<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for `SignInWithAppleButton` and `ASAuthorizationAppleIDProvider`.
         Without this, Apple sign-in fails at runtime. -->
    <key>com.apple.developer.applesignin</key>
    <array>
        <string>Default</string>
    </array>

    <!-- Firebase App Check release attestation. App Attest is the production
         provider; without this entitlement, enforced Firestore can reject
         TestFlight/App Store builds before security rules run. -->
    <key>com.apple.developer.devicecheck.appattest-environment</key>
    <string>production</string>

    <!-- Keychain access group MUST share the AppIdentifierPrefix with the
         build's actual bundle identifier. The escrow key
         in `iOSDeviceKeypair.swift` writes to Keychain via this group. -->
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    </array>

    <!-- App Group for sharing widget data with the WidgetKit extension. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.openburnbar.app</string>
    </array>

    <!-- Lets iPhone/iPad read the OpenBurnBar iCloud Drive archive created by the Mac app. -->
    <key>com.apple.developer.icloud-container-identifiers</key>
    <array>
        <string>iCloud.com.openburnbar.app</string>
    </array>
    <key>com.apple.developer.icloud-services</key>
    <array>
        <string>CloudDocuments</string>
    </array>
</dict>
</plist>
