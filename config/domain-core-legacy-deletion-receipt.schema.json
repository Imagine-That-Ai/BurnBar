{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openburnbar.com/schemas/domain-core-legacy-deletion-receipt-v1.json",
  "title": "OpenBurnBar shared Rust legacy deletion transition receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "rowId", "transition", "status", "evidence", "approvedBy", "approvedAt", "commit"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "rowId": {
      "enum": [
        "quota.claude_statusline",
        "quota.codex_usage",
        "quota.cursor_usage",
        "quota.anthropic_headers",
        "cloudvault.portable_primitives",
        "cloudvault.document_rewrap",
        "cloudvault.search",
        "hermes.relay_crypto",
        "hermes.ratchet_transforms",
        "pricing.token_cost",
        "pricing.kimi_historical"
      ]
    },
    "transition": { "enum": ["promotion", "stable_release", "deletion_review"] },
    "status": { "const": "active" },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^https://(?![^/?#]*@)[^/?#]+(?:/[^?#]*)?$"
      }
    },
    "approvedBy": { "type": "string", "pattern": "^@[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$" },
    "approvedAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
  }
}
