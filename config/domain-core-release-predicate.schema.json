{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openburnbar.dev/schemas/domain-core-release-predicate-v2.json",
  "title": "OpenBurnBar candidate-bound domain-core release predicate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "predicateType",
    "consumer",
    "domain",
    "artifactKind",
    "target",
    "candidate",
    "sourceRun",
    "promotionProof",
    "rollbackArtifact",
    "artifact",
    "release"
  ],
  "oneOf": [
    {
      "properties": {
        "consumer": { "const": "apple" },
        "domain": {
          "enum": [
            "quota",
            "cloudVault",
            "cloudVaultRewrap",
            "cloudVaultSearch",
            "hermes",
            "pricing"
          ]
        },
        "artifactKind": { "const": "macos-dmg" },
        "target": { "const": "macos-arm64" }
      }
    },
    {
      "properties": {
        "consumer": { "const": "android" },
        "domain": {
          "enum": [
            "cloudVault",
            "cloudVaultRewrap",
            "cloudVaultSearch",
            "hermes"
          ]
        },
        "artifactKind": { "const": "android-aab" },
        "target": { "const": "android-universal" }
      }
    },
    {
      "properties": {
        "consumer": { "const": "windows" },
        "domain": { "enum": ["quota", "cloudVault"] },
        "artifactKind": { "const": "windows-release-bundle" },
        "target": { "const": "windows-x64-arm64" }
      }
    },
    {
      "properties": {
        "consumer": { "const": "console" },
        "domain": { "const": "cloudVault" },
        "artifactKind": { "const": "console-deployment-receipt" },
        "target": { "const": "firebase-hosting-production" }
      }
    },
    {
      "properties": {
        "consumer": { "const": "functions" },
        "domain": { "const": "pricing" },
        "artifactKind": { "const": "functions-deployment-receipt" },
        "target": { "const": "firebase-functions-production" }
      }
    }
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "predicateType": {
      "const": "https://openburnbar.dev/attestations/domain-core-release-artifact/v2"
    },
    "consumer": { "$ref": "#/$defs/consumer" },
    "domain": { "$ref": "#/$defs/domain" },
    "artifactKind": { "$ref": "#/$defs/artifactKind" },
    "target": { "$ref": "#/$defs/target" },
    "candidate": { "$ref": "#/$defs/candidate" },
    "sourceRun": { "$ref": "#/$defs/sourceRun" },
    "promotionProof": { "$ref": "#/$defs/promotionProof" },
    "rollbackArtifact": { "$ref": "#/$defs/rollbackArtifact" },
    "artifact": { "$ref": "#/$defs/artifact" },
    "release": { "$ref": "#/$defs/release" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "consumer": {
      "enum": ["apple", "android", "windows", "console", "functions"]
    },
    "domain": {
      "enum": [
        "quota",
        "cloudVault",
        "cloudVaultRewrap",
        "cloudVaultSearch",
        "hermes",
        "pricing"
      ]
    },
    "artifactKind": {
      "enum": [
        "macos-dmg",
        "android-aab",
        "windows-release-bundle",
        "console-deployment-receipt",
        "functions-deployment-receipt"
      ]
    },
    "target": {
      "enum": [
        "macos-arm64",
        "android-universal",
        "windows-x64-arm64",
        "firebase-hosting-production",
        "firebase-functions-production"
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateCommit",
        "coreVersion",
        "abiVersion",
        "sourceSha256"
      ],
      "properties": {
        "candidateCommit": { "$ref": "#/$defs/gitSha" },
        "coreVersion": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "abiVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "sourceSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "sourceRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "workflowPath",
        "runId",
        "runAttempt",
        "event",
        "ref",
        "headSha"
      ],
      "properties": {
        "repository": { "const": "Imagine-That-Ai/BurnBar" },
        "workflowPath": { "const": ".github/workflows/domain-core.yml" },
        "runId": { "type": "integer", "minimum": 1 },
        "runAttempt": { "type": "integer", "minimum": 1 },
        "event": { "const": "push" },
        "ref": { "const": "refs/heads/main" },
        "headSha": { "$ref": "#/$defs/gitSha" }
      }
    },
    "promotionProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signerWorkflow",
        "predicateType",
        "signerRun",
        "attestationSubject",
        "attestationBundleSha256"
      ],
      "properties": {
        "signerWorkflow": {
          "const": ".github/workflows/domain-core-promotion-proof.yml"
        },
        "predicateType": { "const": "https://slsa.dev/provenance/v1" },
        "signerRun": {
          "type": "object",
          "additionalProperties": false,
          "required": ["runId", "runAttempt"],
          "properties": {
            "runId": { "type": "integer", "minimum": 1 },
            "runAttempt": { "type": "integer", "minimum": 1 }
          }
        },
        "attestationSubject": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fileName", "sha256"],
          "properties": {
            "fileName": { "const": "domain-core-candidate-bundle.json" },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "attestationBundleSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "rollbackArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "sha256", "candidate"],
      "properties": {
        "fileName": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "candidate": { "$ref": "#/$defs/candidate" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "sha256"],
      "properties": {
        "fileName": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "tag", "commit", "publicProfileSha256"],
      "properties": {
        "version": { "$ref": "#/$defs/version" },
        "tag": {
          "type": "string",
          "pattern": "^(?:windows-)?v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "commit": { "$ref": "#/$defs/gitSha" },
        "publicProfileSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
