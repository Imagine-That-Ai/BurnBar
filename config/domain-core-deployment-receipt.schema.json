{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openburnbar.dev/schemas/domain-core-deployment-receipt-v2.json",
  "title": "OpenBurnBar candidate-bound domain-core deployment receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "consumer",
    "domain",
    "artifactKind",
    "target",
    "candidate",
    "sourceRun",
    "promotionProof",
    "rollbackArtifact",
    "activation",
    "publicProfile",
    "release",
    "deployment"
  ],
  "oneOf": [
    {
      "properties": {
        "consumer": { "const": "console" },
        "domain": { "const": "cloudVault" },
        "artifactKind": { "const": "console-deployment-receipt" },
        "target": { "const": "firebase-hosting-production" },
        "deployment": {
          "properties": { "provider": { "const": "firebase-hosting" } }
        }
      }
    },
    {
      "properties": {
        "consumer": { "const": "functions" },
        "domain": { "const": "pricing" },
        "artifactKind": { "const": "functions-deployment-receipt" },
        "target": { "const": "firebase-functions-production" },
        "deployment": {
          "properties": { "provider": { "const": "firebase-functions" } }
        }
      }
    }
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "consumer": { "enum": ["console", "functions"] },
    "domain": { "enum": ["cloudVault", "pricing"] },
    "artifactKind": {
      "enum": ["console-deployment-receipt", "functions-deployment-receipt"]
    },
    "target": {
      "enum": ["firebase-hosting-production", "firebase-functions-production"]
    },
    "candidate": {
      "$ref": "domain-core-release-predicate.schema.json#/$defs/candidate"
    },
    "sourceRun": {
      "$ref": "domain-core-release-predicate.schema.json#/$defs/sourceRun"
    },
    "promotionProof": {
      "$ref": "domain-core-release-predicate.schema.json#/$defs/promotionProof"
    },
    "rollbackArtifact": {
      "$ref": "domain-core-release-predicate.schema.json#/$defs/rollbackArtifact"
    },
    "activation": {
      "$ref": "domain-core-release-predicate.schema.json#/$defs/activation"
    },
    "publicProfile": {
      "$ref": "domain-core-release-predicate.schema.json#/$defs/publicProfile"
    },
    "release": {
      "$ref": "domain-core-release-predicate.schema.json#/$defs/release"
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "project",
        "environment",
        "status",
        "healthChecks",
        "deployedArtifact"
      ],
      "properties": {
        "provider": { "enum": ["firebase-hosting", "firebase-functions"] },
        "project": { "type": "string", "minLength": 1 },
        "environment": { "type": "string", "minLength": 1 },
        "status": { "const": "healthy" },
        "healthChecks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "deployedArtifact": {
          "$ref": "domain-core-release-predicate.schema.json#/$defs/artifact"
        }
      }
    }
  }
}
