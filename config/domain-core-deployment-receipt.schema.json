{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openburnbar.dev/schemas/domain-core-deployment-receipt-v2.json",
  "title": "OpenBurnBar candidate-bound domain-core deployment receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "consumer",
    "domain",
    "artifactKind",
    "target",
    "candidate",
    "sourceRun",
    "promotionProof",
    "rollbackArtifact",
    "release",
    "deployment"
  ],
  "oneOf": [
    {
      "properties": {
        "consumer": { "const": "console" },
        "domain": { "const": "cloudVault" },
        "artifactKind": { "const": "console-deployment-receipt" },
        "target": { "const": "firebase-hosting-production" },
        "deployment": {
          "properties": {
            "provider": { "const": "firebase-hosting" },
            "deployRun": {
              "properties": {
                "workflowPath": { "const": ".github/workflows/deploy-hosting.yml" }
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "consumer": { "const": "functions" },
        "domain": { "const": "pricing" },
        "artifactKind": { "const": "functions-deployment-receipt" },
        "target": { "const": "firebase-functions-production" },
        "deployment": {
          "properties": {
            "provider": { "const": "firebase-functions" },
            "deployRun": {
              "properties": {
                "workflowPath": { "const": ".github/workflows/deploy-production.yml" }
              }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "consumer": { "enum": ["console", "functions"] },
    "domain": { "enum": ["cloudVault", "pricing"] },
    "artifactKind": {
      "enum": ["console-deployment-receipt", "functions-deployment-receipt"]
    },
    "target": {
      "enum": ["firebase-hosting-production", "firebase-functions-production"]
    },
    "candidate": {
      "$ref": "domain-core-release-predicate-v2.json#/$defs/candidate"
    },
    "sourceRun": {
      "$ref": "domain-core-release-predicate-v2.json#/$defs/sourceRun"
    },
    "promotionProof": {
      "$ref": "domain-core-release-predicate-v2.json#/$defs/promotionProof"
    },
    "rollbackArtifact": {
      "$ref": "domain-core-release-predicate-v2.json#/$defs/rollbackArtifact"
    },
    "release": {
      "$ref": "domain-core-release-predicate-v2.json#/$defs/release"
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "project",
        "environment",
        "status",
        "healthChecks",
        "deployedArtifact",
        "deployRun",
        "healthArtifactSha256"
      ],
      "properties": {
        "provider": { "enum": ["firebase-hosting", "firebase-functions"] },
        "project": { "type": "string", "minLength": 1 },
        "environment": { "type": "string", "minLength": 1 },
        "status": { "const": "healthy" },
        "healthChecks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "deployedArtifact": {
          "$ref": "domain-core-release-predicate-v2.json#/$defs/artifact"
        },
        "deployRun": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "workflowPath",
            "runId",
            "runAttempt",
            "event",
            "ref",
            "headSha",
            "jobSetSha256"
          ],
          "properties": {
            "repository": { "const": "Imagine-That-Ai/BurnBar" },
            "workflowPath": {
              "enum": [
                ".github/workflows/deploy-hosting.yml",
                ".github/workflows/deploy-production.yml"
              ]
            },
            "runId": { "type": "integer", "minimum": 1 },
            "runAttempt": { "type": "integer", "minimum": 1 },
            "event": { "enum": ["push", "workflow_dispatch"] },
            "ref": {
              "type": "string",
              "pattern": "^refs/tags/v[0-9]+\\.[0-9]+\\.[0-9]+(?:\\+[0-9A-Za-z.-]+)?$"
            },
            "headSha": {
              "$ref": "domain-core-release-predicate-v2.json#/$defs/gitSha"
            },
            "jobSetSha256": {
              "$ref": "domain-core-release-predicate-v2.json#/$defs/sha256"
            }
          }
        },
        "healthArtifactSha256": {
          "$ref": "domain-core-release-predicate-v2.json#/$defs/sha256"
        }
      }
    }
  }
}
