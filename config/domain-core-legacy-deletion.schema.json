{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openburnbar.com/schemas/domain-core-legacy-deletion-v1.json",
  "title": "OpenBurnBar shared Rust legacy deletion ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceRoots", "rows", "sharedTargets"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sourceRoots": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/repositoryPath" },
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" }
    },
    "rows": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": { "$ref": "#/$defs/row" }
    },
    "sharedTargets": {
      "type": "array",
      "items": { "$ref": "#/$defs/sharedTarget" }
    }
  },
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)[^/]+(?:/[^/]+)*$"
    },
    "state": {
      "enum": ["rollout", "rust_authoritative_with_rollback", "legacy_deleted"]
    },
    "receiptPath": {
      "allOf": [
        { "$ref": "#/$defs/repositoryPath" },
        {
          "type": "string",
          "pattern": "^config/domain-core-legacy-deletion-receipts/[a-z][a-z0-9_.]*/(?:promotion|stable_release|deletion_review)\\.json$"
        }
      ]
    },
    "receipts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "promotion": { "$ref": "#/$defs/receiptPath" },
        "stableRelease": { "$ref": "#/$defs/receiptPath" },
        "deletionReview": { "$ref": "#/$defs/receiptPath" }
      }
    },
    "sourceSymbolTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "root", "path", "symbol"],
      "properties": {
        "kind": { "const": "source_symbol" },
        "root": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "path": { "$ref": "#/$defs/repositoryPath" },
        "symbol": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
      }
    },
    "modeLiteralTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "root", "path", "literal"],
      "properties": {
        "kind": { "const": "mode_literal" },
        "root": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "path": { "$ref": "#/$defs/repositoryPath" },
        "literal": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$" }
      }
    },
    "pathTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "root", "path"],
      "properties": {
        "kind": { "const": "path" },
        "root": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "path": { "$ref": "#/$defs/repositoryPath" }
      }
    },
    "target": {
      "oneOf": [
        { "$ref": "#/$defs/sourceSymbolTarget" },
        { "$ref": "#/$defs/modeLiteralTarget" },
        { "$ref": "#/$defs/pathTarget" }
      ]
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "state", "receipts", "targets"],
      "properties": {
        "id": {
          "enum": [
            "quota.claude_statusline",
            "quota.codex_usage",
            "quota.cursor_usage",
            "quota.anthropic_headers",
            "cloudvault.portable_primitives",
            "cloudvault.document_rewrap",
            "cloudvault.search",
            "hermes.relay_crypto",
            "hermes.ratchet_transforms",
            "pricing.token_cost",
            "pricing.kimi_historical"
          ]
        },
        "state": { "$ref": "#/$defs/state" },
        "receipts": { "$ref": "#/$defs/receipts" },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/target" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "rollout" } }, "required": ["state"] },
          "then": { "properties": { "receipts": { "maxProperties": 0 } } }
        },
        {
          "if": { "properties": { "state": { "const": "rust_authoritative_with_rollback" } }, "required": ["state"] },
          "then": {
            "properties": {
              "receipts": {
                "required": ["promotion", "stableRelease"],
                "minProperties": 2,
                "maxProperties": 2
              }
            }
          }
        },
        {
          "if": { "properties": { "state": { "const": "legacy_deleted" } }, "required": ["state"] },
          "then": {
            "properties": {
              "receipts": {
                "required": ["promotion", "stableRelease", "deletionReview"],
                "minProperties": 3,
                "maxProperties": 3
              }
            }
          }
        }
      ]
    },
    "sharedTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rowIds", "target"],
      "properties": {
        "rowIds": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string" }
        },
        "target": { "$ref": "#/$defs/target" }
      }
    }
  }
}
