{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openburnbar.dev/schemas/domain-core-deletion-reviewers.schema.json",
  "title": "OpenBurnBar Shared Rust Deletion Reviewers",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reviewers"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "reviewers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["handle", "reviewClasses"],
        "properties": {
          "handle": {
            "type": "string",
            "pattern": "^@[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
          },
          "reviewClasses": {
            "type": "array",
            "oneOf": [
              { "const": ["domain_owner"] },
              { "const": ["security_crypto"] },
              { "const": ["domain_owner", "security_crypto"] }
            ]
          }
        }
      }
    }
  }
}
