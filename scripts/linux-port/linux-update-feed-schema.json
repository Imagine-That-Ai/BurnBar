{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://burnbar.ai/schemas/latest-linux.json",
  "title": "OpenBurnBar Linux update feed",
  "type": "object",
  "required": ["version", "publishedAt", "channel", "artifacts"],
  "additionalProperties": true,
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "publishedAt": { "type": "string", "minLength": 1 },
    "channel": { "type": "string", "enum": ["stable", "prerelease", "nightly"] },
    "notes": { "type": "string" },
    "gitCommit": { "type": "string" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "url", "sha256"],
        "properties": {
          "type": { "type": "string", "enum": ["appimage", "deb", "rpm", "daemon"] },
          "url": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "minLength": 64, "maxLength": 64 },
          "size": { "type": "integer", "minimum": 0 },
          "signatureUrl": { "type": "string" }
        }
      }
    },
    "ed25519": {
      "type": "object",
      "properties": {
        "publicKeyId": { "type": "string" },
        "signatureBase64": { "type": "string" }
      }
    }
  }
}
