# Copy to scripts/macmini/config.env and fill in the host/user for the runner.
# Values here are examples only; do not put real secrets in this file.
MACMINI_HOST=mac-mini.local
MACMINI_USER=runner
MACMINI_SSH_KEY="$HOME/.ssh/openburnbar_mini"
MACMINI_RUNNER_ROOT="~/OpenBurnBarUIRunner"
MACMINI_SSH_OPTS="-o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ServerAliveInterval=15 -o ServerAliveCountMax=4"
