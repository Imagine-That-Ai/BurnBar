{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    ".dependency-cruiser.cjs",
    "src/extension.ts",
    "src/analytics/index.ts",
    "src/analytics/service.ts",
    "src/webview/panel.js",
    "src/webview/workspace.js",
    "test/extensionHost/suite/index.ts",
    "test/extensionHost/suite/localWorkspace.integration.ts",
    "test/extensionHost/suite/workspaceModes.integration.ts",
