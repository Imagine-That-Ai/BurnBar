{
  "name": "@openburnbar/safari-extension",
  "version": "1.0.40",
  "private": true,
  "description": "OpenBurnBar's safety-gated Safari Web Extension.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && node ./scripts/build.mjs && npm run validate:manifest",
    "clean": "node ./scripts/clean.mjs",
    "deps": "depcruise src --config .dependency-cruiser.cjs",
    "format": "prettier --write \"{src,test,scripts}/**/*.{ts,js,mjs,json,css,html}\" \"*.{json,js,mjs}\"",
    "format:check": "prettier --check \"{src,test,scripts}/**/*.{ts,js,mjs,json,css,html}\" \"*.{json,js,mjs}\"",
    "knip": "knip",
    "lint": "eslint src test scripts --ext .ts,.js,.mjs",
    "lint:fix": "eslint src test scripts --ext .ts,.js,.mjs --fix",
    "size": "size-limit",
    "test": "npm run test:unit",
    "test:ci": "npm run typecheck && npm run lint && npm run format:check && npm run knip && npm run deps && npm run test:coverage && npm run build && npm run size",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run --coverage.enabled false",
    "typecheck": "tsc --noEmit -p ./tsconfig.json && npm run typecheck:background",
    "typecheck:background": "tsc --noEmit -p ./tsconfig.background.json",
    "validate:manifest": "node ./scripts/validate-manifest.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@size-limit/file": "12.1.0",
    "@types/node": "^24.6.0",
    "@typescript-eslint/eslint-plugin": "8.60.0",
    "@typescript-eslint/parser": "8.60.0",
    "@vitest/coverage-v8": "4.1.8",
    "dependency-cruiser": "18.1.0",
    "esbuild": "0.28.1",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.9.0",
    "jsdom": "28.1.0",
    "knip": "5.88.1",
    "prettier": "3.8.3",
    "size-limit": "12.1.0",
    "typescript": "^5.9.3",
    "vitest": "4.1.8"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "esbuild": "0.28.1",
    "minimatch": "^10.0.3",
    "postcss": "^8.5.10",
    "serialize-javascript": "^7.0.0",
    "vite": "^7.3.2"
  },
  "size-limit": [
    {
      "path": "dist/background.js",
      "limit": "90 KB"
    },
    {
      "path": "dist/content.js",
      "limit": "90 KB"
    },
    {
      "path": "dist/popup.js",
      "limit": "70 KB"
    },
    {
      "path": "dist/**/*.{js,css,html,json}",
      "limit": "300 KB"
    }
  ]
}
