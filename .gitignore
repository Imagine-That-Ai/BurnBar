*.mode1v3
*.mode2v3
*.perspectivev3
*.xcuserstate
xcuserdata/

# Thumbnails
*.swp
*.swo
*~

# IDEs
*.idea/
*.vscode/
.cursor/plans/

# Secrets
.secrets/
*.env
*.pem
*.p12
*.p8
*.mobileprovision
*.provisionprofile
*.developerprofile
.encryption-key-recovery

# Sentry — DSN is non-secret but keep local overrides out of source
sentry.properties

# Firebase — never commit the real plist; drop it locally as GoogleService-Info.plist
GoogleService-Info.plist

# Local test/build artifacts
.playwright-mcp/
output/playwright/
default.profraw
firebase-debug.log
firestore-rules-tests/node_modules/
firestore-rules-tests/firestore-debug.log
artifacts/
.asc/
functions/lib/
website/public/downloads/*.dmg
website/public/downloads/*.zip

# BurnBar local MCP (Python venv)
tools/burnbar-mcp/.venv/

# Internal AI agent memory (not for public consumption)
.claude/agent-memory/
.claude/settings.local.json
.claude/*.lock

# Internal-only material (pricing, COGS, GTM, open-vuln working notes).
# This is the private home enforced by the confidentiality guard:
# scripts/security/scan-internal-content.mjs — see docs/security/CONFIDENTIALITY_POLICY.md.
# Files here stay on disk / in the private mirror but never enter the public tree.
internal/

# Generated validation logs (keep JSON reports, skip raw test logs)
.factory/validation/**/user-testing/*.log

# Local Xcode/SwiftPM caches used by scripts/build.sh
.spm-cache/
.spm-cache-*/
.xcode-source-packages/
.derived-data/
.derived-data-*/
.derived-*/
derived-data/

# Local service installs/build outputs
/node_modules/
services/**/node_modules/
services/**/lib/
tools/**/node_modules/
tools/**/lib/
packages/**/node_modules/
packages/**/lib/

# Local-only Factory skills and xcodegen scratch
.factory/skills/
.xcodegen-validate/
.gstack/

# Accidental SwiftPM/protobuf checkouts at repo root
/Sources/protobuf/

# Generated Xcode derived data emitted by factory validation runs
.factory/validation/**/user-testing/derived-data/

# Generated SwiftPM checkout/artifact mirrors from factory validations
.factory/validation/**/derived-data/**/SourcePackages/

# Per-test UserDefaults plists Xcode emits next to source files when running
# tests from inside the IDE (NSUserDefaults host-app simulation).
*.swift.plist

# QA harness output (qa skill writes timestamped reports + screenshots)
# Ignore the entire output/ tree: it holds local auth-QA artifacts including a
# live Chromium profile (cookies/saved logins), OAuth-flow debug captures, and
# authenticated production-session screenshots. None of it is publishable.
output/
qa-results/
output/playwright-screenshots/
output/playwright-user-data/
build_output*.log

# Local language/tool caches and ad-hoc backups
android/.kotlin/
*.bak
android/compile_error.txt
artifacts/**/android-cache/

# Local commercial-launch proof bundle. These files can contain Firebase UIDs,
# App Store transaction IDs, notification readbacks, and live infrastructure
# evidence, so keep them local and attach/redact deliberately.
launch-evidence/

# Generated dashboard snapshot — contains personal spend/token figures; keep
# local (repo is public) and never commit.
/state.json

# Cursor IDE debug logs and local scratch experiments (preserved on disk only).
.cursor/*.log
scratch/

# Secrets / local env / build caches — never commit (added during SOTA remediation
# after these surfaced untracked in the working tree).
appcheck-token.json
.env.production
**/.env.production
.env.*.local
.firebase/
assets/generated/
