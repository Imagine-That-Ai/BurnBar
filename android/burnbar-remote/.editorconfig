root = true

# UniFFI-generated Kotlin bindings — emitted by the UniFFI tool against a foreign
# ABI surface (naming, wrapping, line length, imports all follow the generator,
# not Kotlin style). The bindings are never hand-edited, so ktlint scope excludes
# them entirely; the fix for any violation belongs in the UniFFI emitter, never in
# a checked-in baseline of generated output.
[src/main/java/uniffi/**]
ktlint = disabled
