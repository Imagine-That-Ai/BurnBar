<?xml version="1.0" encoding="utf-8"?>
<!--
  OpenBurnBar Android network security policy (security remediation H-7 + T-AND-02).

  Background: the app previously set a blanket `android:usesCleartextTraffic="true"`,
  then a base-config that still permitted cleartext to ANY non-deny-listed host. The
  app already scopes cleartext at the application layer — `HermesProtocol.validatedBaseURL`
  only allows http:// for localhost and RFC1918 LAN hosts (10/8, 172.16/12, 192.168/16)
  and rejects plain HTTP to public hosts — but the OS-level default left no
  defense-in-depth if that check is ever bypassed (an SDK, an image loader, a future
  code path), so a typo/injection could still exfiltrate over HTTP to an arbitrary host.

  T-AND-02 — DEFAULT-DENY cleartext. The base config now refuses cleartext (HTTPS only),
  so an arbitrary, non-allow-listed host can NEVER be reached over plain HTTP regardless
  of app-layer logic. Cleartext is re-permitted ONLY for the specific hosts that truly
  need it:

    * Loopback (`localhost`, `127.0.0.1`) and the Android-emulator host alias
      (`10.0.2.2`) — these are static literals an NSC `<domain>` can name exactly, and
      they carry the local-runtime Hermes / Ollama / Pi endpoints the app talks to over
      HTTP by design. Traffic here never leaves the device (loopback) or the emulator
      NAT, so cleartext is not a downgrade risk.

  Dynamic RFC1918 LAN-direct (http://192.168.x.x, http://10.x.x.x, http://172.16-31.x.x):
  Android's Network Security Config matches hostnames / IP literals, NOT CIDR subnets, so
  the full RFC1918 ranges cannot be enumerated as `<domain>` entries. Rather than re-open
  cleartext to "any host" to cover them, LAN-direct cleartext is confined to the DEBUG
  source set's override of this file (`app/src/debug/res/xml/network_security_config.xml`,
  which re-permits cleartext in the base config). RELEASE builds use THIS file and
  therefore default-deny cleartext for every host except the static loopback/emulator
  allow-list above; the app-layer `validatedBaseURL` remains the gate, but the OS now
  fails closed too.

  Recommendation (tracked separately): migrate LAN-direct gateway connections to TLS
  (or route them through the authenticated relay) so even debug builds need no cleartext.
-->
<network-security-config>
    <!-- DEFAULT-DENY: no cleartext to arbitrary hosts. HTTPS only unless a host below
         is explicitly allow-listed. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Static loopback / emulator hosts that legitimately serve the local-runtime
         Hermes/Ollama/Pi endpoints over HTTP. These never reach the network, so
         cleartext here is not a downgrade vector. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>

    <!-- Backend / control-plane hosts: TLS only, no cleartext, ever. Redundant under the
         default-deny base, but kept explicit so a future base-config edit cannot silently
         re-expose these security-critical hosts to an HTTP downgrade. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">googleapis.com</domain>
        <domain includeSubdomains="true">firebaseio.com</domain>
        <domain includeSubdomains="true">firebaseapp.com</domain>
        <domain includeSubdomains="true">firebaseappcheck.googleapis.com</domain>
        <domain includeSubdomains="true">firebaseinstallations.googleapis.com</domain>
        <domain includeSubdomains="true">identitytoolkit.googleapis.com</domain>
        <domain includeSubdomains="true">securetoken.googleapis.com</domain>
        <domain includeSubdomains="true">firestore.googleapis.com</domain>
        <domain includeSubdomains="true">cloudfunctions.net</domain>
        <domain includeSubdomains="true">run.app</domain>
        <domain includeSubdomains="true">web.app</domain>
        <domain includeSubdomains="true">gstatic.com</domain>
        <domain includeSubdomains="true">trycloudflare.com</domain>
    </domain-config>
</network-security-config>
