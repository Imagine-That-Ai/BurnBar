<Project Sdk="Microsoft.NET.Sdk">

  <!--
    macOS-host unit tests for the portable TextExpansion core (Windows port ·
    TextExpansion lane).

    Runs on the macOS authoring host today via `dotnet test`: the trigger-match /
    expansion engine, the runtime state machine, the keyboard composer, the usage
    ranker, and the JSON snapshot store are all framework-free managed code, so no
    WinUI / Windows runtime is needed. The REAL OS keystroke capture + injection is
    the OS adapter (bucket B/C) and is exercised here only through the seams.

    Targets net10.0 (the installed runtime) and references the net8.0 engine library
    plus the net8.0/net10.0 storage seam — a higher runtime referencing lower/multi-
    target libraries is allowed, and the WinUI app (net8.0-windows) references the
    very same engine library. Mirrors windows/tests/settings and
    windows/storage/OpenBurnBar.Storage.Tests (net10.0, xUnit).

    The SQLCipher snippet-store round-trip (SnippetSqlCipherStoreRoundTripTests) opens
    the SAME committed Mac-produced fixture the storage byte-compat suite opens; the
    native SQLCipher comes from bundle_e_sqlcipher per-RID (osx-arm64 here). It copies
    the fixture to a temp working file before mutating, so the committed bytes are
    never modified.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../app/OpenBurnBar.App.TextExpansion/OpenBurnBar.App.TextExpansion.csproj" />
    <ProjectReference Include="../../../storage/OpenBurnBar.Storage/OpenBurnBar.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Link (do NOT duplicate) the committed encrypted fixture into the test output so
      the SQLCipher snippet-store round-trip opens the SAME bytes the Mac validator
      opens. The test copies it to a temp working file before writing, so the
      committed file is never mutated.
    -->
    <Content Include="../../../../AgentLensTests/Fixtures/DBByteCompat/openburnbar-db-compat-v64.sqlcipher">
      <Link>Fixtures/openburnbar-db-compat-v64.sqlcipher</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
