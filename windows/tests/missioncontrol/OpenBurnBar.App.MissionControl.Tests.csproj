<Project Sdk="Microsoft.NET.Sdk">

  <!--
    macOS-runnable tests for the Firestore-backed Mission Control dispatch host (WS-B6).
    Links the host sources from the WinUI app tree so we do not reference net8.0-windows here.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>OpenBurnBar.App.MissionControl.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../app/OpenBurnBar.App.Presentation/OpenBurnBar.App.Presentation.csproj" />
    <ProjectReference Include="../../cloudsync/OpenBurnBar.CloudSync/OpenBurnBar.CloudSync.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../app/OpenBurnBar.App/MissionControl/FirestoreMissionDispatchHost.cs" Link="FirestoreMissionDispatchHost.cs" />
  </ItemGroup>

</Project>