<Project Sdk="Microsoft.NET.Sdk">

  <!--
    macOS-runnable tests for CloudSyncInsightSource sample-mode gating (links portable
    app sources — same pattern as Chat.Runtime / Storage.Tests / MissionControl.Tests).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>OpenBurnBar.App.Insights.Tests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../app/OpenBurnBar.App.Configuration/OpenBurnBar.App.Configuration.csproj" />
    <ProjectReference Include="../../app/OpenBurnBar.App.Presentation/OpenBurnBar.App.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../app/OpenBurnBar.App/Insights/CloudSyncInsightSource.cs" Link="CloudSyncInsightSource.cs" />
    <!-- Install(summary) only — DefaultLoad pulls WinUI DashboardUsageProvider and is not linked. -->
    <Compile Include="../../app/OpenBurnBar.App/Insights/InsightsProductionComposition.cs" Link="InsightsProductionComposition.cs" />
    <Compile Include="CloudSyncInsightSourceRuntimeTests.cs" />
  </ItemGroup>

</Project>
