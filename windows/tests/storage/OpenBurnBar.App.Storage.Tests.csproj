<Project Sdk="Microsoft.NET.Sdk">

  <!--
    macOS-runnable tests for WindowsStorageDevHost sample-mode gating (links portable app sources).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>OpenBurnBar.App.Storage.Tests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../app/OpenBurnBar.App.Configuration/OpenBurnBar.App.Configuration.csproj" />
    <ProjectReference Include="../../app/OpenBurnBar.App.Presentation/OpenBurnBar.App.Presentation.csproj" />
    <ProjectReference Include="../../storage/OpenBurnBar.Storage/OpenBurnBar.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../app/OpenBurnBar.App/Storage/WindowsStorageDevHost.cs" Link="WindowsStorageDevHost.cs" />
    <Compile Include="../../app/OpenBurnBar.App/Chat/ChatConversationStore.cs" Link="ChatConversationStore.cs" />
    <Compile Include="../../app/OpenBurnBar.App/Chat/WindowsChatAttachmentStager.cs" Link="WindowsChatAttachmentStager.cs" />
    <Compile Include="WindowsStorageTestCollection.cs" />
    <Compile Include="WindowsStorageDevHostRuntimeTests.cs" />
    <Compile Include="ChatConversationStoreTests.cs" />
  </ItemGroup>

</Project>
