<Project Sdk="Microsoft.NET.Sdk">

  <!--
    macOS-runnable unit tests for the shell's persisted UI-chrome state
    (Phase 3 · W7 · W6-SHELL). Runs on the macOS authoring host today via
    `dotnet test` — it LINKS the dependency-free
    ../../app/OpenBurnBar.App/Shell/AppStatePersistence.cs (System.IO +
    System.Text.Json only, NO WinUI), so the round-trip / defaults / corrupt-file
    fallback / persisted JSON-schema behavior of the shell state store is asserted
    off-Windows. The WinUI-bound shell surfaces (AppShell, FlyoutWindow, ThemeService)
    are Windows-only and are type-checked separately; see the PR's Validation section.

    Mirrors windows/tests/theme/OpenBurnBar.App.Theme.Tests.csproj (net10.0, xUnit) so
    the toolchain is the one already proven on this host.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Link the pure-System shell-state store directly (no WinUI dependency). -->
    <Compile Include="../../app/OpenBurnBar.App/Shell/AppStatePersistence.cs" />
    <Compile Include="AppStatePersistenceTests.cs" />
  </ItemGroup>

</Project>
