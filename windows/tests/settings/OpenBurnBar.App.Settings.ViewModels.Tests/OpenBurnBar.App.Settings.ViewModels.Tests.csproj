<Project Sdk="Microsoft.NET.Sdk">

  <!--
    macOS-host unit tests for the portable Settings view-models (Phase 3 · W7 ·
    Settings lane, parity-100 wave).

    Runs on the macOS authoring host today via `dotnet test`: every view-model is
    framework-free managed code with injectable seams, so no WinUI / Windows runtime is
    needed. Targets net10.0 (the installed runtime) and references the net8.0 view-model
    library — a higher runtime referencing a lower library is allowed, and the WinUI app
    (net8.0-windows) references the same library. Mirrors
    windows/tests/settings/OpenBurnBar.App.Settings.Tests (net10.0, xUnit).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../app/OpenBurnBar.App.Settings.ViewModels/OpenBurnBar.App.Settings.ViewModels.csproj" />
    <ProjectReference Include="../../../app/OpenBurnBar.App.Settings/OpenBurnBar.App.Settings.csproj" />
  </ItemGroup>

</Project>
