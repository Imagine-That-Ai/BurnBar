<Project Sdk="Microsoft.NET.Sdk">

  <!--
    macOS-runnable parity tests for the portable provider-quota parse layer
    (Phase 2 · data & sync — Quota adapters). Runs today via `dotnet test` on the
    authoring host, the SAME assembly that ships on Windows. Mirrors the proven
    presentation/storage/theme test pattern (net10.0, xUnit).

    Coverage — one representative adapter per QUOTA MECHANISM, each asserted
    value-for-value against a committed recorded fixture (input JSON) + expected
    snapshot JSON:
      • ClaudeStatuslineQuotaParserTests — Mechanism 1: the Claude Code statusline
        hook payload (rate_limits window map → percent buckets).
      • CursorUsageQuotaParserTests      — Mechanism 2: Cursor state.vscdb-sourced
        usage-summary (cents→dollars plan/auto/api/on-demand buckets).
      • CodexUsageQuotaParserTests       — Mechanism 3: the Codex wham/usage API
        response (primary/secondary + additional rate-limit percent windows).
      • AnthropicRateLimitHeaderParserTests — Mechanism 4: the anthropic-ratelimit-*
        response headers (unified 5-hour token + standard per-minute buckets).

    The .cmd/PowerShell statusline wrapper, the Windows file-watch, and the
    state.vscdb SQLite read are net8.0-windows/adapter-deferred and NOT exercised
    here — this project proves the PORTABLE parse core is byte-for-byte faithful
    to the Swift adapters.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../app/OpenBurnBar.App.Presentation/OpenBurnBar.App.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Fixtures/**/*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Fixtures/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

</Project>
