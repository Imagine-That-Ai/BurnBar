{
  "schema": "petdef/1",
  "id": "claudecode",
  "name": "Claude Code",
  "kind": "sweeper",
  "displayName": "Claude Code",
  "description": "Scuttles along the baseline, raking loose debris into tidy piles with its claws — then carries the piles off the edge of the screen.",
  "palette": ["#d97757", "#2a1816", "#f2ebe0"],
  "atlas2d": {
    "image": "spritesheet.webp",
    "imageWeb": "spritesheet.webp",
    "grid": { "cols": 8, "rows": 9 },
    "cell": { "w": 192, "h": 208 },
    "anchor": { "x": 96, "y": 196 },
    "states": {
      "idle":        { "row": 0, "frames": 8, "fps":  8, "loop": true  },
      "scuttle":     { "row": 1, "frames": 8, "fps": 10, "loop": true  },
      "pinch_sweep": { "row": 2, "frames": 8, "fps": 10, "loop": true,  "hero": true },
      "claw_scoop":  { "row": 3, "frames": 8, "fps":  9, "loop": false },
      "burrow":      { "row": 4, "frames": 8, "fps":  8, "loop": false },
      "snip":        { "row": 5, "frames": 8, "fps": 11, "loop": true  },
      "cheer":       { "row": 6, "frames": 8, "fps": 11, "loop": false },
      "sleep":       { "row": 7, "frames": 8, "fps":  6, "loop": true  },
      "alert":       { "row": 8, "frames": 8, "fps": 10, "loop": false }
    },
    "default": "idle",
    "sockets": { "contact": { "fx": 0.82, "fy": 0.18 } }
  },
  "model3d": {
    "kind": "static",
    "glb": "claudecode-crab",
    "clips": {}
  },
  "behavior": {
    "initial": "idle",
    "transitions": [
      { "from": "idle",   "to": "wander", "when": "cooldownElapsed", "weight": 12 },
      { "from": "idle",   "to": "sleep",  "when": "cooldownElapsed", "weight": 4  },
      { "from": "idle",   "to": "react",  "when": "cooldownElapsed", "weight": 1  },
      { "from": "idle",   "to": "listen", "when": "cursorNear",      "weight": 100 },
      { "from": "wander", "to": "idle",   "when": "cooldownElapsed", "weight": 8  },
      { "from": "wander", "to": "wander", "when": "cooldownElapsed", "weight": 6  },
      { "from": "sleep",  "to": "idle",   "when": "cooldownElapsed", "weight": 10 },
      { "from": "sleep",  "to": "sleep",  "when": "cooldownElapsed", "weight": 6  },
      { "from": "react",  "to": "idle",   "when": "cooldownElapsed", "weight": 12 },
      { "from": "listen", "to": "think",  "when": "sendPressed" },
      { "from": "think",  "to": "speak",  "when": "streamStart" },
      { "from": "speak",  "to": "react",  "when": "resultLanded" },
      { "from": "speak",  "to": "react",  "when": "fallbackFired" },
      { "from": "react",  "to": "listen", "when": "inputFocused" },
      { "from": "listen", "to": "idle",   "when": "idleElapsed" }
    ]
  },
  "behaviorMechanic": "SWEEP",
  "locomotion": "scuttle",
  "agent": {
    "providersDesktop": ["hermes", "codex", "claude", "openclaw"],
    "webFunction": "chat",
    "persona": "muse",
    "voiceLines": "front-desk"
  },
  "license": {
    "ipStatus": "studio",
    "licenseNote": "Imagine That sweeper companion; shared PetDefinition with the web NPC.",
    "attribution": "Imagine That LLC"
  }
}
