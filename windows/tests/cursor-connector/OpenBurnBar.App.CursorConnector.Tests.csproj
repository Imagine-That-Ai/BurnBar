<Project Sdk="Microsoft.NET.Sdk">

  <!--
    macOS-runnable tests for the portable CURSOR CONNECTOR layer — the log-stream
    tail, connector-model round-trips, the token normalizer + usage-log consumer,
    the try-cloudflare URL extractor, the secret broker over a fake ISecretStore,
    the routed-client config sync over a fake filesystem, the settings applier over
    a fake state store, and the connect/disconnect session state machine (ordering +
    rollback) over a recording steps fake. Recorded usage-log fixtures under
    Fixtures/ are the parity oracle for the tail + consumer.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../app/OpenBurnBar.App.CursorConnector/OpenBurnBar.App.CursorConnector.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Fixtures/**/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Fixtures/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

</Project>
