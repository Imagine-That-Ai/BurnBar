<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WS-B0 end-to-end walking proof (ADR WPD-0007 gate): parse (Swift Engine subprocess) →
    SQLCipher write/read ("live tile") on macOS; ConPTY ICliStream shape authored for Windows.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>OpenBurnBar.B0Spike.Tests</RootNamespace>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../storage/OpenBurnBar.Storage/OpenBurnBar.Storage.csproj" />
    <ProjectReference Include="../../pal/ipc-windows/OpenBurnBar.Pal.Ipc.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../../AgentLensTests/Fixtures/DBByteCompat/openburnbar-db-compat-v64.sqlcipher">
      <Link>Fixtures/openburnbar-db-compat-v64.sqlcipher</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="../../../AgentLensTests/Fixtures/ParserContract/pc-claude-basic-session.jsonl">
      <Link>Fixtures/pc-claude-basic-session.jsonl</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="../../../AgentLensTests/Fixtures/ParserContract/parser-output-golden.json">
      <Link>Fixtures/parser-output-golden.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
