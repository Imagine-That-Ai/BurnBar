<Project Sdk="Microsoft.NET.Sdk">

  <!--
    macOS unit tests for the PORTABLE signed-nonce handshake state machine
    (VAL-P0-CONPTY-018). Runs on the macOS authoring host today via `dotnet test`
    with a real ECDSA-P256 signer/verifier and a deterministic clock/RNG — no
    Windows APIs, no ConPTY, no named pipe. The Windows harness's live handshake
    proof is VAL-P0-CONPTY-019.

    Mirrors crates/burnbar-remote/bindings/csharp/BurnBarRemote.Ffi.Tests
    (net10.0, xUnit) so the toolchain is the one already proven on this host.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../pal/ipc/OpenBurnBar.Pal.Ipc.csproj" />
  </ItemGroup>

</Project>
