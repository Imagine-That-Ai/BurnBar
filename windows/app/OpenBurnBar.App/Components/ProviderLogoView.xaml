<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="OpenBurnBar.App.Components.ProviderLogoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
      Windows peer of AgentLens/Views/Components/ProviderLogoView.swift +
      OpenBurnBarCore/.../UnifiedProviderLogoView.swift (the two macOS variants are unified here).
      Prefers the bundled provider asset (ms-appx:///Assets/ProviderLogos/<name>.png); on load
      failure it falls back to a branded Segoe glyph. Providers whose logos are solid dark glyphs
      get a light disc behind them (ProviderMetadata.NeedsMonochromeLogoBackdrop). The squircle
      clip radius is size*0.2237, matching Swift. Everything is set from code-behind so the
      asset-missing path degrades gracefully; the ClipBorder rounds the whole stack.
    -->
    <Border x:Name="ClipBorder">
        <Grid>
            <Border x:Name="Backdrop"
                    Visibility="Collapsed"
                    BorderThickness="0.5" />

            <Image x:Name="Logo"
                   Stretch="Uniform"
                   ImageFailed="OnImageFailed"
                   ImageOpened="OnImageOpened" />

            <FontIcon x:Name="Fallback"
                      Visibility="Collapsed"
                      FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
        </Grid>
    </Border>
</UserControl>
