<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="OpenBurnBar.App.Components.AppLogoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    AutomationProperties.Name="OpenBurnBar">

    <!--
      Windows peer of AgentLens/Views/Components/AppLogoView.swift — the OpenBurnBar brand
      mark from the app asset (`AppLogo`). Size is set from code-behind so callers can size it
      like the SwiftUI `size` parameter (default 24).
    -->
    <Image x:Name="LogoImage"
           Width="24"
           Height="24"
           Stretch="Uniform"
           Source="ms-appx:///Assets/AppLogo.png" />
</UserControl>
