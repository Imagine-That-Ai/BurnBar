<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="OpenBurnBar.App.Components.UpdateBannerCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:theme="using:OpenBurnBar.App.Theme"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
      Windows peer of AgentLens/Views/Components/UpdateBannerCard.swift — the "update available"
      card rendered into the flyout (compact), dashboard, and settings. Every surface reads the
      shared UpdateBannerState so copy stays in lock-step through download → verify → install →
      relaunch. Title/subtitle/icon/actionability come from the parity-tested UpdateBannerState;
      the plate routes through the Liquid-Glass chokepoint. Action buttons raise ActionInvoked;
      the driving update service is a Windows follow-up (out of Bucket A).
    -->
    <Border x:Name="Root"
            CornerRadius="{StaticResource PensieveRadiusLgCorner}"
            theme:LiquidGlass.Surface="True"
            BorderThickness="1"
            BorderBrush="{StaticResource PensieveColorGlassLineBrush}"
            Padding="16"
            Visibility="Collapsed">
        <StackPanel Spacing="12">

            <!-- Header. -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="IconDisc"
                        Grid.Column="0"
                        Width="30"
                        Height="30"
                        CornerRadius="15"
                        VerticalAlignment="Center">
                    <FontIcon x:Name="HeaderIcon"
                              FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                              FontSize="15"
                              Foreground="White" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock x:Name="TitleText"
                               FontSize="15"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource PensieveColorTextBrightBrush}" />
                    <TextBlock x:Name="SubtitleInline"
                               FontSize="11"
                               Visibility="Collapsed"
                               Foreground="{StaticResource PensieveColorTextMuteBrush}" />
                </StackPanel>
                <Border x:Name="VersionPill"
                        Grid.Column="2"
                        Visibility="Collapsed"
                        Padding="8,3"
                        CornerRadius="{StaticResource PensieveRadiusPillCorner}"
                        Background="{StaticResource OBBAccentBrush}"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="VersionText"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="White" />
                </Border>
            </Grid>

            <!-- Subtitle (non-compact). -->
            <TextBlock x:Name="SubtitleBlock"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Foreground="{StaticResource PensieveColorTextBaseBrush}" />

            <!-- Body: progress / indeterminate / actions. -->
            <StackPanel x:Name="BodyHost" Spacing="8" />
        </StackPanel>
    </Border>
</UserControl>
