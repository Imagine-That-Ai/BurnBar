<?xml version="1.0" encoding="utf-8"?>
<!--
  A single widget tile on the Insights canvas (Phase 3 · W7). Chrome only: a glass card with a
  kind glyph, title, and kind chip; the body is filled in code-behind per the widget's data
  (a Win2D chart canvas for the chart kinds, native XAML for KPI / narrative / recommendation).
  The Windows render of one cell of AgentLens/Views/Insights + the InsightWidgetRenderer switch.
-->
<UserControl
    x:Class="OpenBurnBar.App.Insights.InsightWidgetTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border CornerRadius="{StaticResource PensieveRadiusLgCorner}"
            Background="{StaticResource PensieveColorGlassBgBrush}"
            BorderBrush="{StaticResource OBBStrokeBrush}"
            BorderThickness="1"
            Padding="12">
        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon x:Name="KindGlyph"
                          Grid.Column="0"
                          FontFamily="Segoe MDL2 Assets"
                          FontSize="12"
                          VerticalAlignment="Center"
                          Foreground="{StaticResource OBBAccentBrush}" />
                <TextBlock x:Name="TitleText"
                           Grid.Column="1"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource AuroraTextBrush}" />
                <Border Grid.Column="2"
                        CornerRadius="{StaticResource PensieveRadiusPillCorner}"
                        Background="{ThemeResource AuroraGlassStrokeFrostBrush}"
                        Padding="6,1">
                    <TextBlock x:Name="KindChip"
                               FontSize="9"
                               Foreground="{ThemeResource AuroraTextMutedBrush}" />
                </Border>
            </Grid>

            <!-- Body (filled in code-behind). -->
            <Border x:Name="ContentHost" Grid.Row="1" />
        </Grid>
    </Border>
</UserControl>
