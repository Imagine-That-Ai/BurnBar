<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="OpenBurnBar.App.Views.LiveCliStreamView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:OpenBurnBar.App.ViewModels"
    xmlns:theme="using:OpenBurnBar.App.Theme"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Transport toolbar. -->
        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="Start"
                    Style="{StaticResource LiquidGlassInteractiveStyle}"
                    Click="Start_Click"
                    IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}" />
            <Button Grid.Column="1"
                    Content="Stop"
                    Style="{StaticResource LiquidGlassInteractiveStyle}"
                    Click="Stop_Click"
                    IsEnabled="{x:Bind ViewModel.CanStop, Mode=OneWay}" />

            <TextBlock Grid.Column="3"
                       x:Name="StatusLabel"
                       VerticalAlignment="Center"
                       Opacity="0.7"
                       FontSize="12"
                       Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
        </Grid>

        <!--
          Streamed lines. The container is the Liquid-Glass "surface" plate: the
          LiquidGlassSurfaceStyle carries shape/stroke/padding, and theme:LiquidGlass.Surface
          swaps in the transparency-preference-aware brush (Mica-translucent / Acrylic / solid)
          at runtime through the W6-DS-GLASS chokepoint.
        -->
        <Border Grid.Row="1"
                Style="{StaticResource LiquidGlassSurfaceStyle}"
                theme:LiquidGlass.Surface="True">
            <ListView x:Name="LinesList"
                      Padding="12,8"
                      FontFamily="Cascadia Mono, Consolas, Courier New"
                      FontSize="12.5"
                      SelectionMode="None"
                      IsItemClickEnabled="False"
                      ItemsSource="{x:Bind ViewModel.Lines, Mode=OneWay}"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:CliLineViewModel">
                        <TextBlock Text="{x:Bind Text, Mode=OneWay}"
                                   Foreground="{x:Bind Foreground}"
                                   TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</UserControl>
