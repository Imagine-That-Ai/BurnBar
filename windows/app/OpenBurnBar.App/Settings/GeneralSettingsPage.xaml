<?xml version="1.0" encoding="utf-8"?>
<!--
  General (Phase 3 · W7). WinUI peer of AgentLens/Views/Settings/GeneralSettingsView.swift:
  the General landing with the operator wizard, a drill into Appearance, and the
  dashboard-defaults / refresh / indexing / summaries rows — each anchored to its
  SettingsAnchor id so search results land on the exact control. CommunityToolkit
  SettingsCard rows; Pensieve tokens for text.
-->
<Page
    x:Class="OpenBurnBar.App.Settings.Winui.GeneralSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="{StaticResource PensieveSpace6Thickness}">
        <StackPanel Spacing="6" MaxWidth="720" HorizontalAlignment="Left">

            <TextBlock
                Style="{StaticResource TitleTextBlockStyle}"
                Foreground="{StaticResource PensieveColorTextBrightBrush}"
                Text="General" />
            <TextBlock
                Margin="0,0,0,8"
                Foreground="{StaticResource PensieveColorTextMuteBrush}"
                Text="Appearance, dashboard defaults, refresh, indexing, summaries." />

            <tk:SettingsCard x:Name="OperatorCard" Header="Setup Wizard" Description="Run the guided onboarding wizard">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8B7;" />
                </tk:SettingsCard.HeaderIcon>
                <Button Content="Run wizard" />
            </tk:SettingsCard>

            <tk:SettingsCard x:Name="AppearanceCard" Header="Appearance"
                             Description="Theme, skin, glass, and the animated backdrops"
                             IsClickEnabled="True" Click="Appearance_Click">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE790;" />
                </tk:SettingsCard.HeaderIcon>
            </tk:SettingsCard>

            <TextBlock
                Margin="0,10,0,2"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Foreground="{StaticResource PensieveColorTextBaseBrush}"
                Text="Dashboard defaults" />

            <tk:SettingsCard x:Name="TimeRangeCard" Header="Default Time Range" Description="Window used by charts and totals">
                <ComboBox SelectedIndex="1">
                    <ComboBoxItem Content="Day" />
                    <ComboBoxItem Content="Week" />
                    <ComboBoxItem Content="Month" />
                </ComboBox>
            </tk:SettingsCard>

            <tk:SettingsCard x:Name="UsageModeCard" Header="Usage Display" Description="Show USD spend or token totals (M / B)">
                <ComboBox SelectedIndex="0">
                    <ComboBoxItem Content="USD spend" />
                    <ComboBoxItem Content="Token totals" />
                </ComboBox>
            </tk:SettingsCard>

            <tk:SettingsCard x:Name="RefreshCard" Header="Refresh Interval"
                             Description="How often OpenBurnBar scans for new sessions">
                <ComboBox SelectedIndex="1">
                    <ComboBoxItem Content="1 min" />
                    <ComboBoxItem Content="5 min" />
                    <ComboBoxItem Content="15 min" />
                </ComboBox>
            </tk:SettingsCard>

            <tk:SettingsCard x:Name="IndexingCard" Header="Indexing &amp; Search"
                             Description="Local conversation indexing and embeddings">
                <ToggleSwitch IsOn="True" />
            </tk:SettingsCard>

            <tk:SettingsCard x:Name="SummariesCard" Header="Auto-Generate Session Summaries"
                             Description="Write a recap after every scan">
                <ToggleSwitch />
            </tk:SettingsCard>

        </StackPanel>
    </ScrollViewer>
</Page>
