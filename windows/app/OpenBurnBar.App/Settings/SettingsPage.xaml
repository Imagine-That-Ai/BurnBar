<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings shell (Phase 3 · W7). WinUI peer of AgentLens/Views/Settings/SettingsView.swift:
  a NavigationView sidebar (the macOS NavigationSplitView sidebar), grouped into the same
  sections as SettingsSection, with a search box in the pane (the macOS `.searchable`
  sidebar field) and a content Frame (the detail NavigationStack). The sidebar items are
  built in code-behind from the portable SettingsTabMetadata so labels/order stay in sync
  with the manifest. When the search field is non-empty the Frame shows the search results
  page; picking a result routes the shell to the owning tab + scrolls to the exact anchor.
-->
<Page
    x:Class="OpenBurnBar.App.Settings.Winui.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <NavigationView
        x:Name="Nav"
        IsSettingsVisible="False"
        IsBackButtonVisible="Collapsed"
        PaneDisplayMode="Left"
        OpenPaneLength="280"
        SelectionChanged="Nav_SelectionChanged">

        <NavigationView.AutoSuggestBox>
            <AutoSuggestBox
                x:Name="SearchBox"
                PlaceholderText="Search settings"
                QueryIcon="Find"
                TextChanged="SearchBox_TextChanged" />
        </NavigationView.AutoSuggestBox>

        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Page>
