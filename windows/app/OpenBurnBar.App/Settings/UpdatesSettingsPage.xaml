<?xml version="1.0" encoding="utf-8"?>
<!--
  Updates (Phase 3 · W7). WinUI peer of AgentLens/Views/Settings/UpdatesSettingsView.swift,
  as CommunityToolkit SettingsCard rows anchored to their SettingsAnchor ids so a search
  result deep-links to App Version / Automatic Checks / Release Notes.
-->
<Page
    x:Class="OpenBurnBar.App.Settings.Winui.UpdatesSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="{StaticResource PensieveSpace6Thickness}">
        <StackPanel Spacing="6" MaxWidth="720" HorizontalAlignment="Left">

            <TextBlock
                Style="{StaticResource TitleTextBlockStyle}"
                Foreground="{StaticResource PensieveColorTextBrightBrush}"
                Text="Updates" />
            <TextBlock
                Margin="0,0,0,8"
                Foreground="{StaticResource PensieveColorTextMuteBrush}"
                Text="App version, automatic updates, and the release channel." />

            <tk:SettingsCard x:Name="OverviewCard" Header="App Version"
                             Description="The installed OpenBurnBar version and update channel">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE896;" />
                </tk:SettingsCard.HeaderIcon>
                <StackPanel Spacing="2" HorizontalAlignment="Right">
                    <TextBlock x:Name="VersionText"
                               TextAlignment="Right"
                               Foreground="{StaticResource PensieveColorTextBrightBrush}" />
                    <TextBlock x:Name="ChannelText"
                               TextAlignment="Right"
                               FontSize="12"
                               Foreground="{StaticResource PensieveColorTextMuteBrush}" />
                </StackPanel>
            </tk:SettingsCard>

            <tk:SettingsCard x:Name="AutomaticChecksCard" Header="Automatically Check for Updates"
                             Description="Check shortly after launch and once a day">
                <ToggleSwitch x:Name="AutomaticChecksToggle"
                              Toggled="AutomaticChecksToggle_Toggled" />
            </tk:SettingsCard>

            <tk:SettingsCard x:Name="UpdaterStatusCard" Header="Update Feed"
                             Description="Pinned feed and native updater availability">
                <StackPanel Spacing="6" MinWidth="280">
                    <TextBlock x:Name="UpdaterStatusText"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource PensieveColorTextMuteBrush}" />
                    <TextBlock x:Name="AppcastText"
                               TextWrapping="WrapWholeWords"
                               FontSize="12"
                               Foreground="{StaticResource PensieveColorTextMuteBrush}" />
                    <Button x:Name="CheckNowButton"
                            Content="Check Now"
                            Click="CheckNowButton_Click" />
                </StackPanel>
            </tk:SettingsCard>

            <tk:SettingsCard x:Name="StartupCard" Header="Launch at Startup"
                             Description="Use the packaged Windows startup task when available">
                <StackPanel Spacing="6">
                    <ToggleSwitch x:Name="StartupToggle"
                                  Toggled="StartupToggle_Toggled" />
                    <TextBlock x:Name="StartupStatusText"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{StaticResource PensieveColorTextMuteBrush}" />
                </StackPanel>
            </tk:SettingsCard>

            <tk:SettingsCard x:Name="ReleaseNotesCard" Header="Release Notes"
                             Description="Open the GitHub releases page">
                <Button x:Name="ReleaseNotesButton"
                        Content="Open"
                        Click="ReleaseNotesButton_Click" />
            </tk:SettingsCard>

        </StackPanel>
    </ScrollViewer>
</Page>
