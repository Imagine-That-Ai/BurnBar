<?xml version="1.0" encoding="utf-8"?>
<!-- Real settings leaf for every catalog ViewModel tab (replaces SettingsPlaceholderPage fallthrough). -->
<Page
    x:Class="OpenBurnBar.App.Settings.Winui.SettingsViewModelHostPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:theme="using:OpenBurnBar.App.Theme"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="12" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock x:Name="TitleText"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PensieveColorTextBrightBrush}" />
            <TextBlock x:Name="SubtitleText"
                       TextWrapping="Wrap"
                       FontSize="13"
                       Foreground="{StaticResource PensieveColorTextMuteBrush}" />
            <Border Style="{StaticResource LiquidGlassPillStyle}"
                    theme:LiquidGlass.Surface="True"
                    HorizontalAlignment="Left"
                    Padding="10,4">
                <TextBlock x:Name="GatingPill"
                           FontSize="11"
                           Opacity="0.8" />
            </Border>
            <TextBlock x:Name="BodyText"
                       TextWrapping="Wrap"
                       FontSize="13"
                       Foreground="{StaticResource PensieveColorTextBrightBrush}" />
            <InfoBar x:Name="SaveStatus"
                     IsOpen="False"
                     IsClosable="True"
                     Severity="Error" />
            <StackPanel x:Name="DynamicControls" Spacing="8" />
        </StackPanel>
    </ScrollViewer>
</Page>
