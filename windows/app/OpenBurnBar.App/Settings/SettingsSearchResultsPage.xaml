<?xml version="1.0" encoding="utf-8"?>
<!--
  Search results detail (Phase 3 · W7). WinUI peer of
  AgentLens/Views/Settings/Search/SettingsSearchResultsView.swift: ranked matches from
  SettingsSearchEngine rendered as tappable rows (the Swift SettingsDrillRow), each
  showing the owning-tab glyph + accent, the title/subtitle, and a "Tab › Page"
  breadcrumb from the portable SettingsRouteDisplay. Tapping a row asks the shell to
  route to that control. An empty query state offers "Browse all".
-->
<Page
    x:Class="OpenBurnBar.App.Settings.Winui.SettingsSearchResultsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenBurnBar.App.Settings.Winui"
    xmlns:theme="using:OpenBurnBar.App.Theme"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="{StaticResource PensieveSpace6Thickness}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="CountLabel"
            Grid.Row="0"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            Foreground="{StaticResource PensieveColorTextBaseBrush}"
            Text="Results" />

        <ListView
            x:Name="ResultsList"
            Grid.Row="1"
            IsItemClickEnabled="True"
            SelectionMode="None"
            ItemClick="ResultsList_ItemClick"
            ItemsSource="{x:Bind Results, Mode=OneWay}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="4" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:SettingsSearchResultViewModel">
                    <Border
                        Style="{StaticResource LiquidGlassSurfaceStyle}"
                        theme:LiquidGlass.Surface="True"
                        Padding="{StaticResource OBBCardPadding}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontSize="18"
                                Glyph="{x:Bind Glyph}"
                                Foreground="{x:Bind AccentBrush}" />

                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock
                                    Text="{x:Bind Title}"
                                    TextTrimming="CharacterEllipsis"
                                    Foreground="{StaticResource PensieveColorTextBrightBrush}" />
                                <TextBlock
                                    Text="{x:Bind Subtitle}"
                                    Visibility="{x:Bind SubtitleVisibility}"
                                    TextTrimming="CharacterEllipsis"
                                    FontSize="12"
                                    Foreground="{StaticResource PensieveColorTextMuteBrush}" />
                            </StackPanel>

                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Text="{x:Bind Breadcrumb}"
                                Foreground="{StaticResource PensieveColorTextDimBrush}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel
            x:Name="EmptyState"
            Grid.Row="1"
            Visibility="Collapsed"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12">
            <FontIcon FontSize="28" Glyph="&#xE721;" Foreground="{StaticResource PensieveColorTextMuteBrush}" />
            <TextBlock
                x:Name="EmptyLabel"
                HorizontalAlignment="Center"
                Foreground="{StaticResource PensieveColorTextBaseBrush}"
                Text="No settings match your search" />
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="12"
                Foreground="{StaticResource PensieveColorTextMuteBrush}"
                Text="Try a broader term, or browse the sidebar." />
            <Button Content="Browse all" HorizontalAlignment="Center" Click="BrowseAll_Click" />
        </StackPanel>
    </Grid>
</Page>
