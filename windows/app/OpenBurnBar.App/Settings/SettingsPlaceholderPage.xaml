<?xml version="1.0" encoding="utf-8"?>
<!--
  Placeholder detail for the Settings tabs whose full port lands in a later W7 lane
  (Agents, Cloud, Daemon, …). It renders the tab's real title + subtitle from the
  portable SettingsTabMetadata so the shell + sidebar are coherent and honest about
  what is not yet implemented. The Settings SEARCH already indexes these tabs' rows,
  so a match still routes here and selects the right sidebar entry.
-->
<Page
    x:Class="OpenBurnBar.App.Settings.Winui.SettingsPlaceholderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:theme="using:OpenBurnBar.App.Theme"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="{StaticResource PensieveSpace8Thickness}">
        <Border
            Style="{StaticResource LiquidGlassSurfaceStyle}"
            theme:LiquidGlass.Surface="True"
            Padding="{StaticResource PensieveSpace6Thickness}"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            MaxWidth="720">
            <StackPanel Spacing="8">
                <TextBlock
                    x:Name="TitleLabel"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Foreground="{StaticResource PensieveColorTextBrightBrush}" />
                <TextBlock
                    x:Name="SubtitleLabel"
                    Foreground="{StaticResource PensieveColorTextMuteBrush}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,8,0,0"
                    FontSize="12"
                    Foreground="{StaticResource PensieveColorTextDimBrush}"
                    Text="This surface is being ported in a later W7 lane. Search already indexes its settings." />
            </StackPanel>
        </Border>
    </Grid>
</Page>
