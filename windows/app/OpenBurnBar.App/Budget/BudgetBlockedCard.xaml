<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows render of AgentLens/Views/Chat/BudgetBlockedCard.swift — the first-class error card
  shown in chat when a per-usage credential hits its cap. Rule label, used/limit + period,
  reset time, and the three actions: raise the limit by $25, allow this session, and open
  Budget Settings. Populated via SetError(BudgetBlockedCardModel) from the portable model;
  raises RaiseLimitRequested / AllowSessionRequested / OpenSettingsRequested for the host.
-->
<UserControl
    x:Class="OpenBurnBar.App.Budget.BudgetBlockedCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border x:Name="Root"
            CornerRadius="{StaticResource PensieveRadiusMdCorner}"
            Background="{StaticResource PensieveColorGlassBgElevatedBrush}"
            BorderThickness="1"
            Padding="14">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <FontIcon Grid.Column="0"
                      x:Name="AlertIcon"
                      FontFamily="Segoe MDL2 Assets"
                      Glyph="&#xE711;"
                      FontSize="22"
                      VerticalAlignment="Top" />

            <StackPanel Grid.Column="1" Spacing="8">
                <StackPanel Spacing="2">
                    <TextBlock Text="Budget limit reached"
                               FontWeight="SemiBold"
                               FontSize="15"
                               Foreground="{ThemeResource AuroraTextBrush}" />
                    <TextBlock x:Name="RuleLabelText"
                               FontSize="12"
                               Foreground="{ThemeResource AuroraTextMutedBrush}" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock x:Name="UsedText"
                                   FontFamily="{StaticResource AuroraMonoFont}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="of" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{ThemeResource AuroraTextMutedBrush}" />
                        <TextBlock x:Name="LimitText"
                                   FontFamily="{StaticResource AuroraMonoFont}"
                                   Foreground="{ThemeResource AuroraTextSecondaryBrush}" />
                        <TextBlock x:Name="PeriodText" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{ThemeResource AuroraTextMutedBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="ResetText"
                               FontSize="11"
                               Foreground="{ThemeResource AuroraTextMutedBrush}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                    <Button x:Name="RaiseButton" Click="Raise_Click"
                            Style="{StaticResource LiquidGlassInteractiveStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon x:Name="RaiseIcon" FontFamily="Segoe MDL2 Assets" FontSize="12" Glyph="&#xE710;" />
                            <TextBlock x:Name="RaiseLabel" Text="+$25" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="AllowButton" Content="Allow session" Click="Allow_Click"
                            Style="{StaticResource LiquidGlassInteractiveStyle}" />
                    <Button x:Name="SettingsButton" Click="Settings_Click"
                            ToolTipService.ToolTip="Open Budget Settings"
                            Style="{StaticResource LiquidGlassInteractiveStyle}">
                        <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="12" Glyph="&#xE713;" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
