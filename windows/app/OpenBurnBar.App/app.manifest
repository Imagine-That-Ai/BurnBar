<?xml version="1.0" encoding="utf-8"?>
<!--
  Win32 side-by-side application manifest for the UNPACKAGED WinUI 3 shell.
  (An unpackaged app has no Package.appxmanifest; this app.manifest is the
   equivalent identity/settings surface and is what ApplicationManifest points at.)
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">

  <assemblyIdentity
      version="1.0.40.0"
      name="OpenBurnBar.App"
      type="win32" />

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
      <!-- Windows 8.1 (superset floor; TargetPlatformMinVersion gates the real floor) -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}" />
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!-- Per-monitor v2 DPI so the tray flyout + Mica render crisp on mixed-DPI setups. -->
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2, PerMonitor</dpiAwareness>
      <!-- OpenBurnBar shells CLIs whose session paths can exceed MAX_PATH. -->
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
      <!-- UTF-8 process code page (parity with the macOS/Android UTF-8 wire assumptions). -->
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>

</assembly>
