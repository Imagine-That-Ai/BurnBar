<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="OpenBurnBar.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Theme/Tokens.xaml" />
                <!-- Dark Pensieve shell overrides (must follow Tokens, before controls consume them). -->
                <ResourceDictionary Source="ms-appx:///Theme/PensieveShell.xaml" />
                <!-- Liquid-Glass vocabulary styles (W6-DS-GLASS chokepoint). -->
                <ResourceDictionary Source="ms-appx:///Theme/LiquidGlass.xaml" />
                <!-- Data Control Center shared card + inventory-header chrome (W7). -->
                <ResourceDictionary Source="ms-appx:///DataControlCenter/DataControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
