<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="OpenBurnBar.App.Quota.SubscriptionOrb"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:OpenBurnBar.App.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
      Windows peer of the private SubscriptionOrb in
      AgentLens/Views/Dashboard/Quota/SubscriptionConstellationHero.swift — one provider's plan
      health as a ring around its logo. The ring fill fraction + band (or dashed-muted when the
      provider has no displayable signal) comes from the parity-tested SubscriptionOrbRing; the
      code-behind only paints it. Tapping raises OrbTapped so the hero can toggle the provider
      focus. Selected → luminous halo + scale; hover → lift.
    -->
    <Grid x:Name="Root"
          Tapped="OnTapped"
          Background="Transparent"
          RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
        </Grid.RenderTransform>

        <StackPanel Spacing="6" HorizontalAlignment="Center">
            <!-- Ring + logo. -->
            <Grid Width="64"
                  Height="64"
                  HorizontalAlignment="Center">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="LiftTransform" Y="0" />
                </Grid.RenderTransform>
                <Canvas x:Name="RingCanvas" />
                <components:ProviderLogoView x:Name="Logo"
                                             LogoSize="26"
                                             UseFallbackColor="True"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
            </Grid>

            <!-- Label + remaining percent. -->
            <StackPanel Spacing="1" HorizontalAlignment="Center">
                <TextBlock x:Name="NameText"
                           HorizontalAlignment="Center"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="80"
                           Foreground="{StaticResource PensieveColorTextBaseBrush}" />
                <TextBlock x:Name="PercentText"
                           HorizontalAlignment="Center"
                           FontFamily="{StaticResource PensieveFontMono}"
                           FontSize="11"
                           FontWeight="SemiBold" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
