<?xml version="1.0" encoding="utf-8"?>
<!--
  Nav-frame host for the memory review inbox (key "memory"). The AppShell content Frame
  navigates Page types; MemoryReviewInboxView is the real surface. Dev-host seeds an
  in-memory delegate-backed model until the SQLCipher memory store lands (B1–B4).
-->
<Page
    x:Class="OpenBurnBar.App.Memory.MemoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenBurnBar.App.Memory"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <local:MemoryReviewInboxView x:Name="InboxView" />
</Page>