<Project Sdk="Microsoft.NET.Sdk">

  <!--
    OpenBurnBar WinUI 3 shell spike (W6 / 0-b).
    Windows equivalent of the macOS AgentLens/ app target: Shell_NotifyIcon tray,
    a Mica-backed borderless flyout (NSPopover analog), a main window, and a live
    CLI-stream view wired to a STUB stream (real ConPTY source lands with W1/W2).

    UNPACKAGED (WindowsPackageType=None): the master plan ships direct-download +
    winget as the primary channel, and unpackaged is the simplest dev-host target
    (`dotnet run`). Shell_NotifyIcon + Mica both work unpackaged.

    LIVE verdict per VAL-P0-WINUI-016: "authored; build unproven until WINUI-017".
    A WinUI 3 app cannot be built to completion on macOS — the XAML compiler,
    MakePri, and the Windows App SDK MSBuild targets are Windows-only. See
    windows/app/DEV_HOST_RUNBOOK.md for the exact Windows build/run/record steps.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>OpenBurnBar.App</RootNamespace>
    <AssemblyName>OpenBurnBar.App</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Unpackaged: no MSIX identity; the Windows App Runtime bootstrapper auto-inits. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultLanguage>en-US</DefaultLanguage>
    <!-- Nullable, LangVersion, TreatWarningsAsErrors inherited from windows/Directory.Build.props -->
    <!--
      Lets the project be RESTORED/EVALUATED by MSBuild on a non-Windows host
      (macOS CI authoring) without the Windows targeting pack error NETSDK1100.
      It does NOT make the app buildable on macOS — it only unblocks tooling
      (restore / project evaluation / schema checks). Real compile stays on Windows.
    -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OpenBurnBarNativeEngineDirectory
      Condition="'$(OpenBurnBarNativeEngineDirectory)' == ''">$(MSBuildProjectDirectory)\..\..\native-engine\$(RuntimeIdentifier)</OpenBurnBarNativeEngineDirectory>
    <OpenBurnBarProjectCodeParserPath Condition="'$(OpenBurnBarProjectCodeParserPath)' == ''"></OpenBurnBarProjectCodeParserPath>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(OpenBurnBarNativeEngineDirectory)\OpenBurnBarCoreCAbi.dll')">
    <Content Include="$(OpenBurnBarNativeEngineDirectory)\*.dll"
             Exclude="$(OpenBurnBarNativeEngineDirectory)\openburnbar_domain_ffi.dll"
             Link="%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <!-- The managed quota binding imports this DLL by its bare name. Keep the
         Rust domain core explicit so a publish cannot silently omit it when the
         native-engine staging layout changes. -->
    <Content Include="$(OpenBurnBarNativeEngineDirectory)\openburnbar_domain_ffi.dll"
             Link="openburnbar_domain_ffi.dll"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Condition="Exists('$(OpenBurnBarNativeEngineDirectory)\openburnbar_domain_ffi.dll')" />
    <!-- Start the recursive glob at the engine root so %(RecursiveDir) retains
         the OpenBurnBarCore_OpenBurnBarCore.resources directory segment. -->
    <Content Include="$(OpenBurnBarNativeEngineDirectory)\**\*"
             Exclude="$(OpenBurnBarNativeEngineDirectory)\*.dll;$(OpenBurnBarNativeEngineDirectory)\native-engine-manifest.json"
             Link="%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(OpenBurnBarNativeEngineDirectory)\native-engine-manifest.json"
             Condition="Exists('$(OpenBurnBarNativeEngineDirectory)\native-engine-manifest.json')"
             Link="native-engine-manifest.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="RequireOpenBurnBarNativeEngine"
          BeforeTargets="Publish"
          Condition="'$(OpenBurnBarRequireNativeEngine)' == 'true'">
    <Error
      Condition="!Exists('$(OpenBurnBarNativeEngineDirectory)\OpenBurnBarCoreCAbi.dll')"
      Text="Required Windows parser engine is missing: $(OpenBurnBarNativeEngineDirectory)\OpenBurnBarCoreCAbi.dll" />
    <Error
      Condition="!Exists('$(OpenBurnBarNativeEngineDirectory)\openburnbar_domain_ffi.dll')"
      Text="Required shared domain core is missing: $(OpenBurnBarNativeEngineDirectory)\openburnbar_domain_ffi.dll" />
    <Error
      Condition="!Exists('$(OpenBurnBarNativeEngineDirectory)\OpenBurnBarCore_OpenBurnBarCore.resources')"
      Text="Required Swift resource bundle is missing: $(OpenBurnBarNativeEngineDirectory)\OpenBurnBarCore_OpenBurnBarCore.resources" />
    <Error
      Condition="!Exists('$(OpenBurnBarNativeEngineDirectory)\native-engine-manifest.json')"
      Text="Required native-engine manifest is missing: $(OpenBurnBarNativeEngineDirectory)\native-engine-manifest.json" />
  </Target>

  <ItemGroup Condition="Exists('$(OpenBurnBarProjectCodeParserPath)')">
    <Content Include="$(OpenBurnBarProjectCodeParserPath)"
             Link="ProjectCode\project-code-static-parser.exe"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="RequireOpenBurnBarProjectCodeParser"
          BeforeTargets="Publish"
          Condition="'$(OpenBurnBarRequireProjectCodeParser)' == 'true'">
    <Error
      Condition="!Exists('$(OpenBurnBarProjectCodeParserPath)')"
      Text="Required Windows project-code parser is missing: $(OpenBurnBarProjectCodeParserPath)" />
  </Target>

  <ItemGroup>
    <Using Include="Microsoft.UI" />
    <Using Include="Microsoft.UI.Text" />
    <Using Include="Microsoft.UI.Xaml.Automation" />
    <Using Remove="System.IO.Path" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Windows App SDK 1.8 (stable). Brings WinUI 3, MicaBackdrop, the bootstrapper,
      and Microsoft.Windows.SDK.BuildTools transitively (no separate ref needed).
      It also brings the WebView2 control (Microsoft.UI.Xaml.Controls.WebView2) and
      CoreWebView2 (Microsoft.Web.WebView2.Core) transitively — the offscreen
      Pretext text-layout host (Pretext/WebView2PretextHost.cs) uses those. If a
      Windows build ever needs to pin the WebView2 runtime independently, add an
      explicit Microsoft.Web.WebView2 PackageReference matching WindowsAppSDK 1.7.
    -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260508005" />
    <!--
      Win2D (Phase 3 / W6-DS-SWARM). The GPU renderer for the particle-engine
      substrate layer: CanvasAnimatedControl host + CanvasDrawingSession adapter in
      Particles/. Windows-only; the ParticleS RENDERER LOGIC lives in the
      platform-agnostic OpenBurnBar.Particles lib below, which builds + is
      perf-measured on macOS. Only this GPU binding is Windows/CI-deferred.
    -->
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.1" />
    <!--
      CommunityToolkit SettingsControls (Phase 3 / W7 — Settings lane). Brings the
      idiomatic SettingsCard / SettingsExpander used by the Settings leaf pages under
      Settings/. Default styles ship as compiled resources in the package (auto-resolved
      by each control's DefaultStyleKey), so no App.xaml merge is required. The
      SEARCH/routing logic these pages consume lives in the platform-agnostic
      OpenBurnBar.App.Settings library below, which builds + is unit-tested on macOS.
    -->
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.250402" />
  </ItemGroup>

  <ItemGroup>
    <!-- Engine-agnostic particle renderer core (model + painters + drawing seam). -->
    <ProjectReference Include="..\..\particles\OpenBurnBar.Particles\OpenBurnBar.Particles.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Portable Pretext text-layout bridge (W6-DS-PRETEXT). net8.0, no Windows deps —
      the transport-agnostic engine + protocol + metric-parity harness. The
      Windows-only WebView2 transport lives in Pretext/WebView2PretextHost.cs above.
    -->
    <ProjectReference Include="../../pretext/OpenBurnBar.Pretext/OpenBurnBar.Pretext.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Portable Settings shell + search core (W7 — Settings lane). net8.0, no Windows
      deps — the search index, ranking engine, manifest, router path logic, and
      route-display helpers the Settings/ WinUI pages consume. Unit-tested on macOS
      (windows/tests/settings/); the WinUI XAML that binds it is XamlCompiler-deferred.
    -->
    <ProjectReference Include="../OpenBurnBar.App.Settings/OpenBurnBar.App.Settings.csproj" />
    <ProjectReference Include="../OpenBurnBar.App.Settings.ViewModels/OpenBurnBar.App.Settings.ViewModels.csproj" />
    <!--
      Portable presentation layer (net8.0, no WinUI) for the SessionLogs + Memory
      surfaces (Phase 3 · W7): view-models, ported record types, grouping passes, and
      the transcript parser the XAML views under SessionLogs/ + Memory/ x:Bind to. It
      is unit-tested on macOS (windows/tests/presentation); these views are the Windows
      render of that same logic.
    -->
    <ProjectReference Include="../OpenBurnBar.App.Presentation/OpenBurnBar.App.Presentation.csproj" />
    <ProjectReference Include="../OpenBurnBar.App.MemorySearch/OpenBurnBar.App.MemorySearch.csproj" />
    <ProjectReference Include="../OpenBurnBar.App.UsageRuntime/OpenBurnBar.App.UsageRuntime.csproj" />
    <ProjectReference Include="../OpenBurnBar.App.Configuration/OpenBurnBar.App.Configuration.csproj" />
    <ProjectReference Include="../OpenBurnBar.App.ManagedAgentRuntime/OpenBurnBar.App.ManagedAgentRuntime.csproj" />
    <ProjectReference Include="../OpenBurnBar.App.PrivilegedInput/OpenBurnBar.App.PrivilegedInput.csproj" />
    <ProjectReference Include="../OpenBurnBar.App.CursorConnector/OpenBurnBar.App.CursorConnector.csproj" />
    <ProjectReference Include="../../computeruse/OpenBurnBar.ComputerUse.Core/OpenBurnBar.ComputerUse.Core.csproj" />
    <ProjectReference Include="../../computeruse/OpenBurnBar.ComputerUse.Windows/OpenBurnBar.ComputerUse.Windows.csproj" />
    <ProjectReference Include="../OpenBurnBar.App.CloudSync/OpenBurnBar.App.CloudSync.csproj" />
    <ProjectReference Include="../../cloudsync/appcheck/OpenBurnBar.CloudSync.AppCheck.Windows/OpenBurnBar.CloudSync.AppCheck.Windows.csproj" />
    <ProjectReference Include="../../packaging/updater/OpenBurnBar.Updater.Windows/OpenBurnBar.Updater.Windows.csproj" />
    <ProjectReference Include="../../storage/OpenBurnBar.Storage/OpenBurnBar.Storage.csproj" />
    <!--
      Quota ACQUISITION layer (Wave 1 item 5): the portable sources + coordinator
      feeding the landed Presentation/Quota parsers, and the Windows host half
      (default %LOCALAPPDATA%/%APPDATA% paths, FileSystemWatcher, statusline hook
      installer). Unit-tested on macOS (windows/tests/quota-acquisition).
    -->
    <ProjectReference Include="../OpenBurnBar.App.Quota.Acquisition/OpenBurnBar.App.Quota.Acquisition.csproj" />
    <ProjectReference Include="../OpenBurnBar.App.Quota.Acquisition.Windows/OpenBurnBar.App.Quota.Acquisition.Windows.csproj" />
    <!--
      Portable Dashboard layer (net8.0, no WinUI) for the Dashboard surface (Phase 3 ·
      W7, Bucket C): the layout-switch state machine + the FULL frame-stepped easter-egg
      particle SIMULATION (logo-storm / cloud-token-rain / boundary-pop) with its
      deterministic RNG and glyph sampler. Dashboard/DashboardPage + EasterEggCanvasHost
      STEP + draw this with Win2D; it is unit-tested on macOS (windows/tests/dashboard).
    -->
    <ProjectReference Include="../OpenBurnBar.App.Dashboard/OpenBurnBar.App.Dashboard.csproj" />
    <!--
      Portable PetCompanion core (net8.0, no WinUI) for the desktop pet (Phase 4 · G4):
      the behavior-graph interpreter, chat-event bridge (drives the graph from the
      landed Chat state machine), reaction brain, petdef parser, and the
      transport-agnostic glTF scene controller + embedded three.js shell. The WinUI
      Pet/ shell (PetOverlayWindow + WebView2PetGltfHost + PetChatBubbleView) renders
      it; it is unit-tested on macOS (windows/tests/pet).
    -->
    <ProjectReference Include="../OpenBurnBar.App.Pet/OpenBurnBar.App.Pet.csproj" />
    <!--
      Transparent click-through overlay PAL (net8.0). Provides the shared
      OverlayWindowStyle flag math + PerPixelHitTest + ExistingWindowOverlay helper
      the Pet overlay window styles its HWND with (WS_EX_LAYERED|TRANSPARENT|
      TOOLWINDOW|NOACTIVATE). Windows behaviour is P/Invoke; the flag math + hit-test
      are unit-tested on macOS (windows/tests/pet/Overlay).
    -->
    <ProjectReference Include="../../pal/overlay/OpenBurnBar.Pal.Overlay.csproj" />
    <ProjectReference Include="../../pal/ipc/OpenBurnBar.Pal.Ipc.csproj" />
    <ProjectReference Include="../../pal/ipc-windows/OpenBurnBar.Pal.Ipc.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      DLL-load hardening core (Phase 5 · R19 library-validation equivalent). net8.0, no WinUI.
      Provides OpenBurnBar.Dist.Hardening.DllSearchHardening.ApplyWinUICompatible(), which the
      app entry point calls at the very start of Main. The WinUI-compatible mode strips the CWD via
      SetDllDirectory("") while avoiding SetDefaultDllDirectories, which breaks Microsoft.UI.Xaml
      ms-appx resource lookup for unpackaged self-contained runs. See windows/dist/DLL_HARDENING.md
      for the exact wiring. The P/Invoke declarations restore on macOS; they only execute on Windows.
    -->
    <ProjectReference Include="../../dist/OpenBurnBar.Dist.Hardening/OpenBurnBar.Dist.Hardening.csproj" />
  </ItemGroup>

  <!--
    Shared WebGL2 kernel backdrop field (AgentLens/Resources/KernelBackdrop/).
    Copied beside the exe so KernelBackdropHost can map a virtual host to the folder
    and Navigate to index.html — the same offline bundle macOS WKWebView loads.
  -->
  <ItemGroup>
    <Content Include="..\..\..\AgentLens\Resources\KernelBackdrop\index.html"
             Link="Resources\KernelBackdrop\index.html"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\AgentLens\Resources\KernelBackdrop\kernel-backdrop.js"
             Link="Resources\KernelBackdrop\kernel-backdrop.js"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Brand + provider logos (macOS AppLogo / Linux openburnbar.png parity). -->
  <ItemGroup>
    <Content Include="Assets\AppLogo.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\AppLogo-32.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\AppLogo-64.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\AppLogo.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\ProviderLogos\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\packaging\updater\feed\latest-windows.json"
             Link="Resources\Updates\latest-windows.json"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\packaging\updater\feed\pinned-update-key.pub"
             Link="Resources\Updates\pinned-update-key.pub"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\OpenBurnBarDaemon\Resources\PlaywrightBridge\openburnbar-playwright-bridge.js"
             Link="Resources\PlaywrightBridge\openburnbar-playwright-bridge.js"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Managed PE-hardening props (Phase 5 · R19): HighEntropyVA + Deterministic so the shipped
    OpenBurnBar.App.exe gets full ASLR entropy + a reproducible image. The exact required
    flags are asserted against this file by windows/tests/dist (HardeningPolicy). Imported last
    so it wins over the SDK defaults. See windows/dist/DLL_HARDENING.md.
  -->
  <Import Project="../../dist/props/OpenBurnBar.Windows.Hardening.props" />

</Project>
