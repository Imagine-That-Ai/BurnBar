<?xml version="1.0" encoding="utf-8"?>
<!--
  ConstellationLayoutView — a centered command column: a search / Hermes bar over a
  full swarm stage (transparent — the backdrop is the stage), three stat pills, and a
  wrap of provider chips. Kernel-forward. Windows peer of ConstellationLayoutView.swift.
-->
<UserControl
    x:Class="OpenBurnBar.App.Dashboard.Layouts.ConstellationLayoutView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:theme="using:OpenBurnBar.App.Theme"
    xmlns:layouts="using:OpenBurnBar.App.Dashboard.Layouts"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="32">
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    MaxWidth="720"
                    Spacing="20">

            <!-- Search / Hermes command bar. -->
            <AutoSuggestBox PlaceholderText="Ask Hermes or search everything…"
                            QueryIcon="Find"
                            HorizontalAlignment="Stretch" />

            <!-- Three stat pills. -->
            <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
                <layouts:ConceptStatTile x:Name="SpendTile" Value="—" Caption="Spend"
                                         AccentBrush="{StaticResource PensieveColorBrassCoreBrush}" />
                <layouts:ConceptStatTile x:Name="TokensTile" Value="—" Caption="Tokens"
                                         AccentBrush="{StaticResource PensieveColorMercuryCoreBrush}" />
                <layouts:ConceptStatTile x:Name="ProvidersTile" Value="—" Caption="Data source"
                                         AccentBrush="{StaticResource OBBAccentBrush}" />
            </StackPanel>

            <!-- Data readiness. -->
            <Border Style="{StaticResource LiquidGlassSurfaceStyle}" theme:LiquidGlass.Surface="True" Padding="14,10"
                    CornerRadius="{StaticResource PensieveRadiusPillCorner}">
                <TextBlock x:Name="ProviderStatusText"
                           Text="Connect a SQLCipher database for live provider data"
                           TextWrapping="Wrap"
                           FontSize="12" />
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
