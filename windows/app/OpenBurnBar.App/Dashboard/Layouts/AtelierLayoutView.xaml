<?xml version="1.0" encoding="utf-8"?>
<!--
  AtelierLayoutView — the "keeper" (Windows peer of AtelierLayoutView.swift). A
  full-bleed kernel-forward hero: the live substrate backdrop is the hero, with a
  headline and three floating glass stat cards over it. Kernel-forward, so the view
  itself is mostly transparent and lets the DashboardBackdrop swarm read through.
-->
<UserControl
    x:Class="OpenBurnBar.App.Dashboard.Layouts.AtelierLayoutView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:layouts="using:OpenBurnBar.App.Dashboard.Layouts"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Hero headline, floating over the substrate. -->
        <StackPanel Grid.Row="0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Spacing="8"
                    MaxWidth="620">
            <TextBlock Text="Atelier"
                       FontSize="15"
                       Opacity="0.6"
                       FontWeight="SemiBold" />
            <TextBlock Text="Everything you burn, in one living field."
                       FontSize="40"
                       FontWeight="Bold"
                       TextWrapping="Wrap" />
            <TextBlock Text="Providers, models, and spend orbit the kernel in real time."
                       FontSize="16"
                       Opacity="0.7"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- Three floating glass stat cards. -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Spacing="16"
                    HorizontalAlignment="Left">
            <layouts:ConceptStatTile Value="$1,284" Caption="Spend this month"
                                     AccentBrush="{StaticResource PensieveColorBrassCoreBrush}" />
            <layouts:ConceptStatTile Value="18.4M" Caption="Tokens"
                                     AccentBrush="{StaticResource PensieveColorMercuryCoreBrush}" />
            <layouts:ConceptStatTile Value="7" Caption="Active providers"
                                     AccentBrush="{StaticResource OBBAccentBrush}" />
        </StackPanel>
    </Grid>
</UserControl>
