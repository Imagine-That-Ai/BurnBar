<?xml version="1.0" encoding="utf-8"?>
<!--
  AtelierLayoutView — macOS AtelierLayoutView.swift peer:
    wide (≥900): provider rail (300) | hero + stats
    narrow: stacked hero → stats → rail
-->
<UserControl
    x:Class="OpenBurnBar.App.Dashboard.Layouts.AtelierLayoutView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:layouts="using:OpenBurnBar.App.Dashboard.Layouts"
    xmlns:theme="using:OpenBurnBar.App.Theme"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    SizeChanged="OnSizeChanged">

    <!-- Wide layout (default for desktop) -->
    <Grid x:Name="WideRoot" Padding="28" ColumnSpacing="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="ProviderRail"
                Grid.Column="0"
                Style="{StaticResource LiquidGlassSurfaceStyle}"
                theme:LiquidGlass.Surface="True"
                CornerRadius="{StaticResource PensieveRadiusMdCorner}"
                Padding="14"
                MinHeight="320">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Providers"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="2,0,0,10"
                           Foreground="{ThemeResource AuroraTextBrush}" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ProviderList" Spacing="6" />
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid Grid.Column="1" RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Spacing="10"
                        MaxWidth="640">
                <Border Background="{ThemeResource AuroraGlassSelectionFillBrush}" CornerRadius="999" Padding="10,5" HorizontalAlignment="Left">
                    <TextBlock Text="WebGL kernel"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource OBBAccentBrush}" />
                </Border>
                <TextBlock Text="A living substrate, tuned to your spend."
                           FontSize="36"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource AuroraTextBrush}" />
                <TextBlock Text="Provider logos emerge from the kernel and dissolve back into it. Every layout is its own ecosystem — pick a concept, tune the glass."
                           FontSize="15"
                           Opacity="0.72"
                           TextWrapping="Wrap"
                           MaxWidth="460"
                           Foreground="{ThemeResource AuroraTextSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Spacing="16"
                        HorizontalAlignment="Left">
                <layouts:ConceptStatTile x:Name="SpendTile" Value="—" Caption="Spend this month"
                                         AccentBrush="{StaticResource PensieveColorBrassCoreBrush}" />
                <layouts:ConceptStatTile x:Name="TokensTile" Value="—" Caption="Tokens"
                                         AccentBrush="{StaticResource PensieveColorMercuryCoreBrush}" />
                <layouts:ConceptStatTile x:Name="ProvidersTile" Value="—" Caption="Data source"
                                         AccentBrush="{StaticResource OBBAccentBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
