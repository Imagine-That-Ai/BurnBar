<?xml version="1.0" encoding="utf-8"?>
<!--
  ClassicLayoutView — the information-dense vertical scroll overview (the safe
  fallback). Windows peer of the legacy DashboardOverviewView composition: a column of
  stat cards + lanes. Scrolling is provided by the DashboardPage's own ScrollViewer
  (which also probes offset for the easter-egg scroll-reversal summon), so this view is
  a plain column and never nests a second scroller.
-->
<UserControl
    x:Class="OpenBurnBar.App.Dashboard.Layouts.ClassicLayoutView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:OpenBurnBar.App.Components"
    xmlns:layouts="using:OpenBurnBar.App.Dashboard.Layouts"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Padding="24" Spacing="16" HorizontalAlignment="Stretch">
        <Grid ColumnSpacing="16" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <layouts:ConceptStatTile Grid.Column="0" x:Name="SpendTile" Value="—" Caption="Spend this month"
                                     AccentBrush="{StaticResource PensieveColorBrassCoreBrush}" />
            <layouts:ConceptStatTile Grid.Column="1" x:Name="TokensTile" Value="—" Caption="Tokens"
                                     AccentBrush="{StaticResource PensieveColorMercuryCoreBrush}" />
            <layouts:ConceptStatTile Grid.Column="2" x:Name="SessionsTile" Value="—" Caption="Sessions"
                                     AccentBrush="{StaticResource OBBAccentBrush}" />
        </Grid>

        <components:UnifiedGlassCard>
            <StackPanel Spacing="6">
                <TextBlock Text="Cost curve" FontSize="14" FontWeight="SemiBold" />
                <TextBlock x:Name="CostCurveText" Text="Connect a usage database for live trend data." FontSize="13" Opacity="0.7" />
            </StackPanel>
        </components:UnifiedGlassCard>

        <components:UnifiedGlassCard>
            <StackPanel Spacing="6">
                <TextBlock Text="Data source" FontSize="14" FontWeight="SemiBold" />
                <TextBlock x:Name="ProviderStatusText" Text="No SQLCipher database connected" FontSize="13" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>
        </components:UnifiedGlassCard>

        <components:UnifiedGlassCard>
            <StackPanel Spacing="6">
                <TextBlock Text="Models" FontSize="14" FontWeight="SemiBold" />
                <TextBlock x:Name="ModelsStatusText" Text="Connect a usage database for model spend and token rankings." FontSize="13" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>
        </components:UnifiedGlassCard>

        <components:UnifiedGlassCard>
            <StackPanel Spacing="6">
                <TextBlock Text="Activity" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Text="Recent sessions and runs." FontSize="13" Opacity="0.7" />
            </StackPanel>
        </components:UnifiedGlassCard>
    </StackPanel>
</UserControl>
