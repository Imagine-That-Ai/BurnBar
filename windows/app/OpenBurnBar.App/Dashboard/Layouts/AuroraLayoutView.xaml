<?xml version="1.0" encoding="utf-8"?>
<!--
  AuroraLayoutView — provider list (left) + open hero swarm field (centre, transparent
  so the backdrop reads through) + a bottom data band. Windows peer of AuroraLayoutView.swift.
-->
<UserControl
    x:Class="OpenBurnBar.App.Dashboard.Layouts.AuroraLayoutView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:OpenBurnBar.App.Components"
    xmlns:layouts="using:OpenBurnBar.App.Dashboard.Layouts"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" ColumnSpacing="20" RowSpacing="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Provider list panel. -->
        <components:UnifiedGlassCard Grid.Row="0" Grid.Column="0">
            <StackPanel Spacing="12">
                <TextBlock Text="Data source" FontSize="13" Opacity="0.6" FontWeight="SemiBold" />
                <TextBlock x:Name="ProviderStatusText"
                           Text="No SQLCipher database connected"
                           TextWrapping="Wrap"
                           FontSize="13" />
                <Border Height="1" Background="{ThemeResource AuroraGlassStrokeBrush}" Margin="0,4" />
                <TextBlock Text="Active providers" FontSize="12" Opacity="0.6" FontWeight="SemiBold" />
                <TextBlock x:Name="ActiveProvidersCountText" Text="—" FontSize="18" FontWeight="Bold" />
            </StackPanel>
        </components:UnifiedGlassCard>

        <!-- Focus Hero answer card: exactly one number above the fold. -->
        <components:UnifiedGlassCard Grid.Row="0" Grid.Column="1" Interactive="True">
            <StackPanel Spacing="16" VerticalAlignment="Center" HorizontalAlignment="Stretch" Padding="8">
                <TextBlock Text="BURN · FOCUS"
                           FontSize="12"
                           FontWeight="Bold"
                           CharacterSpacing="80"
                           Foreground="{StaticResource PensieveColorBrassBrightBrush}" />
                <TextBlock x:Name="HeroBurnText"
                           Text="—"
                           FontSize="54"
                           FontWeight="Bold"
                           FontFamily="{StaticResource OBBMonoFontFamily}"
                           Foreground="{StaticResource PensieveColorBrassBrightBrush}" />
                <TextBlock x:Name="FocusSentenceText"
                           Text="No spend recorded in this window yet."
                           FontSize="15"
                           Opacity="0.8"
                           TextWrapping="Wrap"
                           MaxWidth="620"
                           HorizontalAlignment="Left"
                           Foreground="{ThemeResource AuroraTextSecondaryBrush}" />
            </StackPanel>
        </components:UnifiedGlassCard>

        <!-- Bottom data band: star columns distribute slack across full width. -->
        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" ColumnSpacing="16" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <layouts:ConceptStatTile Grid.Column="0" x:Name="SpendTile" Value="—" Caption="Spend"
                                     AccentBrush="{StaticResource PensieveColorBrassCoreBrush}" />
            <layouts:ConceptStatTile Grid.Column="1" x:Name="TokensTile" Value="—" Caption="Tokens"
                                     AccentBrush="{StaticResource PensieveColorMercuryCoreBrush}" />
            <layouts:ConceptStatTile Grid.Column="2" x:Name="SessionsTile" Value="—" Caption="Sessions"
                                     AccentBrush="{StaticResource OBBAccentBrush}" />
        </Grid>
    </Grid>
</UserControl>
