<?xml version="1.0" encoding="utf-8"?>
<!--
  CockpitLayoutView — a mission-control grid: a spend-share provider rail, four KPI
  tiles (incl. cache hit), a routing swarm stage with TPS (transparent — backdrop reads
  through), and a cost curve + The Wand row. Windows peer of CockpitLayoutView.swift.
-->
<UserControl
    x:Class="OpenBurnBar.App.Dashboard.Layouts.CockpitLayoutView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:OpenBurnBar.App.Components"
    xmlns:layouts="using:OpenBurnBar.App.Dashboard.Layouts"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" ColumnSpacing="16" RowSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Spend-share provider rail & Alarms. -->
        <components:UnifiedGlassCard Grid.Row="0" Grid.RowSpan="2" Grid.Column="0">
            <StackPanel Spacing="14">
                <TextBlock Text="INSTRUMENTS &amp; ALARMS" FontSize="11" FontWeight="Bold" CharacterSpacing="80"
                           Foreground="{StaticResource PensieveColorBrassBrightBrush}" />
                <TextBlock x:Name="ProviderStatusText"
                           Text="No SQLCipher database connected"
                           TextWrapping="Wrap"
                           FontSize="13" />
                <Border Height="1" Background="{ThemeResource AuroraGlassStrokeBrush}" Margin="0,2" />
                <TextBlock Text="Alarms" FontSize="12" FontWeight="SemiBold" Opacity="0.7" />
                <StackPanel Spacing="6">
                    <TextBlock x:Name="AlarmUrgentText" Text="• Urgent queue: Nominal" FontSize="12" Opacity="0.8" />
                    <TextBlock x:Name="AlarmTodayText" Text="• Today queue: Nominal" FontSize="12" Opacity="0.8" />
                    <TextBlock x:Name="AlarmCacheText" Text="• Cache efficiency: Live" FontSize="12" Opacity="0.8" />
                </StackPanel>
            </StackPanel>
        </components:UnifiedGlassCard>

        <!-- Four KPI tiles: star columns distribute slack. -->
        <Grid Grid.Row="0" Grid.Column="1" ColumnSpacing="14" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <layouts:ConceptStatTile Grid.Column="0" x:Name="BurnTile" Value="—" Caption="Burn / day"
                                     AccentBrush="{StaticResource PensieveColorBrassCoreBrush}" />
            <layouts:ConceptStatTile Grid.Column="1" x:Name="TokensTile" Value="—" Caption="Tokens"
                                     AccentBrush="{StaticResource PensieveColorMercuryCoreBrush}" />
            <layouts:ConceptStatTile Grid.Column="2" x:Name="SessionsTile" Value="—" Caption="Sessions"
                                     AccentBrush="{StaticResource OBBAccentBrush}" />
            <layouts:ConceptStatTile Grid.Column="3" x:Name="CacheTile" Value="—" Caption="Cache hit"
                                     AccentBrush="{StaticResource PensieveColorTierEndToEndBrush}" />
        </Grid>

        <!-- Routing swarm stage (transparent — backdrop reads through). -->
        <Border Grid.Row="1" Grid.Column="1"
                CornerRadius="{StaticResource PensieveRadiusLgCorner}"
                BorderThickness="1"
                BorderBrush="{StaticResource OBBStrokeBrush}"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
                    <Border Background="{ThemeResource AuroraGlassSelectionFillBrush}" CornerRadius="999" Padding="8,4">
                        <TextBlock Text="forming · boids" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource OBBAccentBrush}" />
                    </Border>
                    <TextBlock x:Name="ActiveProvidersBadge" Text="0 providers active" FontSize="12" VerticalAlignment="Center" Opacity="0.75" />
                </StackPanel>
                <TextBlock Grid.Row="1" x:Name="RoutingStatusText"
                           Text="Live routing active across agent sessions"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Opacity="0.6"
                           FontSize="13" />
            </Grid>
        </Border>

        <!-- Cost curve + The Wand row. -->
        <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <components:UnifiedGlassCard Grid.Column="0">
                <StackPanel Spacing="4">
                    <TextBlock Text="Cost curve" FontSize="13" Opacity="0.6" FontWeight="SemiBold" />
                    <TextBlock x:Name="CostCurveText" Text="Connect a usage database for live trend data" FontSize="13" Opacity="0.7" />
                </StackPanel>
            </components:UnifiedGlassCard>
            <Button Grid.Column="1"
                    Content="The Wand"
                    VerticalAlignment="Stretch"
                    Style="{StaticResource LiquidGlassInteractiveStyle}" />
        </Grid>
    </Grid>
</UserControl>
