<?xml version="1.0" encoding="utf-8"?>
<!--
  DashboardPage — the Windows Dashboard surface (Phase 3 · W7, Bucket C). The nav
  destination "dashboard" routes here. It layers, back to front:
    1. the LANDED particle engine backdrop (DashboardBackdrop -> SwarmCanvasHost, a
       Win2D CanvasAnimatedControl) — the swarm/constellation/depth field;
    2. a depth scrim for legibility;
    3. the concept content: a top rail with the DashboardLayoutSwitcher over a
       ScrollViewer that hosts the selected one of the five concept layouts (+ Classic);
    4. a SECOND Win2D CanvasAnimatedControl (EasterEggCanvasHost) as a hit-test-disabled
       overlay running the frame-stepped easter-egg physics.
  Backdrop + easter-egg canvases are created in code-behind and inserted into the named
  hosts (the same pattern SurfaceStubPage uses for the live CLI stream).
-->
<Page
    x:Class="OpenBurnBar.App.Dashboard.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dashboard="using:OpenBurnBar.App.Dashboard"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{StaticResource PensieveColorInkBaseBrush}">
        <!-- 1. Landed particle-engine backdrop (Win2D). -->
        <Grid x:Name="BackdropHost" />

        <!-- 2. Depth scrim. -->
        <Border IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0.0" Color="#66070A12" />
                    <GradientStop Offset="0.5" Color="#1A070A12" />
                    <GradientStop Offset="1.0" Color="#66070A12" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- 3. Concept content. -->
        <Grid RowSpacing="8" Padding="16,12,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top rail: title + layout switcher. -->
            <Grid Grid.Row="0" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Dashboard"
                           VerticalAlignment="Center"
                           FontSize="22"
                           FontWeight="SemiBold" />
                <dashboard:DashboardLayoutSwitcher Grid.Column="1"
                                                   x:Name="Switcher"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
            </Grid>

            <!-- Selected concept, in a page-level scroller probed for easter-egg metrics. -->
            <ScrollViewer Grid.Row="1"
                          x:Name="ContentScroll"
                          VerticalScrollBarVisibility="Auto"
                          VerticalScrollMode="Enabled"
                          HorizontalScrollMode="Disabled"
                          ViewChanged="OnContentScrollViewChanged">
                <ContentPresenter x:Name="ContentHost" />
            </ScrollViewer>
        </Grid>

        <!-- 4. Easter-egg overlay canvas (Win2D), hit-test disabled. -->
        <Grid x:Name="EggHost" IsHitTestVisible="False" />
    </Grid>
</Page>
