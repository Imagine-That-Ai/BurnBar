<?xml version="1.0" encoding="utf-8"?>
<!--
  DashboardPage — the Windows Dashboard surface (Phase 3 · W7, Bucket C). Layers, back to front:
    1. WebGL2 KernelBackdrop (WebView2) when enabled + available;
    2. Win2D particle swarm (DashboardBackdrop) as fallback / dual layer when kernel is off;
    3. depth scrim for legibility;
    4. concept content (layout switcher + selected layout);
    5. Easter-egg overlay canvas.
-->
<Page
    x:Class="OpenBurnBar.App.Dashboard.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dashboard="using:OpenBurnBar.App.Dashboard"
    xmlns:theme="using:OpenBurnBar.App.Theme"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Background="Transparent">
        <!-- 1. WebGL2 kernel backdrop host (WebView2), hit-test disabled. -->
        <Grid x:Name="KernelHost" IsHitTestVisible="False" Visibility="Collapsed" />

        <!-- 2. Landed particle-engine backdrop (Win2D) — primary when kernel is off. -->
        <Grid x:Name="BackdropHost" />

        <!-- 3. Depth scrim. -->
        <Border IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0.0" Color="#66070A12" />
                    <GradientStop Offset="0.5" Color="#1A070A12" />
                    <GradientStop Offset="1.0" Color="#66070A12" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- 4. Concept content. -->
        <Grid RowSpacing="8" Padding="16,12,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top rail: title + layout switcher on a glass toolbar plate. -->
            <Border Grid.Row="0"
                    Style="{StaticResource LiquidGlassToolbarStyle}"
                    theme:LiquidGlass.Surface="True"
                    Margin="0,0,0,4">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Dashboard"
                               VerticalAlignment="Center"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PensieveColorTextBrightBrush}" />
                    <dashboard:DashboardLayoutSwitcher Grid.Column="1"
                                                       x:Name="Switcher"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Selected concept, in a page-level scroller probed for easter-egg metrics. -->
            <ScrollViewer Grid.Row="1"
                          x:Name="ContentScroll"
                          VerticalScrollBarVisibility="Auto"
                          VerticalScrollMode="Enabled"
                          HorizontalScrollMode="Disabled"
                          ViewChanged="OnContentScrollViewChanged">
                <ContentPresenter x:Name="ContentHost" />
            </ScrollViewer>
        </Grid>

        <!-- 5. Easter-egg overlay canvas (Win2D), hit-test disabled. -->
        <Grid x:Name="EggHost" IsHitTestVisible="False" />
    </Grid>
</Page>
