<?xml version="1.0" encoding="utf-8"?>
<!--
  Phase-3 tail: the nav-frame HOSTING page for the account-switcher surface. The AppShell content
  Frame navigates Page types (SurfacePageResolver.Resolve); the ported surface ships as the
  SwitcherSettingsView UserControl. This thin Page adapts the two so the "switcher" destination —
  destination #10 of the 12 in NavCatalog — renders its real surface instead of SurfaceStubPage.
  The code-behind seeds a SwitcherSettingsViewModel from the portable, unit-tested
  SwitcherSampleData store (the dev-host analog of BudgetPage's SeedRules) until the encrypted
  Windows profile store lands with the storage seam.
-->
<Page
    x:Class="OpenBurnBar.App.Switcher.SwitcherHostPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:switcher="using:OpenBurnBar.App.Switcher"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <switcher:SwitcherSettingsView x:Name="SwitcherView" />
</Page>
