<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows render of AgentLens/Views/Settings/AccountSwitcher/* (Phase 3 · W7 — Switcher lane).
  A provider-grouped account manager: a header (account count + Manual Add), a "CLI Profiles"
  section and a "Browser Profiles" section, each an ItemsControl over the portable
  SwitcherSettingsViewModel's CliSections / BrowserSections. Every section is a UnifiedGlassCard
  (the shared W6-DS-GLASS plate) carrying a provider header (ProviderLogoView for CLIs, a branded
  glyph for browsers), a summary line, a Connect / Add Account affordance, and its profile rows.

  Binds to OpenBurnBar.App.Presentation.Switcher.SwitcherSettingsViewModel + the row/section
  view-models, all unit-tested on macOS. This XAML compiles on Windows (XamlCompiler); on the
  macOS authoring host it is validated well-formed + reaches the compile gate.
-->
<UserControl
    x:Class="OpenBurnBar.App.Switcher.SwitcherSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:OpenBurnBar.App.Presentation.Switcher"
    xmlns:local="using:OpenBurnBar.App.Switcher"
    xmlns:views="using:OpenBurnBar.App.Views"
    xmlns:comp="using:OpenBurnBar.App.Components"
    xmlns:conv="using:OpenBurnBar.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <local:HexToBrushConverter x:Key="HexToBrush" />
        <SolidColorBrush x:Key="SwitcherActiveBrush" Color="#3FB950" />
        <SolidColorBrush x:Key="SwitcherPausedBrush" Color="#7D8590" />

        <!-- One profile row (SwitcherProfileRowViewModel). Referenced by both section templates. -->
        <DataTemplate x:Key="ProfileRowTemplate" x:DataType="vm:SwitcherProfileRowViewModel">
            <Grid ColumnSpacing="10" Padding="8,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Accent bar + active dot -->
                <Grid Grid.Column="0" Width="8">
                    <Border Width="3" Height="34" CornerRadius="2"
                            VerticalAlignment="Center"
                            Background="{x:Bind BrandColorHex, Converter={StaticResource HexToBrush}}" />
                    <Ellipse Width="7" Height="7"
                             Fill="{StaticResource SwitcherActiveBrush}"
                             VerticalAlignment="Bottom" HorizontalAlignment="Center"
                             Visibility="{x:Bind IsActive, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <!-- Identity -->
                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{x:Bind DisplayName}"
                                   FontSize="13"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource PensieveColorTextBrightBrush}" />
                        <Border CornerRadius="{StaticResource PensieveRadiusPillCorner}"
                                Background="{StaticResource SwitcherPausedBrush}"
                                Padding="6,1"
                                Visibility="{x:Bind IsDisabled, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Paused" FontSize="10" Foreground="White" />
                        </Border>
                        <Border CornerRadius="{StaticResource PensieveRadiusPillCorner}"
                                Background="{StaticResource SwitcherActiveBrush}"
                                Padding="6,1"
                                Visibility="{x:Bind IsConnected, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Logged in" FontSize="10" Foreground="White" />
                        </Border>
                        <Border CornerRadius="{StaticResource PensieveRadiusPillCorner}"
                                Background="{x:Bind BrandColorHex, Converter={StaticResource HexToBrush}, ConverterParameter=28}"
                                Padding="6,1"
                                Visibility="{x:Bind HasSlotLabel, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{x:Bind SlotLabel}"
                                       FontFamily="Cascadia Mono, Consolas"
                                       FontSize="10"
                                       Foreground="{x:Bind BrandColorHex, Converter={StaticResource HexToBrush}}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{x:Bind AccountIdentityText}"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource PensieveColorTextMuteBrush}" />
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Click="OnLaunchShell"
                            Style="{StaticResource LiquidGlassInteractiveStyle}"
                            ToolTipService.ToolTip="Launch CLI profile"
                            Visibility="{x:Bind CanLaunchShell, Converter={StaticResource BoolToVisibility}}">
                        <FontIcon Glyph="&#xE768;" FontSize="11" />
                    </Button>
                    <Button Content="Make Primary"
                            FontSize="11"
                            Click="OnMakePrimary"
                            Style="{StaticResource LiquidGlassInteractiveStyle}"
                            Visibility="{x:Bind CanSetPrimary, Converter={StaticResource BoolToVisibility}}" />
                    <Button Click="OnMoveUp" IsEnabled="{x:Bind CanMoveUp}"
                            Style="{StaticResource LiquidGlassInteractiveStyle}"
                            ToolTipService.ToolTip="Move up">
                        <FontIcon Glyph="&#xE70E;" FontSize="11" />
                    </Button>
                    <Button Click="OnMoveDown" IsEnabled="{x:Bind CanMoveDown}"
                            Style="{StaticResource LiquidGlassInteractiveStyle}"
                            ToolTipService.ToolTip="Move down">
                        <FontIcon Glyph="&#xE70D;" FontSize="11" />
                    </Button>
                    <Button Content="{x:Bind PauseResumeLabel}"
                            FontSize="11"
                            Click="OnTogglePause"
                            IsEnabled="{x:Bind CanToggleDisabled}"
                            Style="{StaticResource LiquidGlassInteractiveStyle}" />
                    <Button Click="OnChangeAccount"
                            Style="{StaticResource LiquidGlassInteractiveStyle}"
                            ToolTipService.ToolTip="Change account"
                            Visibility="{x:Bind CanChangeAccount, Converter={StaticResource BoolToVisibility}}">
                        <FontIcon Glyph="&#xE895;" FontSize="11" />
                    </Button>
                    <Button Click="OnEdit"
                            Style="{StaticResource LiquidGlassInteractiveStyle}"
                            ToolTipService.ToolTip="Edit">
                        <FontIcon Glyph="&#xE70F;" FontSize="11" />
                    </Button>
                    <Button Click="OnDelete"
                            Style="{StaticResource LiquidGlassInteractiveStyle}"
                            ToolTipService.ToolTip="Delete">
                        <FontIcon Glyph="&#xE74D;" FontSize="11" />
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- A CLI provider section (SwitcherGroupViewModel) -->
        <DataTemplate x:Key="CliSectionTemplate" x:DataType="vm:SwitcherGroupViewModel">
            <comp:UnifiedGlassCard Margin="0,0,0,10">
                <comp:UnifiedGlassCard.CardContent>
                    <StackPanel Spacing="6" Padding="14">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <comp:ProviderLogoView Grid.Column="0"
                                                   Width="28" Height="28"
                                                   VerticalAlignment="Center"
                                                   LogoSize="28"
                                                   UseFallbackColor="True"
                                                   Provider="{x:Bind local:SwitcherViewSupport.Brand(CliType)}" />
                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Label}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource PensieveColorTextBrightBrush}" />
                                <TextBlock Text="{x:Bind Summary}" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{StaticResource PensieveColorTextMuteBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ConnectedBadge}" FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource PensieveColorTextDimBrush}" />
                                <Button Content="{x:Bind AddButtonLabel}" FontSize="11"
                                        Click="OnAddAccount"
                                        Style="{StaticResource LiquidGlassInteractiveStyle}" />
                            </StackPanel>
                        </Grid>
                        <ItemsControl ItemsSource="{x:Bind Rows}"
                                      ItemTemplate="{StaticResource ProfileRowTemplate}" />
                    </StackPanel>
                </comp:UnifiedGlassCard.CardContent>
            </comp:UnifiedGlassCard>
        </DataTemplate>

        <!-- A browser provider section (SwitcherGroupViewModel) -->
        <DataTemplate x:Key="BrowserSectionTemplate" x:DataType="vm:SwitcherGroupViewModel">
            <comp:UnifiedGlassCard Margin="0,0,0,10">
                <comp:UnifiedGlassCard.CardContent>
                    <StackPanel Spacing="6" Padding="14">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14"
                                    VerticalAlignment="Center"
                                    Background="{x:Bind BrandColorHex, Converter={StaticResource HexToBrush}, ConverterParameter=30}">
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="14"
                                          Foreground="{x:Bind BrandColorHex, Converter={StaticResource HexToBrush}}" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Label}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource PensieveColorTextBrightBrush}" />
                                <TextBlock Text="{x:Bind Summary}" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{StaticResource PensieveColorTextMuteBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ConnectedBadge}" FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource PensieveColorTextDimBrush}" />
                                <Button Content="{x:Bind AddButtonLabel}" FontSize="11"
                                        Click="OnAddAccount"
                                        Style="{StaticResource LiquidGlassInteractiveStyle}" />
                            </StackPanel>
                        </Grid>
                        <ItemsControl ItemsSource="{x:Bind Rows}"
                                      ItemTemplate="{StaticResource ProfileRowTemplate}" />
                    </StackPanel>
                </comp:UnifiedGlassCard.CardContent>
            </comp:UnifiedGlassCard>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer Background="Transparent" Padding="24">
        <StackPanel Spacing="14" MaxWidth="820" HorizontalAlignment="Stretch">

            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{x:Bind ViewModel.CountLabel, Mode=OneWay}"
                               FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource PensieveColorTextBrightBrush}" />
                    <TextBlock Text="Manage provider accounts, keep reserves ready, and connect new logins without leaving BurnBar."
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource PensieveColorTextMuteBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Click="OnManualAdd" VerticalAlignment="Top"
                        Style="{StaticResource LiquidGlassInteractiveStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="12" Foreground="{StaticResource OBBAccentBrush}" />
                        <TextBlock Text="Manual Add" FontSize="12" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Error banner -->
            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     Severity="Error"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                     IsClosable="True" />

            <InfoBar x:Name="ShellErrorBar"
                     IsOpen="False"
                     Severity="Error"
                     IsClosable="True" />

            <!-- CLI section -->
            <TextBlock Text="CLI PROFILES" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource PensieveColorTextMuteBrush}" />
            <ItemsControl x:Name="CliList"
                          ItemsSource="{x:Bind ViewModel.CliSections, Mode=OneWay}"
                          ItemTemplate="{StaticResource CliSectionTemplate}" />

            <views:LiveCliStreamView x:Name="LiveShell"
                                     Height="280"
                                     Visibility="Collapsed" />

            <!-- Browser section -->
            <TextBlock Text="BROWSER PROFILES" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource PensieveColorTextMuteBrush}" />
            <ItemsControl x:Name="BrowserList"
                          ItemsSource="{x:Bind ViewModel.BrowserSections, Mode=OneWay}"
                          ItemTemplate="{StaticResource BrowserSectionTemplate}" />

            <TextBlock Text="Codex, Claude, and OpenCode stay available at the same time. Primary and reserve order only apply within the same provider, so switching Codex accounts never deactivates Claude."
                       FontSize="11" TextWrapping="Wrap"
                       Foreground="{StaticResource PensieveColorTextDimBrush}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
