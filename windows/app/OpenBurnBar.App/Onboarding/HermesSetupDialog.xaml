<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="OpenBurnBar.App.Onboarding.HermesSetupDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:theme="using:OpenBurnBar.App.Theme"
    Style="{StaticResource AuroraGlassDialogStyle}"
    Title="Prepare Hermes"
    PrimaryButtonText="Continue"
    SecondaryButtonText="Back"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryClicked"
    SecondaryButtonClick="OnSecondaryClicked">

    <!--
      Prepare-Hermes wizard — peer of HermesSetupWizardView.swift. Three steps (Prepare /
      Connect / Chat) driven by the portable, unit-tested HermesSetupModel. Live probe /
      config I/O is injected by the host through the optional action callbacks; the panels
      reflect the model's derived reachability + gating.
    -->
    <StackPanel Spacing="14" MinWidth="420" MaxWidth="460">
        <TextBlock x:Name="StepLabel" FontSize="11" Opacity="0.55" />

        <!-- Prepare -->
        <StackPanel x:Name="PreparePanel" Spacing="10">
            <TextBlock Text="OpenBurnBar needs the Hermes CLI and a local API-server key before it can reach the gateway."
                       Opacity="0.75" FontSize="13" TextWrapping="Wrap" />
            <Border Style="{StaticResource LiquidGlassSurfaceStyle}" theme:LiquidGlass.Surface="True" CornerRadius="8" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="CliStatus" FontSize="12.5" />
                    <TextBlock x:Name="ApiServerStatus" FontSize="12.5" />
                </StackPanel>
            </Border>
            <Button x:Name="CheckPrepareButton" Content="Check again" Click="OnCheckPrepare" />
        </StackPanel>

        <!-- Connect (reachability hero) -->
        <StackPanel x:Name="ConnectPanel" Spacing="10" Visibility="Collapsed">
            <Border Style="{StaticResource LiquidGlassSurfaceStyle}" theme:LiquidGlass.Surface="True" x:Name="ReachabilityHero"
                    CornerRadius="10"
                    Padding="14">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border x:Name="ReachabilityDot" Width="8" Height="8" CornerRadius="4"
                                VerticalAlignment="Center" />
                        <TextBlock x:Name="ReachabilityEyebrow" FontSize="10" Opacity="0.6"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="ReachabilityHeadline" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="ReachabilityDetail" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Button x:Name="ReachabilityAction" Content="Make Gateway Reachable" Click="OnMakeReachable" />
        </StackPanel>

        <!-- Chat -->
        <StackPanel x:Name="ChatPanel" Spacing="10" Visibility="Collapsed">
            <TextBlock Text="Send a test message to confirm the gateway answers."
                       Opacity="0.75" FontSize="13" TextWrapping="Wrap" />
            <Button x:Name="VerifyButton" Content="Run test chat" Click="OnRunVerification" />
            <Border Style="{StaticResource LiquidGlassSurfaceStyle}" theme:LiquidGlass.Surface="True" x:Name="VerificationResultBox"
                    CornerRadius="8"
                    Padding="12"
                    Visibility="Collapsed">
                <TextBlock x:Name="VerificationResult" FontSize="12.5" TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </StackPanel>
</ContentDialog>
