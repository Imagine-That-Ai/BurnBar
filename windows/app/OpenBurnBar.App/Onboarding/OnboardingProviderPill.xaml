<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="OpenBurnBar.App.Onboarding.OnboardingProviderPill"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:theme="using:OpenBurnBar.App.Theme"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
      Provider selection pill — Windows peer of OnboardingProviderPill.swift.
      A brand-colored badge + display name in a capsule, with selected (brand tint +
      thicker stroke) and detected (a small success dot in the top-trailing corner)
      states applied from code-behind. Tap toggles selection.
    -->
    <Grid>
        <Border Style="{StaticResource LiquidGlassSurfaceStyle}" x:Name="PillBorder"
                CornerRadius="999"
                Padding="12,6"
                Tapped="OnTapped"
                PointerEntered="OnPointerEntered"
                PointerExited="OnPointerExited">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border x:Name="LogoBadge" Width="18" Height="18" CornerRadius="5" />
                <TextBlock x:Name="NameText"
                           VerticalAlignment="Center"
                           FontSize="12.5"
                           MaxWidth="180"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <Ellipse x:Name="DetectedDot"
                 Width="6" Height="6"
                 Fill="#FF22C55E"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top"
                 Margin="0,2,2,0"
                 Visibility="Collapsed" />
    </Grid>
</UserControl>
