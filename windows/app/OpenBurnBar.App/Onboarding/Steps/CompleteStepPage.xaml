<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenBurnBar.App.Onboarding.CompleteStepPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Completion step — peer of OnboardingCompleteView.swift. -->
    <Grid RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="16" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border Width="72" Height="72" CornerRadius="36" HorizontalAlignment="Center"
                    Style="{StaticResource AuroraGlassAlertInfoStyle}">
                <TextBlock Text="&#x2713;" FontSize="40" FontWeight="SemiBold"
                           Foreground="{ThemeResource AuroraSuccessBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <TextBlock x:Name="Headline"
                       FontSize="16"
                       FontWeight="SemiBold"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center" />

            <TextBlock x:Name="Subtitle"
                       FontSize="12.5"
                       Opacity="0.7"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="380"
                       HorizontalAlignment="Center" />

            <Border x:Name="EmptyNote"
                    Style="{StaticResource AuroraGlassAlertWarningStyle}"
                    CornerRadius="8"
                    Padding="12,8"
                    MaxWidth="400"
                    Visibility="Collapsed">
                <TextBlock Text="No historical sessions were found. Your dashboard may look empty until your agents log new activity. You can trigger a manual scan anytime from the toolbar."
                           FontSize="11"
                           Opacity="0.7"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="8">
            <Button Content="Open Dashboard"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Click="OnOpenDashboard" />
            <Button Content="Stay in the tray"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalAlignment="Center"
                    FontSize="12.5"
                    Click="OnStayInTray" />
        </StackPanel>
    </Grid>
</Page>
