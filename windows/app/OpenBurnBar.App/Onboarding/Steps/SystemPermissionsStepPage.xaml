<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenBurnBar.App.Onboarding.SystemPermissionsStepPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
      System-permissions step — Windows peer of OnboardingSystemPermissionsView.swift.
      macOS grants (Accessibility, Automation, Screen Recording) don't exist on Windows;
      the parity mapping is the Windows-appropriate consent surface: notifications, launch
      at sign-in, and background activity. These are informational until the Windows PAL
      wires the real grant checks; the footer's "Continue (set up later)" honors that.
    -->
    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock Text="Windows permissions" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="OpenBurnBar works best with a few Windows permissions. You can grant these now or later from Settings."
                       Opacity="0.7"
                       FontSize="12.5"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">
                <Border Background="{StaticResource OBBSurfaceBrush}"
                        BorderBrush="{StaticResource OBBStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Notifications" FontSize="13.5" FontWeight="SemiBold" />
                        <TextBlock Text="Show toast alerts for burn-rate thresholds and finished agent sessions."
                                   Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource OBBSurfaceBrush}"
                        BorderBrush="{StaticResource OBBStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Launch at sign-in" FontSize="13.5" FontWeight="SemiBold" />
                        <TextBlock Text="Start OpenBurnBar in the tray when you sign in, so tracking never misses a session."
                                   Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource OBBSurfaceBrush}"
                        BorderBrush="{StaticResource OBBStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Background activity" FontSize="13.5" FontWeight="SemiBold" />
                        <TextBlock Text="Let OpenBurnBar watch your local agent logs while it runs in the background."
                                   Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
