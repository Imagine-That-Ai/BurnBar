<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenBurnBar.App.Onboarding.ChatEngineStepPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:theme="using:OpenBurnBar.App.Theme"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Chat-engine step — peer of OnboardingChatEngineView.swift. -->
    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock Text="Choose chat engines" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="OpenBurnBar attaches your local index as context to every query. Enable the backends you use — add or remove anytime in Settings."
                       Opacity="0.7"
                       FontSize="12.5"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">
                <Border theme:LiquidGlass.Surface="True"
                        CornerRadius="14"
                        BorderBrush="{StaticResource OBBStrokeBrush}"
                        BorderThickness="1"
                        Padding="12">
                    <StackPanel x:Name="BackendRows" Spacing="8" />
                </Border>

                <StackPanel x:Name="DefaultEngineRow" Spacing="6" Visibility="Collapsed">
                    <TextBlock Text="Default engine" FontSize="12.5" Opacity="0.7" />
                    <ComboBox x:Name="DefaultEngineCombo"
                              HorizontalAlignment="Left"
                              MinWidth="200"
                              SelectionChanged="OnDefaultEngineChanged" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="16">
            <Button Content="Check gateway health" Click="OnCheckGatewayHealth" />
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border x:Name="HermesDot" Width="8" Height="8" CornerRadius="4"
                            Background="{StaticResource OBBSystemBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Hermes" FontSize="11" Opacity="0.55" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border x:Name="OpenClawDot" Width="8" Height="8" CornerRadius="4"
                            Background="{StaticResource OBBSystemBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="OpenClaw" FontSize="11" Opacity="0.55" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
