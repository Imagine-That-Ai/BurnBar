<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenBurnBar.App.Onboarding.ScanStepPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:theme="using:OpenBurnBar.App.Theme"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Scanning-logs step — peer of OnboardingScanView.swift. -->
    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock Text="Scanning logs" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="OpenBurnBar is reading your agent logs and building a local operating picture — spend, sessions, and project context."
                       Opacity="0.7"
                       FontSize="12.5"
                       TextWrapping="Wrap" />
            <Border Style="{StaticResource LiquidGlassSurfaceStyle}" theme:LiquidGlass.Surface="True" CornerRadius="8" Padding="10">
                <TextBlock Text="The first scan parses your entire log history and may take a moment. Your dashboard fills in as sessions are discovered."
                           Opacity="0.55"
                           FontSize="11"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ProviderRows" Spacing="8" />
        </ScrollViewer>

        <StackPanel x:Name="BusyRow"
                    Grid.Row="2"
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="Collapsed">
            <ProgressRing x:Name="BusyRing" Width="18" Height="18" IsActive="False" />
            <TextBlock Text="Parsing session data…" Opacity="0.55" FontSize="11" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
