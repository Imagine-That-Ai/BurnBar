<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenBurnBar.App.Onboarding.TourStepPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:theme="using:OpenBurnBar.App.Theme"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Product tour step — peer of OnboardingTourView.swift. -->
    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock Text="What OpenBurnBar does" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="A quick look at the surfaces you'll use every day."
                       Opacity="0.7"
                       FontSize="12.5"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- Tour card (glass surface via the LiquidGlass chokepoint). -->
        <Border Grid.Row="1"
                theme:LiquidGlass.Surface="True"
                CornerRadius="14"
                BorderBrush="{StaticResource OBBStrokeBrush}"
                BorderThickness="1"
                Padding="28"
                VerticalAlignment="Center">
            <StackPanel Spacing="16" HorizontalAlignment="Center">
                <Border x:Name="TourBadge"
                        Width="56" Height="56"
                        CornerRadius="16"
                        HorizontalAlignment="Center">
                    <TextBlock x:Name="TourBadgeGlyph"
                               FontSize="24"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="White" />
                </Border>
                <TextBlock x:Name="TourTitle"
                           FontSize="16"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="TourDescription"
                           FontSize="12.5"
                           Opacity="0.7"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="360" />
            </StackPanel>
        </Border>

        <!-- Dots + chevron nav. -->
        <Grid Grid.Row="2" HorizontalAlignment="Center" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="PrevButton"
                    Grid.Column="0"
                    Content="&#x2039;"
                    FontSize="16"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnPrev" />

            <StackPanel x:Name="Dots" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" />

            <Button x:Name="NextButton"
                    Grid.Column="2"
                    Content="&#x203A;"
                    FontSize="16"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnNext" />
        </Grid>
    </Grid>
</Page>
