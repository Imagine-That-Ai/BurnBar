<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenBurnBar.App.Onboarding.ProvidersStepPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenBurnBar.App.Onboarding"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Provider cloud step — peer of OnboardingProviderCloudView.swift. -->
    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="12">
            <StackPanel Spacing="6">
                <TextBlock Text="Choose your agents" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Select the coding agents you use. OpenBurnBar highlighted the ones detected on this PC."
                           Opacity="0.7"
                           FontSize="12.5"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8"
                Padding="12"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="Mac database (optional)" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock
                        Text="If you copied your SQLCipher database from macOS, choose it here so session logs and dashboard use real data."
                        Opacity="0.7"
                        FontSize="11.5"
                        TextWrapping="Wrap" />
                    <TextBox x:Name="DbPathBox" PlaceholderText="Path to .sqlite file" />
                    <PasswordBox x:Name="DbPassphraseBox" PlaceholderText="Database passphrase" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="BrowseDbButton" Content="Browse…" Click="OnBrowseDb" />
                        <Button x:Name="SaveDbButton" Content="Save for this PC" Click="OnSaveDb" />
                    </StackPanel>
                    <TextBlock x:Name="DbStatusText" Opacity="0.55" FontSize="11" />
                </StackPanel>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
            <local:FlowLayoutPanel x:Name="ProviderCloud" HorizontalSpacing="8" VerticalSpacing="8" />
        </ScrollViewer>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="SelectAllDetectedButton"
                    Grid.Column="0"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="12.5"
                    Visibility="Collapsed"
                    Click="OnSelectAllDetected" />

            <TextBlock x:Name="SelectedCount"
                       Grid.Column="2"
                       VerticalAlignment="Center"
                       Opacity="0.55"
                       FontSize="11" />
        </Grid>
    </Grid>
</Page>