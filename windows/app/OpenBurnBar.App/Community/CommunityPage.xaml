<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenBurnBar.App.Community.CommunityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Background="{StaticResource PensieveColorInkBaseBrush}">
        <StackPanel Padding="24" MaxWidth="1100" Spacing="{StaticResource PensieveSpace6}">

            <StackPanel Spacing="4">
                <TextBlock Text="Community"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PensieveColorTextBrightBrush}" />
                <TextBlock Text="Anonymous rankings, percentile bands, and consent-first sharing."
                           Foreground="{StaticResource PensieveColorTextMuteBrush}" />
            </StackPanel>

            <Border Background="{StaticResource PensieveColorInkElevatedBrush}"
                    CornerRadius="{StaticResource PensieveRadiusMdCorner}"
                    Padding="20"
                    BorderBrush="{StaticResource PensieveColorGlassLineBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="Personal hero" FontWeight="SemiBold" />
                    <TextBlock x:Name="HeroTokensText" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock x:Name="HeroCostText" Foreground="{StaticResource PensieveColorTextMuteBrush}" />
                    <TextBlock x:Name="HeroTrendText" />
                    <TextBlock x:Name="HeroMixText" Foreground="{StaticResource PensieveColorTextMuteBrush}" TextWrapping="WrapWholeWords" />
                    <TextBlock x:Name="InviteText"
                               Foreground="{StaticResource PensieveColorTextMuteBrush}"
                               TextWrapping="WrapWholeWords"
                               Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <StackPanel Spacing="8">
                <TextBlock Text="Time filter" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="WinToday" Content="Today" Click="OnWindowClick" Tag="Today" />
                    <Button x:Name="Win7d" Content="7d" Click="OnWindowClick" Tag="SevenDay" />
                    <Button x:Name="Win30d" Content="30d" Click="OnWindowClick" Tag="ThirtyDay" />
                    <Button x:Name="Win90d" Content="90d" Click="OnWindowClick" Tag="NinetyDay" />
                    <Button x:Name="WinAll" Content="All" Click="OnWindowClick" Tag="All" />
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="LeaderboardHost" Spacing="12" />

            <Border Background="{StaticResource PensieveColorInkElevatedBrush}"
                    CornerRadius="{StaticResource PensieveRadiusMdCorner}"
                    Padding="20"
                    BorderBrush="{StaticResource PensieveColorGlassLineBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="Percentile strip" FontWeight="SemiBold" />
                    <TextBlock x:Name="PercentileText" TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource PensieveColorInkElevatedBrush}"
                    CornerRadius="{StaticResource PensieveRadiusMdCorner}"
                    Padding="20"
                    BorderBrush="{StaticResource PensieveColorGlassLineBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="Peer comparison (anonymized cohort)" FontWeight="SemiBold" />
                    <TextBlock x:Name="PeerText" TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource PensieveColorInkElevatedBrush}"
                    CornerRadius="{StaticResource PensieveRadiusMdCorner}"
                    Padding="20"
                    BorderBrush="{StaticResource PensieveColorGlassLineBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="Purpose breakdown" FontWeight="SemiBold" />
                    <TextBlock x:Name="PurposeText" TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource PensieveColorInkElevatedBrush}"
                    CornerRadius="{StaticResource PensieveRadiusMdCorner}"
                    Padding="20"
                    BorderBrush="{StaticResource PensieveColorGlassLineBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="Consent center" FontWeight="SemiBold" />
                    <TextBlock x:Name="ConsentPreviewText" TextWrapping="WrapWholeWords" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="L1 analytics" Click="OnL1Click" />
                        <Button Content="L2 rankings" Click="OnL2Click" />
                        <Button Content="L3 looking glass" Click="OnL3Click" />
                        <Button Content="Location" Click="OnLocationClick" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="City tier" Click="OnCityTierClick" />
                        <Button Content="Region tier" Click="OnRegionTierClick" />
                        <Button Content="Country tier" Click="OnCountryTierClick" />
                        <Button Content="World tier" Click="OnWorldTierClick" />
                    </StackPanel>
                    <Button Content="Pause / revoke participation" Click="OnRevokeClick" />
                    <TextBlock x:Name="StatusText" Foreground="{StaticResource PensieveColorTextMuteBrush}" TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>