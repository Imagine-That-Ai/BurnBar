<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows render of AgentLens/Views/Chat/HermesThinkingView.swift — three mercury
  droplets that pool and separate while Hermes is streaming but no text has
  arrived yet. The macOS view uses per-droplet keyframe phase math; here a single
  staggered Storyboard drives opacity + scale, tinted with the Aurora whimsy
  shimmer so the motion reads identically against the glass shell.
-->
<UserControl
    x:Class="OpenBurnBar.App.Chat.HermesThinkingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Storyboard x:Name="PulseStoryboard" RepeatBehavior="Forever">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot0" Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:0.0" Value="0.4" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.6" Value="1.0" />
                <LinearDoubleKeyFrame KeyTime="0:0:1.2" Value="0.4" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot1" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.2">
                <LinearDoubleKeyFrame KeyTime="0:0:0.0" Value="0.4" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.6" Value="1.0" />
                <LinearDoubleKeyFrame KeyTime="0:0:1.2" Value="0.4" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot2" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.4">
                <LinearDoubleKeyFrame KeyTime="0:0:0.0" Value="0.4" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.6" Value="1.0" />
                <LinearDoubleKeyFrame KeyTime="0:0:1.2" Value="0.4" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal" Spacing="5" Padding="16,10" VerticalAlignment="Center">
        <Ellipse x:Name="Dot0" Width="8" Height="8" Opacity="0.4"
                 Fill="{ThemeResource AuroraWhimsyBrush}" />
        <Ellipse x:Name="Dot1" Width="8" Height="8" Opacity="0.4"
                 Fill="{ThemeResource AuroraWhimsyBrush}" />
        <Ellipse x:Name="Dot2" Width="8" Height="8" Opacity="0.4"
                 Fill="{ThemeResource AuroraWhimsyBrush}" />
    </StackPanel>
</UserControl>
