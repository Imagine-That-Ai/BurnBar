<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows render of AgentLens/Views/Chat/HermesAtomComponents.swift `HermesAtomChip`
  — the atomic, tappable inline chip an atom run renders as. A leading kind glyph
  plus the atom label inside a brass-tinted pill; tapping raises Invoked so the
  host can navigate (the macOS HermesAtomRouter.open analog). Pretext lays this out
  as a break:never fragment so it never wraps across a line.
-->
<UserControl
    x:Class="OpenBurnBar.App.Chat.HermesAtomChip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border x:Name="ChipRoot"
            Padding="7,1,8,2"
            CornerRadius="7"
            Background="{StaticResource PensieveColorGlassBgElevatedBrush}"
            BorderThickness="1"
            BorderBrush="{StaticResource PensieveColorBrassGlowBrush}"
            Tapped="OnTapped"
            PointerEntered="OnPointerEntered"
            PointerExited="OnPointerExited">
        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <FontIcon x:Name="KindGlyph"
                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                      FontSize="10"
                      Foreground="{StaticResource PensieveColorBrassCoreBrush}" />
            <TextBlock x:Name="LabelText"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PensieveColorTextBrightBrush}" />
        </StackPanel>
    </Border>
</UserControl>
