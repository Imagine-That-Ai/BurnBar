<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows render of MissionSituationRoom (OpenBurnBarCore/.../MissionControl/MissionSituationRoom.swift).
  The live right column: pending approval asks (with Approve/Reject), active mission tiles
  (phase, runtime, snippet, burn, progress), and the recent activity ticker. Binds to the
  portable MissionConsoleViewModel snapshot lists; approvals route back through the view-model.
-->
<UserControl
    x:Class="OpenBurnBar.App.MissionControl.MissionSituationRoomView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mcp="using:OpenBurnBar.App.Presentation.MissionControl"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///MissionControl/MissionControlResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto" Padding="20,16">
        <StackPanel Spacing="20">

            <!-- Approvals -->
            <StackPanel Spacing="8"
                        Visibility="{x:Bind ViewModel.HasApprovals, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="NEEDS YOU" FontFamily="{StaticResource OBBMonoFontFamily}" FontSize="12"
                           FontWeight="Bold" Foreground="{StaticResource PensieveColorBrassBrightBrush}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.ApprovalAsks, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="mcp:MissionApprovalAsk">
                            <Border Margin="0,0,0,8" Padding="12"
                                    CornerRadius="{StaticResource PensieveRadiusMdCorner}"
                                    Background="#1AE8A93C"
                                    BorderBrush="#59E8A93C"
                                    BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{x:Bind Title}" FontSize="13" FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource AuroraTextBrush}" />
                                    <TextBlock Text="{x:Bind Message}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{ThemeResource AuroraTextSecondaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Approve" Tag="{x:Bind Id}" Click="Approve_Click"
                                                Style="{StaticResource LiquidGlassInteractiveStyle}" />
                                        <Button Content="Reject" Tag="{x:Bind Id}" Click="Reject_Click"
                                                Style="{StaticResource LiquidGlassInteractiveStyle}" />
                                        <TextBlock Text="{x:Bind RequestedLabel}" FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource AuroraTextMutedBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Active tiles -->
            <StackPanel Spacing="8">
                <TextBlock Text="IN FLIGHT" FontFamily="{StaticResource OBBMonoFontFamily}" FontSize="12"
                           FontWeight="Bold" Foreground="{ThemeResource AuroraTextMutedBrush}" />

                <TextBlock Text="No missions in flight. Compose one on the left."
                           FontSize="12" TextWrapping="Wrap"
                           Foreground="{ThemeResource AuroraTextMutedBrush}"
                           Visibility="{x:Bind ViewModel.HasActiveTiles, Mode=OneWay, Converter={StaticResource NegatedBoolToVisibility}}" />

                <ItemsControl ItemsSource="{x:Bind ViewModel.ActiveTiles, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="mcp:MissionActiveTile">
                            <Border Margin="0,0,0,8" Padding="12"
                                    CornerRadius="{StaticResource PensieveRadiusMdCorner}"
                                    Background="{StaticResource PensieveColorGlassBgElevatedBrush}"
                                    BorderBrush="{StaticResource PensieveColorGlassLineBrush}"
                                    BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <Grid>
                                        <TextBlock Text="{x:Bind Title}" FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" HorizontalAlignment="Left"
                                                   Foreground="{ThemeResource AuroraTextBrush}" />
                                        <TextBlock Text="{x:Bind BurnLabel}" HorizontalAlignment="Right"
                                                   FontFamily="{StaticResource OBBMonoFontFamily}" FontSize="12"
                                                   Foreground="{ThemeResource AuroraTextSecondaryBrush}" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Padding="6,1"
                                                CornerRadius="{StaticResource PensieveRadiusPillCorner}"
                                                Background="{ThemeResource AuroraGlassStrokeFrostBrush}">
                                            <TextBlock Text="{x:Bind PhaseLabel}"
                                                       FontFamily="{StaticResource OBBMonoFontFamily}" FontSize="10"
                                                       Foreground="{x:Bind IsProblem, Converter={StaticResource ProblemBrush}}" />
                                        </Border>
                                        <TextBlock Text="{x:Bind RuntimeDisplayLabel}" FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource AuroraTextMutedBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind LastEventSnippet}" FontSize="12" TextWrapping="Wrap"
                                               MaxLines="2"
                                               Visibility="{x:Bind HasSnippet, Converter={StaticResource BoolToVisibility}}"
                                               Foreground="{ThemeResource AuroraTextSecondaryBrush}" />
                                    <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind ProgressPercent}"
                                                 Height="3" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Ticker -->
            <StackPanel Spacing="8"
                        Visibility="{x:Bind ViewModel.HasTicker, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="ACTIVITY" FontFamily="{StaticResource OBBMonoFontFamily}" FontSize="12"
                           FontWeight="Bold" Foreground="{ThemeResource AuroraTextMutedBrush}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.RecentTicker, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="mcp:MissionTickerEntry">
                            <Grid Padding="0,4" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="6" Height="6" VerticalAlignment="Top" Margin="0,4,0,0"
                                         Fill="{x:Bind IsError, Converter={StaticResource ProblemBrush}}" />
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock Text="{x:Bind Message}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{ThemeResource AuroraTextSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind PathDetail}" FontSize="10"
                                               FontFamily="{StaticResource OBBMonoFontFamily}"
                                               Visibility="{x:Bind HasPathDetail, Converter={StaticResource BoolToVisibility}}"
                                               Foreground="{ThemeResource AuroraTextMutedBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{x:Bind TimeLabel}" FontSize="10"
                                           VerticalAlignment="Top"
                                           Foreground="{ThemeResource AuroraTextMutedBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
