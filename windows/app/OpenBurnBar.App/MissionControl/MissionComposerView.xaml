<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows render of the console composer column (MissionControlConsoleView.composerColumn +
  MissionKindChooser / MissionComposerControls / MissionBurnForecast). The left column:
  kind chooser, runtime constellation, title + prompt, depth dial, approval lever, permission
  toggles, target project, the forecast strip, an inline error banner, and the dispatch CTA.
  Binds to the portable MissionConsoleViewModel; all copy/selection/forecast is unit-tested.
-->
<UserControl
    x:Class="OpenBurnBar.App.MissionControl.MissionComposerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenBurnBar.App.MissionControl"
    xmlns:mcp="using:OpenBurnBar.App.Presentation.MissionControl"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///MissionControl/MissionControlResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Spacing="20">

        <!-- 01 · KIND -->
        <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="01 · KIND" FontFamily="{StaticResource OBBMonoFontFamily}" FontSize="12"
                           FontWeight="Bold" Foreground="{ThemeResource AuroraTextMutedBrush}"
                           VerticalAlignment="Center" />
                <Border Height="1" Width="200" VerticalAlignment="Center"
                        Background="{StaticResource PensieveColorGlassLineBrush}" Opacity="0.6" />
            </StackPanel>

            <ScrollViewer HorizontalScrollMode="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollMode="Disabled"
                          VerticalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="KindChips" ItemsSource="{x:Bind ViewModel.KindChips, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="mcp:MissionKindChipItem">
                        <Button Tag="{x:Bind Tag}" Click="Kind_Click"
                                Padding="12,8"
                                CornerRadius="{StaticResource PensieveRadiusPillCorner}"
                                Background="{StaticResource PensieveColorGlassBgElevatedBrush}"
                                BorderBrush="{StaticResource PensieveColorGlassLineBrush}"
                                BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="13" Glyph="{x:Bind Glyph}"
                                          Foreground="{StaticResource OBBAccentBrush}" />
                                <TextBlock Text="{x:Bind DisplayName}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{ThemeResource AuroraTextBrush}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>

            <TextBlock Text="{x:Bind ViewModel.KindTagline, Mode=OneWay}"
                       FontSize="12" Foreground="{ThemeResource AuroraTextSecondaryBrush}" />
        </StackPanel>

        <!-- 02 · RUNTIME -->
        <local:MissionRuntimeConstellationView x:Name="Constellation" />

        <!-- 03 · BRIEF -->
        <StackPanel Spacing="8">
            <TextBlock Text="03 · BRIEF" FontFamily="{StaticResource OBBMonoFontFamily}" FontSize="12"
                       FontWeight="Bold" Foreground="{ThemeResource AuroraTextMutedBrush}" />
            <TextBox x:Name="TitleBox"
                     Header="Title (optional)"
                     PlaceholderText="Name this mission…"
                     Text="{x:Bind ViewModel.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox x:Name="PromptBox"
                     Header="Prompt"
                     PlaceholderText="What should the agent do?"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="96"
                     Text="{x:Bind ViewModel.Prompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <!-- 04 · DEPTH + APPROVAL -->
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="6">
                <TextBlock Text="DEPTH" FontFamily="{StaticResource OBBMonoFontFamily}" FontSize="11"
                           Foreground="{ThemeResource AuroraTextMutedBrush}" />
                <RadioButtons x:Name="DepthChoice" MaxColumns="1" SelectionChanged="Depth_SelectionChanged">
                    <RadioButton Content="Light" />
                    <RadioButton Content="Standard" />
                    <RadioButton Content="Deep" />
                </RadioButtons>
                <TextBlock x:Name="DepthSubtitle" FontSize="12"
                           Foreground="{ThemeResource AuroraTextSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock Text="APPROVAL" FontFamily="{StaticResource OBBMonoFontFamily}" FontSize="11"
                           Foreground="{ThemeResource AuroraTextMutedBrush}" />
                <RadioButtons x:Name="ApprovalChoice" MaxColumns="1" SelectionChanged="Approval_SelectionChanged">
                    <RadioButton Content="Honor existing policy" />
                    <RadioButton Content="Require my approval" />
                </RadioButtons>
                <TextBlock x:Name="ApprovalCaption" FontSize="12" TextWrapping="Wrap"
                           Foreground="{ThemeResource AuroraTextSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- 05 · PERMISSIONS -->
        <StackPanel Spacing="6">
            <TextBlock Text="05 · PERMISSIONS" FontFamily="{StaticResource OBBMonoFontFamily}" FontSize="12"
                       FontWeight="Bold" Foreground="{ThemeResource AuroraTextMutedBrush}" />
            <ToggleSwitch Header="Allow shell commands"
                          IsOn="{x:Bind ViewModel.CommandsAllowed, Mode=TwoWay}" />
            <ToggleSwitch Header="Allow file edits"
                          IsOn="{x:Bind ViewModel.FileEditsAllowed, Mode=TwoWay}" />
        </StackPanel>

        <!-- 06 · PROJECT -->
        <StackPanel Spacing="6">
            <TextBlock Text="06 · PROJECT" FontFamily="{StaticResource OBBMonoFontFamily}" FontSize="12"
                       FontWeight="Bold" Foreground="{ThemeResource AuroraTextMutedBrush}" />
            <TextBox x:Name="ProjectBox"
                     PlaceholderText="Target project (defaults to scratch)"
                     Text="{x:Bind ViewModel.TargetProject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <!-- Forecast -->
        <local:MissionBurnForecastView x:Name="Forecast" />

        <!-- Inline error -->
        <Border x:Name="ErrorBanner"
                Padding="12"
                CornerRadius="{StaticResource PensieveRadiusSmCorner}"
                Background="{ThemeResource AuroraGlassSelectionFillBrush}"
                BorderBrush="{ThemeResource AuroraGlassSelectionStrokeBrush}"
                BorderThickness="1"
                Visibility="{x:Bind ViewModel.HasInlineError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" FontFamily="Segoe MDL2 Assets" Glyph="&#xEA39;" FontSize="14"
                          Foreground="{ThemeResource AuroraErrorBrush}" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="Dispatch failed" FontSize="12" FontWeight="SemiBold"
                               Foreground="{ThemeResource AuroraErrorBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.InlineError, Mode=OneWay}" FontSize="13" TextWrapping="Wrap"
                               Foreground="{ThemeResource AuroraTextSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="2" Click="ClearError_Click" Style="{StaticResource LiquidGlassCircleButtonStyle}">
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE711;" FontSize="11" />
                </Button>
            </Grid>
        </Border>

        <!-- Dispatch CTA -->
        <Button x:Name="DispatchButton"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Padding="16,12"
                CornerRadius="{StaticResource PensieveRadiusMdCorner}"
                Background="{x:Bind ViewModel.RuntimeAccentKey, Mode=OneWay, Converter={StaticResource ProviderBrush}}"
                IsEnabled="{x:Bind ViewModel.CanDispatch, Mode=OneWay}"
                Click="Dispatch_Click">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ProgressRing Width="16" Height="16"
                              IsActive="{x:Bind ViewModel.IsDispatching, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.IsDispatching, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE724;" FontSize="14"
                          Foreground="White"
                          Visibility="{x:Bind ViewModel.IsDispatching, Mode=OneWay, Converter={StaticResource NegatedBoolToVisibility}}" />
                <TextBlock Text="{x:Bind ViewModel.DispatchLabel, Mode=OneWay}" FontSize="15" FontWeight="Bold"
                           Foreground="White" />
            </StackPanel>
        </Button>

    </StackPanel>
</UserControl>
