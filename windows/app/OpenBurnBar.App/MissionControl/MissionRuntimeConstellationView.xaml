<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows render of MissionRuntimeConstellation
  (OpenBurnBarCore/.../MissionControl/MissionRuntimeConstellation.swift). A horizontal row of
  agent capability cards: AUTO first, then each advertised runtime. Each card carries a
  provider-tinted accent stripe, call-sign, availability dot, subtitle, and a "Preferred for
  {kind}" hint. Binds to MissionConsoleViewModel.ConstellationItems (portable, unit-tested);
  tapping a card sets the draft runtime.
-->
<UserControl
    x:Class="OpenBurnBar.App.MissionControl.MissionRuntimeConstellationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mcp="using:OpenBurnBar.App.Presentation.MissionControl"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///MissionControl/MissionControlResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Spacing="8">
        <!-- Section header -->
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="02 · RUNTIME"
                       FontFamily="{StaticResource OBBMonoFontFamily}"
                       FontSize="12"
                       FontWeight="Bold"
                       Foreground="{StaticResource PensieveColorTextMuteBrush}"
                       VerticalAlignment="Center" />
            <Border Height="1" Width="200" VerticalAlignment="Center"
                    Background="{StaticResource PensieveColorGlassLineBrush}" Opacity="0.6" />
        </StackPanel>

        <ScrollViewer HorizontalScrollMode="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollMode="Disabled"
                      VerticalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="Cards" ItemsSource="{x:Bind ViewModel.ConstellationItems, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="mcp:MissionRuntimeCardItem">
                        <Button Width="176" Height="112"
                                Padding="0"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Background="{StaticResource PensieveColorGlassBgElevatedBrush}"
                                BorderBrush="{StaticResource PensieveColorGlassLineBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource PensieveRadiusMdCorner}"
                                Tag="{x:Bind Id}"
                                Click="Card_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Provider accent stripe -->
                                <Border Grid.Column="0"
                                        Background="{x:Bind ProviderKey, Converter={StaticResource ProviderBrush}}" />

                                <StackPanel Grid.Column="1" Spacing="6" Padding="12,10">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                                 Fill="{x:Bind Availability, Converter={StaticResource AvailabilityBrush}}" />
                                        <TextBlock Text="{x:Bind CallSign}"
                                                   FontFamily="{StaticResource OBBMonoFontFamily}"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="{x:Bind ProviderKey, Converter={StaticResource ProviderBrush}}" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind DisplayName}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource PensieveColorTextBrightBrush}" />
                                    <TextBlock Text="{x:Bind Subtitle}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               MaxLines="2"
                                               Foreground="{StaticResource PensieveColorTextBaseBrush}" />
                                    <TextBlock Text="{x:Bind PreferredLabel}"
                                               FontFamily="{StaticResource OBBMonoFontFamily}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PensieveColorBrassBrightBrush}"
                                               Visibility="{x:Bind ShowsPreferredHint, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </StackPanel>
</UserControl>
