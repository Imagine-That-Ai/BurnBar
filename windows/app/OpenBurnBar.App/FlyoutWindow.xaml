<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="OpenBurnBar.App.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:OpenBurnBar.App.Views">

    <Border Padding="14" CornerRadius="{StaticResource OBBCardCornerRadius}">
        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Flyout header. -->
            <Grid Grid.Row="0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Width="10" Height="10" CornerRadius="5"
                        VerticalAlignment="Center"
                        Background="{StaticResource OBBAccentBrush}" />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Text="OpenBurnBar"
                           FontWeight="SemiBold" />
                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           Opacity="0.6"
                           FontSize="12"
                           Text="live" />
            </Grid>

            <!-- Compact live CLI stream. -->
            <views:LiveCliStreamView x:Name="StreamView" Grid.Row="1" Compact="True" />

            <!-- Footer action opens the full window. -->
            <HyperlinkButton Grid.Row="2"
                             HorizontalAlignment="Left"
                             Content="Open full window"
                             Click="OpenFull_Click" />
        </Grid>
    </Border>
</Window>
