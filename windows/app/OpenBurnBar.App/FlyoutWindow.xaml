<?xml version="1.0" encoding="utf-8"?>
<!--
  Tray flyout — macOS MenuBarPopoverView region stack:
  header · freshness · quotas · scroll (summary/providers/insights) · cloud · actions
-->
<Window
    x:Class="OpenBurnBar.App.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:OpenBurnBar.App.Components"
    xmlns:theme="using:OpenBurnBar.App.Theme"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">

    <Grid Background="Transparent">
        <Border x:Name="WindowBlendScrim" IsHitTestVisible="False" />

        <Border Padding="0"
                CornerRadius="{StaticResource PensieveRadiusXlCorner}"
                Style="{StaticResource LiquidGlassSurfaceStyle}"
                theme:LiquidGlass.Surface="True"
                Background="{ThemeResource AuroraGlassTintElevatedBrush}"
                Margin="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 1. Header -->
                <Border Grid.Row="0" Padding="16,12" theme:LiquidGlass.Surface="True"
                        Background="{ThemeResource AuroraGlassTintClearBrush}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <components:AppLogoView Grid.Column="0" Size="28" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="OpenBurnBar"
                                   Style="{StaticResource AuroraHeadlineTextStyle}"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource AuroraTextBrush}" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                            <Button x:Name="ScanButton"
                                    Style="{StaticResource LiquidGlassCircleButtonStyle}"
                                    theme:LiquidGlass.CircleButtonDiameter="28"
                                    ToolTipService.ToolTip="Import sessions"
                                    AutomationProperties.Name="Scan provider activity"
                                    Click="Scan_Click">
                                <FontIcon Glyph="&#xE72C;" FontSize="11"
                                          Foreground="{ThemeResource AuroraTextSecondaryBrush}" />
                            </Button>
                            <Button Style="{StaticResource LiquidGlassCircleButtonStyle}"
                                    theme:LiquidGlass.CircleButtonDiameter="28"
                                    ToolTipService.ToolTip="Settings"
                                    Click="Settings_Click">
                                <FontIcon Glyph="&#xE713;" FontSize="11"
                                          Foreground="{ThemeResource AuroraTextSecondaryBrush}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. Freshness -->
                <Border Grid.Row="1" Padding="16,8"
                        Background="{ThemeResource AuroraGlassTintSunkenBrush}">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Border Width="6" Height="6" CornerRadius="3"
                                    Background="{ThemeResource AuroraSuccessBrush}" />
                            <TextBlock x:Name="FreshnessText" Text="Updated just now"
                                       Style="{StaticResource AuroraTinyTextStyle}"
                                       Foreground="{ThemeResource AuroraTextMutedBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                            <TextBlock x:Name="FreshnessMetric" Text="$0.00" FontSize="11"
                                       FontFamily="{StaticResource AuroraMonoFont}"
                                       Foreground="{StaticResource OBBAccentBrush}" />
                            <TextBlock Text="·" FontSize="11"
                                       Foreground="{ThemeResource AuroraTextMutedBrush}" />
                            <TextBlock x:Name="FreshnessSessions" Text="0 sessions" FontSize="11"
                                       Foreground="{ThemeResource AuroraTextMutedBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 3. Quota rail -->
                <Border Grid.Row="2" Padding="16,10"
                        BorderBrush="{ThemeResource AuroraGlassStrokeBrush}"
                        BorderThickness="0,1,0,1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="QUOTAS" CharacterSpacing="80"
                                   Style="{StaticResource AuroraStatCardLabelStyle}" />
                        <StackPanel x:Name="QuotaHost" Spacing="6" />
                    </StackPanel>
                </Border>

                <!-- 4. Scroll body -->
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="12,8">
                    <StackPanel Spacing="14">
                        <!-- Summary -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="SUMMARY" CharacterSpacing="80"
                                       Style="{StaticResource AuroraStatCardLabelStyle}" />
                            <TextBlock x:Name="SummaryToday" Text="$0.00"
                                       Style="{StaticResource AuroraMonoLargeTextStyle}" />
                            <TextBlock Text="today"
                                       Style="{StaticResource AuroraTinyTextStyle}"
                                       Foreground="{ThemeResource AuroraTextMutedBrush}" />
                            <Grid ColumnSpacing="12" Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="This week"
                                               Style="{StaticResource AuroraTinyTextStyle}"
                                               Foreground="{ThemeResource AuroraTextMutedBrush}" />
                                    <TextBlock x:Name="SummaryWeek" Text="$0.00"
                                               Style="{StaticResource AuroraMonoTextStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="This month"
                                               Style="{StaticResource AuroraTinyTextStyle}"
                                               Foreground="{ThemeResource AuroraTextMutedBrush}" />
                                    <TextBlock x:Name="SummaryMonth" Text="$0.00"
                                               Style="{StaticResource AuroraMonoTextStyle}" />
                                </StackPanel>
                            </Grid>
                            <Canvas x:Name="SummarySpark" Height="28" Margin="0,6,0,0" />
                        </StackPanel>

                        <!-- Providers -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="PROVIDERS" CharacterSpacing="80"
                                       Style="{StaticResource AuroraStatCardLabelStyle}" />
                            <StackPanel x:Name="ProviderHost" Spacing="4" />
                        </StackPanel>

                        <!-- Insights -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="INSIGHTS" CharacterSpacing="80"
                                       Style="{StaticResource AuroraStatCardLabelStyle}" />
                            <StackPanel x:Name="InsightHost" Spacing="6" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- 5. Cloud strip -->
                <Border Grid.Row="4" Padding="14,10"
                        BorderBrush="{ThemeResource AuroraGlassStrokeBrush}"
                        BorderThickness="0,1,0,0"
                        Background="{ThemeResource AuroraGlassSelectionFillBrush}">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="28" Height="28" CornerRadius="14"
                                Background="{ThemeResource AuroraGlassTintElevatedBrush}">
                            <FontIcon Glyph="&#xE753;" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Foreground="{StaticResource OBBAccentBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="Cloud Pro unlocks multi-device sync"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{ThemeResource AuroraTextBrush}" />
                            <TextBlock Text="Free plan · sample mode"
                                       FontSize="11"
                                       Foreground="{ThemeResource AuroraTextMutedBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 6. Action bar -->
                <Grid Grid.Row="5" Padding="12,10" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Dashboard" HorizontalAlignment="Stretch"
                            Style="{StaticResource AuroraGlassButtonProminentStyle}"
                            Click="OpenFull_Click" />
                    <Button Grid.Column="1" Content="Settings" HorizontalAlignment="Stretch"
                            Style="{StaticResource AuroraGlassButtonRegularStyle}"
                            Click="Settings_Click" />
                    <Button Grid.Column="2" Content="Quit" HorizontalAlignment="Stretch"
                            Style="{StaticResource AuroraGlassButtonCoolStyle}"
                            Click="Quit_Click" />
                </Grid>

                <!-- Resize grip -->
                <primitives:Thumb Grid.Row="6"
                                  x:Name="ResizeGrip"
                                  Width="18" Height="14"
                                  HorizontalAlignment="Right"
                                  Margin="0,0,8,6"
                                  DragDelta="ResizeGrip_DragDelta"
                                  DragCompleted="ResizeGrip_DragCompleted">
                    <primitives:Thumb.Template>
                        <ControlTemplate TargetType="primitives:Thumb">
                            <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="12" Glyph="&#xE744;" Opacity="0.45" />
                        </ControlTemplate>
                    </primitives:Thumb.Template>
                </primitives:Thumb>
            </Grid>
        </Border>
    </Grid>
</Window>
