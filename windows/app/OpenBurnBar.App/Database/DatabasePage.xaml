<?xml version="1.0" encoding="utf-8"?>
<!-- IA-2 Database System mode: tracked session browse over SQLCipher seam. -->
<Page
    x:Class="OpenBurnBar.App.Database.DatabasePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:theme="using:OpenBurnBar.App.Theme"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Database"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PensieveColorTextBrightBrush}" />
            <TextBlock x:Name="StatusText"
                       TextWrapping="Wrap"
                       FontSize="13"
                       Foreground="{StaticResource PensieveColorTextMuteBrush}" />
        </StackPanel>

        <Border Grid.Row="1"
                Style="{StaticResource LiquidGlassPillStyle}"
                theme:LiquidGlass.Surface="True"
                HorizontalAlignment="Left"
                Padding="10,4">
            <TextBlock Text="System mode · IA-2"
                       FontSize="11"
                       Opacity="0.75" />
        </Border>

        <ListView x:Name="SessionList"
                  Grid.Row="2"
                  SelectionMode="None"
                  IsItemClickEnabled="False">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Padding="0,8" Spacing="2">
                        <TextBlock Text="{Binding InferredTaskTitle}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PensieveColorTextBrightBrush}" />
                        <TextBlock FontSize="12"
                                   Foreground="{StaticResource PensieveColorTextMuteBrush}">
                            <Run Text="{Binding ProviderDisplayName}" />
                            <Run Text=" · " />
                            <Run Text="{Binding ProjectName}" />
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
