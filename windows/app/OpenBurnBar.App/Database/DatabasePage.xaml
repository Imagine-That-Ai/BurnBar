<?xml version="1.0" encoding="utf-8"?>
<!-- IA-2 Database System mode: tracked session browse over SQLCipher seam.
     Composition mirrors the Linux DatabaseSurface: hero header + status pill +
     session rows as glass cards on the slate canvas. -->
<Page
    x:Class="OpenBurnBar.App.Database.DatabasePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:theme="using:OpenBurnBar.App.Theme"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="24,20,24,32" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Hero header (Linux surface hero: Outfit display + muted subtitle). -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Database"
                       Style="{StaticResource AuroraDisplayTextStyle}" />
            <TextBlock x:Name="StatusText"
                       Style="{StaticResource AuroraBodyTextStyle}"
                       Foreground="{ThemeResource AuroraTextMutedBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1"
                Style="{StaticResource LiquidGlassPillStyle}"
                theme:LiquidGlass.Surface="True"
                HorizontalAlignment="Left"
                Padding="10,4">
            <TextBlock Text="System mode · IA-2"
                       Style="{StaticResource AuroraTinyTextStyle}" />
        </Border>

        <ListView x:Name="SessionList"
                  Grid.Row="2"
                  SelectionMode="None"
                  IsItemClickEnabled="False">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <!-- Session row as a glass card (Linux SurfaceCard row). -->
                    <Border Style="{StaticResource AuroraGlassCardStyle}"
                            theme:LiquidGlass.Surface="True"
                            Padding="12,10">
                        <StackPanel Spacing="3">
                            <TextBlock Text="{Binding InferredTaskTitle}"
                                       Style="{StaticResource AuroraHeadlineTextStyle}"
                                       FontSize="13" />
                            <TextBlock Style="{StaticResource AuroraMonoSmallTextStyle}">
                                <Run Text="{Binding ProviderDisplayName}" />
                                <Run Text=" · " />
                                <Run Text="{Binding ProjectName}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
