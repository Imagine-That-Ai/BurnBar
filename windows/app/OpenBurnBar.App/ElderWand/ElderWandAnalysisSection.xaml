<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows render of AgentLens/Views/Chat/ElderWand/ElderWandAnalysisSection.swift (Phase 3 · W7).
  The analysis panel: a provider-grouped, multi-select chip cloud. The user picks 1–8 models
  that answer the prompt in parallel. Selection + enablement live on the portable
  ElderWandChipCloudViewModel (unit-tested on macOS); this control is a pure renderer that
  x:Binds each chip's IsSelected / IsEnabled and routes clicks back through the cloud. Chips wrap
  via the ElderWandFlowPanel (parity with the Swift ElderWandFlowLayout). Consumes the Pensieve
  tokens + Liquid-Glass surface styles.
-->
<UserControl
    x:Class="OpenBurnBar.App.ElderWand.ElderWandAnalysisSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:theme="using:OpenBurnBar.App.Theme"
    xmlns:ew="using:OpenBurnBar.App.Presentation.ElderWand"
    xmlns:local="using:OpenBurnBar.App.ElderWand"
    xmlns:conv="using:OpenBurnBar.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:NegatedBoolToVisibilityConverter x:Key="NegatedBoolToVisibility" />
        <conv:ElderWandModelAccentBrushConverter x:Key="ModelAccent" />
    </UserControl.Resources>

    <StackPanel Spacing="12">
        <!-- Header: title + subtitle + "N of 8" counter -->
        <Grid>
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="Analysis Panel"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PensieveColorTextBrightBrush}" />
                <TextBlock Text="These models answer in parallel."
                           FontSize="11"
                           Foreground="{StaticResource PensieveColorTextMuteBrush}" />
            </StackPanel>
            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    CornerRadius="{StaticResource PensieveRadiusPillCorner}"
                    Background="#1FFA5053"
                    Padding="8,2">
                <TextBlock Text="{x:Bind Editor.AnalysisPanelCounterText, Mode=OneWay}"
                           FontSize="12"
                           Foreground="#FFFA5053" />
            </Border>
        </Grid>

        <!-- Empty hint (no live models advertised) -->
        <Border Style="{StaticResource LiquidGlassSurfaceStyle}" theme:LiquidGlass.Surface="True" CornerRadius="{StaticResource PensieveRadiusMdCorner}"
                Padding="12"
                Visibility="{x:Bind Cloud.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="No live models advertised yet. Refresh the chat gateway to populate the panel."
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource PensieveColorTextMuteBrush}" />
        </Border>

        <!-- Provider-grouped chip cloud -->
        <ItemsControl ItemsSource="{x:Bind Cloud.Groups, Mode=OneWay}"
                      Visibility="{x:Bind Cloud.HasGroups, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="ew:ElderWandChipGroup">
                    <StackPanel Spacing="8" Margin="0,0,0,12">
                        <TextBlock Text="{x:Bind ProviderName}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PensieveColorTextBaseBrush}" />
                        <ItemsControl ItemsSource="{x:Bind Chips}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <local:ElderWandFlowPanel HorizontalSpacing="8" VerticalSpacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="ew:ElderWandChip">
                                    <Button Click="OnChipClick"
                                            Tag="{x:Bind}"
                                            IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0">
                                        <Grid>
                                            <Border Style="{StaticResource LiquidGlassSurfaceStyle}" theme:LiquidGlass.Surface="True" CornerRadius="{StaticResource PensieveRadiusPillCorner}"
                                                    Padding="12,7">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <Grid Width="12" Height="12">
                                                        <Ellipse Fill="{x:Bind ModelId, Converter={StaticResource ModelAccent}}" />
                                                        <FontIcon Glyph="&#xE73E;"
                                                                  FontSize="8"
                                                                  Foreground="White"
                                                                  Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                                    </Grid>
                                                    <TextBlock Text="{x:Bind Title}"
                                                               FontSize="12"
                                                               Foreground="{StaticResource PensieveColorTextBrightBrush}" />
                                                    <FontIcon Glyph="&#xE708;"
                                                              FontSize="9"
                                                              Foreground="{StaticResource PensieveColorTextMuteBrush}"
                                                              Visibility="{x:Bind IsRouteAsleep, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                            </Border>
                                            <!-- Selection ring in the model's brand color -->
                                            <Border CornerRadius="{StaticResource PensieveRadiusPillCorner}"
                                                    BorderThickness="1.25"
                                                    BorderBrush="{x:Bind ModelId, Converter={StaticResource ModelAccent}}"
                                                    Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
