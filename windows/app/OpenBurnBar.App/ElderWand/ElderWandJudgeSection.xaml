<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows render of AgentLens/Views/Chat/ElderWand/ElderWandJudgeSection.swift (Phase 3 · W7).
  The judge: a provider-grouped, single-select chip rail. The judge model COMPARES the panel
  answers into a structured verdict (it never merges). Selecting a model sets it as judge;
  re-selecting clears it. Renders the SAME portable ElderWandChipCloudViewModel — in Judge mode —
  as the analysis section, so single-select + route-eligibility gating are the macOS-tested logic.
  Selected chips take the whimsy tint (parity with the Swift gavel/whimsy treatment).
-->
<UserControl
    x:Class="OpenBurnBar.App.ElderWand.ElderWandJudgeSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:theme="using:OpenBurnBar.App.Theme"
    xmlns:ew="using:OpenBurnBar.App.Presentation.ElderWand"
    xmlns:local="using:OpenBurnBar.App.ElderWand"
    xmlns:conv="using:OpenBurnBar.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:NegatedBoolToVisibilityConverter x:Key="NegatedBoolToVisibility" />
        <conv:ElderWandModelAccentBrushConverter x:Key="ModelAccent" />
    </UserControl.Resources>

    <StackPanel Spacing="12">
        <!-- Header -->
        <StackPanel Spacing="2">
            <TextBlock Text="Judge"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource AuroraTextBrush}" />
            <TextBlock Text="Compares the panel answers into a structured verdict."
                       FontSize="11"
                       Foreground="{ThemeResource AuroraTextMutedBrush}" />
        </StackPanel>

        <!-- Empty hint -->
        <Border Style="{StaticResource LiquidGlassSurfaceStyle}" theme:LiquidGlass.Surface="True" CornerRadius="{StaticResource PensieveRadiusMdCorner}"
                Padding="12"
                Visibility="{x:Bind Cloud.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="No live models advertised yet. Refresh the chat gateway to choose a judge."
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource AuroraTextMutedBrush}" />
        </Border>

        <!-- Provider-grouped single-select rail -->
        <ItemsControl ItemsSource="{x:Bind Cloud.Groups, Mode=OneWay}"
                      Visibility="{x:Bind Cloud.HasGroups, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="ew:ElderWandChipGroup">
                    <StackPanel Spacing="8" Margin="0,0,0,12">
                        <TextBlock Text="{x:Bind ProviderName}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource AuroraTextSecondaryBrush}" />
                        <ItemsControl ItemsSource="{x:Bind Chips}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <local:ElderWandFlowPanel HorizontalSpacing="8" VerticalSpacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="ew:ElderWandChip">
                                    <Button Click="OnChipClick"
                                            Tag="{x:Bind}"
                                            IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0">
                                        <Grid>
                                            <Border Style="{StaticResource LiquidGlassSurfaceStyle}" theme:LiquidGlass.Surface="True" CornerRadius="{StaticResource PensieveRadiusPillCorner}"
                                                    Padding="12,7">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <Grid Width="12" Height="12">
                                                        <Ellipse Fill="{x:Bind ModelId, Converter={StaticResource ModelAccent}}"
                                                                 Width="7"
                                                                 Height="7"
                                                                 Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource NegatedBoolToVisibility}}" />
                                                        <FontIcon Glyph="&#xE73E;"
                                                                  FontSize="11"
                                                                  Foreground="{ThemeResource AuroraWhimsyBrush}"
                                                                  Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                                    </Grid>
                                                    <TextBlock Text="{x:Bind Title}"
                                                               FontSize="12"
                                                               Foreground="{ThemeResource AuroraTextBrush}" />
                                                    <FontIcon Glyph="&#xE708;"
                                                              FontSize="9"
                                                              Foreground="{ThemeResource AuroraTextMutedBrush}"
                                                              Visibility="{x:Bind IsRouteAsleep, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                            </Border>
                                            <!-- Selection ring (whimsy) -->
                                            <Border CornerRadius="{StaticResource PensieveRadiusPillCorner}"
                                                    BorderThickness="1.25"
                                                    BorderBrush="{ThemeResource AuroraWhimsyBrush}"
                                                    Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
