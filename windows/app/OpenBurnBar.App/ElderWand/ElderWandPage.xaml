<?xml version="1.0" encoding="utf-8"?>
<!--
  Phase-3 tail: the nav-frame HOSTING page for the Elder Wand configurator (ElderWandConfiguratorView
  UserControl). Registered in SurfacePageResolver so the shell content Frame can navigate to it.

  Reachability parity (see ElderWandConfiguratorView.xaml): on macOS Elder Wand is gated behind
  `.gatedFeature(.elderWand)` and reached from the Settings tree ("Analysis Models") or the chat
  header — it is NOT one of the 12 top-level sidebar destinations. So this key is registered in the
  resolver + surfaced through the Command Palette (NavCatalog.Auxiliary), never added to
  NavCatalog.All, keeping the 12-row sidebar parity. The page binds persisted settings by default;
  sample provider groups require OPENBURNBAR_SAMPLE_MODE=1.
-->
<Page
    x:Class="OpenBurnBar.App.ElderWand.ElderWandPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:elderwand="using:OpenBurnBar.App.ElderWand"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    AutomationProperties.AutomationId="RouteRoot.elderWand">

    <Grid Background="Transparent">
        <elderwand:ElderWandConfiguratorView x:Name="ConfiguratorView" />
    </Grid>
</Page>
