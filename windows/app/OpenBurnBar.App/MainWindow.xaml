<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="OpenBurnBar.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="using:OpenBurnBar.App.Shell"
    Title="OpenBurnBar">

    <Grid RowSpacing="0" Background="{StaticResource PensieveColorInkBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom draggable title bar (window-level title-bar region set in code-behind). -->
        <Grid x:Name="TitleBar" Grid.Row="0" Height="40" Padding="16,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    Width="12" Height="12" CornerRadius="6"
                    VerticalAlignment="Center"
                    Background="{StaticResource OBBAccentBrush}" />
            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       Text="OpenBurnBar"
                       FontWeight="SemiBold" />
        </Grid>

        <!-- The NavigationView app frame (12 stubbed destinations + content Frame). -->
        <shell:AppShell x:Name="ShellControl" Grid.Row="1" />
    </Grid>
</Window>
