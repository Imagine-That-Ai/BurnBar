<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="OpenBurnBar.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="using:OpenBurnBar.App.Shell"
    xmlns:theme="using:OpenBurnBar.App.Theme"
    Title="OpenBurnBar"
    RequestedTheme="Dark">

    <!--
      Root is intentionally transparent so Mica/Acrylic (LiquidGlass.ApplyWindowBackdrop)
      shows through. Dark Pensieve is forced for shell parity with macOS.
    -->
    <Grid x:Name="RootGrid" RowSpacing="0" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- LiquidGlassWindowBlend scrim (frost/clear plate over the system backdrop). -->
        <Border x:Name="WindowBlendScrim"
                Grid.RowSpan="2"
                IsHitTestVisible="False" />

        <!-- Custom draggable title bar (window-level title-bar region set in code-behind). -->
        <Border Grid.Row="0"
                Style="{StaticResource LiquidGlassToolbarStyle}"
                Margin="8,4,8,0"
                theme:LiquidGlass.Surface="True">
            <Grid x:Name="TitleBar" Height="32" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Width="12" Height="12" CornerRadius="6"
                        VerticalAlignment="Center"
                        Background="{StaticResource OBBAccentBrush}" />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Text="OpenBurnBar"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PensieveColorTextBrightBrush}" />
            </Grid>
        </Border>

        <!-- The NavigationView app frame (12 destinations + content Frame). -->
        <shell:AppShell x:Name="ShellControl" Grid.Row="1" />
    </Grid>
</Window>
