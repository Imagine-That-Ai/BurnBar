<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="OpenBurnBar.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:OpenBurnBar.App.Views"
    Title="OpenBurnBar">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header strip (draggable title-bar region set in code-behind). -->
        <Grid x:Name="HeaderBar" Grid.Row="0" Height="48" Padding="16,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    Width="12" Height="12" CornerRadius="6"
                    VerticalAlignment="Center"
                    Background="{StaticResource OBBAccentBrush}" />
            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       Text="OpenBurnBar — CLI stream"
                       FontWeight="SemiBold" />
        </Grid>

        <!-- Full live CLI stream. -->
        <views:LiveCliStreamView x:Name="StreamView" Grid.Row="1" Margin="16,0,16,16" />
    </Grid>
</Window>
