<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="OpenBurnBar.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="using:OpenBurnBar.App.Shell"
    xmlns:components="using:OpenBurnBar.App.Components"
    xmlns:theme="using:OpenBurnBar.App.Theme"
    Title="OpenBurnBar">

    <Grid x:Name="RootGrid" RowSpacing="0" Background="Transparent" RequestedTheme="Dark"
          FontFamily="{StaticResource AuroraBodyFont}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="WindowBlendScrim"
                Grid.RowSpan="2"
                IsHitTestVisible="False" />

        <!-- Bare drag strip for the caption buttons (the command deck in AppShell is the
             single brand row — no duplicate wordmark up here). -->
        <Grid x:Name="TitleBar"
              Grid.Row="0"
              Height="32"
              Background="Transparent" />

        <!-- Content: the shared Linux UI WebView2 host by default, or the native XAML
             AppShell when OPENBURNBAR_XAML_SHELL=1 (see MainWindow.xaml.cs). -->
        <Grid x:Name="ContentHost" Grid.Row="1" />
    </Grid>
</Window>
