<?xml version="1.0" encoding="utf-8"?>
<!--
  AppShell — macOS Command Deck + Linux TopChrome parity.
  Brand logo · section switcher · Ctrl+K · KernelSwitcher · BURN hero · appearance · overflow
  Dashboard owns the Command sidebar (not a permanent destination rail).
-->
<UserControl
    x:Class="OpenBurnBar.App.Shell.AppShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="using:OpenBurnBar.App.Shell"
    xmlns:components="using:OpenBurnBar.App.Components"
    xmlns:theme="using:OpenBurnBar.App.Theme"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Dark">

    <Grid Background="Transparent" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource LiquidGlassToolbarStyle}"
                theme:LiquidGlass.Surface="True"
                Margin="10,6,10,4"
                MinHeight="52">
            <Grid ColumnSpacing="8" Padding="8,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand: AppLogo + wordmark (Linux DeckBrandMark) -->
                <Button Grid.Column="0"
                        Click="Brand_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="4,2"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="OpenBurnBar — Dashboard">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <components:AppLogoView Size="26" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="0">
                            <TextBlock Text="Open" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{ThemeResource AuroraTextSecondaryBrush}" />
                            <TextBlock Text="BurnBar" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{ThemeResource AuroraTextBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Button>

                <!-- Omnibar: wide glass search pill (macOS BurnBarTopRail / Linux TopChrome) -->
                <Button Grid.Column="1"
                        Style="{StaticResource LiquidGlassInteractiveStyle}"
                        theme:LiquidGlass.Interactive="True"
                        Click="Palette_Click"
                        VerticalAlignment="Center"
                        CornerRadius="999"
                        MinWidth="220"
                        MaxWidth="400"
                        HorizontalContentAlignment="Stretch"
                        ToolTipService.ToolTip="Command palette (Ctrl+K)">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="12"
                                  Glyph="&#xE721;"
                                  Foreground="{ThemeResource AuroraTextSecondaryBrush}" />
                        <TextBlock Grid.Column="1"
                                   Text="Search or jump to…"
                                   FontSize="12"
                                   Foreground="{ThemeResource AuroraTextMutedBrush}" />
                        <Border Grid.Column="3"
                                VerticalAlignment="Center"
                                CornerRadius="4"
                                Padding="6,2"
                                Background="{ThemeResource AuroraGlassTintElevatedBrush}">
                            <TextBlock Text="Ctrl K"
                                       FontSize="10"
                                       Foreground="{ThemeResource AuroraTextMutedBrush}" />
                        </Border>
                    </Grid>
                </Button>

                <Border Grid.Column="2" />

                <!-- Full 31-kernel switcher (Linux KernelSwitcher) -->
                <shell:KernelSwitcherControl x:Name="KernelSwitcher"
                                             Grid.Column="3"
                                             VerticalAlignment="Center" />

                <!-- BURN hero -->
                <shell:BurnHeroControl x:Name="BurnHero"
                                       Grid.Column="4"
                                       VerticalAlignment="Center"
                                       Margin="4,0,0,0" />

                <!-- Appearance -->
                <Button Grid.Column="5"
                        Style="{StaticResource LiquidGlassCircleButtonStyle}"
                        theme:LiquidGlass.CircleButtonDiameter="30"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="Appearance">
                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="14" Glyph="&#xE771;"
                              Foreground="{ThemeResource AuroraTextBrush}" />
                    <Button.Flyout>
                        <Flyout x:Name="AppearanceFlyout" Opening="AppearanceFlyout_Opening">
                            <theme:AppearanceModeControl x:Name="AppearanceControl" MinWidth="300" />
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!-- Overflow -->
                <Button Grid.Column="6"
                        Style="{StaticResource LiquidGlassCircleButtonStyle}"
                        theme:LiquidGlass.CircleButtonDiameter="30"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="More">
                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="14" Glyph="&#xE712;"
                              Foreground="{ThemeResource AuroraTextBrush}" />
                    <Button.Flyout>
                        <MenuFlyout x:Name="OverflowMenu" Placement="Bottom" />
                    </Button.Flyout>
                </Button>
            </Grid>
        </Border>

        <!-- Linux TopTabbar: the 7-tab glass pill strip (chat/providers/database/projects/
             missions/activity/memory). Tabs are built in code-behind from the NavCatalog. -->
        <Border Grid.Row="1"
                Style="{StaticResource LiquidGlassPillStyle}"
                theme:LiquidGlass.Surface="True"
                Margin="10,2,10,6"
                Padding="3">
            <Grid x:Name="TopTabsHost" ColumnSpacing="2" />
        </Border>

        <Frame x:Name="ContentFrame"
               Grid.Row="2"
               Background="{ThemeResource AuroraCanvasBrush}" />
    </Grid>
</UserControl>
