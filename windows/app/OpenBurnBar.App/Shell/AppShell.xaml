<?xml version="1.0" encoding="utf-8"?>
<!--
  AppShell — macOS DashboardView chrome parity (not a permanent left destination rail).

  macOS structure (DashboardView + DashboardToolbarContent):
    • Toolbar / Command Deck: brand · section switcher menu · ⌘K · appearance
    • NavigationSplitView lives INSIDE the Dashboard page (Command sidebar | detail)
    • Other sections replace the detail frame; they are NOT left-nav rows

  Windows: same idea — top Command Deck + full-width content frame.
  Destinations live in the section menu (DashboardSectionSwitcher peer).
-->
<UserControl
    x:Class="OpenBurnBar.App.Shell.AppShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:theme="using:OpenBurnBar.App.Theme"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Dark">

    <Grid Background="Transparent" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Command Deck toolbar (macOS .toolbar navigation + primaryAction) -->
        <Border Grid.Row="0"
                Style="{StaticResource LiquidGlassToolbarStyle}"
                theme:LiquidGlass.Surface="True"
                Margin="10,6,10,4">
            <Grid ColumnSpacing="10" Padding="6,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand mark -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center"
                            Margin="4,0,8,0">
                    <Border Width="10" Height="10" CornerRadius="5"
                            Background="{StaticResource OBBAccentBrush}" />
                    <TextBlock Text="OpenBurnBar"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource PensieveColorTextBrightBrush}" />
                </StackPanel>

                <!-- Section switcher (macOS DashboardSectionSwitcher Menu) -->
                <DropDownButton x:Name="SectionSwitcher"
                                Grid.Column="1"
                                Style="{StaticResource LiquidGlassInteractiveStyle}"
                                theme:LiquidGlass.Interactive="True"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="Switch section">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon x:Name="SectionGlyph"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="12"
                                  Glyph="&#xE80F;"
                                  Foreground="{StaticResource PensieveColorTextBrightBrush}" />
                        <TextBlock x:Name="SectionTitle"
                                   Text="Dashboard"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PensieveColorTextBrightBrush}" />
                        <FontIcon FontFamily="Segoe MDL2 Assets"
                                  FontSize="10"
                                  Glyph="&#xE70D;"
                                  Foreground="{StaticResource PensieveColorTextMuteBrush}" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="SectionMenu" Placement="Bottom" />
                    </DropDownButton.Flyout>
                </DropDownButton>

                <!-- Spacer -->
                <Border Grid.Column="2" />

                <!-- Command palette (⌘K / Ctrl+K) -->
                <Button Grid.Column="3"
                        Style="{StaticResource LiquidGlassInteractiveStyle}"
                        theme:LiquidGlass.Interactive="True"
                        Click="Palette_Click"
                        ToolTipService.ToolTip="Command palette (Ctrl+K)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="14" Glyph="&#xE721;"
                                  Foreground="{StaticResource PensieveColorTextBrightBrush}" />
                        <TextBlock Text="Search"
                                   Foreground="{StaticResource PensieveColorTextBrightBrush}" />
                        <TextBlock Text="Ctrl K"
                                   Opacity="0.55"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource PensieveColorTextMuteBrush}" />
                    </StackPanel>
                </Button>

                <!-- Appearance -->
                <Button Grid.Column="4"
                        Style="{StaticResource LiquidGlassCircleButtonStyle}"
                        theme:LiquidGlass.CircleButtonDiameter="30"
                        ToolTipService.ToolTip="Appearance">
                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="14" Glyph="&#xE771;"
                              Foreground="{StaticResource PensieveColorTextBrightBrush}" />
                    <Button.Flyout>
                        <Flyout x:Name="AppearanceFlyout" Opening="AppearanceFlyout_Opening">
                            <theme:AppearanceModeControl x:Name="AppearanceControl" MinWidth="300" />
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!-- Overflow: footer destinations (Settings) -->
                <Button Grid.Column="5"
                        Style="{StaticResource LiquidGlassCircleButtonStyle}"
                        theme:LiquidGlass.CircleButtonDiameter="30"
                        ToolTipService.ToolTip="More">
                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="14" Glyph="&#xE712;"
                              Foreground="{StaticResource PensieveColorTextBrightBrush}" />
                    <Button.Flyout>
                        <MenuFlyout x:Name="OverflowMenu" Placement="Bottom" />
                    </Button.Flyout>
                </Button>
            </Grid>
        </Border>

        <!-- Full-bleed content (Dashboard owns its own Command sidebar) -->
        <Frame x:Name="ContentFrame"
               Grid.Row="1"
               Background="Transparent" />
    </Grid>
</UserControl>
