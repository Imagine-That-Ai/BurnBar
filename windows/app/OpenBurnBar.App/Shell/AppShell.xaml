<?xml version="1.0" encoding="utf-8"?>
<!--
  AppShell — WinUI NavigationView frame (macOS NavigationSplitView analogue).
  Dark Pensieve + Liquid Glass chrome: translucent pane, glass header toolbar,
  interactive Search + circle Appearance. Content frame stays transparent so
  page/kernel/Mica layers show through.
-->
<UserControl
    x:Class="OpenBurnBar.App.Shell.AppShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:theme="using:OpenBurnBar.App.Theme"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Dark">

    <NavigationView x:Name="Nav"
                    Background="Transparent"
                    IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False"
                    PaneDisplayMode="Left"
                    OpenPaneLength="240"
                    IsPaneToggleButtonVisible="True"
                    SelectionChanged="Nav_SelectionChanged">

        <NavigationView.Header>
            <Border Style="{StaticResource LiquidGlassToolbarStyle}"
                    theme:LiquidGlass.Surface="True"
                    Margin="0,0,0,6">
                <theme:LiquidGlassGroup>
                    <Grid ColumnSpacing="8" Padding="4,2,4,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="HeaderTitle"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PensieveColorTextBrightBrush}" />

                        <Button Grid.Column="1"
                                Style="{StaticResource LiquidGlassInteractiveStyle}"
                                theme:LiquidGlass.Interactive="True"
                                Click="Palette_Click"
                                ToolTipService.ToolTip="Command palette (Ctrl+K)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="14" Glyph="&#xE721;"
                                          Foreground="{StaticResource PensieveColorTextBrightBrush}" />
                                <TextBlock Text="Search"
                                           Foreground="{StaticResource PensieveColorTextBrightBrush}" />
                                <TextBlock Text="Ctrl K"
                                           Opacity="0.55"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource PensieveColorTextMuteBrush}" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2"
                                Style="{StaticResource LiquidGlassCircleButtonStyle}"
                                theme:LiquidGlass.CircleButtonDiameter="30"
                                ToolTipService.ToolTip="Appearance">
                            <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="14" Glyph="&#xE771;"
                                      Foreground="{StaticResource PensieveColorTextBrightBrush}" />
                            <Button.Flyout>
                                <Flyout x:Name="AppearanceFlyout" Opening="AppearanceFlyout_Opening">
                                    <theme:AppearanceModeControl x:Name="AppearanceControl" MinWidth="300" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                </theme:LiquidGlassGroup>
            </Border>
        </NavigationView.Header>

        <Frame x:Name="ContentFrame" Background="Transparent" />
    </NavigationView>
</UserControl>
