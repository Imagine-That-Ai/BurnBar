<?xml version="1.0" encoding="utf-8"?>
<!--
  CommandPalette — the Ctrl+K palette, the Windows analog of CommandDeckPalette.swift and the
  substitute for the macOS App-Intents surface. Presented as a ContentDialog overlay: a search
  box over a results list that unifies "Go to" section navigation with tracked session jumps.
  Keyboard-first: Up/Down move the selection, Enter activates, Esc dismisses (ContentDialog).
-->
<ContentDialog
    x:Class="OpenBurnBar.App.Shell.CommandPalette"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenBurnBar.App.Shell"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Style="{StaticResource AuroraGlassDialogStyle}"
    DefaultButton="None"
    Padding="0"
    CornerRadius="{StaticResource OBBCardCornerRadius}">

    <Grid Width="520" Height="440">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Search bar. -->
        <Grid Grid.Row="0" ColumnSpacing="8" Padding="16,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon Grid.Column="0"
                      FontFamily="Segoe MDL2 Assets"
                      FontSize="15"
                      Glyph="&#xE721;"
                      Opacity="0.7"
                      VerticalAlignment="Center" />
            <TextBox Grid.Column="1"
                     x:Name="QueryBox"
                     BorderThickness="0"
                     Background="Transparent"
                     FontSize="16"
                     PlaceholderText="Jump to section or search sessions…"
                     TextChanged="QueryBox_TextChanged"
                     KeyDown="QueryBox_KeyDown" />
        </Grid>

        <Border Grid.Row="1" Height="1" Background="{ThemeResource AuroraGlassStrokeBrush}" />

        <TextBlock Grid.Row="2"
                   x:Name="StatusText"
                   Margin="16,8,16,0"
                   Opacity="0.7"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />

        <!-- Results. -->
        <ListView Grid.Row="3"
                  x:Name="ResultsList"
                  Padding="8,8"
                  SelectionMode="Single"
                  IsItemClickEnabled="True"
                  ItemClick="ResultsList_ItemClick">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="8,6" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:CommandPaletteItem">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="14"
                                  Glyph="{x:Bind Glyph}"
                                  Foreground="{ThemeResource AuroraAccentBrush}"
                                  VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="{x:Bind Subtitle}" Opacity="0.65" FontSize="11" />
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                   Text="{x:Bind Shortcut}"
                                   Visibility="{x:Bind ShortcutVisibility}"
                                   Opacity="0.5"
                                   FontSize="11"
                                   VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</ContentDialog>
