<?xml version="1.0" encoding="utf-8"?>
<!-- Linux KernelSwitcher.tsx / macOS Appearance kernel picker peer — full KernelCatalog. -->
<UserControl
    x:Class="OpenBurnBar.App.Shell.KernelSwitcherControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:theme="using:OpenBurnBar.App.Theme">

    <Button x:Name="Trigger"
            Style="{StaticResource LiquidGlassInteractiveStyle}"
            theme:LiquidGlass.Interactive="True"
            AutomationProperties.AutomationId="Shell.KernelSwitcher"
            AutomationProperties.Name="Backdrop kernel"
            ToolTipService.ToolTip="Backdrop kernel">
        <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="12" Glyph="&#xE790;"
                      Foreground="{ThemeResource AuroraTextBrush}" />
            <TextBlock x:Name="ActiveLabel"
                       Text="Fluid Aurora"
                       FontSize="12"
                       FontWeight="SemiBold"
                       MaxWidth="140"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource AuroraTextBrush}" />
            <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="10" Glyph="&#xE70D;"
                      Foreground="{ThemeResource AuroraTextSecondaryBrush}" />
        </StackPanel>
        <Button.Flyout>
            <Flyout x:Name="KernelFlyout" Placement="Bottom">
                <Border MinWidth="240" MaxHeight="360" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Backdrop kernel"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   CharacterSpacing="40"
                                   Margin="6,2,6,8"
                                   Foreground="{ThemeResource AuroraTextMutedBrush}" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="300">
                            <StackPanel x:Name="KernelList" Spacing="2" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Flyout>
        </Button.Flyout>
    </Button>
</UserControl>
