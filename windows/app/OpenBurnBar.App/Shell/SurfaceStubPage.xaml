<?xml version="1.0" encoding="utf-8"?>
<!--
  SurfaceStubPage — the placeholder a NavigationView destination shows in Phase 3 W6-SHELL.

  Every one of the 12 destinations navigates here with its NavDestination as the parameter.
  The page names the surface (glyph + title + subtitle) and marks it a Windows-parity stub,
  so the frame is demonstrably real while the actual surfaces (Buckets A/B/C) land later.
  The Session Logs destination additionally hosts the live CLI stream, proving the frame
  hosts real controls, not just static text.
-->
<Page
    x:Class="OpenBurnBar.App.Shell.SurfaceStubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24">
        <!-- Placeholder card (shown for every stubbed surface). -->
        <Border x:Name="PlaceholderCard"
                MaxWidth="520"
                Padding="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="{StaticResource OBBCardCornerRadius}"
                Background="{StaticResource OBBSurfaceBrush}"
                BorderThickness="1"
                BorderBrush="{StaticResource OBBStrokeBrush}">
            <StackPanel Spacing="12" HorizontalAlignment="Center">
                <FontIcon x:Name="Glyph"
                          FontFamily="Segoe MDL2 Assets"
                          FontSize="34"
                          Foreground="{StaticResource OBBAccentBrush}" />
                <TextBlock x:Name="TitleText"
                           HorizontalAlignment="Center"
                           FontSize="22"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="SubtitleText"
                           HorizontalAlignment="Center"
                           Opacity="0.7"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
                <Border Padding="8,3"
                        HorizontalAlignment="Center"
                        CornerRadius="10"
                        Background="{StaticResource OBBSurfaceBrush}"
                        BorderThickness="1"
                        BorderBrush="{StaticResource OBBStrokeBrush}">
                    <TextBlock Text="Windows parity · stub surface"
                               FontSize="11"
                               Opacity="0.6" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Live host (used by the Session Logs destination). -->
        <Border x:Name="LiveHost"
                Visibility="Collapsed" />
    </Grid>
</Page>
