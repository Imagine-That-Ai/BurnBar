<?xml version="1.0" encoding="utf-8"?>
<!--
  SurfaceStubPage — (1) unknown destination keys, and (2) intentional IA-1 deferred
  disclosure for database/projects until depth pages land (SurfaceRouteMap).

  Not a fake Real surface: honest deferred / unknown chrome only.
-->
<Page
    x:Class="OpenBurnBar.App.Shell.SurfaceStubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:theme="using:OpenBurnBar.App.Theme"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="24" Background="Transparent">
        <Border x:Name="PlaceholderCard"
                MaxWidth="560"
                Padding="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource LiquidGlassSurfaceStyle}"
                theme:LiquidGlass.Surface="True">
            <StackPanel Spacing="14" HorizontalAlignment="Stretch">
                <FontIcon x:Name="Glyph"
                          FontFamily="Segoe MDL2 Assets"
                          FontSize="36"
                          HorizontalAlignment="Center"
                          Foreground="{StaticResource OBBAccentBrush}" />
                <TextBlock x:Name="TitleText"
                           HorizontalAlignment="Center"
                           FontSize="22"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           Foreground="{StaticResource PensieveColorTextBrightBrush}" />
                <TextBlock x:Name="SubtitleText"
                           HorizontalAlignment="Center"
                           Opacity="0.75"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Foreground="{StaticResource PensieveColorTextMuteBrush}" />
                <Border x:Name="StatusPill"
                        Style="{StaticResource LiquidGlassPillStyle}"
                        theme:LiquidGlass.Surface="True"
                        HorizontalAlignment="Center"
                        Margin="0,4,0,0">
                    <TextBlock x:Name="StatusPillText"
                               FontSize="11"
                               Opacity="0.75" />
                </Border>
                <TextBlock x:Name="NextStepText"
                           Margin="0,4,0,0"
                           HorizontalAlignment="Center"
                           FontSize="12"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Foreground="{StaticResource PensieveColorTextMuteBrush}"
                           Opacity="0.9" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
