<?xml version="1.0" encoding="utf-8"?>
<!--
  Liquid-Glass vocabulary styles (Windows) — the XAML half of the W6-DS-GLASS chokepoint.
  Companion to Theme/LiquidGlass.cs; together they mirror AgentLens/Theme/LiquidGlass.swift
  and apps/linux-desktop/src/styles/liquid-glass.css.

  Style -> Swift / Linux member:
    • LiquidGlassSurfaceStyle       -> View.liquidGlassSurface / .glass-card / .glass-surface
    • LiquidGlassToolbarStyle       -> floating toolbar plate / .glass-toolbar
    • LiquidGlassPillStyle          -> capsule status/segment plate / .glass-pill
    • LiquidGlassAlertStyle         -> tinted glass alert tray
    • LiquidGlassInteractiveStyle   -> View.liquidGlassInteractive (PointerOver/Pressed
                                       VisualStates = interactive-lensing stand-in, R7)
    • LiquidGlassCircleButtonStyle  -> View.liquidGlassCircleButton(diameter:) (default 30)

  Material values (tint plates, strokes, inner light) come from the token pipeline
  (packages/design-tokens/tokens/aurora.tokens.json → Theme/Tokens.xaml), which carries the
  macOS Aurora dark ramp + the Linux liquid-glass alpha math baked to rgba — so these plates
  are the same color the macOS and Linux shells render. Radii follow the macOS scale:
  card 10 (GlassCard), toolbar 8 (toolbarPill), pill 999, dialogs/popover 22.

  The surface *brush* itself (Mica-translucent / Acrylic / solid, chosen by the transparency
  preference) is resolved in code by LiquidGlass.ResolveSurfaceBrush / the LiquidGlass.Surface
  attached property. These styles carry the shape/stroke/padding + pointer feedback; the code
  carries the transparency-preference math. See the R7 NOTES block in LiquidGlass.cs.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Passive plate for trays, floating bars, cards (.glass-card / .glass-surface).
         macOS GlassCard: radius 10, elevated tint plate, hairline border. -->
    <Style x:Key="LiquidGlassSurfaceStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource OBBCardCornerRadius}" />
        <Setter Property="Background" Value="{ThemeResource AuroraGlassTintElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AuroraGlassStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource PensieveSpace3Thickness}" />
    </Style>

    <!-- Floating toolbar / nav header plate (.glass-toolbar). Radius 8 = macOS toolbarPill. -->
    <Style x:Key="LiquidGlassToolbarStyle" TargetType="Border" BasedOn="{StaticResource LiquidGlassSurfaceStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource PensieveRadiusSmCorner}" />
        <Setter Property="Background" Value="{ThemeResource AuroraGlassTintBaseBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AuroraGlassStrokeBrush}" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <!-- Capsule status / segment plate (.glass-pill). -->
    <Style x:Key="LiquidGlassPillStyle" TargetType="Border" BasedOn="{StaticResource LiquidGlassSurfaceStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource PensieveRadiusPillCorner}" />
        <Setter Property="Background" Value="{ThemeResource AuroraGlassTintClearBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AuroraGlassStrokeBrush}" />
        <Setter Property="Padding" Value="10,4" />
    </Style>

    <!-- Alert / toast tray (semantic tint rides as BorderBrush override at call site).
         Default border = ember @45% (macOS alert ring). -->
    <Style x:Key="LiquidGlassAlertStyle" TargetType="Border" BasedOn="{StaticResource LiquidGlassSurfaceStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource PensieveRadiusSmCorner}" />
        <Setter Property="Background" Value="{ThemeResource AuroraGlassTintElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PensieveGlassInputFocusRingBrush}" />
        <Setter Property="Padding" Value="{StaticResource PensieveSpace4Thickness}" />
    </Style>

    <!-- Selected nav pill chrome — macOS SidebarItem selected: ember @8% fill + @30% stroke. -->
    <Style x:Key="LiquidGlassNavSelectedStyle" TargetType="Border" BasedOn="{StaticResource LiquidGlassPillStyle}">
        <Setter Property="Background" Value="{ThemeResource AuroraGlassSelectionFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AuroraGlassSelectionStrokeBrush}" />
    </Style>

    <!-- liquidGlassInteractive: glass that responds to pointer (buttons, chips, pills). -->
    <Style x:Key="LiquidGlassInteractiveStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource AuroraGlassTintInteractiveBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AuroraGlassStrokeFrostBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource AuroraTextBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource OBBCardCornerRadius}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <CompositeTransform x:Name="RootTransform" ScaleX="1" ScaleY="1" TranslateY="0" />
                        </Grid.RenderTransform>
                        <Border x:Name="GlassPlate"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                        <!--
                          The pointer-feedback overlay. On macOS the interactive glass lenses
                          the light under the pointer; here (R7) it is a subtle luminance
                          overlay that fades in on PointerOver / Pressed, plus a micro-scale.
                        -->
                        <Border x:Name="HoverOverlay"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Background="{StaticResource PensieveColorMercuryBrightBrush}"
                                Opacity="0"
                                IsHitTestVisible="False" />
                        <!-- Inner top hairline highlight (macOS luminous edge / Linux glass-inner-light). -->
                        <Border CornerRadius="{TemplateBinding CornerRadius}"
                                BorderThickness="0,1,0,0"
                                BorderBrush="{ThemeResource AuroraGlassInnerLightBrush}"
                                IsHitTestVisible="False" />
                        <ContentPresenter x:Name="ContentPresenter"
                                          Padding="{TemplateBinding Padding}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentTransitions="{TemplateBinding ContentTransitions}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          AutomationProperties.AccessibilityView="Raw" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="RootTransform"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1"
                                                         Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="RootTransform"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1"
                                                         Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="RootTransform"
                                                         Storyboard.TargetProperty="TranslateY"
                                                         To="0"
                                                         Duration="0:0:0.12" />
                                    </Storyboard>
                                </VisualState>
                                <!-- Hover scale 1.015 / lift −0.5px — the macOS GlassCard hover physics. -->
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.08"
                                                         Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="RootTransform"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1.015"
                                                         Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="RootTransform"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1.015"
                                                         Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="RootTransform"
                                                         Storyboard.TargetProperty="TranslateY"
                                                         To="-0.5"
                                                         Duration="0:0:0.12" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.16"
                                                         Duration="0:0:0.06" />
                                        <DoubleAnimation Storyboard.TargetName="RootTransform"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="0.98"
                                                         Duration="0:0:0.06" />
                                        <DoubleAnimation Storyboard.TargetName="RootTransform"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="0.98"
                                                         Duration="0:0:0.06" />
                                        <DoubleAnimation Storyboard.TargetName="RootTransform"
                                                         Storyboard.TargetProperty="TranslateY"
                                                         To="0.5"
                                                         Duration="0:0:0.06" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RootGrid"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.4"
                                                         Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      liquidGlassCircleButton: the recurring circular toolbar/overlay control
      (close, collapse chevron). Interactive glass + circular. Default 30x30 mirrors the
      Swift default; LiquidGlass.CircleButtonDiameter overrides Width/Height/CornerRadius.
    -->
    <Style x:Key="LiquidGlassCircleButtonStyle" TargetType="Button" BasedOn="{StaticResource LiquidGlassInteractiveStyle}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="CornerRadius" Value="15" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="30" />
        <Setter Property="MinHeight" Value="30" />
    </Style>

</ResourceDictionary>
