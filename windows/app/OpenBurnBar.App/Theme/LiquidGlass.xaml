<?xml version="1.0" encoding="utf-8"?>
<!--
  Liquid-Glass vocabulary styles (Windows) — the XAML half of the W6-DS-GLASS chokepoint.
  Companion to Theme/LiquidGlass.cs; together they mirror AgentLens/Theme/LiquidGlass.swift
  and apps/linux-desktop/src/styles/liquid-glass.css.

  Style -> Swift / Linux member:
    • LiquidGlassSurfaceStyle       -> View.liquidGlassSurface / .glass-card / .glass-surface
    • LiquidGlassToolbarStyle       -> floating toolbar plate / .glass-toolbar
    • LiquidGlassPillStyle          -> capsule status/segment plate / .glass-pill
    • LiquidGlassAlertStyle         -> tinted glass alert tray
    • LiquidGlassInteractiveStyle   -> View.liquidGlassInteractive (PointerOver/Pressed
                                       VisualStates = interactive-lensing stand-in, R7)
    • LiquidGlassCircleButtonStyle  -> View.liquidGlassCircleButton(diameter:) (default 30)

  The surface *brush* itself (Mica-translucent / Acrylic / solid, chosen by the transparency
  preference) is resolved in code by LiquidGlass.ResolveSurfaceBrush / the LiquidGlass.Surface
  attached property. These styles carry the shape/stroke/padding + pointer feedback; the code
  carries the transparency-preference math. See the R7 NOTES block in LiquidGlass.cs.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Passive plate for trays, floating bars, cards (.glass-card / .glass-surface). -->
    <Style x:Key="LiquidGlassSurfaceStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource PensieveRadiusMdCorner}" />
        <Setter Property="Background" Value="{StaticResource PensieveColorGlassBgBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PensieveColorFrostLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource PensieveSpace3Thickness}" />
    </Style>

    <!-- Floating toolbar / nav header plate (.glass-toolbar). -->
    <Style x:Key="LiquidGlassToolbarStyle" TargetType="Border" BasedOn="{StaticResource LiquidGlassSurfaceStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource PensieveRadiusSmCorner}" />
        <Setter Property="Background" Value="{StaticResource PensieveColorGlassBgElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PensieveColorGlassLineBrush}" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <!-- Capsule status / segment plate (.glass-pill). -->
    <Style x:Key="LiquidGlassPillStyle" TargetType="Border" BasedOn="{StaticResource LiquidGlassSurfaceStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource PensieveRadiusPillCorner}" />
        <Setter Property="Background" Value="{StaticResource PensieveColorGlassBgBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PensieveColorGlassLineBrush}" />
        <Setter Property="Padding" Value="10,4" />
    </Style>

    <!-- Alert / toast tray (semantic tint rides as BorderBrush override at call site). -->
    <Style x:Key="LiquidGlassAlertStyle" TargetType="Border" BasedOn="{StaticResource LiquidGlassSurfaceStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource PensieveRadiusSmCorner}" />
        <Setter Property="Background" Value="{StaticResource PensieveColorGlassBgElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PensieveColorBrassGlowBrush}" />
        <Setter Property="Padding" Value="{StaticResource PensieveSpace4Thickness}" />
    </Style>

    <!-- Selected nav pill chrome. -->
    <Style x:Key="LiquidGlassNavSelectedStyle" TargetType="Border" BasedOn="{StaticResource LiquidGlassPillStyle}">
        <Setter Property="Background" Value="{StaticResource PensieveColorMercuryWashBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PensieveColorGlassLineBrightBrush}" />
    </Style>

    <!-- liquidGlassInteractive: glass that responds to pointer (buttons, chips, pills). -->
    <Style x:Key="LiquidGlassInteractiveStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PensieveColorGlassBgBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PensieveColorFrostLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource PensieveColorTextBrightBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource PensieveRadiusSmCorner}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <CompositeTransform x:Name="RootTransform" ScaleX="1" ScaleY="1" TranslateY="0" />
                        </Grid.RenderTransform>
                        <Border x:Name="GlassPlate"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                        <!--
                          The pointer-feedback overlay. On macOS the interactive glass lenses
                          the light under the pointer; here (R7) it is a subtle luminance
                          overlay that fades in on PointerOver / Pressed, plus a micro-scale.
                        -->
                        <Border x:Name="HoverOverlay"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Background="{StaticResource PensieveColorMercuryBrightBrush}"
                                Opacity="0"
                                IsHitTestVisible="False" />
                        <!-- Frost-line inner top highlight (Linux --glass-inner-light). -->
                        <Border CornerRadius="{TemplateBinding CornerRadius}"
                                BorderThickness="0,1,0,0"
                                BorderBrush="{StaticResource PensieveColorFrostLineBrush}"
                                IsHitTestVisible="False" />
                        <ContentPresenter x:Name="ContentPresenter"
                                          Padding="{TemplateBinding Padding}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentTransitions="{TemplateBinding ContentTransitions}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          AutomationProperties.AccessibilityView="Raw" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="RootTransform"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1"
                                                         Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="RootTransform"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1"
                                                         Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="RootTransform"
                                                         Storyboard.TargetProperty="TranslateY"
                                                         To="0"
                                                         Duration="0:0:0.12" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.08"
                                                         Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="RootTransform"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1.02"
                                                         Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="RootTransform"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1.02"
                                                         Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="RootTransform"
                                                         Storyboard.TargetProperty="TranslateY"
                                                         To="-0.5"
                                                         Duration="0:0:0.12" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.16"
                                                         Duration="0:0:0.06" />
                                        <DoubleAnimation Storyboard.TargetName="RootTransform"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="0.98"
                                                         Duration="0:0:0.06" />
                                        <DoubleAnimation Storyboard.TargetName="RootTransform"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="0.98"
                                                         Duration="0:0:0.06" />
                                        <DoubleAnimation Storyboard.TargetName="RootTransform"
                                                         Storyboard.TargetProperty="TranslateY"
                                                         To="0.5"
                                                         Duration="0:0:0.06" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RootGrid"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.4"
                                                         Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      liquidGlassCircleButton: the recurring circular toolbar/overlay control
      (close, collapse chevron). Interactive glass + circular. Default 30x30 mirrors the
      Swift default; LiquidGlass.CircleButtonDiameter overrides Width/Height/CornerRadius.
    -->
    <Style x:Key="LiquidGlassCircleButtonStyle" TargetType="Button" BasedOn="{StaticResource LiquidGlassInteractiveStyle}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="CornerRadius" Value="15" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="30" />
        <Setter Property="MinHeight" Value="30" />
    </Style>

</ResourceDictionary>
