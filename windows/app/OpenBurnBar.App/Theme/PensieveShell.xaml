            <!-- Theme-aware Aurora aliases (light values) — same keys as Default. -->
            <SolidColorBrush x:Key="AuroraCanvasBrush" Color="{StaticResource PensieveColorAuroraLightBg}" />
            <SolidColorBrush x:Key="AuroraSurfaceBrush" Color="{StaticResource PensieveColorAuroraLightSurface}" />
            <SolidColorBrush x:Key="AuroraSurfaceElevatedBrush" Color="{StaticResource PensieveColorAuroraLightSurfaceElevated}" />
