<?xml version="1.0" encoding="utf-8"?>
<!--
  Pensieve shell chrome overrides for WinUI NavigationView and system surfaces.
  macOS AgentLens is dark-first Liquid Glass over ink; these resources keep the
  Windows shell from falling back to light Fluent white/gray plates.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- App / page plate: ink base, not system ApplicationPageBackground. -->
    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="{StaticResource PensieveColorInkBase}" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{StaticResource PensieveColorInkElevated}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource PensieveColorGlassBg}" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource PensieveColorGlassLine}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource PensieveColorInkBase}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="{StaticResource PensieveColorInkElevated}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="{StaticResource PensieveColorInkElevated}" />
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource PensieveColorGlassBg}" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="{StaticResource PensieveColorGlassBgElevated}" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource PensieveColorGlassLine}" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource PensieveColorTextBright}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource PensieveColorTextBase}" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource PensieveColorTextMute}" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource PensieveColorBrassCore}" />

    <!-- NavigationView: translucent ink pane + glass selection (macOS sidebar analogue). -->
    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#E612121A" />
    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#E612121A" />
    <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="#CC0A0A0E" />
    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="{StaticResource PensieveColorGlassLine}" />
    <SolidColorBrush x:Key="NavigationViewItemBackground" Color="Transparent" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#26C7CFDD" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#33C7CFDD" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#33FA6B06" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#40FA6B06" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#4DFA6B06" />
    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{StaticResource PensieveColorBrassCore}" />
    <SolidColorBrush x:Key="NavigationViewItemForeground" Color="{StaticResource PensieveColorTextBase}" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="{StaticResource PensieveColorTextBright}" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="{StaticResource PensieveColorTextBright}" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="{StaticResource PensieveColorTextBright}" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundDisabled" Color="{StaticResource PensieveColorTextDim}" />
    <SolidColorBrush x:Key="NavigationViewItemSeparatorForeground" Color="{StaticResource PensieveColorGlassLine}" />
    <SolidColorBrush x:Key="NavigationViewItemHeaderForeground" Color="{StaticResource PensieveColorTextMute}" />

    <!-- SettingsCard / expander (CommunityToolkit) often fall back to these. -->
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="{StaticResource PensieveColorGlassBg}" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="{StaticResource PensieveColorGlassBgElevated}" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="{StaticResource PensieveColorGlassLine}" />

</ResourceDictionary>
