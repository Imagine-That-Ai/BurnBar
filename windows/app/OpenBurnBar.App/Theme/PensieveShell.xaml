            <SolidColorBrush x:Key="AuroraTextMutedBrush" Color="{StaticResource PensieveColorAuroraLightTextMuted}" />
            <SolidColorBrush x:Key="AuroraAccentBrush" Color="{StaticResource PensieveColorAuroraLightEmber}" />
            <SolidColorBrush x:Key="AuroraAmberBrush" Color="{StaticResource PensieveColorAuroraLightAmber}" />
            <SolidColorBrush x:Key="AuroraWhimsyBrush" Color="{StaticResource PensieveColorAuroraLightWhimsy}" />
            <SolidColorBrush x:Key="AuroraSuccessBrush" Color="{StaticResource PensieveColorAuroraLightSuccess}" />
            <SolidColorBrush x:Key="AuroraWarningBrush" Color="{StaticResource PensieveColorAuroraLightWarning}" />
            <SolidColorBrush x:Key="AuroraErrorBrush" Color="{StaticResource PensieveColorAuroraLightError}" />
            <SolidColorBrush x:Key="AuroraGlassTintBaseBrush" Color="{StaticResource PensieveGlassLightTintBase}" />
            <SolidColorBrush x:Key="AuroraGlassTintElevatedBrush" Color="{StaticResource PensieveGlassLightTintElevated}" />
            <SolidColorBrush x:Key="AuroraGlassTintSunkenBrush" Color="#B8F3E8E6" />
            <SolidColorBrush x:Key="AuroraGlassTintClearBrush" Color="#8CFAF5F2" />
            <SolidColorBrush x:Key="AuroraGlassTintInteractiveBrush" Color="#61FDF8F5" />
            <SolidColorBrush x:Key="AuroraGlassStrokeBrush" Color="{StaticResource PensieveGlassStrokeLightBase}" />
            <SolidColorBrush x:Key="AuroraGlassStrokeFrostBrush" Color="{StaticResource PensieveGlassStrokeLightFrost}" />
            <SolidColorBrush x:Key="AuroraGlassInnerLightBrush" Color="{StaticResource PensieveGlassStrokeLightFrost}" />
            <SolidColorBrush x:Key="AuroraGlassSelectionFillBrush" Color="#14F45B69" />
            <SolidColorBrush x:Key="AuroraGlassSelectionStrokeBrush" Color="#4DF45B69" />
            <SolidColorBrush x:Key="AuroraGlassSheenFromBrush" Color="{StaticResource PensieveGlassSheenLightFrom}" />
            <SolidColorBrush x:Key="AuroraGlassSheenToBrush" Color="{StaticResource PensieveGlassSheenLightTo}" />
            <SolidColorBrush x:Key="AuroraGlassEdgeBrush" Color="{StaticResource PensieveGlassEdgeLight}" />
            <SolidColorBrush x:Key="AuroraGlassEdgeBorderBrush" Color="{StaticResource PensieveGlassEdgeLightBorder}" />

            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#E6FAF5F2" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#E6FAF5F2" />
            <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="#CCF3E8E6" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="{StaticResource PensieveGlassStrokeLightBase}" />
            <SolidColorBrush x:Key="NavigationViewItemBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#0F2A1816" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#1A2A1816" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#14F45B69" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#24F45B69" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#2EF45B69" />
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{StaticResource PensieveColorAuroraLightEmber}" />
            <SolidColorBrush x:Key="NavigationViewItemForeground" Color="{StaticResource PensieveColorAuroraLightTextSecondary}" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="{StaticResource PensieveColorAuroraLightText}" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="{StaticResource PensieveColorAuroraLightText}" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="{StaticResource PensieveColorAuroraLightText}" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundDisabled" Color="{StaticResource PensieveColorAuroraLightTextMuted}" />
            <SolidColorBrush x:Key="NavigationViewItemSeparatorForeground" Color="{StaticResource PensieveGlassStrokeLightBase}" />
            <SolidColorBrush x:Key="NavigationViewItemHeaderForeground" Color="{StaticResource PensieveColorAuroraLightTextMuted}" />

            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="{StaticResource PensieveGlassLightTintBase}" />
            <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="{StaticResource PensieveGlassLightTintElevated}" />
            <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="{StaticResource PensieveGlassStrokeLightBase}" />
        </ResourceDictionary>

        <!-- ── HighContrast — mirrors Default (pre-existing forced-brand behavior) ── -->
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="{StaticResource PensieveColorMacosBg}" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{StaticResource PensieveColorMacosSurface}" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource PensieveGlassTintElevated}" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource PensieveGlassStrokeBase}" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource PensieveColorMacosBg}" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="{StaticResource PensieveColorMacosSurface}" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="{StaticResource PensieveColorMacosSurfaceElevated}" />
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource PensieveGlassTintBase}" />
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="{StaticResource PensieveGlassTintElevated}" />
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource PensieveGlassStrokeBase}" />
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource PensieveColorMacosText}" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource PensieveColorMacosTextSecondary}" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource PensieveColorMacosTextMuted}" />
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource PensieveColorMacosEmber}" />
            <SolidColorBrush x:Key="AuroraCanvasBrush" Color="{StaticResource PensieveColorMacosBg}" />
            <SolidColorBrush x:Key="AuroraSurfaceBrush" Color="{StaticResource PensieveColorMacosSurface}" />
            <SolidColorBrush x:Key="AuroraSurfaceElevatedBrush" Color="{StaticResource PensieveColorMacosSurfaceElevated}" />
            <SolidColorBrush x:Key="AuroraTextBrush" Color="{StaticResource PensieveColorMacosText}" />
            <SolidColorBrush x:Key="AuroraTextSecondaryBrush" Color="{StaticResource PensieveColorMacosTextSecondary}" />
            <SolidColorBrush x:Key="AuroraTextMutedBrush" Color="{StaticResource PensieveColorMacosTextMuted}" />
            <SolidColorBrush x:Key="AuroraAccentBrush" Color="{StaticResource PensieveColorMacosEmber}" />
            <SolidColorBrush x:Key="AuroraAmberBrush" Color="{StaticResource PensieveColorMacosAmber}" />
            <SolidColorBrush x:Key="AuroraWhimsyBrush" Color="{StaticResource PensieveColorMacosWhimsy}" />
            <SolidColorBrush x:Key="AuroraSuccessBrush" Color="{StaticResource PensieveColorMacosSuccess}" />
            <SolidColorBrush x:Key="AuroraWarningBrush" Color="{StaticResource PensieveColorMacosWarning}" />
