<?xml version="1.0" encoding="utf-8"?>
<!--
  Aurora shell chrome overrides for WinUI NavigationView and system surfaces.

  The macOS app (AgentLens/) is the design oracle: Dark = the Aurora dark cool-slate
  ramp (DesignSystem.Colors dark, mirrored 1:1 by apps/linux-desktop liquid-glass-tokens.css),
  Light = the Aurora light coral-dust ramp. All values flow from the token pipeline
  (packages/design-tokens/tokens/aurora.tokens.json → Theme/Tokens.xaml) — this file only
  maps Fluent system brushes onto those tokens, per theme, via ThemeDictionaries.
  (Before 2026-07 these overrides were dark-only and lived at the dictionary root, so
  Light mode painted dark ink plates — broken by design.)

  WinUI theme keys: "Default" = dark, "Light" = light, "HighContrast" mirrors Default
  (preserves the pre-existing forced-brand behavior under HC; Fluent HC semantics are
  intentionally not adopted yet).
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <!-- ── Dark (Default) — macOS Aurora dark slate ─────────────────────── -->
        <ResourceDictionary x:Key="Default">
            <!-- App / page plate: Aurora canvas, not system ApplicationPageBackground. -->
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="{StaticResource PensieveColorMacosBg}" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{StaticResource PensieveColorMacosSurface}" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource PensieveGlassTintElevated}" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource PensieveGlassStrokeBase}" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource PensieveColorMacosBg}" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="{StaticResource PensieveColorMacosSurface}" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="{StaticResource PensieveColorMacosSurfaceElevated}" />
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource PensieveGlassTintBase}" />
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="{StaticResource PensieveGlassTintElevated}" />
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource PensieveGlassStrokeBase}" />
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource PensieveColorMacosText}" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource PensieveColorMacosTextSecondary}" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource PensieveColorMacosTextMuted}" />
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource PensieveColorMacosEmber}" />

            <!-- Theme-aware Aurora aliases consumed via {ThemeResource} by LiquidGlass.xaml /
                 Typography.xaml so the glass + ink swap when the theme swaps. -->
            <SolidColorBrush x:Key="AuroraCanvasBrush" Color="{StaticResource PensieveColorMacosBg}" />
            <SolidColorBrush x:Key="AuroraSurfaceBrush" Color="{StaticResource PensieveColorMacosSurface}" />
            <SolidColorBrush x:Key="AuroraSurfaceElevatedBrush" Color="{StaticResource PensieveColorMacosSurfaceElevated}" />
            <SolidColorBrush x:Key="AuroraTextBrush" Color="{StaticResource PensieveColorMacosText}" />
            <SolidColorBrush x:Key="AuroraTextSecondaryBrush" Color="{StaticResource PensieveColorMacosTextSecondary}" />
            <SolidColorBrush x:Key="AuroraTextMutedBrush" Color="{StaticResource PensieveColorMacosTextMuted}" />
            <SolidColorBrush x:Key="AuroraAccentBrush" Color="{StaticResource PensieveColorMacosEmber}" />
            <SolidColorBrush x:Key="AuroraAmberBrush" Color="{StaticResource PensieveColorMacosAmber}" />
            <SolidColorBrush x:Key="AuroraWhimsyBrush" Color="{StaticResource PensieveColorMacosWhimsy}" />
            <SolidColorBrush x:Key="AuroraSuccessBrush" Color="{StaticResource PensieveColorMacosSuccess}" />
            <SolidColorBrush x:Key="AuroraWarningBrush" Color="{StaticResource PensieveColorMacosWarning}" />
            <SolidColorBrush x:Key="AuroraErrorBrush" Color="{StaticResource PensieveColorMacosError}" />
            <SolidColorBrush x:Key="AuroraGlassTintBaseBrush" Color="{StaticResource PensieveGlassTintBase}" />
            <SolidColorBrush x:Key="AuroraGlassTintElevatedBrush" Color="{StaticResource PensieveGlassTintElevated}" />
            <SolidColorBrush x:Key="AuroraGlassTintSunkenBrush" Color="{StaticResource PensieveGlassTintSunken}" />
            <SolidColorBrush x:Key="AuroraGlassTintClearBrush" Color="{StaticResource PensieveGlassTintClear}" />
            <SolidColorBrush x:Key="AuroraGlassTintInteractiveBrush" Color="{StaticResource PensieveGlassTintInteractive}" />
            <SolidColorBrush x:Key="AuroraGlassStrokeBrush" Color="{StaticResource PensieveGlassStrokeBase}" />
            <SolidColorBrush x:Key="AuroraGlassStrokeFrostBrush" Color="{StaticResource PensieveGlassStrokeFrost}" />
            <SolidColorBrush x:Key="AuroraGlassInnerLightBrush" Color="{StaticResource PensieveGlassInnerLight}" />
            <SolidColorBrush x:Key="AuroraGlassSelectionFillBrush" Color="{StaticResource PensieveGlassSelectionFill}" />
            <SolidColorBrush x:Key="AuroraGlassSelectionStrokeBrush" Color="{StaticResource PensieveGlassSelectionStroke}" />
            <SolidColorBrush x:Key="AuroraGlassSheenFromBrush" Color="{StaticResource PensieveGlassSheenDarkFrom}" />
            <SolidColorBrush x:Key="AuroraGlassSheenToBrush" Color="{StaticResource PensieveGlassSheenDarkTo}" />
            <SolidColorBrush x:Key="AuroraGlassEdgeBrush" Color="{StaticResource PensieveGlassEdgeLight}" />
            <SolidColorBrush x:Key="AuroraGlassEdgeBorderBrush" Color="{StaticResource PensieveGlassEdgeDarkBorder}" />

            <!-- NavigationView: translucent slate pane + glass selection (macOS sidebar analogue:
                 selected = ember @8% fill, hover = text @8–12% — macOS SidebarItem semantics). -->
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#E6161B22" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#E6161B22" />
            <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="#CC0D1117" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="{StaticResource PensieveGlassStrokeBase}" />
            <SolidColorBrush x:Key="NavigationViewItemBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#14E6EDF3" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#1FE6EDF3" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="{StaticResource PensieveGlassSelectionFill}" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#29FA5053" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#33FA5053" />
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{StaticResource PensieveColorMacosEmber}" />
            <SolidColorBrush x:Key="NavigationViewItemForeground" Color="{StaticResource PensieveColorMacosTextSecondary}" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="{StaticResource PensieveColorMacosText}" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="{StaticResource PensieveColorMacosText}" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="{StaticResource PensieveColorMacosText}" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundDisabled" Color="{StaticResource PensieveColorMacosTextMuted}" />
            <SolidColorBrush x:Key="NavigationViewItemSeparatorForeground" Color="{StaticResource PensieveGlassStrokeBase}" />
            <SolidColorBrush x:Key="NavigationViewItemHeaderForeground" Color="{StaticResource PensieveColorMacosTextMuted}" />

            <!-- SettingsCard / expander (CommunityToolkit) often fall back to these. -->
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="{StaticResource PensieveGlassTintBase}" />
            <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="{StaticResource PensieveGlassTintElevated}" />
            <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="{StaticResource PensieveGlassStrokeBase}" />
        </ResourceDictionary>

        <!-- ── Light — macOS Aurora light (coral dust) ──────────────────────── -->
