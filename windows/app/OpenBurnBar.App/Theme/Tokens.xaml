    <x:String x:Key="PensieveMotionEaseSettle">cubic-bezier(0.22, 1, 0.36, 1)</x:String>
    <x:String x:Key="PensieveMotionEaseArrive">cubic-bezier(0.34, 1.32, 0.44, 1)</x:String>

