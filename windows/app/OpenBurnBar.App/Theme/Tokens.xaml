    <!-- ── Pensieve primitives — font stacks + easing curves (x:String) ── -->
    <x:String x:Key="PensieveFontDisplay">Outfit, 'Geist Variable', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif</x:String>
    <x:String x:Key="PensieveFontBody">'Geist Variable', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif</x:String>
