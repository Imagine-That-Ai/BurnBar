<?xml version="1.0" encoding="utf-8"?>
<!--
  Aurora glass controls — the shared component vocabulary the macOS app (GlassCard /
  GlassButton / GlassIconButton / toolbarPill / GlassSegmentedPicker / StatCard / SidebarItem /
  ChartGlassCard in AgentLens/Views) and the Linux shell (SurfaceCard, glass buttons, pills,
  alerts in apps/linux-desktop/src) render, expressed as WinUI styles over the token pipeline
  values (packages/design-tokens/tokens/aurora.tokens.json).

  Every brush is {ThemeResource}-resolved so Dark (Aurora slate) and Light (Aurora coral-dust)
  swap correctly. Interactive physics come from LiquidGlassInteractiveStyle (hover 1.015 /
  press 0.98 — the macOS GlassCard values). Merged in App.xaml after LiquidGlass.xaml.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkitControls="using:CommunityToolkit.WinUI.Controls">

    <!-- ═══ Cards ═══ -->

    <!-- macOS GlassCard: radius 10, elevated tint plate, hairline border, padding 12.
         (The richer sheen + luminous-edge variant stays in Components/UnifiedGlassCard.) -->
    <Style x:Key="AuroraGlassCardStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource OBBCardCornerRadius}" />
        <Setter Property="Background" Value="{ThemeResource AuroraGlassTintElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AuroraGlassStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource PensieveSpace3Thickness}" />
    </Style>

    <!-- ═══ Buttons ═══ -->

    <!-- macOS GlassButton .prominent: ember wash + ember/amber gradient stroke + gradient text. -->
    <Style x:Key="AuroraGlassButtonProminentStyle" TargetType="Button" BasedOn="{StaticResource LiquidGlassInteractiveStyle}">
        <Setter Property="Background" Value="{ThemeResource AuroraGlassSelectionFillBrush}" />
        <Setter Property="BorderBrush">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource PensieveColorMacosEmber}" Offset="0" />
                    <GradientStop Color="{StaticResource PensieveColorMacosAmber}" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Foreground">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="{StaticResource PensieveColorMacosEmber}" Offset="0" />
                    <GradientStop Color="{StaticResource PensieveColorMacosAmber}" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- macOS GlassButton .regular: neutral interactive glass (alias with intent name). -->
    <Style x:Key="AuroraGlassButtonRegularStyle" TargetType="Button" BasedOn="{StaticResource LiquidGlassInteractiveStyle}" />

    <!-- macOS GlassButton .cool (Quit / drain): frost→abyss wash + frost text. -->
    <Style x:Key="AuroraGlassButtonCoolStyle" TargetType="Button" BasedOn="{StaticResource LiquidGlassInteractiveStyle}">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#196FC2FF" Offset="0" />
                    <GradientStop Color="#1412294D" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="#596FC2FF" />
        <Setter Property="Foreground" Value="{StaticResource PensieveColorMacosFrostBrush}" />
    </Style>

    <!-- macOS GlassIconButton: 28pt circle, surface plate + sheen + hairline. -->
    <Style x:Key="AuroraGlassIconButtonStyle" TargetType="Button" BasedOn="{StaticResource LiquidGlassCircleButtonStyle}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>

    <!-- ═══ Toolbar pills + segmented pickers ═══ -->

    <!-- macOS toolbarPill: radius 8 glass plate (range/unit pickers, chips). -->
    <Style x:Key="AuroraToolbarPillStyle" TargetType="Border" BasedOn="{StaticResource LiquidGlassToolbarStyle}" />

    <!-- Segmented-picker item: unselected segment is transparent, selected rides the
         AuroraGlassSegmentSelectedStyle below. Radius 6 matches the macOS selected segment. -->
    <Style x:Key="AuroraGlassSegmentStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource PensieveRadiusXsCorner}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="10,4" />
    </Style>
    <Style x:Key="AuroraGlassSegmentSelectedStyle" TargetType="Border" BasedOn="{StaticResource AuroraGlassSegmentStyle}">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource PensieveColorMacosEmber}" Offset="0" />
                    <GradientStop Color="{StaticResource PensieveColorMacosAmber}" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Inputs ═══ -->

    <!-- Linux .glass-input: sunken plate + ember focus ring (border @45%, 2px outer glow @22%). -->
    <Style x:Key="AuroraGlassInputStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{ThemeResource AuroraGlassTintSunkenBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AuroraTextBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AuroraGlassStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource PensieveRadiusSmCorner}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontFamily" Value="{StaticResource AuroraBodyFont}" />
        <Setter Property="FontSize" Value="{StaticResource PensieveTypeSizeBody}" />
        <Setter Property="SelectionHighlightColor" Value="{ThemeResource AuroraGlassSelectionStrokeBrush}" />
    </Style>

    <!-- ═══ Alerts (Linux GlassAlert pill capsules: severity @10% over elevated) ═══ -->

    <Style x:Key="AuroraGlassAlertInfoStyle" TargetType="Border" BasedOn="{StaticResource LiquidGlassPillStyle}">
        <Setter Property="Background" Value="{StaticResource PensieveGlassAlertInfoBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PensieveColorMacosSuccessBrush}" />
    </Style>
    <Style x:Key="AuroraGlassAlertWarningStyle" TargetType="Border" BasedOn="{StaticResource LiquidGlassPillStyle}">
        <Setter Property="Background" Value="{StaticResource PensieveGlassAlertWarningBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PensieveColorMacosWarningBrush}" />
    </Style>
    <Style x:Key="AuroraGlassAlertErrorStyle" TargetType="Border" BasedOn="{StaticResource LiquidGlassPillStyle}">
        <Setter Property="Background" Value="{StaticResource PensieveGlassAlertErrorBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PensieveColorMacosErrorBrush}" />
    </Style>

    <!-- ═══ Stat card text (macOS StatCard: uppercase tiny muted label + gradient mono value) ═══ -->

    <Style x:Key="AuroraStatCardLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource AuroraTinyTextStyle}">
        <Setter Property="CharacterSpacing" Value="80" />
        <!-- Labels render uppercase at the call site (WinUI TextBlock has no TextTransform). -->
    </Style>
    <Style x:Key="AuroraStatCardValueStyle" TargetType="TextBlock" BasedOn="{StaticResource AuroraMonoLargeTextStyle}">
        <Setter Property="Foreground">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="{StaticResource PensieveColorMacosEmber}" Offset="0" />
                    <GradientStop Color="#A6FA5053" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Sidebar rows (macOS SidebarItem: radius 10, logo + name + mono metric) ═══ -->

    <Style x:Key="AuroraSidebarItemStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource OBBCardCornerRadius}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{ThemeResource AuroraGlassStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style x:Key="AuroraSidebarItemSelectedStyle" TargetType="Border" BasedOn="{StaticResource AuroraSidebarItemStyle}">
        <Setter Property="Background" Value="{ThemeResource AuroraGlassSelectionFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AuroraGlassSelectionStrokeBrush}" />
    </Style>

    <!-- ═══ Hairline divider (macOS popover section separators: 0.5–1pt stroke) ═══ -->

    <Style x:Key="AuroraGlassDividerStyle" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{ThemeResource AuroraGlassStrokeBrush}" />
        <Setter Property="Opacity" Value="0.6" />
    </Style>

    <!-- ═══ Dialogs (Linux CommandPalette: radius 20 elevated glass over dim scrim) ═══ -->

    <Style x:Key="AuroraGlassDialogStyle" TargetType="ContentDialog">
        <Setter Property="Background" Value="{ThemeResource AuroraGlassTintElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AuroraGlassStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource PensieveRadiusLgCorner}" />
        <Setter Property="Foreground" Value="{ThemeResource AuroraTextBrush}" />
    </Style>

    <!-- ═══ CommunityToolkit SettingsCard/Expander — implicit Aurora glass chrome.
         Every Settings leaf page (General/Updates/DataSource/…) inherits these, which
         replaces the stock Fluent card look with the macOS glass card (radius 10,
         elevated tint plate, hairline border). Structure stays CommunityToolkit. ═══ -->

    <Style TargetType="toolkitControls:SettingsCard">
        <Setter Property="Background" Value="{ThemeResource AuroraGlassTintElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AuroraGlassStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource OBBCardCornerRadius}" />
        <Setter Property="Foreground" Value="{ThemeResource AuroraTextBrush}" />
    </Style>
    <Style TargetType="toolkitControls:SettingsExpander">
        <Setter Property="Background" Value="{ThemeResource AuroraGlassTintElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AuroraGlassStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource OBBCardCornerRadius}" />
        <Setter Property="Foreground" Value="{ThemeResource AuroraTextBrush}" />
    </Style>

</ResourceDictionary>
