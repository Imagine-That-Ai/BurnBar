<?xml version="1.0" encoding="utf-8"?>
<!--
  AppearanceModeControl — the Windows port of AgentLens/Views/Settings/AppearanceModePickerView.

  A row of selectable mode cards (System / Light / Dark / High contrast) over a
  "Reduce transparency" toggle. Selection drives the shell-wide ThemeService, which
  applies the ElementTheme + backdrop on/off across every window.

  Each option renders a swatch tile previewing that mode's canvas + accent (the design-pass
  successor to the original glyph-only rows). The tile pins RequestedTheme to the mode's
  ElementTheme via AppearanceModeExtensions.ToElementTheme — the exact mapping ThemeService
  applies — so {ThemeResource} AuroraCanvasBrush/AuroraAccentBrush resolve to that mode's
  plate + accent (Dark: #0D1117 + #FA5053 dot; Light: #F3E8E6 + #F45B69 dot). High
  contrast overlays a solid black plate with a white border (AppearanceModeExtensions.
  HighContrastOverlayVisibility — a Visibility-returning helper, since x:Bind function
  bindings type-check the return type against the target property and a bool + converter
  does not compile through a function bind). System previews its effective resolution (System → Dark
  per ToElementTheme): a literal half-dark/half-light split would need Mode-identity
  branching the shared ItemTemplate cannot express without new code-behind — System and
  Dark share every derivable signal, so the tile honestly previews what System resolves to.

  RadioButtons stays the accessible control (keyboard/Narrator-ready, selection bindings
  intact); only the item content template was restyled.
-->
<UserControl
    x:Class="OpenBurnBar.App.Theme.AppearanceModeControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenBurnBar.App.Theme"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="14">

        <TextBlock Text="Appearance"
                   FontWeight="SemiBold"
                   FontSize="15" />

        <controls:RadioButtons x:Name="ModeButtons"
                               MaxColumns="4"
                               SelectionChanged="ModeButtons_SelectionChanged">
            <controls:RadioButtons.ItemTemplate>
                <DataTemplate x:DataType="local:AppearanceModeOption">
                    <StackPanel Spacing="6">
                        <!-- Swatch tile: mode canvas plate + accent dot, radius 10 (OBBCardCornerRadius). -->
                        <Grid Width="64"
                              Height="40"
                              RequestedTheme="{x:Bind local:AppearanceModeExtensions.ToElementTheme(Mode), Mode=OneWay}">
                            <Border CornerRadius="{StaticResource OBBCardCornerRadius}"
                                    Background="{ThemeResource AuroraCanvasBrush}"
                                    BorderBrush="{ThemeResource AuroraGlassStrokeBrush}"
                                    BorderThickness="1" />
                            <Ellipse Width="10"
                                     Height="10"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Top"
                                     Margin="0,6,6,0"
                                     Fill="{ThemeResource AuroraAccentBrush}" />
                            <!-- High contrast: solid black plate + white border. -->
                            <Border CornerRadius="{StaticResource OBBCardCornerRadius}"
                                    Background="Black"
                                    BorderBrush="White"
                                    BorderThickness="2"
                                    Visibility="{x:Bind local:AppearanceModeExtensions.HighContrastOverlayVisibility(Mode), Mode=OneWay}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <FontIcon FontFamily="Segoe MDL2 Assets"
                                      FontSize="12"
                                      Glyph="{x:Bind Glyph}" />
                            <TextBlock Text="{x:Bind Label}" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </controls:RadioButtons.ItemTemplate>
        </controls:RadioButtons>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Reduce transparency"
                           FontWeight="SemiBold"
                           FontSize="13" />
                <TextBlock Text="Turn off Mica/Acrylic and use solid surfaces."
                           Opacity="0.7"
                           FontSize="12"
                           TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1"
                          x:Name="ReduceTransparencyToggle"
                          MinWidth="0"
                          Toggled="ReduceTransparencyToggle_Toggled" />
        </Grid>

    </StackPanel>
</UserControl>
