<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows render of the delete confirmation (AgentLens/Views/Settings/DataControlCenter/
  DataControlCenterActions.swift · DeleteDomainSheet). Permanent, type-DELETE-to-confirm deletion of
  a domain's data; end-to-end domains note that this is genuine, irreversible ciphertext deletion.
  Binds to the portable DataControlCenterViewModel.deleteDomain.
-->
<ContentDialog
    x:Class="OpenBurnBar.App.DataControlCenter.DeleteDomainDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    PrimaryButtonText="Delete permanently"
    CloseButtonText="Cancel"
    DefaultButton="None"
    Background="{StaticResource PensieveColorGlassBgElevatedBrush}">

    <StackPanel Spacing="14" MinWidth="440">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{StaticResource PensieveColorSealCrimsonBrush}" />
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="Bold"
                       Foreground="{StaticResource PensieveColorTextBrightBrush}" />
        </StackPanel>

        <TextBlock x:Name="WarningText" FontSize="12" TextWrapping="Wrap"
                   Foreground="{StaticResource PensieveColorTextBaseBrush}" />

        <StackPanel x:Name="ConfirmGroup" Spacing="6">
            <TextBlock Text="Type DELETE to confirm" FontSize="11"
                       Foreground="{StaticResource PensieveColorTextMuteBrush}" />
            <TextBox x:Name="ConfirmBox" FontFamily="Cascadia Mono, Consolas"
                     FontWeight="SemiBold" TextChanged="OnConfirmChanged" />
        </StackPanel>

        <StackPanel x:Name="ResultGroup" Spacing="4" Visibility="Collapsed" Orientation="Horizontal">
            <FontIcon Glyph="&#xE73E;" FontSize="13"
                      Foreground="{StaticResource PensieveColorTierEndToEndBrush}" />
            <TextBlock x:Name="ResultText" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource PensieveColorTierEndToEndBrush}" />
        </StackPanel>

        <TextBlock x:Name="ErrorText" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                   Foreground="{StaticResource PensieveColorSealCrimsonBrush}" />
    </StackPanel>
</ContentDialog>
