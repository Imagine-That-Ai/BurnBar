<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared chrome for the Data Control Center (Phase 3 · W7). The Windows analog of the macOS
  InspectorCard chrome (AgentLens/Views/Settings/DataControlCenter/DataControlCenterInspector.swift)
  and the governance-card look reused by the inventory, inspector, and dialogs. Merged globally via
  App.xaml so every Data Control Center surface reads the same frosted card + tier badge shell.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- InspectorCard: a frosted, stroked, padded governance card. -->
    <Style x:Key="DataInspectorCardStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource PensieveRadiusMdCorner}" />
        <Setter Property="Background" Value="{StaticResource PensieveColorGlassBgBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PensieveColorGlassLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Inventory column-header button: a flat, left-aligned, clickable sort header. -->
    <Style x:Key="DataGridHeaderButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Foreground" Value="{StaticResource PensieveColorTextMuteBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

</ResourceDictionary>
