<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows render of the domain inspector (AgentLens/Views/Settings/DataControlCenter/
  DataControlCenterInspector.swift) — the right-hand pane for the selected domain: header, the
  yours↔server flip, the footprint card, the Pensieve hard-cap meters (Pensieve only), the
  tamper-evident audit card (Access Audit only), the "where it lives" paths, and the per-domain
  actions. Sections are shown/populated in code-behind via Show(viewModel, row); the flip + audit
  list bind to the portable, unit-tested view-model.
-->
<UserControl
    x:Class="OpenBurnBar.App.DataControlCenter.DomainInspectorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenBurnBar.App.DataControlCenter"
    xmlns:dcc="using:OpenBurnBar.App.Presentation.DataControlCenter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel Spacing="18">

            <!-- Header -->
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="HeaderIconTile" Grid.Column="0" Width="48" Height="48"
                        CornerRadius="{StaticResource PensieveRadiusMdCorner}">
                    <FontIcon x:Name="HeaderIcon" Glyph="&#xE8B7;" FontSize="20" Foreground="White" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock x:Name="HeaderTitle"
                               FontSize="20" FontWeight="Bold"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource PensieveColorTextBrightBrush}" />
                    <TextBlock x:Name="HeaderSummary"
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource PensieveColorTextBaseBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border x:Name="HeaderTierBadge"
                                CornerRadius="{StaticResource PensieveRadiusPillCorner}"
                                BorderThickness="0.5"
                                Padding="8,3">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon x:Name="HeaderTierGlyph" FontSize="10" />
                                <TextBlock x:Name="HeaderTierLabel" FontSize="10" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="{StaticResource PensieveRadiusPillCorner}"
                                Background="#14FFFFFF" Padding="8,3">
                            <TextBlock x:Name="HeaderRetention" FontSize="10"
                                       Foreground="{StaticResource PensieveColorTextMuteBrush}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Yours ↔ Server flip -->
            <local:YoursVsServerFlip x:Name="Flip" />

            <!-- Footprint -->
            <Border Style="{StaticResource DataInspectorCardStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE9D2;" FontSize="10" Foreground="{StaticResource PensieveColorBrassCoreBrush}" />
                        <TextBlock Text="FOOTPRINT" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource PensieveColorBrassCoreBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="18">
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="FootprintCount" FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource PensieveColorTextBrightBrush}" />
                            <TextBlock x:Name="FootprintCountLabel" FontSize="10"
                                       Foreground="{StaticResource PensieveColorTextMuteBrush}" />
                        </StackPanel>
                        <StackPanel x:Name="FootprintBytesGroup" Spacing="2">
                            <TextBlock x:Name="FootprintBytes" FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource PensieveColorTextBrightBrush}" />
                            <TextBlock Text="Stored" FontSize="10"
                                       Foreground="{StaticResource PensieveColorTextMuteBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <Border x:Name="FootprintBar" Height="6"
                            CornerRadius="{StaticResource PensieveRadiusPillCorner}" />
                </StackPanel>
            </Border>

            <!-- Pensieve hard caps (Pensieve only) -->
            <Border x:Name="PensieveCard" Style="{StaticResource DataInspectorCardStyle}" Visibility="Collapsed">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE9D9;" FontSize="10" Foreground="{StaticResource PensieveColorBrassCoreBrush}" />
                        <TextBlock Text="PENSIEVE LIMITS" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource PensieveColorBrassCoreBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="PensieveCaption" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource PensieveColorTextBaseBrush}" />
                    <StackPanel Spacing="4">
                        <Grid>
                            <TextBlock Text="Chunks" FontSize="11" HorizontalAlignment="Left"
                                       Foreground="{StaticResource PensieveColorTextBaseBrush}" />
                            <TextBlock x:Name="PensieveChunksValue" FontSize="11" FontWeight="SemiBold"
                                       FontFamily="Cascadia Mono, Consolas" HorizontalAlignment="Right"
                                       Foreground="{StaticResource PensieveColorTextBrightBrush}" />
                        </Grid>
                        <ProgressBar x:Name="PensieveChunksBar" Minimum="0" Maximum="1" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <Grid>
                            <TextBlock Text="Storage" FontSize="11" HorizontalAlignment="Left"
                                       Foreground="{StaticResource PensieveColorTextBaseBrush}" />
                            <TextBlock x:Name="PensieveStorageValue" FontSize="11" FontWeight="SemiBold"
                                       FontFamily="Cascadia Mono, Consolas" HorizontalAlignment="Right"
                                       Foreground="{StaticResource PensieveColorTextBrightBrush}" />
                        </Grid>
                        <ProgressBar x:Name="PensieveStorageBar" Minimum="0" Maximum="1" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Tamper-evident audit (Access Audit only) -->
            <Border x:Name="AuditCard" Style="{StaticResource DataInspectorCardStyle}" Visibility="Collapsed">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72E;" FontSize="10" Foreground="{StaticResource PensieveColorBrassCoreBrush}" />
                        <TextBlock Text="TAMPER-EVIDENT LOG" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource PensieveColorBrassCoreBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="VerifyButton" Click="OnVerifyClick"
                                Style="{StaticResource LiquidGlassInteractiveStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE73E;" FontSize="12" />
                                <TextBlock Text="Verify chain" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="VerifyResult" FontSize="11" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="AuditEmpty" Text="No audit events yet." FontSize="11"
                               Foreground="{StaticResource PensieveColorTextMuteBrush}" />
                    <ItemsRepeater x:Name="AuditList">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="6" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="dcc:AuditEvent">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind Seq}"
                                               FontFamily="Cascadia Mono, Consolas" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource PensieveColorTextMuteBrush}" />
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Text="{x:Bind Actor}" FontSize="11" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource PensieveColorTextBrightBrush}" />
                                        <TextBlock Text="{x:Bind Domain}" FontSize="10"
                                                   Foreground="{StaticResource PensieveColorTextMuteBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <!-- Where it lives -->
            <Border Style="{StaticResource DataInspectorCardStyle}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xEDA2;" FontSize="10" Foreground="{StaticResource PensieveColorBrassCoreBrush}" />
                        <TextBlock Text="WHERE IT LIVES" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource PensieveColorBrassCoreBrush}" />
                    </StackPanel>
                    <StackPanel x:Name="CollectionsGroup" Spacing="6">
                        <TextBlock Text="COLLECTIONS" FontSize="9" FontWeight="SemiBold"
                                   Foreground="{StaticResource PensieveColorTextMuteBrush}" />
                        <ItemsRepeater x:Name="CollectionsChips">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="120" MinItemHeight="24"
                                                   MinRowSpacing="6" MinColumnSpacing="6" ItemsStretch="None" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border CornerRadius="{StaticResource PensieveRadiusPillCorner}"
                                            Background="#1FC7CFDD" Padding="9,4">
                                        <TextBlock Text="{x:Bind}" FontSize="11"
                                                   FontFamily="Cascadia Mono, Consolas"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource PensieveColorTextBaseBrush}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                    <StackPanel x:Name="StorageGroup" Spacing="6" Visibility="Collapsed">
                        <TextBlock Text="STORAGE" FontSize="9" FontWeight="SemiBold"
                                   Foreground="{StaticResource PensieveColorTextMuteBrush}" />
                        <ItemsRepeater x:Name="StorageChips">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="120" MinItemHeight="24"
                                                   MinRowSpacing="6" MinColumnSpacing="6" ItemsStretch="None" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border CornerRadius="{StaticResource PensieveRadiusPillCorner}"
                                            Background="#1F8B94A8" Padding="9,4">
                                        <TextBlock Text="{x:Bind}" FontSize="11"
                                                   FontFamily="Cascadia Mono, Consolas"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource PensieveColorTextBaseBrush}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Actions -->
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="ExportButton" Click="OnExportClick"
                        Style="{StaticResource LiquidGlassInteractiveStyle}" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xEDE1;" FontSize="12" />
                        <TextBlock Text="Export" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
                <Button x:Name="RecoverButton" Click="OnRecoverClick"
                        Style="{StaticResource LiquidGlassInteractiveStyle}" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE192;" FontSize="12" />
                        <TextBlock Text="Recovery" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
                <Button x:Name="DeleteButton" Click="OnDeleteClick"
                        Style="{StaticResource LiquidGlassInteractiveStyle}" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74D;" FontSize="12"
                                  Foreground="{StaticResource PensieveColorSealCrimsonBrush}" />
                        <TextBlock Text="Delete" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource PensieveColorSealCrimsonBrush}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
