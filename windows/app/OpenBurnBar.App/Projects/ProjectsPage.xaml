<?xml version="1.0" encoding="utf-8"?>
<!-- IA-4 project groups plus optional Tree-sitter-backed code symbols. -->
<Page
    x:Class="OpenBurnBar.App.Projects.ProjectsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:theme="using:OpenBurnBar.App.Theme"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="180" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Projects"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PensieveColorTextBrightBrush}" />
            <TextBlock x:Name="StatusText"
                       TextWrapping="Wrap"
                       FontSize="13"
                       Foreground="{StaticResource PensieveColorTextMuteBrush}" />
        </StackPanel>

        <Border Grid.Row="1"
                Style="{StaticResource LiquidGlassPillStyle}"
                theme:LiquidGlass.Surface="True"
                HorizontalAlignment="Left"
                Padding="10,4">
            <TextBlock Text="List-level peer · IA-4"
                       FontSize="11"
                       Opacity="0.75" />
        </Border>

        <TextBlock x:Name="DepthText"
                   Grid.Row="2"
                   TextWrapping="Wrap"
                   FontSize="12"
                   Opacity="0.85"
                   Foreground="{StaticResource PensieveColorTextMuteBrush}" />

        <TextBlock Grid.Row="3"
                   Text="Project groups"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource PensieveColorTextBrightBrush}" />

        <ListView x:Name="ProjectList"
                  Grid.Row="4"
                  SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Padding="0,8" Spacing="2">
                        <TextBlock Text="{Binding ProjectKey}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PensieveColorTextBrightBrush}" />
                        <TextBlock Text="{Binding Summary}"
                                   FontSize="12"
                                   Foreground="{StaticResource PensieveColorTextMuteBrush}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="5" Spacing="2" Margin="0,10,0,0">
            <TextBlock Text="Code symbols"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PensieveColorTextBrightBrush}" />
            <TextBlock Text="Tree-sitter symbols are shown only when the signed parser path is configured."
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource PensieveColorTextMuteBrush}" />
        </StackPanel>

        <ListView x:Name="CodeSymbolList"
                  Grid.Row="6"
                  SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Padding="0,6" Spacing="2">
                        <TextBlock Text="{Binding Name}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PensieveColorTextBrightBrush}" />
                        <TextBlock FontSize="11"
                                   Foreground="{StaticResource PensieveColorTextMuteBrush}">
                            <Run Text="{Binding Kind}" />
                            <Run Text=" · line " />
                            <Run Text="{Binding Line}" />
                            <Run Text=" · " />
                            <Run Text="{Binding ConfidenceTier}" />
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
