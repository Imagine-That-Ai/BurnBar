<?xml version="1.0" encoding="utf-8"?>
<!-- IA-4 project groups plus optional Tree-sitter-backed code symbols. -->
<Page
    x:Class="OpenBurnBar.App.Projects.ProjectsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Projects"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PensieveColorTextBrightBrush}" />
            <TextBlock x:Name="StatusText"
                       TextWrapping="Wrap"
                       FontSize="13"
                       Foreground="{StaticResource PensieveColorTextMuteBrush}" />
        </StackPanel>

        <Grid Grid.Row="1"
              x:Name="RootSelectionGrid"
              MinHeight="64"
              Padding="0,10"
              ColumnSpacing="12">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="NarrowRootSelection">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="FolderActions.(Grid.Row)" Value="1" />
                            <Setter Target="FolderActions.(Grid.Column)" Value="0" />
                            <Setter Target="FolderActions.(Grid.ColumnSpan)" Value="2" />
                            <Setter Target="FolderActions.Margin" Value="0,10,0,0" />
                            <Setter Target="FolderActions.HorizontalAlignment" Value="Left" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="WideRootSelection">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="640" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="FolderActions.(Grid.Row)" Value="0" />
                            <Setter Target="FolderActions.(Grid.Column)" Value="1" />
                            <Setter Target="FolderActions.(Grid.ColumnSpan)" Value="1" />
                            <Setter Target="FolderActions.Margin" Value="0" />
                            <Setter Target="FolderActions.HorizontalAlignment" Value="Right" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="Indexed folder"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PensieveColorTextBrightBrush}" />
                <TextBlock x:Name="ProjectRootPathText"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="2"
                           FontSize="12"
                           Foreground="{StaticResource PensieveColorTextMuteBrush}" />
                <TextBlock x:Name="ProjectRootStatusText"
                           TextWrapping="Wrap"
                           FontSize="11"
                           Foreground="{StaticResource PensieveColorTextMuteBrush}" />
            </StackPanel>

            <StackPanel x:Name="FolderActions"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                <Button x:Name="ChooseFolderButton"
                        MinWidth="132"
                        Height="36"
                        Click="ChooseFolder_Click"
                        ToolTipService.ToolTip="Choose the project folder to index">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B7;" FontSize="13" />
                        <TextBlock Text="Choose folder" />
                    </StackPanel>
                </Button>

                <Button x:Name="ClearFolderButton"
                        Width="36"
                        Height="36"
                        Padding="0"
                        Click="ClearFolder_Click"
                        AutomationProperties.Name="Clear indexed folder"
                        ToolTipService.ToolTip="Clear indexed folder">
                    <FontIcon Glyph="&#xE74D;" FontSize="13" />
                </Button>
            </StackPanel>
        </Grid>

        <InfoBar x:Name="RootInfoBar"
                 Grid.Row="2"
                 IsOpen="False"
                 IsClosable="True" />

        <TextBlock x:Name="DepthText"
                   Grid.Row="3"
                   TextWrapping="Wrap"
                   FontSize="12"
                   Opacity="0.85"
                   Foreground="{StaticResource PensieveColorTextMuteBrush}" />

        <TextBlock Grid.Row="4"
                   Text="Project groups"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource PensieveColorTextBrightBrush}" />

        <ListView x:Name="ProjectList"
                  Grid.Row="5"
                  MinHeight="120"
                  SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Padding="0,8" Spacing="2">
                        <TextBlock Text="{Binding ProjectKey}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PensieveColorTextBrightBrush}" />
                        <TextBlock Text="{Binding Summary}"
                                   FontSize="12"
                                   Foreground="{StaticResource PensieveColorTextMuteBrush}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="6" Spacing="2" Margin="0,10,0,0">
            <TextBlock Text="Code symbols"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PensieveColorTextBrightBrush}" />
        </StackPanel>

        <ListView x:Name="CodeSymbolList"
                  Grid.Row="7"
                  MinHeight="140"
                  SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Padding="0,6" Spacing="2">
                        <TextBlock Text="{Binding Name}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PensieveColorTextBrightBrush}" />
                        <TextBlock FontSize="11"
                                   Foreground="{StaticResource PensieveColorTextMuteBrush}">
                            <Run Text="{Binding Kind}" />
                            <Run Text=" · line " />
                            <Run Text="{Binding Line}" />
                            <Run Text=" · " />
                            <Run Text="{Binding Parser}" />
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
