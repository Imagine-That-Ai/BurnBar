<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Live Home Assistant transport adapter (Phase 4 · integrations lane).

    This is the platform-facing half: it plugs a real System.Net.Http.HttpClient
    into the portable HomeAssistantClient's IHomeAssistantHttpTransport seam,
    mapping HttpClient timeouts/faults onto the portable HomeAssistantClientException
    exactly as the Swift URLSession client did. All request assembly, status/error
    mapping, and entity projection stay in the portable core.

    Target framework note: this targets plain net10.0 (net-generic), NOT
    net10.0-windows — System.Net.Http is cross-platform, so the SAME assembly the
    Windows app ships is also BUILT AND RUN on the macOS authoring host today
    (windows/tests/integrations exercises it against an in-process HttpListener).
    This mirrors the OpenBurnBar.Pal.Ipc.Windows scaffold's "compiles on the
    authoring host" property, but here the adapter genuinely runs off-Windows too.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>OpenBurnBar.Integrations.HomeAssistant.Net</RootNamespace>
    <AssemblyName>OpenBurnBar.Integrations.HomeAssistant.Net</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../OpenBurnBar.Integrations.HomeAssistant/OpenBurnBar.Integrations.HomeAssistant.csproj" />
  </ItemGroup>

</Project>
