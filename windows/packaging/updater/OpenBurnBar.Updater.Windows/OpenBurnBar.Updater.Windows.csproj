<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Windows-native updater HOST adapter (Phase 5 · W10 · R19). The platform half
    of the auto-updater: it drives the OS-native update UX (WinSparkle) behind
    the portable Core's IUpdaterHost seam, and re-verifies every downloaded
    artifact through the SAME pinned Ed25519 core verifier before install.

    WinSparkle is the direct Windows analog of macOS Sparkle: it fetches the
    appcast, shows the update prompt, downloads the enclosure, and (0.8.0+)
    verifies the `sparkle:edSignature` against a pinned EdDSA public key set via
    win_sparkle_set_eddsa_public_key. This adapter pins the SAME key the Core
    pins, so the feed key stays independent of the Authenticode certificate on
    both the native and managed verification paths (defense-in-depth). A Squirrel
    host would implement the same IUpdaterHost seam; WinSparkle is primary
    because it mirrors the shipped Sparkle behavior.

    macOS-authoring-host status: with EnableWindowsTargeting=true this project
    RESTORES the Windows ref packs and Roslyn-COMPILES CLEAN on macOS — the
    winsparkle.dll P/Invoke declarations are metadata that bind cross-platform.
    Every entry point is [SupportedOSPlatform("windows")]; it does not RUN
    off-Windows, and the live WinSparkle round-trip (with the bundled
    winsparkle.dll + the real signed MSIX) is a Windows dev-host task
    (VAL-W10-*). This mirrors the ComputerUse.Windows / CloudSync App Check
    adapters already landed on main.

    Target framework net8.0-windows (not a versioned Windows-10 TFM): the host
    needs only Win32 P/Invoke into winsparkle.dll, no WinRT projection, so the
    lighter TFM keeps the adapter buildable on the authoring host.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <RootNamespace>OpenBurnBar.Updater.Windows</RootNamespace>
    <AssemblyName>OpenBurnBar.Updater.Windows</AssemblyName>
    <!-- Restore + compile the Windows ref packs on the macOS/Linux authoring host. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../OpenBurnBar.Updater.Core/OpenBurnBar.Updater.Core.csproj" />
  </ItemGroup>

</Project>
