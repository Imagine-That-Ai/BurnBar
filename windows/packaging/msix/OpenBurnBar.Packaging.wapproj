<?xml version="1.0" encoding="utf-8"?>
<!--
  OpenBurnBar.Packaging — Windows Application Packaging Project (WAP).

  Wraps the UNPACKAGED WinUI 3 shell (windows/app/OpenBurnBar.App) into a signable
  MSIX WITHOUT changing the app project: the app keeps WindowsPackageType=None for the
  direct-download / winget / Chocolatey portable channel, and this WAP produces the
  MSIX channel from the SAME binaries by referencing the app as its entry point. Release
  CI stages the already-published app with New-MsixPackage.ps1 + MakeAppx instead, avoiding
  WAP global-property propagation into the unpackaged app build.

  BUILD CEILING (honest): the DesktopBridge props/targets, MakeAppx, MakePri, and the
  AppxManifest XSD gate are Windows-only — this project does NOT restore or build on
  macOS. It is authored to the canonical WAP schema and checked for XML well-formedness
  on macOS (xmllint). Actual pack + Authenticode/Artifact Signing signature run on the
  Windows dev host / CI with the Azure Artifact Signing profile (see windows/app/DEV_HOST_RUNBOOK.md).

  Self-contained reconciliation: OpenBurnBar.App sets WindowsAppSDKSelfContained=true
  (its unpackaged build carries the WinAppSDK runtime). Under MSIX the framework can be
  a package dependency instead; the dev-host runbook records the exact
  WindowsAppSDKSelfContained / WindowsPackageType reconciliation used at pack time.
-->
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x64'">
    <AppxBundle>Never</AppxBundle>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x64'">
    <AppxBundle>Never</AppxBundle>
  </PropertyGroup>

  <PropertyGroup>
    <WapProjPath Condition="'$(WapProjPath)'==''">$(MSBuildExtensionsPath)\Microsoft\DesktopBridge\</WapProjPath>
  </PropertyGroup>
  <Import Project="$(WapProjPath)\Microsoft.DesktopBridge.props" />

  <PropertyGroup>
    <ProjectGuid>32459C78-BA4B-41B4-A268-3835E9D3DF34</ProjectGuid>
    <TargetPlatformVersion>10.0.22621.0</TargetPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <DefaultLanguage>en-US</DefaultLanguage>
    <!-- x86 | x64 | arm64 — mirrors the app project's <Platforms>. -->
    <AppxBundlePlatforms>x86|x64|arm64</AppxBundlePlatforms>
    <!--
      The app project supplies the executable + assemblies packaged into the MSIX.
      EntryPointProjectUniqueName pins which referenced project's exe is the entry.
    -->
    <EntryPointProjectUniqueName>..\..\app\OpenBurnBar.App\OpenBurnBar.App.csproj</EntryPointProjectUniqueName>
    <!--
      Signing is deferred to the Windows CI/dev host with Azure Artifact Signing. Leave the
      thumbprint UNSET here so an unsigned dev pack works; CI passes
      the Artifact Signing account/profile to the release workflow after pack time.
    -->
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
    <AppxSymbolPackageEnabled>true</AppxSymbolPackageEnabled>
    <AppxAutoIncrementPackageRevision>false</AppxAutoIncrementPackageRevision>
  </PropertyGroup>

  <ItemGroup>
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>

  <ItemGroup>
    <!-- Tile / logo / store assets referenced by Package.appxmanifest. -->
    <Content Include="Images\**\*.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\app\OpenBurnBar.App\OpenBurnBar.App.csproj" />
  </ItemGroup>

  <Import Project="$(WapProjPath)\Microsoft.DesktopBridge.targets" />

</Project>
