{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Imagine-That-Ai/BurnBar/windows/packaging/portable/portable-layout.schema.json",
  "title": "OpenBurnBar portable-zip layout",
  "description": "Declarative layout consumed by New-PortableZip.ps1 to stage + zip the portable distribution.",
  "type": "object",
  "required": ["schemaVersion", "product", "packageId", "version", "entryPoint", "rootFolder", "artifactNameTemplate", "architectures", "include"],
  "additionalProperties": true,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "string" },
    "product": { "type": "string" },
    "packageId": { "type": "string" },
    "description": { "type": "string" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "note": { "type": "string" },
    "entryPoint": { "type": "string", "pattern": "\\.exe$" },
    "rootFolder": { "type": "string", "minLength": 1 },
    "artifactNameTemplate": { "type": "string", "pattern": "\\{version\\}" },
    "checksumSidecarTemplate": { "type": "string" },
    "architectures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["arch", "runtimeIdentifier"],
        "additionalProperties": false,
        "properties": {
          "arch": { "type": "string", "enum": ["x64", "arm64", "x86"] },
          "runtimeIdentifier": { "type": "string", "pattern": "^win-" }
        }
      }
    },
    "source": { "type": "object" },
    "include": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "exclude": { "type": "array", "items": { "type": "string" } },
    "generatedFiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "kind", "contents"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "kind": { "type": "string", "enum": ["marker", "readme", "text"] },
          "contents": { "type": "string" }
        }
      }
    },
    "extraFilesFromRepo": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "additionalProperties": false,
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "optional": { "type": "boolean" }
        }
      }
    },
    "checksum": {
      "type": "object",
      "required": ["algorithm"],
      "properties": {
        "algorithm": { "type": "string", "enum": ["SHA256"] },
        "sidecar": { "type": "boolean" },
        "manifestLine": { "type": "string" }
      }
    }
  }
}
