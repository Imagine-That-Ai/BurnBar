<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Live HttpClient transport for the portable App Check mint client
    (Phase 2 · CloudSync · App Check client lane).

    This is the network half of the mint call: a System.Net.Http implementation of
    IAppCheckMintTransport that POSTs the callable request the portable client
    assembled. It is cross-platform (no WinRT), so unlike the WinUI/TPM adapters it
    RUNS today on the macOS authoring host — the test project stands up a loopback
    HttpListener mint server and drives the whole claim → HTTP → token-install path
    through this real transport (mirrors the Home Assistant .Net transport + live
    HttpListener test already proven in windows/tests/integrations).

    Targets both net8.0 (the shipping WinUI app) and net10.0 (the portable test
    harness). Both consume the net8.0 portable core.
  -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>OpenBurnBar.CloudSync.AppCheck.Net</RootNamespace>
    <AssemblyName>OpenBurnBar.CloudSync.AppCheck.Net</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../OpenBurnBar.CloudSync.AppCheck/OpenBurnBar.CloudSync.AppCheck.csproj" />
  </ItemGroup>

</Project>
