[Unit]
Description=OpenBurnBar hardware attestation broker socket
Documentation=https://github.com/Imagine-That-Ai/BurnBar

[Socket]
ListenSequentialPacket=/run/openburnbar/attestd.sock
PassCredentials=yes
FileDescriptorName=attestation
Service=openburnbar-attestd.service
SocketUser=root
SocketGroup=root
# Any local desktop user may connect. The broker does not trust filesystem
# permissions: every complete request packet is bound to SCM_CREDENTIALS from
# its actual writer, then authorized through /proc/<pid>/exe and the signed
# installed-client manifest before evidence is collected.
SocketMode=0666
DirectoryMode=0755
RemoveOnStop=true
FlushPending=true
Backlog=64

[Install]
WantedBy=sockets.target
