[Desktop Entry]
Categories={{categories}}
{{#if comment}}
Comment={{comment}}
{{/if}}
# AppImage must keep a PATH-relative Exec. Absolute /usr/bin paths are resolved
# on the host under --appimage-extract-and-run and break portable launch.
Exec={{exec}}
StartupWMClass={{exec}}
Icon={{icon}}
Name={{name}}
Terminal=false
Type=Application
{{#if mime_type}}
MimeType={{mime_type}}
{{/if}}
