{
  "schemaVersion": 1,
  "product": "OpenBurnBar",
  "appId": "dev.openburnbar.OpenBurnBar",
  "linuxDesktopPackage": "apps/linux-desktop",
  "primaryArtifact": "appimage",
  "requiredArtifacts": ["appimage", "deb", "rpm", "daemon"],
  "packageBuilders": {
    "appimage": "tauri",
    "deb": "native-dpkg",
    "rpm": "native-rpmbuild"
  },
  "supportedArchitectures": ["aarch64", "x86_64"],
  "releaseTagPrefix": "linux-v",
  "signing": {
    "publicKey": "packaging/linux/openburnbar-linux-ed25519.pub.pem",
    "publicKeySpkiSha256": "0e0fd1f52af308d96c71571ef7e94f3e183218abf531760dfcc8ef8e499e5c37",
    "cosignIssuer": "https://token.actions.githubusercontent.com",
    "cosignIdentityTemplate": "https://github.com/Imagine-That-Ai/BurnBar/.github/workflows/linux-release.yml@refs/tags/linux-v{version}"
  },
  "distributionRepositories": {
    "config": "packaging/linux/distribution-channels.json",
    "outputDirectory": "repositories",
    "closure": "repositories/repository-closure.json",
    "closureSignature": "repositories/repository-closure.json.asc",
    "lifecycleReceipt": "repositories/repository-lifecycle.json",
    "channels": ["stable", "prerelease", "nightly"],
    "aptBuilder": "dpkg-scanpackages",
    "aptReleaseBuilder": "apt-ftparchive",
    "rpmPackageSigner": "rpmsign",
    "rpmBuilder": "createrepo_c",
    "aptValidForHours": 168,
    "signingKeyMinimumRemainingDays": 30,
    "artifactOrigin": "https://downloads.burnbar.ai/linux/releases/linux-v<version>",
    "activationModel": "metadata-last-fail-closed-pending-atomic-rpm-pointer",
    "lifecycleVerifier": "scripts/linux-port/verify-linux-repository-lifecycle.sh",
    "signingSecret": "OPENBURNBAR_LINUX_REPOSITORY_GPG_PRIVATE_KEY",
    "publicIdentitySource": "distribution-channels.signing",
    "promotionStatus": "blocked-until-production-key-public-mirror-and-lifecycle-proof"
  },
  "tailMetadata": {
    "aur": "packaging/linux/aur/PKGBUILD",
    "flatpak": "packaging/linux/flatpak/dev.openburnbar.OpenBurnBar.yml",
    "distributionChannels": "packaging/linux/distribution-channels.json",
    "aptSourcesTemplate": "packaging/linux/debian/openburnbar.sources.template",
    "rpmRepoTemplate": "packaging/linux/rpm/openburnbar.repo.template",
    "desktopEntry": "packaging/linux/openburnbar.desktop",
    "safeModeDesktopEntry": "packaging/linux/openburnbar-safe-mode.desktop",
    "autostartEntry": "packaging/linux/autostart/openburnbar.desktop",
    "systemdUserService": "packaging/linux/openburnbar-daemon.service",
    "daemonLaunchScript": "packaging/linux/openburnbar-daemon-launch.sh",
    "daemonEnvExample": "packaging/linux/daemon.env.example",
    "customXdgDropInExample": "packaging/linux/systemd/openburnbar-daemon.service.d/custom-xdg.conf.example",
    "attestationSystemService": "packaging/linux/openburnbar-attestd.service",
    "attestationSystemSocket": "packaging/linux/openburnbar-attestd.socket",
    "attestationManifestSchema": "packaging/linux/attestation/openburnbar-installed-manifest.schema.json",
    "attestationManifestTemplate": "packaging/linux/attestation/openburnbar-installed-manifest.template.json",
    "attestationDebianPostinst": "packaging/linux/debian/openburnbar-attestd.postinst",
    "attestationDebianPrerm": "packaging/linux/debian/openburnbar-attestd.prerm",
    "attestationDebianPostrm": "packaging/linux/debian/openburnbar-attestd.postrm",
    "attestationRpmPost": "packaging/linux/rpm/openburnbar-attestd.post",
    "attestationRpmPreun": "packaging/linux/rpm/openburnbar-attestd.preun",
    "attestationRpmPostun": "packaging/linux/rpm/openburnbar-attestd.postun",
    "attestationRpmPurgeHelper": "packaging/linux/openburnbar-attestd-purge-state",
    "attestationActivationReady": "packaging/linux/openburnbar-attestd-activation-ready",
    "restartActiveUserDaemons": "packaging/linux/openburnbar-restart-active-user-daemons"
  },
  "installPaths": {
    "daemonLaunch": "/usr/libexec/openburnbar-daemon-launch",
    "daemonBinary": "/usr/bin/openburnbar-daemon",
    "swiftRuntime": "/usr/lib/openburnbar/swift",
    "nativeRuntime": "/usr/lib/openburnbar/native",
    "systemdUserService": "/usr/lib/systemd/user/openburnbar-daemon.service",
    "desktopEntry": "/usr/share/applications/dev.openburnbar.OpenBurnBar.desktop",
    "attestationBroker": "/usr/libexec/openburnbar-attestd",
    "attestationActivationReady": "/usr/libexec/openburnbar-attestd-activation-ready",
    "restartActiveUserDaemons": "/usr/libexec/openburnbar-restart-active-user-daemons",
    "attestationSystemService": "/usr/lib/systemd/system/openburnbar-attestd.service",
    "attestationSystemSocket": "/usr/lib/systemd/system/openburnbar-attestd.socket",
    "attestationSocket": "/run/openburnbar/attestd.sock",
    "attestationState": "/var/lib/openburnbar-attestd",
    "attestationEkContext": "/var/lib/openburnbar-attestd/ek.ctx",
    "attestationEkPublic": "/var/lib/openburnbar-attestd/ek.pub",
    "attestationEkCertificate": "/var/lib/openburnbar-attestd/ek.cert",
    "attestationAkContext": "/var/lib/openburnbar-attestd/ak.ctx",
    "attestationInstalledManifest": "/usr/share/openburnbar/attestation/installed-manifest.json",
    "attestationInstalledManifestSignature": "/usr/share/openburnbar/attestation/installed-manifest.json.sig",
    "attestationReleasePublicKey": "/usr/share/openburnbar/attestation/release-ed25519.pub.pem"
  },
  "rootAttestationBroker": {
    "productionPackages": ["deb", "rpm"],
    "socketActivation": true,
    "defaultActivation": "disabled-until-enrolled-and-rollout-enabled",
    "socketMode": "0666",
    "akLifecycle": {
      "mode": "broker-cli-initialize-ak",
      "createak": "/usr/bin/tpm2_createak",
      "ekContext": "/var/lib/openburnbar-attestd/ek.ctx",
      "ekPublic": "/var/lib/openburnbar-attestd/ek.pub",
      "ekCertificate": "/var/lib/openburnbar-attestd/ek.cert",
      "rotation": "refuse-existing-unless-explicit-rotate"
    },
    "quoteCollector": "/usr/bin/tpm2_quote",
    "akContext": "/var/lib/openburnbar-attestd/ak.ctx",
    "peerAuthorization": [
      "SCM_CREDENTIALS pid and uid attached to the complete SOCK_SEQPACKET request",
      "open /proc/<pid>/exe identity without path re-resolution",
      "root-owned mode-0755 executable",
      "SHA-256 match in the release-signed installed manifest"
    ],
    "networkAccess": "denied",
    "normalRemovalPreservesState": true,
    "unsupportedPackages": {
      "appimage": "Cannot install the privileged broker, system socket, signed installed-file manifest, or lifecycle hooks.",
      "flatpak": "The sandbox cannot install or authenticate a host root broker.",
      "aur": "The current AUR package is AppImage-backed and has no reviewed privileged broker lifecycle."
    }
  },
  "credentialStorage": {
    "requiredCommand": "secret-tool",
    "primaryBackend": "org.freedesktop.secrets",
    "optionalBackend": "kwallet-query",
    "debian": {
      "depends": ["libsecret-tools", "tpm2-tools"],
      "recommends": ["gnome-keyring", "libkf5wallet-bin", "libkf6wallet-bin"]
    },
    "rpm": {
      "depends": ["libsecret", "tpm2-tools"]
    },
    "arch": {
      "depends": ["libsecret", "tpm2-tools"],
      "optdepends": ["kwallet"]
    },
    "flatpak": {
      "status": "unpromoted",
      "requiredBusName": "org.freedesktop.secrets",
      "blocker": "Sandboxed secret-tool and locked/unlocked keyring lifecycle are not yet proven on a real Flatpak runner."
    }
  },
  "updateMetadata": {
    "draftName": "latest-linux.draft.json",
    "publishedName": "latest-linux.json",
    "publicUrl": "https://downloads.burnbar.ai/latest-linux.json",
    "publishOnlyAfter": [
      "every required package exists for aarch64 and x86_64",
      "install-launch-uninstall smoke passes",
      "checksums verify",
      "Ed25519/minisign-compatible signatures verify",
      "Sigstore/cosign provenance bundle verifies",
      "SPDX SBOM and VEX exist",
      "source archive hash matches release metadata",
      "production repository OpenPGP primary and signing-subkey fingerprints are pinned",
      "signed repository closure and lifecycle receipt verify",
      "public apt and RPM bytes match the repository closure",
      "public apt and dnf install-update-rollback-uninstall lifecycle passes on both architectures",
      "interrupted repository publication preserves the previous snapshot through one-switch activation",
      "apt metadata refresh completes before signed expiry",
      "parity ledger has no blocked Tier A/B rows",
      "release commit is clean and matches source archive"
    ]
  },
  "externalCredentials": {
    "ed25519PrivateKeyEnv": "OPENBURNBAR_LINUX_ED25519_PRIVATE_KEY_PEM",
    "repositoryGpgPrivateKeyEnv": "OPENBURNBAR_LINUX_REPOSITORY_GPG_PRIVATE_KEY",
    "cosignOidc": "GitHub Actions id-token: write",
    "packageRegistryTokens": {
      "aur": "operator SSH/Git push credentials",
      "flatpak": "future Flathub publisher credentials"
    }
  },
  "supportedSmokeTargets": [
    "ubuntu-noble-x11-xvfb",
    "ubuntu-noble-wayland-blocked-until-portal-runner",
    "fedora-kde-wayland-blocked-until-runner",
    "arch-wlroots-blocked-until-runner"
  ]
}
