{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openburnbar.dev/schemas/linux-installed-manifest-v1.json",
  "title": "OpenBurnBar Linux installed release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "product",
    "appId",
    "firebaseAppId",
    "packageVersion",
    "gitCommit",
    "packageArchitecture",
    "packageFormat",
    "packageName",
    "policyId",
    "brokerProtocolVersion",
    "installedFilesRootSha256",
    "authorizedClients",
    "files"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "product": { "const": "OpenBurnBar" },
    "appId": { "const": "dev.openburnbar.OpenBurnBar" },
    "firebaseAppId": {
      "type": "string",
      "maxLength": 160,
      "pattern": "^1:[0-9]+:web:[A-Za-z0-9_-]+$"
    },
    "packageVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "gitCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "packageArchitecture": { "type": "string", "enum": ["aarch64", "x86_64"] },
    "packageFormat": { "type": "string", "enum": ["deb", "rpm"] },
    "packageName": { "const": "open-burn-bar" },
    "policyId": { "const": "openburnbar-linux-signed-package-inventory-v1" },
    "brokerProtocolVersion": { "const": 2 },
    "installedFilesRootSha256": { "$ref": "#/$defs/sha256" },
    "authorizedClients": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/authorizedClient" }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/regularFile" },
          { "$ref": "#/$defs/symlink" }
        ]
      }
    }
  },
  "$defs": {
    "absolutePath": {
      "type": "string",
      "pattern": "^/usr/[^\\u0000]+$",
      "maxLength": 4096
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "mode": { "type": "string", "pattern": "^[0-7]{4}$" },
    "authorizedClient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "sha256", "ownerUid", "ownerGid", "mode"],
      "properties": {
        "role": { "const": "daemon" },
        "path": { "const": "/usr/bin/openburnbar-daemon" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "ownerUid": { "const": 0 },
        "ownerGid": { "const": 0 },
        "mode": { "const": 493 }
      }
    },
    "regularFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "type", "sha256", "size", "mode", "uid", "gid"],
      "properties": {
        "path": { "$ref": "#/$defs/absolutePath" },
        "type": { "const": "file" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 0, "maximum": 2147483648 },
        "mode": { "$ref": "#/$defs/mode" },
        "uid": { "const": 0 },
        "gid": { "const": 0 }
      }
    },
    "symlink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "type", "target", "mode", "uid", "gid"],
      "properties": {
        "path": { "$ref": "#/$defs/absolutePath" },
        "type": { "const": "symlink" },
        "target": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "mode": { "$ref": "#/$defs/mode" },
        "uid": { "const": 0 },
        "gid": { "const": 0 }
      }
    }
  }
}
