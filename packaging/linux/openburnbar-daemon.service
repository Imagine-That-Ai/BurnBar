[Unit]
Description=OpenBurnBar local daemon
Documentation=https://github.com/Imagine-That-Ai/BurnBar
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/openburnbar-daemon --socket %t/openburnbar/daemon.sock --state-dir %h/.local/state/openburnbar
Restart=on-failure
RestartSec=5
RuntimeDirectory=openburnbar
StateDirectory=openburnbar
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/openburnbar %h/.cache/openburnbar %t/openburnbar

[Install]
WantedBy=default.target
