# Optional operator overrides for the user systemd unit.
# Install as: ~/.config/openburnbar/daemon.env  (mode 0600)
#
# Allowed:
#   OPENBURNBAR_DAEMON_SUPPORT_DIR=/path/to/support
#   OPENBURNBAR_SOCKET_PATH=/run/user/$UID/openburnbar/daemon.sock
#   OPENBURNBAR_DAEMON_SOCKET_PATH=...
#
# FORBIDDEN (launch script ignores or refuses):
#   OPENBURNBAR_DAEMON_LINUX_PEER_ROOTS  — always forced to the unit allowlist;
#     daemon.env cannot set PEER_ROOTS=/ or $HOME (or any other value)
#   OPENBURNBAR_DAEMON_SOCKET_AUTH_TOKEN — never put raw tokens in env files
