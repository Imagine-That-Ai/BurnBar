<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Reusable C# binding for the `openburnbar-iroh` cdylib, generated by
    uniffi-bindgen-cs (Windows port, native shim — consumed by
    windows/native/OpenBurnBar.Native.Iroh). The single source under generated/
    is produced by ../regenerate.sh from the compiled cdylib — do not hand-edit
    it. See ../README.md and docs/windows-port/decisions/0001-csharp-binding-path.md.

    Targets net8.0 — the portable-core TFM the windows/ tree standardizes on —
    so windows/native (net8.0) can reference it; the crate-side and windows-side
    test projects (net10.0) reference it downward without regenerating.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Generated interop code carries intentional style/nullability slack. -->
    <NoWarn>$(NoWarn);CS0169;CS0649;CS1591;CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625</NoWarn>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <RootNamespace>OpenBurnBarIroh.Ffi</RootNamespace>
  </PropertyGroup>

  <!-- The SDK's default glob compiles generated/openburnbar_iroh.cs; it is the
       only source in this project, so no explicit <Compile> items are needed. -->

</Project>
