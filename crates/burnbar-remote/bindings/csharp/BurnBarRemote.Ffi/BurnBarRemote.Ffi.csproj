<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Reusable C# binding for the `burnbar-remote-ffi` cdylib, generated by
    uniffi-bindgen-cs (Windows port, FFI-007 / VAL-P0-FFI-007). The single
    source under generated/ is produced by ../regenerate.sh from the compiled
    cdylib — do not hand-edit it. See ../README.md and
    docs/windows-port/decisions/0001-csharp-binding-path.md.

    Targets net10.0 to match the toolchain proving the macOS round-trip today;
    the shipping WinUI consumer (Phase 1+) may retarget to a Windows TFM without
    regenerating.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Generated interop code carries intentional style/nullability slack. -->
    <NoWarn>$(NoWarn);CS0169;CS0649;CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625</NoWarn>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <RootNamespace>BurnBarRemote.Ffi</RootNamespace>
  </PropertyGroup>

  <!-- The SDK's default glob compiles generated/burnbar_remote.cs; it is the
       only source in this project, so no explicit <Compile> items are needed. -->

</Project>
