<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- reason: generated UniFFI interop intentionally carries unused ABI fields and nullable wire conversions. -->
    <NoWarn>$(NoWarn);CS0169;CS0649;CS1591;CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625</NoWarn>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <RootNamespace>OpenBurnBarDomainCore.Ffi</RootNamespace>
  </PropertyGroup>
</Project>
