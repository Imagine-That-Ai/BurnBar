          "status",
          "profileName",
          "advertisedModel",
          "hostInstallationId",
          "replacedByConnectionId",
          "relayPublicKey",
          "relayKeyVersion",
          "relayEncryption",
          "realtimeRelayURL",
          "realtimeRelayStatus",
          "realtimeRelayLastSeenAt",
          "realtimeRelayProtocolVersion",
