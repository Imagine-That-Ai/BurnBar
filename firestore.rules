        allow read: if ownsUserNamespace(userId);
        allow create: if ownsUserNamespace(userId)
          && signalDirectoryDocumentLimits()
          && validKyberPreKeyDocument()
          && request.resource.data.status == "available";
        allow update: if ownsUserNamespace(userId)
          && signalDirectoryDocumentLimits()
          && validKyberPreKeyDocument()
          && kyberPreKeyImmutableFieldsUnchanged()
          && resource.data.status == "available"
          && request.resource.data.status in ["claimed", "exhausted", "retired"];
        allow delete: if false;
      }

      match /sessions/{sessionId} {
        function validSignalSessionDirectoryDocument() {
          return request.resource.data.keys().hasOnly([
            "sessionId",
            "identityKeyId",
            "deviceId",
            "keyVersion",
            "peerUid",
            "peerDeviceId",
            "peerIdentityKeyId",
            "mode",
            "stateStorage",
            "status",
            "createdAt",
            "updatedAt",
            "lastMessageAt",
            "archivedAt"
          ])
          && validSignalDirectoryBase()
          && request.resource.data.sessionId == sessionId
          && request.resource.data.peerUid is string
          && request.resource.data.peerUid.size() <= 160
          && request.resource.data.peerDeviceId is string
          && request.resource.data.peerDeviceId.size() <= 160
          && request.resource.data.peerIdentityKeyId is string
          && request.resource.data.peerIdentityKeyId.size() <= 200
          && request.resource.data.mode in ["same-user-device", "gateway-transport"]
          && request.resource.data.stateStorage == "device-local-only"
          && request.resource.data.status in ["active", "archived", "revoked"]
          && (!("lastMessageAt" in request.resource.data) || request.resource.data.lastMessageAt is timestamp)
          && (!("archivedAt" in request.resource.data) || request.resource.data.archivedAt is timestamp);
        }

        function signalSessionImmutableFieldsUnchanged() {
          return request.resource.data.sessionId == resource.data.sessionId
            && request.resource.data.identityKeyId == resource.data.identityKeyId
            && request.resource.data.deviceId == resource.data.deviceId
            && request.resource.data.keyVersion == resource.data.keyVersion
            && request.resource.data.peerUid == resource.data.peerUid
            && request.resource.data.peerDeviceId == resource.data.peerDeviceId
            && request.resource.data.peerIdentityKeyId == resource.data.peerIdentityKeyId
            && request.resource.data.mode == resource.data.mode
            && request.resource.data.stateStorage == resource.data.stateStorage
            && request.resource.data.createdAt == resource.data.createdAt;
        }

        allow read: if ownsUserNamespace(userId);
        allow create: if ownsUserNamespace(userId)
          && signalDirectoryDocumentLimits()
          && validSignalSessionDirectoryDocument()
          && request.resource.data.status == "active";
        allow update: if ownsUserNamespace(userId)
          && signalDirectoryDocumentLimits()
          && validSignalSessionDirectoryDocument()
          && signalSessionImmutableFieldsUnchanged()
          && (
            request.resource.data.status == resource.data.status
            || (resource.data.status == "active" && request.resource.data.status in ["archived", "revoked"])
