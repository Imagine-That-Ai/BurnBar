          "algorithm",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.deviceId is string
        && request.resource.data.deviceId.size() <= 160
        && request.resource.data.keyVersion is int
        && request.resource.data.keyVersion >= 1
        && request.resource.data.keyVersion <= 1000
        && request.resource.data.publicKeyData is string
        && request.resource.data.publicKeyData.matches("^[A-Za-z0-9+/=]{80,128}$")
        && (!("publicKeyFingerprint" in request.resource.data)
          || (request.resource.data.publicKeyFingerprint is string
            && request.resource.data.publicKeyFingerprint.size() <= 128))
        && (!("fingerprint" in request.resource.data)
          || (request.resource.data.fingerprint is string
            && request.resource.data.fingerprint.size() <= 128))
        && request.resource.data.algorithm == "ECIES-P256-AESGCM"
        && (!("platform" in request.resource.data) || (request.resource.data.platform is string && request.resource.data.platform.size() <= 80))
        && (!("publicKeyJwk" in request.resource.data)
          || (request.resource.data.publicKeyJwk is map
            && request.resource.data.publicKeyJwk.keys().hasOnly(["kty", "crv", "x", "y", "ext", "key_ops"])
            && request.resource.data.publicKeyJwk.kty == "EC"
            && request.resource.data.publicKeyJwk.crv == "P-256"
            && request.resource.data.publicKeyJwk.x is string
            && request.resource.data.publicKeyJwk.x.size() <= 80
            && request.resource.data.publicKeyJwk.y is string
            && request.resource.data.publicKeyJwk.y.size() <= 80));
      }

      allow create: if ownsUserNamespace(userId)
        && escrowDocumentLimits()
        && hasNoPlaintextSecretFields()
        && validEscrowPublicKeyDocument()
        && publicKeyMatchesPendingEscrowDevice();
    }

    match /users/{userId}/signal_identity_public_keys/{keyId} {
      function signalIdentityDevicePath() {
        return /databases/$(database)/documents/users/$(userId)/escrow_devices/$(request.resource.data.deviceId);
      }

      function signalKeyVersionLabelMatchesNumber(label, version) {
        return (label == "1" && version == 1)
          || (label == "2" && version == 2)
          || (label == "3" && version == 3)
          || (label == "4" && version == 4)
          || (label == "5" && version == 5)
          || (label == "6" && version == 6)
          || (label == "7" && version == 7)
          || (label == "8" && version == 8)
          || (label == "9" && version == 9)
          || (label == "10" && version == 10);
      }

      function signalIdentityKeyIdMatchesVersion() {
        return (
          request.resource.data.keyVersion == 1
          && (!("keyVersionLabel" in request.resource.data) || request.resource.data.keyVersionLabel == "1")
          && request.resource.data.identityKeyId == request.resource.data.deviceId + "_1"
        ) || (
          request.resource.data.keyVersion >= 2
          && request.resource.data.keyVersion <= 10
          && request.resource.data.keyVersionLabel is string
          && signalKeyVersionLabelMatchesNumber(request.resource.data.keyVersionLabel, request.resource.data.keyVersion)
          && request.resource.data.identityKeyId == request.resource.data.deviceId + "_" + request.resource.data.keyVersionLabel
        );
      }

      function validSignalIdentityPublicKeyDocument() {
        return request.resource.data.keys().hasOnly([
          "deviceId",
          "platform",
          "identityKeyId",
          "publicKeyFingerprint",
          "publicKeyData",
          "keyVersion",
          "keyVersionLabel",
          "algorithm",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.deviceId is string
        && request.resource.data.deviceId.size() <= 160
        && request.resource.data.keyVersion is int
        && request.resource.data.keyVersion >= 1
        && request.resource.data.keyVersion <= 10
        && request.resource.data.identityKeyId is string
        // Firestore rules cannot stringify an int. Rotation uses an explicit
        // string `keyVersionLabel` and a bounded label->int map above, so a
        // rotated identity keeps the doc-id/device/key-version binding without
        // lossy prefix matching.
        && signalIdentityKeyIdMatchesVersion()
        && keyId == request.resource.data.identityKeyId
        && request.resource.data.publicKeyData is string
        && request.resource.data.publicKeyData.matches("^[A-Za-z0-9+/=]{40,96}$")
        && request.resource.data.publicKeyFingerprint is string
        && request.resource.data.publicKeyFingerprint.size() <= 128
        && request.resource.data.algorithm == "signal-hpke-identity-seal-v1"
        && (!("platform" in request.resource.data)
          || (request.resource.data.platform is string && request.resource.data.platform.size() <= 80));
      }

      function signalIdentityMatchesPendingDevice() {
        // Client-direct identity publication is only bootstrap for a pending
        // device. After trust approval, the server-written escrow device pins
        // the Signal identity metadata; Firestore rules cannot hash
        // `publicKeyData`, so they must not accept a later self-asserted
        // fingerprint/public-key pair for an already-trusted device.
        return exists(signalIdentityDevicePath())
          && get(signalIdentityDevicePath()).data.trustState == "pending"
          && ("keyVersion" in get(signalIdentityDevicePath()).data)
          && request.resource.data.keyVersion == get(signalIdentityDevicePath()).data.keyVersion;
      }

      allow create: if ownsUserNamespace(userId)
        && escrowDocumentLimits()
        && hasNoPlaintextSecretFields()
        && validSignalIdentityPublicKeyDocument()
        && signalIdentityMatchesPendingDevice();

      match /signed_prekeys/{signedPreKeyId} {
        // Server-only: publishSignalPrekeyBundle is the sole write path.
        allow read: if ownsUserNamespace(userId);
      }

      match /one_time_prekeys/{oneTimePreKeyId} {
        // Server-only: publishSignalPrekeyBundle / claimSignalPrekeyBundle own writes.
        allow read: if ownsUserNamespace(userId);
      }

      match /kyber_prekeys/{kyberPreKeyId} {
        // Server-only: publishSignalPrekeyBundle / claimSignalPrekeyBundle own writes.
        allow read: if ownsUserNamespace(userId);
      }

      match /sessions/{sessionId} {
        // Server-only: recordSignalSession is the sole write path.
        allow read: if ownsUserNamespace(userId);
      }

      match /rotation_events/{rotationId} {
        // Server-only: recordSignalRotation is the sole write path.
        allow read: if ownsUserNamespace(userId);
      }
    }

    match /users/{userId}/escrow_grants/{grantId} {
      // F-RR07-006: allowlist the exact fields the Mac writer emits on create
      // and the server revoke callable sets on update, so no extra keys can
      // ride in on either path.
      function escrowGrantDeviceTrusted(deviceId) {
        return exists(/databases/$(database)/documents/users/$(userId)/escrow_devices/$(deviceId))
          && get(/databases/$(database)/documents/users/$(userId)/escrow_devices/$(deviceId)).data.trustState == "trusted";
      }
      function escrowGrantReadAllowed() {
        return resource.data.status != "granted"
          || (
            resource.data.sourceDeviceId is string
            && resource.data.targetDeviceId is string
            && escrowGrantDeviceTrusted(resource.data.sourceDeviceId)
            && escrowGrantDeviceTrusted(resource.data.targetDeviceId)
          );
      }
      function validEscrowGrantCreate() {
        return request.resource.data.keys().hasOnly([
          "sourceDeviceId",
          "targetDeviceId",
          "providerId",
          "credentialKind",
          "status",
          "grantedAt"
        ])
        && request.resource.data.sourceDeviceId is string
        && request.resource.data.sourceDeviceId.size() > 0
        && request.resource.data.sourceDeviceId.size() <= 160
        && request.resource.data.targetDeviceId is string
        && request.resource.data.targetDeviceId.size() > 0
        && request.resource.data.targetDeviceId.size() <= 160
        && request.resource.data.providerId is string
        && request.resource.data.providerId.size() > 0
        && request.resource.data.providerId.size() <= 80
        && request.resource.data.credentialKind in [
          "api_key", "oauth_token", "bearer_token", "unknown"
        ]
        && request.resource.data.status == "granted"
        && request.resource.data.grantedAt is timestamp
        && escrowGrantDeviceTrusted(request.resource.data.sourceDeviceId)
        && escrowGrantDeviceTrusted(request.resource.data.targetDeviceId);
      }
      // Revoke is a server-side merge patch that touches only status + revokedAt.
      // The affectedKeys() check confines what the client can change on update;
      // once status is revoked, no further updates are allowed.
      function validEscrowGrantUpdate() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "revokedAt"
        ])
        && resource.data.status == "granted"
        && request.resource.data.status == "revoked"
        && (!("revokedAt" in request.resource.data) || request.resource.data.revokedAt is timestamp);
      }
      allow read: if ownsUserNamespace(userId)
        && escrowGrantReadAllowed();
      allow create: if ownsUserNamespace(userId)
        && escrowDocumentLimits()
        && hasNoPlaintextSecretFields()
        && validEscrowGrantCreate();
      allow update: if ownsUserNamespace(userId)
        && escrowDocumentLimits()
        && hasNoPlaintextSecretFields()
        && validEscrowGrantUpdate();
    }

    match /users/{userId}/escrow_envelopes/{envelopeId} {
      function validEscrowEnvelopeDocument() {
        return request.resource.data.keys().hasOnly([
          "id",
          "grantId",
          "sourceDeviceId",
          "targetDeviceId",
          "providerId",
          "credentialKind",
          "accountLabel",
          "ciphertext",
          "keyVersion",
          "envelopeVersion",
          "metadataBinding",
          "createdAt"
        ])
        && request.resource.data.id is string
        && request.resource.data.id == envelopeId
        && request.resource.data.grantId is string
        && request.resource.data.grantId.size() <= 160
        && request.resource.data.sourceDeviceId is string
        && request.resource.data.sourceDeviceId.size() <= 160
        && request.resource.data.targetDeviceId is string
        && request.resource.data.targetDeviceId.size() <= 160
        && request.resource.data.providerId is string
        && request.resource.data.providerId.size() <= 80
        && request.resource.data.credentialKind in ["api_key", "oauth_token", "bearer_token", "unknown"]
        && (!("accountLabel" in request.resource.data) || (request.resource.data.accountLabel is string && request.resource.data.accountLabel.size() <= 160))
        && request.resource.data.ciphertext is string
        && request.resource.data.ciphertext.size() >= 16
        && request.resource.data.ciphertext.size() <= 20000
        && request.resource.data.ciphertext.matches("^[A-Za-z0-9+/=_-]*$")
        && request.resource.data.keyVersion is int
        && request.resource.data.envelopeVersion is int
        && (!("metadataBinding" in request.resource.data) || request.resource.data.metadataBinding == "escrow-credential-aad-v1")
        && (request.resource.data.envelopeVersion < 2 || request.resource.data.metadataBinding == "escrow-credential-aad-v1")
        && request.resource.data.createdAt is timestamp;
      }

      allow create, update: if ownsUserNamespace(userId)
        && escrowDocumentLimits()
        && hasNoPlaintextSecretFields()
        && validEscrowEnvelopeDocument();
      // Sealed credential envelopes are non-deletable from the client; retirement
      // flows through a server-only path so the escrow history stays intact.
    }

    match /users/{userId}/escrow_audit_events/{eventId} {
      // Tamper-evidence log: append-only for the owner. Once written, an audit
      // event cannot be mutated or erased from the client — only server-side
      // (Admin SDK) reconciliation may touch history. Mirrors the stricter
      // computer_use_actions header above.
      allow create: if ownsUserNamespace(userId)
        && escrowDocumentLimits()
        && hasNoPlaintextSecretFields();
    }






    // --- Shared artifacts (E2EE-sealed; see sharedArtifactSealedOwnerWrite) ---

    match /workspaces/{workspaceId}/teams/{teamId}/artifacts/{artifactId} {
      allow read: if sharedArtifactOwnerRead(workspaceId);
      allow create, update: if sharedArtifactSealedOwnerWrite(workspaceId, teamId, artifactId);
      allow delete: if sharedArtifactOwnerRead(workspaceId);

      match /versions/{revisionId} {
        allow read: if sharedArtifactOwnerRead(workspaceId);
        allow create, update: if sharedArtifactVersionSealedOwnerWrite(workspaceId, teamId, artifactId, revisionId);
        allow delete: if sharedArtifactOwnerRead(workspaceId);
      }
    }

    // --- Mercury budget split (ADR 006) ---
    // Public envelope: level + caps only (no USD). Operator metrics and
    // events hold projections and audit rows. Rollups stay operator-only.
    match /ops/media_budget_status/state/current {
      allow read: if isSignedIn();
    }
    match /ops/media_budget_status/metrics/current {
      allow read: if isOperator();
    }
    match /ops/media_budget_status/events/{eventId} {
      allow read: if isOperator();
    }

    match /ops/media_session_daily_rollups/{document=**} {
      allow read: if isOperator();
    }

    // --- Global Google Play token claims (server-only) ---

    // --- Account erasure retention records (server-only) ---

    // --- High-risk action nonces (server-only, single-use replay defense) ---

    // --- Public HTTP / approval rate limits (server-only) ---

    // --- CLI Link Sessions (Deny All - Server Only) ---

    // --- Hermes Gateway root indexes (Deny All - Server Only) ---

    // Hermes gateway token indexes and shared-Rust shadow evidence remain
    // callable/Admin SDK only. Firestore's default deny applies because neither
    // root collection has a client match block.
  }
}
