          "id",
          "connectionId",
          "operation",
          "status",
          "method",
          "payloadCiphertext",
          "wrappedKey",
          "relayEncryption",
          "relayKeyVersion",
          "senderPublicKey",
          "senderDeviceId",
          "senderPeerNodeId",
          "senderCounter",
          "chunkCount",
          "createdAt",
          "updatedAt",
          "expiresAt",
          "expireAt",
          "claimedAt",
          "claimedBy",
          "completedAt",
