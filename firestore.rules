            && request.resource.data.deviceId == resource.data.deviceId
            && request.resource.data.signerIdentifier == resource.data.signerIdentifier
            && request.resource.data.signerKind == resource.data.signerKind
            && request.resource.data.trustRoot == resource.data.trustRoot
            && request.resource.data.algorithm == resource.data.algorithm
            && request.resource.data.publicKeyBase64 == resource.data.publicKeyBase64
            && request.resource.data.publicKeySHA256Hex == resource.data.publicKeySHA256Hex
