        && (!("hostInstallationId" in request.resource.data) || (request.resource.data.hostInstallationId is string && request.resource.data.hostInstallationId.size() <= 256))
        && (!("replacedByConnectionId" in request.resource.data) || (request.resource.data.replacedByConnectionId is string && request.resource.data.replacedByConnectionId.size() <= 256))
        && (!("relayKeyVersion" in request.resource.data) || request.resource.data.relayKeyVersion == 3)
