        && (!("targetSignalIdentityPublicKeyFingerprint" in d)
          || (d.targetSignalIdentityPublicKeyFingerprint is string
            && d.targetSignalIdentityPublicKeyFingerprint.size() <= 128))
        && (!("approvedBySignalIdentityKeyId" in d)
          || (d.approvedBySignalIdentityKeyId is string && d.approvedBySignalIdentityKeyId.size() <= 200))
        && (!("approvedBySignalIdentityPublicKeyFingerprint" in d)
          || (d.approvedBySignalIdentityPublicKeyFingerprint is string
            && d.approvedBySignalIdentityPublicKeyFingerprint.size() <= 128))
        && (!("signalIdentityRepairVersion" in d)
          || d.signalIdentityRepairVersion == 1)
        && (!("signalIdentityRepairAlgorithm" in d)
          || d.signalIdentityRepairAlgorithm == "escrow-possession-challenge-v1")
        && (!("signalIdentityReapprovalRequired" in d)
          || d.signalIdentityReapprovalRequired is bool)
        && (!("signalIdentityRepairedAt" in d)
          || d.signalIdentityRepairedAt is timestamp)
        && (!("approvedAt" in d) || d.approvedAt is timestamp)
        && (!("createdAt" in d) || d.createdAt is timestamp)
