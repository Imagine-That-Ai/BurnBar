        && d.deviceName is string
        && d.deviceName.size() <= 256
        && d.platform is string
        && d.platform.size() <= 80
        && d.trustState in ["pending", "trusted", "revoked"]
        && (!("appVersion" in d) || (d.appVersion is string && d.appVersion.size() <= 80))
        && (!("publicKeyFingerprint" in d) || (d.publicKeyFingerprint is string && d.publicKeyFingerprint.size() <= 256))
        && (!("keyVersion" in d) || d.keyVersion is int)
        && (!("approvedByDeviceId" in d) || (d.approvedByDeviceId is string && d.approvedByDeviceId.size() <= 160))
        && (!("trustChainVersion" in d) || d.trustChainVersion == 1)
        && (!("trustChainAlgorithm" in d) || d.trustChainAlgorithm == "signal-identity-xeddsa-v1")
        && (!("trustChainSignature" in d)
          || (d.trustChainSignature is string
            && d.trustChainSignature.size() >= 64
            && d.trustChainSignature.size() <= 256
            && d.trustChainSignature.matches("^[A-Za-z0-9+/=]+$")))
        && (!("targetSignalIdentityKeyId" in d)
