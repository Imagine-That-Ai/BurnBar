      allow delete: if ownsUserNamespace(userId);
    }

    match /users/{userId}/sync_status/{deviceId} {
      allow read: if ownsUserNamespace(userId);
      allow create, update: if ownsUserNamespace(userId)
        && escrowDocumentLimits()
        && hasNoPlaintextSecretFields();
      allow delete: if ownsUserNamespace(userId);
    }

    match /users/{userId}/cloud_settings/{settingsId} {
      allow read: if ownsUserNamespace(userId);
      allow create, update: if ownsUserNamespace(userId)
        && escrowDocumentLimits()
        && hasNoPlaintextSecretFields();
      allow delete: if ownsUserNamespace(userId);
    }

    match /users/{userId}/recent_usage/{summaryId} {
      allow read: if ownsUserNamespace(userId);
      allow create, update: if ownsUserNamespace(userId)
        && escrowDocumentLimits()
        && hasNoPlaintextSecretFields();
      allow delete: if ownsUserNamespace(userId);
    }

    // --- Shared artifacts (unchanged) ---

    match /workspaces/{workspaceId}/teams/{teamId}/artifacts/{artifactId} {
      allow read: if sharedArtifactOwnerRead(workspaceId);
      allow create, update: if sharedArtifactOwnerWrite(workspaceId, teamId);
      allow delete: if sharedArtifactOwnerRead(workspaceId);

      match /versions/{revisionId} {
        allow read: if sharedArtifactOwnerRead(workspaceId);
        allow create, update: if sharedArtifactOwnerWrite(workspaceId, teamId);
        allow delete: if sharedArtifactOwnerRead(workspaceId);
      }
    }

    // --- Mercury budget split (ADR 006) ---
    // Public envelope: level + caps only (no USD). Operator metrics and
    // events hold projections and audit rows. Rollups stay operator-only.
    match /ops/media_budget_status/state/current {
      allow read: if isSignedIn();
      allow write: if false;
    }
    match /ops/media_budget_status/metrics/current {
      allow read: if isOperator();
      allow write: if false;
    }
    match /ops/media_budget_status/events/{eventId} {
      allow read: if isOperator();
      allow write: if false;
    }

    match /ops/media_session_daily_rollups/{document=**} {
      allow read: if isOperator();
      allow write: if false;
    }

    // --- Global Google Play token claims (server-only) ---
    match /google_play_token_claims/{tokenHash} {
      allow read, write: if false;
    }

    // --- High-risk action nonces (server-only, single-use replay defense) ---
    match /users/{userId}/high_risk_action_nonces/{nonceId} {
      allow read, write: if false;
    }

    // --- Public HTTP / approval rate limits (server-only) ---
    match /public_rate_limits/{limitId} {
      allow read, write: if false;
    }

    // --- CLI Link Sessions (Deny All - Server Only) ---
    match /cli_link_sessions/{sessionId} {
      allow read, write: if false;
    }

    // --- Hermes Gateway root indexes (Deny All - Server Only) ---
    match /hermes_gateway_device_sessions/{sessionId} {
      allow read, write: if false;
    }

    match /hermes_gateway_token_index/{tokenHash} {
      allow read, write: if false;
    }
  }
}
