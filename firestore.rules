          && request.resource.data.publicKeyBase64.size() <= 128
          && request.resource.data.publicKeySHA256Hex is string
          && request.resource.data.publicKeySHA256Hex == signerId
          && request.resource.data.publicKeySHA256Hex.matches("^[0-9a-f]{64}$")
