              && request.resource.data.approvedBySignalIdentityPublicKeyFingerprint == resource.data.approvedBySignalIdentityPublicKeyFingerprint)
            || (!("approvedBySignalIdentityPublicKeyFingerprint" in resource.data)
              && !("approvedBySignalIdentityPublicKeyFingerprint" in request.resource.data)))
          && ((("approvedAt" in resource.data)
