        "workspaceID",
        "teamID",
        "ownerUserID",
        "visibility",
        "revisionID",
        "baseRevisionID",
        "isDeleted",
        "updatedByUserID",
        "updatedByDeviceID",
        "resolvedConflictRevisionID",
        "updatedAt",
        "contentSealed",
        "sealedSchemaVersion",
        "vaultKeyID",
        "sealedPayload"
