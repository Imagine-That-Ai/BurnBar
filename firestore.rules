          "uid",
          "schemaVersion",
          "payloadSchemaVersion",
          "sourceDeviceID",
          "updatedAt",
          "sealedPayload"
        ])
        && request.resource.data.keys().hasAll([
          "uid",
          "schemaVersion",
          "payloadSchemaVersion",
          "updatedAt",
          "sealedPayload"
        ])
