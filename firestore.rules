      }

      function validEscrowDeviceDocument(deviceId) {
        let d = request.resource.data;
        return d.keys().hasOnly([
          "deviceId",
          "deviceName",
          "platform",
          "appVersion",
          "trustState",
          "approvedAt",
          "createdAt",
          "updatedAt",
          "publicKeyFingerprint",
          "keyVersion",
          "approvedByDeviceId",
          "trustChainVersion",
          "trustChainAlgorithm",
          "trustChainSignature",
          "targetSignalIdentityKeyId",
          "targetSignalIdentityPublicKeyFingerprint",
          "approvedBySignalIdentityKeyId",
          "approvedBySignalIdentityPublicKeyFingerprint",
          "signalIdentityRepairVersion",
          "signalIdentityRepairAlgorithm",
          "signalIdentityReapprovalRequired",
