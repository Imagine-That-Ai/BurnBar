    // T-AZ-02: bind the `workspaceId` PATH segment to the caller. The canonical
    // tenant shape is `workspaces/workspace-{uid}/...` (see header), so a caller
    // may only ever touch their OWN workspace path — they cannot read or write
    // another tenant's `workspaces/workspace-<victimUid>/...` subtree even if they
    // were to forge a matching `ownerUserID` document field. This is the path-level
    // tenant boundary; the per-document `ownerUserID`/`workspaceID`/`teamID` checks
    // below remain as defense-in-depth on the document body.
    function callerOwnsWorkspacePath(workspaceId) {
      return isSignedIn()
        && workspaceId == "workspace-" + request.auth.uid;
    }

    function sharedArtifactOwnerRead(workspaceId) {
      return callerOwnsWorkspacePath(workspaceId)
        && resource.data.ownerUserID is string
        && resource.data.ownerUserID == request.auth.uid;
    }

    function sharedArtifactOwnerWrite(workspaceId, teamId) {
      return callerOwnsWorkspacePath(workspaceId)
