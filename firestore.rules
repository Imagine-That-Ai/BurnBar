            || (!("approvedByDeviceId" in resource.data)
              && !("approvedByDeviceId" in request.resource.data)))
          && ((("trustChainVersion" in resource.data)
              && request.resource.data.trustChainVersion == resource.data.trustChainVersion)
            || (!("trustChainVersion" in resource.data)
              && !("trustChainVersion" in request.resource.data)))
          && ((("trustChainAlgorithm" in resource.data)
              && request.resource.data.trustChainAlgorithm == resource.data.trustChainAlgorithm)
            || (!("trustChainAlgorithm" in resource.data)
              && !("trustChainAlgorithm" in request.resource.data)))
          && ((("trustChainSignature" in resource.data)
              && request.resource.data.trustChainSignature == resource.data.trustChainSignature)
            || (!("trustChainSignature" in resource.data)
              && !("trustChainSignature" in request.resource.data)))
