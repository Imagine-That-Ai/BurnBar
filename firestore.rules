    match /users/{userId}/escrow_grants/{grantId} {
      allow read: if ownsUserNamespace(userId);
      allow create, update: if ownsUserNamespace(userId)
        && escrowDocumentLimits()
        && hasNoPlaintextSecretFields();
      allow delete: if ownsUserNamespace(userId);
    }

    match /users/{userId}/escrow_envelopes/{envelopeId} {
      function validEscrowEnvelopeDocument() {
        return request.resource.data.keys().hasOnly([
          "id",
          "grantId",
          "sourceDeviceId",
          "targetDeviceId",
          "providerId",
          "credentialKind",
          "accountLabel",
          "ciphertext",
          "keyVersion",
          "envelopeVersion",
          "createdAt"
        ])
        && request.resource.data.id == envelopeId
        && request.resource.data.grantId is string
        && request.resource.data.grantId.size() <= 160
        && request.resource.data.sourceDeviceId is string
        && request.resource.data.sourceDeviceId.size() <= 160
        && request.resource.data.targetDeviceId is string
        && request.resource.data.targetDeviceId.size() <= 160
        && request.resource.data.providerId is string
        && request.resource.data.providerId.size() <= 80
        && request.resource.data.credentialKind in ["api_key", "oauth_token", "bearer_token", "unknown"]
        && (!("accountLabel" in request.resource.data) || (request.resource.data.accountLabel is string && request.resource.data.accountLabel.size() <= 160))
        && request.resource.data.ciphertext is string
        && request.resource.data.ciphertext.size() >= 16
        && request.resource.data.ciphertext.size() <= 20000
        && request.resource.data.ciphertext.matches("^[A-Za-z0-9+/=_-]*$")
        && request.resource.data.keyVersion is int
        && request.resource.data.envelopeVersion is int
        && request.resource.data.createdAt is timestamp;
      }

      allow read: if ownsUserNamespace(userId);
      allow create, update: if ownsUserNamespace(userId)
        && escrowDocumentLimits()
        && hasNoPlaintextSecretFields()
        && validEscrowEnvelopeDocument();
      allow delete: if ownsUserNamespace(userId);
    }

    match /users/{userId}/escrow_audit_events/{eventId} {
      allow read: if ownsUserNamespace(userId);
      allow create, update: if ownsUserNamespace(userId)
        && escrowDocumentLimits()
        && hasNoPlaintextSecretFields();
      allow delete: if ownsUserNamespace(userId);
    }

    match /users/{userId}/cloud_profile/{profileId} {
      allow read: if ownsUserNamespace(userId);
      allow create, update: if ownsUserNamespace(userId)
        && escrowDocumentLimits()
