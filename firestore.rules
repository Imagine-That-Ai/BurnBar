      match /one_time_prekeys/{oneTimePreKeyId} {
        function validOneTimePreKeyDocument() {
          return request.resource.data.keys().hasOnly([
            "oneTimePreKeyId",
            "oneTimePreKeyNumericId",
            "identityKeyId",
            "deviceId",
            "keyVersion",
            "publicKeyB64",
            "algorithm",
            "status",
            "claimedBySessionId",
            "claimedAt",
            "createdAt",
            "updatedAt",
            "expiresAt"
          ])
          && validSignalDirectoryBase()
          && request.resource.data.oneTimePreKeyId == oneTimePreKeyId
          && request.resource.data.oneTimePreKeyNumericId is int
          && request.resource.data.oneTimePreKeyNumericId >= 1
          && request.resource.data.oneTimePreKeyNumericId <= 2147483647
          && validSignalBase64(request.resource.data.publicKeyB64, 256)
          && request.resource.data.algorithm == "signal-pqxdh-one-time-prekey-v1"
          && request.resource.data.status in ["available", "claimed", "exhausted", "retired"]
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt > request.time
          && (
            request.resource.data.status == "available"
            || (
              request.resource.data.claimedBySessionId is string
              && request.resource.data.claimedBySessionId.size() <= 200
              && request.resource.data.claimedAt is timestamp
            )
          );
        }

        function oneTimePreKeyImmutableFieldsUnchanged() {
          return request.resource.data.oneTimePreKeyId == resource.data.oneTimePreKeyId
            && request.resource.data.oneTimePreKeyNumericId == resource.data.oneTimePreKeyNumericId
            && request.resource.data.identityKeyId == resource.data.identityKeyId
            && request.resource.data.deviceId == resource.data.deviceId
            && request.resource.data.keyVersion == resource.data.keyVersion
            && request.resource.data.publicKeyB64 == resource.data.publicKeyB64
            && request.resource.data.algorithm == resource.data.algorithm
            && request.resource.data.createdAt == resource.data.createdAt;
        }

        allow read: if ownsUserNamespace(userId);
        allow create: if ownsUserNamespace(userId)
          && signalDirectoryDocumentLimits()
          && validOneTimePreKeyDocument()
          && request.resource.data.status == "available";
        allow update: if ownsUserNamespace(userId)
          && signalDirectoryDocumentLimits()
          && validOneTimePreKeyDocument()
          && oneTimePreKeyImmutableFieldsUnchanged()
          && resource.data.status == "available"
          && request.resource.data.status in ["claimed", "exhausted", "retired"];
