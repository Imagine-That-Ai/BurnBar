              && request.resource.data.approvedBySignalIdentityKeyId == resource.data.approvedBySignalIdentityKeyId)
            || (!("approvedBySignalIdentityKeyId" in resource.data)
              && !("approvedBySignalIdentityKeyId" in request.resource.data)))
