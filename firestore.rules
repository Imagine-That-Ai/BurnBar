rules_version = '2';
// OpenBurnBar currently syncs explicit owner-scoped collections:
// - users/{uid}/usage, conversations, chat_threads, text_snippets, session_logs (+ chunks), devices
// - users/{uid}/quota_snapshots, provider_connections, provider_accounts, usage_rollups
// - users/{uid}/projects (derived read model)
// - users/{uid}/hermes_connections, hermes_pairings, hermes_relay_requests, hermes_session_cache, hermes_audit_events
// - users/{uid}/iroh_pairing, iroh_pairing_keys, iroh_audit_events
// - users/{uid}/agent_grant_authorities, agent_capability_grant_requests
// - users/{uid}/pi_agent_connections, pi_agent_pairings, pi_agent_relay_requests, pi_agent_audit_events
// - users/{uid}/provider_account_device_links, runtime_connection_preferences
// - users/{uid}/cloud_profile, sync_watermarks, sync_status, cloud_settings, recent_usage
// - users/{uid}/cloud_search_index_manifest, remote_mcp_clients, remote_mcp_grants, remote_mcp_audit_events, remote_mcp_rate_limits
// - users/{uid}/cli_sessions, cli_agent_mission_requests
// - users/{uid}/escrow_devices, escrow_public_keys, signal_identity_public_keys, escrow_grants, escrow_envelopes, escrow_audit_events
// - server-only: provider_account_secret_refs, users/{uid}/_rate_limits, users/{uid}/rollup_jobs
// - public read-only: model_benchmark_snapshots, model_benchmark_source_status
// - workspaces/workspace-{uid}/teams/team-default/artifacts/{artifactID} (+ versions/{revisionID})
// The shared-artifact rule below intentionally stays owner-scoped for this source release.
//
// App Check: `request.auth` below is not sufficient to block non-app clients. Enforce
// App Check for Cloud Firestore in the Firebase console so only your app+attested
// traffic reaches this ruleset. See: https://firebase.google.com/docs/app-check/enable-enforcement
// and docs/FIREBASE_APP_CHECK_ENFORCEMENT.md in this repo.
//
// Escrow trust: clients may register pending escrow_devices but cannot elevate
// trustState to `trusted` in rules — use the `approveEscrowDeviceTrust` callable.
//
// Escrow security: escrow_envelopes MUST contain ciphertext only. The rules below
// reject documents that contain field names associated with plaintext credentials.
// Client code is independently responsible for ensuring plaintext secrets are never
// serialized into Firestore documents (validated by unit tests).
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOperator() {
      return isSignedIn() && request.auth.token.get('burnbarOperator', false) == true;
    }

    function requestWithinBasicLimits() {
      return request.resource.size() < 1048576
        && request.resource.data.keys().size() < 80;
    }

    function escrowDocumentLimits() {
      return request.resource.size() < 51200
        && request.resource.data.keys().size() < 20;
    }

    function ownsUserNamespace(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasNoPlaintextSecretFields() {
      return !("apiKey" in request.resource.data)
        && !("token" in request.resource.data)
        && !("refreshToken" in request.resource.data)
        && !("accessToken" in request.resource.data)
        && !("idToken" in request.resource.data)
        && !("cookie" in request.resource.data)
        && !("password" in request.resource.data)
        && !("secret" in request.resource.data)
        && !("secretVersionName" in request.resource.data)
        && !("authorization" in request.resource.data)
        && !("bearer" in request.resource.data)
        && !("credential" in request.resource.data);
    }

    function ownerWritableNonSecret(userId) {
      return ownsUserNamespace(userId)
        && requestWithinBasicLimits()
        && hasNoPlaintextSecretFields();
    }

    function validRootUserProfileWrite(userId) {
      return ownerWritableNonSecret(userId)
        && request.resource.data.keys().hasOnly([
          "uid",
          "displayName",
          "email",
          "photoURL",
          "avatarURL",
          "createdAt",
          "updatedAt",
          "lastSeenAt",
          "sourceDeviceId",
          "deviceId",
          "platform",
          "appVersion",
          "timezone",
          "locale",
          "settingsVersion",
          "schemaVersion"
        ])
        && (!("uid" in request.resource.data) || request.resource.data.uid == userId)
        && (!("displayName" in request.resource.data) || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 200))
        && (!("email" in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 320))
        && (!("photoURL" in request.resource.data) || (request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 2000))
        && (!("avatarURL" in request.resource.data) || (request.resource.data.avatarURL is string && request.resource.data.avatarURL.size() <= 2000))
        && (!("createdAt" in request.resource.data) || request.resource.data.createdAt is timestamp)
        && (!("updatedAt" in request.resource.data) || request.resource.data.updatedAt is timestamp)
        && (!("lastSeenAt" in request.resource.data) || request.resource.data.lastSeenAt is timestamp)
        && (!("sourceDeviceId" in request.resource.data) || (request.resource.data.sourceDeviceId is string && request.resource.data.sourceDeviceId.size() <= 256))
        && (!("deviceId" in request.resource.data) || (request.resource.data.deviceId is string && request.resource.data.deviceId.size() <= 256))
        && (!("platform" in request.resource.data) || (request.resource.data.platform is string && request.resource.data.platform.size() <= 80))
        && (!("appVersion" in request.resource.data) || (request.resource.data.appVersion is string && request.resource.data.appVersion.size() <= 80))
        && (!("timezone" in request.resource.data) || (request.resource.data.timezone is string && request.resource.data.timezone.size() <= 120))
        && (!("locale" in request.resource.data) || (request.resource.data.locale is string && request.resource.data.locale.size() <= 40))
        && (!("settingsVersion" in request.resource.data) || (request.resource.data.settingsVersion is int && request.resource.data.settingsVersion >= 1 && request.resource.data.settingsVersion <= 10000))
        && (!("schemaVersion" in request.resource.data) || (request.resource.data.schemaVersion is int && request.resource.data.schemaVersion >= 1 && request.resource.data.schemaVersion <= 100));
    }

    function validPixelClockConfig(pixelClock) {
      return pixelClock is map
        && pixelClock.keys().hasOnly([
          "enabled",
          "host",
          "port",
          "layout",
          "palette",
          "timePeriod",
          "workingSpinnerStyle",
          "workingSpinnerPrimaryHex",
          "workingSpinnerSecondaryHex",
          "completionClockSoundEnabled",
          "completionLocalNotificationsEnabled",
          "pageDurationSeconds",
          "updateIntervalSeconds",
          "scrollSpeedPercent",
          "brightness",
          "providerIDs",
          "updatedAt",
          "updatedByDeviceId",
          "lastProbeStatus"
        ])
        && pixelClock.enabled is bool
        && pixelClock.host is string
        && pixelClock.host.size() <= 255
        && pixelClock.port is int
        && pixelClock.port >= 1
        && pixelClock.port <= 65535
        && pixelClock.layout in ["providerDashboard", "quotaCarousel", "burnStatus", "alertsOnly"]
        && pixelClock.palette in ["emberWhimsy", "mercury", "traffic", "monochrome"]
        && pixelClock.timePeriod in ["rolling5h", "rolling24h", "rolling7d", "rolling30d"]
        && (!("workingSpinnerStyle" in pixelClock) || pixelClock.workingSpinnerStyle in ["orbit", "chase", "pulse", "scan"])
        && (!("workingSpinnerPrimaryHex" in pixelClock) || (pixelClock.workingSpinnerPrimaryHex is string && pixelClock.workingSpinnerPrimaryHex.matches("^#[0-9A-Fa-f]{6}$")))
        && (!("workingSpinnerSecondaryHex" in pixelClock) || (pixelClock.workingSpinnerSecondaryHex is string && pixelClock.workingSpinnerSecondaryHex.matches("^#[0-9A-Fa-f]{6}$")))
        && (!("completionClockSoundEnabled" in pixelClock) || pixelClock.completionClockSoundEnabled is bool)
        && (!("completionLocalNotificationsEnabled" in pixelClock) || pixelClock.completionLocalNotificationsEnabled is bool)
        && pixelClock.pageDurationSeconds is int
        && pixelClock.pageDurationSeconds >= 3
        && pixelClock.pageDurationSeconds <= 30
        && pixelClock.updateIntervalSeconds is int
        && pixelClock.updateIntervalSeconds >= 15
        && pixelClock.updateIntervalSeconds <= 3600
        && pixelClock.scrollSpeedPercent is int
        && pixelClock.scrollSpeedPercent >= 10
        && pixelClock.scrollSpeedPercent <= 300
        && (!("brightness" in pixelClock) || (
          pixelClock.brightness is int
          && pixelClock.brightness >= 0
          && pixelClock.brightness <= 255
        ))
        && pixelClock.providerIDs is list
        && pixelClock.providerIDs.size() <= 24
        && pixelClock.lastProbeStatus in ["unknown", "awtrixReady", "stockUlanziFirmware", "unreachable", "unsupported", "error"]
        && (!("updatedByDeviceId" in pixelClock) || (pixelClock.updatedByDeviceId is string && pixelClock.updatedByDeviceId.size() <= 160));
    }

    function validSmartHubDisplayConfig(displayConfig) {
      return displayConfig is map
        && displayConfig.keys().hasOnly([
          "layout",
          "palette",
          "theme",
          "background",
          "brightness",
          "scrollSpeedSeconds",
          "refreshCadenceSeconds",
          "providerIDs",
          "audibleCue",
          "identifyOnRefresh",
          "updatedAt"
        ])
        && displayConfig.layout in ["quotaCarousel", "bigTotal", "providerGrid", "singleProvider"]
        && displayConfig.palette in ["emberWhimsy", "mercury", "forestSage", "monochrome"]
        && displayConfig.theme in ["warmCharcoal", "botanicalCream", "oledBlack", "matchSystem"]
        && displayConfig.background in ["dashboard", "ambient", "photoBlend"]
        && displayConfig.brightness is number
        && displayConfig.brightness >= 0.2
        && displayConfig.brightness <= 1.0
        && displayConfig.scrollSpeedSeconds is int
        && displayConfig.scrollSpeedSeconds >= 3
        && displayConfig.scrollSpeedSeconds <= 30
        && displayConfig.refreshCadenceSeconds is int
        && displayConfig.refreshCadenceSeconds >= 3
        && displayConfig.refreshCadenceSeconds <= 60
        && displayConfig.providerIDs is list
        && displayConfig.providerIDs.size() <= 24
        && displayConfig.audibleCue is bool
        && displayConfig.identifyOnRefresh is bool
        && displayConfig.updatedAt is string
        && displayConfig.updatedAt.size() <= 64;
    }

    function validSmartDisplayOrder(displayOrder) {
      return displayOrder is list
        && displayOrder.size() <= 4
        && displayOrder.hasOnly(["nestHub", "pixelClock"]);
    }

    function hostedCloudEntitlementPath(userId) {
      return /databases/$(database)/documents/users/$(userId)/entitlements/hosted_quota_sync;
    }

    function burnBarProEntitlementPath(userId) {
      return /databases/$(database)/documents/users/$(userId)/entitlements/burnbar_pro;
    }

    function burnBarProMaxEntitlementPath(userId) {
      return /databases/$(database)/documents/users/$(userId)/entitlements/burnbar_pro_max;
    }

    function activePremiumEntitlementData(entitlement) {
      return entitlement.active == true
        // BEGIN GENERATED: entitlement-product-ids premium — do not hand-edit.
        // Source: packages/entitlements/src/catalog.ts (FIRESTORE_RULES_PRODUCT_ID_ALLOWLISTS.premium).
        // Regenerate: node tools/gen-rules-entitlements.mjs (CI drift gate: --check).
        && entitlement.productID in [
          "com.openburnbar.hostedQuotaSync.cloud.monthly",
          "com.openburnbar.hostedQuotaSync.monthly",
          "com.openburnbar.pro.monthly",
          "com.openburnbar.pro.annual",
          "com.openburnbar.proMax.bundle.monthly",
          "com.openburnbar.proMax.v2.monthly",
          "com.openburnbar.proMax.annual",
          "com.openburnbar.ultra.monthly",
          "com.openburnbar.ultra.annual",
          "com.openburnbar.ultra.annual.v2"
        ]
        // END GENERATED: entitlement-product-ids premium
        && entitlement.expireAt is timestamp
        && entitlement.expireAt > request.time;
    }

    function hasActiveHostedQuotaEntitlement(userId) {
      return (
          exists(hostedCloudEntitlementPath(userId))
          && activePremiumEntitlementData(get(hostedCloudEntitlementPath(userId)).data)
        )
        || (
          exists(burnBarProEntitlementPath(userId))
          && activePremiumEntitlementData(get(burnBarProEntitlementPath(userId)).data)
        )
        || (
          exists(burnBarProMaxEntitlementPath(userId))
          && activePremiumEntitlementData(get(burnBarProMaxEntitlementPath(userId)).data)
        );
    }

    // --- Mercury media entitlement (Phase 2 SKU rollout) ---
    // Mirrors `hasActiveHostedQuotaEntitlement` for the new
    // `hosted_media_sync` SKU. The Mac is the source of truth at session
    // time (Decision 2), but the rules-side helper is what gates the
    // owner-writable metadata collections (`media_attachment_manifests`,
    // `media_session_events`).
    function hostedMediaEntitlementPath(userId) {
      return /databases/$(database)/documents/users/$(userId)/entitlements/hosted_media_sync;
    }

    function activeMediaEntitlementData(entitlement) {
      return entitlement.active == true
        // BEGIN GENERATED: entitlement-product-ids media — do not hand-edit.
        // Source: packages/entitlements/src/catalog.ts (FIRESTORE_RULES_PRODUCT_ID_ALLOWLISTS.media).
        // Regenerate: node tools/gen-rules-entitlements.mjs (CI drift gate: --check).
        && entitlement.productID in [
          "com.openburnbar.hostedMediaSync.monthly",
          "com.openburnbar.proMax.bundle.monthly",
          "com.openburnbar.proMax.v2.monthly",
          "com.openburnbar.proMax.annual",
          "com.openburnbar.ultra.monthly",
          "com.openburnbar.ultra.annual",
          "com.openburnbar.ultra.annual.v2"
        ]
        // END GENERATED: entitlement-product-ids media
        && entitlement.expireAt is timestamp
        && entitlement.expireAt > request.time;
    }

    function hasActiveHostedMediaEntitlement(userId) {
      return (
          exists(hostedMediaEntitlementPath(userId))
          && activeMediaEntitlementData(get(hostedMediaEntitlementPath(userId)).data)
        )
        || (
          exists(burnBarProMaxEntitlementPath(userId))
          && activeMediaEntitlementData(get(burnBarProMaxEntitlementPath(userId)).data)
        );
    }

    // Computer Use entitlement helpers. Phase 9 ships
    // `hosted_computer_use_sync` as a separate SKU; the `pro_max`
    // umbrella bundles it. See
    // `plans/2026-05-16-computer-use-master-plan.md` § E.1.
    function hostedComputerUseEntitlementPath(userId) {
      return /databases/$(database)/documents/users/$(userId)/entitlements/hosted_computer_use_sync;
    }

    function activeComputerUseEntitlementData(entitlement) {
	      return entitlement.active == true
	        // BEGIN GENERATED: entitlement-product-ids computerUse — do not hand-edit.
	        // Source: packages/entitlements/src/catalog.ts (FIRESTORE_RULES_PRODUCT_ID_ALLOWLISTS.computerUse).
	        // Regenerate: node tools/gen-rules-entitlements.mjs (CI drift gate: --check).
	        && entitlement.productID in [
	          "com.openburnbar.computerUse.monthly",
	          "com.openburnbar.hostedComputerUseSync.monthly",
	          "com.openburnbar.proMax.bundle.monthly",
	          "com.openburnbar.proMax.v2.monthly",
	          "com.openburnbar.proMax.annual",
	          "com.openburnbar.ultra.monthly",
	          "com.openburnbar.ultra.annual",
	          "com.openburnbar.ultra.annual.v2"
	        ]
	        // END GENERATED: entitlement-product-ids computerUse
        && entitlement.expireAt is timestamp
        && entitlement.expireAt > request.time;
    }

    function hasActiveHostedComputerUseEntitlement(userId) {
      return (
          exists(hostedComputerUseEntitlementPath(userId))
          && activeComputerUseEntitlementData(get(hostedComputerUseEntitlementPath(userId)).data)
        )
        || (
          exists(burnBarProMaxEntitlementPath(userId))
          && activeComputerUseEntitlementData(get(burnBarProMaxEntitlementPath(userId)).data)
        );
    }

    function ownerWritableHostedCloudBackup(userId) {
      return ownerWritableNonSecret(userId)
        && hasActiveHostedQuotaEntitlement(userId);
    }

    // Strict allowlist for the encrypted session-log manifest. The set below is
    // the UNION of every key any write path leaves on the doc post-merge: the
    // full create (SessionLogSyncService.swift uploadManifest) plus the
    // facet-refresh merge update (facetFields + updatedAt). Because the writer
    // uses merge:true, request.resource.data is the post-merge full document, so
    // the allowlist must cover the union; the legacy plaintext fields are removed
    // via FieldValue.delete() and therefore absent — they stay denied by both
    // hasOnly and the belt-and-suspenders !hasAny() denylist below. No
    // content/title/project text can ride along — only sealed envelopes, storage
    // pointers, hashes, and bounded cockpit facets.
    function validSessionLogManifestKeys() {
      return request.resource.data.keys().hasOnly([
        "id",
        "deviceId",
        "provider",
        "sessionId",
        "sourceType",
        "inferredTaskTitle",
        "bodyStorage",
        "storagePath",
        "sealedTitle",
        "sealedBodyPreview",
        "encryption",
        "vaultKeyID",
        "chunkCount",
        "searchChunkCount",
        "byteCount",
        "encryptedByteCount",
        "bodyHash",
        "bodyHashVersion",
        "chunkSize",
        "chunkHashes",
        "chunkHashVersion",
        "chunkMetadataVersion",
        "cloudSearchIndexVersion",
        "cloudSearchIndexedAt",
        "updatedAt",
        "startTime",
        "endTime",
        "facetSchemaVersion",
        "model",
        "messageCount",
        "userWordCount",
        "assistantWordCount",
        "inputTokens",
        "outputTokens",
        "cacheCreationTokens",
        "cacheReadTokens",
        "totalTokens",
        "costUSD",
        "toolTags",
        "durationSeconds"
      ]);
    }

    function ownerWritableSessionLogManifest(userId) {
      return ownerWritableHostedCloudBackup(userId)
        && validSessionLogManifestKeys()
        && !("body" in request.resource.data)
        && !("payloadCiphertext" in request.resource.data)
        && !("ciphertext" in request.resource.data)
        && !("data" in request.resource.data)
        && !("text" in request.resource.data)
        && !("title" in request.resource.data)
        && !("snippet" in request.resource.data)
        && !("terms" in request.resource.data)
        && !("projectName" in request.resource.data)
        && !("workingDirectory" in request.resource.data)
        && (!("inferredTaskTitle" in request.resource.data) || request.resource.data.inferredTaskTitle == "Encrypted session")
        && (!("sealedTitle" in request.resource.data) || validCloudSealedText(request.resource.data.sealedTitle))
        && (!("sealedBodyPreview" in request.resource.data) || validCloudSealedText(request.resource.data.sealedBodyPreview))
        && (!("encryption" in request.resource.data) || request.resource.data.encryption is map)
        && (!("vaultKeyID" in request.resource.data) || validVaultKeyID(request.resource.data.vaultKeyID))
        && validSessionLogFacets(request.resource.data);
    }

    // Plaintext cockpit facets are metadata only (counters, cost, timing, working directory,
    // and generic tool tags). This constrains each optional facet to a bounded primitive so
    // conversation content can never ride along inside a facet field.
    function validSessionLogFacetCount(data, field) {
      return !(field in data) || (data[field] is int && data[field] >= 0 && data[field] <= 100000000000);
    }

    function validSessionLogFacets(data) {
      return validSessionLogFacetCount(data, "inputTokens")
        && validSessionLogFacetCount(data, "outputTokens")
        && validSessionLogFacetCount(data, "cacheCreationTokens")
        && validSessionLogFacetCount(data, "cacheReadTokens")
        && validSessionLogFacetCount(data, "totalTokens")
        && validSessionLogFacetCount(data, "messageCount")
        && validSessionLogFacetCount(data, "userWordCount")
        && validSessionLogFacetCount(data, "assistantWordCount")
        && validSessionLogFacetCount(data, "durationSeconds")
        && validSessionLogFacetCount(data, "facetSchemaVersion")
        && (!("costUSD" in data) || (data.costUSD is number && data.costUSD >= 0))
        && (!("model" in data) || (data.model is string && data.model.size() <= 200))
        && (!("provider" in data) || (data.provider is string && data.provider.size() <= 80))
        && (!("sourceType" in data) || (data.sourceType is string && data.sourceType.size() <= 80))
        && (!("toolTags" in data) || (data.toolTags is list && data.toolTags.size() <= 32));
    }

    function validCloudHexDigest(value) {
      return value is string
        && value.matches("^[a-f0-9]{32,128}$");
    }

    function cloudVaultAADContext(userId, collection, docID, field) {
      return "OpenBurnBar-CloudVault-aad-v2|" + userId + "|" + collection + "|" + docID + "|" + field + "|2|" + field;
    }

    function validCloudVaultAAD(value) {
      return value is string
        && value.matches("^OpenBurnBar-CloudVault-aad-v2\\|[^|]+\\|[^|]+\\|[^|]+\\|[^|]+\\|[2-9][0-9]*\\|[^|]+$");
    }

    function validCloudSealedText(value) {
      return value is map
        && value.keys().hasAll([
          "algorithm",
          "keyVersion",
          "nonce",
          "ciphertext",
          "tag"
        ])
        && value.keys().hasOnly([
          "schemaVersion",
          "algorithm",
          "keyVersion",
          "nonce",
          "ciphertext",
          "tag",
          "aad"
        ])
        && (!("schemaVersion" in value) || (value.schemaVersion is int && value.schemaVersion >= 1 && value.schemaVersion <= 10))
        && value.algorithm == "AES-256-GCM"
        && value.keyVersion is int
        && value.keyVersion >= 1
        && value.keyVersion <= 100
        && value.nonce is string
        && value.nonce.size() <= 128
        && value.nonce.matches("^[A-Za-z0-9+/=]+$")
        && value.ciphertext is string
        && value.ciphertext.size() <= 8192
        && value.ciphertext.matches("^[A-Za-z0-9+/=]+$")
        && value.tag is string
        && value.tag.size() <= 128
        && value.tag.matches("^[A-Za-z0-9+/=]+$")
        && (
          (!("schemaVersion" in value) && !("aad" in value))
          || (value.schemaVersion == 1 && !("aad" in value))
          || (value.schemaVersion >= 2 && validCloudVaultAAD(value.aad))
        );
    }

    function validCloudSealedTextAt(userId, collection, docID, field, value) {
      return validCloudSealedText(value)
        && value.schemaVersion is int
        && value.schemaVersion >= 2
        && value.aad == cloudVaultAADContext(userId, collection, docID, field);
    }

    function validPathBoundCloudSealedText(value, expectedAAD) {
      return value is map
        && value.keys().hasAll([
          "schemaVersion",
          "algorithm",
          "keyVersion",
          "nonce",
          "ciphertext",
          "tag",
          "aad"
        ])
        && value.keys().hasOnly([
          "schemaVersion",
          "algorithm",
          "keyVersion",
          "nonce",
          "ciphertext",
          "tag",
          "aad"
        ])
        && value.schemaVersion is int
        && value.schemaVersion >= 2
        && value.schemaVersion <= 10
        && value.algorithm == "AES-256-GCM"
        && value.keyVersion is int
        && value.keyVersion >= 1
        && value.keyVersion <= 100
        && value.nonce is string
        && value.nonce.size() <= 128
        && value.nonce.matches("^[A-Za-z0-9+/=]+$")
        && value.ciphertext is string
        && value.ciphertext.size() <= 8192
        && value.ciphertext.matches("^[A-Za-z0-9+/=]+$")
        && value.tag is string
        && value.tag.size() <= 128
        && value.tag.matches("^[A-Za-z0-9+/=]+$")
        && value.aad == expectedAAD;
    }

    // CloudVaultBlobEnvelopeDoc (sealed binary blob, larger than sealed text).
    // Used by project_memory_snapshots.sealedSnapshot. Mirrors the Swift/TS
    // CloudVaultCrypto blob envelope shape — never invent a new one.
    function validCloudSealedBlob(value, expectedAAD) {
      return value is map
        && value.keys().hasOnly([
          "schemaVersion",
          "algorithm",
          "keyVersion",
          "plaintextSHA256",
          "plaintextHMAC",
          "integrityHashVersion",
          "sealedBoxBase64",
          "createdAt",
          "aad"
        ])
        && value.schemaVersion is int
        && value.schemaVersion >= 1
        && value.schemaVersion <= 10
        && value.algorithm == "AES-256-GCM"
        && value.keyVersion is int
        && value.keyVersion >= 1
        && value.keyVersion <= 100
        && (
          (
            value.schemaVersion == 1
            && validCloudHexDigest(value.plaintextSHA256)
            && !("plaintextHMAC" in value)
            && !("integrityHashVersion" in value)
            && !("aad" in value)
          )
          || (
            value.schemaVersion >= 2
            && !("plaintextSHA256" in value)
            && validCloudHexDigest(value.plaintextHMAC)
            && value.integrityHashVersion is int
            && value.integrityHashVersion >= 1
            && value.integrityHashVersion <= 100
            && value.aad == expectedAAD
          )
        )
        && value.sealedBoxBase64 is string
        && value.sealedBoxBase64.size() > 0
        && value.sealedBoxBase64.size() <= 900000
        && value.sealedBoxBase64.matches("^[A-Za-z0-9+/=]+$");
    }

    function validVaultKeyID(value) {
      return value is string
        && value.matches("^v1_[a-f0-9]{32}$");
    }

    function validCloudSealedPayload(value) {
      return value is map
        && value.keys().hasOnly([
          "schemaVersion",
          "algorithm",
          "keyVersion",
          "vaultKeyID",
          "sealedBoxBase64",
          "aad"
        ])
        && value.schemaVersion == 2
        && value.algorithm == "AES-256-GCM"
        && value.keyVersion is int
        && value.keyVersion >= 1
        && value.keyVersion <= 100
        && validVaultKeyID(value.vaultKeyID)
        && (
          value.aad == "OpenBurnBar-CloudVaultSealedPayload-v2"
          || validCloudVaultAAD(value.aad)
        )
        && value.sealedBoxBase64 is string
        && value.sealedBoxBase64.size() > 0
        && value.sealedBoxBase64.size() <= 900000
        && value.sealedBoxBase64.matches("^[A-Za-z0-9+/=]+$");
    }

    // ---- Signal at-rest CloudVault envelopes ------------------------------------
    // Client-direct writes MUST NOT include `signalEnvelope`. Firestore rules cannot
    // iterate and deep-validate every recipient wrap or verify senderAuth signatures,
    // so production Signal-at-rest producers must route through an Admin/callable path
    // that sanitizes the full envelope before persisting. This keeps the backend
    // zero-plaintext while avoiding a shallow-rules validation bypass.
    function forbidsDirectSignalEnvelope() {
      return !("signalEnvelope" in request.resource.data);
    }

    // T-AZ-04: belt-and-suspenders plaintext-content ban for sealed collections.
    // Each sealed collection already pins an exact `hasOnly(...)` allowlist, so an
    // unknown field is rejected outright. This helper is the additional, explicit
    // denylist of the cleartext content/title/body field names a sealed mirror
    // must NEVER carry — it mirrors the per-collection denylists already inlined
    // on `conversations`/`mission_groups`/`cli_agent_mission_events`/`chat_threads`
    // and the session-log manifest, so every sealed collection enforces the SAME
    // shape and a future allowlist edit cannot silently re-admit a plaintext key.
    // NOTE: this is a rules-side defense-in-depth measure only. Full no-plaintext
    // also depends on client correctness — producers must seal content into the
    // `sealedPayload` envelope and never serialize the cleartext into Firestore
    // (independently validated by the Swift/TS unit tests).
    function forbidsSealedPlaintextContentFields() {
      return !request.resource.data.keys().hasAny([
        "body",
        "text",
        "title",
        "preview",
        "message",
        "messages",
        "fullMessage",
        "snippet",
        "summary",
        "summaryTitle",
        "content",
        "transcript",
        "prompt",
        "lastAssistantMessage",
        "projectName",
        "workingDirectory",
        "ciphertext",
        "payloadCiphertext"
      ]);
    }

    function validSignalBase64(value, maxLen) {
      return value is string
        && value.size() > 0
        && value.size() <= maxLen
        && value.size() % 4 == 0
        && value.matches("^[A-Za-z0-9+/]*={0,2}$");
    }

    function matchesCurrentVaultKey(userId, vaultKeyID) {
      return validVaultKeyID(vaultKeyID)
        && exists(/databases/$(database)/documents/users/$(userId)/cloud_vault_state/current)
        && get(/databases/$(database)/documents/users/$(userId)/cloud_vault_state/current).data.vaultKeyID == vaultKeyID
        && get(/databases/$(database)/documents/users/$(userId)/cloud_vault_state/current).data.status == "active";
    }

    function validSealedPayloadForUser(userId, vaultKeyID, payload) {
      return matchesCurrentVaultKey(userId, vaultKeyID)
        && validCloudSealedPayload(payload)
        && payload.vaultKeyID == vaultKeyID;
    }

    function validTextSnippetDoc(userId, snippetId) {
      return ownerWritableNonSecret(userId)
        && request.resource.data.keys().hasOnly([
          "id",
          "uid",
          "sourceDeviceID",
          "triggerHash",
          "sealedTitle",
          "sealedTrigger",
          "sealedBody",
          "sealedScope",
          "mode",
          "isEnabled",
          "revision",
          "createdAt",
          "updatedAt",
          "deletedAt",
          "schemaVersion",
          "encryption"
        ])
        && request.resource.data.id == snippetId
        && request.resource.data.uid == userId
        && request.resource.data.sourceDeviceID is string
        && request.resource.data.sourceDeviceID.size() <= 160
        && request.resource.data.triggerHash is string
        && request.resource.data.triggerHash.size() <= 128
        && validPathBoundCloudSealedText(request.resource.data.sealedTitle, cloudVaultAADContext(userId, "text_snippets", snippetId, "sealedTitle"))
        && validPathBoundCloudSealedText(request.resource.data.sealedTrigger, cloudVaultAADContext(userId, "text_snippets", snippetId, "sealedTrigger"))
        && validPathBoundCloudSealedText(request.resource.data.sealedBody, cloudVaultAADContext(userId, "text_snippets", snippetId, "sealedBody"))
        && validPathBoundCloudSealedText(request.resource.data.sealedScope, cloudVaultAADContext(userId, "text_snippets", snippetId, "sealedScope"))
        && request.resource.data.mode in ["static", "llm_rewrite"]
        && request.resource.data.isEnabled is bool
        && request.resource.data.revision is int
        && request.resource.data.revision >= 1
        && request.resource.data.schemaVersion is int
        && request.resource.data.schemaVersion >= 2;
    }

    function validCloudSessionStoragePath(userId, documentId, bodyHash, storagePath) {
      return validCloudHexDigest(bodyHash)
        && storagePath is string
        && storagePath.matches("^users/" + userId + "/session_logs/" + documentId + "/bodies/" + bodyHash + "\\.json\\.aesgcm$");
    }

    function chatThreadIncludesBackedUpContent() {
      return request.resource.data.keys().hasAny(["sealedPayload"])
        || (("contentIncluded" in request.resource.data)
          && request.resource.data.contentIncluded == true);
    }

    function chatThreadHasPlaintextContent() {
      return request.resource.data.keys().hasAny(["messages", "title", "preview"]);
    }

    // Strict allowlist for a cross-device chat thread mirror. Union of the
    // free metadata-only write (contentIncluded:false; title/preview/messages
    // FieldValue.delete()) and the sealed content-backup write
    // (ChatThreadSyncService.swift). The plaintext content keys
    // (title/preview/messages) are NEVER allowed — they are always deleted, so
    // they stay absent and denied by both hasOnly and chatThreadHasPlaintextContent().
    function validChatThreadKeys() {
      return request.resource.data.keys().hasOnly([
        "threadId",
        "messageCount",
        "createdAt",
        "updatedAt",
        "deviceId",
        "contentIncluded",
        "contentSealed",
        "sealedSchemaVersion",
        "vaultKeyID",
        "sealedPayload"
      ]);
    }

    function validChatThreadSealedContent(userId) {
      return !chatThreadHasPlaintextContent()
        && validChatThreadKeys()
        && forbidsDirectSignalEnvelope()
        && (!chatThreadIncludesBackedUpContent()
          || (
            request.resource.data.contentSealed == true
            && request.resource.data.sealedSchemaVersion == 2
            && validSealedPayloadForUser(userId, request.resource.data.vaultKeyID, request.resource.data.sealedPayload)
          ));
    }

    function ownerWritableChatThread(userId) {
      return ownerWritableNonSecret(userId)
        && validChatThreadSealedContent(userId)
        && (!chatThreadIncludesBackedUpContent()
          || hasActiveHostedQuotaEntitlement(userId));
    }

    function relayConnectionWrite(userId, connectionId) {
      return ownerWritableNonSecret(userId)
        && hasActiveHostedQuotaEntitlement(userId)
        && request.resource.data.keys().hasOnly([
          "id",
          "displayName",
          "mode",
          "status",
          "profileName",
          "advertisedModel",
          "hostInstallationId",
          "relayPublicKey",
          "relayKeyVersion",
          "relayEncryption",
          "realtimeRelayURL",
          "realtimeRelayStatus",
          "realtimeRelayLastSeenAt",
          "realtimeRelayProtocolVersion",
          "capabilities",
          "lastSeenAt",
          "createdAt",
          "updatedAt",
          "schemaVersion"
        ])
        && request.resource.data.mode == "relayLink"
        && request.resource.data.status in ["online", "offline", "degraded", "unauthorized"]
        && request.resource.data.schemaVersion is int
        && (!("relayPublicKey" in request.resource.data) || (request.resource.data.relayPublicKey is string && request.resource.data.relayPublicKey.size() <= 256))
        && (!("relayKeyVersion" in request.resource.data) || request.resource.data.relayKeyVersion == 3)
        && (!("relayEncryption" in request.resource.data) || request.resource.data.relayEncryption == "hpke-auth-p256-hkdfsha256-aes256gcm")
        && (!("realtimeRelayURL" in request.resource.data) || (request.resource.data.realtimeRelayURL is string && request.resource.data.realtimeRelayURL.matches("^wss://.+")))
        && (!("realtimeRelayStatus" in request.resource.data) || request.resource.data.realtimeRelayStatus in ["online", "offline", "degraded"])
        && (!("realtimeRelayLastSeenAt" in request.resource.data) || (request.resource.data.realtimeRelayLastSeenAt is string && request.resource.data.realtimeRelayLastSeenAt.size() <= 64))
        && (!("realtimeRelayProtocolVersion" in request.resource.data) || request.resource.data.realtimeRelayProtocolVersion is int)
        && request.resource.data.id is string
        && request.resource.data.id == connectionId
        && request.resource.data.displayName is string
        && (!("hostInstallationId" in request.resource.data) || (request.resource.data.hostInstallationId is string && request.resource.data.hostInstallationId.size() <= 128))
        && request.resource.data.capabilities is list;
    }

    function relayRequestWrite(userId, requestId) {
      return ownerWritableNonSecret(userId)
        && hasActiveHostedQuotaEntitlement(userId)
        && request.resource.data.keys().hasOnly([
          "id",
          "connectionId",
          "operation",
          "status",
          "method",
          "path",
          "sessionId",
          "body",
          "payloadCiphertext",
          "enc",
          "wrappedKey",
          "relayEncryption",
          "relayKeyVersion",
          "senderPublicKey",
          "senderDeviceId",
          "senderPeerNodeId",
          "senderCounter",
          "keyId",
          "error",
          "chunkCount",
          "createdAt",
          "updatedAt",
          "expiresAt",
          "expireAt",
          "claimedAt",
          "claimedBy",
          "completedAt",
          "schemaVersion"
        ])
        && request.resource.data.id is string
        && request.resource.data.id == requestId
        && request.resource.data.connectionId is string
        && request.resource.data.operation in ["chatCompletions", "cliAgentChat", "cliAgentModelCatalog", "models", "sessions", "sessionDetail", "profiles", "jobs"]
        && request.resource.data.status in ["pending", "claimed", "streaming", "completed", "failed", "cancelled", "expired"]
        && request.resource.data.method in ["GET", "POST"]
        && request.resource.data.chunkCount is int
        && request.resource.data.schemaVersion is int
        && request.resource.data.schemaVersion >= 2
        && (!("claimedBy" in request.resource.data) || request.resource.data.claimedBy == request.resource.data.connectionId)
        && !("path" in request.resource.data)
        && !("sessionId" in request.resource.data)
        && !("body" in request.resource.data)
        && !("error" in request.resource.data)
        && request.resource.data.payloadCiphertext is string
        && request.resource.data.payloadCiphertext.size() <= 900000
        && request.resource.data.enc is string
        && request.resource.data.enc.size() <= 4096
        && request.resource.data.wrappedKey is string
        && request.resource.data.wrappedKey.size() <= 4096
        && request.resource.data.relayEncryption == "hpke-auth-p256-hkdfsha256-aes256gcm"
        && request.resource.data.relayKeyVersion == 3
        && request.resource.data.senderPublicKey is string
        && request.resource.data.senderPublicKey.size() >= 80
        && request.resource.data.senderPublicKey.size() <= 128
        && request.resource.data.senderDeviceId is string
        && request.resource.data.senderDeviceId.size() <= 160
        && request.resource.data.senderPeerNodeId is string
        && request.resource.data.senderPeerNodeId.size() <= 160
        && request.resource.data.senderCounter is int
        && request.resource.data.senderCounter >= 0
        && request.resource.data.keyId is string
        && request.resource.data.keyId.matches("^relay-v3-[a-f0-9]{24}$");
    }

    function relayChunkWrite(userId, requestId, chunkId) {
      return ownerWritableNonSecret(userId)
        && hasActiveHostedQuotaEntitlement(userId)
        && request.resource.data.keys().hasOnly([
          "id",
          "requestId",
          "sequence",
          "kind",
          "data",
          "text",
          "error",
          "ciphertext",
          "createdAt",
          "updatedAt",
          "schemaVersion"
        ])
        && request.resource.data.id is string
        && request.resource.data.id == chunkId
        && request.resource.data.requestId is string
        && request.resource.data.requestId == requestId
        && request.resource.data.sequence is int
        && request.resource.data.kind in ["sse", "data", "error"]
        && request.resource.data.schemaVersion is int
        && request.resource.data.schemaVersion >= 2
        && !("data" in request.resource.data)
        && !("text" in request.resource.data)
        && !("error" in request.resource.data)
        && request.resource.data.ciphertext is string
        && request.resource.data.ciphertext.size() <= 131072;
    }

    function hermesGatewayDestinationWrite(userId, destinationId) {
      return ownerWritableNonSecret(userId)
        && destinationId is string
        && hasActiveHostedQuotaEntitlement(userId)
        && request.resource.data.keys().hasOnly([
          "id",
          "displayName",
          "kind",
          "status",
          "isDefault",
          "createdAt",
          "updatedAt",
          "schemaVersion"
        ])
        && request.resource.data.id is string
        && request.resource.data.id.size() <= 160
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.kind in ["home", "chat", "thread"]
        && request.resource.data.status in ["active", "archived"]
        && request.resource.data.isDefault is bool
        && request.resource.data.schemaVersion is int;
    }

    function piRelayConnectionWrite(userId, connectionId) {
      return ownerWritableNonSecret(userId)
        && hasActiveHostedQuotaEntitlement(userId)
        && request.resource.data.keys().hasOnly([
          "id",
          "displayName",
          "mode",
          "status",
          "endpointURL",
          "advertisedModel",
          "selectedInstanceID",
          "redisURL",
          "relayPublicKey",
          "relayKeyVersion",
          "relayEncryption",
          "realtimeRelayURL",
          "realtimeRelayStatus",
          "realtimeRelayLastSeenAt",
          "realtimeRelayProtocolVersion",
          "capabilities",
          "instances",
          "models",
          "lastSeenAt",
          "createdAt",
          "updatedAt",
          "schemaVersion"
        ])
        && request.resource.data.mode == "relayLink"
        && request.resource.data.status in ["online", "offline", "degraded", "unauthorized"]
        && request.resource.data.schemaVersion is int
        && request.resource.data.id is string
        && request.resource.data.id == connectionId
        && request.resource.data.displayName is string
        && request.resource.data.capabilities is list
        && (!("endpointURL" in request.resource.data) || (request.resource.data.endpointURL is string && request.resource.data.endpointURL.size() <= 2048))
        && (!("advertisedModel" in request.resource.data) || (request.resource.data.advertisedModel is string && request.resource.data.advertisedModel.size() <= 160))
        && (!("selectedInstanceID" in request.resource.data) || (request.resource.data.selectedInstanceID is string && request.resource.data.selectedInstanceID.size() <= 160))
        && (!("redisURL" in request.resource.data) || (request.resource.data.redisURL is string && request.resource.data.redisURL.size() <= 2048))
        && (!("relayPublicKey" in request.resource.data) || (request.resource.data.relayPublicKey is string && request.resource.data.relayPublicKey.size() <= 256))
        && (!("relayKeyVersion" in request.resource.data) || request.resource.data.relayKeyVersion is int)
        && (!("relayEncryption" in request.resource.data) || request.resource.data.relayEncryption == "p256-hkdf-sha256-aesgcm")
        && (!("realtimeRelayURL" in request.resource.data) || (request.resource.data.realtimeRelayURL is string && request.resource.data.realtimeRelayURL.matches("^wss://.+")))
        && (!("realtimeRelayStatus" in request.resource.data) || request.resource.data.realtimeRelayStatus in ["online", "offline", "degraded"]);
    }

    function piRelayRequestWrite(userId, requestId) {
      return ownerWritableNonSecret(userId)
        && hasActiveHostedQuotaEntitlement(userId)
        && request.resource.data.keys().hasOnly([
          "id",
          "connectionId",
          "operation",
          "status",
          "method",
          "payloadCiphertext",
          "wrappedKey",
          "relayEncryption",
          "relayKeyVersion",
          "senderPublicKey",
          "senderDeviceId",
          "senderPeerNodeId",
          "senderCounter",
          "chunkCount",
          "createdAt",
          "updatedAt",
          "expiresAt",
          "expireAt",
          "claimedAt",
          "claimedBy",
          "completedAt",
          "schemaVersion"
        ])
        && request.resource.data.id is string
        && request.resource.data.id == requestId
        && request.resource.data.connectionId is string
        && request.resource.data.operation in ["chatCompletions", "models", "sessions", "sessionDetail"]
        && request.resource.data.status in ["pending", "claimed", "streaming", "completed", "failed", "cancelled", "expired"]
        && request.resource.data.method in ["GET", "POST"]
        && request.resource.data.chunkCount is int
        && request.resource.data.schemaVersion is int
        && request.resource.data.schemaVersion >= 2
        && request.resource.data.payloadCiphertext is string
        && request.resource.data.payloadCiphertext.size() <= 900000
        && request.resource.data.wrappedKey is string
        && request.resource.data.wrappedKey.size() <= 4096
        && request.resource.data.relayEncryption == "p256-hkdf-sha256-aesgcm"
        && request.resource.data.relayKeyVersion is int
        // Sender-authentication parity with the Hermes lane
        // (`relayRequestWrite`): a relay request is sender-bound so a malicious
        // co-tenant cannot forge another device's identity. The lane is v2
        // (schemaVersion >= 2), so we require these strictly rather than keep a
        // legacy-empty backward-compat branch.
        && request.resource.data.senderPublicKey is string
        && request.resource.data.senderPublicKey.size() >= 80
        && request.resource.data.senderPublicKey.size() <= 128
        && request.resource.data.senderDeviceId is string
        && request.resource.data.senderDeviceId.size() <= 160
        && request.resource.data.senderPeerNodeId is string
        && request.resource.data.senderPeerNodeId.size() <= 160
        && request.resource.data.senderCounter is int
        && request.resource.data.senderCounter >= 0
        && (!("claimedBy" in request.resource.data) || request.resource.data.claimedBy == request.resource.data.connectionId);
    }

    function piRelayChunkWrite(userId, requestId, chunkId) {
      return ownerWritableNonSecret(userId)
        && hasActiveHostedQuotaEntitlement(userId)
        && request.resource.data.keys().hasOnly([
          "id",
          "requestId",
          "sequence",
          "kind",
          "ciphertext",
          "createdAt",
          "updatedAt",
          "schemaVersion"
        ])
        && request.resource.data.id is string
        && request.resource.data.id == chunkId
        && request.resource.data.requestId is string
        && request.resource.data.requestId == requestId
        && request.resource.data.sequence is int
        && request.resource.data.kind in ["sse", "data", "error"]
        && request.resource.data.schemaVersion is int
        && request.resource.data.schemaVersion >= 2
        && request.resource.data.ciphertext is string
        && request.resource.data.ciphertext.size() <= 131072;
    }

    function runtimeConnectionPreferenceWrite(userId, preferenceId) {
      return ownerWritableNonSecret(userId)
        && request.resource.data.keys().hasOnly([
          "id",
          "deviceID",
          "runtimeKind",
          "selectedConnectionID",
          "selectedInstanceID",
          "selectedModelID",
          "createdAt",
          "updatedAt",
          "schemaVersion"
        ])
        && request.resource.data.id is string
        && request.resource.data.id == preferenceId
        && request.resource.data.deviceID is string
        && request.resource.data.deviceID.size() <= 160
        && request.resource.data.runtimeKind in ["hermes", "piAgent"]
        && preferenceId == request.resource.data.deviceID + "_" + request.resource.data.runtimeKind
        && request.resource.data.selectedConnectionID is string
        && request.resource.data.selectedConnectionID.size() <= 160
        && (!("selectedInstanceID" in request.resource.data) || (request.resource.data.selectedInstanceID is string && request.resource.data.selectedInstanceID.size() <= 160))
        && (!("selectedModelID" in request.resource.data) || (request.resource.data.selectedModelID is string && request.resource.data.selectedModelID.size() <= 240))
        && request.resource.data.schemaVersion is int;
    }

    // T-AZ-02: bind the `workspaceId` PATH segment to the caller. The canonical
    // tenant shape is `workspaces/workspace-{uid}/...` (see header), so a caller
    // may only ever touch their OWN workspace path — they cannot read or write
    // another tenant's `workspaces/workspace-<victimUid>/...` subtree even if they
    // were to forge a matching `ownerUserID` document field. This is the path-level
    // tenant boundary; the per-document `ownerUserID`/`workspaceID`/`teamID` checks
    // below remain as defense-in-depth on the document body.
    function callerOwnsWorkspacePath(workspaceId) {
      return isSignedIn()
        && workspaceId == "workspace-" + request.auth.uid;
    }

    function sharedArtifactOwnerRead(workspaceId) {
      return callerOwnsWorkspacePath(workspaceId)
        && resource.data.ownerUserID is string
        && resource.data.ownerUserID == request.auth.uid;
    }

    function sharedArtifactOwnerWrite(workspaceId, teamId) {
      return callerOwnsWorkspacePath(workspaceId)
        && requestWithinBasicLimits()
        && request.resource.data.ownerUserID is string
        && request.resource.data.ownerUserID == request.auth.uid
        && request.resource.data.workspaceID == workspaceId
        && request.resource.data.teamID == teamId;
    }

    // --- Server-only private provider credential references ---

    // Cloud Functions store Secret Manager version names here. The Admin SDK
    // bypasses rules; clients must never read or write these documents.
    match /provider_account_secret_refs/{refId} {
      allow read, write: if false;
    }

    // --- Credential transfers (cross-device encrypted payload) ---

    match /credential_transfers/{code} {
      function validCredentialTransferCode() {
        return code.matches("^[ABCDEFGHJKMNPQRSTUVWXYZ23456789]{12}$");
      }

      function validCredentialTransferCreate() {
        return request.auth != null
          && validCredentialTransferCode()
          && request.resource.data.keys().hasOnly([
            "ownerUid",
            "payload",
            "createdAt",
            "expiresAt",
            "consumed"
          ])
          && request.resource.data.keys().hasAll([
            "ownerUid",
            "payload",
            "createdAt",
            "expiresAt",
            "consumed"
          ])
          && request.auth.uid == request.resource.data.ownerUid
          && request.resource.data.payload is string
          && request.resource.data.payload.size() <= 200000
          && request.resource.data.payload.matches("^v1\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$")
          && request.resource.data.createdAt is timestamp
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.createdAt <= request.time
          && request.resource.data.createdAt > request.time - duration.value(5, "m")
          && request.resource.data.expiresAt > request.time
          && request.resource.data.expiresAt <= request.time + duration.value(24, "h")
          && request.resource.data.consumed == false;
      }

      allow create: if validCredentialTransferCreate();
      // Consumption is server-transaction-only via consumeCredentialTransfer.
      allow get: if false;
      allow update: if false;
      allow delete: if false;
      allow list: if false;
    }

    // --- Public read-only model-landscape metadata ---

    match /model_benchmark_snapshots/{snapshotId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /model_benchmark_source_status/{sourceId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // --- User-scoped data ---

    match /users/{userId} {
      allow read: if ownsUserNamespace(userId);
      allow write: if validRootUserProfileWrite(userId);
    }

    // Usage rows seal the project name into `sealedProjectName` (with an opaque
    // `projectKeyHash` trapdoor for client group-by). New writes are FAIL-CLOSED:
    // a `create` may never carry a cleartext `projectName`, so a writer with no
    // vault key omits the name rather than leaking it. Legacy rows that still
    // hold a plaintext name keep syncing on `update` only, and only while the
    // field already exists on the stored doc — no write may re-introduce one
    // (privacy-leak-remediation §1 / F6).
    match /users/{userId}/usage/{usageId} {
      allow read: if ownsUserNamespace(userId);
      allow create: if ownerWritableNonSecret(userId)
        && !("projectName" in request.resource.data)
        && (!("sealedProjectName" in request.resource.data) || validCloudSealedText(request.resource.data.sealedProjectName));
      allow update: if ownerWritableNonSecret(userId)
        && (!("projectName" in request.resource.data) || ("projectName" in resource.data))
        && (!("sealedProjectName" in request.resource.data) || validCloudSealedText(request.resource.data.sealedProjectName));
      allow delete: if ownsUserNamespace(userId);
    }

    // Budget rules: owner-scoped CRUD. Cross-device sync writes these from
    // macOS CloudBudgetService and iOS BudgetRulesStore. The project name and
    // label are sealed (`sealedProjectName`/`sealedLabel`). Same FAIL-CLOSED
    // contract as usage: `create` forbids cleartext `projectName`/`label`
    // outright; `update` tolerates a legacy plaintext field only while it
    // already exists on the stored doc (migration), never on a fresh write.
    match /users/{userId}/budgetRules/{ruleId} {
      allow read: if ownsUserNamespace(userId);
      allow create: if ownerWritableNonSecret(userId)
        && !("projectName" in request.resource.data)
        && !("label" in request.resource.data)
        && (!("sealedProjectName" in request.resource.data) || validCloudSealedText(request.resource.data.sealedProjectName))
        && (!("sealedLabel" in request.resource.data) || validCloudSealedText(request.resource.data.sealedLabel));
      allow update: if ownerWritableNonSecret(userId)
        && (!("projectName" in request.resource.data) || ("projectName" in resource.data))
        && (!("label" in request.resource.data) || ("label" in resource.data))
        && (!("sealedProjectName" in request.resource.data) || validCloudSealedText(request.resource.data.sealedProjectName))
        && (!("sealedLabel" in request.resource.data) || validCloudSealedText(request.resource.data.sealedLabel));
      allow delete: if ownsUserNamespace(userId);
    }

    // Budget events: append-only audit log. Clients create events but never
    // update or delete them — the history is immutable.
    match /users/{userId}/budgetEvents/{eventId} {
      function validBudgetEvent() {
        return request.resource.data.keys().hasOnly([
          "id",
          "ruleID",
          "kind",
          "source",
          "amountAtEvent",
          "limitAtEvent",
          "occurredAt",
          "syncedAt",
          "sourceDeviceID"
        ])
        && !("detailJSON" in request.resource.data)
        && request.resource.data.id is string
        && request.resource.data.id == eventId
        && request.resource.data.ruleID is string
        && request.resource.data.ruleID.size() <= 160
        && request.resource.data.kind in ["warning", "block", "override", "pause", "resume", "ruleCreated", "ruleUpdated", "ruleDeleted"]
        && (!("source" in request.resource.data) || (request.resource.data.source is string && request.resource.data.source.size() <= 80))
        && request.resource.data.amountAtEvent is number
        && request.resource.data.limitAtEvent is number
        && (!("sourceDeviceID" in request.resource.data) || (request.resource.data.sourceDeviceID is string && request.resource.data.sourceDeviceID.size() <= 160));
      }
      allow read: if ownsUserNamespace(userId);
      allow create: if ownerWritableNonSecret(userId) && validBudgetEvent();
    }

    match /users/{userId}/conversations/{conversationId} {
      function validConversationMirror() {
        return request.resource.data.keys().hasOnly([
          "id",
          "deviceId",
          "provider",
          "sessionId",
          "messageCount",
          "userWordCount",
          "assistantWordCount",
          "startTime",
          "endTime",
          "updatedAt",
          "sourceType",
          "version",
          "deletedAt",
          "contentSealed",
          "sealedSchemaVersion",
          "vaultKeyID",
          "sealedPayload"
        ])
        && !request.resource.data.keys().hasAny([
          "projectName",
          "keyFiles",
          "keyCommands",
          "keyTools",
          "inferredTaskTitle",
          "lastAssistantMessage",
          "workingDirectory",
          "summary",
          "summaryTitle",
          "summaryProvider",
          "summaryModel"
        ])
        && request.resource.data.id is string
        && request.resource.data.id.size() <= 512
        && request.resource.data.deviceId is string
        && request.resource.data.deviceId.size() <= 160
        && request.resource.data.provider is string
        && request.resource.data.provider.size() <= 80
        && request.resource.data.sessionId is string
        && request.resource.data.sessionId.size() <= 512
        && request.resource.data.messageCount is int
        && request.resource.data.messageCount >= 0
        && request.resource.data.messageCount <= 200000
        && request.resource.data.userWordCount is int
        && request.resource.data.userWordCount >= 0
        && request.resource.data.assistantWordCount is int
        && request.resource.data.assistantWordCount >= 0
        && (!("sourceType" in request.resource.data) || request.resource.data.sourceType is string)
        && (!("version" in request.resource.data) || request.resource.data.version is int)
        && request.resource.data.contentSealed == true
        && request.resource.data.sealedSchemaVersion == 2
        && validSealedPayloadForUser(userId, request.resource.data.vaultKeyID, request.resource.data.sealedPayload)
        && forbidsDirectSignalEnvelope();
      }
      allow read: if ownsUserNamespace(userId);
      allow create, update: if ownerWritableHostedCloudBackup(userId)
        && validConversationMirror();
      allow delete: if false;
    }

    match /users/{userId}/chat_threads/{threadId} {
      allow read: if ownsUserNamespace(userId);
      allow create, update: if ownerWritableChatThread(userId);
      allow delete: if ownsUserNamespace(userId);
    }

    match /users/{userId}/text_snippets/{snippetId} {
      allow read: if ownsUserNamespace(userId);
      allow create, update: if validTextSnippetDoc(userId, snippetId);
      allow delete: if ownsUserNamespace(userId);
    }

    // Mobile assistant chat history (Hermes + Pi conversations originated on
    // an iOS device). Owner-only with no entitlement gate — the same data is
    // also persisted on-device, so Firestore is the cross-device mirror.
    match /users/{userId}/mobile_assistant_chats/{threadId} {
      function validMobileAssistantChatMirror() {
        return request.resource.data.keys().hasOnly([
          "id",
          "runtime",
          "createdAt",
          "updatedAt",
          "messageCount",
          "contentSealed",
          "sealedSchemaVersion",
          "vaultKeyID",
          "sealedPayload",
          "labelColorHex",
          "isPinned",
          "priorityOrder",
          "lastMessageRole",
          "lastAssistantMessageID"
        ])
        && request.resource.data.id == threadId
        && request.resource.data.runtime in ["hermes", "pi", "piagent", "pi_agent", "codex", "claude", "openclaw", "antigravity", "droid", "factory", "forge", "grok", "cursorAgent", "cursoragent", "cursor_agent"]
        && request.resource.data.messageCount is int
        && request.resource.data.messageCount >= 0
        && request.resource.data.messageCount <= 5000
        && request.resource.data.contentSealed == true
        && request.resource.data.sealedSchemaVersion == 2
        && validSealedPayloadForUser(userId, request.resource.data.vaultKeyID, request.resource.data.sealedPayload)
        && (!("labelColorHex" in request.resource.data) || (request.resource.data.labelColorHex is string && request.resource.data.labelColorHex.size() <= 16))
        && (!("isPinned" in request.resource.data) || request.resource.data.isPinned is bool)
        && (!("priorityOrder" in request.resource.data) || request.resource.data.priorityOrder is int)
        && (!("lastMessageRole" in request.resource.data) || request.resource.data.lastMessageRole in ["user", "assistant", "system", "tool"])
        && (!("lastAssistantMessageID" in request.resource.data) || (request.resource.data.lastAssistantMessageID is string && request.resource.data.lastAssistantMessageID.size() <= 512))
        && forbidsSealedPlaintextContentFields()
        && forbidsDirectSignalEnvelope();
      }

      allow read: if ownsUserNamespace(userId);
      allow create, update: if ownerWritableNonSecret(userId)
        && validMobileAssistantChatMirror();
      allow delete: if ownsUserNamespace(userId);
    }

    // Mac CLI agent transcripts mirrored for the mobile Assistants tiles.
    match /users/{userId}/cli_sessions/{sessionId} {
      function validCliSessionMirror() {
        return request.resource.data.keys().hasOnly([
          "id",
          "agent",
          "sourceKind",
          "createdAt",
          "updatedAt",
          "endedAt",
          "schemaVersion",
          "contentSealed",
          "sealedSchemaVersion",
          "vaultKeyID",
          "sealedPayload",
          "messageCount",
          "lastMessageRole",
          "lastAssistantMessageID",
          "tokenUsage",
          "encryptedTranscriptAvailable",
          "labelColorHex",
          "isPinned",
          "priorityOrder"
        ])
        && request.resource.data.id == sessionId
        && request.resource.data.agent in ["codex", "claude", "openclaw", "antigravity", "droid", "forge", "grok", "cursorAgent", "cursoragent", "cursor_agent"]
        && (!("sourceKind" in request.resource.data) || request.resource.data.sourceKind in ["live_chat", "archived_log"])
        && request.resource.data.schemaVersion is int
        && request.resource.data.contentSealed == true
        && request.resource.data.sealedSchemaVersion == 2
        && validSealedPayloadForUser(userId, request.resource.data.vaultKeyID, request.resource.data.sealedPayload)
        && (!("messageCount" in request.resource.data) || (request.resource.data.messageCount is int && request.resource.data.messageCount >= 0 && request.resource.data.messageCount <= 5000))
        && (!("lastMessageRole" in request.resource.data) || request.resource.data.lastMessageRole in ["user", "assistant", "system", "tool"])
        && (!("lastAssistantMessageID" in request.resource.data) || (request.resource.data.lastAssistantMessageID is string && request.resource.data.lastAssistantMessageID.size() <= 512))
        && (!("encryptedTranscriptAvailable" in request.resource.data) || request.resource.data.encryptedTranscriptAvailable is bool)
        && (!("labelColorHex" in request.resource.data) || (request.resource.data.labelColorHex is string && request.resource.data.labelColorHex.size() <= 16))
        && (!("isPinned" in request.resource.data) || request.resource.data.isPinned is bool)
        && (!("priorityOrder" in request.resource.data) || request.resource.data.priorityOrder is int)
        && forbidsSealedPlaintextContentFields();
      }

      allow read: if ownsUserNamespace(userId);
      allow create, update: if ownerWritableNonSecret(userId)
        && validCliSessionMirror();
      allow delete: if ownsUserNamespace(userId);
    }

    // Mobile Insights mission dispatch. iOS/iPadOS/Android create pending
    // requests; the signed-in Mac claims them, runs the local agent, then
    // writes status and a small preview back for mobile.
    match /users/{userId}/cli_agent_mission_requests/{requestId} {
      function validCliMissionApprovalControls() {
        let approvalMode = request.resource.data.get("approvalMode", "existing_policy");
        let commandsAllowed = request.resource.data.get("commandsAllowed", false);
        let fileEditsAllowed = request.resource.data.get("fileEditsAllowed", false);
        return approvalMode in ["existing_policy", "manual_all", "risky_only", "read_only"]
          && commandsAllowed is bool
          && fileEditsAllowed is bool
          && (
            approvalMode != "read_only"
            || (
              commandsAllowed == false
              && fileEditsAllowed == false
            )
          );
      }

      function validCliAgentMissionRequest() {
        return request.resource.data.keys().hasOnly([
          "id",
          "missionKind",
          "requestedRuntime",
          "requestedModelID",
          "depth",
          "approvalMode",
          "commandsAllowed",
          "fileEditsAllowed",
          "source",
          "sourceSkillID",
          "sourceSurface",
          "deliveryMode",
          "parentHermesThreadID",
          "status",
          "createdAt",
          "updatedAt",
          "startedAt",
          "completedAt",
          "claimedBy",
          "selectedRuntime",
          "selectedRuntimeName",
          "selectedModelID",
          "sessionId",
          "approvalRequestId",
          "approvalStatus",
          "approvalRequestedAt",
          "approvalRespondedAt",
          "lastEventSequence",
          "schemaVersion",
          // Hermes Square Phase B — group + persona hints. All optional;
          // server-side enforcement still pins the existing-field invariants.
          "groupID",
          "siblingIndex",
          "siblingCount",
          "isGroupChild",
          "personaID",
          "clientThreadID",
          "parentSessionID",
          "resumeAction",
          "contentSealed",
          "sealedSchemaVersion",
          "vaultKeyID",
          "sealedPayload",
          "sealedStatePayload",
          "sealedStateSchemaVersion",
          "sealedStateVaultKeyID",
          "approvedByDeviceId"
        ])
        && request.resource.data.id is string
        && request.resource.data.id.size() <= 512
        && request.resource.data.contentSealed == true
        && request.resource.data.sealedSchemaVersion == 2
        && validSealedPayloadForUser(userId, request.resource.data.vaultKeyID, request.resource.data.sealedPayload)
        && (!("sealedStatePayload" in request.resource.data) || (
          request.resource.data.sealedStateSchemaVersion == 1
          && validSealedPayloadForUser(userId, request.resource.data.sealedStateVaultKeyID, request.resource.data.sealedStatePayload)
        ))
        && request.resource.data.missionKind in ["debt", "diligence", "creative", "accretive", "security", "ui_improvement", "modernization", "provider_routing", "cost_efficiency", "project_focus", "custom", "chat"]
        && request.resource.data.requestedRuntime in ["auto", "codex", "claude", "hermes", "openclaw", "piAgent", "pi", "opencode", "ollama", "antigravity", "droid", "forge", "grok", "cursorAgent", "cursoragent", "cursor_agent"]
        && request.resource.data.source in ["ios-insights", "android-insights", "mac-insights", "ios-chat", "android-chat"]
        && (!("deliveryMode" in request.resource.data) || request.resource.data.deliveryMode in ["action_only", "full_stream", "muted"])
        && request.resource.data.status in ["pending", "queued", "accepted", "starting", "running", "waiting_for_approval", "completed", "failed", "canceled", "cancelled", "mac_offline", "unauthorized", "agent_launch_failed", "vault_key_unavailable"]
        && request.resource.data.schemaVersion is int
        && (!("depth" in request.resource.data) || request.resource.data.depth in ["light", "standard", "deep", "max"])
        && validCliMissionApprovalControls()
        && (!("claimedBy" in request.resource.data) || (request.resource.data.claimedBy is string && request.resource.data.claimedBy.size() <= 256))
        && (!("selectedRuntime" in request.resource.data) || request.resource.data.selectedRuntime in ["codex", "claude", "hermes", "openclaw", "piAgent", "pi", "opencode", "ollama", "antigravity", "droid", "forge", "grok", "cursorAgent", "cursoragent", "cursor_agent"])
        && (!("approvalStatus" in request.resource.data) || request.resource.data.approvalStatus in ["pending", "approved", "rejected", "canceled", "cancelled"])
        && (!("approvedByDeviceId" in request.resource.data) || (request.resource.data.approvedByDeviceId is string && request.resource.data.approvedByDeviceId.size() <= 160))
        && (!("lastEventSequence" in request.resource.data) || request.resource.data.lastEventSequence is int)
        && (!("siblingIndex" in request.resource.data) || (request.resource.data.siblingIndex is int && request.resource.data.siblingIndex >= 0 && request.resource.data.siblingIndex < 16))
        && (!("siblingCount" in request.resource.data) || (request.resource.data.siblingCount is int && request.resource.data.siblingCount > 0 && request.resource.data.siblingCount <= 16))
        && (!("isGroupChild" in request.resource.data) || request.resource.data.isGroupChild is bool)
        && (!("resumeAction" in request.resource.data) || request.resource.data.resumeAction in ["new", "resume", "fork", "forward"])
        && forbidsSealedPlaintextContentFields()
        && forbidsDirectSignalEnvelope();
      }

      function validCliAgentMissionCreate() {
        return request.resource.data.status == "pending"
          && !request.resource.data.keys().hasAny([
            "startedAt",
            "completedAt",
            "claimedBy",
            "selectedRuntime",
            "selectedRuntimeName",
            "selectedModelID",
            "sessionId",
            "approvalRequestId",
            "approvalStatus",
            "approvalRequestedAt",
            "approvalRespondedAt",
            "approvedByDeviceId",
            "lastEventSequence",
            "sealedStatePayload",
            "sealedStateSchemaVersion",
            "sealedStateVaultKeyID"
          ]);
      }

      function trustedMissionExecutorDevice(userId) {
        return ("claimedBy" in request.resource.data)
          && exists(/databases/$(database)/documents/users/$(userId)/escrow_devices/$(request.resource.data.claimedBy))
          && get(/databases/$(database)/documents/users/$(userId)/escrow_devices/$(request.resource.data.claimedBy)).data.trustState == "trusted"
          && get(/databases/$(database)/documents/users/$(userId)/escrow_devices/$(request.resource.data.claimedBy)).data.platform == "macOS";
      }

      function validTrustedMissionHostUpdate(userId) {
        return trustedMissionExecutorDevice(userId)
          && (!("claimedBy" in resource.data) || request.resource.data.claimedBy == resource.data.claimedBy)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["events"])
          // The trusted Mac host may REQUEST approval (approvalStatus "pending")
          // but must NOT RESOLVE it. Flipping approvalStatus to approved/rejected
          // is the human decision and must flow through the App-Check-enforced
          // respondMissionApproval callable (Admin SDK) or the device-bound
          // validMobileMissionApprovalResponse path — never a bare host write.
          // Without this, the host branch would let any owner-auth client
          // self-approve a mission claimed by a trusted Mac, bypassing the
          // approvedByDeviceId binding below.
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["approvalStatus"])
              || !(request.resource.data.approvalStatus in ["approved", "rejected"]));
      }

      function validMobileMissionApprovalResponse() {
        // A client may CANCEL a pending approval request via Firestore, but may
        // NOT approve or reject it. Approval RESOLUTION (approved/rejected) is a
        // high-risk decision that must flow through the App-Check + attestation
        // enforced respondMissionApproval callable (Admin SDK), which stamps a
        // server-verified approvedByDeviceId and bypasses these rules. Keeping
        // resolution server-only makes client self-approval impossible at the
        // rules layer and keeps this rule cheap (escrow_devices get()/exists()
        // here otherwise pushed the mission-update rule past Firestore's
        // 1000-expression evaluation limit). The trusted-host branch is likewise
        // barred from resolving (see validTrustedMissionHostUpdate).
        return resource.data.status == "waiting_for_approval"
          && request.resource.data.status == "waiting_for_approval"
          && request.resource.data.approvalStatus in ["canceled", "cancelled"]
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "approvalStatus",
            "approvalRespondedAt",
            "contentSealed",
            "sealedStatePayload",
            "sealedStateSchemaVersion",
            "sealedStateVaultKeyID",
            "updatedAt"
          ]);
      }

      function validMissionRefusalOrFailureUpdate() {
        return resource.data.status in ["unauthorized", "failed", "canceled", "cancelled"]
          && request.resource.data.status == resource.data.status
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "lastEventSequence",
            "contentSealed",
            "sealedStatePayload",
            "sealedStateSchemaVersion",
            "sealedStateVaultKeyID",
            "updatedAt"
          ]);
      }

      // The owner device that dispatched a mission can cancel it from the phone
      // before (or while) the Mac picks it up. The cancel transition flips
      // status to "cancelled" and may carry only sealed state fields (the iOS
      // CLIAgentMissionDispatcher seals a "Mission cancelled by user." live
      // summary into sealedStatePayload — never a plaintext liveSummary). Any
      // other key change (or a plaintext summary) falls through and is denied.
      function validMobileMissionCancel() {
        return request.resource.data.status == "cancelled"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "status",
            "contentSealed",
            "sealedStatePayload",
            "sealedStateSchemaVersion",
            "sealedStateVaultKeyID",
            "updatedAt"
          ]);
      }

      function trustedMissionExecutorClaim(userId, requestId) {
        return exists(/databases/$(database)/documents/users/$(userId)/cli_agent_mission_requests/$(requestId))
          && ("claimedBy" in get(/databases/$(database)/documents/users/$(userId)/cli_agent_mission_requests/$(requestId)).data)
          && exists(/databases/$(database)/documents/users/$(userId)/escrow_devices/$(get(/databases/$(database)/documents/users/$(userId)/cli_agent_mission_requests/$(requestId)).data.claimedBy))
          && get(/databases/$(database)/documents/users/$(userId)/escrow_devices/$(get(/databases/$(database)/documents/users/$(userId)/cli_agent_mission_requests/$(requestId)).data.claimedBy)).data.trustState == "trusted"
          && get(/databases/$(database)/documents/users/$(userId)/escrow_devices/$(get(/databases/$(database)/documents/users/$(userId)/cli_agent_mission_requests/$(requestId)).data.claimedBy)).data.platform == "macOS";
      }

      function validCliAgentMissionEventSource(userId, requestId, eventId) {
        return (
            request.resource.data.source in ["ios", "android", "ios-chat", "android-chat"]
            && request.resource.data.phase == "queued"
            && request.resource.data.kind == "status"
            && request.resource.data.sequence == 1
            && eventId == "000001"
          )
          || (
            request.resource.data.source == "mac"
            && trustedMissionExecutorClaim(userId, requestId)
          );
      }

      allow read: if ownsUserNamespace(userId);
      allow create: if ownerWritableNonSecret(userId)
        && validCliAgentMissionRequest()
        && validCliAgentMissionCreate();
      allow update: if ownerWritableNonSecret(userId)
        && validCliAgentMissionRequest()
        && (
          validTrustedMissionHostUpdate(userId)
          || validMobileMissionApprovalResponse()
          || validMissionRefusalOrFailureUpdate()
          || validMobileMissionCancel()
        );
      allow delete: if false;

      match /events/{eventId} {
        allow read: if ownsUserNamespace(userId);
        allow create: if ownerWritableNonSecret(userId)
          && request.resource.data.keys().hasOnly([
            "sequence",
            "timestamp",
            "kind",
            "phase",
            "title",
            "message",
            "fullMessage",
            "messageLength",
            "messageTruncated",
            "runtime",
            "source",
            "sourceSkillID",
            "deliveryMode",
            "eventImportance",
            "skillStepID",
            "toolName",
            "artifactPath",
            "changedFilePath",
            "isError",
            "contentSealed",
            "sealedSchemaVersion",
            "vaultKeyID",
            "sealedPayload"
          ])
          && !request.resource.data.keys().hasAny([
            "title",
            "message",
            "fullMessage",
            "toolName",
            "artifactPath",
            "changedFilePath"
          ])
          && request.resource.data.contentSealed == true
          && request.resource.data.sealedSchemaVersion == 2
          && validSealedPayloadForUser(userId, request.resource.data.vaultKeyID, request.resource.data.sealedPayload)
          && request.resource.data.sequence is int
          && request.resource.data.sequence >= 1
          && request.resource.data.timestamp is string
          && request.resource.data.timestamp.size() <= 80
          && request.resource.data.kind in ["status", "llm_response", "assistant_message", "tool_call", "tool_result", "error", "approval_request", "artifact", "changed_file", "final_answer"]
          && request.resource.data.phase in ["queued", "accepted", "claimed", "starting", "running", "streaming", "assistant_response", "tool_use", "tool_result", "waiting_for_approval", "approval_requested", "approval_resolved", "artifact", "changed_file", "completed", "failed", "canceled", "cancelled", "mac_offline", "unauthorized", "agent_launch_failed", "process_started", "process_running"]
          && (!("messageLength" in request.resource.data) || (
            request.resource.data.messageLength is int
            && request.resource.data.messageLength <= 24000
          ))
          && (!("messageTruncated" in request.resource.data) || request.resource.data.messageTruncated is bool)
          && request.resource.data.source in ["ios", "android", "ios-chat", "android-chat", "mac"]
          && (!("sourceSkillID" in request.resource.data) || (request.resource.data.sourceSkillID is string && request.resource.data.sourceSkillID.size() <= 80))
          && (!("deliveryMode" in request.resource.data) || request.resource.data.deliveryMode in ["action_only", "full_stream", "muted"])
          && (!("eventImportance" in request.resource.data) || request.resource.data.eventImportance in ["quiet", "normal", "action_required", "terminal"])
          && (!("skillStepID" in request.resource.data) || (request.resource.data.skillStepID is string && request.resource.data.skillStepID.size() <= 80))
          && validCliAgentMissionEventSource(userId, requestId, eventId)
          && request.resource.data.isError is bool
          && (!("runtime" in request.resource.data) || request.resource.data.runtime in ["codex", "claude", "hermes", "openclaw", "piAgent", "pi", "opencode", "ollama", "auto", "antigravity", "droid", "forge", "grok", "cursorAgent", "cursoragent", "cursor_agent"])
          ;
        allow update, delete: if false;
      }
    }

    // Mobile-triggered agent history imports. Phones create pending jobs;
    // only a trusted macOS escrow device can claim/update scan progress and
    // results. Imported transcript bodies still flow through session_logs.
    match /users/{userId}/agent_import_jobs/{jobId} {
      function trustedAgentImportMac(userId) {
        return ("claimedBy" in request.resource.data)
          && exists(/databases/$(database)/documents/users/$(userId)/escrow_devices/$(request.resource.data.claimedBy))
          && get(/databases/$(database)/documents/users/$(userId)/escrow_devices/$(request.resource.data.claimedBy)).data.trustState == "trusted"
          && get(/databases/$(database)/documents/users/$(userId)/escrow_devices/$(request.resource.data.claimedBy)).data.platform == "macOS";
      }

      function validAgentImportJob() {
        return request.resource.data.keys().hasOnly([
          "id", "selectedHarnesses", "status", "source", "createdAt",
          "updatedAt", "startedAt", "completedAt", "claimedBy",
          "progressMessage", "scannedCount", "importedCount",
          "mirroredSessionCount", "uploadedSessionLogCount",
          "errorMessage", "schemaVersion"
        ])
        && request.resource.data.id is string
        && request.resource.data.id.size() <= 512
        && request.resource.data.selectedHarnesses is list
        && request.resource.data.selectedHarnesses.size() > 0
        && request.resource.data.selectedHarnesses.size() <= 32
        && request.resource.data.status in ["pending", "claimed", "scanning", "uploading", "completed", "failed", "canceled", "cancelled"]
        && request.resource.data.source in ["ios-import", "android-import", "mac-import"]
        && request.resource.data.schemaVersion is int
        && (!("claimedBy" in request.resource.data) || (request.resource.data.claimedBy is string && request.resource.data.claimedBy.size() <= 256))
        && (!("progressMessage" in request.resource.data) || (request.resource.data.progressMessage is string && request.resource.data.progressMessage.size() <= 2048))
        && (!("errorMessage" in request.resource.data) || (request.resource.data.errorMessage is string && request.resource.data.errorMessage.size() <= 2048))
        && (!("scannedCount" in request.resource.data) || request.resource.data.scannedCount is int)
        && (!("importedCount" in request.resource.data) || request.resource.data.importedCount is int)
        && (!("mirroredSessionCount" in request.resource.data) || request.resource.data.mirroredSessionCount is int)
        && (!("uploadedSessionLogCount" in request.resource.data) || request.resource.data.uploadedSessionLogCount is int);
      }

      function validAgentImportCreate() {
        return request.resource.data.status == "pending"
          && !("claimedBy" in request.resource.data)
          && !("startedAt" in request.resource.data)
          && !("completedAt" in request.resource.data)
          && !("errorMessage" in request.resource.data);
      }

      function validTrustedAgentImportUpdate(userId) {
        return trustedAgentImportMac(userId)
          && (!("claimedBy" in resource.data) || request.resource.data.claimedBy == resource.data.claimedBy);
      }

      allow read: if ownsUserNamespace(userId);
      allow create: if ownerWritableNonSecret(userId)
        && validAgentImportJob()
        && validAgentImportCreate();
      allow update: if ownerWritableNonSecret(userId)
        && validAgentImportJob()
        && validTrustedAgentImportUpdate(userId);
      allow delete: if ownsUserNamespace(userId);
    }

    // Hermes Square Phase B — mission groups (fan-out parent). Owner writes
    // the parent document at dispatch, the Mac listener stamps phase
    // transitions, the phone observes both.
    match /users/{userId}/mission_groups/{groupId} {
      function validMissionGroup() {
        return request.resource.data.keys().hasOnly([
          "id", "title", "prompt", "missionKind", "targetProject",
          "childMissionIDs", "runtimeTokens", "parallelismLimit",
          "mergeStrategy", "phase", "winnerMissionID",
          "forecast", "createdAt", "updatedAt", "schemaVersion", "source",
          "synthesisSummary",
          "contentSealed", "sealedSchemaVersion", "vaultKeyID", "sealedPayload",
          "sealedStatePayload", "sealedStateSchemaVersion", "sealedStateVaultKeyID"
        ])
        && !request.resource.data.keys().hasAny(["title", "prompt", "targetProject", "synthesisSummary"])
        && request.resource.data.contentSealed == true
        && request.resource.data.sealedSchemaVersion == 2
        && validSealedPayloadForUser(userId, request.resource.data.vaultKeyID, request.resource.data.sealedPayload)
        && (!("sealedStatePayload" in request.resource.data) || (
          request.resource.data.sealedStateSchemaVersion == 1
          && validSealedPayloadForUser(userId, request.resource.data.sealedStateVaultKeyID, request.resource.data.sealedStatePayload)
        ))
        && request.resource.data.childMissionIDs is list
        && request.resource.data.childMissionIDs.size() <= 16
        && request.resource.data.runtimeTokens is list
        && request.resource.data.runtimeTokens.size() <= 16
        && request.resource.data.parallelismLimit is int
        && request.resource.data.parallelismLimit >= 1
        && request.resource.data.parallelismLimit <= 16
        && request.resource.data.mergeStrategy in ["pick_one", "keep_all", "synthesize"]
        && request.resource.data.phase in ["queued", "fanning_out", "awaiting_merge", "merged", "cancelled", "failed"]
        && request.resource.data.schemaVersion is int;
      }
      allow read: if ownsUserNamespace(userId);
      allow create, update: if ownerWritableNonSecret(userId) && validMissionGroup();
      allow delete: if ownsUserNamespace(userId);
    }

    // Hermes Square Phase B — class-based approval policies. Phone writes,
    // phone reads. Synced across devices via the user namespace. The display
    // label, file glob, and target project are sealed into
    // `sealedDisplayLabel`/`sealedFileGlob`/`sealedTargetProject` (with opaque
    // `projectKeyHash`/`fileGlobHash` trapdoors for client-side bucketing); the
    // doc ID itself becomes an opaque keyed hash. New writes require v2 sealed
    // fields bound by AAD to this exact user/doc/field path. Legacy plaintext
    // rows remain readable but may not be re-created through client rules.
    match /users/{userId}/approval_policies/{policyId} {
      function validApprovalPolicy() {
        return request.resource.data.keys().hasOnly([
          "decision", "missionKind", "toolName", "runtimeID",
          "sealedDisplayLabel", "sealedFileGlob", "sealedTargetProject",
          "projectKeyHash", "fileGlobHash",
          "createdAt", "expiresAt", "matchCount", "schemaVersion"
        ])
        && request.resource.data.decision in ["approve", "deny"]
        && request.resource.data.schemaVersion is int
        && request.resource.data.schemaVersion >= 2
        && validCloudSealedTextAt(userId, "approval_policies", policyId, "sealedDisplayLabel", request.resource.data.sealedDisplayLabel)
        && (!("missionKind" in request.resource.data) || request.resource.data.missionKind is string)
        && (!("toolName" in request.resource.data) || request.resource.data.toolName is string)
        && (!("runtimeID" in request.resource.data) || request.resource.data.runtimeID is string)
        && (!("sealedFileGlob" in request.resource.data) || validCloudSealedTextAt(userId, "approval_policies", policyId, "sealedFileGlob", request.resource.data.sealedFileGlob))
        && (!("sealedTargetProject" in request.resource.data) || validCloudSealedTextAt(userId, "approval_policies", policyId, "sealedTargetProject", request.resource.data.sealedTargetProject))
        && (!("projectKeyHash" in request.resource.data) || request.resource.data.projectKeyHash.matches("^[a-f0-9]{32}$"))
        && (!("fileGlobHash" in request.resource.data) || request.resource.data.fileGlobHash.matches("^[a-f0-9]{32}$"))
        && (!("matchCount" in request.resource.data) || request.resource.data.matchCount is int);
      }
      allow read: if ownsUserNamespace(userId);
      allow create, update: if ownerWritableNonSecret(userId) && validApprovalPolicy();
      allow delete: if ownsUserNamespace(userId);
    }

    // Hermes Square Phase C — rollback requests. Phone submits, Mac claims
    // and resolves. Snapshots themselves live under cli_sessions/{id}/snapshots.
    // The scope JSON (carries absolute file paths for singleFile scope) and the
    // Mac-written error diagnostic are sealed into `sealedScope`/
	    // `sealedErrorMessage`; new client writes are sealed-only. Legacy plaintext
	    // rows remain readable but may not be re-created through client rules
	    // (privacy-leak-remediation).
	    match /users/{userId}/rollback_requests/{requestId} {
	      function validRollbackRequest() {
	        return request.resource.data.keys().hasOnly([
	          "id", "sessionID", "sealedScope", "requestedAt", "requestedBy",
	          "status", "resolvedAt", "sealedErrorMessage", "schemaVersion", "source"
	        ])
	        && request.resource.data.sessionID is string
	        && request.resource.data.sessionID.size() <= 256
	        && validCloudSealedText(request.resource.data.sealedScope)
	        && (!("sealedErrorMessage" in request.resource.data) || validCloudSealedText(request.resource.data.sealedErrorMessage))
	        && request.resource.data.status in ["pending", "in_flight", "completed", "failed", "cancelled"];
      }
      allow read: if ownsUserNamespace(userId);
      allow create, update: if ownerWritableNonSecret(userId) && validRollbackRequest();
      allow delete: if ownsUserNamespace(userId);
    }

    // Hermes Square Phase A — per-session rollback snapshot index. Mac
    // writes (claimed device only); phone reads for the rollback picker.
    // No live writer ships today, so the action label, touched-file paths, and
    // Mac filesystem path are sealed-only from day one: the plaintext keys are
    // hard-dropped from the allowlist and the values live in
    // `sealedActionLabel`/`sealedTouchedFiles`/`sealedMacSnapshotPath`
    // (sealedTouchedFiles is the whole [String] array sealed as one
    // CloudVaultSealedText) — privacy-leak-remediation.
    match /users/{userId}/cli_sessions/{sessionId}/snapshots/{snapshotId} {
      function validRollbackSnapshot() {
        return request.resource.data.keys().hasOnly([
          "id", "sessionID", "sequence", "takenAt",
          "sealedActionLabel", "sealedTouchedFiles", "sealedMacSnapshotPath",
          "restoredAt", "schemaVersion"
	        ])
	        && request.resource.data.sequence is int
	        && request.resource.data.sequence >= 0
	        && validCloudSealedText(request.resource.data.sealedActionLabel)
	        && (!("sealedTouchedFiles" in request.resource.data) || validCloudSealedText(request.resource.data.sealedTouchedFiles))
	        && (!("sealedMacSnapshotPath" in request.resource.data) || validCloudSealedText(request.resource.data.sealedMacSnapshotPath));
      }
      allow read: if ownsUserNamespace(userId);
      allow create, update: if ownerWritableNonSecret(userId) && validRollbackSnapshot();
      allow delete: if ownsUserNamespace(userId);
    }

    // Hermes Square Phase A/B — user-installed agent identities + persona
    // overrides. Phone-only writes. Cached locally; cloud copy survives
    // re-install. No live cloud writer ships today, so the sealed contract is
    // forward-declared: identity/persona free-text (displayName, tagline, and
    // the whole personas[] array) is sealed into
    // `sealedDisplayName`/`sealedTagline`/`sealedPersonas` and cleartext copies
    // are rejected outright (no legacy migration window) —
    // privacy-leak-remediation.
    match /users/{userId}/agent_identities/{identityId} {
      function validAgentIdentity() {
        return request.resource.data.keys().hasOnly([
          "id", "runtimeID", "glyph", "paletteHex", "tier", "availability",
          "installSource", "capabilities", "dispatchTransport",
          "lastSevenDays", "lastRefreshedAt",
          "sealedDisplayName", "sealedTagline", "sealedPersonas", "updatedAt"
        ])
        && (!("sealedDisplayName" in request.resource.data) || validCloudSealedText(request.resource.data.sealedDisplayName))
        && (!("sealedTagline" in request.resource.data) || validCloudSealedText(request.resource.data.sealedTagline))
        && (!("sealedPersonas" in request.resource.data) || validCloudSealedText(request.resource.data.sealedPersonas))
        && !("displayName" in request.resource.data)
        && !("tagline" in request.resource.data)
        && !("personas" in request.resource.data);
      }
      allow read: if ownsUserNamespace(userId);
      allow create, update: if ownerWritableNonSecret(userId) && validAgentIdentity();
      allow delete: if ownsUserNamespace(userId);
    }

	    // Hermes Square Phase A — subscription topics with per-template consent.
	    // The graph edge itself (which agent/topic the user follows) is sealed into
	    // `sealedAgentURI`/`sealedTopicID`; display text is sealed into
	    // `sealedDisplayName`/`sealedDescription`; the doc ID is an opaque keyed
	    // hash. New writes are sealed-only. merge:true partial writes
	    // (setMuted/setDeliveryMode) pass only against already-sealed documents
	    // because request.resource.data is the post-write document —
	    // privacy-leak-remediation.
	    match /users/{userId}/subscription_topics/{topicId} {
	      allow read: if ownsUserNamespace(userId);
	      allow create, update: if ownerWritableNonSecret(userId)
	        && request.resource.data.keys().hasOnly([
	          "sealedAgentURI", "sealedTopicID", "sealedDisplayName", "sealedDescription",
	          "cadence", "consentGivenAt", "isMuted", "deliveryMode",
	          "minimumEventImportance", "deliveryCountThisMonth", "lastDeliveredAt", "updatedAt"
	        ])
	        && validCloudSealedText(request.resource.data.sealedAgentURI)
	        && validCloudSealedText(request.resource.data.sealedTopicID)
	        && validCloudSealedText(request.resource.data.sealedDisplayName)
	        && validCloudSealedText(request.resource.data.sealedDescription)
	        && (!("cadence" in request.resource.data) || request.resource.data.cadence in ["on_demand", "daily", "weekly", "monthly"])
        && (!("deliveryMode" in request.resource.data) || request.resource.data.deliveryMode in ["action_only", "full_stream", "muted"])
        && (!("minimumEventImportance" in request.resource.data) || request.resource.data.minimumEventImportance in ["quiet", "normal", "action_required", "terminal"])
        && (!("deliveryCountThisMonth" in request.resource.data) || (request.resource.data.deliveryCountThisMonth is int && request.resource.data.deliveryCountThisMonth <= 64));
      allow delete: if ownsUserNamespace(userId);
    }

    match /users/{userId}/session_logs/{logId} {
      allow read: if ownsUserNamespace(userId);
      allow create, update: if ownerWritableSessionLogManifest(userId);
      allow delete: if ownsUserNamespace(userId);

	      match /chunks/{chunkId} {
	        allow read: if ownsUserNamespace(userId);
	        allow create, update: if false;
	        allow delete: if ownsUserNamespace(userId);
	      }
    }

    // Encrypted per-project memory snapshots (privacy-leak-remediation §2). The
    // human-readable project name now lives ONLY inside the sealed `sealedSnapshot`
    // blob, and the doc is keyed by an opaque, vault-key-derived `docID` — the
    // server never learns the project's name or slug. These rows are written
    // server-side today by `commitEncryptedProjectMemorySnapshot` (Admin SDK,
    // which bypasses these rules); the allowlist below documents the hardened
    // contract and fences any future direct client write. Plaintext
    // `projectDisplayName`/`projectSlug` are rejected outright.
    match /users/{userId}/project_memory_snapshots/{docID} {
      function validProjectMemorySnapshotKeys() {
        return request.resource.data.keys().hasOnly([
          "docID",
          "contentHash",
          "contentHashVersion",
          "sourceSessionCount",
          "sourceConversationCount",
          "generatedAt",
          "freshness",
          "visualKinds",
          "sealedSnapshot",
          "encryption",
          "schemaVersion",
          "updatedAt"
        ]);
      }
      allow read: if ownsUserNamespace(userId);
      allow create, update: if ownerWritableNonSecret(userId)
        && hasActiveHostedQuotaEntitlement(userId)
        && validProjectMemorySnapshotKeys()
        && !("projectDisplayName" in request.resource.data)
        && !("projectSlug" in request.resource.data)
        && (!("docID" in request.resource.data) || request.resource.data.docID == docID)
        && (!("freshness" in request.resource.data) || request.resource.data.freshness in ["fresh", "needsRefresh", "stale"])
        && (!("visualKinds" in request.resource.data) || (request.resource.data.visualKinds is list && request.resource.data.visualKinds.size() <= 24))
        && (!("encryption" in request.resource.data) || request.resource.data.encryption is map)
        && validCloudSealedBlob(
          request.resource.data.sealedSnapshot,
          cloudVaultAADContext(userId, "project_memory_snapshots", docID, "sealedSnapshot")
        )
        && request.resource.data.schemaVersion is int
        && request.resource.data.schemaVersion >= 2;
      allow delete: if ownsUserNamespace(userId);
    }

    match /users/{userId}/cloud_search_documents/{documentId} {
      allow read: if ownsUserNamespace(userId);
      allow create, update: if false
        && request.resource.data.keys().hasOnly([
          "uid",
          "documentID",
          "deviceId",
          "sourceKind",
          "sourceID",
          "sourceVersionID",
          "provider",
          "bodyHash",
          "bodyHashVersion",
          "storagePath",
          "sealedTitle",
          "sealedBodyPreview",
          "byteCount",
          "encryptedByteCount",
          "indexVersion",
          "tokenHashVersion",
          "semanticHashVersion",
          "updatedAt",
          "schemaVersion"
        ])
        && request.resource.data.uid == userId
        && request.resource.data.documentID == documentId
        && validCloudSessionStoragePath(userId, documentId, request.resource.data.bodyHash, request.resource.data.storagePath)
        && validCloudSealedText(request.resource.data.sealedTitle)
        && validCloudSealedText(request.resource.data.sealedBodyPreview)
        && request.resource.data.byteCount is int
        && request.resource.data.byteCount >= 0
        && request.resource.data.encryptedByteCount is int
        && request.resource.data.encryptedByteCount >= 1
        && request.resource.data.encryptedByteCount < 10 * 1024 * 1024
        && !("title" in request.resource.data)
        && !("snippet" in request.resource.data)
        && !("body" in request.resource.data)
        && !("text" in request.resource.data);
      allow delete: if ownsUserNamespace(userId);
    }

    match /users/{userId}/cloud_search_chunks/{chunkId} {
      allow read: if ownsUserNamespace(userId);
      // Search chunks are server-owned. Clients submit encrypted chunks through
      // commitEncryptedSearchIndexBatch, where trusted code validates every
      // token/semantic hash before Admin SDK writes this collection.
      allow create, update: if false;
      allow delete: if ownsUserNamespace(userId);
    }

    match /users/{userId}/cloud_search_postings/{postingId} {
      allow read: if ownsUserNamespace(userId);
      allow create, update: if false
        && request.resource.data.keys().hasOnly([
          "uid",
          "postingKey",
          "edgeID",
          "kind",
          "hash",
          "chunkID",
          "documentID",
          "provider",
          "updatedAt",
          "indexVersion",
          "schemaVersion"
        ])
        && request.resource.data.uid == userId
        && request.resource.data.edgeID == postingId
        && request.resource.data.kind in ["token", "semantic"]
        && request.resource.data.hash is string
        && request.resource.data.hash.matches("^[a-f0-9]{32}$")
        && request.resource.data.postingKey == request.resource.data.kind + "_" + request.resource.data.hash
        && request.resource.data.chunkID is string
        && request.resource.data.chunkID.size() <= 512
        && request.resource.data.edgeID == request.resource.data.postingKey + "_" + request.resource.data.chunkID
        && request.resource.data.documentID is string
        && request.resource.data.documentID.size() <= 512
        && (!("provider" in request.resource.data) || (request.resource.data.provider is string && request.resource.data.provider.size() <= 80))
        && !("title" in request.resource.data)
        && !("snippet" in request.resource.data)
        && !("body" in request.resource.data)
        && !("text" in request.resource.data);
      allow delete: if ownsUserNamespace(userId);
    }

    match /users/{userId}/cloud_search_index_state/{deviceId} {
      allow read: if ownsUserNamespace(userId);
      allow create, update: if false
        && request.resource.data.uid == userId
        && request.resource.data.deviceId == deviceId;
      allow delete: if ownsUserNamespace(userId);
    }

    match /users/{userId}/cloud_search_index_manifest/{manifestId} {
      allow read: if ownsUserNamespace(userId);
      allow write: if false;
    }

    // Pensieve E2EE knowledge memory. Vectors + sealed envelopes are written
    // ONLY by the commitKnowledgeBatch callable (admin SDK, which validates the
    // Cloud Pro entitlement + tier caps). The client may read its own ciphertext
    // for defence in depth; recall actually flows through the hosted MCP shim.
    match /users/{userId}/cloud_search_knowledge/{vectorId} {
      allow read: if ownsUserNamespace(userId);
      allow write: if false;
    }

    // Pensieve sync manifests (no plaintext): chunk/byte counts + sync health,
    // written by the knowledgeMemory callables. Owner-readable for the UI.
    match /users/{userId}/knowledge_sync_manifests/{sourceManifestId} {
      allow read: if ownsUserNamespace(userId);
      allow write: if false;

      match /entries/{entryKey} {
        allow read: if ownsUserNamespace(userId);
        allow write: if false;
      }
    }

    // Connected GitHub repo registry (the dirty-signal source registration). The
    // repo identity is project-class private text: rows are written by the
    // connectKnowledgeRepo callable (Admin SDK, which bypasses these rules) and
    // hold only an opaque server-keyed `repoMatchToken` (for webhook routing),
    // an opaque server-keyed `sourceManifestId` (the manifest doc-id key —
    // replaces the transitional `sourceSlugToken` and formerly-stored cleartext
    // `sourceSlug`), and a vault-`sealedRepoFullName`
    // (for owner-only display). A direct client write is now constrained to that
    // opaque shape by a STRICT allowlist: no arbitrary smuggled fields, opaque
    // 64-hex `repoMatchToken`/`sourceManifestId`, an owner-only `sealedRepoFullName`,
    // and an explicit ban on every deprecated or cleartext repo identity
    // (`repoFullName`/`sourcePath`/`sourceSlug`/`sourceSlugToken`) so a future/buggy client can never reintroduce
    // reversible path/name text (F5). The cleartext name + cleartext slug are
    // observed server-side only transiently (webhook routing / token derivation),
    // never stored.
    match /users/{userId}/knowledge_repos/{repoId} {
      function validKnowledgeRepoKeys() {
        return request.resource.data.keys().hasOnly([
          "uid",
          "repoId",
          "repoMatchToken",
          "sourceManifestId",
          "sealedRepoFullName",
          "installId",
          "connectedAt",
          "schemaVersion"
        ]);
      }
      allow read: if ownsUserNamespace(userId);
      allow create, update: if ownerWritableNonSecret(userId)
        && validKnowledgeRepoKeys()
        && !("repoFullName" in request.resource.data)
        && !("sourcePath" in request.resource.data)
        && !("sourceSlug" in request.resource.data)
        && !("sourceSlugToken" in request.resource.data)
        && (!("uid" in request.resource.data) || request.resource.data.uid == userId)
        && (!("repoMatchToken" in request.resource.data)
            || (request.resource.data.repoMatchToken is string
                && request.resource.data.repoMatchToken.matches("^[a-f0-9]{64}$")))
        && (!("sourceManifestId" in request.resource.data)
            || (request.resource.data.sourceManifestId is string
                && request.resource.data.sourceManifestId.matches("^[a-f0-9]{64}$")))
        && (!("sealedRepoFullName" in request.resource.data)
            || validCloudSealedText(request.resource.data.sealedRepoFullName));
      allow delete: if ownsUserNamespace(userId);
    }

    // Tamper-evident unified access-audit log (server-only writer). Per-user
    // SHA-256 hash chain written exclusively by Cloud Functions (appendAuditEvent)
    // for the Access Audit Timeline. Clients must never write or the chain could
    // be forged; owner-read only.
    match /users/{userId}/unified_audit_log/{eventId} {
      allow read: if ownsUserNamespace(userId);
      allow write: if false;
    }

    // Transactional head pointer for the audit chain (server-only writer). Holds
    // { maxSeq, headHash } advanced in the same transaction as each append plus
    // the daily OpenTimestamps anchor, so a truncated tail is detectable. Clients
    // must never write or truncation detection could be forged; owner-read only.
    match /users/{userId}/audit_meta/{metaId} {
      allow read: if ownsUserNamespace(userId);
      allow write: if false;
    }

    // Account recovery methods for zero-knowledge mode (server-only writer).
    // Holds ONLY sealed wrapped-vault-key blobs + verification hashes (Apple ADP
    // delayed-confirm pattern), written exclusively via setupRecovery/confirmRecovery.
    match /users/{userId}/account_recovery_methods/{recoveryId} {
      allow read: if ownsUserNamespace(userId);
      allow write: if false;
    }

    match /users/{userId}/cloud_vault_state/{stateId} {
      allow read: if ownsUserNamespace(userId);
      allow create, update: if ownerWritableNonSecret(userId)
        && stateId == "current"
        && request.resource.data.keys().hasOnly([
	          "uid",
	          "vaultKeyID",
	          "previousVaultKeyID",
	          "vaultGeneration",
	          "keyVersion",
	          "algorithm",
	          "status",
	          "createdByDeviceId",
	          "rotatedByDeviceId",
	          "rotationJobId",
	          "rotatedAt",
	          "createdAt",
	          "updatedAt",
	          "schemaVersion"
        ])
        && request.resource.data.uid == userId
        && validVaultKeyID(request.resource.data.vaultKeyID)
	        && request.resource.data.keyVersion is int
	        && request.resource.data.keyVersion >= 1
	        && request.resource.data.keyVersion <= 100
	        && (!("previousVaultKeyID" in request.resource.data) || validVaultKeyID(request.resource.data.previousVaultKeyID))
	        && (!("vaultGeneration" in request.resource.data) || (request.resource.data.vaultGeneration is int && request.resource.data.vaultGeneration >= 1 && request.resource.data.vaultGeneration <= 10000))
	        && request.resource.data.algorithm == "AES-256-GCM"
	        && request.resource.data.status == "active"
	        && request.resource.data.createdByDeviceId is string
	        && request.resource.data.createdByDeviceId.size() <= 256
	        && (!("rotatedByDeviceId" in request.resource.data) || (request.resource.data.rotatedByDeviceId is string && request.resource.data.rotatedByDeviceId.size() <= 256))
	        && (!("rotationJobId" in request.resource.data) || (request.resource.data.rotationJobId is string && request.resource.data.rotationJobId.size() <= 200))
	        && (!("rotatedAt" in request.resource.data) || request.resource.data.rotatedAt is timestamp)
	        && request.resource.data.schemaVersion in [1, 2]
        && (!exists(/databases/$(database)/documents/users/$(userId)/cloud_vault_state/current)
          || get(/databases/$(database)/documents/users/$(userId)/cloud_vault_state/current).data.vaultKeyID == request.resource.data.vaultKeyID);
      allow delete: if false;
    }

    // T-PTR-06: the wrapper doc ID is the deterministic
    // `<vaultKeyID>_<targetDeviceId>_<keyVersion>` composite both writers use
    // (CloudVaultKeyAccess.swift / MobileCloudVaultKeyAccess.swift). Binding the
    // path segment to that composite — combined with `matchesCurrentVaultKey`
    // (current rotation generation only) and the trusted-escrow-device gate —
    // CAPS a stolen-session owner to exactly ONE wrapper per (current vaultKeyID,
    // trusted target device, keyVersion): they cannot mint extra same-generation
    // wrappers under arbitrary doc IDs; a re-write of the canonical ID only
    // overwrites it. `allow delete: if false` keeps active wrappers non-deletable
    // by the owner (availability / revocation stays server-owned).
    function validKeyWrapperDocId(wrapperId) {
      return wrapperId == request.resource.data.vaultKeyID
        + "_" + request.resource.data.targetDeviceId
        + "_" + string(request.resource.data.keyVersion);
    }

    match /users/{userId}/cloud_vault_key_wrappers/{wrapperId} {
      allow read: if ownsUserNamespace(userId);
      allow create, update: if ownerWritableHostedCloudBackup(userId)
        && validKeyWrapperDocId(wrapperId)
        && request.resource.data.keys().hasOnly([
          "uid",
          "targetDeviceId",
          "sourceDeviceId",
          "publicKeyFingerprint",
	          "keyVersion",
	          "wrappedVaultKey",
	          "vaultKeyID",
	          "vaultGeneration",
	          "rotationJobId",
	          "revokedByRotationJobId",
	          "algorithm",
	          "status",
          "createdAt",
          "updatedAt",
          "schemaVersion"
        ])
        && request.resource.data.uid == userId
        && validVaultKeyID(request.resource.data.vaultKeyID)
        && matchesCurrentVaultKey(userId, request.resource.data.vaultKeyID)
        && request.resource.data.targetDeviceId is string
        && request.resource.data.targetDeviceId.size() <= 256
        && request.resource.data.sourceDeviceId is string
        && request.resource.data.sourceDeviceId.size() <= 256
        && request.resource.data.publicKeyFingerprint is string
        && request.resource.data.publicKeyFingerprint.size() <= 128
        && request.resource.data.keyVersion is int
        && request.resource.data.keyVersion >= 1
	        && request.resource.data.keyVersion <= 1000
	        && (!("vaultGeneration" in request.resource.data) || (request.resource.data.vaultGeneration is int && request.resource.data.vaultGeneration >= 1 && request.resource.data.vaultGeneration <= 10000))
	        && (!("rotationJobId" in request.resource.data) || (request.resource.data.rotationJobId is string && request.resource.data.rotationJobId.size() <= 200))
	        && (!("revokedByRotationJobId" in request.resource.data) || (request.resource.data.revokedByRotationJobId is string && request.resource.data.revokedByRotationJobId.size() <= 200))
	        && request.resource.data.wrappedVaultKey is string
        && request.resource.data.wrappedVaultKey.size() <= 8192
        && request.resource.data.wrappedVaultKey.matches("^[A-Za-z0-9+/=]+$")
        && request.resource.data.algorithm == "ECIES-P256-AESGCM"
        && request.resource.data.status in ["active", "revoked"]
	        && request.resource.data.schemaVersion in [2, 3]
        && exists(/databases/$(database)/documents/users/$(userId)/escrow_devices/$(request.resource.data.targetDeviceId))
        && get(/databases/$(database)/documents/users/$(userId)/escrow_devices/$(request.resource.data.targetDeviceId)).data.trustState == "trusted"
        && exists(/databases/$(database)/documents/users/$(userId)/escrow_devices/$(request.resource.data.sourceDeviceId))
        && get(/databases/$(database)/documents/users/$(userId)/escrow_devices/$(request.resource.data.sourceDeviceId)).data.trustState == "trusted";
	      allow delete: if false;
	    }

	    match /users/{userId}/cloud_vault_rotation_jobs/{jobId} {
	      function validCloudVaultRotationJobClientUpdate() {
	        return ownerWritableNonSecret(userId)
	          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
	            "status",
	            "clientDeviceId",
		            "documentRewrapComplete",
		            "storageRewrapComplete",
		            "storageRewrapPending",
		            "processedDocumentCount",
		            "rewrappedDocumentCount",
		            "changedFieldCount",
		            "processedStorageBlobCount",
		            "rewrappedStorageBlobCount",
		            "completedAt",
		            "failedAt",
		            "failureReason",
		            "updatedAt"
	          ])
	          && (!("status" in request.resource.data) || request.resource.data.status in [
	            "queued",
	            "rewrapping",
	            "documents_complete",
	            "documents_complete_storage_pending",
	            "complete",
	            "failed"
	          ])
	          && (!("clientDeviceId" in request.resource.data) || (
	            request.resource.data.clientDeviceId is string
	            && request.resource.data.clientDeviceId.size() > 0
	            && request.resource.data.clientDeviceId.size() <= 128
		          ))
		          && (!("documentRewrapComplete" in request.resource.data) || request.resource.data.documentRewrapComplete is bool)
		          && (!("storageRewrapComplete" in request.resource.data) || request.resource.data.storageRewrapComplete is bool)
		          && (!("storageRewrapPending" in request.resource.data) || request.resource.data.storageRewrapPending is bool)
		          && (!("processedDocumentCount" in request.resource.data) || (
		            request.resource.data.processedDocumentCount is int
		            && request.resource.data.processedDocumentCount >= 0
	            && request.resource.data.processedDocumentCount <= 10000000
	          ))
	          && (!("rewrappedDocumentCount" in request.resource.data) || (
	            request.resource.data.rewrappedDocumentCount is int
	            && request.resource.data.rewrappedDocumentCount >= 0
	            && request.resource.data.rewrappedDocumentCount <= 10000000
	          ))
	          && (!("changedFieldCount" in request.resource.data) || (
		            request.resource.data.changedFieldCount is int
		            && request.resource.data.changedFieldCount >= 0
		            && request.resource.data.changedFieldCount <= 10000000
		          ))
		          && (!("processedStorageBlobCount" in request.resource.data) || (
		            request.resource.data.processedStorageBlobCount is int
		            && request.resource.data.processedStorageBlobCount >= 0
		            && request.resource.data.processedStorageBlobCount <= 10000000
		          ))
		          && (!("rewrappedStorageBlobCount" in request.resource.data) || (
		            request.resource.data.rewrappedStorageBlobCount is int
		            && request.resource.data.rewrappedStorageBlobCount >= 0
		            && request.resource.data.rewrappedStorageBlobCount <= 10000000
		          ))
		          && (!("failureReason" in request.resource.data) || (
		            request.resource.data.failureReason is string
		            && request.resource.data.failureReason.size() <= 500
	          ));
	      }

	      function validCloudVaultRotationCheckpoint(checkpointId) {
	        return ownerWritableNonSecret(userId)
	          && request.resource.data.keys().hasOnly([
	            "domainID",
	            "status",
	            "scannedDocumentCount",
	            "rewrappedDocumentCount",
	            "changedFieldCount",
	            "updatedAt"
	          ])
	          && request.resource.data.domainID == checkpointId
	          && request.resource.data.status in [
		            "documents_pending_storage",
		            "documents_complete",
		            "storage_rewrapping",
		            "storage_complete",
		            "failed"
		          ]
	          && request.resource.data.scannedDocumentCount is int
	          && request.resource.data.scannedDocumentCount >= 0
	          && request.resource.data.scannedDocumentCount <= 10000000
	          && request.resource.data.rewrappedDocumentCount is int
	          && request.resource.data.rewrappedDocumentCount >= 0
	          && request.resource.data.rewrappedDocumentCount <= 10000000
	          && request.resource.data.changedFieldCount is int
	          && request.resource.data.changedFieldCount >= 0
	          && request.resource.data.changedFieldCount <= 10000000;
	      }

	      allow read: if ownsUserNamespace(userId);
	      allow create, delete: if false;
	      allow update: if validCloudVaultRotationJobClientUpdate();

	      match /checkpoints/{checkpointId} {
	        allow read: if ownsUserNamespace(userId);
	        allow create, update: if validCloudVaultRotationCheckpoint(checkpointId);
	        allow delete: if false;
	      }
	    }

	    match /users/{userId}/cloud_vault_rotation_requirements/{requirementId} {
	      allow read: if ownsUserNamespace(userId);
	      allow create, update, delete: if false;
	    }

    match /users/{userId}/devices/{deviceId} {
      allow read: if ownsUserNamespace(userId);
      allow create, update: if ownerWritableNonSecret(userId);
      allow delete: if ownsUserNamespace(userId);
    }

    match /users/{userId}/agent_notification_events/{eventId} {
      allow read: if ownsUserNamespace(userId);
      allow write: if false;
    }

    match /users/{userId}/agent_notification_replies/{replyId} {
      allow read: if ownsUserNamespace(userId);
      allow create: if ownerWritableNonSecret(userId)
        && request.resource.data.keys().hasOnly([
          "id",
          "uid",
          "eventId",
          "threadId",
          "runtime",
          "sourceKind",
          "contentSealed",
          "sealedSchemaVersion",
          "vaultKeyID",
          "sealedReplyPayload",
          "deviceId",
          "status",
          "createdAt",
          "updatedAt",
          "schemaVersion"
        ])
        && request.resource.data.id == replyId
        && request.resource.data.uid == userId
        && request.resource.data.eventId is string
        && request.resource.data.eventId.size() <= 512
        && exists(/databases/$(database)/documents/users/$(userId)/agent_notification_events/$(request.resource.data.eventId))
        && request.resource.data.threadId is string
        && request.resource.data.threadId.size() <= 512
        && request.resource.data.threadId == get(/databases/$(database)/documents/users/$(userId)/agent_notification_events/$(request.resource.data.eventId)).data.threadId
        && request.resource.data.runtime in ["hermes", "pi", "piagent", "pi_agent", "codex", "claude", "openclaw", "antigravity", "droid", "factory", "forge", "grok", "cursorAgent", "cursoragent", "cursor_agent"]
        && request.resource.data.runtime == get(/databases/$(database)/documents/users/$(userId)/agent_notification_events/$(request.resource.data.eventId)).data.runtime
        && request.resource.data.sourceKind in ["cli_session", "mobile_assistant_chat"]
        && request.resource.data.sourceKind == get(/databases/$(database)/documents/users/$(userId)/agent_notification_events/$(request.resource.data.eventId)).data.sourceKind
        && request.resource.data.contentSealed == true
        && request.resource.data.sealedSchemaVersion == 2
        && validSealedPayloadForUser(userId, request.resource.data.vaultKeyID, request.resource.data.sealedReplyPayload)
        && (!("deviceId" in request.resource.data) || (request.resource.data.deviceId is string && request.resource.data.deviceId.size() <= 160))
        && request.resource.data.status == "queued"
        && request.resource.data.schemaVersion == 1;
      allow update: if ownsUserNamespace(userId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.eventId == resource.data.eventId
        && request.resource.data.threadId == resource.data.threadId
        && request.resource.data.runtime == resource.data.runtime
        && request.resource.data.sourceKind == resource.data.sourceKind
        && request.resource.data.contentSealed == resource.data.contentSealed
        && request.resource.data.sealedSchemaVersion == resource.data.sealedSchemaVersion
        && request.resource.data.vaultKeyID == resource.data.vaultKeyID
        && request.resource.data.sealedReplyPayload == resource.data.sealedReplyPayload
        && request.resource.data.status in ["processing", "sent", "failed"]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "processorDeviceId",
          "processedAt",
          "errorMessage",
          "updatedAt"
        ])
        && (!("processorDeviceId" in request.resource.data) || (request.resource.data.processorDeviceId is string && request.resource.data.processorDeviceId.size() <= 160))
        && (!("errorMessage" in request.resource.data) || (request.resource.data.errorMessage is string && request.resource.data.errorMessage.size() <= 512));
      allow delete: if false;
    }

    match /users/{userId}/quota_snapshots/{snapshotId} {
      allow read: if ownsUserNamespace(userId);
      allow create, update: if ownerWritableNonSecret(userId);
      allow delete: if ownsUserNamespace(userId);
    }

    match /users/{userId}/provider_connections/{providerId} {
      allow read: if ownsUserNamespace(userId);
      allow create, update: if ownerWritableNonSecret(userId);
      allow delete: if ownsUserNamespace(userId);
    }

    match /users/{userId}/provider_accounts/{accountId} {
      function validProviderAccountDocument() {
        return request.resource.data.keys().hasOnly([
          "id",
          "providerID",
          "label",
          "identityHint",
          "status",
          "credentialKind",
          "storageScope",
          "redactedLabel",
          "sourceDeviceID",
          "linkedSwitcherProfileID",
          "isDefault",
          "sortKey",
          "lastValidatedAt",
          "lastRefreshAt",
          "lastErrorCode",
          "endpointProfileID",
          "region",
          "tokenPlanTier",
          "tokenPlanBillingCycle",
          "authMethodID",
          "schemaVersion",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.keys().hasAll([
          "id",
          "providerID",
          "label",
          "status",
          "credentialKind",
          "storageScope",
          "redactedLabel",
          "isDefault",
          "sortKey",
          "schemaVersion",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.id == accountId
        && request.resource.data.providerID is string
        && request.resource.data.providerID.size() <= 80
        && request.resource.data.label is string
        && request.resource.data.label.size() <= 160
        && (!("identityHint" in request.resource.data) || (request.resource.data.identityHint is string && request.resource.data.identityHint.size() <= 256))
        && request.resource.data.status in ["connected", "disconnected", "stale", "error", "disabled", "deleted"]
        && request.resource.data.credentialKind in ["token", "bearer", "session", "cookie", "plan"]
        && request.resource.data.storageScope in ["cloud_refreshable", "local_only", "device_keychain", "server_private"]
        && request.resource.data.redactedLabel is string
        && request.resource.data.redactedLabel.size() <= 160
        && (!("sourceDeviceID" in request.resource.data) || (request.resource.data.sourceDeviceID is string && request.resource.data.sourceDeviceID.size() <= 160))
        && (!("linkedSwitcherProfileID" in request.resource.data) || (request.resource.data.linkedSwitcherProfileID is string && request.resource.data.linkedSwitcherProfileID.size() <= 160))
        && request.resource.data.isDefault is bool
        && request.resource.data.sortKey is number
        && (!("lastValidatedAt" in request.resource.data) || (request.resource.data.lastValidatedAt is string && request.resource.data.lastValidatedAt.size() <= 80))
        && (!("lastRefreshAt" in request.resource.data) || (request.resource.data.lastRefreshAt is string && request.resource.data.lastRefreshAt.size() <= 80))
        && (!("lastErrorCode" in request.resource.data) || (request.resource.data.lastErrorCode is string && request.resource.data.lastErrorCode.size() <= 160))
        && (!("endpointProfileID" in request.resource.data) || (request.resource.data.endpointProfileID is string && request.resource.data.endpointProfileID.size() <= 160))
        && (!("region" in request.resource.data) || request.resource.data.region in ["cn", "sgp", "ams", "global"])
        && (!("tokenPlanTier" in request.resource.data) || request.resource.data.tokenPlanTier in ["lite", "standard", "pro", "max"])
        && (!("tokenPlanBillingCycle" in request.resource.data) || request.resource.data.tokenPlanBillingCycle in ["monthly", "annual"])
        && (!("authMethodID" in request.resource.data) || (request.resource.data.authMethodID is string && request.resource.data.authMethodID.size() <= 160))
        && request.resource.data.schemaVersion is number
        && request.resource.data.createdAt is string
        && request.resource.data.createdAt.size() <= 80
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() <= 80;
      }

      allow read: if ownsUserNamespace(userId);
      allow create, update: if ownerWritableNonSecret(userId)
        && validProviderAccountDocument();
      allow delete: if ownsUserNamespace(userId);
    }

    // Provider account device links. Canonical top-level collection used by
    // `adoptProviderAccountForDevice`, `revokeProviderAccountDeviceLink`, and
    // the `backfillProviderAccountDeviceLinks` callable / schedule. Writes
    // funnel through the Admin SDK so capability values stay constrained;
    // clients are read-only.
    match /users/{userId}/provider_account_device_links/{deviceLinkId} {
      allow read: if ownsUserNamespace(userId);
      allow write: if false;
    }

    match /users/{userId}/runtime_connection_preferences/{preferenceId} {
      allow read: if ownsUserNamespace(userId);
      allow create, update: if runtimeConnectionPreferenceWrite(userId, preferenceId);
      allow delete: if ownsUserNamespace(userId);
    }

    match /users/{userId}/hermes_connections/{connectionId} {
      allow read: if ownsUserNamespace(userId);
      allow create: if relayConnectionWrite(userId, connectionId);
      allow update: if relayConnectionWrite(userId, connectionId) && resource.data.mode == "relayLink";
      allow delete: if false;
    }

    match /users/{userId}/hermes_pairings/{pairingId} {
      allow read: if ownsUserNamespace(userId);
      allow write: if false;
    }

    match /users/{userId}/hermes_relay_requests/{requestId} {
      allow read: if ownsUserNamespace(userId);
      allow create, update: if relayRequestWrite(userId, requestId);
      allow delete: if ownsUserNamespace(userId);

      match /chunks/{chunkId} {
        allow read: if ownsUserNamespace(userId);
        allow create, update: if relayChunkWrite(userId, requestId, chunkId);
        allow delete: if ownsUserNamespace(userId);
      }
    }

    match /users/{userId}/hermes_session_cache/{sessionId} {
      allow read: if ownsUserNamespace(userId);
      allow write: if false;
    }

    match /users/{userId}/hermes_audit_events/{eventId} {
      allow read: if ownsUserNamespace(userId);
      allow write: if false;
    }

    match /users/{userId}/hermes_gateway_clients/{clientId} {
      allow read: if ownsUserNamespace(userId);
      allow write: if false;
    }

    match /users/{userId}/hermes_gateway_destinations/{destinationId} {
      allow read: if ownsUserNamespace(userId);
      allow write: if false;
    }

    // Hermes Gateway events (phone→agent). Server-written via the
    // enqueueHermesGatewayEvent callable; clients never write here directly, so
    // the doc stays `write:if false` and the sealed-envelope contract is
    // enforced in the callable handler, not in a rule allowlist
    // (hermes-gateway-e2e-rearchitecture). Once schemaVersion >= 2 a sealed doc
    // carries only `relayEnvelope { payloadCiphertext, wrappedKey,
    // relayEncryption:"p256-hkdf-sha256-aesgcm", relayKeyVersion }` plus
    // routing fields (id/sequence/kind/destinationId/targetClientId/senderId/
    // modelId/attachmentIds/createdAt/schemaVersion). The plaintext text,
    // senderDisplayName, and threadId are sealed inside payloadCiphertext and
    // are rejected by the callable; reads keep a legacy plaintext fallback for
    // pre-cutoff docs.
    match /users/{userId}/hermes_gateway_events/{eventId} {
      allow read: if ownsUserNamespace(userId);
      allow write: if false;
    }

    // Hermes Gateway messages (agent→phone). Server-written via the bearer-token
    // handleMessageSend HTTP handler; `write:if false` for clients and the
    // sealed-envelope contract is enforced in that handler
    // (hermes-gateway-e2e-rearchitecture). Sealed docs carry only
    // `relayEnvelope { payloadCiphertext, wrappedKey, relayEncryption,
    // relayKeyVersion }` plus routing; the plaintext `text` is sealed inside
    // payloadCiphertext and rejected by the handler. Reads keep a legacy
    // plaintext fallback.
    match /users/{userId}/hermes_gateway_messages/{messageId} {
      allow read: if ownsUserNamespace(userId);
      allow write: if false;
    }

    match /users/{userId}/hermes_gateway_typing/{clientId} {
      allow read: if ownsUserNamespace(userId);
      allow write: if false;
    }

    // Hermes Gateway attachments (agent→phone). Server-written via the
    // bearer-token handleAttachmentInit HTTP handler; `write:if false` for
    // clients and the sealed-envelope contract is enforced in that handler
    // (hermes-gateway-e2e-rearchitecture). The body bytes are sealed with a
    // per-attachment key before signed-URL upload; the manifest's
    // `relayEnvelope.payloadCiphertext` seals `{fileName, byteCount,
    // contentType}` and `wrappedKey` wraps the body key to the phone. The
    // plaintext fileName (and the fileName segment of storagePath) are dropped;
    // the server hashes ciphertext for integrity only.
    match /users/{userId}/hermes_gateway_attachments/{attachmentId} {
      allow read: if ownsUserNamespace(userId);
      allow write: if false;
    }

    match /users/{userId}/hermes_gateway_state/{stateId} {
      allow read: if ownsUserNamespace(userId);
      allow write: if false;
    }

    // Human-in-the-loop oversight gates. The owner reads pending/decided gates
    // (the native approval UI lights up from here); all writes are Admin-SDK
    // only, so neither the bearer-token agent nor any client can self-approve.
    // Resolution flows exclusively through respondHermesGatewayApproval, which
    // requires a trusted native escrow device and stamps approvedByDeviceId.
    match /users/{userId}/hermes_gateway_approvals/{approvalId} {
      allow read: if ownsUserNamespace(userId);
      allow write: if false;
    }

    // Iroh transport pairing public keys. The Mac writes one singleton
    // document per host role (today: `host`) containing the base64-encoded
    // 32-byte Ed25519 public half of the pairing key. iOS clients read this
    // value to verify `iroh_pairing/*` signatures before dialing. Schema lives
    // in `functions/src/types.ts` (`IrohPairingPublicKeyDoc`).
    match /users/{userId}/iroh_pairing_keys/{roleId} {
      allow read: if ownsUserNamespace(userId);
      // Trust roots are server-owned. Clients publish through
      // `publishIrohPairingPublicKey`, which enforces App Check, a single-use
      // high-risk nonce, and a trusted macOS escrow device before Admin SDK
      // writes this document.
      allow create, update, delete: if false;
    }

    // Iroh transport pairing records. Mac publishes; iOS reads + verifies the
    // Ed25519 signature using `iroh_pairing_keys/host.publicKeyBase64` before
    // dialing the signed NodeAddr material. Schema lives in `functions/src/types.ts`
    // (`IrohPairingRecordDoc`); the Mac is the sole writer.
    match /users/{userId}/iroh_pairing/{connectionId} {
      allow read: if ownsUserNamespace(userId);
      // The signed host pairing record is a remote-control trust root. Clients
      // publish/revoke through high-risk server callables; direct owner writes
      // would let a stolen Firebase session replace the Mac endpoint.
      allow create, update, delete: if false;
    }

    // Iroh transport audit events. Append-only; written by the Mac (on stream
    // open/close/fail) and the Cloud Functions hosted runner (on fallback to
    // the WSS relay). Schema lives in `functions/src/types.ts`
    // (`IrohTransportAuditEventDoc`).
    match /users/{userId}/iroh_audit_events/{eventId} {
      allow read: if ownsUserNamespace(userId);
      allow create: if ownerWritableNonSecret(userId)
        && request.resource.data.keys().hasOnly([
          "id",
          "connectionId",
          "eventType",
          "rttMillis",
          "transport",
          "observedAt",
          "detail",
          "schemaVersion",
          "expireAt"
        ])
        && request.resource.data.id is string
        && request.resource.data.id == eventId
        && request.resource.data.eventType in [
          "iroh_stream_opened",
          "iroh_stream_closed",
          "iroh_stream_failed",
          "iroh_pairing_published",
          "iroh_pairing_verified",
          "iroh_pairing_rejected",
          "iroh_fallback_to_wss",
          "iroh_fallback_to_firestore"
        ]
        && request.resource.data.schemaVersion is int
        && request.resource.data.schemaVersion >= 1;
      allow update: if false;
      allow delete: if false;
    }

    // --- Mercury media (Phase 2) ---
    // Per-session metadata. Bucketed enums only, never payload bytes.
    // Schema in `functions/src/types.ts` (`MediaSessionEventDoc`).
    match /users/{userId}/media_session_events/{eventId} {
      // Strict allowlist (MediaSessionEventDoc). Bucketed enums + opaque hashed
      // peer id only — never a filename, payload bytes, or any free-text field.
      function validMediaSessionEventKeys() {
        return request.resource.data.keys().hasOnly([
          "id",
          "sessionId",
          "feature",
          "streamClass",
          "startedAt",
          "endedAt",
          "endReason",
          "peerDeviceIdHash",
          "byteCountInbound",
          "byteCountOutbound",
          "freezeCount",
          "p95RoundTripMillisBucket",
          "p95BitsPerSecondBucket",
          "durationBucket",
          "expireAt",
          "schemaVersion"
        ]);
      }
      allow read: if ownsUserNamespace(userId);
      allow create: if ownerWritableNonSecret(userId)
        && hasActiveHostedMediaEntitlement(userId)
        && validMediaSessionEventKeys()
        && request.resource.data.id == eventId
        && request.resource.data.feature in ["fileTransfer", "screenShare", "videoCall"]
        && request.resource.data.startedAt is string
        && request.resource.data.schemaVersion is int
        && request.resource.data.schemaVersion >= 1
        && (!("peerDeviceIdHash" in request.resource.data) || (request.resource.data.peerDeviceIdHash is string && request.resource.data.peerDeviceIdHash.size() <= 128))
        && (!("p95RoundTripMillisBucket" in request.resource.data) || request.resource.data.p95RoundTripMillisBucket in ["lt_50ms", "50_150ms", "150_400ms", "gte_400ms"])
        && (!("p95BitsPerSecondBucket" in request.resource.data) || request.resource.data.p95BitsPerSecondBucket in ["lt_300kbps", "300_600kbps", "600kbps_1mbps", "1_2mbps", "2_4mbps", "4_8mbps", "gte_8mbps"])
        && (!("durationBucket" in request.resource.data) || request.resource.data.durationBucket in ["lt_30s", "30s_2m", "2m_10m", "10m_30m", "30m_60m", "gte_60m"])
        && !("body" in request.resource.data)
        && !("payloadCiphertext" in request.resource.data)
        && !("ciphertext" in request.resource.data)
        && !("filename" in request.resource.data);
      allow update: if false;
      allow delete: if false;
    }

    // --- Computer Use (Phase 8-13, master plan 2026-05-16) ---
    // Phone-control authority keys. The phone publishes its Ed25519 public
    // key before opening `control.input`; the Mac fetches it from the active
    // `iroh_pairing/{connectionId}/controllers/{peerNodeId}` doc when it
    // receives `control.classify`. This keeps the verifier root out of the
    // stream it authenticates and binds it to the pairing record iOS verified
    // before dialing.
    match /users/{userId}/iroh_pairing/{connectionId}/controllers/{peerNodeId} {
      allow read: if ownsUserNamespace(userId);
      // Phone-control verifier keys are server-owned for the same reason as
      // host pairing roots. `publishPhoneControlAuthority` verifies a trusted
      // native mobile escrow device and existing host pairing before writing.
      allow create, update, delete: if false;
    }

    // Mobile iroh QUIC NodeId allow-list entries. This is intentionally
    // separate from phone-control `controllers/*`: the Mac's inbound policy
    // checks the QUIC peer NodeId surfaced by iroh, while phone-control
    // controller IDs are derived from app-layer signing keys. Clients publish
    // through `publishIrohPeerNodeId`, which verifies App Check, nonce
    // freshness, trusted native mobile escrow state, and the existing pairing.
    match /users/{userId}/iroh_pairing/{connectionId}/iroh_controllers/{irohPeerNodeId} {
      allow read: if ownsUserNamespace(userId);
      allow create, update, delete: if false;
    }

    // Mobile/Android sender keys for authenticated relay request envelopes.
    // These are trust-root cache entries, not user-editable preferences. Clients
    // publish through `publishRelaySenderKey`, which verifies App Check,
    // high-risk nonce freshness, trusted native escrow state, key shape, key id,
    // and the device's Signal identity binding before Admin SDK writes here.
    match /users/{userId}/relay_sender_keys/{deviceId} {
      allow read: if ownsUserNamespace(userId);
      allow create, update, delete: if false;
    }

    // Phone/iPad/Android -> Mac agent desktop permission grants. These
    // documents carry only signed capability metadata and public keys.
    match /users/{userId}/agent_grant_authorities/{deviceId} {
      function validAgentGrantAuthorityDocument() {
        return request.resource.data.keys().hasOnly([
          "sourceDeviceId",
          "peerNodeId",
          "publicKeyBase64",
          "publishedAtMillis",
          "schemaVersion",
          "updatedAt"
        ])
        && request.resource.data.sourceDeviceId == deviceId
        && request.resource.data.peerNodeId is string
        && request.resource.data.peerNodeId.size() <= 160
        && request.resource.data.publicKeyBase64 is string
        && request.resource.data.publicKeyBase64.size() >= 32
        && request.resource.data.publicKeyBase64.size() <= 256
        && (!("publishedAtMillis" in request.resource.data) || request.resource.data.publishedAtMillis is int)
        && (!("schemaVersion" in request.resource.data) || request.resource.data.schemaVersion is int)
        && request.resource.data.updatedAt is timestamp
        && exists(/databases/$(database)/documents/users/$(userId)/escrow_devices/$(deviceId))
        && get(/databases/$(database)/documents/users/$(userId)/escrow_devices/$(deviceId)).data.trustState == "trusted"
        && get(/databases/$(database)/documents/users/$(userId)/escrow_devices/$(deviceId)).data.platform in ["iOS", "iPadOS", "Android"];
      }

      allow read: if ownsUserNamespace(userId);
      allow create, update, delete: if false;
    }

    match /users/{userId}/agent_capability_grant_requests/{requestId} {
      function validAgentGrantAuthorityEnvelope() {
        return request.resource.data.authority is map
          && request.resource.data.authority.keys().hasOnly([
            "peerNodeId",
            "counter",
            "timestamp",
            "intentHashBlake3",
            "signatureEd25519"
          ])
          && request.resource.data.authority.peerNodeId is string
          && request.resource.data.authority.peerNodeId.size() <= 160
          && request.resource.data.authority.counter is number
          && request.resource.data.authority.counter >= 0
          && request.resource.data.authority.timestamp is number
          && request.resource.data.authority.intentHashBlake3 is string
          && request.resource.data.authority.intentHashBlake3.matches("^[a-fA-F0-9]{64}$")
          && request.resource.data.authority.signatureEd25519 is string
          && request.resource.data.authority.signatureEd25519.size() <= 256;
      }

      function validAgentGrantReceipt(receipt) {
        return receipt is map
          && receipt.keys().hasOnly([
            "receiptId",
            "requestId",
            "runtime",
            "threadId",
            "status",
            "appliedGrantId",
            "capabilities",
            "trustMode",
            "receivedAt",
            "grantExpiresAt",
            "sourceDeviceId",
            "denialReason",
            "message"
          ])
          && receipt.receiptId is string
          && receipt.receiptId.size() <= 160
          && receipt.requestId == requestId
          && receipt.runtime in ["hermes", "pi", "codex", "claude", "openclaw", "antigravity", "droid", "forge", "grok", "cursorAgent", "cursoragent", "cursor_agent"]
          && receipt.threadId is string
          && receipt.threadId.size() <= 240
          && receipt.status in ["queued", "applied", "revoked", "denied", "expired"]
          && receipt.capabilities is list
          && receipt.capabilities.size() <= 16
          && receipt.capabilities.hasOnly([
            "desktop_browser",
            "desktop_screenshot",
            "accessibility_inspect",
            "desktop_system_input",
            "workspace_read",
            "workspace_write",
            "shell",
            "desktop_file_export",
            "shell_unrestricted"
          ])
          && receipt.trustMode in ["manual", "step", "trusted"]
          && receipt.receivedAt is number
          && (!("appliedGrantId" in receipt) || (receipt.appliedGrantId is string && receipt.appliedGrantId.size() <= 160))
          && (!("grantExpiresAt" in receipt) || receipt.grantExpiresAt is number)
          && (!("sourceDeviceId" in receipt) || (receipt.sourceDeviceId is string && receipt.sourceDeviceId.size() <= 160))
          && (!("denialReason" in receipt) || receipt.denialReason in ["malformed_request", "unsupported_runtime", "expired", "signature_failure", "counter_replay", "stale_timestamp", "no_paired_mac", "local_authentication_required", "local_auth_proof_required", "local_auth_proof_invalid", "mac_approval_required", "yolo_unavailable", "grant_preset_mismatch", "unknown"])
          && (!("message" in receipt) || (receipt.message is string && receipt.message.size() <= 2048));
      }

      function validAgentGrantLocalAuthProof(proof) {
        return proof is map
          && proof.keys().hasOnly([
            "proofId",
            "deviceId",
            "signedIntentHash",
            "authenticatedAt",
            "expiresAt",
            "signatureEd25519"
          ])
          && proof.proofId is string
          && proof.proofId.size() <= 160
          && proof.deviceId is string
          && proof.deviceId.size() <= 160
          && proof.signedIntentHash.matches("^[a-f0-9]{64}$")
          && proof.authenticatedAt is number
          && proof.expiresAt is number
          && proof.expiresAt > proof.authenticatedAt
          && proof.signatureEd25519 is string
          && proof.signatureEd25519.size() <= 256;
      }

      function validAgentCapabilityGrantDocument() {
        return request.resource.data.keys().hasOnly([
          "requestId",
          "runtime",
          "threadId",
          "preset",
          "capabilities",
          "trustMode",
          "deliveryMode",
          "requestedAt",
          "expiresAt",
          "grantDurationSeconds",
          "sourceDeviceId",
          "clientIntentId",
          "localAuthenticationSatisfied",
          "localAuthProof",
          "localAuthProofVerifiedAt",
          "authority",
          "status",
          "canonicalRequestHashSha256",
          "createdAt",
          "updatedAt",
          "receipt"
        ])
        && request.resource.data.requestId == requestId
        && request.resource.data.runtime in ["hermes", "pi", "codex", "claude", "openclaw", "antigravity", "droid", "forge", "grok", "cursorAgent", "cursoragent", "cursor_agent"]
        && request.resource.data.threadId is string
        && request.resource.data.threadId.size() <= 240
        && request.resource.data.preset in ["off", "low", "workspace", "desktop", "all", "yolo"]
        && request.resource.data.capabilities is list
        && request.resource.data.capabilities.size() <= 16
        && request.resource.data.capabilities.hasOnly([
          "desktop_browser",
          "desktop_screenshot",
          "accessibility_inspect",
          "desktop_system_input",
          "workspace_read",
          "workspace_write",
          "shell",
          "desktop_file_export",
          "shell_unrestricted"
        ])
        && request.resource.data.trustMode in ["manual", "step", "trusted"]
        && request.resource.data.deliveryMode in ["live", "queued", "live_then_queued"]
        && request.resource.data.status in ["queued", "applied", "revoked", "denied", "expired"]
        && request.resource.data.requestedAt is number
        && request.resource.data.expiresAt is number
        && request.resource.data.grantDurationSeconds is number
        && request.resource.data.grantDurationSeconds > 0
        && request.resource.data.grantDurationSeconds <= 86400
        && request.resource.data.sourceDeviceId is string
        && request.resource.data.sourceDeviceId.size() <= 160
        && request.resource.data.clientIntentId is string
        && request.resource.data.clientIntentId.size() <= 160
        && request.resource.data.localAuthenticationSatisfied is bool
        && (!("localAuthProof" in request.resource.data) || validAgentGrantLocalAuthProof(request.resource.data.localAuthProof))
        && (!("localAuthProofVerifiedAt" in request.resource.data) || request.resource.data.localAuthProofVerifiedAt is timestamp)
        && (!("canonicalRequestHashSha256" in request.resource.data) || request.resource.data.canonicalRequestHashSha256.matches("^[a-f0-9]{64}$"))
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && validAgentGrantAuthorityEnvelope()
        && (!("receipt" in request.resource.data) || validAgentGrantReceipt(request.resource.data.receipt))
        && exists(/databases/$(database)/documents/users/$(userId)/agent_grant_authorities/$(request.resource.data.sourceDeviceId))
        && exists(/databases/$(database)/documents/users/$(userId)/escrow_devices/$(request.resource.data.sourceDeviceId))
        && get(/databases/$(database)/documents/users/$(userId)/escrow_devices/$(request.resource.data.sourceDeviceId)).data.trustState == "trusted"
        && get(/databases/$(database)/documents/users/$(userId)/escrow_devices/$(request.resource.data.sourceDeviceId)).data.platform in ["iOS", "iPadOS", "Android"];
      }

      allow read: if ownsUserNamespace(userId);
      allow create: if false;
      allow update: if ownerWritableNonSecret(userId)
        && hasActiveHostedComputerUseEntitlement(userId)
        && validAgentCapabilityGrantDocument()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "receipt",
          "updatedAt"
        ])
        && request.resource.data.status in ["applied", "revoked", "denied", "expired"]
        && ("receipt" in request.resource.data);
      allow delete: if false;
    }

    // Per-session metadata. The full audit chain lives on the Mac at
    // ~/Library/Application Support/com.openburnbar.AgentLens/computer-use-audit/.
    // Server-side carries only the chain header (manifest hash, head
    // hash, end reason). Never carries action descriptors, screenshots,
    // or scope rule contents.
    match /users/{userId}/computer_use_sessions/{sessionId} {
      allow read: if ownsUserNamespace(userId);
      allow create: if ownerWritableNonSecret(userId)
        && hasActiveHostedComputerUseEntitlement(userId)
        && request.resource.data.sessionId == sessionId
        && request.resource.data.userId == userId
        && request.resource.data.mode in ["agent_watch", "browser", "system"]
        && request.resource.data.trustMode in ["manual", "step", "trusted"]
        && request.resource.data.manifestHashHex is string
        && request.resource.data.macAppVersion is string
        && request.resource.data.schemaVersion is int
        && request.resource.data.schemaVersion >= 1
        && !("body" in request.resource.data)
        && !("payloadCiphertext" in request.resource.data)
        && !("ciphertext" in request.resource.data)
        && !("screenshots" in request.resource.data)
        && !("actionDescriptors" in request.resource.data);
      // End-of-session updates may set endReason/endedAt/auditHeadHashHex.
      allow update: if ownsUserNamespace(userId)
        && hasActiveHostedComputerUseEntitlement(userId)
        && request.resource.data.sessionId == resource.data.sessionId
        && request.resource.data.manifestHashHex == resource.data.manifestHashHex;
      allow delete: if false;
    }

    // Per-action audit *header*. Carries only the chain link, status,
    // and cost — never the full descriptor or selectors / URLs / coords.
    match /users/{userId}/computer_use_actions/{actionId} {
      allow read: if ownsUserNamespace(userId);
      allow create: if ownerWritableNonSecret(userId)
        && hasActiveHostedComputerUseEntitlement(userId)
        && request.resource.data.id == actionId
        && request.resource.data.sessionId is string
        && request.resource.data.entryIndex is int
        && request.resource.data.toolKind is string
        && request.resource.data.status in [
          "executed", "denied", "rejected", "awaiting_approval", "error"
        ]
        && request.resource.data.approvedBy in [
          "mac", "phone", "trusted_scope", "step", "denied", "panic"
        ]
        && request.resource.data.parentEntryHashHex is string
        && request.resource.data.schemaVersion is int
        && !("body" in request.resource.data)
        && !("selector" in request.resource.data)
        && !("text" in request.resource.data)
        && !("url" in request.resource.data)
        && !("screenshot" in request.resource.data)
        && !("ciphertext" in request.resource.data);
      allow update: if false;
      allow delete: if false;
    }

    // Daily counters mirrored from the Mac. Owner-writable; cloud
    // function `recomputeComputerUseQuotaUsage` reconciles drift.
    match /users/{userId}/computer_use_quota_usage/{day} {
      allow read: if ownsUserNamespace(userId);
      allow create, update: if ownerWritableNonSecret(userId)
        && request.resource.data.dayKey == day
        && request.resource.data.browserActionsExecuted is number
        && request.resource.data.browserActionsRejected is number
        && request.resource.data.systemActionsExecuted is number
        && request.resource.data.systemActionsRejected is number
        && request.resource.data.phoneControlIntentsExecuted is number
        && request.resource.data.phoneControlIntentsRejected is number
        && request.resource.data.visionModelSpendUSD is number;
      allow delete: if false;
    }

    // Budget split (ADR 006): public envelope vs operator metrics.
    match /ops/computer_use_budget_status/state/current {
      allow read: if isSignedIn();
      allow write: if false;
    }
    match /ops/computer_use_budget_status/metrics/current {
      allow read: if isOperator();
      allow write: if false;
    }
    match /ops/computer_use_budget_status/events/{eventId} {
      allow read: if isOperator();
      allow write: if false;
    }
    match /ops/computer_use_session_daily_rollups/days/{day} {
      allow read: if isOperator();
      allow write: if false;
    }

    // Owner-writable daily quota counter. The Mac batches updates every
    // 30 s during active sessions; the hourly `recomputeMediaQuotaUsage`
    // Cloud Function reconciles drift from `iroh_audit_events`.
    match /users/{userId}/media_quota_usage/{day} {
      allow read: if ownsUserNamespace(userId);
      allow create, update: if ownerWritableNonSecret(userId)
        && request.resource.data.id == day
        && request.resource.data.schemaVersion is int
        && request.resource.data.schemaVersion >= 1
        && request.resource.data.bytesUploadedFile is number
        && request.resource.data.bytesDownloadedFile is number
        && request.resource.data.fileTransfersInitiated is number
        && request.resource.data.fileTransfersFailed is number
        && request.resource.data.screenShareSecondsUsed is number
        && request.resource.data.screenShareSessions is number
        && request.resource.data.videoCallSecondsUsed is number
        && request.resource.data.videoCallSessions is number;
      allow delete: if false;
    }

    // Per-attachment manifest. No payload bytes — the file flows
    // peer-to-peer over iroh-blobs. This doc is the audit record so DSR
    // exports + admin tooling can answer "what files have been sent."
    //
    // Fork F = SEAL (privacy-leak-remediation-2026-06-02 §6): the human-readable
    // filename is PRIVATE TEXT and is sealed into `sealedFilename`
    // (validCloudSealedText). FLAG-DAY (hermes-gateway-e2e-rearchitecture): the
    // sealing iOS writer of record ships clean — no native code ever wrote this
    // collection in plaintext — so the legacy plaintext `filename` branch is
    // hard-dropped from the allowlist. `sealedFilename` is now MANDATORY; a
    // plaintext `filename` key (or any smuggled body/ciphertext) is rejected.
    match /users/{userId}/media_attachment_manifests/{manifestId} {
      function validMediaAttachmentManifestKeys() {
        return request.resource.data.keys().hasOnly([
          "id",
          "blobHash",
          "sealedFilename",
          "mime",
          "size",
          "peerDeviceIdHash",
          "direction",
          "createdAt",
          "expireAt",
          "schemaVersion"
        ]);
      }
      allow read: if ownsUserNamespace(userId);
      allow create: if ownerWritableNonSecret(userId)
        && hasActiveHostedMediaEntitlement(userId)
        && validMediaAttachmentManifestKeys()
        && request.resource.data.id == manifestId
        && request.resource.data.blobHash is string
        && request.resource.data.mime is string
        && request.resource.data.size is number
        && request.resource.data.peerDeviceIdHash is string
        && request.resource.data.direction in ["macToIos", "iosToMac"]
        && request.resource.data.schemaVersion is int
        // Sealed filename is the only accepted shape — plaintext `filename`
        // is no longer in the allowlist, so a co-emitted cleartext name is
        // impossible.
        && ("sealedFilename" in request.resource.data)
        && validCloudSealedText(request.resource.data.sealedFilename)
        && !("body" in request.resource.data)
        && !("ciphertext" in request.resource.data);
      allow update: if false;
      allow delete: if false;
    }

    match /users/{userId}/pi_agent_connections/{connectionId} {
      allow read: if ownsUserNamespace(userId);
      allow create: if piRelayConnectionWrite(userId, connectionId);
      allow update: if piRelayConnectionWrite(userId, connectionId) && resource.data.mode == "relayLink";
      allow delete: if false;
    }

    match /users/{userId}/pi_agent_pairings/{pairingId} {
      allow read: if ownsUserNamespace(userId);
      allow write: if false;
    }

    match /users/{userId}/pi_agent_relay_requests/{requestId} {
      allow read: if ownsUserNamespace(userId);
      allow create, update: if piRelayRequestWrite(userId, requestId);
      allow delete: if ownsUserNamespace(userId);

      match /chunks/{chunkId} {
        allow read: if ownsUserNamespace(userId);
        allow create, update: if piRelayChunkWrite(userId, requestId, chunkId);
        allow delete: if ownsUserNamespace(userId);
      }
    }

    match /users/{userId}/pi_agent_audit_events/{eventId} {
      allow read: if ownsUserNamespace(userId);
      allow write: if false;
    }

    match /users/{userId}/smart_hub_config/{deviceId} {
      allow read: if ownsUserNamespace(userId);
      allow create, update: if ownerWritableNonSecret(userId)
        && request.resource.data.keys().hasOnly([
          "enabled",
          "dashboardURL",
          "refreshURL",
          "voiceRefreshURL",
          "sourceDeviceName",
          "publishedAt",
          "timePeriod",
          "pixelClock",
          "displayConfig",
          "displayOrder",
          "schemaVersion"
        ])
        && request.resource.data.enabled is bool
        && request.resource.data.schemaVersion is int
        && (!("dashboardURL" in request.resource.data) || (request.resource.data.dashboardURL is string && request.resource.data.dashboardURL.size() <= 2048))
        && (!("refreshURL" in request.resource.data) || (request.resource.data.refreshURL is string && request.resource.data.refreshURL.size() <= 2048))
        && (!("voiceRefreshURL" in request.resource.data) || (request.resource.data.voiceRefreshURL is string && request.resource.data.voiceRefreshURL.size() <= 2048))
        && (!("sourceDeviceName" in request.resource.data) || (request.resource.data.sourceDeviceName is string && request.resource.data.sourceDeviceName.size() <= 160))
        && (!("timePeriod" in request.resource.data) || request.resource.data.timePeriod in ["rolling5h", "rolling24h", "rolling7d", "rolling30d"])
        && (!("pixelClock" in request.resource.data) || validPixelClockConfig(request.resource.data.pixelClock))
        && (!("displayConfig" in request.resource.data) || validSmartHubDisplayConfig(request.resource.data.displayConfig))
        && (!("displayOrder" in request.resource.data) || validSmartDisplayOrder(request.resource.data.displayOrder));
      allow delete: if ownsUserNamespace(userId);
    }

    match /users/{userId}/smart_display_actions/{actionId} {
      allow read: if ownsUserNamespace(userId);
      allow create, update: if ownerWritableNonSecret(userId)
        && request.resource.data.keys().hasOnly([
          "type",
          "status",
          "requestedAt",
          "completedAt",
          "errorMessage",
          "probeStatus",
          "setupMode",
          "message",
          "suggestedServerHost",
          "suggestedServerPort",
          "flasherURL",
          "refreshing",
          "pixelClock",
          "displayConfig",
          "displayOrder"
        ])
        && request.resource.data.type in [
          "pixel_clock_probe",
          "pixel_clock_prepare",
          "pixel_clock_test",
          "pixel_clock_push",
          "pixel_clock_remove",
          "pixel_clock_update_config",
          "nest_hub_update_display_config",
          "nest_hub_update_order",
          "nest_hub_refresh",
          "nest_hub_identify",
          "nest_hub_stop"
        ]
        && request.resource.data.status in ["pending", "completed", "failed"]
        && (!("errorMessage" in request.resource.data) || (request.resource.data.errorMessage is string && request.resource.data.errorMessage.size() <= 2048))
        && (!("probeStatus" in request.resource.data) || request.resource.data.probeStatus in ["unknown", "awtrixReady", "stockUlanziFirmware", "unreachable", "unsupported", "error"])
        && (!("setupMode" in request.resource.data) || request.resource.data.setupMode in ["awtrixLightReady", "stockSimulatorConfigured", "needsAwtrixLightFlash", "unreachable"])
        && (!("message" in request.resource.data) || (request.resource.data.message is string && request.resource.data.message.size() <= 2048))
        && (!("suggestedServerHost" in request.resource.data) || (request.resource.data.suggestedServerHost is string && request.resource.data.suggestedServerHost.size() <= 255))
        && (!("suggestedServerPort" in request.resource.data) || (request.resource.data.suggestedServerPort is int && request.resource.data.suggestedServerPort >= 1 && request.resource.data.suggestedServerPort <= 65535))
        && (!("flasherURL" in request.resource.data) || (request.resource.data.flasherURL is string && request.resource.data.flasherURL.size() <= 2048))
        && (!("refreshing" in request.resource.data) || request.resource.data.refreshing is bool)
        && (!("pixelClock" in request.resource.data) || validPixelClockConfig(request.resource.data.pixelClock))
        && (!("displayConfig" in request.resource.data) || validSmartHubDisplayConfig(request.resource.data.displayConfig))
        && (!("displayOrder" in request.resource.data) || validSmartDisplayOrder(request.resource.data.displayOrder));
      allow delete: if ownsUserNamespace(userId);
    }

    match /users/{userId}/cast_actions/{actionId} {
      allow read: if ownsUserNamespace(userId);
      allow create, update: if ownerWritableNonSecret(userId)
        && request.resource.data.keys().hasOnly([
          "type",
          "status",
          "requestedAt",
          "completedAt",
          "errorMessage",
          "deviceId",
          "friendlyName",
          "model",
          "host",
          "port",
          "identifier",
          "supportsDisplay",
          "sessionId",
          "recovery",
          "message",
          "attempts"
        ])
        && request.resource.data.type in ["test", "save_selection", "cast", "stop"]
        && request.resource.data.status in ["pending", "completed", "failed"]
        && (!("errorMessage" in request.resource.data) || (request.resource.data.errorMessage is string && request.resource.data.errorMessage.size() <= 2048))
        && (!("deviceId" in request.resource.data) || (request.resource.data.deviceId is string && request.resource.data.deviceId.size() <= 512))
        && (!("friendlyName" in request.resource.data) || (request.resource.data.friendlyName is string && request.resource.data.friendlyName.size() <= 160))
        && (!("model" in request.resource.data) || (request.resource.data.model is string && request.resource.data.model.size() <= 160))
        && (!("host" in request.resource.data) || (request.resource.data.host is string && request.resource.data.host.size() <= 255))
        && (!("port" in request.resource.data) || (request.resource.data.port is int && request.resource.data.port >= 1 && request.resource.data.port <= 65535))
        && (!("identifier" in request.resource.data) || (request.resource.data.identifier is string && request.resource.data.identifier.size() <= 512))
        && (!("supportsDisplay" in request.resource.data) || request.resource.data.supportsDisplay is bool)
        && (!("sessionId" in request.resource.data) || (request.resource.data.sessionId is string && request.resource.data.sessionId.size() <= 512))
        && (!("recovery" in request.resource.data) || request.resource.data.recovery in ["home_assistant"])
        && (!("message" in request.resource.data) || (request.resource.data.message is string && request.resource.data.message.size() <= 2048))
        && (!("attempts" in request.resource.data) || (request.resource.data.attempts is int && request.resource.data.attempts >= 0 && request.resource.data.attempts <= 20));
