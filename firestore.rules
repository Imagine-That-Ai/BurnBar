          "deviceId",
          "deviceName",
          "platform",
          "appVersion",
          "trustState",
          "approvedAt",
          "createdAt",
          "updatedAt",
          "publicKeyFingerprint",
          "keyVersion",
          "approvedByDeviceId",
          "trustChainVersion",
          "trustChainAlgorithm",
          "trustChainSignature",
