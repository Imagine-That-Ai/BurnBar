rules_version = '2';
// OpenBurnBar currently syncs explicit owner-scoped collections:
// - users/{uid}/usage, conversations, chat_threads, text_snippets, session_logs (+ chunks), devices
// - users/{uid}/quota_snapshots, provider_connections, provider_accounts, usage_rollups, roaming_profile
// - users/{uid}/projects (derived read model)
// - users/{uid}/hermes_connections, hermes_pairings, hermes_relay_requests, hermes_session_cache, hermes_audit_events
// - users/{uid}/iroh_pairing, iroh_pairing_keys, iroh_audit_events, incoming_call_contexts
// - users/{uid}/agent_grant_authorities, agent_capability_grant_requests
// - users/{uid}/pi_agent_connections, pi_agent_pairings, pi_agent_relay_requests, pi_agent_audit_events
// - users/{uid}/provider_account_device_links, runtime_connection_preferences
// - users/{uid}/cloud_profile, sync_watermarks, sync_status, cloud_settings, recent_usage
// - users/{uid}/cloud_search_index_manifest, remote_mcp_clients, remote_mcp_grants, remote_mcp_audit_events, remote_mcp_rate_limits
// - users/{uid}/cli_sessions, cli_agent_mission_requests
// - users/{uid}/ai_inbox_items, ai_inbox_item_state
// - users/{uid}/escrow_devices, escrow_public_keys, signal_identity_public_keys, escrow_grants, escrow_envelopes, escrow_audit_events
// - server-only: provider_account_secret_refs, users/{uid}/_rate_limits, users/{uid}/rollup_jobs
// - public read-only: model_benchmark_snapshots, model_benchmark_source_status
// - workspaces/workspace-{uid}/teams/team-default/artifacts/{artifactID} (+ versions/{revisionID})
// The shared-artifact rule below intentionally stays owner-scoped for this source release.
//
// App Check: `request.auth` below is not sufficient to block non-app clients. Enforce
// App Check for Cloud Firestore in the Firebase console so only your app+attested
// traffic reaches this ruleset. See: https://firebase.google.com/docs/app-check/enable-enforcement
// and docs/FIREBASE_APP_CHECK_ENFORCEMENT.md in this repo.
//
// Escrow trust: clients may register pending escrow_devices but cannot elevate
// trustState to `trusted` in rules — use the `approveEscrowDeviceTrust` callable.
//
// Escrow security: escrow_envelopes MUST contain ciphertext only. The rules below
// reject documents that contain field names associated with plaintext credentials.
// Client code is independently responsible for ensuring plaintext secrets are never
// serialized into Firestore documents (validated by unit tests).
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null
        && !exists(/databases/$(database)/documents/account_erasure_tombstones/$(request.auth.uid));
    }

    function isOperator() {
      return isSignedIn() && request.auth.token.get('burnbarOperator', false) == true;
    }

    function requestWithinBasicLimits() {
      return request.resource.size() < 1048576
        && request.resource.data.keys().size() < 80;
    }

    function escrowDocumentLimits() {
      return request.resource.size() < 51200
        && request.resource.data.keys().size() < 20;
    }

    function escrowDeviceDocumentLimits() {
      // Trusted device records include the approval chain and server-owned
      // Signal repair receipt. `validEscrowDeviceDocument` still provides an
      // exact field allowlist, so this wider count applies only to that schema.
      return request.resource.size() < 51200
        && request.resource.data.keys().size() <= 24;
    }

    function ownsUserNamespace(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasNoPlaintextSecretFields() {
      return !("apiKey" in request.resource.data)
        && !("token" in request.resource.data)
        && !("refreshToken" in request.resource.data)
        && !("accessToken" in request.resource.data)
        && !("idToken" in request.resource.data)
        && !("cookie" in request.resource.data)
        && !("password" in request.resource.data)
        && !("secret" in request.resource.data)
        && !("secretVersionName" in request.resource.data)
        && !("authorization" in request.resource.data)
        && !("bearer" in request.resource.data)
        && !("credential" in request.resource.data);
    }

    function ownerWritableNonSecret(userId) {
      return ownsUserNamespace(userId)
        && requestWithinBasicLimits()
        && hasNoPlaintextSecretFields();
    }

    function validComputerUseSessionDocument(userId, sessionId) {
      return request.resource.data.keys().hasOnly([
          "id",
          "sessionId",
          "userId",
          "mode",
          "trustMode",
          "startedAt",
          "endedAt",
          "endReason",
          "actionCount",
          "approvalCount",
          "rejectionCount",
          "panicHaltCount",
          "visionSpendUSD",
          "manifestHashHex",
          "auditHeadHashHex",
          "macAppVersion",
          "schemaVersion",
          "updatedAt"
        ])
        && (!("id" in request.resource.data) || request.resource.data.id == sessionId)
        && request.resource.data.sessionId == sessionId
        && request.resource.data.userId == userId
        && request.resource.data.mode in ["agent_watch", "browser", "system"]
        && request.resource.data.trustMode in ["manual", "step", "trusted"]
        && request.resource.data.startedAt is timestamp
        && (!("endedAt" in request.resource.data) || request.resource.data.endedAt is timestamp)
        && (!("endReason" in request.resource.data) || request.resource.data.endReason in [
          "completed",
          "user_halt",
          "panic_hotkey",
          "panic_phone_gesture",
          "panic_mac_lock",
          "panic_remote_config",
          "panic_accessibility_revoked",
          "timeout",
          "entitlement_lost",
          "budget_soft_cap",
          "budget_hard_cap",
          "error"
        ])
        && request.resource.data.actionCount is int
        && request.resource.data.actionCount >= 0
        && request.resource.data.approvalCount is int
        && request.resource.data.approvalCount >= 0
        && request.resource.data.rejectionCount is int
        && request.resource.data.rejectionCount >= 0
        && request.resource.data.panicHaltCount is int
        && request.resource.data.panicHaltCount >= 0
        && request.resource.data.visionSpendUSD is number
        && request.resource.data.visionSpendUSD >= 0
        && request.resource.data.manifestHashHex is string
        && request.resource.data.manifestHashHex.matches("^[A-Fa-f0-9]{64}$")
        && (!("auditHeadHashHex" in request.resource.data) || (request.resource.data.auditHeadHashHex is string && request.resource.data.auditHeadHashHex.matches("^[A-Fa-f0-9]{64}$")))
        && request.resource.data.macAppVersion is string
        && request.resource.data.macAppVersion.size() <= 80
        && request.resource.data.schemaVersion is int
        && request.resource.data.schemaVersion >= 1
        && request.resource.data.schemaVersion <= 100
        && (!("updatedAt" in request.resource.data) || request.resource.data.updatedAt is timestamp);
    }

    function validComputerUseSessionUpdate(userId, sessionId) {
      return request.resource.data.keys().hasOnly([
          "id",
          "sessionId",
          "userId",
          "mode",
          "trustMode",
          "startedAt",
          "endedAt",
          "endReason",
          "actionCount",
          "approvalCount",
          "rejectionCount",
          "panicHaltCount",
          "visionSpendUSD",
          "manifestHashHex",
          "auditHeadHashHex",
          "macAppVersion",
          "schemaVersion",
          "updatedAt",
          "quotaStartMeteredEventId",
          "quotaStartMeteredDayKey",
          "quotaStartMeteredAt",
          "quotaCompletionMeteredEventId",
          "quotaCompletionMeteredDayKey",
          "quotaCompletionMeteredAt"
        ])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "endedAt",
          "endReason",
          "actionCount",
          "approvalCount",
          "rejectionCount",
          "panicHaltCount",
          "visionSpendUSD",
          "auditHeadHashHex",
          "updatedAt"
        ])
        && (!("id" in request.resource.data) || request.resource.data.id == sessionId)
        && request.resource.data.sessionId == resource.data.sessionId
        && request.resource.data.userId == userId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.mode == resource.data.mode
        && request.resource.data.trustMode == resource.data.trustMode
        && request.resource.data.startedAt == resource.data.startedAt
        && request.resource.data.manifestHashHex == resource.data.manifestHashHex
        && request.resource.data.macAppVersion == resource.data.macAppVersion
        && request.resource.data.schemaVersion == resource.data.schemaVersion
        && (!("endedAt" in request.resource.data) || request.resource.data.endedAt is timestamp)
        && (!("endReason" in request.resource.data) || request.resource.data.endReason in [
          "completed",
          "user_halt",
          "panic_hotkey",
          "panic_phone_gesture",
          "panic_mac_lock",
          "panic_remote_config",
          "panic_accessibility_revoked",
          "timeout",
          "entitlement_lost",
          "budget_soft_cap",
          "budget_hard_cap",
          "error"
        ])
        && request.resource.data.actionCount is int
        && request.resource.data.actionCount >= resource.data.actionCount
        && request.resource.data.approvalCount is int
        && request.resource.data.approvalCount >= resource.data.approvalCount
        && request.resource.data.rejectionCount is int
        && request.resource.data.rejectionCount >= resource.data.rejectionCount
        && request.resource.data.panicHaltCount is int
        && request.resource.data.panicHaltCount >= resource.data.panicHaltCount
        && request.resource.data.visionSpendUSD is number
        && request.resource.data.visionSpendUSD >= resource.data.visionSpendUSD
        && (!("auditHeadHashHex" in request.resource.data) || (request.resource.data.auditHeadHashHex is string && request.resource.data.auditHeadHashHex.matches("^[A-Fa-f0-9]{64}$")))
        && (!("updatedAt" in request.resource.data) || request.resource.data.updatedAt is timestamp);
    }

    function validComputerUseActionDocument(actionId) {
      return request.resource.data.keys().hasOnly([
          "id",
          "sessionId",
          "entryIndex",
          "toolKind",
          "actionKind",
          "status",
          "approvedBy",
          "scopeRuleId",
          "denyReason",
          "parentEntryHashHex",
          "approvalLatencyMillis",
          "visionTokensCostUSD",
          "recordedAt",
          "schemaVersion"
        ])
        && request.resource.data.id == actionId
        && request.resource.data.sessionId is string
        && request.resource.data.sessionId.size() > 0
        && request.resource.data.sessionId.size() <= 200
        && request.resource.data.entryIndex is int
        && request.resource.data.entryIndex >= 0
        && request.resource.data.toolKind is string
        && request.resource.data.toolKind.size() <= 120
        && request.resource.data.actionKind is string
        && request.resource.data.actionKind.size() <= 120
        && request.resource.data.status in [
          "executed", "denied", "rejected", "awaiting_approval", "error"
        ]
        && request.resource.data.approvedBy in [
          "mac", "phone", "trusted_scope", "step", "denied", "panic"
        ]
        && (!("scopeRuleId" in request.resource.data) || (request.resource.data.scopeRuleId is string && request.resource.data.scopeRuleId.size() <= 200))
        && (!("denyReason" in request.resource.data) || (request.resource.data.denyReason is string && request.resource.data.denyReason.size() <= 200))
        && request.resource.data.parentEntryHashHex is string
        && request.resource.data.parentEntryHashHex.matches("^[A-Fa-f0-9]{64}$")
        && (!("approvalLatencyMillis" in request.resource.data) || (request.resource.data.approvalLatencyMillis is int && request.resource.data.approvalLatencyMillis >= 0))
        && (!("visionTokensCostUSD" in request.resource.data) || (request.resource.data.visionTokensCostUSD is number && request.resource.data.visionTokensCostUSD >= 0 && request.resource.data.visionTokensCostUSD <= 25))
        && request.resource.data.recordedAt is timestamp
        && request.resource.data.schemaVersion is int
        && request.resource.data.schemaVersion >= 1
        && request.resource.data.schemaVersion <= 100;
    }

    function validRootUserProfileWrite(userId) {
      let d = request.resource.data;
      return ownerWritableNonSecret(userId)
        && d.keys().hasOnly([
          "uid",
          "displayName",
          "email",
          "photoURL",
          "avatarURL",
          "createdAt",
          "updatedAt",
          "lastSeenAt",
          "sourceDeviceId",
          "deviceId",
          "platform",
          "appVersion",
          "timezone",
          "locale",
          "settingsVersion",
          "schemaVersion"
        ])
        && (!("uid" in d) || d.uid == userId)
        && (!("displayName" in d) || (d.displayName is string && d.displayName.size() <= 200))
        && (!("email" in d) || (d.email is string && d.email.size() <= 320))
        && (!("photoURL" in d) || (d.photoURL is string && d.photoURL.size() <= 2000))
        && (!("avatarURL" in d) || (d.avatarURL is string && d.avatarURL.size() <= 2000))
        && (!("createdAt" in d) || d.createdAt is timestamp)
        && (!("updatedAt" in d) || d.updatedAt is timestamp)
        && (!("lastSeenAt" in d) || d.lastSeenAt is timestamp)
        && (!("sourceDeviceId" in d) || (d.sourceDeviceId is string && d.sourceDeviceId.size() <= 256))
        && (!("deviceId" in d) || (d.deviceId is string && d.deviceId.size() <= 256))
        && (!("platform" in d) || (d.platform is string && d.platform.size() <= 80))
        && (!("appVersion" in d) || (d.appVersion is string && d.appVersion.size() <= 80))
        && (!("timezone" in d) || (d.timezone is string && d.timezone.size() <= 120))
        && (!("locale" in d) || (d.locale is string && d.locale.size() <= 40))
        && (!("settingsVersion" in d) || (d.settingsVersion is int && d.settingsVersion >= 1 && d.settingsVersion <= 10000))
        && (!("schemaVersion" in d) || (d.schemaVersion is int && d.schemaVersion >= 1 && d.schemaVersion <= 100));
    }

    function validPixelClockConfig(pixelClock) {
      return pixelClock is map
        && pixelClock.keys().hasOnly([
          "enabled",
          "host",
          "port",
          "layout",
          "palette",
          "timePeriod",
          "workingSpinnerStyle",
          "workingSpinnerPrimaryHex",
          "workingSpinnerSecondaryHex",
          "completionClockSoundEnabled",
          "completionLocalNotificationsEnabled",
          "pageDurationSeconds",
          "updateIntervalSeconds",
          "scrollSpeedPercent",
          "brightness",
          "providerIDs",
          "updatedAt",
          "updatedByDeviceId",
          "lastProbeStatus"
        ])
        && pixelClock.enabled is bool
        && pixelClock.host is string
        && pixelClock.host.size() <= 255
        && pixelClock.port is int
        && pixelClock.port >= 1
        && pixelClock.port <= 65535
        && pixelClock.layout in ["providerDashboard", "quotaCarousel", "burnStatus", "alertsOnly"]
        && pixelClock.palette in ["emberWhimsy", "mercury", "traffic", "monochrome", "rainbow"]
        && pixelClock.timePeriod in ["rolling5h", "rolling24h", "rolling7d", "rolling30d"]
        && (!("workingSpinnerStyle" in pixelClock) || pixelClock.workingSpinnerStyle in ["orbit", "chase", "pulse", "scan"])
        && (!("workingSpinnerPrimaryHex" in pixelClock) || (pixelClock.workingSpinnerPrimaryHex is string && pixelClock.workingSpinnerPrimaryHex.matches("^#[0-9A-Fa-f]{6}$")))
        && (!("workingSpinnerSecondaryHex" in pixelClock) || (pixelClock.workingSpinnerSecondaryHex is string && pixelClock.workingSpinnerSecondaryHex.matches("^#[0-9A-Fa-f]{6}$")))
        && (!("completionClockSoundEnabled" in pixelClock) || pixelClock.completionClockSoundEnabled is bool)
        && (!("completionLocalNotificationsEnabled" in pixelClock) || pixelClock.completionLocalNotificationsEnabled is bool)
        && pixelClock.pageDurationSeconds is int
        && pixelClock.pageDurationSeconds >= 3
        && pixelClock.pageDurationSeconds <= 30
        && pixelClock.updateIntervalSeconds is int
        && pixelClock.updateIntervalSeconds >= 15
        && pixelClock.updateIntervalSeconds <= 3600
        && pixelClock.scrollSpeedPercent is int
        && pixelClock.scrollSpeedPercent >= 10
        && pixelClock.scrollSpeedPercent <= 300
        && (!("brightness" in pixelClock) || (
          pixelClock.brightness is int
          && pixelClock.brightness >= 0
          && pixelClock.brightness <= 255
        ))
        && pixelClock.providerIDs is list
        && pixelClock.providerIDs.size() <= 24
        && pixelClock.lastProbeStatus in ["unknown", "awtrixReady", "stockUlanziFirmware", "unreachable", "unsupported", "error"]
        && (!("updatedByDeviceId" in pixelClock) || (pixelClock.updatedByDeviceId is string && pixelClock.updatedByDeviceId.size() <= 160));
    }

    function validSmartHubDisplayConfig(displayConfig) {
      return displayConfig is map
        && displayConfig.keys().hasOnly([
          "layout",
          "palette",
          "theme",
          "background",
          "brightness",
          "scrollSpeedSeconds",
          "refreshCadenceSeconds",
          "providerIDs",
          "audibleCue",
          "identifyOnRefresh",
          "updatedAt"
        ])
        && displayConfig.layout in ["quotaCarousel", "bigTotal", "providerGrid", "singleProvider"]
        && displayConfig.palette in ["emberWhimsy", "mercury", "forestSage", "monochrome", "rainbow"]
        && displayConfig.theme in ["warmCharcoal", "botanicalCream", "oledBlack", "matchSystem"]
        && displayConfig.background in ["dashboard", "ambient", "photoBlend"]
        && displayConfig.brightness is number
        && displayConfig.brightness >= 0.2
        && displayConfig.brightness <= 1.0
        && displayConfig.scrollSpeedSeconds is int
        && displayConfig.scrollSpeedSeconds >= 3
        && displayConfig.scrollSpeedSeconds <= 30
        && displayConfig.refreshCadenceSeconds is int
        && displayConfig.refreshCadenceSeconds >= 3
        && displayConfig.refreshCadenceSeconds <= 60
        && displayConfig.providerIDs is list
        && displayConfig.providerIDs.size() <= 24
        && displayConfig.audibleCue is bool
        && displayConfig.identifyOnRefresh is bool
        && displayConfig.updatedAt is string
        && displayConfig.updatedAt.size() <= 64;
    }

    function validSmartDisplayOrder(displayOrder) {
      return displayOrder is list
        && displayOrder.size() <= 4
        && displayOrder.hasOnly(["nestHub", "pixelClock"]);
    }

    function hostedCloudEntitlementPath(userId) {
      return /databases/$(database)/documents/users/$(userId)/entitlements/hosted_quota_sync;
    }

    function burnBarProEntitlementPath(userId) {
      return /databases/$(database)/documents/users/$(userId)/entitlements/burnbar_pro;
    }

    function burnBarProMaxEntitlementPath(userId) {
      return /databases/$(database)/documents/users/$(userId)/entitlements/burnbar_pro_max;
    }

    function activePremiumEntitlementData(entitlement) {
      return entitlement.active == true
        // BEGIN GENERATED: entitlement-product-ids premium — do not hand-edit.
        // Source: packages/entitlements/src/catalog.ts (FIRESTORE_RULES_PRODUCT_ID_ALLOWLISTS.premium).
        // Regenerate: node tools/gen-rules-entitlements.mjs (CI drift gate: --check).
        && entitlement.productID in [
          "com.openburnbar.hostedQuotaSync.cloud.monthly",
          "com.openburnbar.hostedQuotaSync.monthly",
          "com.openburnbar.pro.monthly",
          "com.openburnbar.pro.annual",
          "com.openburnbar.proMax.bundle.monthly",
          "com.openburnbar.proMax.v2.monthly",
          "com.openburnbar.proMax.annual",
          "com.openburnbar.ultra.monthly",
          "com.openburnbar.ultra.annual",
          "com.openburnbar.ultra.annual.v2"
        ]
        // END GENERATED: entitlement-product-ids premium
        && entitlement.expireAt is timestamp
        && entitlement.expireAt > request.time;
    }

    function activeProMaxEntitlementData(entitlement) {
      return entitlement.active == true
        // BEGIN GENERATED: entitlement-product-ids proMax — do not hand-edit.
        // Source: packages/entitlements/src/catalog.ts (FIRESTORE_RULES_PRODUCT_ID_ALLOWLISTS.proMax).
        // Regenerate: node tools/gen-rules-entitlements.mjs (CI drift gate: --check).
        && entitlement.productID in [
          "com.openburnbar.proMax.bundle.monthly",
          "com.openburnbar.proMax.v2.monthly",
          "com.openburnbar.proMax.annual",
          "com.openburnbar.promax.v2.monthly",
          "com.openburnbar.promax.annual"
        ]
        // END GENERATED: entitlement-product-ids proMax
        && entitlement.expireAt is timestamp
        && entitlement.expireAt > request.time;
    }

    function activeUltraEntitlementData(entitlement) {
      return entitlement.active == true
        // BEGIN GENERATED: entitlement-product-ids ultra — do not hand-edit.
        // Source: packages/entitlements/src/catalog.ts (FIRESTORE_RULES_PRODUCT_ID_ALLOWLISTS.ultra).
        // Regenerate: node tools/gen-rules-entitlements.mjs (CI drift gate: --check).
        && entitlement.productID in [
          "com.openburnbar.ultra.monthly",
          "com.openburnbar.ultra.annual",
          "com.openburnbar.ultra.annual.v2"
        ]
        // END GENERATED: entitlement-product-ids ultra
        && entitlement.expireAt is timestamp
        && entitlement.expireAt > request.time;
    }

    function activeProMaxOrUltraEntitlementData(entitlement) {
      return activeProMaxEntitlementData(entitlement)
        || activeUltraEntitlementData(entitlement);
    }

    function hasActiveHostedQuotaEntitlement(userId) {
      return (
          exists(hostedCloudEntitlementPath(userId))
          && activePremiumEntitlementData(get(hostedCloudEntitlementPath(userId)).data)
        )
        || (
          exists(burnBarProEntitlementPath(userId))
          && activePremiumEntitlementData(get(burnBarProEntitlementPath(userId)).data)
        )
        || (
          exists(burnBarProMaxEntitlementPath(userId))
          && activeProMaxOrUltraEntitlementData(get(burnBarProMaxEntitlementPath(userId)).data)
        );
    }

    // --- The Wand: per-tier parallel fan-out cap ---
    // The unforgeable ceiling on how many child missions a single Wand cast may
    // fan out (mirrors WandFanOut.maxParallel in OpenBurnBarCore + the website
    // site.ts ladder). Free 1 / Cloud 3 / Cloud Pro 8 / Ultra 16. Checked
    // top-down so an Ultra user (who may hold only the burnbar_ultra doc) is
    // never undercounted. Entitlement docs are cached per-evaluation; missing
    // entitlement docs intentionally fall back to the Free cap of 1.
    // VERIFIED by firestore-rules-tests/wand-fanout-cap.test.js (emulator): each
    // tier allows AT its cap and denies OVER it, and the helper get-budget does
    // not break otherwise-valid mission_group writes.
    // DEPLOY ORDER (launch gate): the Free cap of 1 is below the in-app fan-out
    // floor (FanOutComposerSheet enforces >= 2), so deploying this cap BEFORE the
    // in-app Wand gate would deny every existing free-tier fan-out write. Ship the
    // rules cap and the UI gate together, never the rules cap alone.
    function burnBarUltraEntitlementPath(userId) {
      return /databases/$(database)/documents/users/$(userId)/entitlements/burnbar_ultra;
    }

    function hasActiveUltraEntitlement(userId) {
      return exists(burnBarUltraEntitlementPath(userId))
        && activeUltraEntitlementData(get(burnBarUltraEntitlementPath(userId)).data);
    }

    function hasActiveProMaxEntitlement(userId) {
      return exists(burnBarProMaxEntitlementPath(userId))
        && activeProMaxEntitlementData(get(burnBarProMaxEntitlementPath(userId)).data);
    }

    function hasActiveDataVaultEntitlement(userId) {
      return hasActiveProMaxEntitlement(userId)
        || hasActiveUltraEntitlement(userId);
    }

    function wandFanOutCap(userId) {
      // BEGIN GENERATED: wand-parallel-caps — do not hand-edit.
      // Source: packages/entitlements/src/catalog.ts (WAND_PARALLEL_CAPS).
      // Regenerate: node tools/gen-rules-entitlements.mjs (CI drift gate: --check).
      return hasActiveUltraEntitlement(userId) ? 16
        : hasActiveProMaxEntitlement(userId) ? 8
        : hasActiveHostedQuotaEntitlement(userId) ? 3
        : 1;
      // END GENERATED: wand-parallel-caps
    }

    // --- Mercury media entitlement (Phase 2 SKU rollout) ---
    // Mirrors `hasActiveHostedQuotaEntitlement` for the new
    // `hosted_media_sync` SKU. The Mac is the source of truth at session
    // time (Decision 2), but the rules-side helper is what gates the
    // owner-writable metadata collections (`media_attachment_manifests`,
    // `media_session_events`).
    function hostedMediaEntitlementPath(userId) {
      return /databases/$(database)/documents/users/$(userId)/entitlements/hosted_media_sync;
    }

    function activeMediaEntitlementData(entitlement) {
      return entitlement.active == true
        // BEGIN GENERATED: entitlement-product-ids media — do not hand-edit.
        // Source: packages/entitlements/src/catalog.ts (FIRESTORE_RULES_PRODUCT_ID_ALLOWLISTS.media).
        // Regenerate: node tools/gen-rules-entitlements.mjs (CI drift gate: --check).
        && entitlement.productID in [
          "com.openburnbar.hostedMediaSync.monthly",
          "com.openburnbar.proMax.bundle.monthly",
          "com.openburnbar.proMax.v2.monthly",
          "com.openburnbar.proMax.annual",
          "com.openburnbar.ultra.monthly",
          "com.openburnbar.ultra.annual",
          "com.openburnbar.ultra.annual.v2"
        ]
        // END GENERATED: entitlement-product-ids media
        && entitlement.expireAt is timestamp
        && entitlement.expireAt > request.time;
    }

    function hasActiveHostedMediaEntitlement(userId) {
      return (
          exists(hostedMediaEntitlementPath(userId))
          && activeMediaEntitlementData(get(hostedMediaEntitlementPath(userId)).data)
        )
        || (
          exists(burnBarProMaxEntitlementPath(userId))
          && activeProMaxOrUltraEntitlementData(get(burnBarProMaxEntitlementPath(userId)).data)
        );
    }

    // Computer Use entitlement helpers. Phase 9 ships
    // `hosted_computer_use_sync` as a separate SKU; the `pro_max`
    // umbrella bundles it. See
    // `plans/2026-05-16-computer-use-master-plan.md` § E.1.
    function hostedComputerUseEntitlementPath(userId) {
      return /databases/$(database)/documents/users/$(userId)/entitlements/hosted_computer_use_sync;
    }

    function activeComputerUseEntitlementData(entitlement) {
	      return entitlement.active == true
	        // BEGIN GENERATED: entitlement-product-ids computerUse — do not hand-edit.
	        // Source: packages/entitlements/src/catalog.ts (FIRESTORE_RULES_PRODUCT_ID_ALLOWLISTS.computerUse).
	        // Regenerate: node tools/gen-rules-entitlements.mjs (CI drift gate: --check).
	        && entitlement.productID in [
	          "com.openburnbar.computerUse.monthly",
	          "com.openburnbar.hostedComputerUseSync.monthly",
	          "com.openburnbar.proMax.bundle.monthly",
	          "com.openburnbar.proMax.v2.monthly",
	          "com.openburnbar.proMax.annual",
	          "com.openburnbar.ultra.monthly",
	          "com.openburnbar.ultra.annual",
	          "com.openburnbar.ultra.annual.v2"
	        ]
	        // END GENERATED: entitlement-product-ids computerUse
        && entitlement.expireAt is timestamp
        && entitlement.expireAt > request.time;
    }

    function hasActiveHostedComputerUseEntitlement(userId) {
      return (
          exists(hostedComputerUseEntitlementPath(userId))
          && activeComputerUseEntitlementData(get(hostedComputerUseEntitlementPath(userId)).data)
        )
        || (
          exists(burnBarProMaxEntitlementPath(userId))
          && activeProMaxOrUltraEntitlementData(get(burnBarProMaxEntitlementPath(userId)).data)
        );
    }

    function ownerWritableHostedCloudBackup(userId) {
      return ownerWritableNonSecret(userId)
        && hasActiveHostedQuotaEntitlement(userId);
    }

    // Strict allowlist for encrypted session-log manifest creates. Full uploads
    // use setData(merge: false), while later merge:true writes are restricted to
    // facet refresh plus legacy plaintext field deletes by validSessionLogRefreshKeys().
    // No content/title/project text can ride along — only sealed envelopes,
    // storage pointers, hashes, and bounded cockpit facets.
    function validSessionLogManifestKeys() {
      return request.resource.data.keys().hasOnly([
        "id",
        "deviceId",
        "provider",
        "sessionId",
        "sourceType",
        "inferredTaskTitle",
        "bodyStorage",
        "storagePath",
        "sealedTitle",
        "sealedBodyPreview",
        "encryption",
        "vaultKeyID",
        "chunkCount",
        "searchChunkCount",
        "byteCount",
        "encryptedByteCount",
        "bodyHash",
        "bodyHashVersion",
        "chunkSize",
        "chunkHashes",
        "chunkHashVersion",
        "chunkMetadataVersion",
        "cloudSearchIndexVersion",
        "cloudSearchIndexedAt",
        "updatedAt",
        "startTime",
        "endTime",
        "facetSchemaVersion",
        "model",
        "messageCount",
        "userWordCount",
        "assistantWordCount",
        "inputTokens",
        "outputTokens",
        "cacheCreationTokens",
        "cacheReadTokens",
        "totalTokens",
        "costUSD",
        "toolTags",
        "durationSeconds"
      ]);
    }

    function validSessionLogSealedTextAt(userId, logId, field, value) {
      return value is map
        && value.keys().hasOnly([
          "schemaVersion",
          "algorithm",
          "keyVersion",
          "nonce",
          "ciphertext",
          "tag",
          "aad"
        ])
        && value.schemaVersion == 2
        && value.algorithm == "AES-256-GCM"
        && value.keyVersion is int
        && value.keyVersion >= 1
        && value.keyVersion <= 100
        && value.nonce is string
        && value.nonce.size() > 0
        && value.nonce.size() <= 128
        && value.ciphertext is string
        && value.ciphertext.size() > 0
        && value.ciphertext.size() <= 8192
        && value.tag is string
        && value.tag.size() > 0
        && value.tag.size() <= 128
        && value.aad == cloudVaultAADContext(userId, "session_logs", logId, field);
    }

    function sessionLogPostWriteHasNoPlaintextFields(data) {
      return !data.keys().hasAny([
        "body",
        "payloadCiphertext",
        "ciphertext",
        "data",
        "text",
        "title",
        "snippet",
        "terms",
        "projectName",
        "workingDirectory",
        "userPrompt",
        "summary",
        "command",
        "keystrokes",
        "clipboard",
        "transcript",
        "messages",
        "lastAssistantMessage",
        "keyCommands",
        "keyFiles",
        "keyTools",
        "url",
        "selector",
        "screenshot"
      ]);
    }

    function validSessionLogManifestCore(userId, logId) {
      return validSessionLogManifestKeys()
        && request.resource.data.get("inferredTaskTitle", "Encrypted session") == "Encrypted session"
        && (!("sealedTitle" in request.resource.data) || validSessionLogSealedTextAt(userId, logId, "sealedTitle", request.resource.data.sealedTitle))
        && (!("sealedBodyPreview" in request.resource.data) || validSessionLogSealedTextAt(userId, logId, "sealedBodyPreview", request.resource.data.sealedBodyPreview))
        && (!("encryption" in request.resource.data) || request.resource.data.encryption is map)
        && (!("vaultKeyID" in request.resource.data) || validVaultKeyID(request.resource.data.vaultKeyID))
        && validSessionLogFacets(request.resource.data);
    }

    function validSessionLogLifecycleFields(data) {
      let deletedAt = data.get("deletedAt", request.time);
      let version = data.get("version", 1);
      return deletedAt is timestamp
        && version is int
        && version >= 1;
    }

    function sessionLogTombstoneIsSticky() {
      return !("deletedAt" in resource.data) || ("deletedAt" in request.resource.data);
    }

    function ownerWritableSessionLogManifestCreate(userId, logId) {
      return ownerWritableHostedCloudBackup(userId)
        && validSessionLogManifestCore(userId, logId);
    }

    function validSessionLogRefreshKeys() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "body",
        "payloadCiphertext",
        "ciphertext",
        "data",
        "text",
        "title",
        "snippet",
        "terms",
        "projectName",
        "workingDirectory",
        "facetSchemaVersion",
        "model",
        "messageCount",
        "userWordCount",
        "assistantWordCount",
        "inputTokens",
        "outputTokens",
        "cacheCreationTokens",
        "cacheReadTokens",
        "totalTokens",
        "costUSD",
        "durationSeconds",
        "deletedAt",
        "version",
        "toolTags",
        "updatedAt"
      ]);
    }

    function ownerWritableSessionLogManifestRefresh(userId) {
      return ownerWritableHostedCloudBackup(userId)
        && validSessionLogRefreshKeys()
        && sessionLogPostWriteHasNoPlaintextFields(request.resource.data)
        && validSessionLogLifecycleFields(request.resource.data)
        && sessionLogTombstoneIsSticky()
        && validSessionLogFacets(request.resource.data);
    }

    // Plaintext cockpit facets are metadata only. The strict manifest allowlist and
    // denylist carry the confidentiality boundary; keep these checks deliberately
    // light so legitimate encrypted manifests stay within Firestore's rule
    // evaluator budget.
    function validOptionalInt(data, field) {
      let value = data.get(field, 0);
      return value is int && value >= 0;
    }

    function validSessionLogToolTags(data) {
      let toolTags = data.get("toolTags", []);
      return toolTags is list
        && toolTags.size() <= 12
        && toolTags.hasOnly([
          "apply_patch",
          "bash",
          "edit",
          "exec_command",
          "find",
          "grep_search",
          "multi_edit",
          "other",
          "read",
          "rg",
          "search",
          "sed",
          "shell",
          "write"
        ]);
    }

    function validSessionLogFacets(data) {
      let model = data.get("model", "");
      let provider = data.get("provider", "");
      let sourceType = data.get("sourceType", "");
      let costUSD = data.get("costUSD", 0);
      return model is string && model.size() <= 200
        && provider is string && provider.size() <= 80
        && sourceType is string && sourceType.size() <= 80
        && validSessionLogToolTags(data)
        && costUSD is number && costUSD >= 0
        && validOptionalInt(data, "inputTokens")
        && validOptionalInt(data, "outputTokens")
        && validOptionalInt(data, "cacheCreationTokens")
        && validOptionalInt(data, "cacheReadTokens")
        && validOptionalInt(data, "totalTokens")
        && validOptionalInt(data, "messageCount")
        && validOptionalInt(data, "userWordCount")
        && validOptionalInt(data, "assistantWordCount")
        && validOptionalInt(data, "durationSeconds")
        && validOptionalInt(data, "facetSchemaVersion");
    }


    function validCloudHexDigest(value) {
      return value is string
        && value.matches("^[a-f0-9]{32,128}$");
    }

    function validMemorySourceRefHmac(value) {
      return value is string
        && value.matches("^[a-f0-9]{64}$");
    }

    function validMemoryOpaqueId(value) {
      return validMemorySourceRefHmac(value);
    }

    function validMemorySourceRefHmacAt(values, position) {
      return values.size() <= position || validMemorySourceRefHmac(values[position]);
    }

    function validMemorySourceRefHmacs0to9(values) {
      return validMemorySourceRefHmacAt(values, 0)
        && validMemorySourceRefHmacAt(values, 1)
        && validMemorySourceRefHmacAt(values, 2)
        && validMemorySourceRefHmacAt(values, 3)
        && validMemorySourceRefHmacAt(values, 4)
        && validMemorySourceRefHmacAt(values, 5)
        && validMemorySourceRefHmacAt(values, 6)
        && validMemorySourceRefHmacAt(values, 7)
        && validMemorySourceRefHmacAt(values, 8)
        && validMemorySourceRefHmacAt(values, 9);
    }

    function validMemorySourceRefHmacs10to19(values) {
      return validMemorySourceRefHmacAt(values, 10)
        && validMemorySourceRefHmacAt(values, 11)
        && validMemorySourceRefHmacAt(values, 12)
        && validMemorySourceRefHmacAt(values, 13)
        && validMemorySourceRefHmacAt(values, 14)
        && validMemorySourceRefHmacAt(values, 15)
        && validMemorySourceRefHmacAt(values, 16)
        && validMemorySourceRefHmacAt(values, 17)
        && validMemorySourceRefHmacAt(values, 18)
        && validMemorySourceRefHmacAt(values, 19);
    }

    function validMemorySourceRefHmacs20to29(values) {
      return validMemorySourceRefHmacAt(values, 20)
        && validMemorySourceRefHmacAt(values, 21)
        && validMemorySourceRefHmacAt(values, 22)
        && validMemorySourceRefHmacAt(values, 23)
        && validMemorySourceRefHmacAt(values, 24)
        && validMemorySourceRefHmacAt(values, 25)
        && validMemorySourceRefHmacAt(values, 26)
        && validMemorySourceRefHmacAt(values, 27)
        && validMemorySourceRefHmacAt(values, 28)
        && validMemorySourceRefHmacAt(values, 29);
    }

    function validMemorySourceRefHmacs30to39(values) {
      return validMemorySourceRefHmacAt(values, 30)
        && validMemorySourceRefHmacAt(values, 31)
        && validMemorySourceRefHmacAt(values, 32)
        && validMemorySourceRefHmacAt(values, 33)
        && validMemorySourceRefHmacAt(values, 34)
        && validMemorySourceRefHmacAt(values, 35)
        && validMemorySourceRefHmacAt(values, 36)
        && validMemorySourceRefHmacAt(values, 37)
        && validMemorySourceRefHmacAt(values, 38)
        && validMemorySourceRefHmacAt(values, 39);
    }

    function validMemorySourceRefHmacs40to49(values) {
      return validMemorySourceRefHmacAt(values, 40)
        && validMemorySourceRefHmacAt(values, 41)
        && validMemorySourceRefHmacAt(values, 42)
        && validMemorySourceRefHmacAt(values, 43)
        && validMemorySourceRefHmacAt(values, 44)
        && validMemorySourceRefHmacAt(values, 45)
        && validMemorySourceRefHmacAt(values, 46)
        && validMemorySourceRefHmacAt(values, 47)
        && validMemorySourceRefHmacAt(values, 48)
        && validMemorySourceRefHmacAt(values, 49);
    }

    function validMemorySourceRefHmacs(values) {
      return values is list
        && values.size() <= 50
        && (
          (
            values.size() <= 10
            && validMemorySourceRefHmacs0to9(values)
          )
          || (
            values.size() <= 20
            && validMemorySourceRefHmacs0to9(values)
            && validMemorySourceRefHmacs10to19(values)
          )
          || (
            values.size() <= 30
            && validMemorySourceRefHmacs0to9(values)
            && validMemorySourceRefHmacs10to19(values)
            && validMemorySourceRefHmacs20to29(values)
          )
          || (
            values.size() <= 40
            && validMemorySourceRefHmacs0to9(values)
            && validMemorySourceRefHmacs10to19(values)
            && validMemorySourceRefHmacs20to29(values)
            && validMemorySourceRefHmacs30to39(values)
          )
          || (
            validMemorySourceRefHmacs0to9(values)
            && validMemorySourceRefHmacs10to19(values)
            && validMemorySourceRefHmacs20to29(values)
            && validMemorySourceRefHmacs30to39(values)
            && validMemorySourceRefHmacs40to49(values)
          )
        );
    }

    function cloudVaultAADContext(userId, collection, docID, field) {
      return "OpenBurnBar-CloudVault-aad-v2|" + userId + "|" + collection + "|" + docID + "|" + field + "|2|" + field;
    }

    function roamingProfileAADContext(userId) {
      return "OpenBurnBar-CloudVault-aad-v2|"
        + userId
        + "|roaming_profile|current|sealedPayload|2|OpenBurnBar-RoamingProfile-v1";
    }

    function validCloudVaultAAD(value) {
      return value is string
        && value.matches("^OpenBurnBar-CloudVault-aad-v2\\|[^|]+\\|[^|]+\\|[^|]+\\|[^|]+\\|[2-9][0-9]*\\|[^|]+$");
    }

    function validCloudSealedTextAt(userId, collection, docID, field, value) {
      return value is map
        && value.keys().hasOnly([
          "schemaVersion",
          "algorithm",
          "keyVersion",
          "nonce",
          "ciphertext",
          "tag",
          "aad"
        ])
        && value.schemaVersion is int
        && value.schemaVersion >= 2
        && value.schemaVersion <= 10
        && value.algorithm == "AES-256-GCM"
        && value.keyVersion is int
        && value.keyVersion >= 1
        && value.keyVersion <= 100
        && value.nonce is string
        && value.nonce.size() <= 128
        && value.nonce.matches("^[A-Za-z0-9+/=]+$")
        && value.ciphertext is string
        && value.ciphertext.size() <= 8192
        && value.ciphertext.matches("^[A-Za-z0-9+/=]+$")
        && value.tag is string
        && value.tag.size() <= 128
        && value.tag.matches("^[A-Za-z0-9+/=]+$")
        && value.aad == cloudVaultAADContext(userId, collection, docID, field);
    }

    // CloudVaultBlobEnvelopeDoc (sealed binary blob, larger than sealed text).
    // Used by project_memory_snapshots.sealedSnapshot. Mirrors the Swift/TS
    // CloudVaultCrypto blob envelope shape — never invent a new one.
    function validCloudSealedBlob(value, expectedAAD) {
      return value is map
        && value.keys().hasOnly([
          "schemaVersion",
          "algorithm",
          "keyVersion",
          "plaintextSHA256",
          "plaintextHMAC",
          "integrityHashVersion",
          "sealedBoxBase64",
          "createdAt",
          "aad"
        ])
        && value.schemaVersion is int
        && value.schemaVersion >= 1
        && value.schemaVersion <= 10
        && value.algorithm == "AES-256-GCM"
        && value.keyVersion is int
        && value.keyVersion >= 1
        && value.keyVersion <= 100
        && (
          (
            value.schemaVersion == 1
            && validCloudHexDigest(value.plaintextSHA256)
            && !("plaintextHMAC" in value)
            && !("integrityHashVersion" in value)
            && !("aad" in value)
          )
          || (
            value.schemaVersion >= 2
            && !("plaintextSHA256" in value)
            && validCloudHexDigest(value.plaintextHMAC)
            && value.integrityHashVersion is int
            && value.integrityHashVersion >= 1
            && value.integrityHashVersion <= 100
            && value.aad == expectedAAD
          )
        )
        && value.sealedBoxBase64 is string
        && value.sealedBoxBase64.size() > 0
        && value.sealedBoxBase64.size() <= 900000
        && value.sealedBoxBase64.matches("^[A-Za-z0-9+/=]+$");
    }

    function validVaultKeyID(value) {
      return value is string
        && value.matches("^v1_[a-f0-9]{32}$");
    }

    function validCloudSealedPayload(value) {
      return value is map
        && value.keys().hasOnly([
          "schemaVersion",
          "algorithm",
          "keyVersion",
          "vaultKeyID",
          "sealedBoxBase64",
          "aad"
        ])
        && value.schemaVersion == 2
        && value.algorithm == "AES-256-GCM"
        && value.keyVersion is int
        && value.keyVersion >= 1
        && value.keyVersion <= 100
        && validVaultKeyID(value.vaultKeyID)
        && (
          value.aad == "OpenBurnBar-CloudVaultSealedPayload-v2"
          || validCloudVaultAAD(value.aad)
        )
        && value.sealedBoxBase64 is string
        && value.sealedBoxBase64.size() > 0
        && value.sealedBoxBase64.size() <= 900000
        && value.sealedBoxBase64.matches("^[A-Za-z0-9+/=]+$");
    }

    // ---- Signal at-rest CloudVault envelopes ------------------------------------
    // Legacy per-collection validators keep using `forbidsDirectSignalEnvelope`
    // so their compatibility path cannot accidentally accept a mixed shape. The
    // ten exact Signal mirror matches below authorize a separately validated,
    // path-bound `signalEnvelope` with no cleartext private fields. Rules cannot
    // verify Ed25519 signatures or iterate every recipient wrap; the Admin/callable
    // path validates every wrap, while clients verify sender auth cryptographically.
    function forbidsDirectSignalEnvelope() {
      return !("signalEnvelope" in request.resource.data);
    }

    // T-AZ-04: belt-and-suspenders plaintext-content ban for sealed collections.
    // Each sealed collection already pins an exact `hasOnly(...)` allowlist, so an
    // unknown field is rejected outright. This helper is the additional, explicit
    // denylist of the cleartext content/title/body field names a sealed mirror
    // must NEVER carry — it mirrors the per-collection denylists already inlined
    // on `conversations`/`mission_groups`/`cli_agent_mission_events`/`chat_threads`
    // and the session-log manifest, so every sealed collection enforces the SAME
    // shape and a future allowlist edit cannot silently re-admit a plaintext key.
    // NOTE: this is a rules-side defense-in-depth measure only. Full no-plaintext
    // also depends on client correctness — producers must seal content into the
    // `sealedPayload` envelope and never serialize the cleartext into Firestore
    // (independently validated by the Swift/TS unit tests).
    function forbidsSealedPlaintextContentFields() {
      return !request.resource.data.keys().hasAny([
        "body",
        "text",
        "title",
        "preview",
        "message",
        "messages",
        "fullMessage",
        "snippet",
        "summary",
        "summaryTitle",
        "content",
        "transcript",
        "prompt",
        "lastAssistantMessage",
        "projectName",
        "workingDirectory",
        "ciphertext",
        "payloadCiphertext"
      ]);
    }

    function validSignalBase64(value, maxLen) {
      return value is string
        && value.size() > 0
        && value.size() <= maxLen
        && value.size() % 4 == 0
        && value.matches("^[A-Za-z0-9+/]*={0,2}$");
    }

    // Direct-client Signal at-rest writes are allowed only through the exact
    // owner-scoped mirror gate below. Rules cannot verify Ed25519 signatures or
    // iterate every wrap, but they can enforce the zero-plaintext outer shape,
    // exact path binding, sender-auth wire lengths, and collection allowlists.
    // The Admin/callable path remains stricter and validates every wrap.
    function validDirectSignalAtRestEnvelope(userId, collectionId, documentId) {
      let value = ("signalEnvelope" in request.resource.data)
        ? request.resource.data.signalEnvelope
        : {};
      return value is map
        && value.keys().hasOnly([
          "signalEnvelopeFormatVersion", "mode", "relayEncryption",
          "ciphertextLayer", "keyDelivery", "binding", "senderAuth"
        ])
        && value.signalEnvelopeFormatVersion == 1
        && value.mode == "at-rest"
        && value.relayEncryption == "signal-hpke-identity-seal-v1"
        && value.ciphertextLayer is map
        && value.ciphertextLayer.keys().hasOnly(["payloadCiphertextB64", "payloadAADLabel", "schemaVersion"])
        && value.ciphertextLayer.payloadCiphertextB64 is string
        && value.ciphertextLayer.payloadCiphertextB64.size() > 0
        && value.ciphertextLayer.payloadCiphertextB64.size() <= 1100000
        && value.ciphertextLayer.payloadCiphertextB64.size() % 4 == 0
        && value.ciphertextLayer.payloadCiphertextB64.matches("^[A-Za-z0-9+/]*={0,2}$")
        && value.ciphertextLayer.payloadAADLabel is string
        && value.ciphertextLayer.payloadAADLabel.size() > 0
        && value.ciphertextLayer.payloadAADLabel.size() <= 120
        && value.ciphertextLayer.payloadAADLabel.matches("^[A-Za-z0-9:_-]+$")
        && value.ciphertextLayer.schemaVersion == 1
        && value.keyDelivery is map
        && value.keyDelivery.keys().hasOnly(["scheme", "wraps", "contentKeyLength"])
        && value.keyDelivery.scheme == "signal-hpke-identity-seal-v1"
        && value.keyDelivery.contentKeyLength == 32
        && value.keyDelivery.wraps is list
        && value.keyDelivery.wraps.size() >= 1
        && value.keyDelivery.wraps.size() <= 32
        && value.binding is map
        && value.binding.keys().hasOnly(["uid", "scope", "collection", "docId", "field", "mode", "formatVersion"])
        && value.binding.uid == userId
        && value.binding.scope == "cloudvault"
        && value.binding.collection == collectionId
        && value.binding.docId == documentId
        && value.binding.field == "signalEnvelope"
        && value.binding.mode == "at-rest"
        && value.binding.formatVersion == 1
        && value.senderAuth is map
        && value.senderAuth.keys().hasOnly(["senderIdentityKeyId", "senderIdentityKeyB64", "signatureB64", "signatureVersion"])
        && value.senderAuth.senderIdentityKeyId is string
        && value.senderAuth.senderIdentityKeyId.size() > 0
        && value.senderAuth.senderIdentityKeyId.size() <= 160
        && value.senderAuth.senderIdentityKeyB64 is string
        && value.senderAuth.senderIdentityKeyB64.size() == 44
        && value.senderAuth.senderIdentityKeyB64.matches("^[A-Za-z0-9+/]*={0,2}$")
        && value.senderAuth.signatureB64 is string
        && value.senderAuth.signatureB64.size() == 88
        && value.senderAuth.signatureB64.matches("^[A-Za-z0-9+/]*={0,2}$")
        && value.senderAuth.signatureVersion == 1;
    }

    // Fast, collection-scoped validator used only from the ten exact match
    // blocks below. Keep this function small: calling a dynamic ten-way branch
    // from the catch-all user-document match exhausts Firestore's expression
    // budget even for unrelated writes.
    function validSignalAtRestMirrorWrite(userId, collectionId, documentId, allowedKeys) {
      return ("signalEnvelope" in request.resource.data)
        ? (
          ownerWritableNonSecret(userId)
          && ((collectionId == "conversations" || collectionId == "chat_threads")
            ? hasActiveHostedQuotaEntitlement(userId)
            : true)
          && validDirectSignalAtRestEnvelope(userId, collectionId, documentId)
          && request.resource.data.keys().hasOnly(allowedKeys)
        )
        : false;
    }

    function matchesCurrentVaultKey(userId, vaultKeyID) {
      return validVaultKeyID(vaultKeyID)
        && exists(/databases/$(database)/documents/users/$(userId)/cloud_vault_state/current)
        && get(/databases/$(database)/documents/users/$(userId)/cloud_vault_state/current).data.vaultKeyID == vaultKeyID
        && get(/databases/$(database)/documents/users/$(userId)/cloud_vault_state/current).data.status == "active";
    }

    function validSealedPayloadForUser(userId, vaultKeyID, payload) {
      return matchesCurrentVaultKey(userId, vaultKeyID)
        && validCloudSealedPayload(payload)
        && payload.vaultKeyID == vaultKeyID;
    }

    function validPathBoundCloudSealedPayloadAt(userId, collection, docId, field, value) {
      return value is map
        && value.keys().hasOnly([
          "schemaVersion",
          "algorithm",
          "keyVersion",
          "vaultKeyID",
          "sealedBoxBase64",
          "aad"
        ])
        && value.schemaVersion == 2
        && value.algorithm == "AES-256-GCM"
        && value.keyVersion is int
        && value.keyVersion >= 1
        && value.keyVersion <= 100
        && validVaultKeyID(value.vaultKeyID)
        && value.aad == cloudVaultAADContext(userId, collection, docId, field)
        && value.sealedBoxBase64 is string
        && value.sealedBoxBase64.size() > 0
        && value.sealedBoxBase64.size() <= 900000
        && value.sealedBoxBase64.matches("^[A-Za-z0-9+/=]+$");
    }

    function validPathBoundCloudSealedPayload(userId, collection, docId, value) {
      return validPathBoundCloudSealedPayloadAt(userId, collection, docId, "sealedPayload", value);
    }

    function validRoamingProfileSealedPayload(userId, value) {
      return value is map
        && value.keys().hasOnly([
          "schemaVersion",
          "algorithm",
          "keyVersion",
          "vaultKeyID",
          "sealedBoxBase64",
          "aad"
        ])
        && value.schemaVersion == 2
        && value.algorithm == "AES-256-GCM"
        && value.keyVersion is int
        && value.keyVersion >= 1
        && value.keyVersion <= 100
        && validVaultKeyID(value.vaultKeyID)
        && matchesCurrentVaultKey(userId, value.vaultKeyID)
        && value.aad == roamingProfileAADContext(userId)
        && value.sealedBoxBase64 is string
        && value.sealedBoxBase64.size() > 0
        && value.sealedBoxBase64.size() <= 900000
        && value.sealedBoxBase64.matches("^[A-Za-z0-9+/=]+$");
