              && request.resource.data.targetSignalIdentityKeyId == resource.data.targetSignalIdentityKeyId)
            || (!("targetSignalIdentityKeyId" in resource.data)
              && !("targetSignalIdentityKeyId" in request.resource.data)))
          && ((("targetSignalIdentityPublicKeyFingerprint" in resource.data)
              && request.resource.data.targetSignalIdentityPublicKeyFingerprint == resource.data.targetSignalIdentityPublicKeyFingerprint)
            || (!("targetSignalIdentityPublicKeyFingerprint" in resource.data)
              && !("targetSignalIdentityPublicKeyFingerprint" in request.resource.data)))
