    function validRealtimeRelayURL(value) {
      return value is string
        && value.size() <= 2048
        && value.matches("^wss://[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*(:[0-9]{1,5})?(/[A-Za-z0-9._~%!$&()*+,;=:@/-]{0,512})?$")
        && !value.matches("^wss://localhost(\\.|:|/|$).*")
        && !value.matches("^wss://metadata\\.google\\.internal(\\.|:|/|$).*")
        && !value.matches("^wss://[0-9]+(:|/|$).*")
        && !value.matches("^wss://[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+(:|/|$).*");
