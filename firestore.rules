    // `cli_sessions`, and `ai_inbox_items`; other sealed surfaces stay on
    // `validSealedPayloadForUser` until their clients migrate.
    function validPathBoundSealedPayloadForUser(userId, vaultKeyID, payload, collection, docId) {
      return matchesCurrentVaultKey(userId, vaultKeyID)
        && validPathBoundCloudSealedPayload(userId, collection, docId, payload)
        && payload.vaultKeyID == vaultKeyID;
    }

    function hasValidEscrowPublicKey(userId, deviceId, keyVersion) {
      return exists(/databases/$(database)/documents/users/$(userId)/escrow_public_keys/$(deviceId + "_" + string(keyVersion)));
    }

    function validTextSnippetDoc(userId, snippetId) {
      return ownerWritableNonSecret(userId)
        && request.resource.data.keys().hasOnly([
          "id",
          "uid",
          "sourceDeviceID",
          "triggerHash",
          "sealedTitle",
          "sealedTrigger",
          "sealedBody",
          "sealedScope",
          "mode",
          "isEnabled",
          "revision",
          "createdAt",
          "updatedAt",
          "deletedAt",
          "schemaVersion",
          "encryption"
        ])
        && request.resource.data.id == snippetId
        && request.resource.data.uid == userId
        && request.resource.data.sourceDeviceID is string
        && request.resource.data.sourceDeviceID.size() <= 160
        && request.resource.data.triggerHash is string
        && request.resource.data.triggerHash.size() <= 128
        && validCloudSealedTextAt(userId, "text_snippets", snippetId, "sealedTitle", request.resource.data.sealedTitle)
        && validCloudSealedTextAt(userId, "text_snippets", snippetId, "sealedTrigger", request.resource.data.sealedTrigger)
        && validCloudSealedTextAt(userId, "text_snippets", snippetId, "sealedBody", request.resource.data.sealedBody)
        && validCloudSealedTextAt(userId, "text_snippets", snippetId, "sealedScope", request.resource.data.sealedScope)
        && hasValidEscrowPublicKey(userId, request.resource.data.sourceDeviceID, request.resource.data.sealedTitle.keyVersion)
        && request.resource.data.mode in ["static", "llm_rewrite"]
        && request.resource.data.isEnabled is bool
        && request.resource.data.revision is int
        && request.resource.data.revision >= 1
        && request.resource.data.schemaVersion is int
        && request.resource.data.schemaVersion >= 2;
