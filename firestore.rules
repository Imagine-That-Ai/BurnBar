      match /rotation_events/{rotationId} {
        function validSignalKeyRotationEventDocument() {
          return request.resource.data.keys().hasOnly([
            "rotationId",
            "identityKeyId",
            "deviceId",
            "keyVersion",
            "fromKeyVersion",
            "toKeyVersion",
            "reason",
            "status",
            "rewrapRequired",
            "rewrapJobId",
            "revokedIdentityKeyId",
            "createdAt",
            "updatedAt",
            "completedAt"
          ])
          && validSignalDirectoryBase()
          && request.resource.data.rotationId == rotationId
          && request.resource.data.fromKeyVersion is int
          && request.resource.data.fromKeyVersion >= 1
          && request.resource.data.fromKeyVersion <= 10
          && request.resource.data.toKeyVersion is int
          && request.resource.data.toKeyVersion >= 2
          && request.resource.data.toKeyVersion <= 10
          && request.resource.data.toKeyVersion > request.resource.data.fromKeyVersion
          && request.resource.data.reason in ["scheduled", "suspected_compromise", "device_repair", "revocation_rewrap", "manual"]
          && request.resource.data.status in ["planned", "running", "completed", "failed"]
          && request.resource.data.rewrapRequired is bool
          && (!("rewrapJobId" in request.resource.data) || (request.resource.data.rewrapJobId is string && request.resource.data.rewrapJobId.size() <= 200))
          && (!("revokedIdentityKeyId" in request.resource.data) || (request.resource.data.revokedIdentityKeyId is string && request.resource.data.revokedIdentityKeyId.size() <= 200))
          && (!("completedAt" in request.resource.data) || request.resource.data.completedAt is timestamp);
        }

        allow read: if ownsUserNamespace(userId);
        allow create: if ownsUserNamespace(userId)
