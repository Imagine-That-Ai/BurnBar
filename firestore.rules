        && request.resource.data.payloadCiphertext.size() <= 900000
        && request.resource.data.enc is string
        && request.resource.data.enc.size() <= 4096
        && request.resource.data.wrappedKey is string
        && request.resource.data.wrappedKey.size() <= 4096
        && request.resource.data.relayEncryption == "hpke-auth-p256-hkdfsha256-aes256gcm"
