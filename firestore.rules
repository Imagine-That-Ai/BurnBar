          && ((("approvedBySignalIdentityPublicKeyFingerprint" in resource.data)
              && d.approvedBySignalIdentityPublicKeyFingerprint == resource.data.approvedBySignalIdentityPublicKeyFingerprint)
            || (!("approvedBySignalIdentityPublicKeyFingerprint" in resource.data)
              && !("approvedBySignalIdentityPublicKeyFingerprint" in d)))
          && ((("signalIdentityRepairVersion" in resource.data)
