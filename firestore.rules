      match /kyber_prekeys/{kyberPreKeyId} {
        function validKyberPreKeyDocument() {
          return request.resource.data.keys().hasOnly([
            "kyberPreKeyId",
            "kyberPreKeyNumericId",
            "identityKeyId",
            "deviceId",
            "keyVersion",
            "publicKeyB64",
            "signatureB64",
            "algorithm",
            "status",
            "claimedBySessionId",
            "claimedAt",
            "createdAt",
            "updatedAt",
            "expiresAt"
          ])
          && validSignalDirectoryBase()
          && request.resource.data.kyberPreKeyId == kyberPreKeyId
          && request.resource.data.kyberPreKeyNumericId is int
          && request.resource.data.kyberPreKeyNumericId >= 1
          && request.resource.data.kyberPreKeyNumericId <= 2147483647
          && validSignalBase64(request.resource.data.publicKeyB64, 4096)
          && validSignalBase64(request.resource.data.signatureB64, 4096)
          && request.resource.data.algorithm == "signal-pqxdh-kyber-prekey-v1"
          && request.resource.data.status in ["available", "claimed", "exhausted", "retired"]
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt > request.time
          && (
            request.resource.data.status == "available"
            || (
              request.resource.data.claimedBySessionId is string
              && request.resource.data.claimedBySessionId.size() <= 200
              && request.resource.data.claimedAt is timestamp
            )
          );
        }

        function kyberPreKeyImmutableFieldsUnchanged() {
          return request.resource.data.kyberPreKeyId == resource.data.kyberPreKeyId
            && request.resource.data.kyberPreKeyNumericId == resource.data.kyberPreKeyNumericId
            && request.resource.data.identityKeyId == resource.data.identityKeyId
            && request.resource.data.deviceId == resource.data.deviceId
            && request.resource.data.keyVersion == resource.data.keyVersion
            && request.resource.data.publicKeyB64 == resource.data.publicKeyB64
            && request.resource.data.signatureB64 == resource.data.signatureB64
            && request.resource.data.algorithm == resource.data.algorithm
            && request.resource.data.createdAt == resource.data.createdAt;
