{
  "version": "openburnbar-project-code-secret-corpus-v5",
  "patterns": [
    {
      "id": "openai-api-key",
      "label": "OpenAI API key detected",
      "kind": "secret",
      "regex": "sk-(?!ant-)[A-Za-z0-9_-]{20,}"
    },
    {
      "id": "anthropic-api-key",
      "label": "Anthropic API key detected",
      "kind": "secret",
      "regex": "sk-ant-[A-Za-z0-9_-]{16,}"
    },
    {
      "id": "stripe-secret-key",
      "label": "Stripe secret key detected",
      "kind": "secret",
      "regex": "\\b(?:sk|rk)_(?:live|test)_[A-Za-z0-9]{20,}\\b"
    },
    {
      "id": "github-token",
      "label": "GitHub token detected",
      "kind": "secret",
      "regex": "\\b(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9_]{30,}\\b"
    },
    {
      "id": "github-fine-grained-pat",
      "label": "GitHub fine-grained PAT detected",
      "kind": "secret",
      "regex": "\\bgithub_pat_[A-Za-z0-9_]{30,}\\b"
    },
    {
      "id": "gitlab-token",
      "label": "GitLab token detected",
      "kind": "secret",
      "regex": "\\bglpat-[A-Za-z0-9_-]{20,}\\b"
    },
    {
      "id": "google-api-key",
      "label": "Google API key detected",
      "kind": "secret",
      "regex": "\\bAIza[0-9A-Za-z_-]{35}\\b"
    },
    {
      "id": "slack-token",
      "label": "Slack token detected",
      "kind": "secret",
      "regex": "\\bxox[baprs]-[A-Za-z0-9-]{10,}\\b"
    },
    {
      "id": "slack-app-token",
      "label": "Slack app-level token detected",
      "kind": "secret",
      "regex": "\\bxapp-[0-9]-[A-Za-z0-9-]{10,}\\b"
    },
    {
      "id": "slack-refresh-token",
      "label": "Slack refresh token detected",
      "kind": "secret",
      "regex": "\\bxoxe[.-][A-Za-z0-9.-]{20,}"
    },
    {
      "id": "slack-webhook",
      "label": "Slack webhook URL detected",
      "kind": "secret",
      "regex": "https://hooks\\.slack\\.com/services/[A-Za-z0-9_/-]{20,}"
    },
    {
      "id": "sendgrid-api-key",
      "label": "SendGrid API key detected",
      "kind": "secret",
      "regex": "\\bSG\\.[A-Za-z0-9_-]{16,}\\.[A-Za-z0-9_-]{16,}\\b"
    },
    {
      "id": "twilio-api-key",
      "label": "Twilio API key detected",
      "kind": "secret",
      "regex": "\\bSK[0-9a-fA-F]{32}\\b"
    },
    {
      "id": "vault-token",
      "label": "Vault token detected",
      "kind": "secret",
      "regex": "\\bhv[sc]\\.[A-Za-z0-9_-]{20,}\\b"
    },
    {
      "id": "xai-api-key",
      "label": "xAI API key detected",
      "kind": "secret",
      "regex": "\\bxai-[A-Za-z0-9_-]{20,}\\b"
    },
    {
      "id": "aws-access-key",
      "label": "AWS access key detected",
      "kind": "secret",
      "regex": "\\b(?:AKIA|ASIA)[A-Z0-9]{16}\\b"
    },
    {
      "id": "aws-secret-access-key",
      "label": "AWS secret access key detected",
      "kind": "secret",
      "regex": "aws_secret_access_key\\s*[:=]\\s*[\"']?[A-Za-z0-9/+]{40}",
      "caseInsensitive": true
    },
    {
      "id": "private-key-block",
      "label": "Private key block detected",
      "kind": "secret",
      "regex": "-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----.*?-----END [A-Z0-9 ]*PRIVATE KEY-----",
      "dotMatchesNewlines": true
    },
    {
      "id": "private-key-marker",
      "label": "Private key marker detected",
      "kind": "secret",
      "regex": "-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----"
    },
    {
      "id": "openssh-private-key-payload",
      "label": "OpenSSH private key payload detected",
      "kind": "secret",
      "regex": "openssh-key-v1\\x00"
    },
    {
      "id": "database-uri-credentials",
      "label": "Database URI credentials detected",
      "kind": "secret",
      "regex": "\\b[a-z][a-z0-9+.-]*://[^/\\s:@]+:[^@\\s]+@[^/\\s]+",
      "caseInsensitive": true
    },
    {
      "id": "generic-long-secret-assignment",
      "label": "Generic long secret assignment detected",
      "kind": "secret",
      "regex": "\\b(?:api[_-]?key|secret|token|password|passwd)\\s*[:=]\\s*[\"']?[^\"'\\s]{32,}",
      "caseInsensitive": true
    },
    {
      "id": "dotenv-secret-assignment",
      "label": "Dotenv secret assignment detected",
      "kind": "secret",
      "regex": "^\\s*[A-Z0-9_]*(?:KEY|SECRET|TOKEN|PASSWORD)\\s*=\\s*[^#\\n]{16,}",
      "anchorsMatchLines": true
    },
    {
      "id": "terraform-secret-assignment",
      "label": "Terraform variable secret detected",
      "kind": "secret",
      "regex": "^\\s*[A-Za-z0-9_]*(?:password|secret|token|api_key)\\s*=\\s*\"?[^\"#\\n]{16,}\"?",
      "anchorsMatchLines": true,
      "caseInsensitive": true
    },
    {
      "id": "kubernetes-secret-manifest",
      "label": "Kubernetes Secret manifest detected",
      "kind": "secret",
      "regex": "\\bkind\\s*:\\s*Secret\\b.*\\b(?:data|stringData)\\s*:",
      "caseInsensitive": true,
      "dotMatchesNewlines": true
    },
    {
      "id": "npmrc-auth-token",
      "label": "Package manager token detected",
      "kind": "secret",
      "regex": "//[^\\s]+/:?_authToken\\s*=\\s*[^\\s#]{16,}",
      "caseInsensitive": true
    },
    {
      "id": "pypirc-password",
      "label": "Package manager token detected",
      "kind": "secret",
      "regex": "^\\s*(?:password|token)\\s*=\\s*[^#\\n]{16,}",
      "anchorsMatchLines": true,
      "caseInsensitive": true
    },
    {
      "id": "jwt",
      "label": "JWT detected",
      "kind": "secret",
      "regex": "\\beyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\b"
    },
    {
      "id": "email-address",
      "label": "Email address detected",
      "kind": "pii",
      "regex": "\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}\\b"
    },
    {
      "id": "us-ssn",
      "label": "US SSN detected",
      "kind": "pii",
      "regex": "\\b\\d{3}-\\d{2}-\\d{4}\\b"
    },
    {
      "id": "us-phone-number",
      "label": "US phone number detected",
      "kind": "pii",
      "regex": "\\b(?:\\+1[-.\\s]?)?(?:\\(?\\d{3}\\)?[-.\\s]?)\\d{3}[-.\\s]?\\d{4}\\b"
    },
    {
      "id": "ipv4-address",
      "label": "IPv4 address detected",
      "kind": "pii",
      "regex": "\\b(?:\\d{1,3}\\.){3}\\d{1,3}\\b",
      "validator": "ipv4Octets"
    },
    {
      "id": "credit-card-number",
      "label": "Credit card number detected",
      "kind": "pii",
      "regex": "\\b(?:\\d[ -]*?){13,19}\\b",
      "validator": "luhn"
    }
  ],
  "entropy": {
    "enabled": true,
    "kind": "secret",
    "label": "High entropy secret-like token detected",
    "minLength": 32,
    "maxLength": 4096,
    "minShannonEntropy": 4.2
  },
  "hexEntropy": {
    "enabled": true,
    "kind": "secret",
    "label": "High-entropy hex secret-like token detected",
    "minLength": 32,
    "maxLength": 4096,
    "minShannonEntropy": 3.0
  },
  "decoding": {
    "enabled": true,
    "maxCandidates": 32,
    "maxDecodedBytes": 8192
  }
}
