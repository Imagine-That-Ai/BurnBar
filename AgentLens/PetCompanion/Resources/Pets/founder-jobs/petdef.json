{
  "schema": "petdef/1",
  "id": "founder-jobs",
  "name": "founder-jobs",
  "kind": "founder",
  "displayName": "Jobs",
  "description": "A rigged 3D founder that strolls the baseline. Demonstrates the SceneKit backend resolving a named GLB walk clip.",
  "model3d": {
    "kind": "rigged",
    "glb": "founder-jobs-walk",
    "clips": {
      "idle": "Armature|walking_man|baselayer",
      "wander": "Armature|walking_man|baselayer",
      "drag": "Armature|walking_man|baselayer",
      "walk": "Armature|walking_man|baselayer",
      "travel": "Armature|walking_man|baselayer"
    }
  },
  "behavior": {
    "initial": "idle",
    "transitions": [
      { "from": "idle", "to": "wander", "when": "cooldownElapsed", "weight": 2 },
      { "from": "wander", "to": "idle", "when": "idleElapsed", "weight": 1 }
    ]
  },
  "license": {
    "ipStatus": "demo",
    "licenseNote": "Bundled demo asset for the PetCompanion SceneKit backend."
  }
}
