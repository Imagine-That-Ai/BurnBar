<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		Release signing entitlements for Developer ID distribution.

		The direct-download app embeds a MAC_APP_DIRECT provisioning profile
		before signing. Firebase Auth requires Keychain Sharing on macOS, so
		the release lane must keep the app identifier, team identifier, and
		keychain access group in the signed entitlements. Keep iCloud and
		Apple Sign-In out of this profile until the direct-download release
		flow intentionally supports those hosted account capabilities.
	-->
	<key>com.apple.application-identifier</key>
	<string>$(AppIdentifierPrefix)com.openburnbar.app</string>
	<key>com.apple.developer.team-identifier</key>
	<string>$(TeamIdentifierPrefix)</string>
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.openburnbar.app</string>
	</array>
</dict>
</plist>
