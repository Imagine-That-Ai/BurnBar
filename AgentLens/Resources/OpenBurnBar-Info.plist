			<array>
				<string>com.googleusercontent.apps.YOUR_CLIENT_ID_SUFFIX</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>OpenBurnBarDomainCoreBuildProfile</key>
	<string>$(DOMAIN_CORE_BUILD_PROFILE)</string>
	<key>OpenBurnBarDomainCoreBuildAuthority</key>
	<string>$(DOMAIN_CORE_BUILD_AUTHORITY)</string>
	<key>OpenBurnBarDomainCoreDistribution</key>
	<string>$(DOMAIN_CORE_DISTRIBUTION)</string>
	<key>OpenBurnBarDomainCoreRolloutChannel</key>
	<string>$(DOMAIN_CORE_ROLLOUT_CHANNEL)</string>
	<key>OpenBurnBarDomainCoreEvidenceEnabled</key>
	<string>$(DOMAIN_CORE_EVIDENCE_ENABLED)</string>
	<key>OpenBurnBarDomainCoreModeQuota</key>
	<string>$(DOMAIN_CORE_QUOTA_MODE)</string>
	<key>OpenBurnBarDomainCoreModeCloudVault</key>
	<string>$(DOMAIN_CORE_CLOUDVAULT_MODE)</string>
	<key>OpenBurnBarDomainCoreModeCloudVaultRewrap</key>
	<string>$(DOMAIN_CORE_CLOUDVAULT_REWRAP_MODE)</string>
	<key>OpenBurnBarDomainCoreModeCloudVaultSearch</key>
	<string>$(DOMAIN_CORE_CLOUDVAULT_SEARCH_MODE)</string>
	<key>OpenBurnBarDomainCoreModeHermes</key>
	<string>$(DOMAIN_CORE_HERMES_MODE)</string>
	<key>OpenBurnBarDomainCoreModePricing</key>
	<string>$(DOMAIN_CORE_PRICING_MODE)</string>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>OpenBurnBar Chat Thread</string>
			<key>UTTypeIdentifier</key>
			<string>ai.burnbar.chat-thread</string>
		</dict>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>OpenBurnBar Chat Pane</string>
			<key>UTTypeIdentifier</key>
			<string>ai.burnbar.chat-pane</string>
		</dict>
	</array>
	<!-- Swift 6.2 (Xcode 26+) made swift_task_isCurrentExecutor crash on an
	     isolation mismatch where it previously returned false. Until the
	     concurrency-isolation migration is complete, restore the legacy
	     non-crashing behavior so startup (GRDB prepare hooks, AppDelegate
	     executor checks) does not SIGTRAP/SIGBUS under the new runtime. -->
	<key>LSEnvironment</key>
	<dict>
		<key>SWIFT_IS_CURRENT_EXECUTOR_LEGACY_MODE_OVERRIDE</key>
		<string>legacy</string>
	</dict>
	<key>OpenBurnBarDirectUpdateFeedURL</key>
	<string>https://github.com/Imagine-That-Ai/BurnBar/releases/latest/download/latest-macos.json</string>
	<key>SUFeedURL</key>
	<string>https://github.com/Imagine-That-Ai/BurnBar/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>613YSraDEJ54LKsfpqbYhyzYnfYRg7z4QwiEJfoy0TI=</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>OpenBurnBar may send Apple Events to apps you approve--such as Cursor, Safari, Google Chrome, and Finder--during Computer Use runs so agents can verify Automation permission and operate only the apps you authorize. Every action is recorded in a tamper-evident audit log.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_googlecast._tcp</string>
		<string>_http._tcp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>OpenBurnBar uses the local network to connect this Mac to your trusted iPhone, iPad, Android devices, and local smart displays for pairing, Hermes relay, Mercury media sessions, and screen sharing.</string>
	<key>NSCameraUsageDescription</key>
	<string>OpenBurnBar uses the camera only when you start a trusted Mercury video call or run the camera check in Media &amp; Sharing settings.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>OpenBurnBar uses the microphone only when you start a trusted Mercury audio or video call or run the microphone check in Media &amp; Sharing settings.</string>
</dict>
</plist>
