{
  "mcpServers": {
    "openburnbar": {
      "type": "stdio",
      "command": "tools/openburnbar-mcp/launch-memory.sh",
      "args": [],
      "env": {
        "BURNBAR_MCP_TOOLSET": "memory"
      }
    },
    "mem0-burnbar": {
      "type": "http",
      "url": "https://mcp.mem0.ai/mcp",
      "headers": {
        "Authorization": "Bearer ${MEM0_BURNBAR_API_KEY}"
      }
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "Authorization": "Bearer ${CONTEXT7_API_KEY}"
      }
    }
  }
}
