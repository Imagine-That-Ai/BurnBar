{
  "name": "@openburnbar/functions-shared",
  "version": "0.1.0",
  "private": true,
  "description": "OpenBurnBar Cloud Functions shared runtime: validators, billing/stripe helpers, audit-log chain, OTS stamping, admin/config/logging/guards. Deep imports only (@openburnbar/functions-shared/<path>.js).",
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "lint": "eslint src --max-warnings 0",
    "knip": "knip",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "@openburnbar/domain-core-wasm": "file:../../functions/vendor/openburnbar/domain-core-wasm",
    "@openburnbar/entitlements": "file:../entitlements",
    "@openburnbar/signal-envelope-contracts": "file:../signal-envelope-contracts",
    "@sentry/core": "11.1.0",
    "@sentry/node": "11.1.0",
    "cockatiel": "4.0.0",
    "express": "5.2.1",
    "firebase-admin": "14.5.0",
    "firebase-functions": "^7.4.0",
    "googleapis": "182.0.0",
    "stripe": "22.6.2"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^26.6.2",
    "eslint": "10.11.0",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "knip": "6.38.0"
  },
  "exports": {
    "./package.json": "./package.json",
    "./*.js": "./lib/*.js",
    "./*/*.js": "./lib/*/*.js",
    "./*/*/*.js": "./lib/*/*/*.js"
  },
  "overrides": {
    "brace-expansion@^1.1.7": "file:vendor/openburnbar/brace-expansion-cjs.tgz",
    "brace-expansion": "^5.0.9",
    "uuid": "11.1.1"
  }
}
