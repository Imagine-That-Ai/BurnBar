{
  "name": "openburnbar-hosted-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "prebuild": "../../scripts/build-signal-envelope-contracts.sh && ../../scripts/build-entitlements.sh",
    "build": "tsc",
    "lint": "eslint src --max-warnings=0 && ../../scripts/build-signal-envelope-contracts.sh && ../../scripts/build-entitlements.sh && tsc --noEmit",
    "start": "node lib/server.js",
    "test": "npm run build && node --test lib/*.test.js"
  },
  "dependencies": {
    "@openburnbar/entitlements": "file:../../packages/entitlements",
    "@openburnbar/signal-envelope-contracts": "file:../../packages/signal-envelope-contracts",
    "firebase-admin": "14.5.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^26.6.2",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.70.1"
  },
  "overrides": {
    "uuid": "11.1.1",
    "brace-expansion": "^5.0.9",
    "minimatch": "11.0.1",
    "glob": "14.0.2"
  },
  "license": "AGPL-3.0-only"
}
