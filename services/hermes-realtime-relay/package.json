{
  "name": "openburnbar-hermes-realtime-relay",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "prebuild": "../../scripts/build-signal-envelope-contracts.sh && ../../scripts/build-entitlements.sh",
    "build": "tsc",
    "start": "node lib/server.js",
    "test": "npm run build && node --test lib/*.test.js",
    "lint": "eslint src --max-warnings=0 && ../../scripts/build-signal-envelope-contracts.sh && ../../scripts/build-entitlements.sh && tsc --noEmit"
  },
  "dependencies": {
    "@openburnbar/entitlements": "file:../../packages/entitlements",
    "@openburnbar/signal-envelope-contracts": "file:../../packages/signal-envelope-contracts",
    "firebase-admin": "14.5.0",
    "ioredis": "^6.0.0",
    "protobufjs": "8.8.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^26.6.2",
    "@types/ws": "^8.5.12",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.70.1"
  },
  "overrides": {
    "@tootallnate/once": "^3.0.1",
    "uuid": "11.1.1",
    "brace-expansion": "^5.0.9",
    "minimatch": "^10.0.3"
  },
  "license": "AGPL-3.0-only"
}
