{
  "name": "@openburnbar/website",
  "version": "1.0.0",
  "description": "OpenBurnBar launch website — burnbar.ai",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/require-node.mjs",
    "dev": "astro dev",
    "prestart": "node scripts/require-node.mjs",
    "start": "astro dev",
    "research": "node --env-file-if-exists=.env scripts/run-research.mjs",
    "research:test": "node scripts/test-rundown.mjs",
    "model-capabilities:update": "node scripts/update-model-capabilities.mjs --apply --refresh-openrouter",
    "model-capabilities:check": "node scripts/update-model-capabilities.mjs --check",
    "test:platform": "node scripts/test-platform-mockups.mjs",
    "test:router-copy": "node scripts/test-router-copy.mjs",
    "test:pricing-copy": "node scripts/test-pricing-copy.mjs",
    "test:launch-assets": "node scripts/test-launch-assets.mjs",
    "prebuild": "node scripts/require-node.mjs",
    "build": "node --env-file-if-exists=.env scripts/run-research.mjs || true && astro build && node scripts/build-sitemap.mjs",
    "prebuild:offline": "node scripts/require-node.mjs",
    "build:offline": "astro build && node scripts/build-sitemap.mjs",
    "prepreview": "node scripts/require-node.mjs",
    "preview": "astro preview --host 127.0.0.1 --port 4322",
    "precheck": "node scripts/require-node.mjs",
    "check": "astro check",
    "pretypecheck": "node scripts/require-node.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{astro,ts,tsx,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{astro,ts,tsx,css,md}\"",
    "lint": "eslint \"src/**/*.ts\" \"src/**/*.astro\"",
    "links:check": "node scripts/check-links.mjs",
    "size": "size-limit",
    "preverify": "node scripts/require-node.mjs",
    "verify": "npm run research:test && npm run test:platform && npm run test:router-copy && npm run test:pricing-copy && npm run test:launch-assets && npm run check && npm run build && npm run links:check",
    "pretest": "node scripts/require-node.mjs",
    "test": "vitest run",
    "pretest:integration": "node scripts/require-node.mjs",
    "test:integration": "vitest run test/integration"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/mdx": "^5.0.5",
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@sentry/astro": "8.55.2",
    "astro": "^6.3.2",
    "firebase": "12.14.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "8.60.0",
    "@typescript-eslint/parser": "8.60.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "1.7.0",
    "lightningcss": "^1.32.0",
    "prettier": "3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "vitest": "4.1.8"
  },
  "overrides": {
    "yaml": "^2.8.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "AGPL-3.0-only"
}
