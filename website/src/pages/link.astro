---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  title="Link CLI"
  description="Link the OpenBurnBar CLI to your BurnBar account with a one-time code."
  noindex={true}
>
  <section class="pagehead">
    <div class="container pagehead__inner">
      <span class="eyebrow eyebrow--ember">Integration</span>
      <h1 class="pagehead__h">Link your CLI to BurnBar Cloud</h1>
    </div>
  </section>

  <section class="link-container">
    <div class="container container--narrow">
      <div class="glass-pane link-card" aria-live="polite">
        <!-- Loader / Checking Auth State -->
        <div id="state-checking" class="link-state">
          <div class="spinner" aria-hidden="true"></div>
          <p>Checking your session…</p>
        </div>

        <!-- State: Signed Out -->
        <div id="state-signed-out" class="link-state hidden">
          <div class="icon-wrap" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              width="28"
              height="28"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="8" cy="14" r="4.5"></circle>
              <path d="M11.5 10.5 20 2m-3.5 3.5L19 8m-5-2.5L16.5 8"></path>
            </svg>
          </div>
          <h2>Sign in to link your CLI</h2>
          <p>Use the same account as the BurnBar app. Signing in authorizes this one connection.</p>
          <button id="btn-signin" class="btn btn--ember"> Sign in with Google </button>
          <button id="btn-signin-apple" class="btn btn--secondary"> Sign in with Apple </button>
        </div>

        <!-- State: Signed In, Enter/Confirm Code -->
        <div id="state-confirm" class="link-state hidden">
          <div class="user-badge" id="user-badge">
            <img id="user-avatar" src="" alt="" class="avatar hidden" />
            <span id="user-email" class="mono">...</span>
          </div>
          <h2>Confirm your link code</h2>
          <p>Enter or confirm the 8-character code shown in your terminal.</p>

          <div class="code-input-wrap">
            <label class="code-label mono" for="code-input">Link code</label>
            <input
              type="text"
              id="code-input"
              placeholder="WDJB-MQXK"
              maxlength="9"
              autocomplete="one-time-code"
              spellcheck="false"
              class="mono-input"
            />
            <p id="code-hint" class="code-hint hidden" role="alert">
              Enter the full 8-character code from your terminal.
            </p>
          </div>

          <button id="btn-confirm" class="btn btn--ember"> Link this terminal </button>

          <button id="btn-signout" class="btn-text"> Sign out of this account </button>
        </div>

        <!-- State: Submitting / Linking -->
        <div id="state-linking" class="link-state hidden">
          <div class="spinner" aria-hidden="true"></div>
          <h2>Linking your terminal…</h2>
          <p>Provisioning credentials and preparing secure sync endpoints.</p>
        </div>

        <!-- State: Success -->
        <div id="state-success" class="link-state hidden">
          <div class="success-glow" aria-hidden="true"></div>
          <div class="icon-wrap success" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              width="28"
              height="28"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m4.5 12.5 5 5 10-11"></path>
            </svg>
          </div>
          <h2>CLI linked</h2>
          <p>This terminal is now authorized with your account.</p>
          <div class="next-step-box">
            <p class="mono small">Return to your terminal to finish.</p>
          </div>
        </div>

        <!-- State: Error -->
        <div id="state-error" class="link-state hidden">
          <div class="icon-wrap error" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              width="28"
              height="28"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            >
              <path d="M6 6l12 12M18 6L6 18"></path>
            </svg>
          </div>
          <h2>Linking failed</h2>
          <p id="error-message">Something went wrong on our side. Try again in a moment.</p>
          <button id="btn-retry" class="btn btn--secondary"> Try again </button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .link-container {
    padding: 2rem 1rem 6rem;
    display: flex;
    justify-content: center;
  }
  .container--narrow {
    max-width: 520px;
    width: 100%;
  }
  .link-card {
    padding: 3rem 2rem;
    text-align: center;
    border-radius: 16px;
    min-height: 320px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    position: relative;
    overflow: hidden;
  }
  .link-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    animation: fadeIn 0.4s ease-out;
  }
  .hidden {
    display: none !important;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  h2 {
    font-size: 1.75rem;
    margin: 1rem 0 0.5rem;
    font-weight: var(--wght-black);
    color: var(--text-bright);
    --opsz: var(--opsz-h3);
  }

  p {
    color: var(--text-mute);
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 2rem;
    max-width: 360px;
  }

  .btn {
    width: 100%;
    max-width: 320px;
    padding: 0.875rem 1.5rem;
    font-weight: var(--wght-bold);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn--secondary {
    background: var(--ink-surface);
    border: 1px solid var(--ink-line);
    color: var(--text-bright);
    margin-top: 0.75rem;
  }
  .btn--secondary:hover {
    background: var(--ink-surface-2);
    border-color: var(--ink-line-bright);
  }

  .btn-text {
    background: none;
    border: none;
    color: var(--text-mute);
    font-size: 0.875rem;
    margin-top: 1.5rem;
    cursor: pointer;
    text-decoration: underline;
  }
  .btn-text:hover {
    color: var(--text-bright);
  }

  /* Spinner */
  .spinner {
    width: 48px;
    height: 48px;
    border: 4px solid var(--ink-line);
    border-top: 4px solid var(--ember-bright);
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin-bottom: 1.5rem;
  }
  @keyframes spin {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }

  /* Icons */
  .icon-wrap {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--ink-surface);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    margin-bottom: 1rem;
    border: 1px solid var(--ink-line);
    color: var(--ember-bright);
  }
  .icon-wrap.success {
    background: color-mix(in oklab, var(--status-exact) 10%, transparent);
    border-color: color-mix(in oklab, var(--status-exact) 30%, var(--ink-line));
    color: var(--status-exact);
  }
  .icon-wrap.error {
    background: color-mix(in oklab, var(--status-burn) 10%, transparent);
    border-color: color-mix(in oklab, var(--status-burn) 30%, var(--ink-line));
    color: var(--status-burn);
  }

  /* User Badge */
  .user-badge {
    background: var(--ink-surface);
    border: 1px solid var(--ink-line);
    padding: 0.5rem 1rem;
    border-radius: 99px;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }
  .avatar {
    width: 24px;
    height: 24px;
    border-radius: 50%;
  }

  /* Code Input */
  .code-input-wrap {
    margin-bottom: 2rem;
    width: 100%;
    max-width: 320px;
  }
  .code-label {
    display: block;
    text-align: left;
    margin-bottom: 0.4rem;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-mute);
  }
  .code-hint {
    margin: 0.6rem 0 0;
    font-size: 0.82rem;
    color: var(--status-burn);
    text-align: left;
  }
  .code-hint.hidden {
    display: none;
  }
  .mono-input {
    width: 100%;
    background: var(--ink-surface);
    border: 2px solid var(--ink-line);
    border-radius: 8px;
    padding: 0.75rem 1rem;
    color: var(--text-bright);
    font-family: var(--font-mono);
    font-size: 1.5rem;
    letter-spacing: 2px;
    text-align: center;
    text-transform: uppercase;
    transition: border-color 0.2s ease;
  }
  .mono-input:focus-visible {
    outline: 2px solid var(--ember-bright);
    outline-offset: 2px;
    border-color: var(--ember-bright);
  }
  .mono-input[aria-invalid="true"] {
    border-color: var(--status-burn);
  }

  /* Success Glow */
  .success-glow {
    position: absolute;
    width: 200px;
    height: 200px;
    background: radial-gradient(
      circle,
      color-mix(in oklab, var(--status-exact) 15%, transparent) 0%,
      transparent 70%
    );
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .next-step-box {
    margin-top: 1.5rem;
    background: color-mix(in oklab, var(--status-exact) 5%, transparent);
    border: 1px dashed color-mix(in oklab, var(--status-exact) 30%, var(--ink-line));
    padding: 1rem;
    border-radius: 8px;
    width: 100%;
    max-width: 320px;
  }
</style>

<script>
  import { auth, googleProvider, appleProvider } from "../lib/firebaseClient";
  import { signInWithPopup, signOut, onAuthStateChanged } from "firebase/auth";
  import type { User } from "firebase/auth";
  import {
    attestedCallable,
    callableErrorCode,
    isAppCheckBindingConflictError
  } from "../lib/attestedCallable";

  // Elements
  const states = {
    checking: document.getElementById("state-checking"),
    signedOut: document.getElementById("state-signed-out"),
    confirm: document.getElementById("state-confirm"),
    linking: document.getElementById("state-linking"),
    success: document.getElementById("state-success"),
    error: document.getElementById("state-error")
  };

  const btnSignin = document.getElementById("btn-signin");
  const btnSigninApple = document.getElementById("btn-signin-apple");
  const btnConfirm = document.getElementById("btn-confirm");
  const btnSignout = document.getElementById("btn-signout");
  const btnRetry = document.getElementById("btn-retry");

  const codeInput = document.getElementById("code-input") as HTMLInputElement;
  const userEmail = document.getElementById("user-email");
  const userAvatar = document.getElementById("user-avatar") as HTMLImageElement;
  const errorMessage = document.getElementById("error-message");

  let currentUser: User | null = null;

  // Helpers
  function showState(activeState: keyof typeof states) {
    Object.keys(states).forEach((key) => {
      const el = states[key as keyof typeof states];
      if (el) {
        if (key === activeState) {
          el.classList.remove("hidden");
        } else {
          el.classList.add("hidden");
        }
      }
    });
  }

  function getQueryCode(): string {
    const params = new URLSearchParams(window.location.search);
    return (params.get("code") || "").toUpperCase();
  }

  // Format code input with hyphen: WDJB-MQXK
  if (codeInput) {
    codeInput.addEventListener("input", () => {
      let val = codeInput.value.replace(/[^A-Za-z2-9]/g, "").toUpperCase();
      if (val.length > 4) {
        val = val.slice(0, 4) + "-" + val.slice(4, 8);
      } else {
        val = val.slice(0, 4);
      }
      codeInput.value = val;
    });
  }

  // Auth State Listener
  onAuthStateChanged(auth, (user) => {
    currentUser = user;
    if (!user) {
      showState("signedOut");
    } else {
      if (userEmail) userEmail.textContent = user.email || user.displayName || "Authenticated User";
      if (userAvatar && user.photoURL) {
        userAvatar.src = user.photoURL;
        userAvatar.classList.remove("hidden");
      }

      // Auto-prefill query param code
      const queryCode = getQueryCode();
      if (queryCode && codeInput) {
        codeInput.value = queryCode;
      }

      showState("confirm");
    }
  });

  // Action: Sign In (Google or Apple — same Firebase account either way)
  const signIn = async (provider: typeof googleProvider | typeof appleProvider) => {
    try {
      showState("checking");
      await signInWithPopup(auth, provider);
    } catch (err: unknown) {
      const errorLike = err as { message?: unknown };
      if (errorMessage) {
        errorMessage.textContent =
          typeof errorLike.message === "string" ? errorLike.message : "Authentication failed.";
      }
      showState("error");
    }
  };
  btnSignin?.addEventListener("click", () => signIn(googleProvider));
  btnSigninApple?.addEventListener("click", () => signIn(appleProvider));

  // Action: Sign Out
  btnSignout?.addEventListener("click", async () => {
    try {
      showState("checking");
      await signOut(auth);
    } catch (err) {
      console.error("Sign out error", err);
    }
  });

  // Action: Complete link
  const codeHint = document.getElementById("code-hint");
  btnConfirm?.addEventListener("click", async () => {
    // Signed-out visitors never invoke completeCliLink.
    if (!currentUser) {
      codeHint?.classList.add("hidden");
      showState("signedOut");
      return;
    }

    const displayCode = (codeInput?.value || "").trim();
    const stripped = displayCode.replace(/-/g, "");
    if (stripped.length !== 8) {
      codeHint?.classList.remove("hidden");
      codeInput?.setAttribute("aria-invalid", "true");
      codeInput?.focus();
      return;
    }
    codeHint?.classList.add("hidden");
    codeInput?.removeAttribute("aria-invalid");

    try {
      showState("linking");
      // userCode stays the hyphenated display value (XXXX-XXXX) stored by
      // generateUserCode in Firestore; the hyphen is stripped only above for
      // the 8-character length gate.
      await attestedCallable("completeCliLink", { userCode: displayCode });
      showState("success");
    } catch (err: unknown) {
      console.error("Linking error", err);
      // Firebase FunctionsError codes arrive prefixed ("functions/not-found");
      // callableErrorCode normalizes them so one set of branches covers both shapes.
      const errorCode = callableErrorCode(err);
      const errorText = String((err as { message?: unknown })?.message || "");
      const isPermissionDenied = errorCode === "permission-denied";
      const isFailedPrecondition = errorCode === "failed-precondition";
      const isUnauthenticated =
        errorCode === "unauthenticated" || errorCode.includes("unauthenticated");

      let friendlyMessage: string;
      if (
        errorCode === "not-found" ||
        (isFailedPrecondition && /This link code has expired/i.test(errorText))
      ) {
        friendlyMessage =
          "Link session not found or code expired. Please ensure you entered the exact code from your terminal.";
      } else if (isPermissionDenied && /Pro is required/.test(errorText)) {
        friendlyMessage =
          "BurnBar Pro is required for Remote MCP access. Please subscribe to continue.";
      } else if (isAppCheckBindingConflictError(err)) {
        friendlyMessage =
          "Your device attestation could not be verified for this action. Sign in again and retry.";
      } else if (
        isFailedPrecondition &&
        /nonce|bindAppCheckAttestation|App Check|attestation/i.test(errorText)
      ) {
        friendlyMessage =
          "Your device attestation could not be verified for this action. Sign in again and retry.";
      } else if (isUnauthenticated) {
        friendlyMessage = "Your sign-in could not be verified. Sign in again and try once more.";
      } else {
        friendlyMessage = errorText || "Something went wrong on our side. Try again in a moment.";
      }
      if (errorMessage) errorMessage.textContent = friendlyMessage;
      showState("error");
    }
  });

  // Action: Retry
  btnRetry?.addEventListener("click", () => {
    if (currentUser) {
      showState("confirm");
    } else {
      showState("signedOut");
    }
  });
</script>
