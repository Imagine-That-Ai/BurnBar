---
import BaseLayout from "@layouts/BaseLayout.astro";
import { SITE } from "@data/site";
import { SUPPORT_MACROS } from "@data/supportMacros";
---

<BaseLayout
  title="Support"
  description="OpenBurnBar support information, contact paths, subscription help, account deletion, and troubleshooting resources."
>
  <section class="supportpage">
    <div class="container container--narrow">
      <span class="eyebrow eyebrow--ember">Support</span>
      <h1>OpenBurnBar support</h1>
      <p class="lead">
        Get help with the macOS app, iPhone and iPad companion app, BurnBar Cloud, BurnBar Cloud
        Pro, provider connections, account deletion, or privacy requests.
      </p>

      <div class="supportgrid">
        <article class="supportcard">
          <h2>Email support</h2>
          <p>
            For app support, billing-flow questions, App Store subscription recovery, or
            account/data deletion help, email
            <a href={`mailto:${SITE.supportContact}`}>{SITE.supportContact}</a>.
          </p>
          <p class="small muted">
            Include your device type, app version, and the provider or screen where the issue
            happens. Do not send API keys, session cookies, or provider secrets.
          </p>
        </article>

        <article class="supportcard">
          <h2>Subscription help</h2>
          <p>
            BurnBar Cloud and BurnBar Cloud Pro are auto-renewable subscriptions. Billing is handled
            by the purchase platform: Apple App Store, Google Play, or Stripe. Manage, cancel, or
            request refunds from the platform where you purchased.
          </p>
          <a
            class="textlink"
            href="https://apps.apple.com/account/subscriptions"
            target="_blank"
            rel="noopener noreferrer"
          >
            Manage Apple subscriptions
          </a>
        </article>

        <article class="supportcard">
          <h2>Cloud Pro allowance</h2>
          <p>
            Cloud Pro includes 500 hosted Agent Control actions and 50 relay-accounting GB each
            month. Extra hosted actions and relay are prepaid top-ups. If allowance or caps are
            exhausted, hosted Agent Control and Floo relay pause instead of silently spending more.
          </p>
        </article>

        <article class="supportcard">
          <h2>Account and data deletion</h2>
          <p>
            In the iOS app, go to <strong>You -> Settings -> Account -> Delete account</strong>.
            This deletes OpenBurnBar cloud data for the signed-in account and signs you out. Local
            macOS data remains on your Mac until you remove the app support folder.
          </p>
        </article>

        <article class="supportcard">
          <h2>Privacy and terms</h2>
          <p>
            Review the data model, optional sync behavior, subscription terms, and contact
            information before enabling cloud features.
          </p>
          <div class="linkrow">
            <a class="textlink" href="/legal/privacy-policy">Privacy Policy</a>
            <a class="textlink" href="/legal/terms">Terms of Use</a>
          </div>
        </article>
      </div>

      <section class="macros" aria-labelledby="support-macros-h">
        <h2 id="support-macros-h">Support macros</h2>
        <div class="supportgrid">
          {
            SUPPORT_MACROS.map((macro) => (
              <article class="supportcard supportcard--compact">
                <h3>{macro.title}</h3>
                <p>{macro.summary}</p>
              </article>
            ))
          }
        </div>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .supportpage {
    padding-block: var(--s-9);
  }
  .supportpage h1 {
    margin-top: var(--s-3);
    margin-bottom: var(--s-3);
  }
  .lead {
    max-width: 62ch;
    margin-bottom: var(--s-6);
  }
  .supportgrid {
    display: grid;
    gap: var(--s-4);
  }
  .supportcard {
    padding: var(--s-5);
    border: 1px solid var(--ink-line);
    border-radius: var(--r-4);
    background: var(--ink-base);
  }
  .supportcard h2 {
    margin-bottom: var(--s-3);
    font-size: 1.35rem;
    font-variation-settings:
      "opsz" 80,
      "wght" 520;
  }
  .supportcard h3 {
    margin-bottom: var(--s-2);
    font-size: 1rem;
    color: var(--text-bright);
  }
  .supportcard--compact {
    padding: var(--s-4);
  }
  .supportcard p {
    color: var(--text-base);
    max-width: 64ch;
  }
  .small {
    margin-top: var(--s-3);
    font-size: var(--t-caption);
  }
  .supportcard a,
  .textlink {
    color: var(--ember-bright);
    text-decoration: underline;
    text-underline-offset: 0.16em;
  }
  .linkrow {
    display: flex;
    gap: var(--s-4);
    flex-wrap: wrap;
    margin-top: var(--s-3);
  }
  .macros {
    margin-top: var(--s-7);
  }
  .macros > h2 {
    margin-bottom: var(--s-4);
  }
</style>
