---
/* ============================================================
   /memory — the Memory MCP.

   Relationship to /mcp: /mcp is the transport reference (four channels,
   which endpoint speaks which protocol). This page is the product — what
   the memory does, why it is built the way it is, what the numbers are,
   and how to get it running. Neither absorbs the other; each links to the
   other exactly once, from the place a reader would look for it.

   Every claim on this page reads from src/data/memory.ts, where each block
   carries the file on `main` it came from. See website/CLAIMS.md § Memory.
   ============================================================ */
import BaseLayout from "@layouts/BaseLayout.astro";
import { SITE } from "@data/site";
import {
  BOOTSTRAP_LINES,
  BOUNDARY,
  CHECKOUT,
  CLIENTS,
  EMBEDDING_LINES,
  FUSION,
  GATE_PLACEMENTS,
  GATE_POLICIES,
  GATE_SHAPES,
  HOOK_STATUSES,
  LIMITS,
  MEASUREMENTS,
  MEMORY_KINDS,
  MEMORY_STORE_PATH,
  MEMORY_TOOL_COUNT,
  PRO_INVARIANTS,
  PRO_PURPOSES,
  SESSION_HOOK_LINES,
  VERIFY_STEPS,
  WRITE_PIPELINE
} from "@data/memory";

const REPO_MCP = `${SITE.github}/blob/main/tools/openburnbar-mcp/README.md`;
const REPO_DESIGN = `${SITE.github}/blob/main/docs/superpowers/2026-09-02-memory-mcp-v2-design.md`;

const maxKindWeight = Math.max(...MEMORY_KINDS.map((k) => k.weight));
const pinnedCount = MEASUREMENTS.filter((m) => m.pin !== null).length;

/* Section register — the numerals in the left margin, and the in-page nav. */
const SECTIONS = [
  { n: "01", id: "pipeline", label: "The pipeline" },
  { n: "02", id: "gate", label: "The gate" },
  { n: "03", id: "recall", label: "Recall" },
  { n: "04", id: "collection", label: "Collection" },
  { n: "05", id: "proof", label: "Proof" },
  { n: "06", id: "boundary", label: "The boundary" },
  { n: "07", id: "setup", label: "Setup" },
  { n: "08", id: "limits", label: "Limits" }
];
---

<BaseLayout
  title="Memory MCP — one memory your agents share, on a machine you own"
  description={`Thirty-two MCP tools give Claude Code, Cursor, Codex, Claude Desktop and Hermes one durable memory of your work — extracted from the sessions you already run, encrypted on your own disk, and screened so credentials never become memories.`}
>
  {/* Announcements for copy actions and checklist progress. */}
  <p class="sr-only" role="status" aria-live="polite" data-copy-live></p>

  {/* ══════════════════════ HERO ══════════════════════ */}
  <section class="mem-hero" aria-labelledby="mem-hero-h">
    <div class="container container--wide mem-hero__inner">
      <span class="eyebrow eyebrow--ember">Memory MCP · local-first · no account</span>

      <h1 id="mem-hero-h" class="mem-hero__h">
        One memory your agents share,<br />
        <span class="mem-hero__h--ember">on a machine you own.</span>
      </h1>

      <p class="lead mem-hero__lead">
        {MEMORY_TOOL_COUNT} MCP tools give Claude&nbsp;Code, Cursor, Codex, Claude&nbsp;Desktop and Hermes
        the same durable memory of your work — extracted from the sessions you already run, sealed on
        your own disk, and screened so credentials never become memories in the first place. No account.
        No server in the path. It works with the network off.
      </p>

      {/* The store plate — the local counterpart to the endpoint plate on /mcp. */}
      <div class="plate">
        <div class="plate__row">
          <span class="plate__band mono">STORE · SQLITE · AES-256-GCM AT REST</span>
          <span class="plate__pill mono"
            ><span class="plate__dot" aria-hidden="true"></span> ON YOUR DISK</span
          >
        </div>
        <p class="plate__addr mono">{MEMORY_STORE_PATH}</p>
        <div class="plate__row plate__row--foot">
          <span class="mono plate__meta"
            >mode 0600 · key held by the engine · no daemon required</span
          >
          <span class="mono plate__meta">stdio · MCP</span>
        </div>
      </div>

      <div class="mem-hero__ctas">
        <a class="btn btn--ember" href="#setup"
          >Set it up <span class="btn-arrow" aria-hidden="true">→</span></a
        >
        <a class="btn btn--ghost" href="#proof">See the measurements</a>
        <a class="btn btn--ghost" href={REPO_MCP} target="_blank" rel="noopener noreferrer"
          >Read the source</a
        >
      </div>

      <nav class="mem-jump" aria-label="On this page">
        <ol>
          {
            SECTIONS.map((s) => (
              <li>
                <a href={`#${s.id}`}>
                  <span class="mem-jump__n mono" aria-hidden="true">
                    {s.n}
                  </span>
                  {s.label}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </div>
  </section>

  {/* ══════════════════════ 01 · PIPELINE ══════════════════════ */}
  <section class="reg" id="pipeline" aria-labelledby="pipeline-h">
    <div class="container container--wide">
      <header class="reg__head">
        <span class="reg__n mono" aria-hidden="true">01</span>
        <div class="reg__headtext">
          <span class="eyebrow eyebrow--ember">The pipeline</span>
          <h2 id="pipeline-h">Seven stages between a conversation and a memory.</h2>
          <p class="lead">
            Most memory layers are a vector database with a nice name: text goes in, embeddings come
            out, and whatever was in the text is now in the index. This one refuses things. Two of
            the seven stages exist only to say no.
          </p>
        </div>
      </header>

      <ol class="pipe" data-animate-onview>
        {
          WRITE_PIPELINE.map((stage) => (
            <li class="pipe__step" data-role={stage.role}>
              <span class="pipe__dot" aria-hidden="true" />
              <div class="pipe__id">
                <p class="pipe__n mono">{stage.n}</p>
                <h3 class="pipe__name">{stage.name}</h3>
                {stage.role === "gate" && <p class="pipe__role mono">can refuse</p>}
              </div>
              <p class="pipe__what">{stage.what}</p>
              <p class="pipe__detail">{stage.detail}</p>
            </li>
          ))
        }
      </ol>

      <p class="reg__foot mono">
        Source · <code>docs/superpowers/2026-09-02-memory-mcp-v2-design.md</code> §4 ·
        <code>tools/openburnbar-mcp/memory_engine/</code>
      </p>
    </div>
  </section>

  {/* ══════════════════════ 02 · GATE ══════════════════════ */}
  <section class="reg reg--alt" id="gate" aria-labelledby="gate-h">
    <div class="container container--wide">
      <header class="reg__head">
        <span class="reg__n mono" aria-hidden="true">02</span>
        <div class="reg__headtext">
          <span class="eyebrow eyebrow--ember">The gate</span>
          <h2 id="gate-h">Credentials never become memories.</h2>
          <p class="lead">
            Not “we filter them on the way out”. The secret is removed before the row exists, on the
            body and on every auxiliary field a caller controls. The sentence survives. The token
            does not.
          </p>
        </div>
      </header>

      {/* The specimen. The credential is never rendered — the redaction is the point. */}
      <figure class="specimen">
        <figcaption class="specimen__cap mono">
          One sentence, through the gate, under the default policy
        </figcaption>
        <div class="specimen__grid">
          <div class="specimen__side">
            <p class="specimen__label mono">In · what the agent saw</p>
            <p class="specimen__text mono">
              deploy uses the token <span class="specimen__redacted" aria-hidden="true"></span><span
                class="sr-only">(a GitHub personal access token)</span
              > stored in 1Password
            </p>
          </div>
          <div class="specimen__arrow" aria-hidden="true">
            <svg viewBox="0 0 40 12" width="40" height="12" focusable="false">
              <path
                d="M0 6h32M27 1.5 32.5 6 27 10.5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </div>
          <div class="specimen__side specimen__side--out">
            <p class="specimen__label mono">Out · what was stored</p>
            <p class="specimen__text mono">
              deploy uses the token <mark class="specimen__mark">[REDACTED:github-pat]</mark> stored in
              1Password
            </p>
            <p class="specimen__meta mono">kind: procedure · sensitivity: redacted</p>
          </div>
        </div>
        <p class="specimen__note">
          The fact is worth keeping. The token is not. Under <code>reject</code> the whole write is refused
          instead; under <code>retain</code> the verbatim text goes to an encrypted vault that never leaves
          the device.
        </p>
      </figure>

      <div class="policies">
        {
          GATE_POLICIES.map((p) => (
            <article class="policy" data-status={p.status}>
              <header class="policy__head">
                <code class="policy__name">{p.label}</code>
                <span
                  class:list={[
                    "tag",
                    p.status === "default" ? "tag--exact" : "",
                    p.status === "opt-in" ? "tag--mercury" : "",
                    p.status === "experimental" ? "tag--review" : ""
                  ]}
                >
                  {p.status}
                </span>
              </header>
              <h3 class="policy__h">{p.headline}</h3>
              <p class="policy__body">{p.body}</p>
            </article>
          ))
        }
      </div>

      <div class="coverage">
        <div class="coverage__stat">
          <p class="coverage__fig mono">
            {GATE_SHAPES.total}<span class="coverage__of">/{GATE_SHAPES.total}</span>
          </p>
          <p class="coverage__lab">
            credential shapes in the shared corpus, every one detected in raw form
          </p>
        </div>
        <div class="coverage__body">
          <p class="coverage__intro">
            The adversarial suite plants each of those shapes in <strong
              >{GATE_PLACEMENTS.length} caller-controlled places</strong
            > and proves that under <code>redact</code> the verbatim token reaches no result, no
            <code>get</code>, no <code>list</code>, no recall, no pack, no export, no history, no
            audit trail — and is absent from the store's raw bytes, write-ahead log included.
          </p>
          <ul class="coverage__places">
            {GATE_PLACEMENTS.map((place) => <li class="mono">{place}</li>)}
          </ul>
          <div class="coverage__gaps">
            <p class="coverage__gapshead">
              <span class="tag tag--review">Named, not rounded away</span>
              Four encoded forms are not yet caught:
            </p>
            <ul>
              {GATE_SHAPES.encodingGaps.map((gap) => <li>{gap}</li>)}
            </ul>
          </div>
        </div>
      </div>

      <p class="reg__foot mono">
        Source · <code>tools/openburnbar-mcp/tests/test_gate_adversarial.py</code> ·
        <code>eval_memory.py --gate</code>
      </p>
    </div>
  </section>

  {/* ══════════════════════ 03 · RECALL ══════════════════════ */}
  <section class="reg" id="recall" aria-labelledby="recall-h">
    <div class="container container--wide">
      <header class="reg__head">
        <span class="reg__n mono" aria-hidden="true">03</span>
        <div class="reg__headtext">
          <span class="eyebrow eyebrow--ember">Recall</span>
          <h2 id="recall-h">Two rankings, fused. Then weighted by what a memory is.</h2>
          <p class="lead">
            BM25 over a code-aware tokenizer catches the exact identifier. Vector search catches the
            paraphrase. Reciprocal-rank fusion combines both lists, so a memory found by one signal
            alone still surfaces — and then salience decides the order.
          </p>
        </div>
      </header>

      <div class="fuse">
        <div class="fuse__lane" data-lane="lexical">
          <p class="fuse__label mono">Lexical · BM25</p>
          <p class="fuse__weight mono">weight {FUSION.lexicalWeight.toFixed(1)}</p>
          <p class="fuse__note">
            camelCase and snake_case split, light stemming. Wins on paths, symbols and ticket ids.
          </p>
        </div>
        <div class="fuse__join" aria-hidden="true">
          <span class="fuse__joinlab mono">RRF · k={FUSION.rrfK}</span>
        </div>
        <div class="fuse__lane" data-lane="semantic">
          <p class="fuse__label mono">Semantic · vectors</p>
          <p class="fuse__weight mono">weight {FUSION.semanticWeight.toFixed(1)}</p>
          <p class="fuse__note">
            Cosine over the active embedding version only — vectors are never compared across model
            versions.
          </p>
        </div>
      </div>
      <p class="fuse__caption">{FUSION.note}</p>

      <div class="salience">
        <h3 class="salience__h">Salience — what a memory is worth after the fusion.</h3>
        <p class="salience__intro">
          Every kind carries a weight into the rerank, multiplied by confidence, by a recency
          half-life, and by a reinforcement boost that rises each time a memory is actually used
          (capped at {FUSION.accessBoostCap}×). Decisions and gotchas earn their place at the top; a
          stray note has to work for it.
        </p>
        <ul class="kinds">
          {
            MEMORY_KINDS.map((k) => (
              <li class="kind">
                <code class="kind__name">{k.kind}</code>
                <span
                  class="kind__bar"
                  role="img"
                  aria-label={`salience weight ${k.weight.toFixed(2)}`}
                >
                  <span
                    class="kind__fill"
                    style={`--w:${((k.weight / maxKindWeight) * 100).toFixed(1)}%`}
                  />
                </span>
                <span class="kind__val mono">{k.weight.toFixed(2)}</span>
                <span class="kind__flags">
                  {k.personal && <span class="tag tag--mercury tag--plain">personal scope</span>}
                  {k.decaysFast && (
                    <span class="tag tag--review tag--plain">
                      {FUSION.halfLifeShortDays}d half-life
                    </span>
                  )}
                </span>
                <span class="kind__eg">{k.example}</span>
              </li>
            ))
          }
        </ul>
        <p class="salience__foot mono">
          Half-life {FUSION.halfLifeLongDays} days unless marked · duplicates collapse above cosine
          {" "}{FUSION.dedupCosine} or Jaccard {FUSION.dedupJaccard} ·
          <code>memory_engine/constants.py</code>
        </p>
      </div>

      {/* Pro models — subordinate to recall, because that is where it lands. */}
      <aside class="pro" aria-labelledby="pro-h">
        <div class="pro__head">
          <span class="tag tag--ember">Opt-in · paid entitlement · off by default</span>
          <h3 id="pro-h">And if you want a bigger model, it runs on your keys.</h3>
          <p>
            Turn on cloud models for memory and the engine can use a frontier model for five
            purposes. It never holds a key: it asks a signed courier what it may use and gets a
            15-minute bearer scoped to those purposes.
          </p>
        </div>
        <ul class="pro__purposes">
          {
            PRO_PURPOSES.map((p) => (
              <li>
                <code>{p.purpose}</code>
                <span>{p.what}</span>
              </li>
            ))
          }
        </ul>
        <ul class="pro__invariants">
          {PRO_INVARIANTS.map((inv) => <li>{inv}</li>)}
        </ul>
      </aside>

      <p class="reg__foot mono">
        Source · <code>memory_engine/constants.py</code> ·
        <code>tools/openburnbar-mcp/README.md</code> § Pro models · <code>docs/PRIVACY.md</code>
      </p>
    </div>
  </section>

  {/* ══════════════════════ 04 · COLLECTION ══════════════════════ */}
  <section class="reg reg--alt" id="collection" aria-labelledby="collection-h">
    <div class="container container--wide">
      <header class="reg__head">
        <span class="reg__n mono" aria-hidden="true">04</span>
        <div class="reg__headtext">
          <span class="eyebrow eyebrow--ember">Collection</span>
          <h2 id="collection-h">It fills itself in.</h2>
          <p class="lead">
            A memory tool only helps if something calls it. Normally that means the agent deciding,
            mid-task, that a fact is worth keeping — which is exactly the moment it is thinking
            about something else. A <code>SessionEnd</code> hook closes the gap: when a Claude Code session
            ends, the transcript goes through the same pipeline as everything above.
          </p>
        </div>
      </header>

      <div class="collect">
        <div class="collect__code">
          <div class="code" data-code>
            <div class="code__strip">
              <span class="code__meta mono">user-level ~/.claude/settings.json</span>
              <button class="code__copy mono" type="button" data-copy data-copy-label="session hook"
                >copy</button
              >
            </div>
            <pre
              class="code__pre mono"
              tabindex="0"><code>{SESSION_HOOK_LINES.join("\n")}</code></pre>
          </div>
          <p class="collect__warn">
            <strong>Use the absolute path.</strong>
            <code>$CLAUDE_PROJECT_DIR</code> expands to whatever project the session ran in, not to your
            BurnBar checkout — so the hook would go looking for the script inside every unrelated repository.
            Inside the checkout itself, the repo-relative form is the correct one.
          </p>
        </div>

        <div class="collect__facts">
          <h3>What it does, exactly</h3>
          <ul class="ticks">
            <li>
              Keeps only <strong>user and assistant prose</strong>. Tool calls, tool results,
              thinking blocks, summaries and wrapper tags are dropped before anything is read.
            </li>
            <li>
              Trims to the last <strong>400 messages / 200,000 characters</strong> and memorizes against
              the session's working directory.
            </li>
            <li>
              Keeps <strong>both halves of the provenance</strong> — the extractor's message marker behind
              the caller's reference — so a memory traces back to the session and the turn it came from.
            </li>
            <li>
              <strong>Never blocks session end.</strong> A 20-second budget, one JSON status line, exit
              0 in every case but a usage error.
            </li>
            <li>
              <strong>Idempotent.</strong> The ingest receipt is keyed on the transcript's content hash,
              so a <code>--resume</code>, a replay, or two hooks firing writes nothing twice.
            </li>
          </ul>

          <h3 class="collect__h2">The statuses it prints</h3>
          <ul class="statuses">
            {
              HOOK_STATUSES.map((s) => (
                <li>
                  <code>{s.id}</code>
                  <span>{s.note}</span>
                </li>
              ))
            }
          </ul>
          <p class="collect__honest">
            <span class="tag tag--review">Expect this</span>
            The first session end on a machine without the virtualenv usually memorizes nothing: building
            the interpreter eats the hook budget, so that run reports <code>timeout</code>. The venv
            it built persists and every session after it completes normally. Running the bootstrap
            once by hand skips that lost run.
          </p>
          <p class="collect__off mono">
            OPENBURNBAR_MEMORY_SESSION_HOOK=off — nothing is read and no store is created.
          </p>
        </div>
      </div>

      <p class="reg__foot mono">
        Source · <code>tools/openburnbar-mcp/hooks/claude-code-session-end.sh</code> ·
        <code>memorize_transcript.py</code>
      </p>
    </div>
  </section>

  {/* ══════════════════════ 05 · PROOF ══════════════════════ */}
  <section class="reg" id="proof" aria-labelledby="proof-h">
    <div class="container container--wide">
      <header class="reg__head">
        <span class="reg__n mono" aria-hidden="true">05</span>
        <div class="reg__headtext">
          <span class="eyebrow eyebrow--ember">Proof</span>
          <h2 id="proof-h">The numbers, the command, and what stops them sliding.</h2>
          <p class="lead">
            Every figure below is produced by a script in the repository, over a gold set in the
            repository. {pinnedCount} of {MEASUREMENTS.length} are held in place by a committed assertion
            — the floor only moves up. The rest need a model on your own machine, so we say so instead
            of quoting them as if CI watched them.
          </p>
        </div>
      </header>

      <ul class="bench">
        {
          MEASUREMENTS.map((m) => (
            <li class="bench__row" data-pinned={m.pin ? "true" : "false"}>
              <p class="bench__fig mono">
                {m.figure}
                {m.unit && <span class="bench__unit"> {m.unit}</span>}
              </p>
              <div class="bench__body">
                <h3 class="bench__label">{m.label}</h3>
                <p class="bench__corpus">{m.corpus}</p>
                {m.caveat && <p class="bench__caveat">{m.caveat}</p>}
              </div>
              <div class="bench__meta">
                <code class="bench__cmd">{m.command}</code>
                {m.pin ? (
                  <p class="bench__pin">
                    <span class="tag tag--exact">Pinned</span>
                    <span class="bench__pintext mono">{m.pin}</span>
                  </p>
                ) : (
                  <p class="bench__pin">
                    <span class="tag tag--unavailable">Measured, not pinned</span>
                  </p>
                )}
              </div>
            </li>
          ))
        }
      </ul>

      <p class="reg__foot mono">
        Source · <code>tools/openburnbar-mcp/eval_memory.py</code> ·
        <code>tools/openburnbar-mcp/tests/</code> · gold sets in
        <code>tools/openburnbar-mcp/eval/</code>
      </p>
    </div>
  </section>

  {/* ══════════════════════ 06 · BOUNDARY ══════════════════════ */}
  <section class="reg reg--alt" id="boundary" aria-labelledby="boundary-h">
    <div class="container container--wide">
      <header class="reg__head">
        <span class="reg__n mono" aria-hidden="true">06</span>
        <div class="reg__headtext">
          <span class="eyebrow eyebrow--ember">The boundary</span>
          <h2 id="boundary-h">What stays. What leaves. What isn't built yet.</h2>
          <p class="lead">
            The first column is the whole product with nothing turned on. The second needs two
            separate consents and a paid entitlement, and is fail-closed at every lever. The third
            exists so the first two can be read as complete.
          </p>
        </div>
      </header>

      <div class="lanes">
        {
          BOUNDARY.map((lane) => (
            <article class="lane" data-status={lane.status} aria-labelledby={`lane-${lane.id}`}>
              <header class="lane__head">
                <span class="lane__badge mono">{lane.statusLabel}</span>
                <h3 id={`lane-${lane.id}`} class="lane__h">
                  {lane.title}
                </h3>
                <p class="lane__sum">{lane.summary}</p>
              </header>
              <dl class="lane__rows">
                {lane.rows.map((row) => (
                  <div class="lane__row">
                    <dt>{row.item}</dt>
                    <dd>{row.note}</dd>
                  </div>
                ))}
              </dl>
              <p class="lane__src mono">{lane.source}</p>
            </article>
          ))
        }
      </div>

      <p class="reg__foot mono">
        Source · <code>docs/PRIVACY.md</code> · <code>tools/openburnbar-mcp/README.md</code> ·
        <a href="/privacy">the full privacy model</a>
      </p>
    </div>
  </section>

  {/* ══════════════════════ 07 · SETUP ══════════════════════ */}
  <section class="reg" id="setup" aria-labelledby="setup-h">
    <div class="container container--wide">
      <header class="reg__head">
        <span class="reg__n mono" aria-hidden="true">07</span>
        <div class="reg__headtext">
          <span class="eyebrow eyebrow--ember">Setup</span>
          <h2 id="setup-h">One server. Five clients. Under two minutes.</h2>
          <p class="lead">
            The launcher bootstraps itself the first time a client starts it, so the only thing you
            genuinely have to do is point your client at an absolute path. Run the bootstrap by hand
            first if you would rather not lose your first session's memories to a cold start.
          </p>
        </div>
      </header>

      <ol class="steps">
        <li class="step">
          <p class="step__n mono">Step 1</p>
          <h3 class="step__h">Clone and bootstrap</h3>
          <div class="code" data-code>
            <div class="code__strip">
              <span class="code__meta mono">no Rust toolchain · Python 3.11+</span>
              <button
                class="code__copy mono"
                type="button"
                data-copy
                data-copy-label="bootstrap commands">copy</button
              >
            </div>
            <pre class="code__pre mono" tabindex="0"><code>{BOOTSTRAP_LINES.join("\n")}</code></pre>
          </div>
        </li>

