  .fuse {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: var(--s-4);
    align-items: stretch;
    margin-bottom: var(--s-3);
  }

  @media (max-width: 780px) {
    .fuse {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .fuse__lane {
    display: grid;
    gap: var(--s-2);
    align-content: start;
    padding: var(--s-5);
    border-radius: var(--r-md);
    border: 1px solid var(--ink-line);
    background: var(--ink-surface);
  }

  .fuse__lane[data-lane="lexical"] {
    border-left: 2px solid color-mix(in oklab, var(--mercury-bright) 45%, var(--ink-line));
  }

  .fuse__lane[data-lane="semantic"] {
    border-left: 2px solid var(--ember-core);
  }

  .fuse__label {
    margin: 0;
    font-size: var(--t-eyebrow);
    letter-spacing: var(--tracking-uppercase);
    color: var(--text-mute);
    --opsz: var(--opsz-caption);
  }

  .fuse__weight {
    margin: 0;
    font-size: var(--t-h3);
    color: var(--text-bright);
    line-height: 1;
    --opsz: var(--opsz-h3);
  }

  .fuse__note {
    margin: 0;
    font-size: var(--t-caption);
    color: var(--text-mute);
  }

  .fuse__join {
    display: grid;
    place-items: center;
    padding-inline: var(--s-2);
  }

  .fuse__joinlab {
    font-size: var(--t-eyebrow);
    letter-spacing: var(--tracking-uppercase);
    color: var(--ember-bright);
    border: 1px dashed color-mix(in oklab, var(--core-fire) 45%, var(--ink-line));
    border-radius: var(--r-pill);
    padding: 0.25rem var(--s-3);
    white-space: nowrap;
    --opsz: var(--opsz-caption);
  }

  .fuse__caption {
    margin: 0 0 var(--s-7);
    color: var(--text-mute);
    font-size: var(--t-caption);
    max-width: 74ch;
  }

  .salience__h {
    font-size: var(--t-h3);
    font-weight: var(--wght-semibold);
    color: var(--text-bright);
    margin: 0 0 var(--s-3);
    --opsz: var(--opsz-h3);
  }

  .salience__intro {
    margin: 0 0 var(--s-5);
    max-width: 74ch;
    color: var(--text-base);
  }

  .kinds {
    list-style: none;
    margin: 0 0 var(--s-4);
    padding: 0;
    display: grid;
    gap: 1px;
    background: var(--ink-line-soft);
    border: 1px solid var(--ink-line);
    border-radius: var(--r-md);
    overflow: hidden;
  }

  /* The flags column is a fixed width rather than `auto` so the example
     column starts at the same x on every row — an `auto` track collapses on
     the rows that carry no flag and leaves the examples ragged. */
  .kind {
    display: grid;
    grid-template-columns: 8rem 7rem 3.2rem 9rem minmax(0, 1fr);
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-3) var(--s-4);
    background: var(--ink-void);
  }

  .kind__name {
    font-family: var(--font-mono);
    font-size: var(--t-caption);
    color: var(--text-bright);
  }

  .kind__bar {
    display: block;
    height: 5px;
    border-radius: var(--r-pill);
    background: var(--ink-surface-2);
    overflow: hidden;
  }

  .kind__fill {
    display: block;
    height: 100%;
    width: var(--w);
    border-radius: inherit;
    background: linear-gradient(90deg, var(--core-red), var(--core-fire) 55%, var(--core-amber));
  }

  .kind__val {
    font-size: var(--t-caption);
    color: var(--text-mute);
    text-align: right;
    --opsz: var(--opsz-caption);
  }

  .kind__flags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }

  .kind__flags .tag {
    font-size: var(--t-eyebrow);
    padding: 0.1rem var(--s-2);
    --opsz: var(--opsz-caption);
  }

  .kind__eg {
    font-size: var(--t-caption);
    color: var(--text-dim);
    min-width: 0;
  }

  @media (max-width: 1000px) {
    .kind {
      grid-template-columns: 8rem minmax(0, 1fr) 3.2rem;
      grid-template-areas:
        "name bar val"
        "eg eg eg"
        "flags flags flags";
      row-gap: var(--s-2);
    }
    .kind__name {
      grid-area: name;
    }
    .kind__bar {
      grid-area: bar;
    }
    .kind__val {
      grid-area: val;
    }
    .kind__eg {
      grid-area: eg;
    }
    .kind__flags {
      grid-area: flags;
    }
    .kind__flags:empty {
      display: none;
    }
  }

  @media (max-width: 520px) {
    .kind {
      grid-template-columns: minmax(0, 1fr) 3.2rem;
      grid-template-areas:
        "name val"
        "bar bar"
        "eg eg"
        "flags flags";
    }
  }

  .salience__foot {
    font-size: var(--t-eyebrow);
    color: var(--text-dim);
    margin: 0 0 var(--s-7);
    --opsz: var(--opsz-caption);
  }

  .pro {
    display: grid;
    gap: var(--s-5);
    padding: var(--s-6);
    border-radius: var(--r-lg);
    border: 1px solid color-mix(in oklab, var(--core-fire) 28%, var(--ink-line));
    background: linear-gradient(180deg, var(--ember-wash), transparent 55%), var(--ink-surface);
  }

  .pro__head {
    display: grid;
    gap: var(--s-3);
    justify-items: start;
  }

  .pro__head h3 {
    font-size: var(--t-h3);
    font-weight: var(--wght-semibold);
    color: var(--text-bright);
    margin: 0;
    max-width: 24ch;
    --opsz: var(--opsz-h3);
  }

  .pro__head p {
    margin: 0;
    max-width: 70ch;
    color: var(--text-base);
  }

  .pro__purposes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-3);
  }

  .pro__purposes li {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: var(--s-4);
    align-items: baseline;
    padding-bottom: var(--s-3);
    border-bottom: 1px solid var(--ink-line-soft);
    font-size: var(--t-caption);
    color: var(--text-mute);
  }

  .pro__invariants {
    margin: 0;
    padding-left: 1.15rem;
    list-style: disc;
    display: grid;
    gap: var(--s-2);
    color: var(--text-base);
    font-size: var(--t-caption);
    max-width: 82ch;
  }

  .pro__invariants li::marker {
    color: var(--ember-core);
  }

  @media (max-width: 640px) {
    .pro__purposes li {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-1);
    }
  }

  /* ---------- 04 · collection ---------- */

  .collect {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--s-6);
    align-items: start;
  }

  @media (max-width: 900px) {
    .collect {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .collect__warn {
    margin: var(--s-4) 0 0;
    padding: var(--s-4);
    border-left: 2px solid var(--core-amber);
    background: var(--ink-surface);
    border-radius: 0 var(--r-sm) var(--r-sm) 0;
    font-size: var(--t-caption);
    color: var(--text-mute);
  }

  .collect__warn strong {
    color: var(--text-bright);
    display: block;
    margin-bottom: var(--s-1);
  }

  .collect__facts h3 {
    font-size: var(--t-h4);
    font-weight: var(--wght-semibold);
    color: var(--text-bright);
    margin: 0 0 var(--s-3);
    --opsz: var(--opsz-lead);
  }

  .collect__h2 {
    margin-top: var(--s-6) !important;
  }

  .ticks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-3);
  }

  .ticks li {
    position: relative;
    padding-left: 1.5rem;
    font-size: var(--t-caption);
    line-height: var(--leading-base);
    color: var(--text-mute);
  }

  .ticks li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1px solid var(--ember-core);
    background: var(--ember-wash);
  }

  .ticks strong {
    color: var(--text-bright);
    font-weight: var(--wght-semibold);
  }

  .statuses {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-2);
  }

  .statuses li {
    display: grid;
    grid-template-columns: 14rem minmax(0, 1fr);
    gap: var(--s-3);
    align-items: baseline;
    font-size: var(--t-caption);
    color: var(--text-dim);
    padding-bottom: var(--s-2);
    border-bottom: 1px solid var(--ink-line-soft);
  }

  .statuses code {
    justify-self: start;
  }

  @media (max-width: 560px) {
    .statuses li {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-1);
    }
  }

  /* Deliberately a flowing paragraph, not a grid: the inline <code> and the
     leading tag have to sit in the sentence, and a grid would promote each of
     them to its own row. */
  .collect__honest {
    margin: var(--s-5) 0 var(--s-3);
    font-size: var(--t-caption);
    line-height: var(--leading-base);
    color: var(--text-mute);
    max-width: 74ch;
  }

  .collect__honest .tag {
    margin-right: var(--s-2);
    vertical-align: baseline;
  }

  .collect__off {
    margin: 0;
    font-size: var(--t-eyebrow);
    color: var(--text-dim);
    --opsz: var(--opsz-caption);
  }

  /* ---------- 05 · proof ---------- */

  .bench {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1px;
    background: var(--ink-line-soft);
    border: 1px solid var(--ink-line);
    border-radius: var(--r-lg);
    overflow: hidden;
  }

  .bench__row {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1.4fr) minmax(0, 1fr);
    gap: var(--s-5);
    align-items: start;
    padding: var(--s-5);
    background: var(--ink-void);
  }

  @media (max-width: 900px) {
    .bench__row {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-3);
    }
  }

  .bench__fig {
    font-size: clamp(1.8rem, 1.3rem + 1.8vw, 2.6rem);
    line-height: 1;
    color: var(--text-bright);
    margin: 0;
    letter-spacing: var(--tracking-tight);
    --opsz: var(--opsz-h2);
  }

  .bench__row[data-pinned="true"] .bench__fig {
    color: var(--ember-bright);
  }

  .bench__unit {
    font-size: 0.42em;
    color: var(--text-dim);
    letter-spacing: 0.02em;
  }

  .bench__label {
    font-size: var(--t-body);
    font-weight: var(--wght-semibold);
    color: var(--text-bright);
    margin: 0 0 var(--s-2);
    --opsz: var(--opsz-body);
  }

  .bench__corpus,
  .bench__caveat {
    margin: 0;
    font-size: var(--t-caption);
    line-height: var(--leading-base);
    color: var(--text-mute);
  }

  .bench__caveat {
    margin-top: var(--s-2);
    color: var(--text-dim);
    padding-left: var(--s-3);
    border-left: 1px solid var(--ink-line);
  }

  .bench__meta {
    display: grid;
    gap: var(--s-3);
    align-content: start;
    min-width: 0;
  }

  .bench__cmd {
    font-family: var(--font-mono);
    font-size: var(--t-eyebrow);
    color: var(--text-base);
    background: var(--ink-surface);
    border: 1px solid var(--ink-line);
    border-radius: var(--r-sm);
    padding: var(--s-2) var(--s-3);
    word-break: break-word;
    --opsz: var(--opsz-caption);
  }

  .bench__pin {
    display: grid;
    gap: var(--s-2);
    justify-items: start;
    margin: 0;
  }

  .bench__pintext {
    font-size: var(--t-eyebrow);
    color: var(--text-dim);
    line-height: 1.6;
    --opsz: var(--opsz-caption);
  }

  /* ---------- 06 · boundary ---------- */

  .lanes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(19rem, 100%), 1fr));
    gap: var(--s-4);
    align-items: start;
  }

  .lane {
    display: grid;
    gap: var(--s-4);
    align-content: start;
    padding: var(--s-5);
    border-radius: var(--r-lg);
    border: 1px solid var(--ink-line);
    border-top: 3px solid var(--tier-zero);
    background: var(--glass-bg);
  }

  .lane[data-status="always"] {
    border-top-color: var(--tier-e2e);
  }

  .lane[data-status="opt-in"] {
    border-top-color: var(--tier-server);
  }

  .lane[data-status="not-shipped"] {
    border-top-color: var(--tier-zero);
    border-style: dashed;
    border-top-style: solid;
  }

  .lane__head {
    display: grid;
    gap: var(--s-2);
    justify-items: start;
  }

  .lane__badge {
    font-size: var(--t-eyebrow);
    letter-spacing: var(--tracking-uppercase);
    color: var(--tier-zero);
    --opsz: var(--opsz-caption);
  }

  .lane[data-status="always"] .lane__badge {
    color: var(--tier-e2e);
  }

  .lane[data-status="opt-in"] .lane__badge {
    color: var(--tier-server);
  }

  .lane__h {
    font-size: var(--t-h3);
    font-weight: var(--wght-semibold);
    color: var(--text-bright);
    margin: 0;
    --opsz: var(--opsz-h3);
  }

  .lane__sum {
    margin: 0;
    font-size: var(--t-caption);
    line-height: var(--leading-base);
    color: var(--text-mute);
  }

  .lane__rows {
    display: grid;
    gap: var(--s-3);
    margin: 0;
  }

  .lane__row {
    padding-top: var(--s-3);
    border-top: 1px solid var(--ink-line-soft);
  }

  .lane__row dt {
    font-weight: var(--wght-semibold);
    color: var(--text-base);
    font-size: var(--t-caption);
    margin-bottom: var(--s-1);
  }

  .lane__row dd {
    margin: 0;
    font-size: var(--t-caption);
    line-height: var(--leading-base);
    color: var(--text-dim);
  }

  .lane__src {
    margin: 0;
    font-size: var(--t-eyebrow);
    color: var(--text-dim);
    word-break: break-word;
    --opsz: var(--opsz-caption);
  }

  /* ---------- 07 · setup ---------- */

  .steps {
    list-style: none;
    margin: 0 0 var(--s-8);
    padding: 0;
    display: grid;
    gap: var(--s-7);
  }

  .step {
    display: grid;
    gap: var(--s-3);
    padding-left: var(--s-5);
    border-left: 1px solid var(--ink-line);
  }

  .step__n {
    margin: 0;
    font-size: var(--t-eyebrow);
    letter-spacing: var(--tracking-uppercase);
    color: var(--ember-bright);
    --opsz: var(--opsz-caption);
  }

  .step__h {
    font-size: var(--t-h3);
    font-weight: var(--wght-semibold);
    color: var(--text-bright);
    margin: 0;
    --opsz: var(--opsz-h3);
  }

  .step__hint {
    margin: 0;
    max-width: 74ch;
    color: var(--text-mute);
    font-size: var(--t-caption);
  }

  .step__token {
    color: var(--ember-bright);
  }

  /* code block — capped at a measure a config actually occupies, so a
     nine-line JSON snippet does not stretch across an ultrawide viewport
     with 700px of empty gutter beside it.

     `min-width: 0` is load-bearing, not decoration: a grid or flex item's
     automatic minimum size is its content, and a 90-character config line
     inside it will widen its track past the viewport on a 320px phone even
     though the <pre> itself scrolls. Every ancestor between the container
     and the <pre> needs the same escape hatch, which is what the list
     below is. */
  .code {
    max-width: 60rem;
    min-width: 0;
    border: 1px solid var(--ink-line);
    border-radius: var(--r-md);
    background: var(--ink-void);
    overflow: hidden;
  }

  .steps,
  .step,
  .tabs,
  .tabs__panel,
  .collect__code,
  .collect__facts,
  .verify,
  .verify__list,
  .check,
  .check__body,
  .bench__body,
  .bench__meta,
  .lane,
  .limit {
    min-width: 0;
  }

  .code__strip {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    align-items: center;
    justify-content: space-between;
    padding: var(--s-2) var(--s-3);
    border-bottom: 1px solid var(--ink-line-soft);
    background: var(--ink-surface);
  }

  .code__meta {
    font-size: var(--t-eyebrow);
    color: var(--text-dim);
    --opsz: var(--opsz-caption);
  }

  .code__copy {
    font-size: var(--t-eyebrow);
    letter-spacing: var(--tracking-uppercase);
    color: var(--text-mute);
    background: transparent;
    border: 1px solid var(--ink-line);
    border-radius: var(--r-pill);
    padding: 0.2rem var(--s-3);
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
    --opsz: var(--opsz-caption);
  }

  .code__copy:hover,
  .code__copy:focus-visible {
    color: var(--ember-bright);
    border-color: color-mix(in oklab, var(--core-fire) 45%, var(--ink-line));
  }

  .code__copy[data-flash] {
    color: var(--status-exact);
    border-color: color-mix(in oklab, var(--status-exact) 45%, var(--ink-line));
  }

  /* A block that scrolls has to be reachable by keyboard, or the content
     past its right edge is unreadable without a mouse — hence tabindex="0"
     in the markup and a real focus ring here. */
  .code__pre {
    margin: 0;
    padding: var(--s-4);
    overflow-x: auto;
    scrollbar-width: thin;
    font-size: var(--t-caption);
    line-height: 1.75;
    color: var(--text-base);
    tab-size: 2;
  }

  .code__pre:focus-visible {
    outline: 2px solid var(--ember-bright);
    outline-offset: -2px;
  }

  /* tabs */
  .tabs {
    display: grid;
    gap: var(--s-3);
  }

  .tabs__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }

  .tabs__tab {
    font-family: var(--font-mono);
    font-size: var(--t-caption);
    color: var(--text-mute);
    background: transparent;
    border: 1px solid var(--ink-line);
    border-radius: var(--r-pill);
    padding: 0.35rem var(--s-4);
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease);
  }

  .tabs__tab:hover {
    color: var(--text-bright);
    border-color: var(--ink-line-bright);
  }

  .tabs__tab[aria-selected="true"] {
    color: var(--ink-void);
    background: var(--ember-bright);
    border-color: var(--ember-bright);
    font-weight: var(--wght-medium);
  }

  .tabs__panel {
    display: grid;
    gap: var(--s-3);
  }

  .tabs__panel:focus-visible {
    outline: 2px solid var(--ember-bright);
    outline-offset: 4px;
    border-radius: var(--r-md);
  }

  .tabs__note {
    margin: 0;
    font-size: var(--t-caption);
    color: var(--text-mute);
    max-width: 74ch;
  }

  /* verification checklist */
  .verify {
    padding: var(--s-6);
    border-radius: var(--r-lg);
    border: 1px solid var(--ink-line);
    background: var(--ink-surface);
    margin-bottom: var(--s-6);
  }

  .verify__head {
    display: grid;
    gap: var(--s-2);
    margin-bottom: var(--s-5);
  }

  .verify__head h3 {
    font-size: var(--t-h3);
    font-weight: var(--wght-semibold);
    color: var(--text-bright);
    margin: 0;
    --opsz: var(--opsz-h3);
  }

  .verify__head p {
    margin: 0;
    max-width: 70ch;
    color: var(--text-mute);
    font-size: var(--t-caption);
  }

  .verify__progress {
    font-size: var(--t-eyebrow);
    letter-spacing: var(--tracking-uppercase);
    color: var(--ember-bright);
    --opsz: var(--opsz-caption);
  }

  .verify__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-4);
  }

  /* Three tracks on a wide viewport — box, title, detail — so the panel
     uses its width instead of leaving a 600px gutter, and collapses to the
     stacked form below 900px. */
  .check {
    display: grid;
    grid-template-columns: auto minmax(0, 16rem) minmax(0, 1fr);
    gap: var(--s-2) var(--s-4);
    align-items: start;
    padding-bottom: var(--s-4);
    border-bottom: 1px solid var(--ink-line-soft);
  }

  .check:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .check__box {
    width: 1.15rem;
    height: 1.15rem;
    margin: 0.15rem 0 0;
    accent-color: var(--core-fire);
    cursor: pointer;
  }

  .check__label {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-3);
    cursor: pointer;
    color: var(--text-bright);
    font-weight: var(--wght-semibold);
  }

  .check__n {
    color: var(--ember-core);
    font-size: var(--t-eyebrow);
    font-weight: var(--wght-regular);
    --opsz: var(--opsz-caption);
  }

  .check__body {
    grid-column: 3;
    display: grid;
    gap: var(--s-2);
  }

  @media (max-width: 900px) {
    .check {
      grid-template-columns: auto minmax(0, 1fr);
    }
    .check__body {
      grid-column: 2;
    }
  }

  .check__how,
  .check__expect,
  .check__ifnot {
    margin: 0;
    font-size: var(--t-caption);
    line-height: var(--leading-base);
    color: var(--text-mute);
    max-width: 78ch;
  }

  .check__tag {
    display: inline-block;
    font-size: var(--t-eyebrow);
    letter-spacing: var(--tracking-uppercase);
    color: var(--status-exact);
    margin-right: var(--s-2);
    --opsz: var(--opsz-caption);
  }

  .check__tag--warn {
    color: var(--status-estimated);
  }

  .check__ifnot {
    color: var(--text-dim);
  }

  .check__box:checked ~ .check__label .check__title {
    text-decoration: line-through;
    text-decoration-color: var(--ember-core);
    color: var(--text-mute);
  }

  .crossref {
    display: grid;
    gap: var(--s-3);
    justify-items: start;
    padding: var(--s-5);
    border-radius: var(--r-md);
    border: 1px dashed var(--ink-line-bright);
  }

  .crossref h3 {
    font-size: var(--t-h4);
    font-weight: var(--wght-semibold);
    color: var(--text-bright);
    margin: 0;
    --opsz: var(--opsz-lead);
  }

  .crossref p {
    margin: 0;
    max-width: 70ch;
    color: var(--text-mute);
    font-size: var(--t-caption);
  }

  /* ---------- 08 · limits ---------- */

  .limits {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(19rem, 100%), 1fr));
    gap: var(--s-5);
  }

  .limit {
    display: grid;
    gap: var(--s-2);
    align-content: start;
    padding-top: var(--s-4);
    border-top: 1px solid var(--ink-line);
  }

  .limit__h {
    font-size: var(--t-h4);
    font-weight: var(--wght-semibold);
    color: var(--text-bright);
    margin: 0;
    --opsz: var(--opsz-lead);
  }

  .limit__body {
    margin: 0;
    font-size: var(--t-caption);
    line-height: var(--leading-base);
    color: var(--text-mute);
  }

  .limit__src {
    margin: 0;
    font-size: var(--t-eyebrow);
    color: var(--text-dim);
    word-break: break-word;
    --opsz: var(--opsz-caption);
  }

  /* ---------- end ---------- */

  .mem-end {
    border-top: 1px solid var(--ink-line);
  }

  .mem-end__inner {
    display: grid;
    gap: var(--s-5);
    justify-items: center;
    text-align: center;
  }

  .mem-end__h {
    font-size: var(--t-h1);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-display);
    font-weight: var(--wght-display);
    margin: 0;
    --opsz: var(--opsz-h1);
  }

  .mem-end__lead {
    max-width: 62ch;
  }

  /* ---------- light theme corrections ----------
     The dark theme paints on near-black; on paper the same surfaces need
     their own values or they read as grey mud. Tokens do most of it; these
     are the handful of places that reference an explicit dark surface. */
  :global(:root[data-theme="light"]) .specimen__side,
  :global(:root[data-theme="light"]) .kind,
  :global(:root[data-theme="light"]) .bench__row,
  :global(:root[data-theme="light"]) .code,
  :global(:root[data-theme="light"]) .code__pre {
    background: rgba(255, 255, 255, 0.6);
  }

  :global(:root[data-theme="light"]) .tabs__tab[aria-selected="true"] {
    color: #ffffff;
  }

  :global(:root[data-theme="light"]) .pipe__dot {
    background: var(--ink-void);
  }
  /* ============================================================
     COVERAGE ROUND — the register grew from eight sections to
     fifteen, so it gained the one thing a long bound record has and
     a long web page usually does not: PARTS. Three ruled dividers,
     three groups in the index, and the numerals keep running across
     them. The hierarchy is the parts; the numerals are the rhythm.

     Everything below reuses the page's own devices — ruled rows,
     margin numerals, ember only where it means something — so the
     new half reads as the same document rather than an appendix.
     ============================================================ */

  /* ---------- the part divider ---------- */

  .part {
    border-top: 1px solid var(--ink-line-bright);
    background: linear-gradient(180deg, var(--ember-wash), transparent 70%);
    padding-block: var(--s-7) var(--s-6);
    scroll-margin-top: 5rem;
  }

  .part__inner {
    display: grid;
    gap: var(--s-3);
    justify-items: start;
  }

  .part__n {
    font-size: var(--t-eyebrow);
    letter-spacing: var(--tracking-uppercase);
    text-transform: uppercase;
    color: var(--ember-bright);
    --opsz: var(--opsz-caption);
  }

  .part__h {
    font-size: var(--t-h2);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    font-weight: var(--wght-display);
    --opsz: var(--opsz-h2);
    color: var(--text-bright);
    margin: 0;
    max-width: 18ch;
  }

  .part__sub {
    margin: 0;
    max-width: 64ch;
    font-size: var(--t-caption);
    line-height: var(--leading-base);
    color: var(--text-mute);
  }

  /* ---------- the index, now in three parts ---------- */

  .mem-jump {
    display: grid;
    gap: var(--s-4);
  }

  .mem-jump__part {
    display: grid;
    gap: var(--s-2);
  }

  .mem-jump__lab {
    margin: 0;
    font-size: var(--t-eyebrow);
    letter-spacing: var(--tracking-uppercase);
    text-transform: uppercase;
    color: var(--text-dim);
    --opsz: var(--opsz-caption);
  }

  .mem-jump__partn {
    color: var(--ember-core);
  }

  /* ---------- a shared device: the honest-limit paragraph ----------
     Every new section ends on what it does not do. One rule, one ember
     label, no box — a box would let the eye skip it, which is exactly
     what a stated limit must not allow. */

  .honest {
    margin: var(--s-6) 0 0;
    padding-left: var(--s-4);
    border-left: 2px solid var(--ember-core);
    max-width: 78ch;
    font-size: var(--t-caption);
    line-height: var(--leading-base);
    color: var(--text-mute);
  }

  .honest__lab {
    display: block;
    font-size: var(--t-eyebrow);
    letter-spacing: var(--tracking-uppercase);
    text-transform: uppercase;
    color: var(--ember-bright);
    margin-bottom: var(--s-2);
    --opsz: var(--opsz-caption);
  }

  /* ---------- 04 · time ---------- */

  .tfacts {
    list-style: none;
    margin: 0 0 var(--s-7);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(20rem, 100%), 1fr));
    gap: var(--s-5);
  }

  .tfact {
    min-width: 0;
    padding-top: var(--s-3);
    border-top: 1px solid var(--ink-line);
  }

  .tfact__lab {
    margin: 0 0 var(--s-2);
    font-size: var(--t-eyebrow);
    letter-spacing: var(--tracking-uppercase);
    text-transform: uppercase;
    color: var(--ember-bright);
    --opsz: var(--opsz-caption);
  }

  .tfact__body {
    margin: 0;
    font-size: var(--t-caption);
    line-height: var(--leading-base);
    color: var(--text-mute);
  }

  /* The ledger: trigger → verdict → effect, ruled like a bound register.
     The verdict column is the only ember on the row, because the verdict
     is the thing you came to read. */

  .ledger {
    border: 1px solid var(--ink-line);
    border-radius: var(--r-md);
    background: var(--ink-surface);
    padding: var(--s-5);
  }

  .ledger__h {
    margin: 0 0 var(--s-4);
    font-size: var(--t-h4, 1.15rem);
    font-weight: var(--wght-semibold);
    color: var(--text-bright);
    --opsz: var(--opsz-lead);
  }

  .ledger__rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }

  .ledger__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 11rem minmax(0, 1.5fr);
    gap: var(--s-3) var(--s-4);
    align-items: baseline;
    padding: var(--s-3) 0;
    border-top: 1px solid var(--ink-line-soft);
    min-width: 0;
  }

  .ledger__row:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .ledger__trigger {
    margin: 0;
    font-size: var(--t-caption);
    color: var(--text-base);
  }

  .ledger__verdict {
    margin: 0;
    font-size: var(--t-eyebrow);
    letter-spacing: 0.04em;
    color: var(--ember-bright);
    --opsz: var(--opsz-caption);
  }

  .ledger__effect {
    margin: 0;
    font-size: var(--t-caption);
    line-height: var(--leading-base);
    color: var(--text-dim);
  }

  @media (max-width: 860px) {
    .ledger__row {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-2);
    }
  }

  /* ---------- 05 · forget ---------- */

  .purge {
    border: 1px solid color-mix(in oklab, var(--status-burn) 30%, var(--ink-line));
    border-radius: var(--r-md);
    background: linear-gradient(180deg, var(--ember-wash), transparent 70%), var(--ink-surface);
    padding: var(--s-5);
    margin-bottom: var(--s-7);
  }

  .purge__lab {
    margin: 0 0 var(--s-4);
    font-size: var(--t-eyebrow);
    letter-spacing: var(--tracking-uppercase);
    text-transform: uppercase;
    color: var(--ember-bright);
    --opsz: var(--opsz-caption);
  }

  .purge__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-2);
  }

  .purge__item {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: var(--s-3);
    align-items: baseline;
    padding-bottom: var(--s-2);
    border-bottom: 1px solid var(--ink-line-soft);
    min-width: 0;
  }

  .purge__name {
    font-family: var(--font-mono);
    font-size: var(--t-eyebrow);
    color: var(--text-bright);
    /* struck through: the row is what the delete removes */
    text-decoration: line-through;
    text-decoration-color: var(--status-burn);
    text-decoration-thickness: 1px;
    --opsz: var(--opsz-caption);
  }

  .purge__note {
    font-size: var(--t-caption);
    line-height: var(--leading-base);
    color: var(--text-mute);
  }

  .purge__foot {
    margin: var(--s-4) 0 0;
    font-size: var(--t-eyebrow);
    color: var(--text-dim);
    --opsz: var(--opsz-caption);
  }

  @media (max-width: 560px) {
    .purge__item {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-1);
    }
  }

  .fsteps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-5);
  }

  .fstep {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: var(--s-4);
    align-items: start;
    min-width: 0;
  }

  .fstep__n {
    font-size: var(--t-caption);
    color: var(--ember-bright);
    line-height: 1.4;
    --opsz: var(--opsz-caption);
  }

  .fstep__body {
    min-width: 0;
  }

  .fstep__h {
    margin: 0 0 var(--s-2);
    font-size: var(--t-body);
    font-weight: var(--wght-semibold);
    color: var(--text-bright);
    --opsz: var(--opsz-body);
  }

  .fstep__body p {
    margin: 0;
    font-size: var(--t-caption);
    line-height: var(--leading-base);
    color: var(--text-mute);
  }

  @media (max-width: 560px) {
    .fstep {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-1);
    }
  }

  /* ---------- 07 · review ---------- */

  .rsurfaces {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(22rem, 100%), 1fr));
    gap: var(--s-5);
  }

  .rsurface {
    min-width: 0;
    padding-top: var(--s-3);
    border-top: 1px solid var(--ink-line);
    display: grid;
    gap: var(--s-2);
    align-content: start;
  }

  .rsurface__tool {
    justify-self: start;
    font-family: var(--font-mono);
    font-size: var(--t-eyebrow);
    color: var(--ember-bright);
    background: none;
    border: 0;
    padding: 0;
    --opsz: var(--opsz-caption);
  }

  .rsurface__h {
    margin: 0;
    font-size: var(--t-body);
    font-weight: var(--wght-semibold);
    color: var(--text-bright);
    --opsz: var(--opsz-body);
  }

  .rsurface__body {
    margin: 0;
    font-size: var(--t-caption);
    line-height: var(--leading-base);
    color: var(--text-mute);
  }

  /* ---------- 03 · packs (inside recall) ---------- */

  .packs {
    margin-top: var(--s-7);
    border-top: 1px solid var(--ink-line);
    padding-top: var(--s-5);
  }

  .packs__h {
    margin: 0 0 var(--s-2);
    font-size: var(--t-h4, 1.15rem);
    font-weight: var(--wght-semibold);
    color: var(--text-bright);
    --opsz: var(--opsz-lead);
  }

  .packs__intro {
    margin: 0 0 var(--s-5);
    max-width: 70ch;
    font-size: var(--t-caption);
    line-height: var(--leading-base);
    color: var(--text-mute);
  }

  .packs__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(20rem, 100%), 1fr));
    gap: var(--s-5);
  }

  .pack {
    min-width: 0;
    display: grid;
    gap: var(--s-2);
    align-content: start;
    padding: var(--s-4);
    border: 1px solid var(--ink-line);
    border-radius: var(--r-md);
    background: var(--ink-surface);
  }

  .pack__tool {
    justify-self: start;
    font-family: var(--font-mono);
    font-size: var(--t-eyebrow);
    color: var(--ember-bright);
    background: none;
    border: 0;
    padding: 0;
    overflow-wrap: anywhere;
    --opsz: var(--opsz-caption);
  }

  .pack__h {
    margin: 0;
    font-size: var(--t-body);
    font-weight: var(--wght-semibold);
    color: var(--text-bright);
    --opsz: var(--opsz-body);
  }

  .pack__body {
    margin: 0;
    font-size: var(--t-caption);
    line-height: var(--leading-base);
    color: var(--text-mute);
  }

  /* ---------- 08 · code intelligence ---------- */

  .cfacts {
    list-style: none;
    margin: 0 0 var(--s-7);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(24rem, 100%), 1fr));
    gap: var(--s-5);
  }

  .cfact {
    min-width: 0;
    padding-top: var(--s-3);
    border-top: 1px solid var(--ink-line);
  }

  .cfact__h {
    margin: 0 0 var(--s-2);
    font-size: var(--t-body);
    font-weight: var(--wght-semibold);
    color: var(--text-bright);
    --opsz: var(--opsz-body);
  }

  .cfact p {
    margin: 0;
    font-size: var(--t-caption);
    line-height: var(--leading-base);
    color: var(--text-mute);
  }

  .tiers__h {
    margin: 0 0 var(--s-4);
    font-size: var(--t-h4, 1.15rem);
    font-weight: var(--wght-semibold);
    color: var(--text-bright);
    --opsz: var(--opsz-lead);
  }

  .tiers__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-3);
  }

  /* Three tiers, and the eye should be able to tell at a glance which one
     you get for free. The left rule carries that: teal for always-on, gold
     for the one you have to build, mute for the one you have to configure. */
  .tier {
    display: grid;
    gap: var(--s-2);
    padding: var(--s-4);
    border: 1px solid var(--ink-line);
    border-left: 2px solid var(--status-unavailable);
    border-radius: var(--r-md);
    background: var(--ink-surface);
    min-width: 0;
  }

  .tier[data-status="always"] {
    border-left-color: var(--status-exact);
  }

  .tier[data-status="built"] {
    border-left-color: var(--status-estimated);
  }

  .tier__head {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    align-items: baseline;
  }

  .tier__name {
    font-family: var(--font-mono);
    font-size: var(--t-caption);
    color: var(--text-bright);
    background: none;
    border: 0;
    padding: 0;
    --opsz: var(--opsz-caption);
  }

  /* The status colour lives in the left rule, not in this 12px label:
     status-exact measured 4.29:1 and status-estimated 3.94:1 as text at this
     size, both under AA, while a border carries no contrast requirement at
     all. Moving the signal to the rule keeps the glance and passes. */
  .tier__badge {
    font-size: var(--t-eyebrow);
    letter-spacing: var(--tracking-uppercase);
    text-transform: uppercase;
    color: var(--text-mute);
    --opsz: var(--opsz-caption);
  }

  .tier__body {
    margin: 0;
    font-size: var(--t-caption);
    line-height: var(--leading-base);
    color: var(--text-mute);
  }

  /* ---------- 09 · sessions ---------- */

  .sfacts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(24rem, 100%), 1fr));
    gap: var(--s-5);
  }

  .sfact {
    min-width: 0;
    padding-top: var(--s-3);
    border-top: 1px solid var(--ink-line);
  }

  .sfact__h {
    margin: 0 0 var(--s-2);
    font-size: var(--t-body);
    font-weight: var(--wght-semibold);
    color: var(--text-bright);
    --opsz: var(--opsz-body);
  }

  .sfact p {
    margin: 0;
    font-size: var(--t-caption);
    line-height: var(--leading-base);
    color: var(--text-mute);
  }

  /* ---------- 10 · the rest of the server ---------- */

  .surfaces {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-5);
  }

  .surface {
    min-width: 0;
    padding: var(--s-5);
    border: 1px solid var(--ink-line);
    border-radius: var(--r-md);
    background: var(--ink-surface);
    display: grid;
    gap: var(--s-3);
  }

  .surface__head {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    align-items: baseline;
    justify-content: space-between;
  }

  .surface__h {
    margin: 0;
    font-size: var(--t-h4, 1.15rem);
    font-weight: var(--wght-semibold);
    color: var(--text-bright);
    --opsz: var(--opsz-lead);
  }

  /* --ember-core measured 3.75:1 against this panel at 12px, which is below
     AA for small text. --ember-bright clears it and reads the same at a
     glance. Measured in a rendered page, both themes — see the contrast
     sweep in the PR body. The same substitution is made on every 12px ember
     label this round added. */
  .surface__n {
    font-size: var(--t-eyebrow);
    letter-spacing: var(--tracking-uppercase);
    text-transform: uppercase;
    color: var(--ember-bright);
    --opsz: var(--opsz-caption);
  }

  .surface__body,
  .surface__edge {
    margin: 0;
    font-size: var(--t-caption);
    line-height: var(--leading-base);
    color: var(--text-mute);
    max-width: 82ch;
  }

  .surface__edge {
    color: var(--text-dim);
    padding-left: var(--s-3);
    border-left: 1px solid var(--ink-line);
  }

  .surface__edgelab {
    display: block;
    font-size: var(--t-eyebrow);
    letter-spacing: var(--tracking-uppercase);
    text-transform: uppercase;
    color: var(--ember-bright);
    margin-bottom: var(--s-1);
    --opsz: var(--opsz-caption);
  }

  .surface__src {
    margin: 0;
    font-size: var(--t-eyebrow);
    color: var(--text-dim);
    --opsz: var(--opsz-caption);
  }

  /* ---------- 11 · the atlas ----------
     Sixty-three rows would be a wall if they were a wall. They are nine
     native <details> groups, open on arrival so the page works with the
     script blocked, with a filter the script adds once it is running.
     Nothing here is hidden from a reader without JavaScript. */

  .atlas__bar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
    align-items: end;
    justify-content: space-between;
    margin-bottom: var(--s-5);
    padding-bottom: var(--s-4);
    border-bottom: 1px solid var(--ink-line);
  }

  .atlas__field {
    display: grid;
    gap: var(--s-2);
    flex: 1 1 22rem;
    min-width: 0;
  }

  .atlas__lab {
    font-size: var(--t-eyebrow);
    letter-spacing: var(--tracking-uppercase);
    text-transform: uppercase;
    color: var(--text-dim);
    --opsz: var(--opsz-caption);
  }

  .atlas__input {
