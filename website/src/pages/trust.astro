---
import BaseLayout from "@layouts/BaseLayout.astro";
import TrustTierBadge from "@components/TrustTierBadge.astro";
import DomainIcon from "@components/DomainIcon.astro";
import { SITE } from "@data/site";
import { TRUST_TIER_BY_ID, TRUST_DOMAINS } from "@data/trust.generated";

/**
 * burnbar.ai/trust — the public mirror of the in-app Data & Privacy Control
 * Center. Every claim here is GENERATED from packages/data-domains/registry.json
 * (see website/src/data/trust.generated.ts) and CI fails if this page's data
 * drifts from the registry — so the site can't overstate what the product does.
 *
 * Presentation: three plain buckets by who-can-read, strongest protection first.
 * No raw facet dumps — just the human answer per kind of data.
 */
const HEADINGS = {
  end_to_end: "Only you can read these",
  zero_access: "Locked — we keep only the sealed copy",
  server_readable: "We can read these"
} as const;

const TIER_ORDER = ["end_to_end", "zero_access", "server_readable"] as const;
const groups = TIER_ORDER.map((id) => ({
  tier: TRUST_TIER_BY_ID[id],
  heading: HEADINGS[id],
  domains: TRUST_DOMAINS.filter((d) => d.tier === id)
}));

const registryUrl = `${SITE.github}/blob/main/packages/data-domains/registry.json`;
const leakageUrl = `${SITE.github}/blob/main/docs/pensieve-leakage-analysis.md`;
---

<BaseLayout
  title="What we can and can't see"
  description="A plain map of everything BurnBar keeps for you, sorted by who can read it — only your devices, sealed, or our servers. Generated from the same rules the apps run on."
>
  <section class="pagehead">
    <div class="container pagehead__inner">
      <span class="eyebrow eyebrow--ember">Security &amp; Privacy</span>
      <h1 class="pagehead__h">What we can — and can't — see.</h1>
      <div class="lead-glass-wrap glass-pane">
        <p class="lead">
          A plain map of everything BurnBar keeps for you, sorted by who can read it. It's built
          from the same rules our apps run on, so it can't quietly drift from the truth.
        </p>
      </div>
    </div>
  </section>

  {
    groups.map((g) => (
      <section class="bucket" style={`--tier-c: ${g.tier.colorHex}`}>
        <div class="container bucket__inner">
          <header class="bucket__head">
            <TrustTierBadge tier={g.tier} size="lg" />
            <h2 class="bucket__h">{g.heading}</h2>
            <p class="bucket__line">{g.tier.serverLine}</p>
          </header>

          <ul class="bucket__list">
            {g.domains.map((d) => (
              <li class="dom">
                <div class="dom__top">
                  <span class="dom__icon">
                    <DomainIcon id={d.id} />
                  </span>
                  <h3 class="dom__t">{d.title}</h3>
                </div>
                <p class="dom__b">{d.blurb}</p>
                {d.caveat && <p class="dom__note">{d.caveat}</p>}
                {d.id === "pensieve" && (
                  <a class="dom__more" href="#cloak">
                    How the cloak works <span aria-hidden="true">↓</span>
                  </a>
                )}
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))
  }

  <!-- The one genuinely hard thing, told straight. -->
  <section class="cloak" id="cloak">
    <div class="container container--narrow">
      <header class="sec-head">
        <span class="eyebrow eyebrow--plain">The hard part, in plain words</span>
        <h2>How the Pensieve cloak works.</h2>
        <p class="lead">
          Your notes are sealed on your own devices. To find the right one for your agent, our
          server works with a scrambled version of each note's “shape” — never the words.
        </p>
      </header>

      <div class="cloak__cols">
        <div class="cloak__col cloak__col--does">
          <h3 class="cloak__colh">What it hides</h3>
          <ul class="cloak__list">
            <li>
              <strong>The words.</strong> Your notes stay sealed. The server only ever touches scrambled
              math, not text.
            </li>
            <li>
              <strong>The exact copy.</strong> The same note looks different on every account, so we can't
              match it across people by an exact copy.
            </li>
          </ul>
        </div>

        <div class="cloak__col cloak__col--doesnt">
          <h3 class="cloak__colh">What it can still tell</h3>
          <ul class="cloak__list">
            <li>
              <strong>The shape.</strong> It can see which of <em>your</em> notes are alike — clusters
              and near-duplicates — but never what any of them say.
            </li>
            <li>
              <strong>A rough match.</strong> Across accounts, a near-identical note still scores about
              <span class="mono">0.77</span> similar — so we could guess two people saved something alike,
              never what it was.
            </li>
          </ul>
        </div>
      </div>

      <p class="cloak__close">
        We treat that as a known, written-down trade-off. Your content stays private; only the
        <em>shape</em> can leak — and we say so out loud.
      </p>

      <a class="btn btn--ghost" href={leakageUrl} target="_blank" rel="noopener noreferrer">
        Read the full analysis
      </a>
    </div>
  </section>

  <!-- Verify. -->
  <section class="verify">
    <div class="container container--narrow verify__inner">
      <h2>Don't take our word for it.</h2>
      <p class="lead">
        Every label here is generated from one file you can read, and our build fails the moment
        this page and that file disagree.
      </p>
      <div class="verify__links">
        <a class="btn btn--ghost" href={registryUrl} target="_blank" rel="noopener noreferrer">
          registry.json
        </a>
        <a class="btn btn--ghost" href="/privacy">Privacy model</a>
        <a class="btn btn--ghost" href="/security">Security model</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .pagehead {
    padding-block: var(--s-9) var(--s-7);
  }
  .pagehead__inner {
    max-width: 920px;
    margin: 0 auto;
  }
  .pagehead__h {
    margin-top: var(--s-3);
    max-width: 16ch;
  }
  .pagehead .lead {
    margin-top: var(--s-4);
    max-width: 56ch;
  }

  /* ── buckets ───────────────────────────────────────────────────────────── */
  .bucket {
    padding-block: var(--s-8);
    border-top: 1px solid var(--ink-line);
  }
  .bucket__inner {
    display: grid;
    grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
    gap: var(--s-7);
    align-items: start;
  }
  .bucket__head {
    display: grid;
    gap: var(--s-3);
    position: sticky;
    top: var(--s-6);
    align-content: start;
    justify-items: start;
  }
  .bucket__h {
    font-family: var(--font-display);
    font-size: 1.7rem;
    line-height: 1.1;
    color: var(--text-bright);
    letter-spacing: -0.02em;
    max-width: 16ch;
  }
  .bucket__line {
    color: color-mix(in oklab, var(--tier-c) 65%, var(--text-base));
    font-size: 0.95rem;
    line-height: 1.55;
    max-width: 34ch;
  }

  .bucket__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-4);
  }
  .dom {
    /* inherits --tier-c from the parent .bucket section */
    display: grid;
    gap: var(--s-3);
    align-content: start;
    padding: var(--s-5);
    min-width: 0;
    border-radius: var(--r-4);
    background: rgba(12, 12, 18, 0.5);
    border: 1px solid var(--ink-line);
    border-left: 2px solid color-mix(in oklab, var(--tier-c) 55%, transparent);
    transition:
      border-color var(--dur-base) var(--ease),
      transform var(--dur-base) var(--ease);
  }
  .dom:hover {
    transform: translateY(-2px);
    border-color: color-mix(in oklab, var(--tier-c) 32%, var(--ink-line));
  }
  .dom__top {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }
  .dom__icon {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--r-3);
    color: var(--tier-c);
    background: color-mix(in oklab, var(--tier-c) 12%, rgba(8, 8, 12, 0.6));
    border: 1px solid color-mix(in oklab, var(--tier-c) 30%, var(--ink-line));
  }
  .dom__icon :global(svg) {
    width: 1.45rem;
    height: 1.45rem;
    filter: drop-shadow(0 0 6px color-mix(in oklab, var(--tier-c) 45%, transparent));
  }
  .dom__t {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--text-bright);
    font-variation-settings:
      "opsz" 36,
      "wght" 560;
    letter-spacing: -0.01em;
    line-height: 1.2;
    min-width: 0;
  }
  .dom__b {
    color: var(--text-base);
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .dom__note {
    margin-top: var(--s-1);
    font-size: 0.84rem;
    line-height: 1.55;
    color: var(--text-mute);
    padding: var(--s-3);
    border-radius: var(--r-3);
    background: color-mix(in oklab, var(--tier-c) 7%, transparent);
    border: 1px solid color-mix(in oklab, var(--tier-c) 18%, var(--ink-line));
  }
  .dom__more {
    justify-self: start;
    margin-top: var(--s-1);
    font-size: 0.85rem;
    color: var(--tier-c);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in oklab, var(--tier-c) 40%, transparent);
    padding-bottom: 1px;
  }
  .dom__more:hover {
    border-bottom-color: var(--tier-c);
  }

  /* ── cloak ─────────────────────────────────────────────────────────────── */
  .sec-head {
    display: grid;
    gap: var(--s-3);
    margin-bottom: var(--s-6);
    max-width: 60ch;
  }
  .cloak,
  .verify {
    padding-block: var(--s-9);
    border-top: 1px solid var(--ink-line);
  }
  .cloak {
    background: radial-gradient(80% 60% at 50% 0%, rgba(60, 214, 192, 0.05), transparent 70%);
  }
  .cloak__cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-4);
  }
  .cloak__col {
    padding: var(--s-5);
    border-radius: var(--r-4);
    background: rgba(12, 12, 18, 0.5);
    border: 1px solid var(--ink-line);
  }
  .cloak__col--does {
    border-top: 2px solid color-mix(in oklab, #3cd6c0 60%, transparent);
  }
  .cloak__col--doesnt {
    border-top: 2px solid color-mix(in oklab, #8b94a8 60%, transparent);
  }
  .cloak__colh {
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--text-bright);
    margin-bottom: var(--s-4);
    font-variation-settings:
      "opsz" 36,
      "wght" 560;
  }
  .cloak__list {
    display: grid;
    gap: var(--s-4);
  }
  .cloak__list li {
    color: var(--text-base);
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .cloak__list strong {
    color: var(--text-bright);
    font-variation-settings: "wght" 560;
  }
  .cloak__close {
    margin-block: var(--s-5);
    color: var(--text-base);
    font-size: 1rem;
    line-height: 1.65;
    max-width: 58ch;
  }

  /* ── verify ────────────────────────────────────────────────────────────── */
  .verify {
    text-align: center;
    background: radial-gradient(60% 80% at 50% 50%, rgba(255, 106, 26, 0.05), transparent 70%);
  }
  .verify__inner {
    display: grid;
    gap: var(--s-5);
    justify-items: center;
  }
  .verify__inner .lead {
    max-width: 52ch;
  }
  .verify__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    justify-content: center;
  }

  /* ── responsive ────────────────────────────────────────────────────────── */
  @media (max-width: 920px) {
    .bucket__inner {
      grid-template-columns: 1fr;
      gap: var(--s-5);
    }
    .bucket__head {
      position: static;
    }
    .cloak__cols {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 600px) {
    .bucket__list {
      grid-template-columns: 1fr;
    }
  }
</style>
