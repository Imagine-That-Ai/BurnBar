---
import BaseLayout from "@layouts/BaseLayout.astro";
import LockedModelRelay from "@components/LockedModelRelay.astro";
import RuleVignette from "@components/RuleVignette.astro";
import ModeComparison from "@components/ModeComparison.astro";
import TodaysRundown from "@components/TodaysRundown.astro";
import LifecycleStateMachine from "@components/LifecycleStateMachine.astro";
import PlatformShowcase from "@components/platform/PlatformShowcase.astro";
import { SITE } from "@data/site";

const faqEntries = [
  {
    q: "Will failover ever change my model?",
    a: "No. Failover stays inside the model identity you asked for. If you sent `gpt-5.4`, the router must prove the destination route serves canonical model `gpt-5.4`. If no eligible account exists, BurnBar returns a structured 503 — never a silent substitute."
  },
  {
    q: "What is Provider-Family Failover?",
    a: "The default mode. BurnBar extends capacity inside the provider family you selected. A Codex route stays with Codex accounts, a Claude route stays with Claude accounts, and a Z.ai route stays with Z.ai accounts. It does not treat unrelated providers as one generic coding quota pool."
  },
  {
    q: "What is Exact Model Failover?",
    a: "The opt-in mode for wider failover. BurnBar may try another provider or account after quota, rate-limit, or availability failure — but only if that destination proves the same canonical model ID as the request. `gpt-5.4` can move to another route that truly serves `gpt-5.4`; it cannot become `gpt-5.4-mini`, `gpt-5.4-pro`, `gpt-5-family`, or a generic `openai:standard` route."
  },
  {
    q: "What counts as proof of the same model?",
    a: "Explicit `canonicalModelID` wins. Otherwise BurnBar uses the real catalog model ID for direct models. Wrapper entries only count when they have one unambiguous exact alias, such as `factory-gpt-5.4-family` resolving to `gpt-5.4`. Broad capability labels, benchmark recommendations, and matcher-only similar models do not count."
  },
  {
    q: "Is the daily model board a failover mode?",
    a: "No. The daily model board is advisory research: it explains model-landscape recommendations, source freshness, and why certain models look strong for a task. It does not grant permission to silently swap the model on a failed request. Provider-Family Failover and Exact Model Failover are the runtime modes."
  },
  {
    q: "What benchmark sources does BurnBar use?",
    a: "Artificial Analysis (intelligence + coding indices · pricing · TPS), Terminal-Bench via Hugging Face (verified shell-loop agents), and Design Arena (pairwise Elo). Manual cached fixtures cover gaps. Every signal carries a freshness state — fresh / stale / unavailable / error / manual — surfaced in `/router/daily`. Those signals are advisory; they are never proof of exact model identity."
  },
  {
    q: "Can I pin a model in either mode?",
    a: "Yes. In Provider-Family Failover, the pinned account stays active while healthy and the runner-up is selected inside that provider family. In Exact Model Failover, the pin still wins while healthy; only recoverable failures open the door to another provider/account, and only after the canonical model ID matches."
  },
  {
    q: "Are routing logs safe?",
    a: "Yes. The local `ProviderRoutingDecisionEvent` stream records the chosen account ID, the skipped account IDs, and the reason each was skipped — never API keys, OAuth bearers, request bodies, or response bodies. Logs stay in the local SQLite store."
  }
];
---

<BaseLayout
  title="The router — same model, every time"
  description="BurnBar's local router preserves the exact model you asked for. Provider-Family Failover stays inside the selected provider family. Exact Model Failover may cross provider/account only after canonical model identity is proven."
>
  <section class="pagehead" aria-labelledby="hero-h">
    <div class="container container--wide pagehead__inner">
      <span class="eyebrow eyebrow--ember">The router · exact model failover · animated</span>
      <h1 id="hero-h" class="pagehead__h">
        Same model.
        <span class="pagehead__hb">Different account.</span>
        <span class="pagehead__hsm">Every time.</span>
      </h1>
      <div class="lead-glass-wrap glass-pane">
        <p class="pagehead__lead">
          BurnBar's local router stretches one model across every account in your library that
          serves it. Your <code class="mono">gpt-5.5</code> stays
          <code class="mono">gpt-5.5</code>. Your
          <code class="mono">claude-opus-4-7</code> stays
          <code class="mono">claude-opus-4-7</code>. Default mode stays inside the selected provider
          family. Exact Model Failover can look wider, but only after the next route proves the same
          canonical model ID.
        </p>
      </div>

      <ul class="pagehead__chips mono" aria-label="Quick highlights">
        <li><span class="dot dot--ember"></span> 127.0.0.1:8317 · local-only</li>
        <li><span class="dot dot--ember"></span> two router modes · one daemon</li>
        <li><span class="dot dot--mercury"></span> canonical model id · fail closed</li>
      </ul>

      <div class="pagehead__visual">
        <LockedModelRelay variant="big" modelID="gpt-5.5" modelTag="model id · invariant" />
      </div>

      <div class="pagehead__ctas">
        <a class="btn btn--ember" href="/download"
          >Download for macOS <span class="btn-arrow" aria-hidden="true">→</span></a
        >
        <a
          class="btn btn--ghost"
          href={`${SITE.github}/blob/main/docs/ROUTED_CLIENT_GATEWAY.md`}
          target="_blank"
          rel="noopener noreferrer">Read the gateway doc</a
        >
        <a class="btn btn--ghost" href="/router/daily">See today's rundown</a>
      </div>
    </div>
  </section>

  {/* ──────────────── 2 · NON-NEGOTIABLE RULE ──────────────── */}
  <section class="rules" aria-labelledby="rules-h">
    <div class="container container--wide">
      <header class="rules__head">
        <span class="eyebrow eyebrow--ember">The non-negotiable rule</span>
        <h2 id="rules-h" class="rules__h">Your model in. Your model out. Every path.</h2>
        <p class="rules__lead">
          Three things can happen to a request in flight. Watch what each one does — or refuses to
          do — to the model identity you asked for.
        </p>
      </header>

      <div class="rules__grid">
        <RuleVignette
          idx={1}
          variant="swap-account"
          model="gpt-5.5"
          title="Provider-family mode: primary key throttled → backup account, same provider family."
          eyebrow="01 · gpt-5.5 · 429"
          client={{ name: "Forge", logo: "/brand/providers/forge.png" }}
          primary={{
            name: "OpenAI · personal",
            logo: "/brand/providers/openai.png",
            state: "primary"
          }}
          fallback={{
            name: "Codex · plus",
            logo: "/brand/providers/codex.png",
            state: "carries gpt-5.5"
          }}
          failure="429"
          swapDetail="account only · gpt-5.5 → gpt-5.5"
        />

        <RuleVignette
          idx={2}
          variant="swap-auth"
          model="gpt-5.4"
          title="Exact mode: Factory Standard exhausted → OpenAI route, same canonical model."
          eyebrow="02 · gpt-5.4 · exact"
          client={{ name: "Factory Droid", logo: "/brand/providers/factory.png" }}
          primary={{
            name: "Factory Standard",
            logo: "/brand/providers/factory.png",
            state: "standard lane exhausted",
            auth: "Factory key"
          }}
          fallback={{
            name: "OpenAI",
            logo: "/brand/providers/openai.png",
            state: "healthy",
            auth: "x-api-key"
          }}
          failure="quota"
          swapDetail="canonical gpt-5.4 → canonical gpt-5.4"
        />

        <RuleVignette
          idx={3}
          variant="no-fallback"
          model="glm-4.6"
          title="No other account carries it → 503, never a swap."
          eyebrow="03 · glm-4.6 · 503"
          client={{ name: "Cursor", logo: "/brand/providers/cursor.png" }}
          primary={{ name: "Z.ai", logo: "/brand/providers/zai.png", state: "exhausted" }}
          fallback={null}
          failure="exhausted · last carrier"
          swapDetail="nothing — gate closes, IDE sees a clean 503"
        />
      </div>

      <p class="rules__cap mono">
        Implementation · <code>ProviderRoutingPolicy.decide</code> ·
        <code>BurnBarProviderRouter.scoreAndRankRoutes</code> · fail-closed gateway responses
      </p>
    </div>
  </section>

  {/* ──────────────── 3 · TWO MODES ──────────────── */}
  <div class="container container--wide">
    <ModeComparison />
  </div>

  {/* ──────────────── 3.5 · EXACT MODEL TEST ──────────────── */}
  <section class="exacttest" id="exact-model-test" aria-labelledby="exacttest-h">
    <div class="container container--wide">
      <header class="exacttest__head">
        <span class="eyebrow eyebrow--mercury">Exact Model Failover</span>
        <h2 id="exacttest-h" class="exacttest__h">
          Cross-provider failover has to pass one simple test.
        </h2>
        <p class="exacttest__lead">
          BurnBar does not ask "is this model similar?" or "is this provider good enough?" It asks a
          narrower question: can the destination route prove the same canonical model ID as the
          request? If yes, it may recover the request. If no, it stops.
        </p>
      </header>

      <ol class="exacttest__grid" role="list">
        <li class="exactstep glass-pane">
          <span class="exactstep__num mono">01</span>
          <h3>Start with the requested model.</h3>
          <p>
            The incoming request creates a required identity. A direct request for
            <code>gpt-5.4</code> requires canonical <code>gpt-5.4</code>. The router carries that
            value through ranking, retry, and audit.
          </p>
        </li>
        <li class="exactstep glass-pane">
          <span class="exactstep__num mono">02</span>
          <h3>Accept only exact catalog proof.</h3>
          <p>
            Explicit <code>canonicalModelID</code> wins. Otherwise direct catalog IDs count. Wrapper families
            count only when they have one unambiguous exact alias, like
            <code>factory-gpt-5.4-family</code> resolving to <code>gpt-5.4</code>.
          </p>
        </li>
        <li class="exactstep glass-pane">
          <span class="exactstep__num mono">03</span>
          <h3>Reject anything that merely looks close.</h3>
          <p>
            <code>gpt-5.4-mini</code>, <code>gpt-5.4-pro</code>, <code>gpt-5-family</code>,
            <code>openai:standard</code>, benchmark picks, and "similar" matcher hits are not exact
            proof. They stay advisory and never open the failover gate.
          </p>
        </li>
        <li class="exactstep exactstep--result glass-pane">
          <span class="exactstep__num mono">503</span>
          <h3>No proof means no winner.</h3>
          <p>
            If the primary route is exhausted and no exact canonical match remains, BurnBar returns
            a structured unavailable response. That is deliberate: a clean failure is safer than a
            quiet model change your agent did not ask for.
          </p>
        </li>
      </ol>
    </div>
  </section>

  {/* ──────────────── 4 · TODAY'S RUNDOWN ──────────────── */}
  <div class="container container--wide" id="daily-rundown">
    <TodaysRundown />
  </div>

  {/* ──────────────── 4.5 · SMART DISPLAY MOCKUPS (live re-renders) ──────────────── */}
  <PlatformShowcase variant="compact" />

  {/* ──────────────── 5 · WHAT BURNBAR WILL NOT DO ──────────────── */}
  <section class="wontdo" aria-labelledby="wontdo-h">
    <div class="container container--wide">
      <header class="wontdo__head">
        <span class="eyebrow eyebrow--burn">What BurnBar will not do</span>
        <h2 id="wontdo-h" class="wontdo__h">Four bright lines we don't cross.</h2>
        <p class="wontdo__lead">
          A router that's allowed to do anything is a router you can't predict. These are baked into
          the policy — not promises, code.
        </p>
      </header>

      <ul class="wontdo__grid" role="list">
        <li class="wontno wontno--headline">
          <span class="wontno__x" aria-hidden="true">✕</span>
          <div>
            <h3 class="wontno__h">Will not swap your model on failover.</h3>
            <p>
              Exact Model Failover drops every candidate route whose canonical model ID does not
              match the requested one. If no candidate survives, the gateway returns a structured
              503 — your IDE sees a clean error, never a silent substitute.
            </p>
          </div>
        </li>
        <li class="wontno">
          <span class="wontno__x" aria-hidden="true">✕</span>
          <div>
            <h3 class="wontno__h">Will not collapse accounts into a generic quota pool.</h3>
            <p>
              Each account keeps its own bucket, its own cool-down clock, its own decision history.
              You added them separately because they cost and throttle differently — the router
              treats them that way.
            </p>
          </div>
        </li>
        <li class="wontno">
          <span class="wontno__x" aria-hidden="true">✕</span>
          <div>
            <h3 class="wontno__h">Will not log secrets.</h3>
            <p>
              The local decision stream records the chosen account ID, the skipped ones, and the
              reason each was skipped. It never records the API key, the OAuth bearer, the request
              body, or the response body. Keys live in the macOS Keychain, device-local.
            </p>
          </div>
        </li>
        <li class="wontno">
          <span class="wontno__x" aria-hidden="true">✕</span>
          <div>
            <h3 class="wontno__h">Will not treat benchmarks as absolute truth.</h3>
            <p>
              Benchmark snapshots feed the daily model board and inform deterministic
              recommendations. They never prove exact model identity. They never override a pin.
              They never beat live quota state. A model that benchmarks higher but is rate-limited
              right now still loses.
            </p>
          </div>
        </li>
      </ul>
    </div>
  </section>

  {/* ──────────────── 6 · LIFECYCLE ──────────────── */}
  <div class="container container--wide">
    <LifecycleStateMachine />
  </div>

  {/* ──────────────── 7 · FAQ ──────────────── */}
  <section class="qa" aria-labelledby="qa-h">
    <div class="container container--wide">
      <header class="qa__head">
        <span class="eyebrow eyebrow--ember">Quick answers</span>
        <h2 id="qa-h" class="qa__h">The questions we get on every demo.</h2>
      </header>

      <dl class="qa__list">
        {
          faqEntries.map((entry) => (
            <div class="qa__item glass-pane">
              <dt>{entry.q}</dt>
              <dd set:html={entry.a.replace(/`([^`]+)`/g, "<code class='mono'>$1</code>")} />
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="endcta endcta--inline">
    <div class="container container--narrow endcta__inner">
      <h2>Pick the failover boundary once. Let the daemon enforce it.</h2>
      <div class="lead-glass-wrap glass-pane">
        <p class="lead">
          Use Provider-Family Failover for conservative same-provider recovery, or Exact Model
          Failover when you want BurnBar to recover across providers without ever changing the
          canonical model.
        </p>
      </div>
      <div class="endcta__ctas">
        <a class="btn btn--ember" href="/download"
          >Download for macOS <span class="btn-arrow" aria-hidden="true">→</span></a
        >
        <a
          class="btn btn--ghost"
          href={`${SITE.github}/blob/main/docs/ROUTED_CLIENT_GATEWAY.md`}
          target="_blank"
          rel="noopener noreferrer">Read the gateway doc</a
        >
        <a class="btn btn--ghost" href="/router/daily">Browse the daily rundown</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import "../scripts/animateOnView";
</script>

<style>
  /* ────────── 1. HERO ────────── */
  .pagehead {
    padding-block: var(--s-9) var(--s-7);
  }
  .pagehead__inner {
    display: grid;
    gap: var(--s-5);
    justify-items: center;
    text-align: center;
    padding: var(--s-7) var(--s-6);
    border-radius: var(--r-xl);
  }
  .pagehead__h {
    margin-top: var(--s-2);
    max-width: 22ch;
    text-wrap: balance;
    font-size: clamp(2.4rem, 1.6rem + 3vw, 4.4rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
    color: var(--text-bright);
    font-variation-settings:
      "opsz" 144,
      "wght" 460;
  }
  .pagehead__hb {
    display: block;
    color: var(--ember-bright);
    font-style: italic;
    font-variation-settings:
      "opsz" 144,
      "wght" 360,
      "ital" 1;
  }
  .pagehead__hsm {
    display: block;
    color: var(--text-mute);
    font-variation-settings:
      "opsz" 80,
      "wght" 380;
    font-size: 0.52em;
    letter-spacing: 0.02em;
    margin-top: 0.4em;
  }
  .pagehead__lead {
    color: var(--text-base);
    max-width: 60ch;
    margin: 0 auto;
    font-size: var(--t-lead);
    line-height: 1.5;
  }
  .pagehead__lead code {
    color: var(--ember-bright);
    background: var(--ink-surface);
    padding: 1px 6px;
    border-radius: var(--r-2);
    border: 1px solid var(--ink-line);
  }
  .pagehead__chips {
    list-style: none;
    display: inline-flex;
    flex-wrap: wrap;
    gap: var(--s-3) var(--s-5);
    padding: var(--s-3) var(--s-4);
    border: 1px dashed var(--ink-line);
    border-radius: var(--r-pill);
    font-size: var(--t-caption);
    color: var(--text-mute);
    letter-spacing: 0.03em;
    background: color-mix(in oklab, var(--ink-surface) 60%, transparent);
    margin: 0;
  }
  .pagehead__chips li {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    display: inline-block;
  }
  .dot--ember {
    background: var(--ember-core);
    box-shadow: 0 0 8px var(--ember-glow);
  }
  .dot--mercury {
    background: var(--mercury-bright);
    box-shadow: 0 0 8px color-mix(in oklab, var(--mercury-bright) 55%, transparent);
  }
  .pagehead__visual {
    width: 100%;
    max-width: 980px;
    margin: var(--s-3) auto 0;
  }
  .pagehead__ctas {
    display: flex;
    gap: var(--s-3);
    flex-wrap: wrap;
    justify-content: center;
    margin-top: var(--s-3);
  }

  /* ────────── 2. RULES ────────── */
  .rules {
    padding-block: var(--s-9);
    border-top: 1px solid var(--ink-line);
    background: radial-gradient(70% 50% at 50% 0%, rgba(255, 106, 26, 0.05), transparent 65%);
  }
  .rules__head {
    max-width: 64ch;
    margin: 0 auto var(--s-6);
    text-align: center;
    display: grid;
    gap: var(--s-3);
  }
  .rules__h {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 1.2rem + 1.5vw, 2.4rem);
    color: var(--text-bright);
    font-variation-settings:
      "opsz" 80,
      "wght" 500;
    letter-spacing: -0.022em;
    text-wrap: balance;
  }
  .rules__lead {
    color: var(--text-base);
    max-width: 56ch;
    margin: 0 auto;
    line-height: 1.55;
  }
  .rules__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-4);
  }
  @media (max-width: 1080px) {
    .rules__grid {
      grid-template-columns: 1fr;
      max-width: 560px;
      margin-inline: auto;
    }
  }
  .rules__cap {
    margin-top: var(--s-5);
    color: var(--text-dim);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-align: center;
  }
  .rules__cap code {
    color: var(--text-mute);
    background: var(--ink-base);
    padding: 1px 6px;
    border-radius: var(--r-2);
    border: 1px solid var(--ink-line);
  }

  /* ────────── 3.5. EXACT MODEL TEST ────────── */
  .exacttest {
    padding-block: var(--s-9);
    border-top: 1px solid var(--ink-line);
    background: radial-gradient(60% 55% at 84% 0%, rgba(214, 211, 223, 0.055), transparent 70%);
  }
  .exacttest__head {
    max-width: 68ch;
    margin: 0 auto var(--s-6);
    text-align: center;
    display: grid;
    gap: var(--s-3);
  }
  .exacttest__h {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 1.2rem + 1.5vw, 2.4rem);
    color: var(--text-bright);
    font-variation-settings:
      "opsz" 80,
      "wght" 500;
    letter-spacing: -0.022em;
    text-wrap: balance;
  }
  .exacttest__lead {
    color: var(--text-base);
    max-width: 62ch;
    margin: 0 auto;
    line-height: 1.55;
  }
  .exacttest__grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-4);
    margin: 0;
    padding: 0;
  }
  .exactstep {
    display: grid;
    gap: var(--s-3);
    padding: var(--s-5);
    border: 1px solid color-mix(in oklab, var(--mercury-bright) 22%, var(--ink-line));
    border-radius: var(--r-4);
    background: linear-gradient(180deg, var(--ink-surface) 0%, var(--ink-base) 100%);
  }
  .exactstep--result {
    border-color: color-mix(in oklab, var(--status-burn) 34%, var(--ink-line));
  }
  .exactstep__num {
    width: max-content;
    padding: 2px 8px;
    border-radius: var(--r-pill);
    color: var(--mercury-bright);
    background: color-mix(in oklab, var(--mercury-bright) 10%, var(--ink-base));
    border: 1px solid color-mix(in oklab, var(--mercury-bright) 30%, var(--ink-line));
    font-size: 0.68rem;
    letter-spacing: 0.12em;
  }
  .exactstep--result .exactstep__num {
    color: var(--status-burn);
    background: color-mix(in oklab, var(--status-burn) 10%, var(--ink-base));
    border-color: color-mix(in oklab, var(--status-burn) 34%, var(--ink-line));
  }
  .exactstep h3 {
    font-family: var(--font-display);
    color: var(--text-bright);
    font-size: 1.08rem;
    line-height: 1.18;
    letter-spacing: -0.014em;
    text-wrap: balance;
  }
  .exactstep p {
    color: var(--text-base);
    font-size: 0.92rem;
    line-height: 1.55;
  }
  .exactstep code {
    color: var(--text-bright);
    background: var(--ink-surface);
    border: 1px solid var(--ink-line);
    border-radius: var(--r-2);
    padding: 1px 6px;
    font-family: var(--font-mono);
    font-size: 0.86em;
  }
  @media (max-width: 1080px) {
    .exacttest__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 680px) {
    .exacttest__grid {
      grid-template-columns: 1fr;
    }
  }

  /* ────────── 5. WONT DO ────────── */
  .wontdo {
    padding-block: var(--s-9);
    border-top: 1px solid var(--ink-line);
    background: radial-gradient(60% 50% at 0% 0%, rgba(229, 72, 60, 0.04), transparent 70%);
  }
  .wontdo__head {
    max-width: 64ch;
    margin: 0 auto var(--s-6);
    text-align: center;
    display: grid;
    gap: var(--s-3);
  }
  .wontdo__head .eyebrow {
    color: var(--status-burn);
  }
  .wontdo__h {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 1.2rem + 1.5vw, 2.4rem);
    color: var(--text-bright);
    font-variation-settings:
      "opsz" 80,
      "wght" 500;
    letter-spacing: -0.022em;
