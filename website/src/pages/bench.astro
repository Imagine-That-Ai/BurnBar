---
import BaseLayout from "@layouts/BaseLayout.astro";
import "@styles/bench.css";
import {
  BENCH,
  RANKED_STACKS,
  FAMILIES,
  MODEL_COLOR,
  HARNESS_COLOR,
  MODEL_LOGO,
  HARNESS_LOGO,
  MODEL_CLASS,
  HARNESS_CLASS,
  colorFor,
  classFor,
  monogramFor,
  modelDisplay,
  harnessDisplay,
  paretoDomain,
  frontierPoints,
  benchKpis,
  modelLens,
  familyHeat,
  heatBucket,
  modelDisplayShort,
  fmtPct,
  fmtCost,
  fmtWall,
  fmtTokens,
  fmtInt,
  fmtGeneratedAt
} from "@data/bench";

const mc = (id: string): string => colorFor(MODEL_COLOR, id);
const hc = (id: string): string => colorFor(HARNESS_COLOR, id);
const mcls = (id: string): string => classFor(MODEL_CLASS, id);
const hcls = (id: string): string => classFor(HARNESS_CLASS, id);
const pctAttr = (v: number): string => `${(v * 100).toFixed(2)}%`;

const generatedAt = fmtGeneratedAt(BENCH.generated_at_utc);
const shaShort = BENCH.source.runs_sha256.slice(0, 12);
const kpis = benchKpis();
const lens = modelLens();
const heat = familyHeat();
// Families with zero measured cells across every stack (experiential, pre-Arena).
const emptyFams = heat.families.filter((_, fi) => heat.rows.every((r) => r.cells[fi]?.rate == null));

/* Maxima for bar scaling live in the client module (tabs re-render bars). */

/* ---------- Pareto scatter geometry (viewBox 760×440, log-cost domain) ---------- */
const PLOT = { w: 760, h: 440, ml: 56, mr: 24, mt: 24, mb: 48 };
const domain = paretoDomain(RANKED_STACKS);
const xPos = (cost: number): number =>
  PLOT.ml + domain.xFrac(cost) * (PLOT.w - PLOT.ml - PLOT.mr);
const yPos = (rate: number): number =>
  PLOT.mt +
  (1 - (rate - domain.yMin) / (domain.yMax - domain.yMin)) * (PLOT.h - PLOT.mt - PLOT.mb);
const frontierPts = frontierPoints();
const frontierLine = frontierPts
  .map((p) => `${xPos(p.cost_usd_median).toFixed(1)},${yPos(p.solution_rate).toFixed(1)}`)
  .join(" ");
const frontierKeys = new Set(frontierPts.map((p) => `${p.harness}|${p.model}`));

/* Attractive quadrant: cheaper than the median priced stack, better than the
   median rate — the region a buyer should start from. */
const priced = RANKED_STACKS.map((s) => s.cost_usd_median).filter((c): c is number => c != null);
const sortedCosts = [...priced].sort((a, b) => a - b);
const medianCost = sortedCosts[Math.floor(sortedCosts.length / 2)] ?? 0;
const sortedRates = [...RANKED_STACKS.map((s) => s.solution_rate)].sort((a, b) => a - b);
const medianRate = sortedRates[Math.floor(sortedRates.length / 2)] ?? 0.5;

const inferredCount = RANKED_STACKS.filter((s) => s.evidence === "inferred").length;
const lowCount = RANKED_STACKS.filter((s) => s.confidence === "low").length;
const derivedCosts = RANKED_STACKS.filter((s) => s.cost_source === "derived").length;

/* Model-lens domain: zoom to the observed band (floor to 5%, padded) so
   harness spread is visible; disclosed on the axis. */
const lensRates = lens.flatMap((L) => [L.min, L.max]);
const lensLo = Math.max(0, Math.floor((Math.min(...lensRates) - 0.03) * 20) / 20);
const lensHi = Math.min(1, Math.ceil((Math.max(...lensRates) + 0.01) * 20) / 20);
const lensX = (rate: number): number => ((rate - lensLo) / (lensHi - lensLo)) * 100;
const lensTicks: number[] = [];
for (let t = lensLo; t <= lensHi + 1e-9; t += 0.05) lensTicks.push(Math.round(t * 100) / 100);
---

<BaseLayout
  title="BurnBench — which agent harness × model actually ships"
  description="Public BurnBench command center: agent harnesses × models on real shipping tasks — solution-quality rates with Wilson confidence intervals, cost/speed tradeoffs, per-family heatmaps, and an AI analyst grounded in the export."
>
  {/* ──────────────── 1 · HERO ──────────────── */}
  <section class="bb-hero" aria-labelledby="bb-hero-h">
    <div class="container container--wide bb-hero__inner">
      <nav class="bb-bread mono" aria-label="Breadcrumbs">
        <span>BurnBench</span>
        <span aria-hidden="true">·</span>
        <span>evidence export · schema v{BENCH.schema_version}</span>
      </nav>
      <span class="eyebrow eyebrow--ember">BurnBench · public benchmark</span>
      <h1 id="bb-hero-h" class="bb-hero__h">
        The command center for
        <span class="bb-hero__hb">harness × model evidence.</span>
      </h1>
      <p class="bb-hero__lead">
        {BENCH.harnesses.length} agent harnesses × {BENCH.models.length} models on real shipping
        work — refactors, bugfixes, agentic ops, visual builds. Every rate is measured on scored
        runs and ships with a Wilson 95% CI and the cell count behind it. No vibes, no
        self-reported scores.
      </p>

      {/* freshness strip */}
      <ul class="bb-chips mono" aria-label="Benchmark freshness">
        <li><span class="bb-dot bb-dot--exact"></span> generated {generatedAt}</li>
        <li><span class="bb-dot"></span> {fmtInt(kpis.cellsMeasured)} cells measured</li>
        <li><span class="bb-dot bb-dot--mercury"></span> runs sha {shaShort}…</li>
        <li><span class="bb-dot"></span> {kpis.cellsExcluded} cells excluded by policy</li>
      </ul>

      <div class="bb-hero__ctas">
        <a class="btn btn--ember" href="#leaderboard"
          >Open the leaderboard <span class="btn-arrow" aria-hidden="true">↓</span></a
        >
        <a class="btn btn--ghost" href="#ask">Ask the data</a>
        <a class="btn btn--ghost" href="/bench/arena">The Arena</a>
        <a class="btn btn--ghost" href="/bench/report">Methodology &amp; full data</a>
      </div>
    </div>
  </section>

  {/* ──────────────── 2 · KPI STRIP ──────────────── */}
  <section class="bb-kpis" aria-label="Key numbers">
    <div class="container container--wide bb-kpis__grid">
      <div class="bb-kpi">
        <span class="bb-kpi__k">stacks measured</span>
        <span class="bb-kpi__v">{kpis.stacks}</span>
        <span class="bb-kpi__sub">{BENCH.harnesses.length} harnesses × {BENCH.models.length} models</span>
      </div>
      <div class="bb-kpi">
        <span class="bb-kpi__k">cells measured</span>
        <span class="bb-kpi__v">{fmtInt(kpis.cellsMeasured)}</span>
        <span class="bb-kpi__sub">{kpis.cellsExcluded} excluded by policy</span>
      </div>
      <div class="bb-kpi bb-kpi--ember">
        <span class="bb-kpi__k">top solution rate</span>
        <span class="bb-kpi__v">{kpis.topStack ? fmtPct(kpis.topStack.solution_rate) : "—"}</span>
        <span class="bb-kpi__sub">
          {kpis.topStack
            ? `${harnessDisplay(kpis.topStack.harness)} × ${modelDisplay(kpis.topStack.model)}`
            : "no eligible stack"}
        </span>
      </div>
      <div class="bb-kpi">
        <span class="bb-kpi__k">frontier entry</span>
        <span class="bb-kpi__v">
          {kpis.cheapestFrontier ? fmtCost(kpis.cheapestFrontier.cost_usd_median) : "—"}
        </span>
        <span class="bb-kpi__sub">
          {kpis.cheapestFrontier
            ? `${harnessDisplay(kpis.cheapestFrontier.harness)} × ${modelDisplay(kpis.cheapestFrontier.model)} · ${fmtPct(kpis.cheapestFrontier.solution_rate)}`
            : "no priced stacks"}
        </span>
      </div>
      <div class="bb-kpi">
        <span class="bb-kpi__k">arena votes</span>
        <span class="bb-kpi__v">{fmtInt(kpis.arenaVotes)}</span>
        <span class="bb-kpi__sub">blind pairwise, experiential tasks</span>
      </div>
    </div>
  </section>

  {/* ──────────────── 3 · LEADERBOARD (metric tabs) ──────────────── */}
  <section class="bb-section bb-section--ember" id="leaderboard" aria-labelledby="lb-h">
    <div class="container lb-shell">
      <header class="bb-sec-head">
        <span class="eyebrow eyebrow--ember">Leaderboard · every published stack</span>
        <h2 id="lb-h" class="bb-sec-h">One leaderboard, five lenses.</h2>
        <p class="bb-sec-lead">
          Switch the metric — the ranking re-sorts live. <strong>Solution</strong> bars carry the
          Wilson 95% whiskers and the strict-rate tick; <strong>cost</strong> bars are segmented
          into input vs output token spend (token-derived list prices, scaled to the measured
          total). Stacks that tie on the visible metric share one rank — hover or tap the
          <span class="mono">×n</span> chip to meet every contender. Dashed rows are
          shrinkage-pooled <em>inferred</em> estimates.
        </p>
      </header>

      <div class="bb-tabs" role="tablist" aria-label="Leaderboard metric" data-bb-tabs>
        <button class="bb-tab is-active" role="tab" aria-selected="true" data-metric="sol">Solution</button>
        <button class="bb-tab" role="tab" aria-selected="false" data-metric="str">Strict</button>
        <button class="bb-tab" role="tab" aria-selected="false" data-metric="cost">Cost</button>
        <button class="bb-tab" role="tab" aria-selected="false" data-metric="wall">Speed</button>
        <button class="bb-tab" role="tab" aria-selected="false" data-metric="tok">Tokens</button>
      </div>

      <ol class="bb-lb" role="list" data-bb-lb>
        {
          RANKED_STACKS.map((s, i) => {
            const hLogo = HARNESS_LOGO[s.harness] ?? null;
            const mLogo = MODEL_LOGO[s.model] ?? null;
            const first = i === 0;
            return (
              <li class="lb-group">
                <div
                  class={`lb-row h--${hcls(s.harness)} m--${mcls(s.model)}${first ? " lb-row--first" : ""}${s.evidence === "inferred" ? " lb-row--inferred" : ""}`}
                  data-h={s.harness}
                  data-m={s.model}
                >
                  <span class="lb-rank">{String(i + 1).padStart(2, "0")}</span>

                  <span class="lb-logos">
                    {hLogo ? (
                      <img class="lb-logo lb-logo--h" src={hLogo} alt="" width="24" height="24" loading="lazy" decoding="async" />
                    ) : (
                      <span class="lb-mono lb-logo--h">{monogramFor(s.harness, harnessDisplay(s.harness))}</span>
                    )}
                    {mLogo ? (
                      <img class="lb-logo lb-logo--m" src={mLogo} alt="" width="24" height="24" loading="lazy" decoding="async" />
                    ) : (
                      <span class="lb-mono lb-logo--m">{monogramFor(s.model, modelDisplay(s.model))}</span>
                    )}
                  </span>
                  <span class="lb-names">
                    <strong>
                      {harnessDisplay(s.harness)} × {modelDisplayShort(s.model)}
                    </strong>
                    <span class="lb-sub" data-role="subline">
                      strict {fmtPct(s.strict_rate)} · n {s.n} · {fmtCost(s.cost_usd_median)}/task
                      {s.cost_standard_usd_median != null && (
                        <span class="lb-std" title={`Non-contributor tier (meta/muse-spark-1.2 on OpenRouter): ${fmtCost(s.cost_standard_usd_median)}/task — the contributor tier is free under data-sharing`}>
                          · std {fmtCost(s.cost_standard_usd_median)}
                        </span>
                      )}
                    </span>
                  </span>

                  <svg
                    class="lb-bar"
                    viewBox="0 0 100 26"
                    preserveAspectRatio="none"
                    role="img"
                    aria-label={`${harnessDisplay(s.harness)} with ${modelDisplay(s.model)}: solution rate ${fmtPct(s.solution_rate)}, strict ${fmtPct(s.strict_rate)}, CI ${fmtPct(s.ci95[0])} to ${fmtPct(s.ci95[1])}, n ${s.n}`}
                  >
                    <rect class="lb-bar__track" x="0" y="9" width="100" height="8" rx="4" />
                    <rect class="lb-bar__fill" x="0" y="9" width={pctAttr(s.solution_rate)} height="8" rx="4" />
                    <line class="lb-bar__ci" x1={pctAttr(s.ci95[0])} x2={pctAttr(s.ci95[1])} y1="13" y2="13" />
                    <line class="lb-bar__ci" x1={pctAttr(s.ci95[0])} x2={pctAttr(s.ci95[0])} y1="9" y2="17" />
                    <line class="lb-bar__ci" x1={pctAttr(s.ci95[1])} x2={pctAttr(s.ci95[1])} y1="9" y2="17" />
                    <line class="lb-bar__strict" x1={pctAttr(s.strict_rate)} x2={pctAttr(s.strict_rate)} y1="5" y2="21" />
                  </svg>

                  <span class="lb-nums">
                    <span class="lb-head" data-role="headline">{fmtPct(s.solution_rate)}</span>
                    <span class="lb-tags">
                      {s.evidence === "inferred" && <span class="tag tag--estimated">inferred</span>}
                      {s.cost_source === "derived" && <span class="tag tag--derived">cost est.</span>}
                      {s.confidence === "low" && <span class="tag tag--unavailable">low conf</span>}
                    </span>
                  </span>
                </div>
              </li>
            );
          })
        }
      </ol>

      <p class="lb-legend" aria-hidden="true">
        <span class="swatch m--gpt"><i></i> bar = metric value (model color)</span>
        <span class="swatch swatch--tick"><i></i> tick = strict rate</span>
        <span class="swatch swatch--line"><i></i> whiskers = Wilson 95% CI</span>
        <span class="swatch swatch--seg-in"><i></i> input tokens</span>
        <span class="swatch swatch--seg-out"><i></i> output tokens</span>
      </p>
      <p class="bb-caption">
        Costs are per-task medians at configured list prices; {derivedCosts} of {RANKED_STACKS.length}
        stacks include token-derived estimates (<span class="mono">cost_source: derived</span>).
        Cached input tokens are billed at the full input rate — an upper bound for cache-heavy
        stacks. Speed is median wall-clock per task; tokens are the median task total.
      </p>
    </div>
  </section>

  {/* ──────────────── 4 · MATCH TUNER ──────────────── */}
  <section class="bb-section" id="tuner" aria-labelledby="tuner-h">
    <div class="container container--wide">
      <header class="bb-sec-head">
        <span class="eyebrow eyebrow--mercury">Match tuner</span>
        <h2 id="tuner-h" class="bb-sec-h">Weight what matters. Get your stack.</h2>
        <p class="bb-sec-lead">
          Three weights, one weighted score over normalized quality, cost, and speed. Low-confidence
          stacks can't take first place — the same rule the API enforces.
        </p>
      </header>

      <div class="bb-tuner" data-bb-tuner>
        <div class="bb-tuner__presets" role="group" aria-label="Weight presets">
          <button class="bb-chip is-active" data-preset="60,25,15">Balanced</button>
          <button class="bb-chip" data-preset="85,10,5">Quality-first</button>
          <button class="bb-chip" data-preset="20,65,15">Budget</button>
          <button class="bb-chip" data-preset="20,15,65">Speed demon</button>
        </div>
        <div class="bb-tuner__controls">
          <label class="bb-tuner__ctl">
            <span class="bb-tuner__label">Quality <output data-out="wq">60%</output></span>
            <input type="range" min="0" max="100" value="60" data-w="wq" aria-label="Quality weight" />
          </label>
          <label class="bb-tuner__ctl">
            <span class="bb-tuner__label">Cost <output data-out="wc">25%</output></span>
            <input type="range" min="0" max="100" value="25" data-w="wc" aria-label="Cost weight" />
          </label>
          <label class="bb-tuner__ctl">
            <span class="bb-tuner__label">Speed <output data-out="ws">15%</output></span>
            <input type="range" min="0" max="100" value="15" data-w="ws" aria-label="Speed weight" />
          </label>
        </div>
        <div class="bb-tuner__scope">
          <label class="bb-tuner__field">
            <span class="bb-tuner__label">Task family</span>
            <select data-scope="family" aria-label="Score within a task family">
              <option value="">overall suite</option>
              {heat.families.map((f) => <option value={f}>{f}</option>)}
            </select>
          </label>
          <label class="bb-tuner__field">
            <span class="bb-tuner__label">Budget cap</span>
            <select data-scope="budget" aria-label="Maximum cost per task">
              <option value="">no cap</option>
              <option value="0">free only ($0)</option>
              <option value="0.01">≤ $0.01 / task</option>
              <option value="0.05">≤ $0.05 / task</option>
              <option value="0.10">≤ $0.10 / task</option>
              <option value="0.25">≤ $0.25 / task</option>
            </select>
          </label>
          <label class="bb-tuner__check">
            <input type="checkbox" data-scope="lowconf" checked aria-label="Exclude low-confidence stacks" />
            <span>exclude low-confidence</span>
          </label>
        </div>
        <ol class="bb-tuner__picks" data-bb-picks aria-live="polite"></ol>
        <p class="bb-tuner__note" data-bb-tunernote></p>
      </div>
    </div>
  </section>

  {/* ──────────────── 5 · MODEL LENS (interactive comparison) ──────────────── */}
  <section class="bb-section bb-section--mercury" aria-labelledby="lens-h">
    <div class="container container--wide">
      <header class="bb-sec-head">
        <span class="eyebrow eyebrow--mercury">Model lens</span>
        <h2 id="lens-h" class="bb-sec-h">Is it the model or the harness?</h2>
        <p class="bb-sec-lead">
          Every dot is one harness running the same model. The bar spans worst → best;
          the notch is the mean. A wide bar means the harness matters more than the model.
          Pick a model — the table below isolates it across every harness.
        </p>
      </header>

      <div class="bb-lens" data-bb-lens>
        <div class="bb-lens__toolbar">
          <div class="bb-lens__picker" role="tablist" aria-label="Isolate a model">
            {lens.map((L) => {
              const logo = MODEL_LOGO[L.model.id] ?? null;
              return (
                <button class="bb-lens__pick" role="tab" aria-selected="false" data-lenspick={L.model.id}>
                  {logo ? (
                    <img src={logo} alt="" width="16" height="16" loading="lazy" decoding="async" />
                  ) : (
                    <span class="bb-lens__pickmono">{monogramFor(L.model.id, L.model.display)}</span>
                  )}
                  {modelDisplayShort(L.model.id)}
                </button>
              );
            })}
            <button class="bb-lens__pick is-active" role="tab" aria-selected="true" data-lenspick="all">
              All models
            </button>
          </div>
          <span class="bb-lens__pickhint mono">All {BENCH.harnesses.length} harnesses · mean &amp; spread below</span>
        </div>

        <div class="bb-lens__board">
          <div class="bb-lens__axisbar" aria-hidden="true">
            <span class="bb-lens__corner"></span>
            <div class="bb-lens__axis">
              {lensTicks.map((t) => <span style={`left:${lensX(t).toFixed(2)}%`}>{Math.round(t * 100)}%</span>)}
            </div>
            <span class="bb-lens__corner"></span>
          </div>

          <div data-bb-lensrows>
            {
              lens.map((L) => {
                const logo = MODEL_LOGO[L.model.id] ?? null;
                const picked = L.spread >= 0.06;
                return (
                  <button
                    class={`bb-lens__row m--${mcls(L.model.id)}${picked ? " bb-lens__row--hot" : ""}`}
                    data-lensrow={L.model.id}
                    aria-label={`Isolate ${L.model.display}`}
                  >
                    <span class="bb-lens__id">
                      <span class={`bb-badge m--${mcls(L.model.id)}`}>
                        {logo ? (
                          <img src={logo} alt="" width="20" height="20" loading="lazy" decoding="async" />
                        ) : (
                          <span class="bb-badge__mono">{monogramFor(L.model.id, L.model.display)}</span>
                        )}
                      </span>
                      <span class="bb-lens__names">
                        <span class="bb-lens__name">{modelDisplayShort(L.model.id)}</span>
                        <span class="bb-lens__sub">
                          {fmtPct(L.mean)} mean · {fmtPct(L.spread)} spread
                        </span>
                      </span>
                    </span>
                    <svg
                      class="bb-lens__svg"
                      viewBox="0 0 100 30"
                      preserveAspectRatio="none"
                      role="img"
                      aria-label={`${L.model.display} across harnesses: solution rates from ${fmtPct(L.min)} to ${fmtPct(L.max)}`}
                    >
                      {lensTicks.map((t) => (
                        <line class="bb-lens__tick" x1={lensX(t).toFixed(2)} y1="4" x2={lensX(t).toFixed(2)} y2="26" />
                      ))}
                      <line class="bb-lens__gridline" x1="0" y1="15" x2="100" y2="15" />
                      <rect
                        class="bb-lens__range"
                        x={lensX(L.min).toFixed(2)}
                        y="11.5"
                        width={(lensX(L.max) - lensX(L.min)).toFixed(2)}
                        height="7.5"
                        rx="3.75"
                      />
                      <line
                        class="bb-lens__mean"
                        x1={lensX(L.mean).toFixed(2)}
                        x2={lensX(L.mean).toFixed(2)}
                        y1="7"
                        y2="23"
                      />
                      {L.cells.map((c) => (
                        <circle
                          class={`bb-lens__dot h--${hcls(c.harness)}`}
                          cx={lensX(c.rate).toFixed(2)}
                          cy="15"
                          r="3.2"
                          data-conf={c.confidence}
                        >
                          <title>
                            {`${harnessDisplay(c.harness)} · ${fmtPct(c.rate)} · strict ${fmtPct(c.strict)} · ${fmtCost(c.cost)}/task`}
                          </title>
                        </circle>
                      ))}
                    </svg>
                    <span class="bb-lens__extremes mono">
                      <span class="bb-lens__lo">{fmtPct(L.min)}</span>
                      <span class="bb-lens__hi">{fmtPct(L.max)}</span>
                    </span>
                  </button>
                );
              })
            }
          </div>

          <div class="bb-lens__detail" data-bb-lensdetail hidden></div>

          <p class="bb-lens__legend" aria-hidden="true">
            {
              BENCH.harnesses.map((h) => (
                <span class={`key key--ring h--${hcls(h.id)}`}>
                  <i></i>
                  {h.display}
                </span>
              ))
            }
            <span class="bb-lens__axisnote">axis {Math.round(lensLo * 100)}% → {Math.round(lensHi * 100)}% · notch = mean · hollow = low confidence</span>
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ──────────────── 6 · FAMILY HEATMAP — liquid glass focus — */}
  <section class="bb-section" aria-labelledby="heat-h">
    <div class="container container--wide">
      <header class="bb-sec-head">
        <span class="eyebrow eyebrow--ember">Family explorer</span>
        <h2 id="heat-h" class="bb-sec-h">Where each stack shines — not all at once.</h2>
        <p class="bb-sec-lead">
          Tap a stack to isolate its row; tap a family to pull one column into focus. The rest
          dims and contracts so your eye lands on one line at a time. Numbers stay quiet until
          you hover. Toggle the lens — solution, strict, or cost — and keep one comparison in view.
        </p>
      </header>

      <div class="bb-heat-toolbar">
        <div class="bb-tabs bb-tabs--sm" role="tablist" aria-label="Heatmap lens" data-bb-heatlens>
          <button class="bb-tab is-active" role="tab" aria-selected="true" data-lens="rate">Solution</button>
          <button class="bb-tab" role="tab" aria-selected="false" data-lens="strict">Strict</button>
          <button class="bb-tab" role="tab" aria-selected="false" data-lens="cost">Cost</button>
          {
            emptyFams.length > 0 && (
              <button class="bb-tab bb-tab--ghost" data-bb-emptyfam aria-pressed="false">
                + {emptyFams.length} hidden
              </button>
            )
          }
        </div>
        <span class="bb-heat-hint mono">pick a row or column — focus follows</span>
      </div>

      <div class="bb-heat-frame" data-bb-heatframe>
        <div class="bb-heat-wrap">
          <div
            class="bb-heat"
            data-bb-heat
            style={`--fam-cols:${heat.families.length};--fam-vis:${heat.families.length - emptyFams.length}`}
          >
            <div class="bb-heat__corner" aria-hidden="true"></div>
            {
              heat.families.map((fam) => (
                <button
                  class="bb-heat__colhead"
                  type="button"
                  data-heatcol={fam}
                  title={`${fam} — tap to focus this family`}
                  data-emptyfam={emptyFams.includes(fam) ? "true" : undefined}
                  aria-pressed="false"
                >
                  <span>{fam}</span>
                </button>
              ))
            }
            {
              heat.rows.map((row) => (
                <>
                  <button
                    class={`bb-heat__rowhead h--${hcls(row.harness)} m--${mcls(row.model)}`}
                    type="button"
                    data-heatrow={`${row.harness}|${row.model}`}
                    title={`${harnessDisplay(row.harness)} × ${modelDisplay(row.model)} — tap to isolate this stack`}
                    aria-pressed="false"
                  >
                    <span class="bb-heat__rowbadges" aria-hidden="true">
                      {
                        (() => {
                          const hl = HARNESS_LOGO[row.harness] ?? null;
                          const ml = MODEL_LOGO[row.model] ?? null;
                          const hMono = monogramFor(row.harness, harnessDisplay(row.harness));
                          const mMono = monogramFor(row.model, modelDisplay(row.model));
                          return (
                            <>
                              <span class={`bb-heat__badge bb-heat__badge--h h--${hcls(row.harness)}`}>
                                {hl ? (
                                  <img src={hl} alt="" width="16" height="16" loading="lazy" decoding="async" />
                                ) : (
                                  <span class="bb-badge__mono">{hMono}</span>
                                )}
                              </span>
                              <span class="bb-heat__x" aria-hidden="true">×</span>
                              <span class={`bb-heat__badge bb-heat__badge--m m--${mcls(row.model)}`}>
                                {ml ? (
                                  <img src={ml} alt="" width="16" height="16" loading="lazy" decoding="async" />
                                ) : (
                                  <span class="bb-badge__mono">{mMono}</span>
                                )}
                              </span>
                            </>
                          );
                        })()
                      }
                    </span>
                    <span class="bb-heat__rowlabel">
                      <span class={`bb-heat__h h--${hcls(row.harness)}`}>{harnessDisplay(row.harness)}</span>
                      <span class="bb-heat__m" title={modelDisplay(row.model)}>{modelDisplayShort(row.model)}</span>
                    </span>
                  </button>
                  {row.cells.map((cell, ci) => (
                    <button
                      class="bb-heat__cell"
                      type="button"
                      data-heatcell={`${row.harness}|${row.model}|${heat.families[ci]}`}
                      data-rate={cell.rate ?? ""}
                      data-strict={cell.strict ?? ""}
                      data-cost={cell.cost ?? ""}
                      data-n={cell.n}
                      data-emptyfam={emptyFams.includes(heat.families[ci] ?? "") ? "true" : undefined}
                      data-bucket={heatBucket(cell.rate, heat.domains.rate) ?? ""}
                      aria-label={
                        cell.rate != null
                          ? `${harnessDisplay(row.harness)} × ${modelDisplay(row.model)} · ${heat.families[ci]}: ${fmtPct(cell.rate!)}`
                          : `${harnessDisplay(row.harness)} × ${modelDisplay(row.model)} · ${heat.families[ci]}: not measured`
                      }
                    >
                      <span class="bb-heat__glass" aria-hidden="true"></span>
                      {cell.rate != null ? (
                        <span class="bb-heat__v">{Math.round(cell.rate! * 100)}</span>
                      ) : (
                        <span class="bb-heat__dash" aria-hidden="true">—</span>
                      )}
                    </button>
                  ))}
                </>
              ))
            }
          </div>
        </div>
        <div class="bb-heat-tip" data-bb-heattip hidden role="status" aria-live="polite"></div>
      </div>
      <p class="bb-caption">
        Glass: the tint is the value, the number is quiet until you hover. In cost mode cheapest glows teal.
        Empty tiles are dashed glass — never painted as zero. Experiential families stay hidden until Arena judgment lands.
      </p>
    </div>
  </section>

  {/* ──────────────── 7 · COST / QUALITY PARETO — interactive ──────────────── */}
  <section class="bb-section bb-section--ember" id="pareto" aria-labelledby="par-h">
    <div class="container container--wide">
      <header class="bb-sec-head">
        <span class="eyebrow eyebrow--ember">Cost vs quality</span>
        <h2 id="par-h" class="bb-sec-h">What quality costs — compare only what you care about.</h2>
        <p class="bb-sec-lead">
          Hover a dot for a glass card: solution rate, strict rate, cost, and cell count for that
          exact stack. Click to pin it — tap another to stack comparisons side by side. Use the
          filters to shrink the field to only the harnesses or models you want in view. Our round-up
          is still there — the dashed frontier — but you build your own next to it.
        </p>
      </header>

      <div class="bb-pareto" data-bb-pareto>
        <div class="bb-pareto__toolbar">
          <div class="bb-pareto__filters" role="group" aria-label="Filter stacks in view">
            <span class="bb-pareto__filterlabel mono">Show</span>
            <div class="bb-pareto__chips" data-bb-pareto-harnesses>
              {
                BENCH.harnesses.map((h) => (
                  <button
                    class="bb-pareto__chip is-on"
                    type="button"
                    data-pareto-h={h.id}
                    aria-pressed="true"
                    title={`Toggle ${h.display}`}
                  >
                    {HARNESS_LOGO[h.id] ? (
                      <img src={HARNESS_LOGO[h.id]!} alt="" width="14" height="14" loading="lazy" decoding="async" />
                    ) : null}
                    {h.display}
                  </button>
                ))
              }
            </div>
            <span class="bb-pareto__sep" aria-hidden="true">·</span>
            <div class="bb-pareto__chips" data-bb-pareto-models>
              {
                BENCH.models.map((m) => (
                  <button
                    class="bb-pareto__chip bb-pareto__chip--model is-on"
                    type="button"
                    data-pareto-m={m.id}
                    aria-pressed="true"
                  >
                    {MODEL_LOGO[m.id] ? (
                      <img src={MODEL_LOGO[m.id]!} alt="" width="14" height="14" loading="lazy" decoding="async" />
                    ) : null}
                    {modelDisplayShort(m.id)}
                  </button>
                ))
              }
            </div>
          </div>
          <div class="bb-pareto__toolbar-right">
            <button class="bb-pareto__ghost" type="button" data-bb-pareto-reset>Reset filters</button>
            <button class="bb-pareto__ghost" type="button" data-bb-pareto-clear hidden>Clear pins</button>
          </div>
        </div>

        <div class="bb-pareto__stage">
          <svg
            class="bb-pareto__svg"
            data-bb-pareto-svg
            viewBox={`0 0 ${PLOT.w} ${PLOT.h}`}
            role="img"
            aria-label="Interactive scatter: median cost per task versus solution rate. Hover for details, click to pin comparisons."
          >
            <rect
              class="bb-pareto__quadrant"
              x={PLOT.ml}
              y={PLOT.mt}
              width={(xPos(medianCost) - PLOT.ml).toFixed(1)}
              height={(yPos(medianRate) - PLOT.mt).toFixed(1)}
            />
            <text class="bb-pareto__quadlabel" x={PLOT.ml + 10} y={PLOT.mt + 16}>most attractive</text>
            {
              domain.yTicks.map((t) => (
                <>
                  <line class="bb-pareto__grid" x1={PLOT.ml} x2={PLOT.w - PLOT.mr} y1={yPos(t)} y2={yPos(t)} />
                  <text class="bb-pareto__tick" x={PLOT.ml - 8} y={yPos(t) + 4} text-anchor="end">
                    {Math.round(t * 100)}%
                  </text>
                </>
              ))
            }
            {
              domain.xTicks.map((t) => (
                <>
                  <line class="bb-pareto__grid" x1={xPos(t)} x2={xPos(t)} y1={PLOT.mt} y2={PLOT.h - PLOT.mb} />
                  <text class="bb-pareto__tick" x={xPos(t)} y={PLOT.h - PLOT.mb + 18} text-anchor="middle">
                    {fmtCost(t)}
                  </text>
                </>
              ))
            }
            <line class="bb-pareto__grid" x1={xPos(0) + 14} x2={xPos(0) + 14} y1={PLOT.mt} y2={PLOT.h - PLOT.mb} stroke-dasharray="2 4" />
            <text class="bb-pareto__tick" x={xPos(0)} y={PLOT.h - PLOT.mb + 18} text-anchor="middle">$0 free</text>
            <line class="bb-pareto__axis" x1={PLOT.ml} x2={PLOT.w - PLOT.mr} y1={PLOT.h - PLOT.mb} y2={PLOT.h - PLOT.mb} />
            <line class="bb-pareto__axis" x1={PLOT.ml} x2={PLOT.ml} y1={PLOT.mt} y2={PLOT.h - PLOT.mb} />
            <text class="bb-pareto__axistitle" x={(PLOT.ml + PLOT.w - PLOT.mr) / 2} y={PLOT.h - 8} text-anchor="middle">
              median cost per task · USD, log scale (list-price, token-derived)
            </text>
            <text
              class="bb-pareto__axistitle"
              transform={`translate(16, ${(PLOT.mt + PLOT.h - PLOT.mb) / 2}) rotate(-90)`}
              text-anchor="middle"
            >
              solution rate
            </text>
            <polyline class="bb-pareto__frontier" data-bb-pareto-frontier points={frontierLine} />
            {
              RANKED_STACKS.filter((s) => s.cost_usd_median != null).map((s) => {
                const x = xPos(s.cost_usd_median!);
                const y = yPos(s.solution_rate);
                const inferred = s.evidence === "inferred";
                const frontier = frontierKeys.has(`${s.harness}|${s.model}`);
                return (
                  <g
                    class={`bb-pareto__pt h--${hcls(s.harness)} m--${mcls(s.model)}${frontier ? " bb-pareto__pt--frontier" : ""}`}
                    data-pareto-pt={`${s.harness}|${s.model}`}
                    data-h={s.harness}
                    data-m={s.model}
                    role="button"
                    tabindex="0"
                    aria-label={`${harnessDisplay(s.harness)} × ${modelDisplay(s.model)}: ${fmtPct(s.solution_rate)} solution, ${fmtCost(s.cost_usd_median)}/task, n ${s.n}`}
                  >
                    <circle
                      class="bb-pareto__hit"
                      cx={x.toFixed(1)}
                      cy={y.toFixed(1)}
                      r="14"
                      fill="transparent"
                      stroke="transparent"
                    />
                    <circle
                      class="bb-pareto__dot"
                      cx={x.toFixed(1)}
                      cy={y.toFixed(1)}
                      r="7"
                      fill={mc(s.model)}
                      fill-opacity={inferred ? "0.48" : "0.92"}
                      stroke={hc(s.harness)}
                      stroke-width="2.4"
                      stroke-dasharray={inferred ? "3 3" : undefined}
                    />
                  </g>
                );
              })
            }
          </svg>
          <div class="bb-pareto__tip" data-bb-pareto-tip hidden role="status" aria-live="polite"></div>
        </div>

        <div class="bb-pareto__compare" data-bb-pareto-compare hidden>
          <div class="bb-pareto__compare-head">
            <strong>Pinned comparisons</strong>
            <span class="mono" data-bb-pareto-count>0 stacks</span>
          </div>
          <div class="bb-pareto__cards" data-bb-pareto-cards></div>
        </div>

        <p class="bb-legendrow" aria-label="Legend">
          {BENCH.models.map((m) => <span class={`key m--${mcls(m.id)}`}><i></i>{m.display}</span>)}
          <span class="key key--frontier"><i></i> Pareto frontier (our round-up)</span>
          <span class="key key--dash"><i></i> inferred</span>
          <span class="key" style="opacity:0.85">— hover for card · click to pin · filters above narrow the field</span>
        </p>
      </div>
    </div>
  </section>

  {/* ──────────────── 8 · ASK THE DATA (AI panel) ──────────────── */}
  <section class="bb-section bb-section--ask" id="ask" aria-labelledby="ask-h">
    <div class="container container--wide">
      <header class="bb-sec-head">
        <span class="eyebrow eyebrow--mercury">AI analyst</span>
        <h2 id="ask-h" class="bb-sec-h">Ask the data.</h2>
        <p class="bb-sec-lead">
          An AI analyst grounded in this exact export — every answer cites the rows it used, and
          charts render from a closed, server-validated spec (no generated code ever runs). Powered
          by Luna 5.6 via OpenRouter; rate-limited to keep the benchmark's costs boring.
        </p>
      </header>

      <div class="bb-ask" data-bb-ask>
        <div class="bb-ask__chat">
          <div class="bb-ask__log" data-bb-log aria-live="polite">
            <div class="bb-ask__msg bb-ask__msg--ai">
              <p>
                I'm grounded in the {generatedAt} export — {RANKED_STACKS.length} stacks,
                {` ${fmtInt(kpis.cellsMeasured)}`} cells. Ask me about tradeoffs, families, or
                where a stack earns its ranking.
              </p>
            </div>
          </div>
          <div class="bb-ask__suggestions">
            <button class="bb-chip" data-q="Which stack gives the best quality per dollar for feature work?">Best quality per dollar?</button>
            <button class="bb-chip" data-q="How much does the harness change GLM 5.2's results?">Harness effect on GLM 5.2?</button>
            <button class="bb-chip" data-q="Which stack is fastest without giving up solution quality?">Fastest without quality loss?</button>
            <button class="bb-chip" data-q="Where does the leader struggle by task family?">Leader's weak families?</button>
          </div>
          <form class="bb-ask__form" data-bb-form>
            <input
              class="bb-ask__input"
              type="text"
              name="q"
              maxlength="500"
              placeholder="Ask about the numbers…"
              autocomplete="off"
              aria-label="Ask the BurnBench data a question"
            />
            <button class="btn btn--ember btn--small" type="submit">Ask</button>
          </form>
          <p class="bb-ask__meta mono" data-bb-status>answers cite rows · 10/min · 60/day</p>
        </div>
        <div class="bb-ask__chart" data-bb-chart hidden>
          <div class="bb-ask__charthead mono" data-bb-charttitle></div>
          <div class="bb-ask__chartsvg" data-bb-chartsvg></div>
        </div>
      </div>
    </div>
  </section>

  {/* ──────────────── 9 · PROVENANCE ──────────────── */}
  <section class="bb-section" aria-labelledby="meta-h">
    <div class="container container--wide">
      <header class="bb-sec-head">
        <span class="eyebrow eyebrow--mercury">Provenance</span>
        <h2 id="meta-h" class="bb-sec-h">Fresh, frozen, and inspectable.</h2>
      </header>

      <div class="bb-meta">
        <div class="bb-meta__grid">
          <div class="bb-meta__fact">
            <span class="bb-meta__k">generated</span>
            <span class="bb-meta__v">{generatedAt}</span>
          </div>
          <div class="bb-meta__fact">
            <span class="bb-meta__k">schema</span>
            <span class="bb-meta__v">bench.json v{BENCH.schema_version}</span>
          </div>
          <div class="bb-meta__fact">
            <span class="bb-meta__k">cells measured</span>
            <span class="bb-meta__v">{fmtInt(BENCH.source.cells_measured)}</span>
          </div>
          <div class="bb-meta__fact">
            <span class="bb-meta__k">cells excluded</span>
            <span class="bb-meta__v">{fmtInt(BENCH.source.cells_excluded)}</span>
          </div>
          <div class="bb-meta__fact">
            <span class="bb-meta__k">stacks published</span>
            <span class="bb-meta__v">{BENCH.stacks.length}</span>
          </div>
          <div class="bb-meta__fact">
            <span class="bb-meta__k">runs sha256</span>
            <span class="bb-meta__v">{shaShort}…</span>
          </div>
          <div class="bb-meta__fact">
            <span class="bb-meta__k">low-confidence cells</span>
            <span class="bb-meta__v">{lowCount}</span>
          </div>
          <div class="bb-meta__fact">
            <span class="bb-meta__k">inferred cells</span>
            <span class="bb-meta__v">{inferredCount}</span>
          </div>
          <div class="bb-meta__fact">
            <span class="bb-meta__k">derived-cost stacks</span>
            <span class="bb-meta__v">{derivedCosts}</span>
          </div>
        </div>

        <p class="bb-meta__note">
          Rates ship with Wilson 95% confidence intervals. Cells with <code>n &lt; 10</code> are
          marked <strong>low confidence</strong> and may not rank first. Cells marked
          <strong> inferred</strong> are shrinkage-pooled estimates — shown dashed, never presented
          as measured. Costs are per-task medians at configured list prices;
          <strong> derived</strong> costs are computed from token counts (cached inputs at the full
          input rate — an upper bound), never receipts. Consumers can reject stale exports via the
          generated timestamp and the runs hash. Arena ratings are Bradley-Terry with bootstrap
          CIs, published only at 30+ votes per stack.
        </p>

        <div class="bb-meta__links">
          <a class="btn btn--ghost btn--small" href="/bench/report">Methodology &amp; full data</a>
          <a class="btn btn--ghost btn--small" href="/bench/arena">Arena standings</a>
          <a class="btn btn--ghost btn--small" href="/data/bench.json" download>
            Download bench.json
          </a>
        </div>
      </div>
    </div>
  </section>

  {/*
    The dashboard module fetches its dataset from /data/bench-dashboard.json
    (a prerendered projection of the export) — no inline data island, so the
    page keeps its zero-inline-JS budget and the dataset caches immutably.
  */}
  <script>
    import "../scripts/bench-dashboard";
  </script>
</BaseLayout>
