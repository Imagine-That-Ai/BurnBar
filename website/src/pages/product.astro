---
import BaseLayout from "@layouts/BaseLayout.astro";
import RealDashboard from "@components/RealDashboard.astro";
import PlatformShowcase from "@components/platform/PlatformShowcase.astro";
import SurfaceCard from "@components/SurfaceCard.astro";
import HermesGatewayPromo from "@components/HermesGatewayPromo.astro";
import { SURFACES } from "@data/surfaces";
import { FEATURES_BY_CATEGORY } from "@data/features";
import {
  FLOO,
  FLOO_CAPABILITIES,
  FLOO_PROMISES,
  CONTROL,
  CONTROL_CAPABILITIES,
  CONTROL_PROMISES
} from "@data/capabilities";
---

<BaseLayout
  title="Product"
  description="OpenBurnBar — what it actually does. Local tracking, cost and tokens, quota windows, smart insights, daemon, CLI, Hermes assistant, surfaces."
>
  <section class="pagehead">
    <div class="container pagehead__inner">
      <span class="eyebrow eyebrow--ember">Product</span>
      <h1 class="pagehead__h">Every agent, every model, every dollar — in one calm console.</h1>
      <div class="lead-glass-wrap glass-pane">
        <p class="lead">
          OpenBurnBar reads what your agents already leave behind on disk and turns it into a
          coherent picture: today's burn, this week's pattern, this month's budget, every session
          you ran, every quota window you're about to hit.
        </p>
      </div>
    </div>
  </section>

  <section>
    <div class="container container--wide prodshots">
      <RealDashboard
        src="/screens/ipad-pulse-live.png"
        alt="OpenBurnBar iPadOS app — Pulse tab streaming live from the Mac: $11,967.96 burned in the last 24h across 6.23B tokens and 559 requests, ahead of the 7-day average, $23,958.93 end-of-day forecast, 53% quota remaining across 9 providers"
        caption="Real iPadOS capture · Pulse tab · streaming live from your Mac"
        width={711}
        height={1024}
      />
      <RealDashboard
        variant="bare"
        src="/screens/ipad-burn-wide.png"
        alt="OpenBurnBar iPadOS app — Burn tab with Fleet Quota 52% Pressured, eight per-provider rings (Codex 47%, Cursor 58%, and more), and a Today / 7d / 30d / 90d / All-Time window switcher above per-provider cards"
        caption="Real iPadOS capture · Burn tab · same SwiftUI design renders on macOS"
        width={1024}
        height={711}
      />
    </div>
  </section>

  <!-- SMART DISPLAY MOCKUPS -->
  <PlatformShowcase variant="compact" />

  <!-- TRACKING -->
  <section class="featgroup">
    <div class="container container--wide">
      <header class="sec-head">
        <span class="eyebrow eyebrow--ember">Tracking</span>
        <h2>Cost, tokens, quota — local and live.</h2>
        <p class="lead">
          Numbers come from the vendor's own API or local logs. Confidence is labeled on every row.
        </p>
      </header>
      <ul class="featgroup__grid">
        {
          FEATURES_BY_CATEGORY.tracking.map((f) => (
            <li class="feat glass-pane">
              <h3>{f.title}</h3>
              <p>{f.blurb}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ROUTING -->
  <section class="featgroup featgroup--routing">
    <div class="container container--wide">
      <header class="sec-head">
        <span class="eyebrow eyebrow--ember">Routing</span>
        <h2>Same model in. Same model out. Two ways to recover.</h2>
        <p class="lead">
          The same daemon ships two postures. <strong>Provider-Family Failover</strong>
          protects your model identity and extends capacity across every account in your library that
          carries it inside the selected provider family. <strong>Exact Model Failover</strong>
          can recover across providers or accounts only after the destination proves the same canonical
          model ID. Benchmarks remain advisory signals — they never prove identity.
        </p>
      </header>

      <ul class="routing__grid">
        <li class="routing__card routing__card--family glass-pane">
          <header>
            <span class="mono routing__tag">default</span>
            <h3>Provider-Family Failover</h3>
          </header>
          <p>
            Pin an account. Add more accounts that <em>also carry that model</em>. When the primary
            throttles, the runner-up serves the next request — never a different model, never across
            the wire-format family. If no account survives, the gateway returns a structured 503.
          </p>
          <ul class="routing__bullets">
            <li>Model identity is preserved on every failover</li>
            <li>Pinned account wins when healthy · runner-up pre-selected</li>
            <li>5-minute cool-down on transient failures · auto-rejoin</li>
            <li>Account-level routing — no quota pool collapse</li>
          </ul>
        </li>
        <li class="routing__card routing__card--exact glass-pane glass-pane--elevated">
          <header>
            <span class="mono routing__tag routing__tag--mercury">opt-in</span>
            <h3>Exact Model Failover</h3>
          </header>
          <p>
            Let the router look beyond the selected provider family only when the next route can
            prove the same canonical model. <span class="mono">gpt-5.4</span> may move to another provider's
            real <span class="mono">gpt-5.4</span>; it cannot become
            <span class="mono">gpt-5.4-mini</span>, <span class="mono">gpt-5.4-pro</span>, or a
            broad <span class="mono">openai:standard</span> substitute.
          </p>
          <ul class="routing__bullets">
            <li>Canonical model ID is the hard gate</li>
            <li>Provider/account can change after recoverable failures</li>
            <li>Similar models, family wrappers, and capability classes are rejected</li>
            <li>Every decision logs original route, destination, reason, and invariant status</li>
          </ul>
        </li>
      </ul>

      <div class="routing__cta">
        <a class="btn btn--ember" href="/router">
          Read how routing actually works <span class="btn-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ASSISTANT -->
  <section class="featgroup featgroup--mercury">
    <div class="container container--wide">
      <header class="sec-head">
        <span class="eyebrow eyebrow--mercury">Hermes</span>
        <h2>An assistant that knows your data.</h2>
        <p class="lead">
          Two runtimes share one identity. Stateless per-turn against a CLI subprocess for quick
          answers, or multi-turn against a local Hermes Gateway for deeper sessions — both grounded
          in your own OpenBurnBar SQLite.
        </p>
      </header>
      <ul class="featgroup__grid">
        {
          FEATURES_BY_CATEGORY.assistant.map((f) => (
            <li class="feat feat--mercury glass-pane">
              <h3>{f.title}</h3>
              <p>{f.blurb}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- CONTROL -->
  <section class="featgroup">
    <div class="container container--wide">
      <header class="sec-head">
        <span class="eyebrow eyebrow--ember">Control plane</span>
        <h2>One daemon, every surface.</h2>
        <p class="lead">
          The daemon owns provider routing, quota refresh, retrieval, projects, missions, and a
          JSONL run journal you can replay. The CLI scripts it. Every other surface speaks to it.
        </p>
      </header>
      <ul class="featgroup__grid">
        {
          FEATURES_BY_CATEGORY.control.map((f) => (
            <li class="feat glass-pane">
              <h3>{f.title}</h3>
              <p>{f.blurb}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- FLOO — phone ⇄ Mac -->
  <section class="featgroup featgroup--mercury">
    <div class="container container--wide">
      <header class="sec-head">
        <span class="eyebrow eyebrow--mercury">{FLOO.name} · your phone & your Mac</span>
        <h2>{FLOO.tagline}</h2>
        <p class="lead">
          Your Mac does the work. Your phone is the window — and the remote. See it, steer it, send
          files, take a call, even unlock it, from across the room or across town.
        </p>
        <p class="cap-aside mono">
          <span class="tag tag--mercury tag--plain mono">{FLOO.statusLabel}</span>
          <span aria-hidden="true">·</span>
          <span>{FLOO.name} — {FLOO.expansion} <em>(a.k.a. {FLOO.expansionWhimsical})</em></span>
        </p>
      </header>
      <ul class="featgroup__grid">
        {
          FLOO_CAPABILITIES.map((f) => (
            <li class="feat feat--mercury glass-pane">
              <h3>{f.title}</h3>
              <p>{f.blurb}</p>
            </li>
          ))
        }
      </ul>
      <div class="promises glass-pane">
        <h3 class="promises__h">Safe by design</h3>
        <ul class="promises__list">
          {FLOO_PROMISES.map((p) => <li>{p}</li>)}
        </ul>
      </div>
      <div class="routing__cta">
        <a class="btn btn--ghost" href={FLOO.href}>
          See everything {FLOO.name} does <span class="btn-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- AGENT CONTROL -->
  <section class="featgroup">
    <div class="container container--wide">
      <header class="sec-head">
        <span class="eyebrow eyebrow--ember">{CONTROL.name}</span>
        <h2>{CONTROL.tagline}</h2>
        <p class="lead">
          Some jobs are faster if the agent just does them — clicks the buttons, fills the forms,
          works the apps. OpenBurnBar lets it, on a leash you hold. It does nothing you didn't
          allow, and you can stop it in an instant.
        </p>
        <p class="cap-aside mono">
          <span class="tag tag--ember tag--plain mono">{CONTROL.statusLabel}</span>
        </p>
      </header>
      <ul class="featgroup__grid">
        {
          CONTROL_CAPABILITIES.map((f) => (
            <li class="feat glass-pane">
              <h3>{f.title}</h3>
              <p>{f.blurb}</p>
            </li>
          ))
        }
      </ul>
      <div class="promises glass-pane">
        <h3 class="promises__h">You're always in charge</h3>
        <ul class="promises__list">
          {CONTROL_PROMISES.map((p) => <li>{p}</li>)}
        </ul>
      </div>
      <div class="routing__cta">
        <a class="btn btn--ghost" href={CONTROL.href}>
          How {CONTROL.name} keeps you safe <span class="btn-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- SURFACES -->
  <section class="featgroup">
    <div class="container container--wide">
      <header class="sec-head">
        <span class="eyebrow eyebrow--ember">Surfaces</span>
        <h2>The screens it shows up on.</h2>
      </header>
      <ul class="surfaces__grid">
        {SURFACES.map((s, i) => <SurfaceCard surface={s} index={i} />)}
      </ul>
    </div>
  </section>

  <!-- HONESTY -->
  <section class="featgroup featgroup--quiet">
    <div class="container container--wide">
      <header class="sec-head">
        <span class="eyebrow eyebrow--ember">The honest part</span>
        <h2>What it doesn't pretend.</h2>
        <p class="lead">
          A clean console is built on what you choose to leave out as much as what you choose to put
          in.
        </p>
      </header>
      <ul class="featgroup__grid">
        {
          FEATURES_BY_CATEGORY.honesty.map((f) => (
            <li class="feat glass-pane">
              <h3>{f.title}</h3>
              <p>{f.blurb}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <HermesGatewayPromo />

  <section class="endcta endcta--inline">
    <div class="container container--narrow endcta__inner">
      <h2>Read it in code, not in marketing.</h2>
      <div class="lead-glass-wrap glass-pane">
        <p class="lead">
          OpenBurnBar is AGPL-licensed. The README, the architecture doc, the threat model, the
          provider matrix, the changelog, and the corresponding source offer are all in the open.
        </p>
      </div>
      <div class="endcta__ctas">
        <a class="btn btn--ember" href="/download"
          >Download for macOS <span class="btn-arrow" aria-hidden="true">→</span></a
        >
        <a class="btn btn--ghost" href="/providers">See provider matrix</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .prodshots {
    display: grid;
    justify-items: center;
    gap: clamp(var(--s-6), 6vw, var(--s-9));
  }
  .pagehead {
    padding-block: var(--s-9) var(--s-6);
  }
  .pagehead__inner {
    max-width: 960px;
    margin: 0 auto;
  }
  .pagehead__h {
    margin-top: var(--s-3);
    max-width: 22ch;
  }
  .pagehead .lead {
    margin-top: var(--s-4);
    max-width: 60ch;
  }
  .featgroup {
    padding-block: var(--s-9);
    border-top: 1px solid var(--ink-line);
  }
  .featgroup--quiet {
    background: var(--ink-base);
  }
  .featgroup--mercury {
    background: radial-gradient(60% 60% at 100% 50%, rgba(214, 211, 223, 0.04), transparent 70%);
  }
  .cap-aside {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    flex-wrap: wrap;
    margin-top: var(--s-1);
    font-size: var(--t-caption);
    color: var(--text-mute);
  }
  .cap-aside em {
    color: var(--text-base);
    font-style: italic;
  }
  .promises {
    margin-top: var(--s-5);
    padding: var(--s-5);
    display: grid;
    gap: var(--s-3);
    border-radius: var(--r-4);
  }
  .promises__h {
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ember-bright);
    font-family: var(--font-mono);
    font-variation-settings: "wght" 600;
  }
  .featgroup--mercury .promises__h {
    color: var(--mercury-bright);
  }
  .promises__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--s-2) var(--s-5);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .promises__list li {
    position: relative;
    padding-left: 1.5em;
    color: var(--text-base);
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .promises__list li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--ember-bright);
    font-family: var(--font-mono);
  }
  .featgroup--mercury .promises__list li::before {
    color: var(--mercury-bright);
  }
  .sec-head {
    display: grid;
    gap: var(--s-3);
    margin-bottom: var(--s-6);
    max-width: 64ch;
  }
  .featgroup__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-4);
  }
  .feat {
    padding: var(--s-5);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: var(--r-4);
    background: rgba(10, 10, 15, 0.72);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.45);
    display: grid;
    gap: var(--s-2);
  }
  .feat h3 {
    font-size: 1.1rem;
    font-family: var(--font-display);
    color: var(--text-bright);
    font-variation-settings:
      "opsz" 36,
      "wght" 540;
    letter-spacing: -0.014em;
  }
  .feat p {
    color: var(--text-base);
    font-size: 0.94rem;
  }
  .feat--mercury {
    border-color: color-mix(in oklab, var(--mercury-bright) 22%, rgba(255, 255, 255, 0.08));
    border-top-color: color-mix(in oklab, var(--mercury-bright) 35%, rgba(255, 255, 255, 0.16));
    background: rgba(15, 15, 20, 0.76);
  }
  .surfaces__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--s-4);
  }
  @media (max-width: 1080px) {
    .featgroup__grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .surfaces__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .featgroup__grid {
      grid-template-columns: 1fr;
    }
    .surfaces__grid {
      grid-template-columns: 1fr;
    }
  }
  .endcta--inline {
    padding-block: var(--s-9);
    text-align: center;
    background: radial-gradient(60% 80% at 50% 50%, rgba(255, 106, 26, 0.05), transparent 70%);
  }
  .endcta--inline h2 {
    margin-bottom: var(--s-3);
  }
  .endcta--inline .lead {
    margin: 0 auto;
  }
  .endcta__ctas {
    display: flex;
    justify-content: center;
    gap: var(--s-3);
    margin-top: var(--s-5);
    flex-wrap: wrap;
  }
  .endcta__inner {
    text-align: center;
    display: grid;
    gap: var(--s-5);
    justify-items: center;
    padding: var(--s-4) 0;
  }

  /* ─── routing ─── */
  .featgroup--routing {
    background:
      radial-gradient(70% 60% at 50% 0%, rgba(255, 106, 26, 0.05), transparent 60%),
      radial-gradient(50% 60% at 95% 100%, rgba(214, 211, 223, 0.04), transparent 70%);
  }
  .routing__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-4);
    list-style: none;
  }
  .routing__card {
    display: grid;
    gap: var(--s-3);
    padding: var(--s-5);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: var(--r-4);
    background: rgba(10, 10, 15, 0.72);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.45);
  }
  .routing__card--family {
    border-color: color-mix(in oklab, var(--ember-core) 32%, rgba(255, 255, 255, 0.08));
    border-top-color: color-mix(in oklab, var(--ember-core) 45%, rgba(255, 255, 255, 0.16));
    background: rgba(20, 12, 10, 0.76);
    box-shadow:
      0 0 40px -15px rgba(255, 106, 26, 0.25),
      0 8px 32px 0 rgba(0, 0, 0, 0.45);
  }
  .routing__card--exact {
    border-color: color-mix(in oklab, var(--mercury-bright) 30%, rgba(255, 255, 255, 0.12));
    border-top-color: color-mix(in oklab, var(--mercury-bright) 45%, rgba(255, 255, 255, 0.22));
    background: rgba(20, 20, 28, 0.82);
    box-shadow: 0 12px 40px 0 rgba(0, 0, 0, 0.55);
  }
  .routing__card header {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--s-3);
  }
  .routing__card h3 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--text-bright);
    font-variation-settings:
      "opsz" 36,
      "wght" 540;
    letter-spacing: -0.018em;
    line-height: 1.15;
  }
  .routing__tag {
    color: var(--ember-bright);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 1px 6px;
    border-radius: var(--r-pill);
    border: 1px solid color-mix(in oklab, var(--ember-core) 40%, var(--ink-line));
    background: color-mix(in oklab, var(--ember-core) 8%, transparent);
  }
  .routing__tag--mercury {
    color: var(--mercury-bright);
    border-color: color-mix(in oklab, var(--mercury-bright) 35%, var(--ink-line));
    background: color-mix(in oklab, var(--mercury-bright) 8%, transparent);
  }
  .routing__card p {
    color: var(--text-base);
    font-size: 0.94rem;
    line-height: 1.55;
  }
  .routing__bullets {
    list-style: none;
    display: grid;
    gap: var(--s-2);
    margin-top: var(--s-2);
    padding-top: var(--s-3);
    border-top: 1px dashed var(--ink-line-soft);
  }
  .routing__bullets li {
    color: var(--text-base);
    font-size: 0.9rem;
    padding-left: var(--s-4);
    position: relative;
  }
  .routing__bullets li::before {
    content: "▸";
    position: absolute;
    left: 0;
    color: var(--ember-bright);
    font-family: var(--font-mono);
    font-size: 0.9em;
  }
  .routing__card--exact .routing__bullets li::before {
    color: var(--mercury-bright);
  }
  .routing__cta {
    margin-top: var(--s-5);
    display: flex;
    justify-content: flex-start;
  }
  @media (max-width: 960px) {
    .routing__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
