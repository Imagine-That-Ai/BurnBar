    position: absolute;
    inset: 12px;
    border: 1px dashed rgba(255, 255, 255, 0.08);
    border-radius: calc(var(--r-lg) - 8px);
    pointer-events: none;
  }
  .endplate__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    flex-wrap: wrap;
    position: relative;
    z-index: 1;
  }
  .endplate__row--foot {
    margin-top: var(--s-4);
  }
  .endplate__band {
    font-size: var(--t-eyebrow);
    color: var(--text-mute);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .endplate__pill {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--t-eyebrow);
    padding: 0.25em 0.75em;
    border-radius: var(--r-pill);
    border: 1px solid color-mix(in oklab, var(--ember-core) 50%, var(--ink-line));
    color: var(--ember-bright);
    background: var(--ember-wash);
    text-transform: uppercase;
    letter-spacing: 0.18em;
  }
  .endplate__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ember-bright);
    box-shadow: 0 0 8px currentColor;
    animation: liveBlink 1.6s ease-in-out infinite;
  }
  @keyframes liveBlink {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.4;
      transform: scale(0.85);
    }
  }
  .endplate__addr {
    margin-top: var(--s-3);
    font-size: clamp(1.4rem, 3.8vw, 2.6rem);
    color: var(--text-bright);
    letter-spacing: -0.01em;
    line-height: 1;
    position: relative;
    z-index: 1;
    text-shadow: 0 0 24px rgba(250, 107, 6, 0.25);
    word-break: break-all;
  }
  .endplate__meta {
    font-size: 0.8rem;
    color: var(--text-mute);
  }

  /* ============================================================
     2 · THREE CHANNELS
  ============================================================ */
  .channels {
    padding-block: var(--s-9);
    border-top: 1px solid var(--ink-line);
  }
  .channels__grid {
    display: grid;
    gap: var(--s-5);
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  @media (max-width: 960px) {
    .channels__grid {
      grid-template-columns: 1fr;
    }
  }
  .channel {
    position: relative;
    padding: var(--s-5) var(--s-5) var(--s-6);
    border-radius: var(--r-lg);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.03) 0%, rgba(0, 0, 0, 0.3) 100%);
    border: 1px solid var(--ink-line);
    transition:
      border-color var(--dur-base) var(--ease),
      transform var(--dur-base) var(--ease),
      box-shadow var(--dur-base) var(--ease);
    isolation: isolate;
  }
  .channel::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--ember-core) 30%,
      var(--ember-bright) 50%,
      var(--ember-core) 70%,
      transparent
    );
    opacity: 0.5;
  }
  .channel--mercury::before {
    background: linear-gradient(
      90deg,
      transparent,
      rgba(128, 128, 255, 0.6) 30%,
      #ffffff 50%,
      rgba(128, 128, 255, 0.6) 70%,
      transparent
    );
    opacity: 0.6;
  }
  .channel:hover {
    transform: translateY(-3px);
    border-color: rgba(250, 107, 6, 0.35);
    box-shadow:
      0 24px 60px -16px rgba(0, 0, 0, 0.6),
      0 0 30px 0 rgba(250, 107, 6, 0.08);
  }
  .channel--mercury:hover {
    border-color: rgba(128, 128, 255, 0.35);
    box-shadow:
      0 24px 60px -16px rgba(0, 0, 0, 0.6),
      0 0 30px 0 rgba(128, 128, 255, 0.1);
  }
  .channel__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-3);
    margin-bottom: var(--s-4);
  }
  .channel__sigil {
    font-size: 2.2rem;
    color: var(--ember-bright);
    line-height: 1;
    letter-spacing: -0.03em;
    font-family: var(--font-display);
  }
  .channel--mercury .channel__sigil {
    color: #c8c8ff;
  }
  .channel__band {
    font-size: var(--t-eyebrow);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--text-mute);
  }
  .channel__name {
    font-size: 1.6rem;
    margin-bottom: var(--s-5);
    line-height: 1.05;
    color: var(--text-bright);
  }
  .channel__spec {
    display: grid;
    gap: var(--s-2);
    margin-bottom: var(--s-5);
    font-size: 0.8rem;
    padding: var(--s-4);
    border: 1px solid var(--ink-line);
    border-radius: var(--r-md);
    background: rgba(0, 0, 0, 0.25);
  }
  .channel__spec > div {
    display: grid;
    grid-template-columns: 5.4rem minmax(0, 1fr);
    gap: var(--s-3);
    align-items: baseline;
  }
  .channel__spec dt {
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.7rem;
  }
  .channel__spec dd {
    color: var(--text-base);
    overflow-wrap: anywhere;
  }
  .channel__src {
    color: var(--ember-bright);
    font-size: 0.78rem;
  }
  .channel--mercury .channel__src {
    color: #c8c8ff;
  }
  .channel__bul {
    display: grid;
    gap: var(--s-2);
    color: var(--text-base);
    font-size: 0.95rem;
  }
  .channel__bul li {
    padding-left: 1.1em;
    position: relative;
    line-height: 1.5;
  }
  .channel__bul li::before {
    content: "—";
    position: absolute;
    left: 0;
    color: var(--ember-bright);
  }
  .channel--mercury .channel__bul li::before {
    color: #c8c8ff;
  }

  /* ============================================================
     3 · TOOL DOSSIER
  ============================================================ */
  .dossier {
    padding-block: var(--s-9);
    border-top: 1px solid var(--ink-line);
  }
  .dossier__cluster {
    margin-top: var(--s-7);
  }
  .dossier__cluster:first-of-type {
    margin-top: 0;
  }
  .dossier__bar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-3);
    padding-bottom: var(--s-3);
    margin-bottom: var(--s-5);
    border-bottom: 1px solid var(--ink-line);
  }
  .dossier__count {
    color: var(--text-mute);
    font-size: 0.85rem;
    letter-spacing: 0.06em;
  }
  .dossier__grid {
    display: grid;
    gap: var(--s-4);
    grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr));
  }

  .tooltile {
    position: relative;
    padding: var(--s-5);
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid var(--ink-line);
    border-radius: var(--r-md);
    transition:
      border-color var(--dur-base) var(--ease),
      background var(--dur-base) var(--ease),
      transform var(--dur-base) var(--ease);
  }
  .tooltile:hover {
    border-color: rgba(250, 107, 6, 0.35);
    background: rgba(20, 12, 6, 0.4);
    transform: translateY(-2px);
  }
  /* corner brackets — four absolutely-positioned right angles */
  .tooltile__bracket > span {
    position: absolute;
    width: 12px;
    height: 12px;
    border: 1px solid var(--ember-core);
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease);
  }
  .tooltile__bracket > span:nth-child(1) {
    top: -1px;
    left: -1px;
    border-right: 0;
    border-bottom: 0;
  }
  .tooltile__bracket > span:nth-child(2) {
    top: -1px;
    right: -1px;
    border-left: 0;
    border-bottom: 0;
  }
  .tooltile__bracket > span:nth-child(3) {
    bottom: -1px;
    left: -1px;
    border-right: 0;
    border-top: 0;
  }
  .tooltile__bracket > span:nth-child(4) {
    bottom: -1px;
    right: -1px;
    border-left: 0;
    border-top: 0;
  }
  .tooltile:hover .tooltile__bracket > span {
    opacity: 1;
  }
  .tooltile__name {
    display: block;
    color: var(--text-bright);
    font-size: 0.95rem;
    font-weight: 500;
    margin-bottom: var(--s-2);
    overflow-wrap: anywhere;
  }
  .tooltile__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    font-size: 0.7rem;
    margin-bottom: var(--s-3);
  }
  .tooltile__scope {
    color: var(--ember-bright);
    text-transform: lowercase;
    letter-spacing: 0.08em;
  }
  .tooltile__scope.is-write {
    color: var(--core-red);
    font-weight: 700;
    letter-spacing: 0.14em;
  }
  .tooltile__cost {
    color: var(--text-mute);
    text-transform: lowercase;
    letter-spacing: 0.08em;
  }
  .tooltile__desc {
    color: var(--text-base);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  /* ============================================================
     4 · INSTALL · termmux
  ============================================================ */
  .install {
    padding-block: var(--s-9);
    border-top: 1px solid var(--ink-line);
  }
  .termmux {
    margin-top: var(--s-6);
    border: 1px solid var(--ink-line);
    border-radius: var(--r-lg);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.02) 0%, rgba(0, 0, 0, 0.5) 100%);
    overflow: hidden;
  }
  .termmux + .termmux {
    margin-top: var(--s-7);
  }
  .termmux__head {
    padding: var(--s-5) var(--s-5) var(--s-3);
    border-bottom: 1px solid var(--ink-line);
  }
  .termmux__title {
    font-size: 1.4rem;
    color: var(--text-bright);
    line-height: 1.1;
  }
  .termmux__sub {
    margin-top: var(--s-2);
    font-size: 0.78rem;
    color: var(--text-mute);
    letter-spacing: 0.06em;
  }
  .termmux__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 2px;
    padding: var(--s-2);
    background: rgba(0, 0, 0, 0.4);
    border-bottom: 1px solid var(--ink-line);
  }
  .termmux__tab {
    appearance: none;
    background: transparent;
    border: 1px solid transparent;
    color: var(--text-mute);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    padding: 0.45rem 0.85rem;
    border-radius: var(--r-sm);
    cursor: pointer;
    transition:
      color var(--dur-base) var(--ease),
      background var(--dur-base) var(--ease),
      border-color var(--dur-base) var(--ease);
  }
  .termmux__tab:hover {
    color: var(--text-bright);
    background: rgba(255, 255, 255, 0.04);
  }
  .termmux__tab[aria-selected="true"] {
    color: var(--ember-bright);
    background: var(--ember-wash);
    border-color: color-mix(in oklab, var(--ember-core) 50%, var(--ink-line));
  }
  .termmux__strip {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-3) var(--s-5);
    border-bottom: 1px solid var(--ink-line);
    background: rgba(0, 0, 0, 0.25);
  }
  .termmux__strip-meta {
    color: var(--text-mute);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
  }
  .termmux__copy {
    appearance: none;
    background: transparent;
    border: 1px solid var(--ink-line);
    color: var(--text-mute);
    padding: 0.3rem 0.7rem;
    border-radius: var(--r-sm);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    cursor: pointer;
    transition:
      color var(--dur-base) var(--ease),
      border-color var(--dur-base) var(--ease),
      background var(--dur-base) var(--ease);
  }
  .termmux__copy:hover {
    color: var(--ember-bright);
    border-color: color-mix(in oklab, var(--ember-core) 50%, var(--ink-line));
  }
  .termmux__copy[data-flash="true"] {
    color: var(--ember-bright);
    background: var(--ember-wash);
    border-color: color-mix(in oklab, var(--ember-bright) 50%, var(--ink-line));
  }
  .termmux__pre {
    margin: 0;
    padding: var(--s-5);
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--text-base);
    overflow-x: auto;
    white-space: pre;
    background: transparent;
    border: 0;
  }
  .termmux__pre code {
    background: transparent;
    border: 0;
    padding: 0;
  }

  /* ============================================================
     5 · PRIVACY MODE
  ============================================================ */
  .priv {
    padding-block: var(--s-9);
    border-top: 1px solid var(--ink-line);
  }
  .priv__grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--s-5);
    align-items: stretch;
    margin-top: var(--s-6);
  }
  @media (max-width: 880px) {
    .priv__grid {
      grid-template-columns: 1fr;
    }
  }
  .priv__col {
    padding: var(--s-5);
    border: 1px solid var(--ink-line);
    border-radius: var(--r-md);
    background: rgba(0, 0, 0, 0.25);
  }
  .priv__col--never {
    background: linear-gradient(180deg, rgba(250, 107, 6, 0.04) 0%, rgba(0, 0, 0, 0.4) 100%);
    border-color: color-mix(in oklab, var(--ember-core) 30%, var(--ink-line));
  }
  .priv__tag {
    font-size: var(--t-eyebrow);
    text-transform: uppercase;
    letter-spacing: 0.18em;
  }
  .priv__tag--mute {
    color: var(--text-mute);
  }
  .priv__tag--ember {
    color: var(--ember-bright);
  }
  .priv__list {
    display: grid;
    gap: var(--s-3);
    margin-top: var(--s-4);
    color: var(--text-base);
  }
  .priv__list li {
    padding-left: 1.4em;
    position: relative;
    font-size: 0.95rem;
    line-height: 1.55;
  }
  .priv__col--sees .priv__list li::before {
    content: "+";
    position: absolute;
    left: 0;
    color: var(--text-mute);
    font-family: var(--font-mono);
  }
  .priv__col--never .priv__list li::before {
    content: "✕";
    position: absolute;
    left: 0;
    color: var(--ember-bright);
    font-family: var(--font-mono);
  }
  .priv__divider {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    color: var(--ember-bright);
  }
  .priv__divider-arrow {
    font-size: 2rem;
    line-height: 1;
    opacity: 0.6;
  }
  @media (max-width: 880px) {
    .priv__divider {
      display: none;
    }
  }
  .priv__note {
    margin-top: var(--s-5);
    color: var(--text-mute);
    font-size: 0.82rem;
    max-width: 80ch;
    line-height: 1.6;
  }

  /* ============================================================
     6 · SLO SCOREBOARD
  ============================================================ */
  .scoreboard {
    padding-block: var(--s-9);
    border-top: 1px solid var(--ink-line);
  }
  .scoreboard__grid {
    display: grid;
    gap: var(--s-3);
    grid-template-columns: repeat(6, minmax(0, 1fr));
    margin-top: var(--s-3);
  }
  @media (max-width: 1100px) {
    .scoreboard__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .scoreboard__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .scoretile {
    position: relative;
    padding: var(--s-5);
    border: 1px solid var(--ink-line);
    border-radius: var(--r-md);
    background: rgba(0, 0, 0, 0.3);
    text-align: left;
  }
  .scoretile__bracket > span {
    position: absolute;
    width: 8px;
    height: 8px;
    border: 1px solid color-mix(in oklab, var(--ember-core) 50%, var(--ink-line));
  }
  .scoretile__bracket > span:nth-child(1) {
    top: 6px;
    left: 6px;
    border-right: 0;
    border-bottom: 0;
  }
  .scoretile__bracket > span:nth-child(2) {
    top: 6px;
    right: 6px;
    border-left: 0;
    border-bottom: 0;
  }
  .scoretile__bracket > span:nth-child(3) {
    bottom: 6px;
    left: 6px;
    border-right: 0;
    border-top: 0;
  }
  .scoretile__bracket > span:nth-child(4) {
    bottom: 6px;
    right: 6px;
    border-left: 0;
    border-top: 0;
  }
  .scoretile__num {
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
    font-size: clamp(2rem, 5vw, 3.4rem);
    line-height: 1;
    color: var(--text-bright);
    letter-spacing: -0.04em;
    font-variation-settings:
      "wght" 600,
      "opsz" 144;
  }
  .scoretile__unit {
    font-size: 0.8rem;
    color: var(--text-mute);
    letter-spacing: 0.06em;
    text-transform: lowercase;
  }
  .scoretile__lbl {
    margin-top: var(--s-3);
    color: var(--text-mute);
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .scoreboard__verify {
    margin-top: var(--s-6);
    padding: var(--s-3) var(--s-5);
    border: 1px solid var(--ink-line);
    border-radius: var(--r-md);
    background: rgba(0, 0, 0, 0.3);
  }
  .scoreboard__verify summary {
    cursor: pointer;
    color: var(--text-mute);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    list-style: none;
  }
  .scoreboard__verify summary::before {
    content: "▸ ";
    color: var(--ember-bright);
    transition: transform var(--dur-base) var(--ease);
    display: inline-block;
  }
  .scoreboard__verify[open] summary::before {
    content: "▾ ";
  }
  .scoreboard__verify pre {
    margin-top: var(--s-4);
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--text-base);
    overflow-x: auto;
  }

  /* ============================================================
     7 · CONNECTED CLIENTS MIRROR
  ============================================================ */
  .ccmirror {
    padding-block: var(--s-9);
    border-top: 1px solid var(--ink-line);
  }
  .ccmirror__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-7);
    align-items: start;
  }
  @media (max-width: 960px) {
    .ccmirror__inner {
      grid-template-columns: 1fr;
    }
  }
  .ccmirror__copy h2 {
    margin-top: var(--s-3);
    margin-bottom: var(--s-5);
    max-width: 18ch;
  }
  .ccmirror__copy p {
    margin-bottom: var(--s-4);
    max-width: 60ch;
  }

  .ccmirror__card {
    padding: var(--s-5);
    border-radius: var(--r-lg);
    border: 1px solid var(--ink-line);
    border-top: 1px solid var(--ink-line-bright);
    background: linear-gradient(180deg, rgba(20, 18, 26, 0.6) 0%, rgba(8, 6, 12, 0.7) 100%);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    box-shadow:
      0 32px 64px -16px rgba(0, 0, 0, 0.7),
      inset 0 1px 0 0 rgba(255, 255, 255, 0.06);
  }
  .ccmirror__cardhead {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    margin-bottom: var(--s-3);
  }
  .ccmirror__icon {
    color: var(--ember-bright);
    display: inline-flex;
  }
  .ccmirror__title {
    flex: 1;
    color: var(--text-bright);
    font-size: 0.78rem;
    letter-spacing: 0.2em;
  }
  .ccmirror__inc {
    color: var(--ember-bright);
    font-size: 0.7rem;
    padding: 0.2rem 0.6rem;
    border-radius: var(--r-pill);
    background: var(--ember-wash);
    border: 1px solid color-mix(in oklab, var(--ember-core) 40%, var(--ink-line));
    letter-spacing: 0.1em;
  }
  .ccmirror__blurb {
    color: var(--text-base);
    font-size: 0.92rem;
    margin-bottom: var(--s-5);
  }
  .ccmirror__rows {
    display: grid;
    gap: var(--s-2);
    font-size: 0.8rem;
    padding: var(--s-4);
    border: 1px solid var(--ink-line);
    border-radius: var(--r-md);
    background: rgba(0, 0, 0, 0.35);
    margin-bottom: var(--s-5);
  }
  .ccmirror__rows > div {
    display: grid;
    grid-template-columns: 5.6rem 1fr;
    gap: var(--s-3);
    align-items: baseline;
  }
  .ccmirror__rows dt {
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.7rem;
  }
  .ccmirror__rows dd {
    color: var(--text-bright);
    overflow-wrap: anywhere;
  }
  .ccmirror__connected {
    border-top: 1px dashed var(--ink-line);
    padding-top: var(--s-4);
  }
  .ccmirror__conhead {
    font-size: 0.7rem;
    color: var(--text-mute);
    letter-spacing: 0.18em;
    margin-bottom: var(--s-3);
  }
  .ccmirror__connected ul {
    display: grid;
