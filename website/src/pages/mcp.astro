<script>
  // Tabbed terminal mux + copy-to-clipboard
  document.querySelectorAll<HTMLElement>(".termmux").forEach((mux) => {
    const tabs = mux.querySelectorAll<HTMLButtonElement>(".termmux__tab");
    const panels = mux.querySelectorAll<HTMLElement>(".termmux__panel");
    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const target = tab.dataset.target;
        tabs.forEach((t) => t.setAttribute("aria-selected", t === tab ? "true" : "false"));
        panels.forEach((p) => {
          if (p.dataset.panel === target) p.removeAttribute("hidden");
          else p.setAttribute("hidden", "");
        });
      });
      // keyboard arrows for accessibility
      tab.addEventListener("keydown", (e) => {
        const arr = Array.from(tabs);
        const i = arr.indexOf(tab);
        let next = -1;
        if (e.key === "ArrowRight") next = (i + 1) % arr.length;
        if (e.key === "ArrowLeft") next = (i - 1 + arr.length) % arr.length;
        if (next >= 0) {
          e.preventDefault();
          const nextTab = arr[next];
          if (!nextTab) return;
          nextTab.focus();
          nextTab.click();
        }
      });
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const panel = btn.closest<HTMLElement>(".termmux__panel");
      const pre = panel?.querySelector("pre code");
      if (!pre) return;
      try {
        await navigator.clipboard.writeText(pre.textContent ?? "");
        const original = btn.textContent;
        btn.textContent = "copied ✓";
        btn.setAttribute("data-flash", "true");
        setTimeout(() => {
          btn.textContent = original;
          btn.removeAttribute("data-flash");
        }, 1400);
      } catch {
        btn.textContent = "press ⌘C";
      }
    });
  });
</script>

