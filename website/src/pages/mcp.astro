---
import BaseLayout from "@layouts/BaseLayout.astro";
import { SITE } from "@data/site";

/* ------------------------------------------------------------------
   Three MCP surfaces — single source of truth for the channel cards.
------------------------------------------------------------------- */
const channels = [
  {
    sigil: "01",
    band: "Free · local",
    name: "Local stdio MCP",
    runtime: "Python 3 · mcp 1.27.0",
    audience: "Anyone running OpenBurnBar — no account",
    transport: "stdio",
    auth: "Local filesystem (your user)",
    dataPath: "~/Library/Application Support/OpenBurnBar/openburnbar.sqlite",
    tools: 26,
    accent: "ember",
    bullet: [
      "FTS5 + local deterministic semantic search over your transcripts",
      "BurnBar Resume can port prior conversations across harnesses",
      "Token-usage ledger writer is daemon-first, idempotent, falls back to JSONL",
      "Bundles a Hermes operator skill, auto-symlinked at install time"
    ]
  },
  {
    sigil: "02",
    band: "BurnBar Pro · hosted",
    name: "Hosted Remote MCP",
    runtime: "Cloud Run · Node 22 · 2025-11-25 spec",
    audience: "BurnBar Pro subscribers, any device",
    transport: "Streamable HTTP",
    auth: "Short-lived HMAC bearer (audience-bound)",
    dataPath: "https://mcp.burnbar.ai/mcp",
    tools: 8,
    accent: "mercury",
    bullet: [
      "Search hits opaque token/semantic hashes — zero Storage reads",
      "Bodies and resume briefings decrypt on-device by default (local_decrypt_shim)",
      "Per-client grant revoke from the OpenBurnBar app's Cloud Store"
    ]
  },
  {
    sigil: "03",
    band: "Bridge · stdio shim",
    name: "openburnbar-mcp-remote",
    runtime: "Node 22 · zero runtime deps",
    audience: "Codex · Claude Code · Droid · Kimi · Forge",
    transport: "stdio ⇄ HTTPS",
    auth: "macOS Keychain → 0600 file → env var",
    dataPath: "→ https://mcp.burnbar.ai/mcp",
    tools: 8,
    accent: "ember",
    bullet: [
      "Bridges stdio-only clients to the hosted endpoint",
      "Performs the on-device decrypt that keeps privacy mode honest",
      "Adds openburnbar resume for print/copy/open handoff flows",
      "openburnbar mcp doctor proves the whole chain in one command"
    ]
  }
];

/* ------------------------------------------------------------------
   Tool dossier — names + descriptions copied verbatim from
   services/hosted-mcp/src/toolRegistry.ts and
   tools/openburnbar-mcp/README.md so the page never drifts.
------------------------------------------------------------------- */
const hostedTools = [
  {
    name: "burnbar_search_conversations",
    scope: "search:read",
    cost: "standard",
    desc: "Search encrypted OpenBurnBar hosted session memory. Sealed results require the local shim for decrypted previews."
  },
  {
    name: "burnbar_get_conversation_body",
    scope: "conversation:read",
    cost: "body",
    desc: "Fetch one encrypted session body page for a resource returned by search."
  },
  {
    name: "burnbar_list_search_index_status",
    scope: "index:status",
    cost: "metadata",
    desc: "Return encrypted search index freshness, counts, active commits, and stale-state warnings."
  },
  {
    name: "burnbar_list_search_facets",
    scope: "search:read",
    cost: "metadata",
    desc: "List bounded provider / model / project / harness facets for narrowing hosted search."
  },
  {
    name: "burnbar_recent_usage",
    scope: "usage:read",
    cost: "metadata",
    desc: "Read recent provider / model usage metadata without provider credentials."
  },
  {
    name: "burnbar_list_resumable_conversations",
    scope: "index:status",
    cost: "metadata",
    desc: "List recent encrypted hosted sessions eligible for resume."
  },
  {
    name: "burnbar_resume_conversation",
    scope: "conversation:read",
    cost: "body",
    desc: "Compose a sealed resume plan. The local shim decrypts and renders on device."
  },
  {
    name: "burnbar_resolve_capabilities",
    scope: "index:status",
    cost: "metadata",
    desc: "Describe the current user's hosted MCP availability, decrypt mode, scopes, and limits."
  }
];

const localTools = [
  {
    name: "burnbar_resolve_db_path",
    scope: "read",
    cost: "metadata",
    desc: "Show which DB file is in use."
  },
  {
    name: "burnbar_list_providers",
    scope: "read",
    cost: "metadata",
    desc: "Distinct provider values — Codex, Claude Code, Cursor, Hermes, etc."
  },
  {
    name: "burnbar_search_conversations",
    scope: "read",
    cost: "standard",
    desc: "FTS5 search over conversation titles and full transcripts."
  },
  {
    name: "burnbar_semantic_search_conversations",
    scope: "read",
    cost: "standard",
    desc: "Local deterministic semantic search over indexed conversation chunks. Returns structured unavailable when the local semantic index is absent."
  },
  {
    name: "burnbar_cloud_semantic_search_conversations",
    scope: "read · opt-in",
    cost: "standard",
    desc: "Hosted encrypted semantic search; query hashes derived locally, snippets decrypt locally."
  },
  {
    name: "burnbar_cloud_get_conversation_body",
    scope: "read · opt-in",
    cost: "body",
    desc: "Decrypt the full hosted session body for a cloud search hit."
  },
  {
    name: "burnbar_list_project_memory",
    scope: "read",
    cost: "metadata",
    desc: "List project memory snapshots with source counts and freshness."
  },
  {
    name: "burnbar_get_project_memory",
    scope: "read",
    cost: "body",
    desc: "Read one project memory snapshot by slug."
  },
  {
    name: "burnbar_cloud_sync_project_memory",
    scope: "read · opt-in",
    cost: "body",
    desc: "Sync a local project memory snapshot through the encrypted cloud path."
  },
  {
    name: "burnbar_get_conversation",
    scope: "read",
    cost: "body",
    desc: "Full row plus fullText for one conversation by ID (120k char default cap)."
  },
  {
    name: "burnbar_recent_usage",
    scope: "read",
    cost: "metadata",
    desc: "Recent token_usage rows — cost, model, provider, session."
  },
  {
    name: "burnbar_project_summary",
    scope: "read",
    cost: "metadata",
    desc: "Per-project cost + session count aggregated over a rolling window."
  },
  {
    name: "burnbar_chat_messages",
    scope: "read",
    cost: "metadata",
    desc: "In-app assistant chat_messages tail."
  },
  {
    name: "burnbar_record_hermes_usage",
    scope: "WRITE · daemon",
    cost: "standard",
    desc: "Write an idempotent row to the OpenBurnBar daemon usage ledger. The only write tool."
  },
  {
    name: "burnbar_resolve_usage_ledger_path",
    scope: "read",
    cost: "metadata",
    desc: "Show the ledger path the writer will use."
  },
  {
    name: "burnbar_query_spend",
    scope: "read",
    cost: "standard",
    desc: "Query spend by provider, model, project, account, and time window."
  },
  {
    name: "burnbar_budget_status",
    scope: "read",
    cost: "metadata",
    desc: "Summarize active budget gates and current burn state."
  },
  {
    name: "burnbar_spend_forecast",
    scope: "read",
    cost: "standard",
    desc: "Forecast spend against configured budget limits."
  },
  {
    name: "burnbar_budget_audit",
    scope: "read",
    cost: "metadata",
    desc: "Read budget gate audit events for recent enforcement decisions."
  },
  {
    name: "burnbar_set_budget_limit",
    scope: "WRITE · daemon",
    cost: "standard",
    desc: "Set or update a daemon-backed budget limit."
  },
  {
    name: "burnbar_pause_budget_gate",
    scope: "WRITE · daemon",
    cost: "standard",
    desc: "Pause one budget gate until a specific ISO timestamp."
  },
  {
    name: "burnbar_resume_budget_gate",
    scope: "WRITE · daemon",
    cost: "standard",
    desc: "Resume a previously paused budget gate."
  },
  {
    name: "burnbar_org_spend",
    scope: "read",
    cost: "standard",
    desc: "Aggregate organization spend and usage over a bounded window."
  },
  {
    name: "burnbar_list_resumable_conversations",
    scope: "read",
    cost: "metadata",
    desc: "Return recent conversations eligible for native or ported resume."
  },
  {
    name: "burnbar_resume_conversation",
    scope: "read",
    cost: "body",
    desc: "Compose a native command hint or deterministic cross-harness briefing."
  },
  {
    name: "burnbar_spawn_resume",
    scope: "process · opt-in",
    cost: "body",
    desc: "Spawn the selected native or ported resume command after an explicit tool call."
  }
];

/* ------------------------------------------------------------------
   Install snippets — keyed by client tab.
   Source: docs/REMOTE_MCP_CLIENT_SETUP.md +
   tools/openburnbar-mcp/README.md (verbatim).
------------------------------------------------------------------- */
type Snippet = { id: string; label: string; meta: string; lines: string[] };

const hostedSnippets: Snippet[] = [
  {
    id: "codex",
    label: "Codex CLI",
    meta: "~/.codex/config.toml — stdio shim, recommended",
    lines: [
      "$ codex mcp add openburnbar -- openburnbar-mcp-remote mcp serve",
      "# or paste this block into ~/.codex/config.toml",
      "",
      "[mcp_servers.openburnbar]",
      'command = "openburnbar-mcp-remote"',
      'args = ["mcp", "serve"]',
      "startup_timeout_sec = 15",
      "tool_timeout_sec = 60"
    ]
  },
  {
    id: "claude-code",
    label: "Claude Code",
    meta: "from the OpenBurnBar CLI installer",
    lines: [
      "$ openburnbar mcp install claude",
      "# emits deterministic JSON for `claude mcp add`",
      "$ claude mcp get openburnbar",
      "→ Status: connected · endpoint: https://mcp.burnbar.ai/mcp"
    ]
  },
  {
    id: "claude-desktop",
    label: "Claude Desktop",
    meta: "~/Library/Application Support/Claude/claude_desktop_config.json",
    lines: [
      "{",
      '  "mcpServers": {',
      '    "openburnbar": {',
      '      "command": "openburnbar-mcp-remote",',
      '      "args": ["mcp", "serve"]',
      "    }",
      "  }",
      "}"
    ]
  },
  {
    id: "cursor",
    label: "Cursor",
    meta: "Cursor → Settings → MCP",
    lines: [
      "{",
      '  "mcpServers": {',
      '    "openburnbar": {',
      '      "command": "openburnbar-mcp-remote",',
      '      "args": ["mcp", "serve"]',
      "    }",
      "  }",
      "}"
    ]
  },
  {
    id: "droid",
    label: "Droid / Factory",
    meta: "real Factory droid binary",
    lines: [
      "$ openburnbar mcp install droid",
      "$ droid mcp add < ./openburnbar.droid.json",
      "$ droid mcp list",
      "→ openburnbar · 8 tools · https://mcp.burnbar.ai/mcp"
    ]
  },
  {
    id: "kimi",
    label: "Kimi CLI",
    meta: "kimi mcp add / test",
    lines: [
      "$ openburnbar mcp install kimi",
      "$ kimi mcp test openburnbar",
      "→ connected · tools: 8"
    ]
  },
  {
    id: "forge",
    label: "Forge",
    meta: "forge mcp import",
    lines: [
      "$ openburnbar mcp install forge > openburnbar.forge.json",
      "$ forge mcp import openburnbar.forge.json",
      "$ forge mcp list",
      "→ openburnbar · 8 tools"
    ]
  },
  {
    id: "generic",
    label: "Generic / direct HTTP",
    meta: "any client that speaks 2025-11-25 Streamable HTTP",
    lines: [
      "POST https://mcp.burnbar.ai/mcp",
      "authorization: Bearer $OPENBURNBAR_MCP_ACCESS_TOKEN",
      "content-type:  application/json",
      "",
      '{ "jsonrpc": "2.0", "id": 1, "method": "tools/list" }'
    ]
  }
];

const localSnippets: Snippet[] = [
  {
    id: "install",
    label: "Install",
    meta: "tools/openburnbar-mcp — one shell command",
    lines: [
      "$ git clone https://github.com/Imagine-That-Ai/BurnBar",
      "$ cd BurnBar/tools/openburnbar-mcp",
      "$ ./setup.sh",
      "→ creates venv, installs mcp + cryptography,",
      "  symlinks the burnbar-operator skill into ~/.hermes/"
    ]
  },
  {
    id: "cursor",
    label: "Cursor",
    meta: "Cursor → Settings → MCP (absolute paths)",
    lines: [
      "{",
      '  "mcpServers": {',
      '    "openburnbar-local": {',
      '      "command": "/abs/path/.venv/bin/python",',
      '      "args":    ["/abs/path/server.py"]',
      "    }",
      "  }",
      "}"
    ]
  },
  {
    id: "claude-desktop",
    label: "Claude Desktop",
    meta: "~/Library/Application Support/Claude/claude_desktop_config.json",
    lines: [
      "{",
      '  "mcpServers": {',
      '    "openburnbar-local": {',
      '      "command": "/abs/path/.venv/bin/python",',
      '      "args":    ["/abs/path/server.py"]',
      "    }",
      "  }",
      "}"
    ]
  },
  {
    id: "hermes",
    label: "Hermes",
    meta: "~/.hermes/config.yaml",
    lines: [
      "mcp_servers:",
      "  openburnbar_local:",
      '    command: "/abs/path/.venv/bin/python"',
      '    args: ["/abs/path/server.py"]',
      "    timeout: 30",
      "    connect_timeout: 20"
    ]
  }
];

/* ------------------------------------------------------------------
   SLO scoreboard — pulled from
   docs/plans/HOSTED_REMOTE_MCP_COMPLETION_AUDIT.md (live numbers).
------------------------------------------------------------------- */
const slo = [
  { value: "263", unit: "ms", label: "search · p50" },
  { value: "535", unit: "ms", label: "search · p95" },
  { value: "286", unit: "ms", label: "body · p50" },
  { value: "412", unit: "ms", label: "body · p95" },
  { value: "0", unit: "reads", label: "storage during search" },
  { value: "6", unit: "policies", label: "monitoring · alerting" }
];
---

<BaseLayout
  title="MCP integration — speak the protocol your agents already speak"
  description="OpenBurnBar's three Model Context Protocol surfaces: a free local Python server over your SQLite, the hosted Remote MCP at mcp.burnbar.ai gated by BurnBar Pro, and a local stdio shim that bridges + decrypts. Live since 2026-05-15."
>
  {/* ────────────────────────── 1 · HERO ────────────────────────── */}
  <section class="mcp-hero" aria-labelledby="mcp-hero-h">
    <div class="container container--wide mcp-hero__inner">
      <span class="eyebrow eyebrow--ember">MCP integration · protocol-native</span>
      <h1 id="mcp-hero-h" class="mcp-hero__h">
        Codex forgets.<br />
        Claude forgets.
        <span class="mcp-hero__h--ember">Your history doesn't.</span>
      </h1>

      <p class="lead mcp-hero__lead">
        Thirty-four unique MCP tools point any agent that speaks the protocol — Codex, Claude Code,
        Cursor, Droid, Kimi, Forge, Hermes — at your full OpenBurnBar record. Free locally over
        SQLite. Encrypted in the cloud for Pro. Never plaintext on the server.
      </p>

      {/* signal-flow diagram — three sources converge into ANY CLIENT */}
      <figure
        class="signalmap"
        role="img"
        aria-label="Three OpenBurnBar MCP channels — local SQLite, hosted encrypted memory, and the local stdio shim — converging into any MCP-capable client"
      >
        <svg viewBox="0 0 920 320" class="signalmap__svg" aria-hidden="true">
          <defs>
            <linearGradient id="sigEmber" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0%" stop-color="#ee1803" stop-opacity="0.0"></stop>
              <stop offset="40%" stop-color="#fa6b06" stop-opacity="0.85"></stop>
              <stop offset="100%" stop-color="#fdc42c" stop-opacity="0.95"></stop>
            </linearGradient>
            <linearGradient id="sigMerc" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0%" stop-color="#8080ff" stop-opacity="0.0"></stop>
              <stop offset="50%" stop-color="#8080ff" stop-opacity="0.7"></stop>
              <stop offset="100%" stop-color="#ffffff" stop-opacity="0.95"></stop>
            </linearGradient>
            <radialGradient id="sigNode" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="#fdc42c" stop-opacity="0.95"></stop>
              <stop offset="55%" stop-color="#fa6b06" stop-opacity="0.55"></stop>
              <stop offset="100%" stop-color="#fa6b06" stop-opacity="0.0"></stop>
            </radialGradient>
            <radialGradient id="sigNodeMerc" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="#e8e8ff" stop-opacity="0.95"></stop>
              <stop offset="55%" stop-color="#8080ff" stop-opacity="0.45"></stop>
              <stop offset="100%" stop-color="#8080ff" stop-opacity="0.0"></stop>
            </radialGradient>
          </defs>

          {/* horizontal grid lines for the radar feel */}
          <g stroke="rgba(255,255,255,0.045)" stroke-width="1">
            <line x1="40" y1="60" x2="880" y2="60"></line>
            <line x1="40" y1="160" x2="880" y2="160"></line>
            <line x1="40" y1="260" x2="880" y2="260"></line>
          </g>

          {/* three source labels (left) */}
          <g
            class="signalmap__label"
            font-family="JetBrains Mono Variable, monospace"
            font-size="11"
            fill="rgba(255,255,255,0.6)"
          >
            <text x="64" y="56">01 · LOCAL · SQLite</text>
            <text x="64" y="156">02 · HOSTED · mcp.burnbar.ai</text>
            <text x="64" y="256">03 · BRIDGE · stdio shim</text>
          </g>

          {/* source nodes (left) */}
          <g>
            <circle cx="64" cy="80" r="22" fill="url(#sigNode)"></circle>
            <circle cx="64" cy="80" r="5" fill="#fdc42c"></circle>
            <circle cx="64" cy="180" r="22" fill="url(#sigNodeMerc)"></circle>
            <circle cx="64" cy="180" r="5" fill="#e8e8ff"></circle>
            <circle cx="64" cy="280" r="22" fill="url(#sigNode)"></circle>
            <circle cx="64" cy="280" r="5" fill="#fa6b06"></circle>
          </g>

          {/* bezier channels */}
          <path
            d="M 86,80  C 280,80,  500,200, 760,160"
            fill="none"
            stroke="url(#sigEmber)"
            stroke-width="1.5"
            class="signalmap__path signalmap__path--a"></path>
          <path
            d="M 86,180 C 280,180, 500,160, 760,160"
            fill="none"
            stroke="url(#sigMerc)"
            stroke-width="1.5"
            class="signalmap__path signalmap__path--b"></path>
          <path
            d="M 86,280 C 280,280, 500,120, 760,160"
            fill="none"
            stroke="url(#sigEmber)"
            stroke-width="1.5"
            class="signalmap__path signalmap__path--c"></path>

          {/* travelling packets (CSS animated dashes) */}
          <path
            d="M 86,80  C 280,80,  500,200, 760,160"
            fill="none"
            stroke="#fdc42c"
            stroke-width="2"
            class="signalmap__packet signalmap__packet--a"></path>
          <path
            d="M 86,180 C 280,180, 500,160, 760,160"
            fill="none"
            stroke="#e8e8ff"
            stroke-width="2"
            class="signalmap__packet signalmap__packet--b"></path>
          <path
            d="M 86,280 C 280,280, 500,120, 760,160"
            fill="none"
            stroke="#fa6b06"
            stroke-width="2"
            class="signalmap__packet signalmap__packet--c"></path>

          {/* convergence node (right) — ANY CLIENT */}
          <g>
            <circle cx="780" cy="160" r="42" fill="url(#sigNode)" opacity="0.55"></circle>
            <circle cx="780" cy="160" r="18" fill="#ee1803" opacity="0.9"></circle>
            <circle cx="780" cy="160" r="6" fill="#fdc42c"></circle>
          </g>

          {/* convergence bracket frame */}
          <g stroke="#fa6b06" stroke-width="1.25" fill="none" opacity="0.85">
            <path d="M 740,108 L 740,118 L 750,118"></path>
            <path d="M 820,108 L 820,118 L 810,118"></path>
            <path d="M 740,212 L 740,202 L 750,202"></path>
            <path d="M 820,212 L 820,202 L 810,202"></path>
          </g>

          <g
            font-family="Outfit, sans-serif"
            font-size="13"
            font-weight="600"
            fill="#ffffff"
            text-anchor="middle"
          >
            <text x="780" y="232">ANY MCP CLIENT</text>
          </g>
          <g
            font-family="JetBrains Mono Variable, monospace"
            font-size="10"
            fill="rgba(255,255,255,0.55)"
            text-anchor="middle"
          >
            <text x="780" y="248">codex · claude · cursor · droid · kimi · forge · hermes</text>
          </g>
        </svg>

        <figcaption class="signalmap__cap mono">
          three channels · one protocol · zero plaintext on the server
        </figcaption>
      </figure>

      {/* the endpoint plate — a tactile, stamped object */}
      <div class="endplate" data-status="live">
        <div class="endplate__row">
          <span class="endplate__band mono">ENDPOINT · MCP/STREAMABLE-HTTP · 2025-11-25</span>
          <span class="endplate__pill mono"><span class="endplate__dot"></span> LIVE</span>
        </div>
        <div class="endplate__addr mono">https://mcp.burnbar.ai/mcp</div>
        <div class="endplate__row endplate__row--foot">
          <span class="mono endplate__meta"
            >audience-bound · HMAC bearer · burnbar_pro entitlement</span
          >
          <span class="mono endplate__meta">since 2026-05-15</span>
        </div>
      </div>

      <div class="mcp-hero__ctas">
        <a class="btn btn--ember" href="#install"
          >See install snippets <span class="btn-arrow" aria-hidden="true">→</span></a
        >
        <a
          class="btn btn--ghost"
          href={`${SITE.github}/blob/main/docs/HOSTED_REMOTE_MCP.md`}
          target="_blank"
          rel="noopener noreferrer">Read the architecture doc</a
        >
        <a
          class="btn btn--ghost"
          href={`${SITE.github}/blob/main/docs/REMOTE_MCP_THREAT_MODEL.md`}
          target="_blank"
          rel="noopener noreferrer">Threat model</a
        >
      </div>
    </div>
  </section>

  {/* ────────────────────────── 2 · THREE CHANNELS ────────────────────────── */}
  <section class="channels" aria-labelledby="channels-h">
    <div class="container container--wide">
      <header class="sec-head">
        <span class="eyebrow eyebrow--ember">Three channels</span>
        <h2 id="channels-h">Same tools. Three install paths. Pick the one your client speaks.</h2>
        <p class="lead">
          The local stdio server is free and reads your SQLite directly. The hosted Remote MCP is a
          BurnBar Pro feature with encrypted, multi-device session memory. The stdio shim closes the
          gap for clients that don't yet speak Streamable HTTP — and is the only path that decrypts
          hosted bodies on-device.
        </p>
      </header>

      <ol class="channels__grid">
        {
          channels.map((c) => (
            <li class={`channel channel--${c.accent}`}>
              <div class="channel__head">
                <span class="channel__sigil mono">{c.sigil}</span>
                <span class="channel__band mono">{c.band}</span>
              </div>
              <h3 class="channel__name">{c.name}</h3>
              <dl class="channel__spec mono">
                <div>
                  <>
                    <dt>runtime</dt>
                    <dd>{c.runtime}</dd>
                  </>
                </div>
                <div>
                  <>
                    <dt>transport</dt>
                    <dd>{c.transport}</dd>
                  </>
                </div>
                <div>
                  <>
                    <dt>auth</dt>
                    <dd>{c.auth}</dd>
                  </>
                </div>
                <div>
                  <>
                    <dt>audience</dt>
                    <dd>{c.audience}</dd>
                  </>
                </div>
