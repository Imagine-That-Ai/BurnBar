---
import BaseLayout from "@layouts/BaseLayout.astro";
import { SITE } from "@data/site";

const paidTiers = SITE.pricing.tiers.filter((tier) => tier.id !== "free");
const subscriptionCatalog = Object.fromEntries(
  paidTiers.map((tier) => [
    tier.id,
    {
      id: tier.id,
      name: tier.name,
      shortName: tier.shortName,
      monthly: tier.priceMonthlyUSD,
      annual: tier.priceAnnualUSD,
      summary: tier.summary
    }
  ])
);
---

<BaseLayout
  title="Subscribe"
  description="Sign in and start a BurnBar Cloud, Cloud Pro, or Ultra subscription through secure Stripe Checkout."
  noindex
  transactional
>
  <main
    class="subscribe"
    id="subscribe-root"
    data-catalog={JSON.stringify(subscriptionCatalog)}
    aria-live="polite"
  >
    <div class="subscribe__glow" aria-hidden="true"></div>
    <div class="subscribe__shell">
      <header class="subscribe__heading">
        <a class="subscribe__back mono" href="/pricing">← Compare plans</a>
        <span class="eyebrow eyebrow--ember">BurnBar Cloud</span>
        <h1>Finish your subscription.</h1>
        <p>
          Sign in with the BurnBar account you use in the apps. Stripe handles payment; BurnBar
          binds the verified subscription to that Firebase account.
        </p>
      </header>

      <section class="checkout-panel">
        <div class="plan-summary">
          <div class="plan-summary__copy">
            <span class="plan-summary__label mono">Selected plan</span>
            <h2 id="plan-name">BurnBar Cloud</h2>
            <p id="plan-summary">Sync your quota, encrypted history, and agent memory.</p>
          </div>
          <div class="plan-summary__price">
            <strong id="plan-price">$7.99</strong>
            <span id="plan-period">per month</span>
          </div>
        </div>

        <div class="cadence" role="group" aria-label="Billing cadence">
          <button
            class="cadence__option is-active"
            id="cadence-monthly"
            type="button"
            data-cadence="monthly"
            aria-pressed="true">Monthly</button
          >
          <button
            class="cadence__option"
            id="cadence-annual"
            type="button"
            data-cadence="annual"
            aria-pressed="false">Annual</button
          >
        </div>

        <div class="checkout-divider" aria-hidden="true"></div>

        <div id="state-checking" class="checkout-state">
          <div class="spinner" aria-hidden="true"></div>
          <p>Checking your BurnBar account…</p>
        </div>

        <div id="state-signed-out" class="checkout-state hidden">
          <div class="checkout-state__copy">
            <h2>Sign in before checkout</h2>
            <p>Your Firebase UID is the durable link between web billing and every BurnBar app.</p>
          </div>
          <div class="provider-actions">
            <button
              id="btn-google"
              class="btn provider-button provider-button--google"
              type="button"
            >
              <svg class="provider-button__icon" viewBox="0 0 24 24" aria-hidden="true">
                <path
                  fill="#4285F4"
                  d="M23.49 12.27c0-.82-.07-1.42-.22-2.04H12v3.95h6.62c-.13.98-.85 2.46-2.45 3.45l-.02.13 3.56 2.45.25.02c2.29-2.11 3.53-5.22 3.53-7.96Z"
                ></path>
                <path
                  fill="#34A853"
                  d="M12 24c3.28 0 6.03-1.08 8.04-2.94l-3.83-2.96c-1.03.72-2.41 1.22-4.21 1.22a7.32 7.32 0 0 1-6.93-5.06l-.13.01-3.7 2.87-.05.13A12 12 0 0 0 12 24Z"
                ></path>
                <path
                  fill="#FBBC05"
                  d="M5.07 14.26A7.4 7.4 0 0 1 4.67 12c0-.79.14-1.55.39-2.26l-.01-.14-3.75-2.9-.12.06A11.98 11.98 0 0 0 0 12c0 1.88.45 3.66 1.23 5.24l3.84-2.98Z"
                ></path>
                <path
                  fill="#EA4335"
                  d="M12 4.68c2.28 0 3.82.99 4.7 1.81l3.43-3.35A11.7 11.7 0 0 0 12 0 12 12 0 0 0 1.2 6.76l3.86 2.98A7.32 7.32 0 0 1 12 4.68Z"
                ></path>
              </svg>
              <span>Continue with Google</span>
            </button>
            <button id="btn-apple" class="btn provider-button provider-button--apple" type="button">
              <svg class="provider-button__icon" viewBox="0 0 24 24" aria-hidden="true">
                <path
                  fill="currentColor"
                  d="M16.78 12.9c-.03-3.04 2.49-4.5 2.6-4.57-1.41-2.06-3.6-2.34-4.38-2.37-1.87-.19-3.64 1.1-4.58 1.1-.95 0-2.42-1.07-3.97-1.04-2.05.03-3.94 1.19-4.99 3.02-2.13 3.69-.55 9.16 1.53 12.15 1.01 1.46 2.22 3.1 3.81 3.04 1.53-.06 2.11-.99 3.96-.99s2.37.99 3.99.96c1.65-.03 2.69-1.49 3.7-2.96 1.16-1.69 1.64-3.33 1.67-3.41-.04-.02-3.2-1.23-3.24-4.93Zm-3-8.91c.84-1.02 1.41-2.43 1.25-3.84-1.21.05-2.67.8-3.54 1.82-.78.9-1.46 2.34-1.28 3.72 1.35.1 2.73-.69 3.57-1.7Z"
                ></path>
              </svg>
              <span>Continue with Apple</span>
            </button>
          </div>
        </div>

        <div id="state-ready" class="checkout-state hidden">
          <div class="account-row">
            <img id="user-avatar" class="avatar hidden" src="" alt="" />
            <div class="account-row__copy">
              <span class="account-row__label mono">BurnBar account</span>
              <strong id="user-email">Signed in</strong>
            </div>
            <button id="btn-signout" class="text-button" type="button">Change</button>
          </div>
          <button id="btn-checkout" class="btn btn--ember checkout-button" type="button">
            Continue to secure checkout <span aria-hidden="true">→</span>
          </button>
          <button id="btn-portal" class="text-button" type="button">
            Already subscribed? Manage billing
          </button>
        </div>

        <div id="state-loading" class="checkout-state hidden">
          <div class="spinner" aria-hidden="true"></div>
          <h2>Opening secure checkout…</h2>
          <p>Keep this tab open while Stripe prepares your subscription.</p>
        </div>

        <div id="state-success" class="checkout-state hidden">
          <div class="status-mark status-mark--success" aria-hidden="true">✓</div>
          <h2>Checkout completed</h2>
          <p>
            BurnBar is confirming the payment and updating your entitlement. Signed-in apps refresh
            automatically after webhook reconciliation.
          </p>
          <div class="state-actions">
            <a class="btn btn--ember" href="/download">Open the apps</a>
            <button class="btn btn--ghost" id="btn-success-portal" type="button">
              Manage billing
            </button>
          </div>
        </div>

        <div id="state-cancelled" class="checkout-state hidden">
          <div class="status-mark" aria-hidden="true">↩</div>
          <h2>Checkout cancelled</h2>
          <p>Nothing was charged. Your selected plan is still here when you are ready.</p>
          <button class="btn btn--ember" id="btn-cancelled-retry" type="button">
            Return to checkout
          </button>
        </div>

        <div id="state-error" class="checkout-state hidden">
          <div class="status-mark status-mark--error" aria-hidden="true">!</div>
          <h2 id="error-title">Checkout could not start</h2>
          <p id="error-message">
            Please try again. If the problem continues, contact support@burnbar.ai.
          </p>
          <div class="state-actions">
            <button class="btn btn--ember" id="btn-retry" type="button">Try again</button>
            <button class="btn btn--ghost hidden" id="btn-error-portal" type="button">
              Manage billing
            </button>
          </div>
        </div>

        <footer class="checkout-trust">
          <span>Payment by Stripe</span>
          <span>Firebase Auth + App Check</span>
          <span>Cancel from your billing portal</span>
        </footer>
      </section>

      <p class="subscribe__support">
        Need help before buying? <a href={`mailto:${SITE.supportContact}`}>{SITE.supportContact}</a>
      </p>
    </div>
  </main>
</BaseLayout>

<style>
  .subscribe {
    position: relative;
    min-height: min(860px, calc(100svh - 72px));
    display: grid;
    place-items: center;
    overflow: hidden;
    padding: clamp(2.5rem, 8vw, 6rem) var(--gutter);
  }

  .subscribe__glow {
    position: absolute;
    inset: 8% 12% auto;
    height: 32rem;
    pointer-events: none;
    background:
      radial-gradient(circle at 32% 30%, rgba(250, 107, 6, 0.17), transparent 40%),
      radial-gradient(circle at 70% 50%, rgba(60, 214, 192, 0.08), transparent 44%);
    filter: blur(30px);
    animation: subscribeGlow 7s ease-in-out infinite alternate;
  }

  .subscribe__shell {
    position: relative;
    width: min(100%, 720px);
    display: grid;
    gap: 1.5rem;
  }

  .subscribe__heading {
    display: grid;
    justify-items: center;
    gap: 0.7rem;
    text-align: center;
  }

  .subscribe__back {
    justify-self: start;
    color: var(--text-mute);
    font-size: 0.78rem;
    text-decoration: none;
  }

  .subscribe__back:hover {
    color: var(--text-bright);
  }

  .subscribe__heading h1 {
    margin: 0;
    color: var(--text-bright);
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 7vw, 4.8rem);
    font-weight: var(--wght-semibold);
    --opsz: var(--opsz-display);
    line-height: 0.96;
    letter-spacing: -0.04em;
  }

  .subscribe__heading p {
    max-width: 58ch;
    margin: 0;
    color: var(--text-base);
    line-height: 1.55;
  }

  .checkout-panel {
    --checkout-text-bright: #fffaf5;
    --checkout-text-base: #e8e0d8;
    --checkout-text-mute: #bdb4ab;
    --checkout-text-dim: #a49a91;
    --checkout-line: rgba(255, 255, 255, 0.13);
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.25rem, 5vw, 2.25rem);
    border: 1px solid rgba(255, 255, 255, 0.11);
    border-top-color: rgba(255, 255, 255, 0.2);
    border-radius: var(--r-4);
    background:
      radial-gradient(90% 60% at 50% 0%, rgba(250, 107, 6, 0.1), transparent 70%),
      rgba(9, 9, 14, 0.86);
    box-shadow:
      0 32px 100px rgba(0, 0, 0, 0.46),
      0 0 44px rgba(250, 107, 6, 0.07);
    color: var(--checkout-text-base);
    color-scheme: dark;
    backdrop-filter: blur(30px) saturate(150%);
    -webkit-backdrop-filter: blur(30px) saturate(150%);
  }

  .plan-summary {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .plan-summary__copy {
    display: grid;
    gap: 0.45rem;
  }

  .plan-summary__label,
  .account-row__label {
    color: var(--checkout-text-dim);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .plan-summary h2,
  .checkout-state h2 {
    margin: 0;
    color: var(--checkout-text-bright);
    font-family: var(--font-display);
    font-size: 1.5rem;
    letter-spacing: -0.02em;
    --opsz: var(--opsz-h3);
  }

  .plan-summary p,
  .checkout-state p {
    margin: 0;
    color: var(--checkout-text-mute);
    line-height: 1.5;
  }

  .plan-summary__price {
    flex: 0 0 auto;
    display: grid;
    justify-items: end;
    gap: 0.2rem;
    text-align: right;
  }

  .plan-summary__price strong {
    color: var(--checkout-text-bright);
    font-family: var(--font-display);
    font-size: clamp(2rem, 8vw, 3rem);
    font-weight: var(--wght-semibold);
    --opsz: var(--opsz-h2);
    line-height: 1;
  }

  .plan-summary__price span {
    color: var(--checkout-text-dim);
    font-size: 0.82rem;
  }

  .cadence {
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding: 4px;
    border: 1px solid var(--checkout-line);
    border-radius: var(--r-pill);
    background: rgba(0, 0, 0, 0.24);
  }

  .cadence__option {
    min-height: 42px;
    border-radius: var(--r-pill);
    color: var(--checkout-text-mute);
    font-weight: var(--wght-bold);
    transition:
      color var(--dur-base) var(--ease),
      background var(--dur-base) var(--ease),
      box-shadow var(--dur-base) var(--ease);
  }

  .cadence__option.is-active {
    color: #140a04;
    background: linear-gradient(135deg, var(--core-amber), var(--core-fire));
    box-shadow: 0 8px 24px -10px rgba(250, 107, 6, 0.8);
  }

  .checkout-divider {
    height: 1px;
    background: var(--checkout-line);
  }

  .checkout-state {
    min-height: 176px;
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 1rem;
    text-align: center;
    animation: stateEnter 260ms var(--ease) both;
  }

  .checkout-state.hidden,
  .hidden {
    display: none;
  }

  .checkout-state__copy {
    display: grid;
    gap: 0.45rem;
  }

  .provider-actions {
    width: min(100%, 360px);
    display: grid;
    gap: 0.75rem;
  }

  .provider-button {
    min-height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: var(--checkout-text-bright);
    background: rgba(255, 255, 255, 0.055);
  }

  .provider-button:hover {
    border-color: rgba(255, 255, 255, 0.28);
    background: rgba(255, 255, 255, 0.09);
  }

  .provider-button__icon {
    width: 20px;
    height: 20px;
    flex: 0 0 auto;
  }

  .account-row {
    width: 100%;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.8rem;
    padding: 0.8rem;
    border-bottom: 1px solid var(--checkout-line);
    text-align: left;
  }

  .account-row__copy {
    min-width: 0;
    display: grid;
    gap: 0.15rem;
  }

  .account-row strong {
    overflow: hidden;
    color: var(--checkout-text-bright);
    font-size: 0.92rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
  }

  .text-button {
    color: var(--checkout-text-mute);
    font-size: 0.84rem;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
  }

  .text-button:hover {
    color: var(--checkout-text-bright);
    text-decoration-color: currentColor;
  }

  .checkout-button {
    width: min(100%, 420px);
    min-height: 52px;
  }

  .state-actions {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .status-mark {
    width: 52px;
    height: 52px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(250, 107, 6, 0.5);
    border-radius: 50%;
    color: var(--core-amber);
    background: rgba(250, 107, 6, 0.1);
    font-weight: var(--wght-black);
  }

  .status-mark--success {
    color: var(--status-exact);
    border-color: rgba(60, 214, 192, 0.5);
    background: rgba(60, 214, 192, 0.1);
  }

  .status-mark--error {
    color: var(--core-red);
    border-color: rgba(238, 24, 3, 0.5);
    background: rgba(238, 24, 3, 0.1);
  }

  .spinner {
    width: 30px;
    height: 30px;
    border: 2px solid rgba(255, 255, 255, 0.14);
    border-top-color: var(--core-fire);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  .checkout-trust {
    display: flex;
    justify-content: center;
    gap: 0.5rem 1rem;
    flex-wrap: wrap;
    padding-top: 1rem;
    border-top: 1px solid var(--checkout-line);
    color: var(--checkout-text-dim);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .checkout-trust span {
    position: relative;
  }

  .checkout-trust span:not(:last-child)::after {
    content: "·";
    position: absolute;
    right: -0.62rem;
  }

  .subscribe__support {
    margin: 0;
    color: var(--text-dim);
    font-size: 0.82rem;
    text-align: center;
  }

  .subscribe__support a {
    color: var(--text-base);
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes stateEnter {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes subscribeGlow {
    from {
      transform: translate3d(-2%, -1%, 0) scale(0.98);
      opacity: 0.75;
    }
    to {
      transform: translate3d(2%, 2%, 0) scale(1.04);
      opacity: 1;
    }
  }

  @media (max-width: 620px) {
    .subscribe {
      place-items: start center;
      padding-top: 2rem;
    }

    .plan-summary {
      display: grid;
    }

    .plan-summary__price {
      justify-items: start;
      text-align: left;
    }

    .account-row {
      grid-template-columns: auto minmax(0, 1fr) auto;
    }

    .checkout-trust {
      display: grid;
      justify-items: center;
    }

    .checkout-trust span::after {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .subscribe__glow,
    .checkout-state,
    .spinner {
      animation: none;
    }

    .cadence__option {
      transition: none;
    }
  }
</style>

<script>
  import {
    getRedirectResult,
    onAuthStateChanged,
    signInWithPopup,
    signInWithRedirect,
    signOut,
    type AuthProvider,
    type User
  } from "firebase/auth";
  import { httpsCallable } from "firebase/functions";
  import { auth, functions, googleProvider, appleProvider, appCheck } from "../lib/firebaseClient";

  type TierID = "cloud" | "cloud_pro" | "ultra";
  type Cadence = "monthly" | "annual";
  type CatalogTier = {
    id: TierID;
    name: string;
    shortName: string;
    monthly: string;
    annual: string;
    summary: string;
  };

  const root = document.querySelector<HTMLElement>("#subscribe-root");
  const catalog = JSON.parse(root?.dataset.catalog || "{}") as Record<TierID, CatalogTier>;
  const params = new URLSearchParams(window.location.search);
  const requestedTier = params.get("tier");
  const requestedCadence = params.get("cadence");
  let tier: TierID =
    requestedTier === "cloud_pro" || requestedTier === "ultra" ? requestedTier : "cloud";
  let cadence: Cadence = requestedCadence === "annual" ? "annual" : "monthly";
  let currentUser: User | null = null;
  let portalRecommended = false;

  const stateNames = [
    "checking",
    "signed-out",
    "ready",
    "loading",
    "success",
    "cancelled",
    "error"
  ];
  const planName = document.querySelector<HTMLElement>("#plan-name");
  const planSummary = document.querySelector<HTMLElement>("#plan-summary");
  const planPrice = document.querySelector<HTMLElement>("#plan-price");
  const planPeriod = document.querySelector<HTMLElement>("#plan-period");
  const userEmail = document.querySelector<HTMLElement>("#user-email");
  const userAvatar = document.querySelector<HTMLImageElement>("#user-avatar");
  const errorTitle = document.querySelector<HTMLElement>("#error-title");
  const errorMessage = document.querySelector<HTMLElement>("#error-message");
  const errorPortal = document.querySelector<HTMLButtonElement>("#btn-error-portal");
  const cadenceButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-cadence]"));

  function showState(name: string) {
    for (const stateName of stateNames) {
      document.querySelector(`#state-${stateName}`)?.classList.toggle("hidden", stateName !== name);
    }
  }

  function updateSelection(nextCadence: Cadence = cadence) {
    cadence = nextCadence;
    const selected = catalog[tier];
    if (!selected) return;
    if (planName) planName.textContent = selected.name;
    if (planSummary) planSummary.textContent = selected.summary;
    if (planPrice) {
      planPrice.textContent = `$${cadence === "annual" ? selected.annual : selected.monthly}`;
    }
    if (planPeriod) planPeriod.textContent = cadence === "annual" ? "per year" : "per month";
    for (const button of cadenceButtons) {
      const active = button.dataset.cadence === cadence;
      button.classList.toggle("is-active", active);
      button.setAttribute("aria-pressed", String(active));
    }
    const nextURL = new URL(window.location.href);
    nextURL.searchParams.set("tier", tier);
    nextURL.searchParams.set("cadence", cadence);
    nextURL.searchParams.delete("status");
    params.set("tier", tier);
    params.set("cadence", cadence);
    params.delete("status");
    window.history.replaceState({}, "", nextURL);
  }

  function returnURL(status: "success" | "cancelled") {
    const url = new URL("/subscribe", window.location.origin);
    url.searchParams.set("tier", tier);
    url.searchParams.set("cadence", cadence);
    url.searchParams.set("status", status);
    return url.toString();
  }

  function portalReturnURL() {
    const url = new URL("/subscribe", window.location.origin);
    url.searchParams.set("tier", tier);
    url.searchParams.set("cadence", cadence);
    return url.toString();
  }

  function callableError(error: unknown): { code: string; message: string } {
    const record = error as { code?: unknown; message?: unknown };
    return {
      code: String(record?.code || ""),
      message: String(record?.message || "")
    };
  }

  function setError(title: string, message: string, recommendPortal = false) {
    portalRecommended = recommendPortal;
    if (errorTitle) errorTitle.textContent = title;
    if (errorMessage) errorMessage.textContent = message;
    errorPortal?.classList.toggle("hidden", !recommendPortal);
    showState("error");
  }

  async function signIn(provider: AuthProvider) {
    showState("checking");
    try {
      await signInWithPopup(auth, provider);
    } catch (error: unknown) {
      const { code } = callableError(error);
      if (
        code.includes("popup-blocked") ||
        code.includes("operation-not-supported-in-this-environment")
      ) {
        await signInWithRedirect(auth, provider);
        return;
      }
      if (code.includes("popup-closed-by-user") || code.includes("cancelled-popup-request")) {
        showState("signed-out");
        return;
      }
      setError(
        "Sign-in failed",
        "BurnBar could not complete sign-in. Check popup blocking, then try again."
      );
    }
  }

  async function openPortal() {
    if (!currentUser) {
      showState("signed-out");
      return;
    }
    try {
      showState("loading");
      const createPortal = httpsCallable<{ returnUrl: string }, { url?: string }>(
        functions,
        "createStripeBurnBarProPortalSession"
      );
      const result = await createPortal({ returnUrl: portalReturnURL() });
      const url = result.data.url;
      if (!url || new URL(url).protocol !== "https:") {
        throw new Error("Billing portal returned an invalid URL.");
      }
      window.location.assign(url);
    } catch (error: unknown) {
      const { code } = callableError(error);
      setError(
        "Billing portal unavailable",
        code.includes("not-found")
          ? "No Stripe billing profile exists for this account yet."
          : "BurnBar could not open the billing portal. Please try again or contact support."
      );
    }
  }

  async function startCheckout() {
    if (!currentUser) {
      showState("signed-out");
      return;
    }
    try {
      showState("loading");
      const createCheckout = httpsCallable<
        {
          successUrl: string;
          cancelUrl: string;
          tier: TierID;
          cadence: Cadence;
        },
        { url?: string }
      >(functions, "createStripeBurnBarProCheckoutSession");
      const result = await createCheckout({
        successUrl: returnURL("success"),
        cancelUrl: returnURL("cancelled"),
        tier,
        cadence
      });
      const url = result.data.url;
      if (!url || new URL(url).protocol !== "https:") {
        throw new Error("Checkout returned an invalid URL.");
      }
      window.location.assign(url);
    } catch (error: unknown) {
      const { code, message } = callableError(error);
      if (code.includes("already-exists")) {
        setError(
          "You already have a Stripe subscription",
          "Open the billing portal to change, cancel, or review your existing plan.",
          true
        );
        return;
      }
      if (code.includes("failed-precondition")) {
        setError(
          "This plan is not available on the web yet",
          "The selected Stripe price is not configured. Choose another plan or contact support."
        );
        return;
      }
      setError(
        "Checkout could not start",
        message || "Please try again. If the problem continues, contact support@burnbar.ai."
      );
    }
  }

  function showAuthenticatedState(user: User) {
    currentUser = user;
    if (userEmail) userEmail.textContent = user.email || user.displayName || "Signed-in account";
    if (userAvatar) {
      if (user.photoURL) {
        userAvatar.src = user.photoURL;
        userAvatar.alt = "";
        userAvatar.classList.remove("hidden");
      } else {
        userAvatar.classList.add("hidden");
      }
    }
    const status = params.get("status");
    if (status === "success") {
      showState("success");
    } else if (status === "cancelled") {
      showState("cancelled");
    } else {
      showState("ready");
    }
  }

  for (const button of cadenceButtons) {
    button.addEventListener("click", () => {
      updateSelection(button.dataset.cadence === "annual" ? "annual" : "monthly");
    });
  }

  document.querySelector("#btn-google")?.addEventListener("click", () => signIn(googleProvider));
  document.querySelector("#btn-apple")?.addEventListener("click", () => signIn(appleProvider));
  document.querySelector("#btn-checkout")?.addEventListener("click", startCheckout);
  document.querySelector("#btn-portal")?.addEventListener("click", openPortal);
  document.querySelector("#btn-success-portal")?.addEventListener("click", openPortal);
  document.querySelector("#btn-error-portal")?.addEventListener("click", openPortal);
  document.querySelector("#btn-retry")?.addEventListener("click", () => {
    if (portalRecommended) {
      showState(currentUser ? "ready" : "signed-out");
    } else {
      void startCheckout();
    }
  });
  document.querySelector("#btn-cancelled-retry")?.addEventListener("click", () => {
    showState(currentUser ? "ready" : "signed-out");
  });
  document.querySelector("#btn-signout")?.addEventListener("click", async () => {
    showState("checking");
    await signOut(auth);
  });

  updateSelection();
  void appCheck;
  void getRedirectResult(auth).catch(() => undefined);
  onAuthStateChanged(auth, (user) => {
    currentUser = user;
    if (user) {
      showAuthenticatedState(user);
    } else {
      showState("signed-out");
    }
  });
</script>
