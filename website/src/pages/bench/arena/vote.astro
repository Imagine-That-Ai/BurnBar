---
import BaseLayout from "@layouts/BaseLayout.astro";
import "@styles/bench.css";
import "@styles/arena-variants.css";
import "@styles/arena-variant-neural.css";
---

<BaseLayout
  title="BurnBench Arena — cast a blind vote"
  description="Vote on a blind BurnBench Arena matchup: two anonymized experiential artifacts side by side, identities revealed only after you vote."
>
  {/* Neural Split is the sole Arena skin. Set BEFORE paint so it never
      flashes. bench-arena.ts reports exposure, plays and votes with the
      variant attached. */}
  <script slot="head" is:inline>
    (function () {
      try {
        document.documentElement.setAttribute("data-arena-variant", "neural");
      } catch {}
    })();
  </script>
  <section class="bb-hero bb-arena-hero" aria-labelledby="vote-hero-h">
    <div class="container container--wide bb-hero__inner">
      <nav class="bb-bread mono" aria-label="Breadcrumbs">
        <a href="/bench">BurnBench</a>
        <span aria-hidden="true">→</span>
        <a href="/bench/arena">Arena</a>
        <span aria-hidden="true">→</span>
        <span>Vote</span>
      </nav>
      <p class="bb-arena-hero__kicker mono">[ burnbench · arena · blind pairwise ]</p>
      <h1 id="vote-hero-h" class="bb-arena-hero__title">
        <span class="bb-arena-hero__l1">Which one</span>
        <span class="bb-arena-hero__l2"><em>shipped it</em></span>
        <span class="bb-arena-hero__l3">better?</span>
      </h1>
      <p class="bb-arena-hero__lead mono">
        &gt; two agents · same brief · anonymized · order randomized<span
          class="bb-arena-hero__cursor"
          aria-hidden="true">▌</span>
      </p>
      <p class="bb-arena-hero__sub">
        No logos until you decide — only after you vote do we reveal which harness × model built
        which.
      </p>
    </div>
  </section>

  <section class="bb-section bb-arena" aria-labelledby="ballot-h">
    {/* Neural-variant particle field (decorative; CSS shows it only under
        [data-arena-variant="neural"], JS animates it only for that variant). */}
    <canvas id="arena-net" class="bb-arena__net" aria-hidden="true"></canvas>
    <div class="container container--wide">
      <h2 id="ballot-h" class="bb-sec-h" style="position:absolute;left:-9999px">The ballot</h2>
      <p id="arena-status" class="bb-arena__status mono" role="status" aria-live="polite">
        Dealing a blind matchup…
      </p>

      <div id="arena-auth-chip" class="bb-arena__authchip mono" hidden></div>
      <button id="arena-signout" class="bb-arena__signout mono" type="button" hidden>sign out</button>

      <div id="arena-brief" class="bb-arena__brief glass-pane" hidden>
        <span class="bb-arena__brief-eyebrow mono">// mission brief — identical prompt, both cells</span>
        <h2 id="brief-title" class="bb-arena__brief-title"></h2>
        <p id="brief-text" class="bb-arena__brief-text"></p>
        <p class="bb-arena__judge mono"><span>Judge on</span> <span id="brief-judge"></span></p>
      </div>

      <div class="bb-arena__frames bb-versus">
        <figure class="bb-arena__pane bb-arena__pane--a glass-pane">
          <span class="bb-arena__ghost" aria-hidden="true">A</span>
          <figcaption class="bb-arena__tag mono">Artifact A</figcaption>
          <div id="wrap-a" class="bb-arena__framewrap" data-live="false">
            <div
              id="zoomwrap-a"
              class="bb-arena__zoomwrap"
              tabindex="0"
              aria-label="Artifact A zoom and pan viewport"
              aria-keyshortcuts="+ - 0"
            >
              <div id="zoomer-a" class="bb-arena__zoomer">
                <iframe
                  id="frame-a"
                  class="bb-arena__frame"
                  title="Anonymized artifact A"
                  sandbox="allow-scripts allow-forms allow-modals allow-pointer-lock"
                  referrerpolicy="no-referrer"
                  loading="lazy"
                  tabindex="-1"></iframe>
              </div>
            </div>
            {/* The shield keeps the artifact inert until the voter opts in, so a
                scroll past the ballot never gets captured by a live canvas. One
                click hands pointer + keyboard to the artifact in place. */}
            <button id="play-a" class="bb-arena__play" type="button" aria-describedby="play-a-hint">
              <span class="bb-arena__play-disc" aria-hidden="true"></span>
              <span class="bb-arena__play-label mono">Press to play A</span>
              <span id="play-a-hint" class="bb-arena__play-hint">Use it for real — then judge</span>
            </button>
            <div class="bb-arena__tools">
              <button id="reload-a" class="bb-arena__tool mono" type="button" aria-label="Restart artifact A">
                restart ↺
              </button>
              <button id="expand-a" class="bb-arena__tool bb-arena__expand mono" type="button" aria-label="Open artifact A full screen">
                full screen ⤢
              </button>
            </div>
            <div id="zoombar-a" class="bb-arena__zoombar" role="toolbar" aria-label="Zoom artifact A">
              <button id="zoomout-a" class="bb-zoom-btn" type="button" aria-label="Zoom out artifact A">−</button>
              <span id="zoomlevel-a" class="bb-zoom-level" aria-live="polite">100%</span>
              <button id="zoomin-a" class="bb-zoom-btn" type="button" aria-label="Zoom in artifact A">+</button>
              <button id="zoomreset-a" class="bb-zoom-btn bb-zoom-reset" type="button" aria-label="Reset zoom for artifact A">↺</button>
            </div>
            {/* Filled by JS on handover so the state change is announced. */}
            <p id="live-a" class="bb-arena__live mono" role="status"></p>
            <span id="zoomlive-a" class="sr-only" aria-live="polite"></span>
          </div>
          <div class="bb-arena__voteui">
            <button id="vote-a" class="bb-arena__votebar" type="button">
              <span>A shipped it better</span>
              <span class="bb-arena__votearrow" aria-hidden="true">→</span>
            </button>
          </div>
        </figure>
        <span class="bb-arena__versus mono" aria-hidden="true">vs</span>
        <figure class="bb-arena__pane bb-arena__pane--b glass-pane">
          <span class="bb-arena__ghost" aria-hidden="true">B</span>
          <figcaption class="bb-arena__tag mono">Artifact B</figcaption>
          <div id="wrap-b" class="bb-arena__framewrap" data-live="false">
            <div
              id="zoomwrap-b"
              class="bb-arena__zoomwrap"
              tabindex="0"
              aria-label="Artifact B zoom and pan viewport"
              aria-keyshortcuts="+ - 0"
            >
              <div id="zoomer-b" class="bb-arena__zoomer">
                <iframe
                  id="frame-b"
                  class="bb-arena__frame"
                  title="Anonymized artifact B"
                  sandbox="allow-scripts allow-forms allow-modals allow-pointer-lock"
                  referrerpolicy="no-referrer"
                  loading="lazy"
                  tabindex="-1"></iframe>
              </div>
            </div>
            <button id="play-b" class="bb-arena__play" type="button" aria-describedby="play-b-hint">
              <span class="bb-arena__play-disc" aria-hidden="true"></span>
              <span class="bb-arena__play-label mono">Press to play B</span>
              <span id="play-b-hint" class="bb-arena__play-hint">Use it for real — then judge</span>
            </button>
            <div class="bb-arena__tools">
              <button id="reload-b" class="bb-arena__tool mono" type="button" aria-label="Restart artifact B">
                restart ↺
              </button>
              <button id="expand-b" class="bb-arena__tool bb-arena__expand mono" type="button" aria-label="Open artifact B full screen">
                full screen ⤢
              </button>
            </div>
            <div id="zoombar-b" class="bb-arena__zoombar" role="toolbar" aria-label="Zoom artifact B">
              <button id="zoomout-b" class="bb-zoom-btn" type="button" aria-label="Zoom out artifact B">−</button>
              <span id="zoomlevel-b" class="bb-zoom-level" aria-live="polite">100%</span>
              <button id="zoomin-b" class="bb-zoom-btn" type="button" aria-label="Zoom in artifact B">+</button>
              <button id="zoomreset-b" class="bb-zoom-btn bb-zoom-reset" type="button" aria-label="Reset zoom for artifact B">↺</button>
            </div>
            <p id="live-b" class="bb-arena__live mono" role="status"></p>
            <span id="zoomlive-b" class="sr-only" aria-live="polite"></span>
          </div>
          <div class="bb-arena__voteui">
            <button id="vote-b" class="bb-arena__votebar" type="button">
              <span>B shipped it better</span>
              <span class="bb-arena__votearrow" aria-hidden="true">→</span>
            </button>
          </div>
        </figure>
      </div>

      <div class="bb-arena__tiewrap bb-arena__voteui">
        <button id="vote-tie" class="bb-arena__tie mono" type="button">or call it a tie</button>
      </div>

      <ul class="bb-arena__trust" aria-label="How the blind test works">
        <li>
          <strong class="mono">Two agents</strong>
          <span>same prompt, same rubric</span>
        </li>
        <li>
          <strong class="mono">Blind test</strong>
          <span>order randomized per matchup</span>
        </li>
        <li>
          <strong class="mono">Fair reveal</strong>
          <span>identities shown only after you vote</span>
        </li>
      </ul>

      <div id="arena-reveal" class="bb-arena__reveal glass-pane" hidden>
        <span class="bb-arena__brief-eyebrow mono">// identities declassified</span>
        <div class="bb-arena__revealgrid">
          <div id="reveal-card-a"></div>
          <span class="bb-arena__vs mono" aria-hidden="true">vs</span>
          <div id="reveal-card-b"></div>
        </div>
        <button id="arena-next" class="btn btn--ember bb-arena__next" type="button">
          Next matchup <span class="btn-arrow" aria-hidden="true">→</span>
        </button>
      </div>

      <p class="bb-arena__note">
        Votes feed a Firth-corrected Bradley–Terry model with bootstrap confidence intervals,
        published per stack only after 30 votes. The method is pre-registered; see the
        <a href="/bench#report">report</a> for the full methodology.
      </p>
    </div>
  </section>

  <dialog id="arena-stage" class="bb-stage" aria-label="Artifact inspector">
    <div class="bb-stage__shell glass-pane">
      <div class="bb-stage__bar">
        <div class="bb-stage__switch" role="tablist" aria-label="Pick an artifact">
          <button id="stage-tab-a" class="bb-stage__tab mono" type="button" role="tab" aria-selected="true">
            Artifact A
          </button>
          <button id="stage-tab-b" class="bb-stage__tab mono" type="button" role="tab" aria-selected="false">
            Artifact B
          </button>
        </div>
        <div class="bb-stage__actions">
          <button id="stage-vote-a" class="btn btn--ghost bb-stage__vote" type="button" aria-label="Vote for artifact A">A is better</button>
          <button id="stage-vote-b" class="btn btn--ghost bb-stage__vote" type="button" aria-label="Vote for artifact B">B is better</button>
          <button id="stage-close" class="bb-stage__close mono" type="button" aria-label="Close inspector">
            esc ✕
          </button>
        </div>
      </div>
      <p class="bb-stage__brief">
        <strong id="stage-brief-title"></strong>
        <span id="stage-brief-text"></span>
        <span class="bb-stage__judge mono">Judge on: <span id="stage-brief-judge"></span></span>
      </p>
      <div class="bb-stage__viewport">
        <div
          id="stage-zoomwrap-a"
          class="bb-stage__zoomwrap"
          tabindex="0"
          aria-label="Artifact A full-screen zoom and pan viewport"
          aria-keyshortcuts="+ - 0"
        >
          <div id="stage-zoomer-a" class="bb-stage__zoomer">
            <iframe
              id="stage-frame-a"
              class="bb-stage__frame"
              title="Artifact A, full view"
              sandbox="allow-scripts allow-forms allow-modals allow-pointer-lock"
              referrerpolicy="no-referrer"></iframe>
          </div>
        </div>
        <div
          id="stage-zoomwrap-b"
          class="bb-stage__zoomwrap"
          tabindex="0"
          aria-label="Artifact B full-screen zoom and pan viewport"
          aria-keyshortcuts="+ - 0"
          hidden
        >
          <div id="stage-zoomer-b" class="bb-stage__zoomer">
            <iframe
              id="stage-frame-b"
              class="bb-stage__frame"
              title="Artifact B, full view"
              sandbox="allow-scripts allow-forms allow-modals allow-pointer-lock"
              referrerpolicy="no-referrer"></iframe>
          </div>
        </div>
        <div id="stage-zoombar-a" class="bb-stage__zoombar" role="toolbar" aria-label="Zoom artifact A full view">
          <button id="stage-zoomout-a" class="bb-zoom-btn" type="button" aria-label="Zoom out">−</button>
          <span id="stage-zoomlevel-a" class="bb-zoom-level" aria-live="polite">100%</span>
          <button id="stage-zoomin-a" class="bb-zoom-btn" type="button" aria-label="Zoom in">+</button>
          <button id="stage-zoomreset-a" class="bb-zoom-btn bb-zoom-reset" type="button" aria-label="Reset zoom">↺</button>
        </div>
        <div id="stage-zoombar-b" class="bb-stage__zoombar" role="toolbar" aria-label="Zoom artifact B full view" hidden>
          <button id="stage-zoomout-b" class="bb-zoom-btn" type="button" aria-label="Zoom out">−</button>
          <span id="stage-zoomlevel-b" class="bb-zoom-level" aria-live="polite">100%</span>
          <button id="stage-zoomin-b" class="bb-zoom-btn" type="button" aria-label="Zoom in">+</button>
          <button id="stage-zoomreset-b" class="bb-zoom-btn bb-zoom-reset" type="button" aria-label="Reset zoom">↺</button>
        </div>
        <span id="stage-zoomlive-a" class="sr-only" aria-live="polite"></span>
        <span id="stage-zoomlive-b" class="sr-only" aria-live="polite"></span>
        <button id="stage-prev" class="bb-stage__arrow bb-stage__arrow--prev" type="button" aria-label="Show the other artifact">‹</button>
        <button id="stage-next" class="bb-stage__arrow bb-stage__arrow--next" type="button" aria-label="Show the other artifact">›</button>
      </div>
      <p class="bb-stage__hint mono">Click the artifact to play · ‹ › to switch · esc to close</p>
    </div>
  </dialog>

  <dialog id="arena-authgate" class="bb-authgate" aria-label="Sign in to vote">
    <div class="bb-authgate__panel glass-pane">
      <p class="bb-authgate__eyebrow mono">// sign in to record your vote</p>
      <h2 class="bb-authgate__title">One vote per person per matchup</h2>
      <p class="bb-authgate__body">
        Sign in to lock in your judgment. You'll never get dealt the same pairing twice,
        and the board stays honest — one person, one vote, no stuffing.
      </p>
      <p id="authgate-status" class="bb-authgate__status" role="status" aria-live="polite" hidden></p>
      <div class="bb-authgate__buttons">
        <button id="authgate-google" class="bb-authgate__btn bb-authgate__btn--google" type="button" aria-label="Continue with Google" title="Continue with Google">
          <svg class="bb-authgate__logo" viewBox="0 0 24 24" aria-hidden="true">
            <path fill="#4285F4" d="M23.49 12.27c0-.82-.07-1.42-.22-2.04H12v3.95h6.62c-.13.98-.85 2.46-2.45 3.45l-.02.13 3.56 2.45.25.02c2.29-2.11 3.53-5.22 3.53-7.96Z"></path>
            <path fill="#34A853" d="M12 24c2.97 0 5.46-.98 7.28-2.67l-3.54-2.45c-.93.65-2.1 1.08-3.74 1.08-2.87 0-5.3-1.94-6.17-4.62l-.12.01-3.46 2.67-.04.13A12 12 0 0 0 12 24Z"></path>
            <path fill="#FBBC05" d="M5.07 14.26A7.4 7.4 0 0 1 4.67 12c0-.79.14-1.55.39-2.26l-.01-.14-3.75-2.9-.12.06A11.98 11.98 0 0 0 0 12c0 1.88.45 3.66 1.23 5.24l3.84-2.98Z"></path>
            <path fill="#EA4335" d="M12 4.68c2.28 0 3.82.99 4.7 1.81l3.43-3.35A11.7 11.7 0 0 0 12 0 12 12 0 0 0 1.2 6.76l3.86 2.98A7.32 7.32 0 0 1 12 4.68Z"></path>
          </svg>
        </button>
        <button id="authgate-apple" class="bb-authgate__btn bb-authgate__btn--apple" type="button" aria-label="Continue with Apple" title="Continue with Apple">
          <svg class="bb-authgate__logo" viewBox="0 0 24 24" aria-hidden="true">
            <path fill="currentColor" d="M16.78 12.9c-.03-3.04 2.49-4.5 2.6-4.57-1.41-2.06-3.6-2.34-4.38-2.37-1.87-.19-3.64 1.1-4.58 1.1-.95 0-2.42-1.07-3.97-1.04-2.05.03-3.94 1.19-4.99 3.02-2.13 3.69-.55 9.16 1.53 12.15 1.01 1.46 2.22 3.1 3.81 3.04 1.53-.06 2.11-.99 3.96-.99s2.37.99 3.99.96c1.65-.03 2.69-1.49 3.7-2.96 1.16-1.69 1.64-3.33 1.67-3.41-.04-.02-3.2-1.23-3.24-4.93Zm-3-8.91c.84-1.02 1.41-2.43 1.25-3.84-1.21.05-2.67.8-3.54 1.82-.78.9-1.46 2.34-1.28 3.72 1.35.1 2.73-.69 3.57-1.7Z"></path>
          </svg>
        </button>
        <button id="authgate-github" class="bb-authgate__btn bb-authgate__btn--github" type="button" aria-label="Continue with GitHub" title="Continue with GitHub">
          <svg class="bb-authgate__logo" viewBox="0 0 24 24" aria-hidden="true">
            <path fill="currentColor" d="M12 .3a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.05c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.74.08-.74 1.2.09 1.83 1.23 1.83 1.23 1.07 1.83 2.8 1.3 3.49.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.34-5.47-5.93 0-1.31.47-2.38 1.23-3.22-.12-.3-.53-1.52.12-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.3-1.55 3.3-1.23 3.3-1.23.65 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.6-2.8 5.62-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.69.83.57A12 12 0 0 0 12 .3Z"></path>
          </svg>
        </button>
        <button id="authgate-meta" class="bb-authgate__btn bb-authgate__btn--meta" type="button" aria-label="Continue with Meta" title="Continue with Meta">
          <svg class="bb-authgate__logo bb-authgate__logo--meta" viewBox="0 0 32 24" aria-hidden="true">
            <path fill="currentColor" d="M7.2 5.25c-2.9 0-4.82 2.74-4.82 6.75s1.92 6.75 4.82 6.75c1.93 0 3.28-1.3 4.76-3.41l1.03-1.47 1.03 1.47c1.48 2.11 2.83 3.41 4.76 3.41 2.9 0 4.82-2.74 4.82-6.75s-1.92-6.75-4.82-6.75c-1.93 0-3.28 1.3-4.76 3.41L16 10.72l-1.03-1.47C13.49 6.55 12.14 5.25 10.2 5.25 8.95 5.25 7.9 6 7.2 7.2 6.5 6 5.45 5.25 4.2 5.25H7.2Zm0 11.5c-1.32 0-2.52-1.75-2.52-4.75s1.2-4.75 2.52-4.75c1.22 0 2.2.99 3.62 3.01L12 12l-1.18 1.74C9.4 15.76 8.42 16.75 7.2 16.75Zm17.6 0c1.32 0 2.52-1.75 2.52-4.75s-1.2-4.75-2.52-4.75c-1.22 0-2.4.99-3.62 3.01L20 12l1.18 1.74c1.42 2.02 2.4 3.01 3.62 3.01Z"></path>
          </svg>
        </button>
      </div>
      <button id="authgate-dismiss" class="bb-authgate__dismiss mono" type="button">Not now</button>
    </div>
  </dialog>

  <script>
    import "../../../scripts/bench-arena";
  </script>
</BaseLayout>
