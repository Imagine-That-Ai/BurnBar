---
import BaseLayout from "@layouts/BaseLayout.astro";
import "@styles/bench.css";
import {
  BENCH,
  EVIDENCE,
  ALL_STACKS,
  scopeLabel,
  FAMILIES,
  MODEL_LOGO,
  HARNESS_LOGO,
  MODEL_CLASS,
  HARNESS_CLASS,
  classFor,
  monogramFor,
  harnessDisplay,
  modelDisplay,
  reportMatrix,
  reportModels,
  reportTasks,
  reportStats,
  reportCoverage,
  noopStats,
  fmtPct,
  fmtCost,
  fmtWall,
  fmtTokens,
  fmtInt,
  fmtGeneratedAt
} from "@data/bench";

const mcls = (id: string): string => classFor(MODEL_CLASS, id);
const hcls = (id: string): string => classFor(HARNESS_CLASS, id);

const generatedAt = fmtGeneratedAt(BENCH.generated_at_utc);
const shaShort = BENCH.source.runs_sha256.slice(0, 12);

const stats = reportStats();
const matrix = reportMatrix();
const models = reportModels();
const tasks = reportTasks();
const prime = stats.prime;

/* Suite-coverage + run-integrity disclosures. Both no-op against exports that
   predate the coverage block / per-cell noop_runs — sections hide until the
   regenerated evidence.json lands them. */
const noop = noopStats();
const coverage = reportCoverage();

const params = EVIDENCE.params as {
  ci?: string;
  high_n?: number;
  medium_n?: number;
  prior_strength?: number;
};

/* Task-browser family chips, in suite-mean order (FAMILIES is ranked). */
const taskFamilies = FAMILIES.filter((f) => tasks.some((t) => t.family === f));

/* Flip squares for the strict-vs-solution panel: one per flipped trial,
   grouped by harness (most first). Colors ride the .h-- setters. */
const flipSquares: string[] = stats.flipsByHarness.flatMap((f) =>
  Array.from({ length: f.flips }, () => f.harness)
);

/* Difficulty → strict-rate bucket for the task bars (CSS owns the scale). */
const strictBucket = (v: number): number =>
  v < 0.5 ? 0 : v < 0.7 ? 1 : v < 0.85 ? 2 : v < 0.95 ? 3 : 4;

/* The pre-registered plan's amendment log — one line each, dated. Amendments
   1–8, 10, 11 summarized from docs/analysis-plan-v2.md; Amendment 9 (the
   solution-quality endpoint) from the pipeline report's own amendment log. */
const AMENDMENTS: [string, string, string][] = [
  [
    "Pilot oracle-path fix",
    "2026-08-06",
    "Tasks 24–26 verify.sh resolved oracle test files at the wrong bundle path; fixed and re-piloted 6/6 pass. Calibration gate closed."
  ],
  [
    "Image provenance",
    "2026-08-06",
    "The v2 image adds TypeScript, uv, and the prime kernel venv — additive, harness-orthogonal; per-cell image digests recorded for review."
  ],
  [
    "Hard-task expansion",
    "2026-08-06",
    "Tasks 15–26 passed at ~97% field-wide — a floor, not a signal. Six hard tasks (27–32) authored; every cell topped up to 5 trials."
  ],
  [
    "Timeout enforcement fix",
    "2026-08-06",
    "Detached grandchildren held pipes past the cap; the agent now runs in its own process group (SIGKILL on timeout) and verify.sh is bounded to 600s. Scoring-neutral."
  ],
  [
    "Multi-model expansion",
    "2026-08-06",
    "GLM 5.2, GPT 5.6 Luna Pro, and Muse Spark 1.2 join — a full 32-task × 8-harness × 5-trial matrix per model on the sealed image."
  ],
  [
    "Adversarial-audit response",
    "2026-08-07",
    "split-phase-v1 isolation (agent and verifier in separate containers); hermes rerun on a lean tool surface; freeze cells quarantined; stats red-team fixes."
  ],
  [
    "Infrastructure hardening",
    "2026-08-07",
    "Container memory caps (1500m), Docker VM raised to 16 GiB, concurrency capped at 9 after OOM freeze events."
  ],
  [
    "Mid-run audit",
    "2026-08-08",
    "Task 03 invalidated everywhere (190 cells); the seal verified (0/2,602 contaminated); verify re-execution 12/12; Prime Agent found genuine; GUI exclusion bug fixed."
  ],
  [
    "Solution-quality endpoint",
    "2026-08-08",
    "The workspace verdict at budget end (verify_exit_code == 0) reported alongside strict; timeout-while-passing cells flip between the two."
  ],
  [
    "Experiential family + Arena",
    "2026-08-08",
    "Visual, game, sim, and UI tasks judged by blind human pairwise vote; registry v2 / meta v4; Bradley-Terry ratings published at 30+ votes per stack."
  ],
  [
    "Cost derivation disclosure",
    "2026-08-08",
    "Token-derived list-price costs labeled cost_source: derived, never presented as measured; cached input tokens billed at the full input rate."
  ],
  [
    "Standard-tier cost equivalent",
    "2026-08-08",
    "The contributor tier of muse-spark is free under data-sharing; every contributor cell is repriced at the standard non-contributor rates (meta/muse-spark-1.2, $1.25/$4.25 per M) and published as cost_standard_usd_median alongside the $0.00."
  ]
];

const SECTION_NAV: [string, string][] = [
  ["matrix", "Matrix"],
  ["models", "Models"],
  ["endpoints", "Two estimands"],
  ["prime", "Prime audit"],
  ["audits", "Audit verdicts"],
  ["tasks", "Tasks"],
  ["methodology", "Methodology"],
  ["explorer", "Explorer"],
  ["data", "Full data"]
];
---

<BaseLayout
  title="BurnBench report — the full public benchmark story"
  description="The complete BurnBench report: harness × model matrix, per-model profiles, strict vs solution quality, the 2026-08 audit story, all 31 tasks, the pre-registered methodology with 11 amendments, and a searchable explorer over every measured cell."
>
  {/* ──────────────── 1 · HERO ──────────────── */}
  <section class="bb-hero" id="overview" aria-labelledby="report-hero-h">
    <div class="container container--wide bb-hero__inner">
      <nav class="bb-bread mono" aria-label="Breadcrumbs">
        <a href="/bench">BurnBench</a>
        <span aria-hidden="true">→</span>
        <span>Report</span>
      </nav>
      <span class="eyebrow eyebrow--ember">BurnBench · full report · pre-registered analysis</span>
      <h1 id="report-hero-h" class="bb-hero__h">
        {stats.harnesses} harnesses, {stats.models} models, {stats.tasks} tasks.
        <span class="bb-hero__hb">Every cell verified by a hidden oracle.</span>
      </h1>
      <p class="bb-hero__lead">
        The complete public report: the harness × model matrix, per-model profiles, the two
        scoring estimands, the 2026-08 audit story, every task's pass rate, the pre-registered
        methodology and its eleven amendments, and an explorer over every measured cell. Ranked
        by <strong>solution quality</strong> — was the workspace correct when the budget ended?
        Every number derives from <code>evidence.json</code>, generated {generatedAt}.
      </p>

      <ul class="bb-rstats" aria-label="Headline numbers">
        <li class="bb-rstat">
          <span class="bb-rstat__v">{stats.stacks}</span>
          <span class="bb-rstat__k">stacks measured</span>
        </li>
        <li class="bb-rstat">
          <span class="bb-rstat__v">{stats.tasks}</span>
          <span class="bb-rstat__k">valid tasks</span>
        </li>
        <li class="bb-rstat">
          <span class="bb-rstat__v">{fmtInt(stats.trials)}</span>
          <span class="bb-rstat__k">trials scored</span>
        </li>
        <li class="bb-rstat bb-rstat--ember">
          <span class="bb-rstat__v">{fmtPct(stats.globalSolution)}</span>
          <span class="bb-rstat__k">solution rate</span>
        </li>
        <li class="bb-rstat">
          <span class="bb-rstat__v">{fmtPct(stats.globalStrict)}</span>
          <span class="bb-rstat__k">strict rate</span>
        </li>
        <li class="bb-rstat">
          <span class="bb-rstat__v">{stats.flipTrials}</span>
          <span class="bb-rstat__k">timeout-while-passing</span>
        </li>
      </ul>

      <ul class="bb-chips mono" aria-label="Report scope">
        <li><span class="bb-dot"></span> {fmtInt(stats.cells)} measured task cells</li>
        <li><span class="bb-dot bb-dot--mercury"></span> {stats.excluded} cells excluded by policy</li>
        <li><span class="bb-dot bb-dot--exact"></span> runs {shaShort}…</li>
      </ul>

      <nav class="bb-rnav" aria-label="Report sections">
        {SECTION_NAV.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
      </nav>

      <div class="bb-hero__ctas">
        <a class="btn btn--ember" href="/data/evidence.json" download
          >Download evidence.json <span class="btn-arrow" aria-hidden="true">↓</span></a
        >
        <a class="btn btn--ghost" href="/data/bench.json" download>bench.json</a>
        <a class="btn btn--ghost" href="/bench">Leaderboard</a>
        <a class="btn btn--ghost" href="/bench/arena">Arena</a>
      </div>
    </div>
  </section>

  {/* ──────────────── 2 · HARNESS × MODEL MATRIX ──────────────── */}
  <section class="bb-section bb-section--ember" id="matrix" aria-labelledby="matrix-h">
    <div class="container container--wide">
      <header class="bb-sec-head">
        <span class="eyebrow eyebrow--ember">Cross-product</span>
        <h2 id="matrix-h" class="bb-sec-h">The harness × model matrix.</h2>
        <p class="bb-sec-lead">
          Every measured pair, grouped. <strong>Fill color is the model, border is the
          harness</strong> — read a row to compare a harness across models, a column to compare a
          model across harnesses. Toggle to recolor the headline number by the strict gate.
        </p>
      </header>

      <div class="bb-tabs bb-tabs--sm" role="tablist" aria-label="Matrix metric" data-br-mxtabs>
        <button class="bb-tab is-active" role="tab" aria-selected="true" data-mx="sol">Solution quality</button>
        <button class="bb-tab" role="tab" aria-selected="false" data-mx="str">Strict</button>
      </div>

      <div class="bb-matrix-wrap">
        <table class="bb-matrix" data-br-mx>
          <thead>
            <tr>
              <th class="mx-corner">harness ↓ · model →</th>
              {
                matrix.models.map((mid) => {
                  const logo = MODEL_LOGO[mid] ?? null;
                  return (
                    <th class={`mx-colhead m--${mcls(mid)}`} scope="col">
                      <span class="mx-colhead__in">
                        <span class={`bb-badge bb-badge--sm m--${mcls(mid)}`}>
                          {logo ? (
                            <img src={logo} alt="" width="16" height="16" loading="lazy" decoding="async" />
                          ) : (
                            <span class="bb-badge__mono">{monogramFor(mid, modelDisplay(mid))}</span>
                          )}
                        </span>
                        {modelDisplay(mid)}
                      </span>
                    </th>
                  );
                })
              }
            </tr>
          </thead>
          <tbody>
            {
              matrix.harnesses.map((hid) => {
                const hLogo = HARNESS_LOGO[hid] ?? null;
                return (
                  <tr>
                    <th class={`mx-rowhead h--${hcls(hid)}`} scope="row">
                      <span class="mx-rowhead__in">
                        <span class={`bb-badge bb-badge--sm h--${hcls(hid)}`}>
                          {hLogo ? (
                            <img src={hLogo} alt="" width="16" height="16" loading="lazy" decoding="async" />
                          ) : (
                            <span class="bb-badge__mono">{monogramFor(hid, harnessDisplay(hid))}</span>
                          )}
                        </span>
                        {harnessDisplay(hid)}
                      </span>
                    </th>
                    {matrix.models.map((mid) => {
                      const cell = matrix.cells.get(`${hid}|${mid}`);
                      if (!cell) {
                        return (
                          <td class="mx-cell mx-cell--empty">
                            <span class="mx-cell__sub">not run</span>
                          </td>
                        );
                      }
                      return (
                        <td
                          class={`mx-cell h--${hcls(hid)} m--${mcls(mid)}`}
                          data-sol={fmtPct(cell.solution)}
                          data-str={fmtPct(cell.strict)}
                          data-n={cell.n}
                          title={`${harnessDisplay(hid)} × ${modelDisplay(mid)} — solution ${fmtPct(cell.solution)} · strict ${fmtPct(cell.strict)} · n ${cell.n} across ${cell.tasks} tasks`}
                        >
                          <span class="mx-cell__sol" data-mx-val>{fmtPct(cell.solution)}</span>
                          <span class="mx-cell__sub" data-mx-sub>
                            strict {fmtPct(cell.strict)} · n {cell.n}
                          </span>
                          <span class="mx-cell__fam">
                            {cell.tasks} tasks{cell.flips > 0 ? ` · ${cell.flips} t/o-pass` : ""}
                          </span>
                        </td>
                      );
                    })}
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </div>
      <p class="bb-caption">
        Rates are trial-weighted over the pair's measured task cells; t/o-pass counts trials that
        strict-failed on the wall clock but passed the hidden verifier post-mortem. Coverage is
        interim: not every model has run every task yet.
      </p>
    </div>
  </section>

  {/* ──────────────── 3 · FOUR MODELS, ONE SUITE ──────────────── */}
  <section class="bb-section" id="models" aria-labelledby="models-h">
    <div class="container container--wide">
      <header class="bb-sec-head">
        <span class="eyebrow eyebrow--mercury">Model view</span>
        <h2 id="models-h" class="bb-sec-h">{stats.models} models, one suite.</h2>
        <p class="bb-sec-lead">
          Model-level rollup across all {stats.harnesses} harnesses. Coverage is interim — later
          models have fewer of the {stats.tasks} task clusters scored so far, so compare within a
          column of the matrix above before comparing across models.
        </p>
      </header>

      <div class="bb-mcards">
        {
          models.map((m) => {
            const logo = MODEL_LOGO[m.model.id] ?? null;
            return (
              <article class={`bb-mcard m--${mcls(m.model.id)}`}>
                <div class="bb-mcard__head">
                  <span class={`bb-badge bb-badge--lg m--${mcls(m.model.id)}`}>
                    {logo ? (
                      <img src={logo} alt="" width="32" height="32" loading="lazy" decoding="async" />
                    ) : (
                      <span class="bb-badge__mono">{monogramFor(m.model.id, m.model.display)}</span>
                    )}
                  </span>
                  <div>
                    <div class="bb-mcard__name">{m.model.display}</div>
                    <div class="bb-mcard__prov">{m.model.provider}</div>
                  </div>
                </div>
                <div class="bb-mcard__big">{fmtPct(m.solution)}</div>
                <dl class="bb-mcard__stats">
                  <div class="bb-mcard__stat">
                    <dt>strict rate</dt>
                    <dd>{fmtPct(m.strict)}</dd>
                  </div>
                  <div class="bb-mcard__stat">
                    <dt>trials · tasks</dt>
                    <dd>
                      {fmtInt(m.n)} · {m.tasks}
                    </dd>
                  </div>
                  <div class="bb-mcard__stat">
                    <dt>timeout-while-passing</dt>
                    <dd>{m.flips} trials</dd>
                  </div>
                  <div class="bb-mcard__stat">
                    <dt>median cost / task</dt>
                    <dd>{fmtCost(m.medianCost)}</dd>
                  </div>
                  <div class="bb-mcard__stat">
                    <dt>best harness</dt>
                    <dd>
                      {m.bestHarness
                        ? `${harnessDisplay(m.bestHarness.harness)} · ${fmtPct(m.bestHarness.rate)}`
                        : "—"}
                    </dd>
                  </div>
                  <div class="bb-mcard__stat">
                    <dt>strongest family</dt>
                    <dd>
                      {m.strongestFamily
                        ? `${m.strongestFamily.family} · ${fmtPct(m.strongestFamily.rate)}`
                        : "—"}
                    </dd>
                  </div>
                </dl>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  {/* ──────────────── 4 · STRICT VS SOLUTION QUALITY ──────────────── */}
  <section class="bb-section bb-section--mercury" id="endpoints" aria-labelledby="endpoints-h">
    <div class="container container--wide">
      <header class="bb-sec-head">
        <span class="eyebrow eyebrow--mercury">Two ways to score a run</span>
        <h2 id="endpoints-h" class="bb-sec-h">Strict vs solution quality.</h2>
        <p class="bb-sec-lead">
          The same {fmtInt(stats.trials)} trials, two verdicts. They disagree on exactly
          <strong> {stats.flipTrials} trials</strong> — agents killed by the wall-clock cap whose
          abandoned workspaces pass the hidden verifier anyway.
        </p>
      </header>

      <div class="bb-estim">
        <article class="bb-estim__card">
          <h3>Strict <span class="bb-estim__tag bb-estim__tag--pre">pre-registered</span></h3>
          <p>
            Did the agent <strong>finish in time and pass</strong>? The agent runs against a
            wall-clock cap (1,500s hard batch · 1,800s standard).
            <code>timed_out ⇒ fail</code>, no exceptions — an efficiency-correctness composite.
          </p>
          <p class="bb-estim__ex">
            Agent passes all hidden tests but gets killed at the cap mid-cleanup →
            <strong class="bb-estim__fail">FAIL</strong>
          </p>
        </article>
        <article class="bb-estim__card">
          <h3>Solution quality <span class="bb-estim__tag bb-estim__tag--a9">Amendment 9</span></h3>
          <p>
            Was the <strong>workspace correct when the budget ended</strong>? After the kill, the
            verifier runs on whatever the agent left behind.
            <code>verify_exit_code == 0 ⇒ pass</code>, irrespective of a clean agent exit. The cap
            bounds the budget; it is not itself a failure condition.
          </p>
          <p class="bb-estim__ex">
            Same cell — killed at the cap, but the on-disk solution passes everything →
            <strong class="bb-estim__pass">PASS</strong>
          </p>
        </article>
      </div>

      <div class="bb-flip">
        <div class="bb-flip__head">
          <div class="bb-flip__n">{stats.flipTrials}</div>
          <p class="bb-flip__t">
            <strong>trials flip from strict-fail to solution-pass</strong> —
            {fmtPct(stats.flipTrials / stats.trials)} of all measured trials, across
            {" "}{stats.flipCells} task cells. Each square is one flipped trial, colored by
            harness. {stats.flipsByHarness[0] ? harnessDisplay(stats.flipsByHarness[0].harness) : ""}
            {stats.flipsByHarness[1]
              ? ` and ${harnessDisplay(stats.flipsByHarness[1].harness)} carry the most`
              : " carries the most"}
            — Prime passes visible tests early, then spends its remaining budget on elaborate
            self-written stress tests.
          </p>
        </div>
        <div class="bb-flip__grid" role="img" aria-label={`${stats.flipTrials} flipped trials, colored by harness`}>
          {flipSquares.map((h) => <span class={`bb-flip__sq h--${hcls(h)}`} />)}
        </div>
        <div class="bb-flip__legend">
          {
            stats.flipsByHarness.map((f) => (
              <span class={`bb-flip__chip h--${hcls(f.harness)}`}>
                <i></i>
                {harnessDisplay(f.harness)} · {f.flips}
              </span>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  {/* ──────────────── 5 · PRIME AGENT: THE 2026-08 AUDIT STORY ──────────────── */}
  <section class="bb-section" id="prime" aria-labelledby="prime-h">
    <div class="container container--wide">
      <header class="bb-sec-head">
        <span class="eyebrow eyebrow--ember">The investigation · audit of 2026-08-08</span>
        <img
          class="bb-prime-wordmark"
          src="/brand/providers/prime-intellect.svg"
          alt="Prime Intellect"
          width="180"
          height="30"
          loading="lazy"
          decoding="async"
        />
        <h2 id="prime-h" class="bb-sec-h">Prime Agent: contaminated then, genuine now.</h2>
        <p class="bb-sec-lead">
          Prime's v1 dominance (0.9652) was produced exclusively by 35 oracle-exposed cells. A
          full forensic audit of the sealed era asked: was any of it real? Historical narrative
          from the 2026-08-08 audit; current-export numbers computed live.
        </p>
      </header>

      <div class="bb-verdict">
        <span class="bb-verdict__badge">GENUINE</span>
        <p>
          <strong>Zero verifier gaming in 410 sealed Prime diffs.</strong> The agent still hunts
          for the verifier — the seal frustrates it, so it falls back to writing its own
          randomized stress tests. Its sealed standing is real and, if anything, understated.
        </p>
      </div>

      <div class="bb-prime">
        <article class="bb-methcard">
          <h3>Then vs now.</h3>
          <p>
            <strong>Then (leaky runner, v1):</strong> 32/35 = 0.914. Direct
            <code>cat oracle_*_test.py</code> reads, single-shot implementations, 6–13 turns, no
            iteration. One cell reverse-engineered the verifier's grep filter and shipped a
            <code>#</code>-comment alias to defeat it.
          </p>
          {
            prime && (
              <p>
                <strong>Now (sealed split-phase):</strong> {fmtPct(prime.strict)} strict ·
                {" "}{fmtPct(prime.solution)} solution over {fmtInt(prime.n)} trials in the current
                export. Failed <code>find / -name verify.sh</code> probes, then 10–26 turns of
                iterative, self-verifying work. Contamination bought certainty and speed —
                decisive on exactly two tasks (03, 06). The rest, Prime does clean.
              </p>
            )
          }
        </article>

        <div class="bb-defs">
          <article class="bb-defcard">
            <div class="bb-defcard__n bb-defcard__n--violet">{prime?.flips ?? "—"}</div>
            <h4>Timeout-while-passing</h4>
            <p>
              Wall-cap kills where the abandoned workspace <strong>passes the hidden
              verifier</strong> post-mortem — Prime cells in the current export. Counting them
              moves Prime mid-pack; the strict gate keeps them fails.
            </p>
          </article>
          <article class="bb-defcard">
            <div class="bb-defcard__n bb-defcard__n--red">20</div>
            <h4>Broken task-03 fails</h4>
            <p>
              <strong>03_rename_refactor</strong> orders agents to delete a name its hidden test
              imports. Prime failed it honestly, following the prompt. Task invalidated
              everywhere (audit, 2026-08-08).
            </p>
          </article>
          <article class="bb-defcard">
            <div class="bb-defcard__n bb-defcard__n--amber">5</div>
            <h4>Task-24 harness wedge</h4>
            <p>
              A backgrounded <code>mock_api.py &amp;</code> holds the stdout pipe, so the tool
              call never returns and the cell burns to the cap. Real harness behavior —
              disclosed, not invalidated (audit, 2026-08-08).
            </p>
          </article>
        </div>
      </div>
    </div>
  </section>

  {/* ──────────────── 6 · AUDIT VERDICTS ──────────────── */}
  <section class="bb-section bb-section--mercury" id="audits" aria-labelledby="audits-h">
    <div class="container container--wide">
      <header class="bb-sec-head">
        <span class="eyebrow eyebrow--mercury">Trust, but verify · 2026-08-08</span>
        <h2 id="audits-h" class="bb-sec-h">Audit verdicts.</h2>
        <p class="bb-sec-lead">
          A four-lane adversarial audit ran over all five result trees on 2026-08-08:
          contamination sweep, verify re-execution, genuineness forensics, and a statistical
          anomaly scan. Findings as logged by the audit.
        </p>
      </header>

      <div class="bb-audit">
        <article class="bb-acard">
          <div class="bb-acard__top">
            <span class="bb-acard__ico bb-acard__ico--ok" aria-hidden="true">✓</span>
            <h3>The seal held</h3>
          </div>
          <div class="bb-acard__big">0<small> / 2,602 sealed cells contaminated</small></div>
          <p>
            6.23 GB of logs swept; <strong>88,208</strong> oracle-indicator hits, all classified
            benign. Logs show the seal working: failed <code>find / -name verify.sh</code> probes,
            <code>ls /task/</code> → ENOENT, read-only-fs rejections.
          </p>
        </article>

        <article class="bb-acard">
          <div class="bb-acard__top">
            <span class="bb-acard__ico bb-acard__ico--ok" aria-hidden="true">✓</span>
            <h3>Verify re-run reproduces</h3>
          </div>
          <div class="bb-acard__big">12<small> / 12 cells match recorded verdicts</small></div>
          <p>
            Independent re-execution of the pipeline's own verify phase from
