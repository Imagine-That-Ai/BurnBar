                  <td>{fmtTokens(s.tokens_median)}</td>
                  <td class="d-sub">{s.confidence}</td>
                  <td class="d-sub">{s.evidence}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  {/*
    The report module fetches its explorer dataset from /data/bench-cells.json
    lazily (IntersectionObserver + interaction) — no inline data island, so the
    page keeps its zero-inline-JS budget and the dataset caches immutably.
  */}
  <script>
    import "../../scripts/bench-report";
  </script>
</BaseLayout>
