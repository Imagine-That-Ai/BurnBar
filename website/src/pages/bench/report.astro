---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  title="BurnBench report — moved to the main bench page"
  description="The full BurnBench report now lives on the main bench page — redirecting you there."
>
  <meta slot="head" http-equiv="refresh" content="0; url=/bench" />
  <section class="bb-section" id="report-moved">
    <div class="container" style="padding: 6rem 0; text-align: center;">
      <h1 class="bb-sec-h">The report moved.</h1>
      <p class="bb-sec-lead">
        The full BurnBench report now lives on the main bench page.
        <a href="/bench#report">Open the report →</a>
      </p>
    </div>
  </section>
  <script is:inline>
    location.replace("/bench" + (location.hash || "#report"));
  </script>
</BaseLayout>
