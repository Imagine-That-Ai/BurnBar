---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  title="Connect Hermes"
  description="Approve a Hermes Gateway connection for your BurnBar Cloud account."
  noindex
>
  <section class="hermes-connect">
    <div class="hermes-connect__shell">
      <div class="hermes-connect__heading">
        <span class="eyebrow eyebrow--ember">Hermes Gateway</span>
        <h1>Connect Hermes to BurnBar</h1>
        <p>Approve the code from Hermes and BurnBar will mint a revocable gateway token.</p>
      </div>

      <div class="connect-panel" aria-live="polite">
        <div id="state-checking" class="connect-state">
          <div class="spinner" aria-hidden="true"></div>
          <p>Checking account...</p>
        </div>

        <div id="state-signed-out" class="connect-state hidden">
          <div class="status-mark" aria-hidden="true">BB</div>
          <h2>Sign in to approve Hermes</h2>
          <p>Use the same BurnBar account that has BurnBar Cloud or Cloud Pro active.</p>
          <div class="button-stack">
            <button
              id="btn-google"
              class="btn provider-button provider-button--google"
              type="button"
            >
              <svg class="provider-button__icon" viewBox="0 0 24 24" aria-hidden="true">
                <path
                  fill="#4285F4"
                  d="M23.49 12.27c0-.82-.07-1.42-.22-2.04H12v3.95h6.62c-.13.98-.85 2.46-2.45 3.45l-.02.13 3.56 2.45.25.02c2.29-2.11 3.53-5.22 3.53-7.96Z"
                ></path>
                <path
                  fill="#34A853"
                  d="M12 24c3.28 0 6.03-1.08 8.04-2.94l-3.83-2.96c-1.03.72-2.41 1.22-4.21 1.22a7.32 7.32 0 0 1-6.93-5.06l-.13.01-3.7 2.87-.05.13A12 12 0 0 0 12 24Z"
                ></path>
                <path
                  fill="#FBBC05"
                  d="M5.07 14.26A7.4 7.4 0 0 1 4.67 12c0-.79.14-1.55.39-2.26l-.01-.14-3.75-2.9-.12.06A11.98 11.98 0 0 0 0 12c0 1.88.45 3.66 1.23 5.24l3.84-2.98Z"
                ></path>
                <path
                  fill="#EA4335"
                  d="M12 4.68c2.28 0 3.82.99 4.7 1.81l3.43-3.35A11.7 11.7 0 0 0 12 0 12 12 0 0 0 1.2 6.76l3.86 2.98A7.32 7.32 0 0 1 12 4.68Z"
                ></path>
              </svg>
              <span>Sign in with Google</span>
            </button>
            <button id="btn-apple" class="btn provider-button provider-button--apple" type="button">
              <svg class="provider-button__icon" viewBox="0 0 24 24" aria-hidden="true">
                <path
                  fill="currentColor"
                  d="M16.78 12.9c-.03-3.04 2.49-4.5 2.6-4.57-1.41-2.06-3.6-2.34-4.38-2.37-1.87-.19-3.64 1.1-4.58 1.1-.95 0-2.42-1.07-3.97-1.04-2.05.03-3.94 1.19-4.99 3.02-2.13 3.69-.55 9.16 1.53 12.15 1.01 1.46 2.22 3.1 3.81 3.04 1.53-.06 2.11-.99 3.96-.99s2.37.99 3.99.96c1.65-.03 2.69-1.49 3.7-2.96 1.16-1.69 1.64-3.33 1.67-3.41-.04-.02-3.2-1.23-3.24-4.93Zm-3-8.91c.84-1.02 1.41-2.43 1.25-3.84-1.21.05-2.67.8-3.54 1.82-.78.9-1.46 2.34-1.28 3.72 1.35.1 2.73-.69 3.57-1.7Z"
                ></path>
              </svg>
              <span>Sign in with Apple</span>
            </button>
          </div>
        </div>

        <div id="state-confirm" class="connect-state hidden">
          <div class="account-row">
            <img id="user-avatar" src="" alt="" class="avatar hidden" />
            <span id="user-email" class="mono">Signed in</span>
          </div>
          <h2>Confirm the Hermes code</h2>
          <p>Enter the 8-character code shown by Hermes.</p>
          <label class="code-label" for="code-input">Pairing code</label>
          <input
            id="code-input"
            class="code-input"
            type="text"
            placeholder="ABCD-2345"
            maxlength="9"
            autocomplete="one-time-code"
            inputmode="text"
          />
          <button id="btn-confirm" class="btn btn--ember" type="button">Approve Hermes</button>
          <button id="btn-signout" class="btn-text" type="button">Use a different account</button>
        </div>

        <div id="state-approving" class="connect-state hidden">
          <div class="spinner" aria-hidden="true"></div>
          <h2>Approving Hermes...</h2>
          <p>BurnBar is creating a scoped gateway credential.</p>
        </div>

        <div id="state-success" class="connect-state hidden">
          <div class="status-mark status-mark--success" aria-hidden="true">OK</div>
          <h2>Hermes is connected</h2>
          <p>Return to Hermes. This connection can be revoked from BurnBar at any time.</p>
        </div>

        <div id="state-error" class="connect-state hidden">
          <div class="status-mark status-mark--error" aria-hidden="true">!</div>
          <h2>Connection failed</h2>
          <p id="error-message">The Hermes code could not be approved.</p>
          <button id="btn-retry" class="btn btn--secondary" type="button">Try again</button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hermes-connect {
    min-height: min(780px, calc(100vh - 72px));
    display: grid;
    place-items: center;
    padding: clamp(2rem, 8vw, 6rem) var(--gutter);
  }

  .hermes-connect__shell {
    width: min(100%, 540px);
    display: grid;
    gap: 1.5rem;
  }

  .hermes-connect__heading {
    display: grid;
    gap: 0.75rem;
    text-align: center;
  }

  .hermes-connect__heading h1 {
    margin: 0;
    color: var(--text-bright);
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 7vw, 4rem);
    line-height: 0.98;
    letter-spacing: 0;
  }

  .hermes-connect__heading p,
  .connect-state p {
    margin: 0;
    color: var(--text-base);
    line-height: 1.5;
  }

  .connect-panel {
    min-height: 386px;
    display: grid;
    align-items: center;
    padding: clamp(1.25rem, 5vw, 2rem);
    border: 1px solid var(--ink-line-bright);
    border-radius: var(--r-sm);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.035));
    box-shadow:
      0 22px 70px rgba(0, 0, 0, 0.34),
      0 0 34px rgba(250, 107, 6, 0.08);
    backdrop-filter: blur(28px) saturate(150%);
  }

  .connect-state {
    display: grid;
    justify-items: center;
    gap: 1rem;
    text-align: center;
  }

  .connect-state.hidden {
    display: none;
  }

  .connect-state h2 {
    margin: 0;
    color: var(--text-bright);
    font-size: 1.35rem;
    letter-spacing: 0;
  }

  .status-mark {
    width: 56px;
    height: 56px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(250, 107, 6, 0.55);
    border-radius: 50%;
    color: var(--core-amber);
    font-family: var(--font-mono);
    font-size: 0.88rem;
    font-weight: 800;
    letter-spacing: 0;
    background: rgba(250, 107, 6, 0.1);
  }

  .status-mark--success {
    color: var(--status-exact);
    border-color: rgba(60, 214, 192, 0.55);
    background: rgba(60, 214, 192, 0.1);
  }

  .status-mark--error {
    color: var(--core-red);
    border-color: rgba(238, 24, 3, 0.55);
    background: rgba(238, 24, 3, 0.1);
  }

  .button-stack {
    width: min(100%, 320px);
    display: grid;
    gap: 0.75rem;
  }

  .account-row {
    max-width: 100%;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 0.65rem;
    border: 1px solid var(--ink-line);
    border-radius: var(--r-sm);
    background: rgba(255, 255, 255, 0.045);
  }

  .avatar {
    width: 24px;
    height: 24px;
    border-radius: 50%;
  }

  .avatar.hidden {
    display: none;
  }

  .mono {
    max-width: min(320px, 70vw);
    overflow: hidden;
    color: var(--text-base);
    font-family: var(--font-mono);
    font-size: 0.84rem;
    letter-spacing: 0;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .code-label {
    color: var(--text-mute);
    font-size: 0.8rem;
  }

  .code-input {
    width: min(100%, 260px);
    min-height: 56px;
    border: 1px solid var(--ink-line-bright);
    border-radius: var(--r-sm);
    background: rgba(0, 0, 0, 0.32);
    color: var(--text-bright);
    font-family: var(--font-mono);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: 0;
    text-align: center;
    text-transform: uppercase;
  }

  .code-input:focus {
    border-color: var(--core-amber);
    outline: none;
    box-shadow: 0 0 0 3px rgba(253, 196, 44, 0.14);
  }

  .btn {
    min-height: 48px;
    border: 0;
    border-radius: var(--r-sm);
    cursor: pointer;
    font: 700 0.95rem var(--font-body);
    letter-spacing: 0;
  }

  .btn--ember {
    color: #130703;
    background: linear-gradient(135deg, var(--core-amber), var(--core-fire));
  }

  .btn--secondary {
    color: var(--text-bright);
    border: 1px solid var(--ink-line-bright);
    background: rgba(255, 255, 255, 0.07);
  }

  .provider-button {
    display: inline-grid;
    grid-template-columns: 24px minmax(0, 1fr) 24px;
    align-items: center;
    justify-items: center;
    width: 100%;
    min-height: 50px;
    padding-inline: 1rem;
    border: 1px solid var(--ink-line-bright);
    background: rgba(255, 255, 255, 0.94);
    color: #1f1f1f;
    box-shadow:
      0 10px 26px -18px rgba(22, 19, 14, 0.55),
      inset 0 1px 0 rgba(255, 255, 255, 0.78);
    text-shadow: none;
  }

  .provider-button:hover,
  .provider-button:focus-visible {
    color: #1f1f1f;
    border-color: color-mix(in oklab, var(--core-fire) 36%, var(--ink-line-bright));
    background: #ffffff;
    outline: none;
    box-shadow:
      0 14px 32px -20px rgba(22, 19, 14, 0.58),
      0 0 0 3px rgba(250, 107, 6, 0.12);
    transform: translateY(-1px);
  }

  .provider-button--apple {
    background: #111111;
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.18);
    box-shadow:
      0 10px 28px -18px rgba(0, 0, 0, 0.75),
      inset 0 1px 0 rgba(255, 255, 255, 0.16);
  }

  .provider-button--apple:hover,
  .provider-button--apple:focus-visible {
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.3);
    background: #000000;
  }

  :global(:root[data-theme="light"]) .provider-button--google.provider-button--google {
    color: #1f1f1f;
    background: rgba(255, 255, 255, 0.94);
  }

  :global(:root[data-theme="light"]) .provider-button--apple.provider-button--apple {
    color: #ffffff;
    background: #111111;
    border-color: rgba(255, 255, 255, 0.18);
  }

  :global(:root[data-theme="light"]) .provider-button--apple.provider-button--apple:hover,
  :global(:root[data-theme="light"]) .provider-button--apple.provider-button--apple:focus-visible {
    color: #ffffff;
    background: #000000;
  }

  .provider-button__icon {
    width: 20px;
    height: 20px;
    justify-self: start;
    flex: 0 0 auto;
  }

  .btn-text {
    border: 0;
    color: var(--text-mute);
    background: transparent;
    cursor: pointer;
    font: 600 0.88rem var(--font-body);
    letter-spacing: 0;
  }

  .spinner {
    width: 34px;
    height: 34px;
    border: 2px solid rgba(255, 255, 255, 0.16);
    border-top-color: var(--core-amber);
    border-radius: 50%;
    animation: spin 0.85s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>

<script>
  import { appleProvider, auth, functions, googleProvider } from "../../lib/firebaseClient";
  import { onAuthStateChanged, signInWithPopup, signOut } from "firebase/auth";
  import type { AuthProvider, User } from "firebase/auth";
  import { httpsCallable } from "firebase/functions";

  const states = {
    checking: document.getElementById("state-checking"),
    signedOut: document.getElementById("state-signed-out"),
    confirm: document.getElementById("state-confirm"),
    approving: document.getElementById("state-approving"),
    success: document.getElementById("state-success"),
    error: document.getElementById("state-error")
  };

  const btnGoogle = document.getElementById("btn-google");
  const btnApple = document.getElementById("btn-apple");
  const btnConfirm = document.getElementById("btn-confirm");
  const btnSignout = document.getElementById("btn-signout");
  const btnRetry = document.getElementById("btn-retry");
  const codeInput = document.getElementById("code-input") as HTMLInputElement | null;
  const userEmail = document.getElementById("user-email");
  const userAvatar = document.getElementById("user-avatar") as HTMLImageElement | null;
  const errorMessage = document.getElementById("error-message");

  let currentUser: User | null = null;
  let authStateSettled = false;
  const authStateTimeout = window.setTimeout(() => {
    if (!authStateSettled) {
      setError("BurnBar sign-in did not finish loading. Check your connection and try again.");
    }
  }, 8000);

  function showState(activeState: keyof typeof states) {
    for (const [key, el] of Object.entries(states)) {
      if (!el) continue;
      el.classList.toggle("hidden", key !== activeState);
    }
  }

  function setError(message: string) {
    if (errorMessage) errorMessage.textContent = message;
    showState("error");
  }

  function authErrorText(error: unknown) {
    const errorLike = error as { code?: unknown; message?: unknown };
    const code = String(errorLike?.code || "");
    const message = String(errorLike?.message || "");
    const combined = `${code} ${message}`.toLowerCase();

    if (combined.includes("api-key-not-valid") || combined.includes("invalid-api-key")) {
      return "BurnBar sign-in is not configured for this local build. Add the Firebase web config and reload.";
    }
    if (combined.includes("popup-closed-by-user")) {
      return "Sign-in was closed before it finished.";
    }
    if (combined.includes("popup-blocked")) {
      return "Your browser blocked the sign-in popup. Allow popups for BurnBar and try again.";
    }
    if (combined.includes("network-request-failed")) {
      return "BurnBar sign-in could not reach Firebase. Check your connection and try again.";
    }

    return error instanceof Error ? error.message : "Sign-in failed.";
  }

  function queryCode() {
    const params = new URLSearchParams(window.location.search);
    return params.get("code") || "";
  }

  function normalizeCode(raw: string) {
    const value = raw
      .replace(/[^A-Za-z0-9]/g, "")
      .toUpperCase()
      .slice(0, 8);
    return value.length > 4 ? `${value.slice(0, 4)}-${value.slice(4)}` : value;
  }

  function prefillCode() {
    if (!codeInput) return;
    const code = normalizeCode(queryCode() || codeInput.value);
    if (code) codeInput.value = code;
  }

  async function signIn(provider: AuthProvider) {
    try {
      showState("checking");
      await signInWithPopup(auth, provider);
    } catch (error) {
      setError(authErrorText(error));
    }
  }

  codeInput?.addEventListener("input", () => {
    codeInput.value = normalizeCode(codeInput.value);
  });

  onAuthStateChanged(
    auth,
    (user) => {
      authStateSettled = true;
      window.clearTimeout(authStateTimeout);
      currentUser = user;
      if (!user) {
        showState("signedOut");
        return;
      }

      if (userEmail) userEmail.textContent = user.email || user.displayName || "BurnBar account";
      if (userAvatar && user.photoURL) {
        userAvatar.src = user.photoURL;
        userAvatar.classList.remove("hidden");
      }
      prefillCode();
      showState("confirm");
    },
    (error) => {
      authStateSettled = true;
      window.clearTimeout(authStateTimeout);
      setError(authErrorText(error));
    }
  );

  btnGoogle?.addEventListener("click", () => signIn(googleProvider));
  btnApple?.addEventListener("click", () => signIn(appleProvider));

  btnSignout?.addEventListener("click", async () => {
    showState("checking");
    await signOut(auth);
  });

  btnRetry?.addEventListener("click", () => {
    if (!authStateSettled) {
      showState("checking");
      window.location.reload();
      return;
    }
    showState(currentUser ? "confirm" : "signedOut");
  });

  btnConfirm?.addEventListener("click", async () => {
    const code = normalizeCode(codeInput?.value || "");
    if (code.replace("-", "").length !== 8) {
      setError("Enter the 8-character code shown by Hermes.");
      return;
    }

    try {
      showState("approving");
      const approve = httpsCallable(functions, "approveHermesGatewayDeviceGrant");
      await approve({ userCode: code, displayName: "Hermes Agent" });
      showState("success");
    } catch (error: unknown) {
      const codeText = String((error as { code?: unknown })?.code || "");
      if (codeText.includes("permission-denied")) {
        setError("BurnBar Cloud or Cloud Pro is required to connect Hermes.");
      } else if (codeText.includes("not-found")) {
        setError(
          "That Hermes code was not found. Start setup in Hermes again and enter the new code."
        );
      } else if (codeText.includes("deadline-exceeded")) {
        setError("That Hermes code expired. Start setup in Hermes again.");
      } else {
        setError(error?.message || "The Hermes connection could not be approved.");
      }
    }
  });
</script>
