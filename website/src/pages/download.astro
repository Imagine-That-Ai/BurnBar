---
import BaseLayout from "@layouts/BaseLayout.astro";
import { SITE } from "@data/site";

const macDownloadBaseUrl = SITE.macDownloadBaseUrl.replace(/\/$/, "");
const macUpdateBaseUrl = (SITE.macUpdateBaseUrl ?? SITE.macDownloadBaseUrl).replace(/\/$/, "");
const macDownloadHref = macDownloadBaseUrl
  ? `${macDownloadBaseUrl}/${SITE.macReleaseFile}`
  : `/downloads/${SITE.macReleaseFile}`;
const macLatestHref = macUpdateBaseUrl
  ? `${macUpdateBaseUrl}/${SITE.macUpdateFeedFile}`
  : `/downloads/${SITE.macUpdateFeedFile}`;
const macAppcastHref = macUpdateBaseUrl
  ? `${macUpdateBaseUrl}/${SITE.macAppcastFile}`
  : `/downloads/${SITE.macAppcastFile}`;
---

<BaseLayout
  title="Download"
  description="Download OpenBurnBar. macOS app available by direct download and submitted to Mac App Store review, iOS in App Store review, Cursor and VS Code extensions source-only."
>
  <section class="pagehead">
    <div class="container pagehead__inner">
      <span class="eyebrow eyebrow--ember">Download</span>
      <h1 class="pagehead__h">Get OpenBurnBar.</h1>
      <div class="lead-glass-wrap glass-pane">
        <p class="lead">
          macOS ships as a notarized direct download and is submitted to Mac App Store review. iOS
          is in Apple review. The editor extension is source-only for now — build locally and load
          unpacked.
        </p>
      </div>
      <nav class="jump" aria-label="Jump to platform">
        <a href="#macos">macOS</a>
        <a href="#ios">iOS · iPadOS</a>
        <a href="#editor">Editor</a>
        <a href="#android">Android</a>
      </nav>
    </div>
  </section>

  <!-- MACOS -->
  <section id="macos" class="dlsec">
    <div class="container dlsec__shell">
      <div class="dlsec__head">
        <div class="dlsec__intro">
          <span class="tag tag--exact tag--plain mono">Release · {SITE.macReleaseLatest}</span>
          <h2>macOS app</h2>
          <p class="lead">
            Native Swift app. Runs as a menu-bar utility. macOS {SITE.macMin} or later. Apple Silicon
            supported.
          </p>
        </div>
        <a class="btn btn--ember dlsec__primary" href={macDownloadHref}>
          Download DMG · {SITE.macReleaseLatest}
          <span class="btn-arrow" aria-hidden="true">↓</span>
        </a>
      </div>

      <ol class="steps" data-animate-onview>
        <li class="step">
          <span class="step__num mono">1</span>
          <div class="step__card">
            <h3>Download &amp; open the DMG</h3>
            <p>
              The latest direct-download release is served from OpenBurnBar's download host. Each
              one ships Developer ID signed, notarized, stapled, with SHA-256 and SHA-512 checksums,
              a latest-release feed, and a Sparkle-compatible appcast next to it.
            </p>
            <p class="muted small">
              Release feeds:
              <a href={macLatestHref}>latest metadata</a>
              ·
              <a href={macAppcastHref}>appcast</a>
            </p>
          </div>
        </li>
        <li class="step">
          <span class="step__num mono">2</span>
          <div class="step__card">
            <h3>Drag OpenBurnBar.app to <code>/Applications</code></h3>
            <p>That's the install. No installer, no admin password.</p>
          </div>
        </li>
        <li class="step">
          <span class="step__num mono">3</span>
          <div class="step__card">
            <h3>Launch &amp; find the menu bar</h3>
            <p>
              OpenBurnBar lives in the menu bar — no Dock icon. Click the flame to open the popover.
              If Gatekeeper hesitates the first time, right-click → Open.
            </p>
          </div>
        </li>
        <li class="step">
          <span class="step__num mono">4</span>
          <div class="step__card">
            <h3>Watch the burn</h3>
            <p>
              The app reads logs in <code>~/.claude/</code>, <code>~/.codex/</code>,
              <code>~/.factory/</code> and friends. No account, no API keys for local tracking. Quota
              providers (Cursor, Copilot, Warp, MiniMax, etc.) prompt you per provider when you choose
              to enable them.
            </p>
          </div>
        </li>
      </ol>

      <details class="alt">
        <summary>Build from source instead</summary>
        <div class="alt__body">
          <pre><code class="mono">git clone {SITE.github}.git
cd BurnBar
make install</code></pre>
          <p class="muted small">Requires Xcode 16+, Swift 5.10+, XcodeGen optional.</p>
        </div>
      </details>
    </div>
  </section>

  <!-- iOS -->
  <section id="ios" class="dlsec dlsec--quiet">
    <div class="container dlsec__shell">
      <div class="dlsec__head">
        <div class="dlsec__intro">
          <span class="tag tag--review tag--plain mono">In App Store review</span>
          <h2>iPhone &amp; iPad companion</h2>
          <p class="lead">
            iOS &amp; iPadOS {SITE.iosMin} or later. Companion to the Mac app — the phone or tablet renders
            what the Mac records. Native widgets, Live Activity, Siri shortcut.
          </p>
        </div>
        <span class="btn btn--ghost dlsec__primary is-disabled" aria-disabled="true">
          App Store · pending review
        </span>
      </div>

      <div class="callout">
        <p>
          <strong>What "in review" means:</strong>
          OpenBurnBar 1.0 is submitted to App Store Connect with manual release enabled — Apple's approval
          doesn't auto-publish. We'll flip the switch and update this page the moment it's live.
        </p>
        <p class="muted small">App Store subscriptions are gated on the same review.</p>
      </div>
    </div>
  </section>

  <!-- Editor -->
  <section id="editor" class="dlsec">
    <div class="container dlsec__shell">
      <div class="dlsec__head">
        <div class="dlsec__intro">
          <span class="tag tag--estimated tag--plain mono">{SITE.cursorExtStatus}</span>
          <h2>Cursor &amp; VS Code extension</h2>
          <p class="lead">
            Activity-bar panel that talks to the same local daemon as the menu bar. No public
            marketplace listing yet — build from source and load unpacked.
          </p>
        </div>
      </div>

      <ol class="steps" data-animate-onview>
        <li class="step">
          <span class="step__num mono">1</span>
          <div class="step__card">
            <h3>Install &amp; launch OpenBurnBar on macOS</h3>
            <p>The daemon must be running — it's how the extension reads data.</p>
          </div>
        </li>
        <li class="step">
          <span class="step__num mono">2</span>
          <div class="step__card">
            <h3>Build the extension</h3>
            <pre><code class="mono">cd extensions/openburnbar
npm ci
npm run build</code></pre>
          </div>
        </li>
        <li class="step">
          <span class="step__num mono">3</span>
          <div class="step__card">
            <h3>Load unpacked into your editor</h3>
            <p>
              In Cursor or VS Code: <em>Extensions → "Install from VSIX…"</em> or
              <em>Run Extension</em> from the Run-and-Debug panel pointing at
              <code>extensions/openburnbar</code>.
            </p>
          </div>
        </li>
        <li class="step">
          <span class="step__num mono">4</span>
          <div class="step__card">
            <h3>Open the OpenBurnBar activity bar</h3>
            <p>
              The panel surfaces burn for the active workspace and the routed-provider gateway when
              you have it on.
            </p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- Android -->
  <section id="android" class="dlsec dlsec--quiet">
    <div class="container dlsec__shell">
      <div class="dlsec__head">
        <div class="dlsec__intro">
          <span class="tag tag--beta tag--plain mono">Feature-complete · Play Store pending</span>
          <h2>Android companion</h2>
          <p class="lead">
            The full iPhone &amp; iPad experience, now on Android — your burn, your sessions, the
            assistant, and Floo, all built and tested. The one thing left is a Play Store listing;
            until then, build it from source under <code>android/</code>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- System reqs -->
  <section class="reqs">
    <div class="container">
      <header class="sec-head">
        <span class="eyebrow eyebrow--ember">Requirements &amp; provenance</span>
        <h2>What you need, what we ship.</h2>
      </header>
      <div class="reqs__grid" data-animate-onview>
        <article class="reqcard">
          <h4>macOS</h4>
          <ul>
            <li>{SITE.macMin} or later</li>
            <li>Apple Silicon Mac</li>
            <li>~120 MB on disk</li>
            <li>Signed with Developer ID + notarized + stapled</li>
            <li>SHA-256 / SHA-512 checksums published per release</li>
            <li>SPDX SBOM per release</li>
          </ul>
        </article>
        <article class="reqcard">
          <h4>iOS / iPadOS</h4>
          <ul>
            <li>{SITE.iosMin} or later</li>
            <li>App Store-installed; subscriptions in-app</li>
            <li>BurnBar Cloud and Cloud Pro require Firebase sign-in</li>
            <li>Live Activity needs iOS 16.1+</li>
          </ul>
        </article>
        <article class="reqcard">
          <h4>Editor extension</h4>
          <ul>
            <li>Cursor or VS Code ^1.95.0</li>
            <li>Node + npm to build</li>
            <li>Loads unpacked — marketplace listing is roadmap</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section class="endcta endcta--inline">
    <div class="container container--narrow endcta__inner">
      <h2>Two extra resources before you install.</h2>
      <div class="endcta__ctas">
        <a class="btn btn--ghost" href="/privacy">Privacy model</a>
        <a class="btn btn--ghost" href="/providers">Provider matrix</a>
        <a class="btn btn--ghost" href={SITE.github} target="_blank" rel="noopener noreferrer"
          >GitHub repo</a
        >
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import "../scripts/animateOnView.ts";
</script>

<style>
  .pagehead {
    padding-block: var(--s-9) var(--s-6);
  }
  .pagehead__inner {
    max-width: 60rem;
    margin: 0 auto;
    text-align: center;
    display: grid;
    gap: var(--s-3);
    justify-items: center;
  }
  .pagehead__h {
    margin-top: var(--s-3);
  }
  .pagehead .lead {
    margin-top: var(--s-4);
    max-width: 58ch;
  }

  /* platform jump links */
  .jump {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-2);
    margin-top: var(--s-5);
  }
  .jump a {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.02em;
    color: var(--text-mute);
    padding: 0.4rem 0.9rem;
    border-radius: var(--r-pill);
    border: 1px solid var(--ink-line);
    background: rgba(10, 10, 15, 0.5);
    transition:
      color var(--dur-base) var(--ease),
      border-color var(--dur-base) var(--ease);
  }
  .jump a:hover {
    color: var(--ember-bright);
    border-color: color-mix(in oklab, var(--ember-core) 40%, var(--ink-line));
  }

  /* ---------- section shell — keeps content tasteful, not full-bleed ---------- */
  .dlsec {
    padding-block: var(--s-8);
    border-top: 1px solid var(--ink-line);
  }
  .dlsec--quiet {
    background: var(--ink-base);
  }
  .dlsec__shell {
    max-width: 60rem;
  }
  .dlsec__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--s-5);
    margin-bottom: var(--s-6);
    flex-wrap: wrap;
  }
  .dlsec__intro {
    flex: 1 1 28rem;
  }
  .dlsec__head h2 {
    margin-top: var(--s-3);
  }
  .dlsec__head .lead {
    margin-top: var(--s-3);
    max-width: 52ch;
    font-size: 1.1rem;
  }
  .dlsec__primary {
    white-space: nowrap;
  }
  .dlsec__primary.is-disabled {
    opacity: 0.55;
    cursor: not-allowed;
    pointer-events: none;
  }

  /* ---------- elegant numbered timeline ---------- */
  .steps {
    position: relative;
    display: grid;
    gap: var(--s-3);
    max-width: 46rem;
  }
  /* the connector line runs through the node centers (left 20px) */
  .steps::before {
    content: "";
    position: absolute;
    left: 19px;
    top: 18px;
    bottom: 18px;
    width: 2px;
    background: linear-gradient(
      to bottom,
      color-mix(in oklab, var(--ember-core) 55%, transparent),
      color-mix(in oklab, var(--ember-core) 12%, transparent)
    );
  }
  .step {
    position: relative;
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    gap: var(--s-4);
    align-items: start;
  }
  .step__num {
    position: relative;
    z-index: 1;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    font-size: 0.95rem;
    color: var(--ember-bright);
    border: 1px solid color-mix(in oklab, var(--ember-core) 45%, var(--ink-line));
    background:
      radial-gradient(circle at 50% 35%, rgba(250, 107, 6, 0.18), transparent 70%), var(--ink-void);
    box-shadow: inset 0 0 0 4px rgba(5, 5, 8, 0.9);
  }
  .step__card {
    padding: var(--s-4) var(--s-5);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--r-3);
    background: rgba(10, 10, 15, 0.66);
    backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    box-shadow: 0 14px 40px -18px rgba(0, 0, 0, 0.7);
    display: grid;
    gap: var(--s-2);
    min-width: 0;
    transition:
      border-color var(--dur-base) var(--ease),
      transform var(--dur-base) var(--ease);
  }
  .step__card:hover {
    transform: translateX(3px);
    border-color: color-mix(in oklab, var(--ember-core) 28%, rgba(255, 255, 255, 0.08));
  }
  .step__card h3 {
    font-family: var(--font-display);
    color: var(--text-bright);
    font-size: var(--t-h4);
    font-variation-settings:
      "opsz" 36,
      "wght" 540;
  }
  .step__card p {
    color: var(--text-base);
    font-size: 0.95rem;
  }
  .step__card :global(pre) {
    margin: var(--s-1) 0 0;
  }

  pre {
    background: var(--ink-surface);
    border: 1px solid var(--ink-line);
    border-radius: var(--r-2);
    padding: var(--s-3) var(--s-4);
    overflow-x: auto;
  }
  pre code {
    background: transparent;
    border: 0;
    padding: 0;
  }

  /* build-from-source disclosure */
  .alt {
    margin-top: var(--s-5);
    max-width: 46rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--r-3);
    background: rgba(10, 10, 15, 0.66);
    backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
  }
  .alt summary {
    cursor: pointer;
    padding: var(--s-3) var(--s-5);
    color: var(--text-bright);
    font-family: var(--font-display);
    font-size: 1rem;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .alt summary::-webkit-details-marker {
    display: none;
  }
  .alt summary::after {
    content: "+";
    color: var(--ember-bright);
    font-family: var(--font-mono);
  }
  .alt[open] summary::after {
    content: "−";
  }
  .alt__body {
    padding: 0 var(--s-5) var(--s-5);
  }

  /* callout (iOS in-review) */
  .callout {
    max-width: 46rem;
    padding: var(--s-5);
    border-left: 3px solid var(--ember-bright);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    border-right: 1px solid rgba(255, 255, 255, 0.06);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    background: rgba(15, 10, 10, 0.66);
    backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    box-shadow: 0 14px 40px -18px rgba(0, 0, 0, 0.7);
    border-radius: 0 var(--r-3) var(--r-3) 0;
    display: grid;
    gap: var(--s-2);
  }
  .callout strong {
    color: var(--text-bright);
  }

  @media (max-width: 720px) {
    .pagehead__h {
      max-width: 11ch;
      font-size: 2.75rem;
      letter-spacing: 0;
      overflow-wrap: normal;
      word-break: normal;
    }
    .dlsec__head {
      flex-direction: column;
      align-items: stretch;
    }
    .dlsec__primary {
      white-space: normal;
      text-align: center;
      width: 100%;
    }
    pre {
      font-size: 0.78rem;
    }
  }

  /* ---------- system requirements ---------- */
  .reqs {
    padding-block: var(--s-9);
    border-top: 1px solid var(--ink-line);
  }
  .sec-head {
    display: grid;
    gap: var(--s-3);
    margin-bottom: var(--s-6);
    max-width: 64ch;
  }
  .reqs__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-4);
  }
  .reqcard {
    padding: var(--s-5);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: var(--r-3);
    background: rgba(10, 10, 15, 0.66);
    backdrop-filter: blur(22px) saturate(170%);
    -webkit-backdrop-filter: blur(22px) saturate(170%);
    box-shadow: 0 18px 48px -22px rgba(0, 0, 0, 0.7);
    transition: border-color var(--dur-base) var(--ease);
  }
  .reqcard:hover {
    border-color: color-mix(in oklab, var(--ember-core) 26%, rgba(255, 255, 255, 0.08));
  }
  .reqcard h4 {
    font-family: var(--font-display);
    color: var(--text-bright);
    font-size: 1.05rem;
    margin-bottom: var(--s-3);
    font-variation-settings:
      "opsz" 36,
      "wght" 540;
  }
  .reqcard ul {
    display: grid;
    gap: var(--s-2);
    font-size: 0.9rem;
    color: var(--text-base);
  }
  .reqcard li {
    padding-left: 1.1em;
    position: relative;
  }
  .reqcard li::before {
    content: "→";
    color: var(--ember-bright);
    position: absolute;
    left: 0;
    font-family: var(--font-mono);
    font-size: 0.85em;
  }
  @media (max-width: 880px) {
    .reqs__grid {
      grid-template-columns: 1fr;
    }
  }

  .small {
    font-size: var(--t-caption);
  }
  .endcta--inline {
    padding-block: var(--s-9);
    text-align: center;
    background: radial-gradient(60% 80% at 50% 50%, rgba(255, 106, 26, 0.05), transparent 70%);
    border-top: 1px solid var(--ink-line);
  }
  .endcta__ctas {
    display: flex;
    justify-content: center;
    gap: var(--s-3);
    margin-top: var(--s-5);
    flex-wrap: wrap;
  }
  .endcta__inner {
    text-align: center;
    display: grid;
    gap: var(--s-5);
    justify-items: center;
    padding: var(--s-4) 0;
  }

  /* ---------- reveal motion ---------- */
  @keyframes downloadReveal {
    from {
      opacity: 0;
      translate: 0 22px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }
  .steps[data-animate-onview] .step,
  .reqs__grid[data-animate-onview] .reqcard {
    opacity: 1;
    translate: 0 0;
  }
  .steps[data-animate-onview].is-visible .step,
  .reqs__grid[data-animate-onview].is-visible .reqcard {
    animation: downloadReveal 640ms var(--ease) both;
  }
  .steps[data-animate-onview].is-visible .step:nth-child(2) {
    animation-delay: 80ms;
  }
  .steps[data-animate-onview].is-visible .step:nth-child(3) {
    animation-delay: 160ms;
  }
  .steps[data-animate-onview].is-visible .step:nth-child(4) {
    animation-delay: 240ms;
  }
  .reqs__grid[data-animate-onview].is-visible .reqcard:nth-child(2) {
    animation-delay: 90ms;
  }
  .reqs__grid[data-animate-onview].is-visible .reqcard:nth-child(3) {
    animation-delay: 180ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .step,
    .reqcard,
    .step__card {
      transition: none !important;
      animation: none !important;
    }
    .steps[data-animate-onview] .step,
    .reqs__grid[data-animate-onview] .reqcard,
    .steps[data-animate-onview].is-visible .step,
    .reqs__grid[data-animate-onview].is-visible .reqcard {
      opacity: 1 !important;
      translate: none !important;
    }
  }
</style>
