---
import BaseLayout from "@layouts/BaseLayout.astro";
import ControlRoomPreview from "@components/mission-control/ControlRoomPreview.astro";
import MissionMark from "@components/mission-control/MissionMark.astro";
import {
  describeArchitectures,
  MISSION_CONTROL_DOWNLOAD_READY as downloadReady,
  MISSION_CONTROL_EVIDENCE as evidence,
  MISSION_CONTROL_META as meta,
  MISSION_CONTROL_RELEASE as release,
  MISSION_CONTROL_STYLE
} from "@data/mission-control";
import setupBrief from "../../public/mission-control/agent-setup.md?raw";

const architectures = describeArchitectures(release.architectures);
const evidenceDone = evidence.filter((check) => check.done).length;

// The first sentences of the real setup brief's prompt, verbatim, so the
// excerpt on the page can never drift from the file people download.
const briefPrompt = (setupBrief.match(/^> (.+)$/m)?.[1] ?? "").trim();
const briefExcerpt = briefPrompt
  .split(/(?<=\.)\s+/)
  .slice(0, 4)
  .join(" ");

const principles = [
  {
    title: "One place for your environments",
    body: "Your Mac and the remote machines you choose sit side by side, each with its own connection, actions and results."
  },
  {
    title: "Setup that you review",
    body: "An agent you already trust drafts the profile. You read the machines and permissions before anything is imported."
  },
  {
    title: "Only actions you named",
    body: "Every action is a specific program with fixed arguments and a time limit. Diagnostic checks and task actions stay separate."
  },
  {
    title: "State and results that are real",
    body: "Configured, reachable, authenticated and ready to run are reported separately, and results come from tasks that actually ran."
  }
];

const steps = [
  { title: "Open the app", body: "It starts blank. No one else’s machines, tokens or sessions." },
  {
    title: "Hand over the brief",
    body: "Give the setup brief to an agent you already trust on your own computer."
  },
  {
    title: "Review the profile",
    body: "Read the proposed machines and actions, then import only what you approve."
  },
  {
    title: "Connect, then see results",
    body: "Run a real check and one approved action. Mission Control shows what actually happened."
  }
];

const verifiedDate = release.verifiedAt
  ? new Date(release.verifiedAt).toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
      timeZone: "UTC"
    })
  : null;
---

<BaseLayout
  title="Mission Control — your environments, one control room"
  description="A native control room for your Mac and the remote machines you choose. Agent-assisted setup you review, explicit actions, and real connection state and results."
  ambientEffects={false}
>
  <link slot="head" rel="stylesheet" href="/mission-control/fonts/fonts.css" />
  <div class="mission-control" style={MISSION_CONTROL_STYLE}>
    <nav class="product-nav" aria-label="Mission Control">
      <div class="product-nav__inner">
        <a class="wordmark" href="#mission-control">
          <MissionMark size={26} />
          <span class="wordmark__text">
            {meta.wordmark}
            <small>{meta.provenance}</small>
          </span>
        </a>
        <div class="product-nav__links">
          <a href="#setup">Setup</a>
          <a href="#editions">Editions</a>
          <a href="#iphone">iPhone</a>
          <a class="product-nav__cta" href="#release">
            {downloadReady ? "Download" : "Release status"}
          </a>
        </div>
      </div>
    </nav>

    <section class="hero" id="mission-control" aria-labelledby="mc-title">
      <div class="hero__glow" aria-hidden="true"></div>
      <div class="mc-container hero__copy">
        <MissionMark variant="icon" size={72} class="hero__icon" />
        <p class="mc-eyebrow">Mission Control for Mac, by BurnBar</p>
        <h1 id="mc-title">
          Your environments.
          <span class="hero__accent">One control room.</span>
        </h1>
        <p class="mc-lead">
          Your Mac and the remote machines you choose, in one calm native app. You decide what can
          run, and you see what actually happened.
        </p>
        <div class="actions">
          {downloadReady ? (
            <a class="button button--primary" href={release.artifact?.url}>
              Download for Mac <span aria-hidden="true">↓</span>
            </a>
          ) : (
            <a class="button button--primary" href="#release">
              See release status <span aria-hidden="true">→</span>
            </a>
          )}
          <a class="button button--quiet" href="/mission-control/agent-setup.md">
            Read the setup brief
          </a>
        </div>
        <p class="availability">
          {downloadReady
            ? `Version ${release.version} · macOS ${release.minimumMacOS} or later · ${architectures}`
            : `Public Mac release in preparation · macOS ${release.minimumMacOS}+ build target`}
        </p>
      </div>
      <div class="mc-container hero__room">
        <ControlRoomPreview />
      </div>
    </section>

    <section class="section charge" aria-labelledby="charge-title">
      <div class="mc-container charge__grid">
        <header>
          <p class="mc-eyebrow">How it works</p>
          <h2 id="charge-title">
            Move between your machines.
            <span class="muted-line">Stay in charge of what runs.</span>
          </h2>
          <p class="section-lead">
            Mission Control is orchestration for computers you already own and accounts you already
            have. It does not include an AI subscription, extra cloud capacity or access to anyone
            else’s accounts.
          </p>
        </header>
        <ol class="principles">
          {principles.map((item, index) => (
            <li>
              <span class={`principle-index tone-${index}`} aria-hidden="true" />
              <div>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section setup" id="setup" aria-labelledby="setup-title">
      <div class="mc-container">
        <header class="center-head">
          <p class="mc-eyebrow">First launch</p>
          <h2 id="setup-title">An empty room, made yours.</h2>
          <p class="section-lead">
            The portable edition begins blank. Setup is reviewed data, not a script you have to
            trust blindly.
          </p>
        </header>
        <ol class="steps">
          {steps.map((step, index) => (
            <li>
              <span class="step-number" aria-hidden="true">
                {index + 1}
              </span>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </li>
          ))}
        </ol>
        <div class="brief">
          <div class="brief__copy">
            <h3>The setup brief</h3>
            <p>
              Written for the agent, readable by you. It asks for discovery limited to machines you
              name, existing SSH aliases with strict host-key checking, explicit actions with finite
              timeouts, and keys that never leave the machine that owns them.
            </p>
            <div class="brief__links">
              <a class="button button--secondary" href="/mission-control/agent-setup.md" download>
                Download brief <span aria-hidden="true">↓</span>
              </a>
              <a class="text-link" href="/mission-control/agent-setup.md">
                Read it in the browser
              </a>
            </div>
          </div>
          <figure class="brief__excerpt">
            <figcaption>agent-setup.md · excerpt</figcaption>
            <blockquote>
              <p>{briefExcerpt}</p>
            </blockquote>
          </figure>
        </div>
      </div>
    </section>

    <section class="section editions" id="editions" aria-labelledby="editions-title">
      <div class="mc-container">
        <header class="center-head">
          <p class="mc-eyebrow">Two editions</p>
          <h2 id="editions-title">Portable by default. Personal by choice.</h2>
        </header>
        <div class="editions__grid">
          <article class="edition edition--portable">
            <p class="edition__tag">This page</p>
            <h3>Portable edition</h3>
            <p>
              Starts with no environments, no tokens and no copied account sessions. Nothing from
              the original owner’s infrastructure comes along. Ready to be configured by whoever
              installs it.
            </p>
            <ul>
              <li>Blank profile at first launch</li>
              <li>Configured with your own agent and review</li>
              <li>The edition intended for public download</li>
            </ul>
          </article>
          <article class="edition">
            <p class="edition__tag">Separate repository</p>
            <h3>Personal edition</h3>
            <p>
              Built around an explicit owner profile for one person’s own setup. It is kept apart
              from the portable edition and is not the public download.
            </p>
            <ul>
              <li>Explicit owner profile</li>
              <li>Maintained separately</li>
              <li>Not offered on this page</li>
            </ul>
          </article>
        </div>
      </div>
    </section>

    <section class="section iphone" id="iphone" aria-labelledby="iphone-title">
      <div class="mc-container iphone__grid">
        <div class="devices" aria-hidden="true">
          <div class="device device--portrait">
            <span class="device__title"></span>
            <span class="device__hero"></span>
            <span class="device__line"></span>
            <span class="device__line short"></span>
            <span class="device__bar">
              <i></i>
              <i></i>
              <i></i>
            </span>
          </div>
          <div class="device device--landscape">
            <span class="device__rail">
              <i></i>
              <i></i>
              <i></i>
            </span>
            <span class="device__main">
              <b></b>
              <b class="short"></b>
              <b></b>
            </span>
            <span class="device__context">
              <i></i>
              <i></i>
              <i></i>
              <i></i>
            </span>
          </div>
        </div>
        <div class="iphone__copy">
          <p class="mc-eyebrow">iPhone</p>
          <h2 id="iphone-title">A separate client for your pocket.</h2>
          <p class="section-lead">
            Portrait keeps one environment in focus with places in thumb reach. Turn it sideways and
            navigation, the active environment and its context sit side by side.
          </p>
          <dl class="facts">
            <div>
              <dt>Build</dt>
              <dd>Separate iOS 17+ client. A Mac DMG does not install it.</dd>
            </div>
            <div>
              <dt>Pairing</dt>
              <dd>
                Connects to your own authenticated HTTPS service with valid TLS. Pairing credentials
                stay in Keychain.
              </dd>
            </div>
            <div>
              <dt>Availability</dt>
              <dd>No App Store release has been announced.</dd>
            </div>
          </dl>
          <p class="art-note">Layout concept, not a screenshot.</p>
        </div>
      </div>
    </section>

    <section class="section release" id="release" aria-labelledby="release-title">
      <div class="mc-container">
        <div class="release-card">
          <div class="release-card__intro">
            <MissionMark variant="icon" size={88} class="release-icon" />
            <p class="mc-eyebrow">Mission Control for Mac</p>
            <h2 id="release-title">
              {downloadReady
                ? `Version ${release.version} is ready.`
                : "Getting ready for your Mac."}
            </h2>
            <p class="section-lead">
              {downloadReady
                ? "Open the DMG and drag Mission Control into Applications. The app and its bundled service install together; no separate Python or Node runtime is needed."
                : "The app and its bundled service are being prepared for public distribution. A download appears here only after every check below is verified."}
            </p>
            <dl class="facts">
              <div>
                <dt>Requires</dt>
                <dd>macOS {release.minimumMacOS} or later</dd>
              </div>
              <div>
                <dt>{downloadReady ? "Runs on" : "Build targets"}</dt>
                <dd>{architectures}</dd>
              </div>
              <div>
                <dt>Includes</dt>
                <dd>The app and its bundled service. No AI subscription.</dd>
              </div>
            </dl>
          </div>

          <div class="release-card__status">
            {downloadReady ? (
              <>
                <a class="button button--primary button--block" href={release.artifact?.url}>
                  Download Mission Control {release.version} <span aria-hidden="true">↓</span>
                </a>
                <ol class="install">
                  <li>Open the downloaded DMG.</li>
                  <li>Drag Mission Control into Applications.</li>
                  <li>Open it and follow the first-launch setup with your agent.</li>
                </ol>
                <a class="text-link" href={release.releaseNotesUrl ?? undefined}>
                  Release notes <span aria-hidden="true">↗</span>
                </a>
                <div class="checksum">
                  <span>SHA-256</span>
                  <code>{release.artifact?.sha256}</code>
                </div>
              </>
            ) : (
              <div class="pending" role="status">
                <span class="pending__dot" aria-hidden="true" />
                <div>
                  <strong>Public release in preparation</strong>
                  <p>No installation file is offered yet.</p>
                </div>
              </div>
            )}
            <div class="evidence">
              <p class="evidence__head">
                <span>Distribution evidence</span>
                <span>
                  {evidenceDone} of {evidence.length} verified
                </span>
              </p>
              <ul>
                {evidence.map((check) => (
                  <li class:list={{ done: check.done }}>
                    <span class="evidence__mark" aria-hidden="true">
                      {check.done ? "✓" : ""}
                    </span>
                    <span>{check.label}</span>
                    <span class="evidence__state">{check.done ? "Verified" : "Pending"}</span>
                  </li>
                ))}
              </ul>
              <p class="evidence__foot">
                {verifiedDate ? `Verified ${verifiedDate}. ` : ""}
                Each line is read from the{" "}
                <a class="text-link" href="/mission-control/release.json">
                  release manifest
                </a>
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section questions" aria-labelledby="questions-title">
      <div class="mc-container questions__inner">
        <header class="center-head">
          <p class="mc-eyebrow">Good to know</p>
          <h2 id="questions-title">Before you move in.</h2>
        </header>
        <div class="question-list">
          <details>
            <summary>What comes in the Mac app?</summary>
            <p>
              The intended DMG contains Mission Control and its bundled service, so you do not need
              a separate Python or Node installation. Your own machines, logins and approved
              connections complete the setup.
            </p>
          </details>
          <details>
            <summary>Does it include an AI subscription?</summary>
            <p>
              No. Mission Control provides orchestration. Use agents and AI accounts you already
              have; it does not purchase cloud capacity or add entitlements.
            </p>
          </details>
          <details>
            <summary>What can it run on my machines?</summary>
            <p>
              Only the actions in the profile you imported: each one a named program with fixed
              arguments and a finite timeout. It is not a remote shell, and it does not copy account
              sessions or turn every reachable computer into a worker.
            </p>
          </details>
          <details>
            <summary>Where do my SSH keys go?</summary>
            <p>
              Nowhere. Existing SSH identities stay on the machine that owns them, with strict
              host-key checking. TLS, Keychain and operating-system permission prompts work as
              usual.
            </p>
          </details>
          <details>
            <summary>Is a configured machine ready to use?</summary>
            <p>
              Not necessarily. Configured, reachable, authenticated and task-ready are separate
              states, and Mission Control reports each one on its own.
            </p>
          </details>
          <details>
            <summary>Where can I get help?</summary>
            <p>
              Start with the <a href="/mission-control/agent-setup.md">setup brief</a>, or email{" "}
              <a href="mailto:support@burnbar.ai">support@burnbar.ai</a>. Include your app version
              and what happened, never credentials or private keys.
            </p>
          </details>
        </div>
        <p class="design-note">
          <MissionMark size={18} />
          <span>
            A member of the BurnBar family, built on the {meta.sourceProduct} design foundation with
            a warmer palette. <a href="/mission-control/token-provenance.json">Token provenance</a>
            <br />
            Type is Space Grotesk and Space Mono, self-hosted under the SIL Open Font License:{" "}
            <a href="/mission-control/licenses/SpaceGrotesk-OFL.txt">Space Grotesk license</a>
            <span aria-hidden="true"> · </span>
            <a href="/mission-control/licenses/SpaceMono-OFL.txt">Space Mono license</a>
          </span>
        </p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* ── Theme: semantic roles mapped onto the shared token variables ───── */
  .mission-control {
    --font-display: "Mission Space", var(--font-body);
    --font-body: "Mission Space", sans-serif;
    --font-mono: "Mission Mono", monospace;
    --mc-bg: var(--mc-dark-base);
    --mc-raised: var(--mc-dark-raised);
    --mc-text: var(--mc-light-raised);
    --mc-muted: var(--mc-dark-secondary);
    --mc-border: color-mix(in srgb, var(--mc-dark-hairline) 26%, transparent);
    --mc-border-strong: color-mix(in srgb, var(--mc-dark-hairline) 48%, transparent);
    --mc-glass: color-mix(in srgb, var(--mc-dark-raised) 78%, transparent);
    --mc-glass-edge: color-mix(in srgb, var(--mc-light-base) 8%, transparent);
    --mc-sidebar-fill: color-mix(in srgb, var(--mc-dark-base) 40%, transparent);
    --mc-hover: color-mix(in srgb, var(--mc-dark-pearl) 60%, transparent);
    --mc-selected: var(--mc-dark-pearl);
    --mc-accent-text: var(--mc-pink);
    --mc-focus: var(--mc-pink);
    --mc-on-primary: var(--mc-ink);
    --mc-primary: var(--mc-light-base);
    --text-bright: var(--mc-text);
    --text-base: var(--mc-text);
    --ember-bright: var(--mc-text);

    font-family: var(--font-body);
    background: var(--mc-bg);
    color: var(--mc-text);
    isolation: isolate;
    overflow: clip;
  }
  :global([data-theme="light"]) .mission-control {
    --mc-bg: var(--mc-light-base);
    --mc-raised: var(--mc-light-raised);
    --mc-text: var(--mc-ink);
    --mc-muted: var(--mc-light-secondary);
    --mc-border: color-mix(in srgb, var(--mc-light-hairline) 26%, transparent);
    --mc-border-strong: color-mix(in srgb, var(--mc-light-hairline) 50%, transparent);
    --mc-glass: color-mix(in srgb, var(--mc-light-pearl) 72%, transparent);
    --mc-glass-edge: var(--mc-light-base);
    --mc-sidebar-fill: color-mix(in srgb, var(--mc-light-raised) 70%, transparent);
    --mc-hover: color-mix(in srgb, var(--mc-light-raised) 90%, var(--mc-ink));
    --mc-selected: var(--mc-light-base);
    --mc-accent-text: var(--mc-pink-deep);
    --mc-focus: var(--mc-pink-deep);
    --mc-on-primary: var(--mc-light-base);
    --mc-primary: var(--mc-ink);
  }
  /* The site's global element colors (headings, p, strong, link hover) read
     these shell variables; point them at Mission Control's own roles. */
  .mission-control :global(:is(h1, h2, h3, h4)) {
    text-shadow: none;
  }
  .mission-control :global(code) {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
  }
  .mission-control :is(a, summary, button):focus-visible {
    outline: 2px solid var(--mc-focus);
    outline-offset: 4px;
    border-radius: var(--mc-r-sm);
  }

  .mc-container {
    width: min(1120px, calc(100% - 2 * var(--mc-section)));
    margin-inline: auto;
  }

  /* ── Shared type ─────────────────────────────────────────────────────── */
  .mc-eyebrow {
    margin: 0 0 var(--mc-inset);
    font-size: var(--mc-label);
    letter-spacing: var(--mc-label-track);
    font-weight: var(--wght-medium);
    color: var(--mc-accent-text);
  }
  h2 {
    margin: 0 0 var(--mc-page);
    font-family: var(--font-display);
    font-size: clamp(32px, 4.2vw, 52px);
    font-weight: var(--wght-bold);
    line-height: 1.06;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .muted-line {
    display: block;
    color: var(--mc-muted);
  }
  .section-lead {
    margin: 0;
    max-width: 58ch;
    font-size: clamp(var(--mc-body), 1.4vw, var(--mc-headline));
    line-height: 1.55;
    color: var(--mc-muted);
    text-wrap: pretty;
  }
  .center-head {
    display: grid;
    justify-items: center;
    margin: 0 auto var(--mc-empty);
    text-align: center;
  }
  .text-link {
    color: var(--mc-text);
    text-decoration: underline;
    text-decoration-color: var(--mc-border-strong);
    text-underline-offset: 4px;
    transition: text-decoration-color var(--mc-snappy) var(--mc-ease);
  }
  .text-link:hover {
    color: var(--mc-text);
    text-decoration-color: currentColor;
  }

  /* ── Buttons ─────────────────────────────────────────────────────────── */
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--mc-control);
    margin-top: var(--mc-empty);
  }
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--mc-control);
    min-height: 48px;
    padding: var(--mc-control) var(--mc-section);
    border-radius: var(--mc-r-full);
    border: 1px solid transparent;
    font-size: var(--mc-body);
    font-weight: var(--wght-medium);
    text-decoration: none;
    transition:
      transform var(--mc-snappy) var(--mc-ease),
      background-color var(--mc-snappy) var(--mc-ease),
      box-shadow var(--mc-snappy) var(--mc-ease);
  }
  .button--primary {
    background: var(--mc-primary);
    color: var(--mc-on-primary);
    box-shadow: var(--mc-shadow-2);
  }
  .button--primary:hover {
    transform: translateY(-1px);
    box-shadow:
      var(--mc-shadow-2),
      0 10px 32px -10px color-mix(in srgb, var(--mc-pink) 70%, transparent);
  }
  .button--secondary {
    background: var(--mc-raised);
    border-color: var(--mc-border-strong);
    color: var(--mc-text);
  }
  .button--secondary:hover {
    transform: translateY(-1px);
  }
  .button--quiet {
    color: var(--mc-text);
    border-color: var(--mc-border-strong);
  }
  .button--quiet:hover {
    background: var(--mc-hover);
  }
  .button--block {
    width: 100%;
  }

  /* ── Product nav ─────────────────────────────────────────────────────── */
  .product-nav {
    position: sticky;
    top: 0;
    z-index: 5;
    border-bottom: 1px solid var(--mc-border);
    background: color-mix(in srgb, var(--mc-bg) 72%, transparent);
    backdrop-filter: blur(20px) saturate(1.5);
    -webkit-backdrop-filter: blur(20px) saturate(1.5);
  }
  .product-nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--mc-section);
    width: min(1120px, calc(100% - 2 * var(--mc-section)));
    min-height: var(--mc-places-bar);
    margin: auto;
  }
  .wordmark {
    display: flex;
    align-items: center;
    gap: var(--mc-control);
    color: var(--mc-text);
    text-decoration: none;
  }
  .wordmark__text {
    display: grid;
    font-size: var(--mc-body);
    font-weight: var(--wght-bold);
    letter-spacing: -0.01em;
    line-height: 1.1;
  }
  .wordmark__text small {
    font-size: var(--mc-caption);
    font-weight: var(--wght-regular);
    letter-spacing: var(--mc-caption-track);
    color: var(--mc-muted);
  }
  .product-nav__links {
    display: flex;
    align-items: center;
    gap: var(--mc-section);
    font-size: var(--mc-label);
  }
  .product-nav__links a {
    color: var(--mc-muted);
    text-decoration: none;
    transition: color var(--mc-snappy) var(--mc-ease);
  }
  .product-nav__links a:hover {
    color: var(--mc-text);
  }
  .product-nav__links .product-nav__cta {
    padding: 6px var(--mc-control);
