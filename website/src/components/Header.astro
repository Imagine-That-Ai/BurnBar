---
import { SITE } from "@data/site";
import Brandmark from "./Brandmark.astro";

const path = Astro.url.pathname.replace(/\/$/, "");

/* Elegantly consolidated header: the full NAV_PRIMARY (11 items) wrapped
   into 5 pills + one "More" so the bar never wraps or feels flea-market.
   Footer keeps the flat list; header groups for scan. */
const PRODUCT_DROPDOWN = [
  { href: "/product", label: "Overview" },
  { href: "/platforms", label: "Platforms" },
  { href: "/providers", label: "Providers" },
  { href: "/benefits", label: "Why it matters" }
];
const MORE_DROPDOWN = [
  { href: "/trust", label: "Trust" },
  { href: "/privacy", label: "Privacy" },
  { href: SITE.consoleUrl, label: "Your data console" },
  { href: "/security", label: "Security" },
  { href: "/mcp", label: "MCP" },
  { href: "/support", label: "Support" },
  { href: "/faq", label: "FAQ" }
];

interface NavItem {
  href: string;
  label: string;
  dropdown?: { href: string; label: string }[];
}
const HEADER_NAV: NavItem[] = [
  { href: "/product", label: "Product", dropdown: PRODUCT_DROPDOWN },
  { href: "/router", label: "Router" },
  { href: "/bench", label: "Bench" },
  { href: "/floo", label: "Floo" },
  { href: "/control", label: "Control" },
  { href: "/pricing", label: "Pricing" },
  { href: "/trust", label: "More", dropdown: MORE_DROPDOWN }
];
const MOBILE_NAV = [
  { href: "/product", label: "Product" },
  { href: "/router", label: "Router" },
  { href: "/bench", label: "Bench" },
  { href: "/floo", label: "Floo" },
  { href: "/control", label: "Agent Control" },
  { href: "/platforms", label: "Platforms" },
  { href: "/providers", label: "Providers" },
  { href: "/pricing", label: "Pricing" },
  { href: "/trust", label: "Trust" },
  { href: "/faq", label: "FAQ" },
  { href: "/download", label: "Download" },
  { href: SITE.consoleUrl, label: "Your data console" }
];

function isActive(href: string): boolean {
  const itemPath = href.replace(/\/$/, "");
  return path === itemPath || (itemPath !== "" && path.startsWith(itemPath));
}
---

<header class="site-header" data-elevated="false">
  <a href="#main" class="skip-link">Skip to content</a>
  <div class="site-header__inner container container--wide">
    <Brandmark size={28} />

    <nav class="site-nav" aria-label="Primary">
      <ul>
        {
          HEADER_NAV.map((item) => {
            const active = isActive(item.href);
            const dd = item.dropdown;
            if (dd) {
              const ddActive = dd.some((d) => isActive(d.href)) || active;
              return (
                <li class="site-nav__drop">
                  <a
                    href={item.href}
                    class="site-nav__trigger"
                    aria-current={ddActive ? "page" : undefined}
                    data-active={ddActive}
                    aria-haspopup="true"
                  >
                    {item.label}
                    <svg
                      class="site-nav__chev"
                      viewBox="0 0 12 12"
                      width="10"
                      height="10"
                      aria-hidden="true"
                    >
                      <path
                        d="M3 4.5L6 7.5L9 4.5"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.4"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </a>
                  <ul class="site-nav__menu" role="menu">
                    {dd.map((d) => (
                      <li role="none">
                        <a role="menuitem" href={d.href} data-active={isActive(d.href)}>
                          {d.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </li>
              );
            }
            return (
              <li>
                <a href={item.href} aria-current={active ? "page" : undefined} data-active={active}>
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="site-header__cta">
      <button
        class="theme-toggle"
        type="button"
        aria-label="Toggle light or dark theme"
        title="Toggle theme"
      >
        <svg
          class="icon-moon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path></svg
        >
        <svg
          class="icon-sun"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><circle cx="12" cy="12" r="4"></circle><path
            d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"
          ></path></svg
        >
      </button>
      <a
        class="btn btn--small btn--ghost"
        href={SITE.github}
        target="_blank"
        rel="noopener noreferrer"
        data-analytics-event="nav.external.clicked"
        data-analytics-prop-destination="github"
      >
        GitHub
      </a>
      <a
        class="btn btn--small btn--ember"
        href="/download"
        data-analytics-event="download.cta.clicked"
        data-analytics-prop-placement="header"
      >
        Download
        <span class="btn-arrow" aria-hidden="true">→</span>
      </a>
    </div>

    <button
      class="site-header__menu"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Open menu"
    >
      <span></span><span></span><span></span>
    </button>
  </div>

  <div id="mobile-nav" class="mobile-nav" hidden>
    <ul>
      {
        MOBILE_NAV.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))
      }
      <li>
        <a
          href={SITE.github}
          target="_blank"
          rel="noopener noreferrer"
          data-analytics-event="nav.external.clicked"
          data-analytics-prop-destination="github">GitHub</a
        >
      </li>
      <li>
        <a
          class="btn btn--ember"
          href="/download"
          data-analytics-event="download.cta.clicked"
          data-analytics-prop-placement="mobile_nav"
          data-analytics-prop-platform="macos"
        >
          Download for macOS
          <span class="btn-arrow" aria-hidden="true">→</span>
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  // Elevation on scroll. Write the attribute only when the state flips:
  // a per-event style write interleaves with other scroll handlers' rect
  // reads and forces a synchronous style/layout recalc on every tick.
  const header = document.querySelector(".site-header");
  if (header) {
    let elevated: boolean | null = null;
    const onScroll = () => {
      const next = window.scrollY > 8;
      if (next === elevated) return;
      elevated = next;
      header.setAttribute("data-elevated", next ? "true" : "false");
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }

  // Mobile nav toggle
  const toggle = document.querySelector<HTMLButtonElement>(".site-header__menu");
  const mobile = document.querySelector<HTMLElement>("#mobile-nav");
  if (toggle && mobile) {
    toggle.addEventListener("click", () => {
      const open = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!open));
      if (open) {
        mobile.setAttribute("hidden", "");
      } else {
        mobile.removeAttribute("hidden");
      }
    });
    mobile.addEventListener("click", (e) => {
      if (e.target instanceof HTMLAnchorElement) {
        toggle.setAttribute("aria-expanded", "false");
        mobile.setAttribute("hidden", "");
      }
    });
  }

  // Light / dark theme toggle (persisted; FOUC-guarded in BaseLayout head)
  const themeBtn = document.querySelector<HTMLButtonElement>(".theme-toggle");
  if (themeBtn) {
    themeBtn.addEventListener("click", () => {
      const root = document.documentElement;
      const next = root.getAttribute("data-theme") === "light" ? "dark" : "light";
      root.setAttribute("data-theme", next);
      try {
        localStorage.setItem("burnbar-theme", next);
      } catch {
        /* storage blocked */
      }
      const meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute("content", next === "light" ? "#f6f4ee" : "#07060a");
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    transition:
      background var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out);
    background: color-mix(in oklab, var(--ink-void) 70%, transparent);
    backdrop-filter: blur(20px) saturate(140%);
    -webkit-backdrop-filter: blur(20px) saturate(140%);
    border-bottom: 1px solid transparent;
  }
  .site-header[data-elevated="true"] {
    background: color-mix(in oklab, var(--ink-void) 90%, transparent);
    border-bottom-color: var(--ink-line-soft);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--s-5);
    padding-block: 0.85rem;
  }
  .site-nav {
    flex: 1;
    display: flex;
    justify-content: center;
  }
  .site-nav ul {
    display: flex;
    gap: 0.1rem;
    align-items: center;
  }
  .site-nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    padding: 0.4rem 0.65rem;
    border-radius: var(--r-3);
    font-size: 0.85rem;
    white-space: nowrap;
    color: var(--text-mute);
    transition:
      color var(--dur-fast) var(--ease-out),
      background var(--dur-fast) var(--ease-out);
  }
  .site-nav a:hover {
    color: var(--text-bright);
    background: var(--ink-surface);
  }
  .site-nav a[data-active="true"] {
    color: var(--text-bright);
    background: var(--ink-surface);
  }
  .site-nav__chev {
    opacity: 0.5;
    transition:
      opacity var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }
  .site-nav__drop:hover .site-nav__chev {
    opacity: 0.95;
  }
  .site-nav__drop {
    position: relative;
  }
  .site-nav__menu {
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%) translateY(4px);
    min-width: 180px;
    display: grid;
    gap: 1px;
    padding: 6px;
    background: var(--glass-bg-elevated);
    backdrop-filter: blur(28px) saturate(180%);
    -webkit-backdrop-filter: blur(28px) saturate(180%);
    border: 1px solid var(--ink-line);
    border-radius: var(--r-md);
    box-shadow:
      0 12px 40px -16px rgba(0, 0, 0, 0.55),
      0 1px 0 var(--ink-line-soft);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
    z-index: 30;
  }
  .site-nav__drop:hover .site-nav__menu,
  .site-nav__drop:focus-within .site-nav__menu {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }
  .site-nav__menu a {
    display: flex;
    width: 100%;
    padding: 0.55rem 0.75rem;
    border-radius: var(--r-3);
    font-size: 0.84rem;
  }
  .site-nav__menu a:hover {
    background: var(--ink-surface);
  }
  .site-header__cta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: none;
  }
  /* The row is one non-wrapping flex line, so its floor is the sum of the
     brand, the CTA cluster and the menu button. Flex shrink cannot take an
     item below its min-content width, so on a 320px phone the line used to
     stay 372px wide, paint outside the header and mint a document-level
     horizontal scrollbar. The CTA cluster and the menu button hold their
     intrinsic size; the brand is the one item allowed to give, and below the
     narrow breakpoint it gives by dropping the wordmark, never the logo. */
  .site-header__inner > :global(.brand) {
    flex: 0 1 auto;
    min-width: 0;
  }
  .site-header__menu {
    display: none;
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: var(--r-3);
    border: 1px solid var(--ink-line);
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
  }
  .site-header__menu span {
    display: block;
    width: 16px;
    height: 1.5px;
    background: var(--text-base);
    border-radius: 1px;
  }
  .mobile-nav {
    border-top: 1px solid var(--ink-line);
    background: var(--ink-void);
    padding: var(--s-5);
  }
  .mobile-nav ul {
    display: grid;
    gap: var(--s-3);
  }
  .mobile-nav a {
    display: block;
    padding: 0.75rem 0;
    font-size: 1.1rem;
    color: var(--text-bright);
  }
  @media (max-width: 1024px) {
    .site-nav {
      display: none;
    }
    .site-header__cta .btn--ghost {
      display: none;
    }
    .site-header__menu {
      display: inline-flex;
    }
  }
  @media (min-width: 1025px) {
    .mobile-nav {
      display: none !important;
    }
  }
  /* Narrow phones: tighten the row gap and retire the wordmark so the logo,
     the theme toggle, the download CTA and the menu button all fit inside a
     320px layout width with room to spare. The logo mark still links home and
     still carries the "OpenBurnBar — home" label. */
  @media (max-width: 480px) {
    .site-header__inner {
      gap: var(--s-3);
    }
    .site-header__inner :global(.wordmark) {
      display: none;
    }
  }
</style>
