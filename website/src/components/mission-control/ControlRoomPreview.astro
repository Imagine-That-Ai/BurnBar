---
/**
 * Interactive concept of the Afar control room.
 *
 * It is an illustration, labeled as one. Nothing here connects to, reads from
 * or controls a device, so every environment stays "Not set up", every step of
 * the readiness ladder stays "Not checked", and the one action per room is a
 * dashed, labeled example taken from the profile shape in the setup brief.
 *
 * Selection is a native radio group, so arrow keys, Tab and screen readers all
 * work without script. A small script adds swipe on the portrait composition
 * (a scroll-snap track kept in sync with the radios); without it, every layout
 * still shows the selected environment.
 *
 * Compositions (not one layout shrunk):
 *   wide        sidebar · active environment · readiness context rail
 *   medium      sidebar · active environment, readiness across the bottom
 *   portrait    swipeable environment track, places bar within thumb reach
 *   landscape   icon rail · active environment · compact readiness rail
 */
import AfarLogo from "./AfarLogo.astro";
import { MISSION_CONTROL_VOICE as voice } from "@data/mission-control";

const environments = [
  {
    id: "mac",
    name: "My Mac",
    kind: "This computer",
    transport: "Local",
    accent: "pink",
    icon: "M4 6.5A1.5 1.5 0 0 1 5.5 5h13A1.5 1.5 0 0 1 20 6.5V15H4zM2 17h20l-1 2H3z",
    action: { name: "Check hostname", executable: "/bin/hostname", args: "", timeout: 10 }
  },
  {
    id: "linux",
    name: "Remote Linux",
    kind: "Over your SSH config",
    transport: "SSH",
    accent: "orange",
    icon: "M3 5h18v14H3zM6.5 9.5 9 12l-2.5 2.5M11 15h5",
    action: { name: "Check OS version", executable: "/usr/bin/uname", args: '"-sr"', timeout: 10 }
  },
  {
    id: "windows",
    name: "Windows PC",
    kind: "Over your SSH config",
    transport: "SSH",
    accent: "canary",
    icon: "M4 5.5 11 4.5V11.5H4zM13 4.2l7-1v8.3h-7zM4 12.5h7v7l-7-1zM13 12.5h7v8.3l-7-1z",
    action: {
      name: "Check hostname",
      executable: "C:\\Windows\\System32\\hostname.exe",
      args: "",
      timeout: 10
    }
  }
];

const ladder = ["Configured", "Reachable", "Authenticated", "Task-ready"];
---

<figure class="room" data-room aria-labelledby="room-caption">
  <figcaption id="room-caption" class="room-caption">
    <span class="room-caption__tag">Interactive concept</span>
    <span>Illustrative environments. This preview does not connect to or control a device.</span>
  </figcaption>

  <div class="room-window">
    <div class="room-bar" aria-hidden="true">
      <span class="room-lights">
        <i></i>
        <i></i>
        <i></i>
      </span>
      <span class="room-title">
        <AfarLogo size={16} eager />
        Afar
      </span>
      <span class="room-bar__end">Portable edition</span>
    </div>

    <div class="room-body">
      <fieldset class="room-places">
        <legend>Your environments</legend>
        {environments.map((env, index) => (
          <div class="place">
            <input
              type="radio"
              name="mc-room"
              id={`room-${env.id}`}
              value={env.id}
              checked={index === 0}
              aria-controls={`room-panel-${env.id}`}
            />
            <label for={`room-${env.id}`} class={`accent-${env.accent}`}>
              <span class="place-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18">
                  <path d={env.icon} />
                </svg>
              </span>
              <span class="place-text">
                <strong>{env.name}</strong>
                <small>Not set up</small>
              </span>
            </label>
          </div>
        ))}
        <a class="place-add" href="#setup">
          <span aria-hidden="true">+</span>
          <span>Add your own</span>
        </a>
      </fieldset>

      <div class="room-stage" data-room-track>
        {environments.map((env) => (
          <section
            id={`room-panel-${env.id}`}
            class={`room-panel accent-${env.accent}`}
            data-env={env.id}
            aria-label={`${env.name}, concept`}
          >
            <header class="panel-head">
              <div>
                <p class="panel-kind">
                  {env.kind} · {env.transport}
                </p>
                <h3>{env.name}</h3>
              </div>
              <span class="state-pill">
                <span aria-hidden="true" /> Not set up
              </span>
            </header>

            <div class="panel-empty">
              <span class="panel-glyph" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="28" height="28">
                  <path d={env.icon} />
                </svg>
              </span>
              <h4>{voice.empty}</h4>
              <p>Its connection, permitted actions and results will live here.</p>
            </div>

            <div class="panel-actions">
              <p class="panel-label">
                Actions <span>Example · not configured</span>
              </p>
              <div class="example-action">
                <span class="example-action__name">{env.action.name}</span>
                <code>
                  {env.action.executable}
                  {env.action.args && <span> [{env.action.args}]</span>}
                </code>
                <span class="example-action__meta">Diagnostic · {env.action.timeout} s limit</span>
              </div>
            </div>

            <div class="panel-results">
              <p class="panel-label">Results</p>
              <p class="panel-results__empty">Nothing has run here yet.</p>
            </div>
          </section>
        ))}
      </div>

      <aside class="room-context" aria-label="Readiness, concept">
        <p class="panel-label">Before anything runs</p>
        <ol class="ladder">
          {ladder.map((step) => (
            <li>
              <span class="ladder-dot" aria-hidden="true" />
              <span class="ladder-step">{step}</span>
              <span class="ladder-state">Not checked</span>
            </li>
          ))}
        </ol>
        <p class="room-humility">{voice.humility}</p>
      </aside>
    </div>
  </div>

  <p class="room-hint">
    <span class="hint-keys">Use arrow keys to move between environments.</span>
    <span class="hint-tap">Tap an environment to move between them.</span>
    <span class="hint-swipe">Swipe, or tap a place below, to move between environments.</span>
  </p>
</figure>

<script>
  // Swipe for the portrait composition: the stage becomes a scroll-snap
  // track and stays in sync with the radio group in both directions.
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

  for (const room of document.querySelectorAll<HTMLElement>("[data-room]")) {
    const track = room.querySelector<HTMLElement>("[data-room-track]");
    const radios = [...room.querySelectorAll<HTMLInputElement>('input[name="mc-room"]')];
    if (!track || radios.length === 0) continue;
    room.dataset.enhanced = "";

    const isTrack = () => getComputedStyle(track).overflowX !== "visible";
    const panelFor = (radio: HTMLInputElement) =>
      track.querySelector<HTMLElement>(`[data-env="${radio.value}"]`);

    for (const radio of radios) {
      radio.addEventListener("change", () => {
        const panel = panelFor(radio);
        if (!panel || !isTrack()) return;
        track.scrollTo({ left: panel.offsetLeft, behavior: reduce.matches ? "auto" : "smooth" });
      });
    }

    let frame = 0;
    track.addEventListener(
      "scroll",
      () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => {
          if (!isTrack()) return;
          const index = Math.round(track.scrollLeft / Math.max(track.clientWidth, 1));
          const radio = radios[Math.min(Math.max(index, 0), radios.length - 1)];
          if (radio && !radio.checked) radio.checked = true;
        });
      },
      { passive: true }
    );
  }
</script>

<style>
  .room {
    margin: 0;
    text-align: left;
  }
  .room-caption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--mc-cluster) var(--mc-control);
    margin-bottom: var(--mc-inset);
    font-size: var(--mc-caption);
    letter-spacing: var(--mc-caption-track);
    color: var(--mc-muted);
  }
  .room-caption__tag {
    padding: var(--mc-row) var(--mc-cluster);
    border: 1px solid var(--mc-border-strong);
    border-radius: var(--mc-r-full);
    color: var(--mc-text);
    font-weight: var(--wght-medium);
  }

  /* ── Window ─────────────────────────────────────────────────────────── */
  .room-window {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--mc-border-strong);
    border-radius: var(--mc-r-xl);
    background: var(--mc-glass);
    box-shadow:
      inset 0 1px 0 var(--mc-glass-edge),
      var(--mc-shadow-2),
      0 48px 120px -48px color-mix(in srgb, var(--mc-pink) 45%, transparent);
    backdrop-filter: blur(28px) saturate(1.4);
    -webkit-backdrop-filter: blur(28px) saturate(1.4);
  }
  .room-bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: var(--mc-control) var(--mc-inset);
    border-bottom: 1px solid var(--mc-border);
    font-size: var(--mc-label);
    letter-spacing: var(--mc-label-track);
    color: var(--mc-muted);
  }
  .room-lights {
    display: flex;
    gap: 7px;
  }
  .room-lights i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--mc-border-strong);
  }
  .room-title {
    display: inline-flex;
    align-items: center;
    gap: var(--mc-cluster);
    color: var(--mc-text);
    font-weight: var(--wght-medium);
  }
  .room-bar__end {
    justify-self: end;
    font-size: var(--mc-caption);
  }

  .room-body {
    display: grid;
    grid-template-columns: var(--mc-sidebar) minmax(0, 1fr) var(--mc-context);
    grid-template-areas: "places stage context";
    min-height: 460px;
  }

  /* ── Places (sidebar / rail / bottom bar) ───────────────────────────── */
  .room-places {
    grid-area: places;
    display: flex;
    flex-direction: column;
    gap: var(--mc-row);
    min-width: 0;
    margin: 0;
    padding: var(--mc-inset) var(--mc-control);
    border: 0;
    border-right: 1px solid var(--mc-border);
    background: var(--mc-sidebar-fill);
  }
  .room-places legend {
    float: left;
    width: 100%;
    padding: 0 var(--mc-cluster) var(--mc-control);
    font-size: var(--mc-caption);
    letter-spacing: var(--mc-caption-track);
    color: var(--mc-muted);
  }
  .place {
    position: relative;
  }
  .place input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .place label {
    display: flex;
    align-items: center;
    gap: var(--mc-control);
    padding: var(--mc-cluster);
    border-radius: var(--mc-r-md);
    border: 1px solid transparent;
    cursor: pointer;
    transition:
      background-color var(--mc-snappy) var(--mc-ease),
      border-color var(--mc-snappy) var(--mc-ease),
      box-shadow var(--mc-snappy) var(--mc-ease);
  }
  .place input:hover + label {
    background: var(--mc-hover);
  }
  .place input:checked + label {
    background: var(--mc-selected);
    border-color: var(--mc-border-strong);
    box-shadow: var(--mc-shadow-1);
  }
  .place input:focus-visible + label {
    outline: 2px solid var(--mc-focus);
    outline-offset: 2px;
  }
  .place-icon,
  .panel-glyph {
    display: grid;
    place-items: center;
    flex: none;
    border-radius: var(--mc-r-sm);
    background: var(--accent);
    color: var(--mc-ink);
  }
  .place-icon {
    width: 32px;
    height: 32px;
  }
  .place-icon svg,
  .panel-glyph svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .place-text {
    display: grid;
    min-width: 0;
  }
  .place-text strong {
    font-size: var(--mc-label);
    font-weight: var(--wght-medium);
    color: var(--mc-text);
    white-space: nowrap;
  }
  .place-text small {
    font-size: var(--mc-caption);
    color: var(--mc-muted);
  }
  .accent-pink {
    --accent: var(--mc-pink);
  }
  .accent-orange {
    --accent: var(--mc-orange);
  }
  .accent-canary {
    --accent: var(--mc-canary);
  }
  .place-add {
    display: flex;
    align-items: center;
    gap: var(--mc-control);
    margin-top: auto;
    padding: var(--mc-cluster);
    border-radius: var(--mc-r-md);
    color: var(--mc-muted);
    font-size: var(--mc-label);
    text-decoration: none;
  }
  .place-add > span:first-child {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 1px dashed var(--mc-border-strong);
    border-radius: var(--mc-r-sm);
    font-size: var(--mc-headline);
  }
  .place-add:hover {
    color: var(--mc-text);
  }
  .place-add:hover > span:first-child {
    border-color: var(--mc-text);
  }
  .place-add:focus-visible {
    outline: 2px solid var(--mc-focus);
    outline-offset: 2px;
  }

  /* ── Stage and panels ───────────────────────────────────────────────── */
  .room-stage {
    grid-area: stage;
    min-width: 0;
    display: flex;
  }
  .room-panel {
    display: none;
    flex: 0 0 100%;
    flex-direction: column;
    gap: var(--mc-section);
    padding: var(--mc-section);
  }
  .room-body:has(#room-mac:checked) [data-env="mac"],
  .room-body:has(#room-linux:checked) [data-env="linux"],
  .room-body:has(#room-windows:checked) [data-env="windows"] {
    display: flex;
    animation: mc-panel-in var(--mc-standard) var(--mc-ease);
  }
  @keyframes mc-panel-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  .panel-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--mc-inset);
  }
  .panel-kind {
    margin: 0;
    font-size: var(--mc-caption);
    letter-spacing: var(--mc-caption-track);
    color: var(--mc-muted);
  }
  .panel-head h3 {
    margin: var(--mc-row) 0 0;
    font-size: var(--mc-title);
    letter-spacing: var(--mc-title-track);
    font-weight: var(--wght-semibold);
    line-height: 1.15;
    color: var(--mc-text);
  }
  .state-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex: none;
    padding: var(--mc-row) var(--mc-cluster);
    border: 1px solid var(--mc-border-strong);
    border-radius: var(--mc-r-full);
    font-size: var(--mc-caption);
    color: var(--mc-muted);
  }
  .state-pill > span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    border: 1.5px solid currentColor;
  }
  .panel-empty {
    display: grid;
    justify-items: center;
    gap: var(--mc-cluster);
    padding: var(--mc-control) 0;
    text-align: center;
  }
  .panel-glyph {
    width: 56px;
    height: 56px;
    margin-bottom: var(--mc-cluster);
    border-radius: var(--mc-r-lg);
    box-shadow:
      0 0 0 10px color-mix(in srgb, var(--accent) 14%, transparent),
      0 0 0 22px color-mix(in srgb, var(--accent) 6%, transparent);
  }
  .panel-empty h4 {
    margin: var(--mc-cluster) 0 0;
    font-size: var(--mc-headline);
    letter-spacing: var(--mc-headline-track);
    font-weight: var(--wght-medium);
    color: var(--mc-text);
  }
  .panel-empty p {
    margin: 0;
    max-width: 30ch;
    font-size: var(--mc-label);
    line-height: 1.5;
    color: var(--mc-muted);
  }
  .panel-label {
    display: flex;
    justify-content: space-between;
    gap: var(--mc-cluster);
    margin: 0 0 var(--mc-cluster);
    font-size: var(--mc-caption);
    letter-spacing: var(--mc-caption-track);
    color: var(--mc-muted);
  }
  .panel-label span {
    color: var(--mc-accent-text);
  }
  .example-action {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--mc-row) var(--mc-control);
    padding: var(--mc-control) var(--mc-inset);
    border: 1px dashed var(--mc-border-strong);
    border-radius: var(--mc-r-md);
  }
  .example-action__name {
    font-size: var(--mc-label);
    font-weight: var(--wght-medium);
    color: var(--mc-text);
  }
  .example-action__meta {
    grid-row: 1;
    grid-column: 2;
    font-size: var(--mc-caption);
    color: var(--mc-muted);
    text-align: right;
  }
  .example-action code {
    grid-column: 1 / -1;
    font-family: var(--font-mono);
    font-size: var(--mc-caption);
    color: var(--mc-muted);
    overflow-wrap: anywhere;
  }
  .panel-results {
    margin-top: auto;
  }
  .panel-results__empty {
    margin: 0;
    padding-top: var(--mc-cluster);
    border-top: 1px solid var(--mc-border);
    font-size: var(--mc-label);
    color: var(--mc-muted);
  }

  /* ── Readiness context ──────────────────────────────────────────────── */
  .room-context {
    grid-area: context;
    display: flex;
    flex-direction: column;
    padding: var(--mc-section) var(--mc-inset);
    border-left: 1px solid var(--mc-border);
    background: var(--mc-sidebar-fill);
  }
  .ladder {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ladder li {
    position: relative;
    display: grid;
    grid-template-columns: 12px 1fr;
    column-gap: var(--mc-control);
    padding: var(--mc-cluster) 0 var(--mc-control);
  }
  .ladder li:not(:last-child)::after {
    content: "";
    position: absolute;
    left: 5px;
    top: 26px;
    bottom: -6px;
    border-left: 1px dashed var(--mc-border-strong);
  }
  .ladder-dot {
    grid-row: span 2;
    width: 11px;
    height: 11px;
    margin-top: 4px;
    border-radius: 50%;
    border: 1.5px solid var(--mc-border-strong);
  }
  .ladder-step {
    font-size: var(--mc-label);
    font-weight: var(--wght-medium);
    color: var(--mc-text);
  }
  .ladder-state {
    font-size: var(--mc-caption);
    color: var(--mc-muted);
  }
  .room-humility {
    margin: auto 0 0;
    padding-top: var(--mc-inset);
    font-size: var(--mc-caption);
    line-height: 1.5;
    color: var(--mc-muted);
  }
  .room-hint {
    margin: var(--mc-inset) 0 0;
    text-align: center;
    font-size: var(--mc-caption);
    color: var(--mc-muted);
  }
  .hint-tap,
  .hint-swipe {
    display: none;
  }
  @media (pointer: coarse) {
    .hint-keys {
      display: none;
    }
    .hint-tap {
      display: inline;
    }
  }

  /* ── Medium: readiness moves under the active environment ───────────── */
  @media (max-width: 1080px) {
    .room-body {
      grid-template-columns: var(--mc-sidebar) minmax(0, 1fr);
      grid-template-areas:
        "places stage"
        "places context";
    }
    .room-context {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--mc-cluster) var(--mc-section);
      padding: var(--mc-inset) var(--mc-section);
      border-left: 0;
      border-top: 1px solid var(--mc-border);
    }
    .room-context .panel-label {
      margin: 0;
    }
    .ladder {
      grid-auto-flow: column;
      gap: var(--mc-inset);
    }
    .ladder li {
      padding: 0;
    }
    .ladder li::after {
      display: none;
    }
    .room-humility {
      flex-basis: 100%;
      margin: 0;
      padding: 0;
    }
  }

  /* ── Portrait phone: one focused environment, places within thumb reach ─ */
  @media (max-width: 640px) and (orientation: portrait), (max-width: 480px) {
    .room-bar {
      grid-template-columns: auto 1fr;
    }
    .room-lights {
      display: none;
    }
    .room-bar__end {
      font-size: var(--mc-caption);
    }
    .room-body {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        "stage"
        "context"
        "places";
      min-height: 0;
    }
    [data-enhanced] .room-stage {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      overscroll-behavior-x: contain;
    }
    [data-enhanced] .room-stage::-webkit-scrollbar {
      display: none;
    }
    [data-enhanced] .room-panel {
      display: flex;
      scroll-snap-align: start;
      scroll-snap-stop: always;
    }
    /* The track itself is the motion; no extra entrance on swipe. */
    [data-enhanced] .room-body:has(#room-mac:checked) [data-env="mac"],
    [data-enhanced] .room-body:has(#room-linux:checked) [data-env="linux"],
    [data-enhanced] .room-body:has(#room-windows:checked) [data-env="windows"] {
      animation: none;
    }
    .room-panel {
      padding: var(--mc-page);
      gap: var(--mc-page);
    }
    .room-context {
      flex-direction: column;
      flex-wrap: nowrap;
      align-items: stretch;
      padding: var(--mc-inset) var(--mc-page);
    }
    .ladder {
      grid-auto-flow: row;
      grid-template-columns: 1fr 1fr;
      gap: var(--mc-cluster) var(--mc-inset);
    }
    .room-places {
      flex-direction: row;
      align-items: stretch;
      gap: var(--mc-row);
      padding: var(--mc-cluster);
      border-right: 0;
      border-top: 1px solid var(--mc-border);
    }
    .room-places legend {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      overflow: hidden;
      clip-path: inset(50%);
    }
    .place {
      flex: 1 1 0;
      min-width: 0;
    }
    .place label {
      flex-direction: column;
      gap: var(--mc-row);
      min-height: var(--mc-places-bar);
      padding: var(--mc-cluster) var(--mc-row);
      text-align: center;
    }
    .place-text strong {
      font-size: var(--mc-caption);
      white-space: normal;
