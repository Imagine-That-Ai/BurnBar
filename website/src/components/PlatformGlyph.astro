---
/**
 * Shared platform glyph primitive.
 *
 * Single source of truth for platform logos and their intrinsic brand path
 * colors. Consumed by `SurfaceIcon.astro` (site-wide surface cards) and
 * `DownloadPlatformIcon.astro` (download page tiles); contexts control
 * sizing and `currentColor` tinting, glyph shapes live only here.
 */
import type { PlatformGlyphId } from "../types/platform";

interface Props {
  id: PlatformGlyphId;
}

const { id } = Astro.props;
---

{
  id === "macos" && (
    <svg
      class="icon icon-apple"
      viewBox="0 0 24 24"
      fill="currentColor"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701" />
    </svg>
  )
}

{
  id === "ios" && (
    <svg
      class="icon icon-apple icon-ios"
      viewBox="0 0 24 24"
      fill="currentColor"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701" />
    </svg>
  )
}

{
  id === "cursor" && (
    <div class="icon-dual">
      {/* Official VS Code Blue Logo */}
      <svg class="icon-dual__vscode" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path
          fill="#007ACC"
          d="M23.15 2.587L18.21.21a1.494 1.494 0 0 0-1.705.29l-9.46 8.63-4.12-3.128a.999.999 0 0 0-1.276.057L.327 7.261A1 1 0 0 0 .326 8.74L3.899 12 .326 15.26a1 1 0 0 0 .001 1.479L1.65 17.94a.999.999 0 0 0 1.276.057l4.12-3.128 9.46 8.63a1.492 1.492 0 0 0 1.704.29l4.942-2.377A1.5 1.5 0 0 0 24 20.06V3.939a1.5 1.5 0 0 0-.85-1.352zm-5.146 14.861L10.826 12l7.178-5.448v10.896z"
        />
      </svg>
      {/* Official Cursor Teal Logo */}
      <svg class="icon-dual__cursor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path
          fill="#5FF5D2"
          fill-rule="evenodd"
          clip-rule="evenodd"
          d="M22.106 5.68L12.5.135a.998.998 0 00-.998 0L1.893 5.68a.84.84 0 00-.419.726v11.186c0 .3.16.577.42.727l9.607 5.547a.999.999 0 00.998 0l9.608-5.547a.84.84 0 00.42-.727V6.407a.84.84 0 00-.42-.726zm-.603 1.176L12.228 22.92c-.063.108-.228.064-.228-.061V12.34a.59.59 0 00-.295-.51l-9.11-5.26c-.107-.062-.063-.228.062-.228h18.55c.264 0 .428.286.296.514z"
        />
      </svg>
    </div>
  )
}

{
  id === "cursor-plugin" && (
    <div class="icon-dual">
      {/* Cursor Teal Logo (plugin lives inside Cursor) */}
      <svg class="icon-dual__cursor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path
          fill="#5FF5D2"
          fill-rule="evenodd"
          clip-rule="evenodd"
          d="M22.106 5.68L12.5.135a.998.998 0 00-.998 0L1.893 5.68a.84.84 0 00-.419.726v11.186c0 .3.16.577.42.727l9.607 5.547a.999.999 0 00.998 0l9.608-5.547a.84.84 0 00.42-.727V6.407a.84.84 0 00-.42-.726zm-.603 1.176L12.228 22.92c-.063.108-.228.064-.228-.061V12.34a.59.59 0 00-.295-.51l-9.11-5.26c-.107-.062-.063-.228.062-.228h18.55c.264 0 .428.286.296.514z"
        />
      </svg>
      {/* Puzzle-piece plugin marker */}
      <svg
        class="icon-dual__plugin"
        viewBox="0 0 24 24"
        fill="none"
        stroke="#FDC42C"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M14 3.5v2.1a1.9 1.9 0 003.4 1.15L18.6 5.5a3.9 3.9 0 011.1 3.1 3.9 3.9 0 01-3.4 3.9v3.7a1.9 1.9 0 001.9 1.9h2.3" />
        <path d="M10 3.5v2.1a1.9 1.9 0 01-3.4 1.15L5.4 5.5a3.9 3.9 0 00-1.1 3.1 3.9 3.9 0 003.4 3.9v3.7a1.9 1.9 0 01-1.9 1.9H3.5" />
      </svg>
    </div>
  )
}

{
  id === "daemon" && (
    <svg
      class="icon icon-daemon"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <rect x="2" y="4" width="20" height="6" rx="1.5" fill="rgba(255,255,255,0.03)" />
      <rect x="2" y="14" width="20" height="6" rx="1.5" fill="rgba(255,255,255,0.03)" />
      <circle cx="6" cy="7" r="1.2" fill="#E87060" stroke="none" />
      <circle cx="6" cy="17" r="1.2" fill="#2CCAC0" stroke="none" />
      <path d="M11 7h7M11 17h7" stroke="currentColor" stroke-linecap="round" stroke-width="1.5" />
      <line x1="15" y1="7" x2="18" y2="7" stroke="currentColor" />
    </svg>
  )
}

{
  id === "cli" && (
    <svg
      class="icon icon-cli"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <polyline points="4 17 10 11 4 5" stroke="#2CCAC0" />
      <line x1="12" y1="19" x2="20" y2="19" stroke="#E87060" />
    </svg>
  )
}

{
  id === "widgets" && (
    <svg
      class="icon icon-widgets"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <rect x="3" y="3" width="7" height="9" rx="1.5" fill="rgba(255,255,255,0.02)" />
      <rect x="14" y="3" width="7" height="5" rx="1.5" fill="rgba(255,255,255,0.02)" />
      <rect x="3" y="16" width="18" height="5" rx="1.5" fill="rgba(255,255,255,0.02)" />
      <path
        d="M5 18.5l3.5-2 3 2.5 4.5-3 3 1.5"
        stroke="#E87060"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        fill="none"
      />
    </svg>
  )
}

{
  id === "linux" && (
    <svg
      class="icon icon-linux"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M8 7.8c0-2.5 1.5-4.3 4-4.3s4 1.8 4 4.3v2.5c0 1.2.5 2.2 1.3 3.2.8 1 1.2 2.1.9 3.5-.5 2.3-2.7 3.5-6.2 3.5s-5.7-1.2-6.2-3.5c-.3-1.4.1-2.5.9-3.5.8-1 1.3-2 1.3-3.2V7.8z" />
      <path d="M9.1 17.1c1.8.8 4 .8 5.8 0" stroke="#FCB827" />
      <circle cx="10.2" cy="7.9" r=".7" fill="#FCB827" stroke="none" />
      <circle cx="13.8" cy="7.9" r=".7" fill="#FCB827" stroke="none" />
      <path d="M10.2 11.2h3.6l-1.8 1.5-1.8-1.5z" fill="#E87060" stroke="none" />
    </svg>
  )
}

{
  id === "smart-display" && (
    <svg class="icon icon-google" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
      <path
        fill="#4285F4"
        d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
      />
      <path
        fill="#34A853"
        d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
      />
      <path
        fill="#FBBC05"
        d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"
      />
      <path
        fill="#EA4335"
        d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
      />
    </svg>
  )
}

{
  id === "android" && (
    <svg class="icon icon-android" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
      <path
        fill="#3DDC84"
        d="M18.4395 5.5586c-.675 1.1664-1.352 2.3318-2.0274 3.498-.0366-.0155-.0742-.0286-.1113-.043-1.8249-.6957-3.484-.8-4.42-.787-1.8551.0185-3.3544.4643-4.2597.8203-.084-.1494-1.7526-3.021-2.0215-3.4864a1.1451 1.1451 0 0 0-.1406-.1914c-.3312-.364-.9054-.4859-1.379-.203-.475.282-.7136.9361-.3886 1.5019 1.9466 3.3696-.0966-.2158 1.9473 3.3593.0172.031-.4946.2642-1.3926 1.0177C2.8987 12.176.452 14.772 0 18.9902h24c-.119-1.1108-.3686-2.099-.7461-3.0683-.7438-1.9118-1.8435-3.2928-2.7402-4.1836a12.1048 12.1048 0 0 0-2.1309-1.6875c.6594-1.122 1.312-2.2559 1.9649-3.3848.2077-.3615.1886-.7956-.0079-1.1191a1.1001 1.1001 0 0 0-.8515-.5332c-.5225-.0536-.9392.3128-1.0488.5449zm-.0391 8.461c.3944.5926.324 1.3306-.1563 1.6503-.4799.3197-1.188.0985-1.582-.4941-.3944-.5927-.324-1.3307.1563-1.6504.4727-.315 1.1812-.1086 1.582.4941zM7.207 13.5273c.4803.3197.5506 1.0577.1563 1.6504-.394.5926-1.1038.8138-1.584.4941-.48-.3197-.5503-1.0577-.1563-1.6504.4008-.6021 1.1087-.8106 1.584-.4941z"
      />
    </svg>
  )
}

<style>
  /* Dual-glyph composition (VS Code + Cursor) is intrinsic to the glyph. */
  .icon-dual {
    position: relative;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform var(--dur-base) var(--ease-out);
  }

  .icon-dual__vscode {
    position: absolute;
    width: 18px;
    height: 18px;
    left: 2px;
    top: 2px;
    z-index: 1;
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.3));
    transition: transform var(--dur-base) var(--ease-out);
  }

  .icon-dual__cursor {
    position: absolute;
    width: 18px;
    height: 18px;
    right: 2px;
    bottom: 2px;
    z-index: 2;
    filter: drop-shadow(-1px 2px 4px rgba(0, 0, 0, 0.4));
    transition: transform var(--dur-base) var(--ease-out);
  }

  /* plugin marker overlays the Cursor tile for the marketplace-plugin glyph */
  .icon-dual__plugin {
    position: absolute;
    width: 14px;
    height: 14px;
    left: 3px;
    top: 3px;
    z-index: 3;
    filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.5));
  }
</style>
