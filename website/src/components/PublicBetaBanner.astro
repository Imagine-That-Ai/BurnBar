---
import { SITE } from "@data/site";

const beta = SITE.publicBeta;
const mailHref = `mailto:${SITE.supportContact}?subject=${encodeURIComponent(beta.mailtoSubject)}`;
const formHref = beta.feedbackFormUrl.trim();
const primaryFeedbackHref = formHref || beta.discussionsUrl;
const primaryFeedbackLabel = formHref ? "Send feedback" : "Open Discussions";
---

<aside class="public-beta" role="region" aria-label="Public beta notice">
  <div class="public-beta__inner container container--wide">
    <p class="public-beta__copy">
      <span class="public-beta__label mono">{beta.label}</span>
      <span class="public-beta__text">{beta.shortBlurb}</span>
    </p>
    <div class="public-beta__actions">
      <a class="public-beta__link" href="/download">Download Mac</a>
      <a
        class="public-beta__link"
        href={primaryFeedbackHref}
        target="_blank"
        rel="noopener noreferrer">{primaryFeedbackLabel}</a
      >
      <a class="public-beta__link public-beta__link--quiet" href={mailHref}>Email support</a>
    </div>
  </div>
</aside>

<style>
  .public-beta {
    position: relative;
    /* Stay below the sticky header (z-index: 20 in Header.astro) so the banner
       never paints over or intercepts the navigation while scrolling past it. */
    z-index: 10;
    border-bottom: 1px solid color-mix(in oklab, var(--ember, #fa6b06) 45%, transparent);
    background: color-mix(in oklab, var(--ember, #fa6b06) 12%, var(--bg, #07060a));
  }
  :root[data-theme="light"] .public-beta {
    background: color-mix(in oklab, var(--ember, #fa6b06) 10%, #f6f4ee);
  }
  .public-beta__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.25rem;
    padding-block: 0.65rem;
  }
  .public-beta__copy {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.55rem 0.85rem;
    max-width: 70ch;
  }
  .public-beta__label {
    display: inline-flex;
    align-items: center;
    padding: 0.15rem 0.45rem;
    border-radius: 999px;
    border: 1px solid color-mix(in oklab, var(--ember, #fa6b06) 55%, transparent);
    color: var(--ember, #fa6b06);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .public-beta__text {
    color: var(--text-mute);
    font-size: 0.9rem;
    line-height: 1.45;
  }
  .public-beta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 0.85rem;
  }
  .public-beta__link {
    color: var(--text, #f5f2ea);
    font-size: 0.85rem;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  .public-beta__link:hover,
  .public-beta__link:focus-visible {
    color: var(--ember, #fa6b06);
  }
  .public-beta__link--quiet {
    color: var(--text-mute);
  }
</style>
