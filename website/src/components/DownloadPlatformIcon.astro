---
type Platform = "macos" | "linux" | "ios" | "editor" | "android";

interface Props {
  platform: Platform;
  compact?: boolean;
}

const { platform, compact = false } = Astro.props;
---

<span
  class:list={[
    "download-platform-icon",
    `download-platform-icon--${platform}`,
    { "is-compact": compact }
  ]}
  aria-hidden="true"
>
  {
    platform === "macos" && (
      <svg viewBox="0 0 24 24" role="presentation">
        <path
          fill="currentColor"
          d="M16.7 12.9c0-2.3 1.9-3.4 2-3.5-1.1-1.6-2.8-1.8-3.4-1.8-1.4-.2-2.8.9-3.5.9-.7 0-1.8-.9-3-.9-1.5 0-3 .9-3.8 2.2-1.7 2.9-.4 7.1 1.2 9.4.8 1.1 1.7 2.4 2.9 2.3 1.2 0 1.7-.7 3.1-.7 1.5 0 1.9.7 3.2.7 1.3 0 2.1-1.1 2.8-2.2.9-1.3 1.3-2.6 1.3-2.6-.1 0-2.8-1.1-2.8-3.8ZM14.4 6.1c.6-.8 1.1-1.9 1-3-.9 0-2 .6-2.7 1.4-.6.7-1.1 1.8-1 2.9 1 .1 2.1-.5 2.7-1.3Z"
        />
      </svg>
    )
  }
  {
    platform === "linux" && (
      <svg viewBox="0 0 24 24" role="presentation">
        <path
          d="M8 8c0-2.8 1.5-4.8 4-4.8s4 2 4 4.8v2.1c0 1.5.6 2.7 1.4 3.7.8 1 1.2 2.2.8 3.7-.6 2.2-2.7 3.3-6.2 3.3s-5.6-1.1-6.2-3.3c-.4-1.5 0-2.7.8-3.7.8-1 1.4-2.2 1.4-3.7V8Z"
          fill="none"
          stroke="currentColor"
          stroke-width="1.55"
          stroke-linejoin="round"
        />
        <circle cx="10.2" cy="8.1" r=".72" fill="currentColor" />
        <circle cx="13.8" cy="8.1" r=".72" fill="currentColor" />
        <path d="m10.1 11.2 1.9 1.5 1.9-1.5Z" fill="#e87024" />
        <path
          d="M9.2 17.2c1.7.8 3.9.8 5.6 0"
          fill="none"
          stroke="#d49a12"
          stroke-width="1.4"
          stroke-linecap="round"
        />
      </svg>
    )
  }
  {
    platform === "ios" && (
      <svg viewBox="0 0 24 24" role="presentation">
        <rect
          x="6.2"
          y="2.3"
          width="11.6"
          height="19.4"
          rx="2.8"
          fill="none"
          stroke="currentColor"
          stroke-width="1.55"
        />
        <path d="M10 4.9h4" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" />
        <path
          fill="currentColor"
          d="M13.9 12.1c0-1 .8-1.5.9-1.5-.5-.7-1.2-.8-1.5-.8-.6-.1-1.2.4-1.5.4s-.8-.4-1.3-.4c-.7 0-1.3.4-1.7 1-.7 1.3-.2 3.1.5 4.1.4.5.8 1 1.3 1 .5 0 .7-.3 1.4-.3.6 0 .8.3 1.4.3.5 0 .9-.5 1.2-1 .4-.6.6-1.1.6-1.1s-1.3-.5-1.3-1.7Zm-1-3c.3-.3.5-.8.4-1.3-.4 0-.9.3-1.2.6-.3.3-.5.8-.4 1.2.4.1.9-.2 1.2-.5Z"
        />
      </svg>
    )
  }
  {
    platform === "editor" && (
      <svg viewBox="0 0 24 24" role="presentation">
        <path
          fill="#1689d4"
          d="m2.1 8.1 3.5-2.7 5.3 4.1 7.5-7.1 3.5 1.7v15.8l-3.5 1.7-7.5-7.1-5.3 4.1-3.5-2.7L6.4 12Zm16.2-.9L12.2 12l6.1 4.8Z"
        />
        <path
          fill="#4ccbb4"
          d="M13.1 3.6 8.7 6.2a.8.8 0 0 0-.4.7v4.2l3.4 2.6v-3.1l-2.4-1.4V7.7l3.8 2.2 3.8-2.2v1.5l-2.4 1.4v4.8l-1.4.8-1.4-.8v3.1l1 .6c.3.2.6.2.8 0l4.4-2.6c.3-.1.4-.4.4-.7V6.9a.8.8 0 0 0-.4-.7l-4.4-2.6a.8.8 0 0 0-.8 0Z"
        />
      </svg>
    )
  }
  {
    platform === "android" && (
      <svg viewBox="0 0 24 24" role="presentation">
        <path
          d="m8.2 5.4-1.5-2M15.8 5.4l1.5-2"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
        />
        <path d="M5 11.2a7 7 0 0 1 14 0v6.6a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2Z" fill="currentColor" />
        <circle cx="9" cy="9.4" r=".75" fill="var(--icon-eye)" />
        <circle cx="15" cy="9.4" r=".75" fill="var(--icon-eye)" />
      </svg>
    )
  }
</span>

<style>
  .download-platform-icon {
    --icon-size: 3.25rem;
    --icon-color: var(--text-bright);
    --icon-eye: var(--ink-void);
    width: var(--icon-size);
    height: var(--icon-size);
    display: inline-grid;
    place-items: center;
    color: var(--icon-color);
    border-radius: 1rem;
    background: color-mix(in oklab, var(--icon-color) 8%, var(--glass-bg-elevated));
    border: 1px solid color-mix(in oklab, var(--icon-color) 20%, var(--ink-line));
    box-shadow: 0 12px 28px -20px color-mix(in oklab, var(--icon-color) 48%, transparent);
  }

  .download-platform-icon svg {
    width: 68%;
    height: 68%;
    overflow: visible;
  }

  .download-platform-icon--linux {
    --icon-color: #b47b00;
  }

  .download-platform-icon--ios {
    --icon-color: var(--ember-core);
  }

  .download-platform-icon--android {
    --icon-color: #178d55;
    --icon-eye: #f6f4ee;
  }

  .download-platform-icon--editor {
    --icon-color: #178bbf;
  }

  .download-platform-icon.is-compact {
    --icon-size: 2.35rem;
    border-radius: 0.78rem;
  }

  :global(:root:not([data-theme="light"])) .download-platform-icon--linux {
    --icon-color: #f3bd45;
  }

  :global(:root:not([data-theme="light"])) .download-platform-icon--android {
    --icon-color: #52df95;
    --icon-eye: #08130d;
  }
</style>
