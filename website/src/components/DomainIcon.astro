---
/**
 * Per-domain line glyph for the trust surface, keyed by the registry domain id.
 * Each mirrors the SF Symbol the in-app control center uses for that domain
 * (e.g. pensieve -> brain.head.profile). Drawn in `currentColor` so the card can
 * tint it with the domain's tier color. Unknown ids fall back to a document mark.
 */
interface Props {
  id: string;
}
const { id } = Astro.props;

const ICONS: Record<string, string> = {
  // chart.bar.fill
  usage_spend:
    '<path d="M4 20h16"/><rect x="5.5" y="10" width="3" height="8" rx="0.6"/><rect x="10.5" y="6" width="3" height="12" rx="0.6"/><rect x="15.5" y="13" width="3" height="5" rx="0.6"/>',
  // bubble.left.and.bubble.right.fill
  conversations_chat:
    '<path d="M4 7a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2h-7l-4 3v-3H6a2 2 0 0 1-2-2V7Z"/><circle cx="9" cy="10" r="0.95" fill="currentColor" stroke="none"/><circle cx="12" cy="10" r="0.95" fill="currentColor" stroke="none"/><circle cx="15" cy="10" r="0.95" fill="currentColor" stroke="none"/>',
  // text.magnifyingglass
  session_logs:
    '<line x1="4" y1="6" x2="13" y2="6"/><line x1="4" y1="10" x2="11" y2="10"/><line x1="4" y1="14" x2="8" y2="14"/><circle cx="15.5" cy="14.5" r="3.2"/><line x1="17.9" y1="16.9" x2="20.5" y2="19.5"/>',
  // brain.head.profile
  pensieve:
    '<path d="M6 13a2.2 2.2 0 0 1-.6-4.1A2.4 2.4 0 0 1 8 6.2a2.6 2.6 0 0 1 4-.4 2.6 2.6 0 0 1 4 .4 2.4 2.4 0 0 1 2.6 2.7A2.2 2.2 0 0 1 18 13a2.3 2.3 0 0 1-1.5 3.2 2.4 2.4 0 0 1-4.5.6 2.4 2.4 0 0 1-4.5-.6A2.3 2.3 0 0 1 6 13Z"/><path d="M12 5.8v11.4"/><path d="M9 9.6a1.5 1.5 0 0 1 1.5 1.4M15 9.6a1.5 1.5 0 0 0-1.5 1.4"/>',
  // person.badge.key.fill
  provider_accounts:
    '<circle cx="9" cy="8" r="3"/><path d="M3.8 19a5.4 5.4 0 0 1 10.4 0"/><circle cx="17.5" cy="9" r="2"/><path d="M17.5 11v5m0-2.2h2"/>',
  // laptopcomputer.and.iphone
  connected_devices:
    '<rect x="3" y="6" width="11" height="8" rx="1"/><path d="M2 17.5h13"/><rect x="16" y="9" width="5.5" height="9.5" rx="1.2"/>',
  // key.horizontal.fill
  external_mcp: '<circle cx="7" cy="12" r="3.2"/><path d="M10.2 12H20m-3.2 0v3m-3-3v2.2"/>',
  // cursorarrow.rays
  computer_use:
    '<path d="M10 10l8.5 3.2-3.6 1.1-1.1 3.6L10 10Z"/><line x1="4.5" y1="5" x2="6.2" y2="6.7"/><line x1="4" y1="11" x2="6" y2="11"/><line x1="10" y1="4" x2="10" y2="6"/>',
  // photo.on.rectangle.angled
  media:
    '<path d="M4 14.5V6.5A1.5 1.5 0 0 1 5.5 5H16"/><rect x="6.5" y="7.5" width="13" height="11" rx="1.6"/><circle cx="10.5" cy="11.3" r="1.3"/><path d="M6.8 18l3.4-3 2.3 2 2.6-2.6 4.4 4.1"/>',
  // creditcard.fill
  entitlements_billing:
    '<rect x="3" y="6" width="18" height="12" rx="2"/><line x1="3" y1="10" x2="21" y2="10"/><line x1="6.5" y1="14.2" x2="10.5" y2="14.2"/>',
  // lock.shield.fill
  device_trust_keys:
    '<path d="M12 3.2l7 2.4v5.5c0 4.1-2.9 7.3-7 8.9-4.1-1.6-7-4.8-7-8.9V5.6L12 3.2Z"/><circle cx="12" cy="10.4" r="1.5"/><path d="M12 11.9v2.7"/>',
  // list.bullet.rectangle.portrait.fill
  audit_timeline:
    '<circle cx="6" cy="7" r="1.4" fill="currentColor" stroke="none"/><line x1="9.5" y1="7" x2="20" y2="7"/><circle cx="6" cy="12" r="1.4" fill="currentColor" stroke="none"/><line x1="9.5" y1="12" x2="20" y2="12"/><circle cx="6" cy="17" r="1.4" fill="currentColor" stroke="none"/><line x1="9.5" y1="17" x2="17" y2="17"/>'
};

const FALLBACK =
  '<rect x="5" y="4" width="14" height="16" rx="2"/><line x1="8" y1="9" x2="16" y2="9"/><line x1="8" y1="13" x2="16" y2="13"/>';

const inner = ICONS[id] ?? FALLBACK;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={inner}
/>
