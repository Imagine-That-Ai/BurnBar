---
// Opt-in analytics consent banner. Renders hidden; the bundled script below
// shows it only on first visit (consent unset) and boots analytics ONLY after
// an explicit Accept. Declining — or never answering — keeps the site dark:
// the first-party collector is never called. Revisit via any `[data-analytics-manage]`
// control (see Footer). This is the single client entry point for analytics and
// is included once from BaseLayout.
---

<aside
  id="analytics-consent"
  class="analytics-consent"
  role="region"
  aria-label="Usage analytics consent"
  tabindex="-1"
  hidden
>
  <div class="analytics-consent__body">
    <p class="analytics-consent__text">
      <strong>Privacy-first, opt-in analytics.</strong>
      We use privacy-preserving Amplitude only if you accept. No personal data, no message content, no
      tracking before consent. See our <a href="/privacy">Privacy Policy</a>.
    </p>
    <div class="analytics-consent__actions">
      <button
        type="button"
        class="analytics-consent__btn analytics-consent__btn--ghost"
        data-consent-decline
      >
        Not now
      </button>
      <button
        type="button"
        class="analytics-consent__btn analytics-consent__btn--primary"
        data-consent-accept
      >
        Enable analytics
      </button>
    </div>
  </div>
</aside>

<style>
  .analytics-consent {
    position: fixed;
    inset-inline-end: 1rem;
    inset-block-end: 1rem;
    z-index: 1000;
    max-width: min(32rem, calc(100vw - 2rem));
    border: 1px solid var(--ink-line-bright);
    border-radius: 14px;
    background: var(--consent-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 18px 48px -24px rgba(0, 0, 0, 0.7);
    padding: 1rem 1.15rem;
    /* Theme-aware surface: the old --color-* tokens never existed in this
       codebase, so the banner was stuck on its dark fallbacks (and violet
       accent) in both themes. */
    --consent-bg: rgba(20, 19, 26, 0.92);
  }
  :root[data-theme="light"] .analytics-consent {
    --consent-bg: rgba(252, 250, 245, 0.94);
  }
  .analytics-consent[hidden] {
    display: none;
  }
  .analytics-consent__body {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem 1.25rem;
    justify-content: space-between;
  }
  .analytics-consent__text {
    flex: 1 1 22rem;
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--text-mute);
  }
  .analytics-consent__text strong {
    color: var(--text-bright);
  }
  .analytics-consent__text a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .analytics-consent__actions {
    display: flex;
    gap: 0.6rem;
    flex: 0 0 auto;
  }
  .analytics-consent__btn {
    font: inherit;
    font-size: 0.83rem;
    font-weight: var(--wght-bold);
    padding: 0.5rem 0.95rem;
    border-radius: 9px;
    cursor: pointer;
    border: 1px solid transparent;
    transition:
      background-color 120ms ease,
      border-color 120ms ease;
  }
  .analytics-consent__btn--ghost {
    background: transparent;
    border-color: color-mix(in srgb, currentColor 22%, transparent);
    color: var(--text-mute);
  }
  .analytics-consent__btn--ghost:hover {
    border-color: color-mix(in srgb, currentColor 40%, transparent);
    color: var(--text-bright);
  }
  /* Ember-family primary, matching the site's CTA language instead of the
     violet the phantom --color-accent fallback used to produce. Near-black
     label clears WCAG AA on the fire tokens in both themes. */
  .analytics-consent__btn--primary {
    background: var(--ember-core);
    color: #140a04;
  }
  .analytics-consent__btn--primary:hover {
    background: color-mix(in srgb, var(--ember-core) 86%, #fff);
  }
  :root[data-theme="light"] .analytics-consent__btn--primary {
    /* light --core-fire alone is ~4.1:1 vs both white and black; darken it
       so the white label clears 4.5:1. */
    background: color-mix(in srgb, var(--ember-core) 78%, #000);
    color: #fff;
  }
  :root[data-theme="light"] .analytics-consent__btn--primary:hover {
    background: color-mix(in srgb, var(--ember-core) 68%, #000);
  }
  @media (max-width: 640px) {
    .analytics-consent {
      inset-inline: 0.75rem;
      inset-block-end: max(0.75rem, env(safe-area-inset-bottom));
      padding: 0.75rem;
      border-radius: 12px;
      max-height: min(34vh, 11.5rem);
      overflow: auto;
    }
    .analytics-consent__body {
      display: grid;
      gap: 0.65rem;
    }
    .analytics-consent__text {
      flex-basis: auto;
      font-size: 0.78rem;
      line-height: 1.42;
    }
    .analytics-consent__actions {
      width: 100%;
    }
    .analytics-consent__btn {
      flex: 1 1 0;
      min-width: 0;
      padding: 0.55rem 0.5rem;
      white-space: nowrap;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .analytics-consent__btn {
      transition: none;
    }
  }
</style>

<script>
  import {
    analyticsConsent,
    grantConsent,
    declineConsent,
    boot,
    rememberAttribution,
    installDelegatedTracking
  } from "../lib/analytics";

  const banner = document.getElementById("analytics-consent");
  const show = (focus = false) => {
    banner?.removeAttribute("hidden");
    // Move focus only for explicit reopens (footer "manage analytics") —
    // first-visit auto-show must not steal focus from the page.
    if (focus) banner?.focus();
  };
  const hide = () => banner?.setAttribute("hidden", "");

  // Escape dismisses without persisting a decision — the banner returns on
  // the next visit, same as never answering.
  banner?.addEventListener("keydown", (event) => {
    if (event.key === "Escape") hide();
  });

  // CTA tracking is safe to wire immediately — every track() is dropped until
  // consent is granted, so nothing leaks pre-opt-in.
  installDelegatedTracking();

  // Persist bounded landing UTMs before the consent branch. Undecided
  // visitors who navigate internally and grant on /download must still
  // carry the campaign; `boot()` only runs after a decision.
  rememberAttribution();

  const suppressInitialPrompt = document.body.hasAttribute("data-transactional-page");
  if (analyticsConsent.hasDecided) {
    boot(); // resumes + emits page view if granted; stays dark if declined
  } else if (!suppressInitialPrompt) {
    show();
  }

  banner?.querySelector("[data-consent-accept]")?.addEventListener("click", () => {
    grantConsent(); // persists, starts the transport, emits consent.granted + page view
    hide();
  });
  banner?.querySelector("[data-consent-decline]")?.addEventListener("click", () => {
    declineConsent();
    hide();
  });

  // Let any "manage analytics" control (e.g. in the footer) reopen the prompt.
  document.querySelectorAll("[data-analytics-manage]").forEach((el) =>
    el.addEventListener("click", (event) => {
      event.preventDefault();
      show(true);
    })
  );
</script>
