---
import "@styles/globals.css";
// ?url imports resolve to the content-hashed asset paths Vite emits — the
// same URLs the fontsource @font-face rules point at, so the preloads below
// never 404 across builds.
import frauncesLatinUrl from "@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url";
import frauncesLatinItalicUrl from "@fontsource-variable/fraunces/files/fraunces-latin-opsz-italic.woff2?url";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import ConsentBanner from "@components/ConsentBanner.astro";
import { SITE } from "@data/site";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /** Alt text for the card. Defaults to the site line; a page that ships its
   *  own OG image should describe that image instead. */
  ogImageAlt?: string;
  pathname?: string;
  noindex?: boolean;
  transactional?: boolean;
  ambientEffects?: boolean;
}

const {
  title,
  description = SITE.description,
  ogImage = "/og/default.png",
  ogImageAlt = `${SITE.name} — ${SITE.tagline}`,
  pathname,
  noindex = false,
  transactional = false,
  ambientEffects = true
} = Astro.props;

// Firebase Hosting serves these pages without a trailing slash
// (firebase.json marketing target: "trailingSlash": false), so canonical,
// og:url, and the sitemap must all use the slash-less form — otherwise every
// page self-canonicalizes to a URL that 301-redirects.
const rawPath = pathname ?? Astro.url.pathname;
const normalizedPath = rawPath.replace(/\/+$/, "") || "/";
const canonical = new URL(normalizedPath, SITE.url).toString();
const isHome = normalizedPath === "/";
const fullTitle =
  title === SITE.name ? `${SITE.name} — ${SITE.tagline}` : `${title} — ${SITE.name}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#07060a" />
    <meta name="color-scheme" content="dark light" />

    <!-- Theme: resolve BEFORE paint to avoid a flash. Default follows the
         viewer's system preference; the header toggle persists a choice. -->
    <script is:inline>
      (function () {
        try {
          // Scroll-reveal styles hide content until JS reveals it; mark the
          // root so those rules only ever apply when JS is actually running.
          document.documentElement.classList.add("js");
          var stored = localStorage.getItem("burnbar-theme");
          var prefersLight =
            window.matchMedia && window.matchMedia("(prefers-color-scheme: light)").matches;
          var theme = stored || (prefersLight ? "light" : "dark");
          document.documentElement.setAttribute("data-theme", theme);
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute("content", theme === "light" ? "#f6f4ee" : "#07060a");
        } catch {}
      })();
    </script>

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, SITE.url).toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, SITE.url).toString()} />

    <!-- Icons (the real OpenBurnBar app icon at multiple sizes) -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/logo-32.png" />
    <link rel="icon" type="image/png" sizes="64x64" href="/brand/favicon-64.png" />
    <link rel="icon" type="image/png" sizes="256x256" href="/brand/logo-256.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Analytics: opt-in only. Nothing loads or sends until the visitor
         accepts the consent banner; the Amplitude chunk is never even fetched
         pre-consent. Enforced by src/lib/analytics (consent gate) + the bundled
         (never inline/CDN) script in ConsentBanner.astro. -->

    <!-- Preconnect: none. We self-host fonts. Preload only the two latin
         Fraunces faces (display font gates hero/LCP text); unicode-range
         keeps the latin-ext/vietnamese subsets off the critical path. -->
    <link rel="preload" as="font" type="font/woff2" crossorigin href={frauncesLatinUrl} />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={frauncesLatinItalicUrl} />

    <!-- JSON-LD: the SoftwareApplication entity belongs to the homepage only.
         Emitting it on every page published 30+ copies of the same entity,
         each with a different (page-local) description. -->
    {
      isHome && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "SoftwareApplication",
            name: SITE.name,
            applicationCategory: "DeveloperApplication",
            operatingSystem: "macOS 14+, iOS 17+, Linux (preview)",
            description: SITE.description,
            url: SITE.url,
            offers: SITE.pricing.tiers.map((tier) => ({
              "@type": "Offer",
              price: tier.priceMonthlyUSD,
              priceCurrency: "USD",
              name: tier.priceMonthlyUSD === "0" ? tier.name : `${tier.name} monthly`
            }))
          })}
        />
      )
    }
    <!-- Page-specific pre-paint hooks (e.g. the Arena variant assignment on
         the vote page) render here, still inside <head> so they resolve
         before first paint. -->
    <slot name="head" />
  </head>
  <body data-transactional-page={transactional ? "" : undefined}>
    {
      ambientEffects && (
        <>
          <!-- Interactive Token Ember Swarm Canvas Background (DARK theme) -->
          <canvas
            id="bgCanvas"
            style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; pointer-events: none; z-index: 0;"
          />

          <!-- Dot-logo constellation background (LIGHT theme) -->
          <canvas
            id="bgDots"
            style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; pointer-events: none; z-index: 0;"
          />

          <!-- Easter-egg FX overlay: logo storm (dark) / cloud token rain (light) /
               boundary "you've reached the end" tokens. Idles until summoned. -->
          <canvas
            id="bgFx"
            style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; pointer-events: none; z-index: 60;"
          />
        </>
      )
    }

    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <ConsentBanner />

    <script>
      import "../scripts/emberSwarm.ts";
    </script>

    <!-- Ties both fixed background canvases to scroll position, so the field
         is atmosphere over the hero and out of the way below it. Kept out of
         the canvas scripts themselves: it is one CSS custom property, and it
         applies to whichever canvas the current theme is painting. -->
    <script>
      import "../scripts/atmosphere.ts";
    </script>

    <!-- Dot-Logo Constellation Background (LIGHT theme) — BurnBar crests +
         provider logos sampled into colored dots that resolve into a logo,
         shimmer, scatter/dissolve, and reappear as a different logo elsewhere. -->
    <script>
      import "../scripts/dotConstellation.ts";
    </script>

    <!-- Easter Eggs: jiggle the scroll (rapid up/down) to summon a 5-second
         takeover. DARK = LOGO STORM: fireworks of logos that periodically
         converge into shapes ($ / :) / </>). LIGHT = CLOUD TOKEN RAIN: large
         fluffy clouds raining gold & silver coins with real tumble physics.
         Hit the very top/bottom for a "you've reached the end" token bounce. -->
    <script>
      import "../scripts/easterEggFx.ts";
    </script>

    <!-- chenglou/pretext-powered High-Performance Text Shrinkwrap Layout Engine -->
    <script>
      import "../scripts/pretextShrinkwrap.ts";
    </script>
  </body>
</html>
