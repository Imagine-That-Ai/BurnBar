# OpenBurnBar website environment variables.
# Copy to .env and fill in real values. Never commit .env.
#
# Note: the marketing site ships NO analytics and NO error-reporting SDK —
# the footer's "No analytics, no trackers" claim is enforced by
# scripts/test-trust-copy.mjs against the built output. Don't add one here.

# ── Firebase (public config — safe to commit for non-secret values) ────────
# See: https://console.firebase.google.com/
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
