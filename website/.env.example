# OpenBurnBar website environment variables.
# Copy to .env and fill in real values. Never commit .env.
#
# For local dev, these are all optional — Sentry will be disabled when unset.

# ── Sentry Error Tracking ──────────────────────────────────────────────────
# Public DSN is safe to expose in client-side bundles.
# Get from: https://sentry.io/settings/<org>/projects/burnbar-website/keys/
PUBLIC_SENTRY_DSN=

# Auth token for source-map upload during production builds.
# Get from: https://sentry.io/settings/account/api/auth-tokens/
# Required scopes: project:write, org:read
SENTRY_AUTH_TOKEN=

# ── Firebase (public config — safe to commit for non-secret values) ────────
# See: https://console.firebase.google.com/
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
