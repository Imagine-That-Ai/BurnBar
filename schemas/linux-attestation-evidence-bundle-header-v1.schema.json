{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openburnbar.dev/schemas/linux-attestation-evidence-bundle-header-v1.json",
  "title": "OpenBurnBar TPM evidence bundle header v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "records"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "records": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        { "$ref": "#/$defs/imaLog" },
        { "$ref": "#/$defs/uefiLog" },
        { "$ref": "#/$defs/installedManifest" },
        { "$ref": "#/$defs/installedManifestSignature" }
      ],
      "items": false
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "recordBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "offset", "byteLength", "sha256"],
      "properties": {
        "kind": { "type": "string" },
        "offset": { "type": "integer", "minimum": 14, "maximum": 67108863 },
        "byteLength": { "type": "integer", "minimum": 1, "maximum": 67108864 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "imaLog": {
      "allOf": [
        { "$ref": "#/$defs/recordBase" },
        { "type": "object", "properties": { "kind": { "const": "ima_ascii_runtime_measurements" } } }
      ]
    },
    "uefiLog": {
      "allOf": [
        { "$ref": "#/$defs/recordBase" },
        { "type": "object", "properties": { "kind": { "const": "uefi_binary_bios_measurements" } } }
      ]
    },
    "installedManifest": {
      "allOf": [
        { "$ref": "#/$defs/recordBase" },
        { "type": "object", "properties": { "kind": { "const": "installed_manifest" } } }
      ]
    },
    "installedManifestSignature": {
      "allOf": [
        { "$ref": "#/$defs/recordBase" },
        { "type": "object", "properties": { "kind": { "const": "installed_manifest_signature" } } }
      ]
    }
  }
}
