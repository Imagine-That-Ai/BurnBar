{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openburnbar.dev/schemas/linux-attestation-broker-v2.json",
  "title": "OpenBurnBar Linux attestation broker protocol v2",
  "oneOf": [
    { "$ref": "#/$defs/describeBindingRequest" },
    { "$ref": "#/$defs/attestRequest" },
    { "$ref": "#/$defs/describeBindingResponse" },
    { "$ref": "#/$defs/attestResponse" },
    { "$ref": "#/$defs/errorResponse" }
  ],
  "$defs": {
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:+/=-]+$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9._:+/=-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appId",
        "deviceId",
        "appVersion",
        "architecture",
        "releaseDigestSha256",
        "policyId",
        "attestationKind"
      ],
      "properties": {
        "appId": { "$ref": "#/$defs/label" },
        "deviceId": { "$ref": "#/$defs/label" },
        "appVersion": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[A-Za-z0-9._:+/=-]+$" },
        "architecture": { "type": "string", "enum": ["aarch64", "x86_64"] },
        "releaseDigestSha256": { "$ref": "#/$defs/sha256" },
        "policyId": { "$ref": "#/$defs/label" },
        "attestationKind": { "type": "string", "const": "tpm2_ima_signed_verdict_v1" }
      }
    },
    "challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["challengeId", "challenge", "expiresAtMillis", "appId", "policyId", "protocolVersion"],
      "properties": {
        "challengeId": { "$ref": "#/$defs/label" },
        "challenge": {
          "type": "string",
          "minLength": 43,
          "maxLength": 43,
          "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$",
          "description": "Canonical unpadded base64url encoding of exactly 32 random bytes"
        },
        "expiresAtMillis": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "appId": { "$ref": "#/$defs/label" },
        "policyId": { "$ref": "#/$defs/label" },
        "protocolVersion": { "const": 1 }
      }
    },
    "evidenceBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["descriptorIndex", "format", "byteLength", "sha256"],
      "properties": {
        "descriptorIndex": { "const": 0 },
        "format": { "const": "openburnbar_tpm_evidence_bundle_v1" },
        "byteLength": { "type": "integer", "minimum": 1, "maximum": 67108864 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "quoteEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "deviceId",
        "quoteAttestationBase64",
        "quoteSignatureBase64",
        "quotePcrValuesBase64",
        "pcrBank",
        "pcrSelection",
        "qualifyingDataSha256"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "deviceId": { "$ref": "#/$defs/label" },
        "quoteAttestationBase64": { "type": "string", "minLength": 4, "maxLength": 16384, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/][AQgw]==|[A-Za-z0-9+/]{2}[AEIMQUYcgkosw048]=)?$" },
        "quoteSignatureBase64": { "type": "string", "minLength": 4, "maxLength": 4096, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/][AQgw]==|[A-Za-z0-9+/]{2}[AEIMQUYcgkosw048]=)?$" },
        "quotePcrValuesBase64": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/][AQgw]==|[A-Za-z0-9+/]{2}[AEIMQUYcgkosw048]=)?$",
          "description": "Canonical standard-base64 encoding of the uncompressed tpm2-tools PCR blob used as the third component of a Keylime compound quote"
        },
        "pcrBank": { "const": "sha256" },
        "pcrSelection": { "const": [0, 2, 4, 7, 10] },
        "qualifyingDataSha256": {
          "$ref": "#/$defs/sha256",
          "description": "TPM quote extraData derived by the domain-separated challenge-and-binding algorithm in linux-attestation-evidence-bundle-v1.md"
        }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["challengeId", "challenge", "kind", "evidence", "evidenceBundle"],
      "properties": {
        "challengeId": { "$ref": "#/$defs/label" },
        "challenge": {
          "type": "string",
          "minLength": 43,
          "maxLength": 43,
          "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
        },
        "kind": { "const": "tpm2_ima_signed_verdict_v1" },
        "evidence": { "$ref": "#/$defs/quoteEvidence" },
        "evidenceBundle": { "$ref": "#/$defs/evidenceBundle" }
      }
    },
    "brokerError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "$ref": "#/$defs/label" },
        "message": { "type": "string", "minLength": 1, "maxLength": 512 },
        "retryable": { "type": "boolean" }
      }
    },
    "describeBindingRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "requestId", "operation"],
      "properties": {
        "protocolVersion": { "const": 2 },
        "requestId": { "$ref": "#/$defs/requestId" },
        "operation": { "const": "describe_binding" }
      }
    },
    "attestRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "requestId", "operation", "challenge", "binding"],
      "properties": {
        "protocolVersion": { "const": 2 },
        "requestId": { "$ref": "#/$defs/requestId" },
        "operation": { "const": "attest" },
        "challenge": { "$ref": "#/$defs/challenge" },
        "binding": { "$ref": "#/$defs/binding" }
      }
    },
    "describeBindingResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "requestId", "ok", "binding"],
      "properties": {
        "protocolVersion": { "const": 2 },
        "requestId": { "$ref": "#/$defs/requestId" },
        "ok": { "const": true },
        "binding": { "$ref": "#/$defs/binding" }
      }
    },
    "attestResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "requestId", "ok", "attestation"],
      "properties": {
        "protocolVersion": { "const": 2 },
        "requestId": { "$ref": "#/$defs/requestId" },
        "ok": { "const": true },
        "attestation": { "$ref": "#/$defs/attestation" }
      }
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "requestId", "ok", "error"],
      "properties": {
        "protocolVersion": { "const": 2 },
        "requestId": { "type": "string", "maxLength": 128, "pattern": "^[A-Za-z0-9._:+/=-]*$" },
        "ok": { "const": false },
        "error": { "$ref": "#/$defs/brokerError" }
      }
    }
  }
}
