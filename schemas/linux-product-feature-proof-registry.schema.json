{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openburnbar.dev/schemas/linux-product-feature-proof-registry.schema.json",
  "title": "OpenBurnBar Linux product feature proof registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "requirements"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "const": "openburnbar-linux-product-feature-proof-registry-v1" },
    "requirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/requirement" }
    },
    "certification": {
      "type": "array",
      "items": { "$ref": "#/$defs/certification" }
    }
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirementId", "artifacts"],
      "properties": {
        "requirementId": { "type": "string", "pattern": "^P-(0[1-9]|[1-3][0-9]|40)$" },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/artifact" }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "mediaType", "maxBytes"],
      "properties": {
        "role": { "type": "string", "pattern": "^feature\\.[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
        "mediaType": { "type": "string", "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$" },
        "maxBytes": { "type": "integer", "minimum": 1, "maximum": 268435456 }
      }
    },
    "certification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirementId", "validator", "capture", "materializer"],
      "properties": {
        "requirementId": { "type": "string", "pattern": "^P-(0[1-9]|[1-3][0-9]|40)$" },
        "validator": { "$ref": "#/$defs/validatorOwnership" },
        "capture": { "$ref": "#/$defs/componentOwnership" },
        "materializer": { "$ref": "#/$defs/componentOwnership" }
      }
    },
    "validatorOwnership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourcePath", "entrypoint", "testPath", "mutationTestName"],
      "properties": {
        "sourcePath": { "$ref": "#/$defs/sourcePath" },
        "entrypoint": { "$ref": "#/$defs/entrypoint" },
        "testPath": { "$ref": "#/$defs/testPath" },
        "mutationTestName": { "type": "string", "minLength": 1 }
      }
    },
    "componentOwnership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producerPath", "entrypoint", "workflowPath", "testPath", "testName"],
      "properties": {
        "producerPath": { "$ref": "#/$defs/sourcePath" },
        "entrypoint": { "$ref": "#/$defs/entrypoint" },
        "workflowPath": { "type": "string", "pattern": "^\\.github/workflows/[a-z0-9-]+\\.yml$" },
        "testPath": { "$ref": "#/$defs/testPath" },
        "testName": { "type": "string", "minLength": 1 }
      }
    },
    "sourcePath": {
      "type": "string",
      "pattern": "^scripts/linux-port/[A-Za-z0-9._/-]+\\.mjs$"
    },
    "entrypoint": {
      "type": "string",
      "pattern": "^[$A-Z_a-z][$A-Z_a-z0-9]*$"
    },
    "testPath": {
      "type": "string",
      "pattern": "^scripts/linux-port/[A-Za-z0-9._/-]+\\.test\\.mjs$"
    }
  }
}
