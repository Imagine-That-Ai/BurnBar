{
  "threshold": 6,
  "minTokens": 50,
  "minLines": 5,
  "ignore": [
    "**/*.json",
    "**/*.md",
    "**/node_modules/**",
    "**/dist/**",
    "**/lib/**",
    "**/.build/**",
    "**/.derived-data*/**",
    "**/.spm-cache*/**",
    "build/**",
    "Vendor/**",
    "functions/scripts/**",
    "scripts/**",
    "**/*.yaml",
    "**/*.yml",
    "**/*.pbxproj",
    "**/*.xcscheme",
    "**/Package.resolved",
    "**/*.storyboard",
    "**/*.xib",
    "**/__mocks__/**",
    "**/__test__/**",
    "**/__tests__/**",
    "**/Fixtures/**",
    "**/Quarantine/**",
    "**/Tests/**",
    "**/test/**",
    "**/tests/**",
    "**/*Tests/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/generated/**",
    "**/*.generated.*"
  ],
  "reporters": ["console"],
  "format": ["swift", "kotlin", "typescript", "tsx", "javascript", "jsx", "csharp", "rust"],
  "gitignore": true
}