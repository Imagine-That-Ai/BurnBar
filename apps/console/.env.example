# app.burnbar.ai console — public Firebase web config (mirrors website/.env.example).
# These are public client identifiers, not secrets, but keep production values out of git.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=app.burnbar.ai
NEXT_PUBLIC_FIREBASE_PROJECT_ID=burnbar
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=burnbar.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# App Check (reCAPTCHA Enterprise) — required because every console callable enforces App Check.
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_KEY=
NEXT_PUBLIC_ENABLE_APPLE_AUTH=false
NEXT_PUBLIC_ENABLE_GITHUB_AUTH=false

# Dev-only App Check debug token (register it in the Firebase console -> App Check -> debug tokens).
NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=

# Dev-only: auth/Firestore/Functions default to the local emulator suite
# (localhost:9099/8080/5001). Set to 0 to point `npm run dev` at the REAL
# project instead — needed to preview with your live account/data when the
# emulators are not running (otherwise sign-in hangs against dead emulators).
NEXT_PUBLIC_FIREBASE_EMULATORS=1

# Opt-in analytics (Amplitude). STRICTLY opt-in: with no key the analytics layer
# stays dark by construction (the recorder's key check), and even with a key set,
# nothing is sent until the member affirmatively consents in the first-run banner
# or the Settings -> Privacy toggle. Use SEPARATE projects for dev/staging vs
# production. NEVER commit a real key. Absent -> dark.
NEXT_PUBLIC_AMPLITUDE_API_KEY=
# Optional: data residency zone for the Amplitude SDK. "EU" or "US" (default US).
NEXT_PUBLIC_AMPLITUDE_SERVER_ZONE=US

# Sentry error monitoring. A DSN is a PUBLIC ingest endpoint (safe in the client
# bundle), NOT a secret. With no DSN the Sentry SDK is a total no-op — no events,
# no network, and the Next build skips the Sentry plugin entirely. beforeSend
# scrubs tokens/emails/paths/request bodies (lib/sentry/scrub.ts); PII is off.
# Use SEPARATE Sentry projects for dev/staging vs production. Absent -> dark.
NEXT_PUBLIC_SENTRY_DSN=
# Deploy environment tag for grouping (defaults to "development").
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Set to "1" to enable Sentry SDK debug logging locally. Absent -> quiet.
NEXT_PUBLIC_SENTRY_DEBUG=

# Build-time ONLY (never shipped to the client). Source-map upload for readable
# stack traces runs only when SENTRY_AUTH_TOKEN is set, so CI's tokenless
# `npm ci && next build` never breaks. sentry.properties stays gitignored — all
# config is env. Set org/project/token in the deploy environment or CI secrets.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
