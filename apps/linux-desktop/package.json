{
  "name": "@openburnbar/linux-desktop",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "OpenBurnBar Linux desktop shell (Tauri + WebView)",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node ../../scripts/linux-port/verify-linux-production-bundle.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "contrast:audit": "node ../../scripts/linux-port/verify-backdrop-contrast.mjs",
    "tauri:dev": "tauri dev",
    "pretauri:build": "node ../../scripts/linux-port/prepare-linux-package-payload.mjs",
    "tauri:build": "node ../../scripts/linux-port/tauri-build-linux.mjs",
    "tauri:bundle": "tauri bundle",
    "perf:budget": "node ../../scripts/linux-port/run-perf-budget.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0"
  },
  "dependencies": {
    "@openburnbar/design-tokens": "file:../../packages/design-tokens",
    "@tauri-apps/api": "^2.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.13.0",
    "jsdom": "^30.0.1",
    "playwright": "1.62.1",
    "@eslint/js": "10.0.1",
    "eslint": "10.9.1",
    "globals": "17.11.0",
    "typescript-eslint": "8.68.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.18.0"
  },
  "license": "AGPL-3.0-only",
  "overrides": {
    "brace-expansion": "^5.0.9",
    "minimatch": "^10.0.3"
  }
}
