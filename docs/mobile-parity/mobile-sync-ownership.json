    },
    {
      "id": "doc.usage_rollups",
      "publisher": "mac",
      "mobile": "read-mirror"
    },
    {
      "id": "doc.quota_snapshots",
      "publisher": "mac",
      "mobile": "read-mirror"
    },
    {
