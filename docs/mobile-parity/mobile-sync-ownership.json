      "mobile": "read-mirror"
    },
    {
      "id": "doc.provider_accounts",
      "publisher": "mac-or-callable",
      "mobile": "read-mirror-or-callable"
    },
    {
      "id": "doc.fleet_snapshot",
      "publisher": "mac",
      "mobile": "read-mirror"
    }
  ],
  "freshnessLabels": ["live", "stale", "offline", "empty", "failed", "partial"],
  "invariants": [
    "empty is not failed",
    "failed/offline/empty must never render as a live zero",
