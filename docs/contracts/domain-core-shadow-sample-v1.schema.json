{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openburnbar.com/contracts/domain-core-shadow-sample-v1.schema.json",
  "title": "OpenBurnBar domain-core quota shadow sample v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sampleId",
    "domain",
    "consumer",
    "channel",
    "operation",
    "coreVersion",
    "observedAt",
    "outcome",
    "mismatchCategory",
    "legacyMicros",
    "rustMicros"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sampleId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "domain": { "const": "quota" },
    "consumer": { "enum": ["apple", "windows"] },
    "channel": { "enum": ["internal", "beta"] },
    "operation": {
      "enum": ["claude_quota", "codex_quota", "cursor_quota", "anthropic_quota"]
    },
    "coreVersion": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "observedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "outcome": { "enum": ["match", "mismatch"] },
    "mismatchCategory": {
      "type": ["string", "null"],
      "enum": ["result_mismatch", "native_unavailable", "native_error", "invalid_result", null]
    },
    "legacyMicros": { "type": "integer", "minimum": 0, "maximum": 600000000 },
    "rustMicros": { "type": "integer", "minimum": 0, "maximum": 600000000 }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome": { "const": "match" } } },
      "then": { "properties": { "mismatchCategory": { "const": null } } },
      "else": {
        "properties": {
          "mismatchCategory": {
            "enum": ["result_mismatch", "native_unavailable", "native_error", "invalid_result"]
          }
        }
      }
    }
  ]
}
