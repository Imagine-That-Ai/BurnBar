{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "openburnbar-linux-repository-uploader",
  "main": "src/index.mjs",
  "compatibility_date": "2026-07-10",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "downloads.burnbar.ai/linux/repository-upload/*",
      "zone_name": "burnbar.ai"
    },
    {
      "pattern": "downloads.burnbar.ai/linux/repository-preview/*",
      "zone_name": "burnbar.ai"
    }
  ],
  "vars": {
    "WORKER_ROLE": "upload"
  },
  "r2_buckets": [
    {
      "binding": "REPOSITORY_BUCKET",
      "bucket_name": "openburnbar-downloads"
    }
  ]
}
