diff --git a/.github/workflows/computer-use-loopback-test.yml b/.github/workflows/computer-use-loopback-test.yml
index ae8c784d7b..23942d4e34 100644
--- a/.github/workflows/computer-use-loopback-test.yml
+++ b/.github/workflows/computer-use-loopback-test.yml
@@ -1,5 +1,12 @@
 name: computer-use-loopback-test

+# Least-privilege default: this workflow only checks out, builds, and runs
+# tests — it never writes to the repo, comments on PRs, or publishes
+# artifacts. Pin GITHUB_TOKEN to read-only so a compromised step cannot
+# escalate to repo writes.
+permissions:
+  contents: read
+
 on:
   pull_request:
     types: [opened, synchronize, reopened, ready_for_review]
diff --git a/.github/workflows/droid-wiki-refresh.yml b/.github/workflows/droid-wiki-refresh.yml
index 16cf9f7ab3..ba4fb95b95 100644
--- a/.github/workflows/droid-wiki-refresh.yml
+++ b/.github/workflows/droid-wiki-refresh.yml
@@ -1,5 +1,15 @@
 name: Droid Wiki Refresh

+# Least-privilege default: the wiki refresh runs Droid against the
+# checked-out tree and writes only to $GITHUB_STEP_SUMMARY — it intentionally
+# carries no write token (the "Generate wiki" step comment relies on this:
+# "The workflow has no write token, so this only permits the checked-out
+# read-only wiki generation run to proceed unattended"). Pin GITHUB_TOKEN to
+# read-only so the unattended --skip-permissions-unsafe Droid run cannot push
+# commits or mutate repo state.
+permissions:
+  contents: read
+
 on:
   push:
     branches: [main]
diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
index 52bd3b6d9c..97e58755ac 100644
--- a/.github/workflows/release.yml
+++ b/.github/workflows/release.yml
@@ -696,6 +696,26 @@ jobs:
           echo "sig_path=${CHECKSUMS_PATH}.asc" >> "$GITHUB_OUTPUT"
           echo "Checksums signed successfully."

+      # Fail-loud guard for an accidentally-cleared RELEASE_SIGNING_KEY secret.
+      # The sign step above is conditionally skipped when the key is absent, so
+      # a silently-rotated-away secret would otherwise produce an unsigned
+      # release with no signal. Emit a GitHub ::warning:: annotation (visible on
+      # the run and in the job summary) so the gap is noticed. This does NOT
+      # hard-fail: cosign/SLSA attestation of the checksums (below) remains the
+      # unconditional integrity root for every release.
+      - name: Warn if checksum GPG signing was skipped
+        if: env.RELEASE_SIGNING_KEY == ''
+        env:
+          RELEASE_SIGNING_KEY: ${{ secrets.RELEASE_SIGNING_KEY }}
+        run: |
+          echo "::warning title=GPG checksum signature missing::RELEASE_SIGNING_KEY is not set; the GPG-signed checksums (.asc) were not produced for this release. cosign/SLSA attestation still covers the checksums, but verify the RELEASE_SIGNING_KEY secret was not accidentally cleared."
+          {
+            echo "## :warning: GPG checksum signature skipped"
+            echo ""
+            echo "\`RELEASE_SIGNING_KEY\` was absent, so this release has **no detached GPG signature** for its checksums."
+            echo "cosign/SLSA attestation remains the integrity root, but confirm the secret was not accidentally cleared."
+          } >> "$GITHUB_STEP_SUMMARY"
+
       - name: Generate SBOM
         id: sbom
         env:
