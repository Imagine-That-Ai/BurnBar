--- /dev/null
+++ b/functions/src/__tests__/appCheckAttestationMaxAge.test.ts
@@ -0,0 +1,39 @@
+import { describe, expect, it } from "vitest";
+
+import {
+  APP_CHECK_ATTESTATION_MAX_AGE_MS,
+  isAppCheckAttestationClaimFresh,
+  resolveAppCheckAttestationMaxAgeMs,
+} from "../appCheckAttestation.js";
+
+const SEVEN_DAYS_MS = 7 * 24 * 60 * 60 * 1000;
+const THIRTY_DAYS_MS = 30 * 24 * 60 * 60 * 1000;
+
+describe("V-16 App Check attestation max-age", () => {
+  it("defaults to 7 days (tightened from the former 30)", () => {
+    expect(resolveAppCheckAttestationMaxAgeMs(undefined)).toBe(SEVEN_DAYS_MS);
+    expect(resolveAppCheckAttestationMaxAgeMs("")).toBe(SEVEN_DAYS_MS);
+    expect(resolveAppCheckAttestationMaxAgeMs("   ")).toBe(SEVEN_DAYS_MS);
+    // The module-level constant reflects the default in a clean test env.
+    expect(APP_CHECK_ATTESTATION_MAX_AGE_MS).toBeLessThanOrEqual(THIRTY_DAYS_MS);
+  });
+
+  it("honors a valid positive operator override", () => {
+    expect(resolveAppCheckAttestationMaxAgeMs(String(THIRTY_DAYS_MS))).toBe(THIRTY_DAYS_MS);
+    expect(resolveAppCheckAttestationMaxAgeMs("3600000")).toBe(3_600_000);
+  });
+
+  it("falls back to the secure default for non-finite / non-positive / junk values (freshness can never be disabled)", () => {
+    for (const bad of ["0", "-1", "-99999", "NaN", "abc", "Infinity", "1e999"]) {
+      expect(resolveAppCheckAttestationMaxAgeMs(bad), `value=${bad}`).toBe(SEVEN_DAYS_MS);
+    }
+  });
+
+  it("rejects an attestation older than the window and accepts a fresh one", () => {
+    const now = 1_900_000_000_000;
+    const fresh = { v: 1 as const, appId: "app-1", boundAtMillis: now - 60_000 };
+    const stale = { v: 1 as const, appId: "app-1", boundAtMillis: now - APP_CHECK_ATTESTATION_MAX_AGE_MS - 1 };
+    expect(isAppCheckAttestationClaimFresh(fresh, now)).toBe(true);
+    expect(isAppCheckAttestationClaimFresh(stale, now)).toBe(false);
+  });
+});
diff --git a/functions/src/__tests__/fcmOutboundDeviceIdMinimization.test.ts b/functions/src/__tests__/fcmOutboundDeviceIdMinimization.test.ts
new file mode 100644
index 0000000000..f9c771bad8
--- /dev/null
+++ b/functions/src/__tests__/fcmOutboundDeviceIdMinimization.test.ts
@@ -0,0 +1,125 @@
+/**
+ * Push-privacy minimization (V-22-android-deviceid).
+ *
+ * The persisted `fcm_outbound` queue document must NOT carry the stable
+ * `androidDeviceId` correlator. Delivery routing in `fcmAndroidSender.ts`
+ * (the `sendFcmOutbound` create trigger and the stuck-push sweeper) reads
+ * back ONLY `fcmToken` + `payload`, so the device id is never consumed from
+ * the persisted doc — persisting it would just leave a stable cross-session
+ * correlator at rest inside this short-lived (15-min TTL) document.
+ *
+ * These tests drive the real `triggerVoIPCall` handler through the same
+ * path-keyed Firestore + auth mocks the BOLA suite uses, capturing every
+ * `collection().add()` write so the persisted shape can be asserted.
+ */
+import { describe, expect, it, vi } from "vitest";
+
+import { ALICE_UID, callableRequest, callableRunner, seedDoc } from "./bola/callableBolaHarness.js";
+
+const store: Map<string, Record<string, unknown>> = vi.hoisted(() => new Map());
+const outboundWrites: Array<{ collection: string; payload: Record<string, unknown> }> = vi.hoisted(() => []);
+
+process.env.ENFORCE_APP_CHECK = "false";
+
+vi.mock("../auth.js", () => ({
+  assertAppCheck: vi.fn(),
+}));
+vi.mock("firebase-admin/firestore", () => ({
+  getFirestore: () => ({
+    doc: (path: string) => ({
+      get: async () => {
+        const data = store.get(path);
+        return {
+          exists: data !== undefined,
+          data: () => data,
+        };
+      },
+    }),
+    collection: (name: string) => ({
+      add: async (payload: Record<string, unknown>) => {
+        outboundWrites.push({ collection: name, payload });
+        return { id: `out-${outboundWrites.length}` };
+      },
+    }),
+  }),
+  Timestamp: {
+    now: () => ({ toMillis: () => Date.now() }),
+    fromMillis: (ms: number) => ({ toMillis: () => ms }),
+  },
+}));
+vi.mock("../voipPush.js", async () => {
+  const actual = await vi.importActual<typeof import("../voipPush.js")>("../voipPush.js");
+  return {
+    ...actual,
+    macHasActiveMediaEntitlement: vi.fn(async () => true),
+  };
+});
+
+async function triggerForAliceAndroidDevice(): Promise<{ collection: string; payload: Record<string, unknown> }> {
+  store.clear();
+  outboundWrites.length = 0;
+  // Alice owns an Android device with only an FCM token (no APNs / VoIP token),
+  // so `resolveFanOut` resolves the Android branch and returns androidDeviceId.
+  seedDoc(store, `users/${ALICE_UID}/devices/alice-pixel`, {
+    fcm_token: "alice-fcm-token",
+    platform: "android",
+  });
+
+  const mod = await import("../callables/voipPush.js");
+  const run = callableRunner(mod.triggerVoIPCall);
+
+  const result = (await run(
+    callableRequest(ALICE_UID, {
+      callId: "call-00000042",
+      connectionId: "conn-00000042",
+      pairedDeviceId: "alice-pixel",
+      displayName: "Alice's Mac",
+      isVideo: false,
+    }),
+  )) as { ok: boolean; channels: { fcm: boolean } };
+
+  expect(result.ok).toBe(true);
+  expect(result.channels.fcm).toBe(true);
+
+  const fcmWrite = outboundWrites.find((w) => w.collection === "fcm_outbound");
+  expect(fcmWrite, "expected an fcm_outbound write").toBeDefined();
+  // eslint-disable-next-line @typescript-eslint/no-non-null-assertion
+  return fcmWrite!;
+}
+
+describe("fcm_outbound device-id minimization (V-22-android-deviceid)", () => {
+  it("persists the fcm_outbound doc WITHOUT a stable androidDeviceId correlator", async () => {
+    const fcmWrite = await triggerForAliceAndroidDevice();
+
+    // The raw / opaque device id must not be persisted in any form.
+    expect(fcmWrite.payload).not.toHaveProperty("androidDeviceId");
+    expect(fcmWrite.payload).not.toHaveProperty("android_device_id");
+    expect(fcmWrite.payload).not.toHaveProperty("deviceId");
+    expect(fcmWrite.payload).not.toHaveProperty("pairedDeviceId");
+
+    // No persisted value may leak the resolved device id ("alice-pixel"),
+    // even under a differently-named key.
+    for (const value of Object.values(fcmWrite.payload)) {
+      expect(typeof value === "string" ? value : "").not.toContain("alice-pixel");
+    }
+  });
+
+  it("still persists the fields delivery routing + TTL + account-erase depend on", async () => {
+    const fcmWrite = await triggerForAliceAndroidDevice();
+
+    // Delivery routing keys off fcmToken only (read back by sendFcmOutbound).
+    expect(fcmWrite.payload).toHaveProperty("fcmToken", "alice-fcm-token");
+    // Account-erase fan-out (accountDeletion.ts) deletes by uid.
+    expect(fcmWrite.payload).toHaveProperty("uid", ALICE_UID);
+    // 15-min self-expiry TTL stays stamped on the doc.
+    expect(fcmWrite.payload).toHaveProperty("createdAt");
+    expect(fcmWrite.payload).toHaveProperty("expireAt");
+    expect(fcmWrite.payload).toHaveProperty("status", "pending");
+    // The data payload carries only the ephemeral, per-push correlation id.
+    const payload = fcmWrite.payload.payload as Record<string, unknown>;
+    expect(payload).toHaveProperty("call_id", "call-00000042");
+    expect(payload).toHaveProperty("correlation_id");
+    expect(payload).not.toHaveProperty("connection_id");
+    expect(payload).not.toHaveProperty("paired_device_id");
+  });
+});
