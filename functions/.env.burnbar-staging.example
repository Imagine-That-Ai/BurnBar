# OpenBurnBar Cloud Functions — STAGING runtime config (TEMPLATE).
#
# Copy to functions/.env.burnbar-staging and fill in the STAGING project's
# public identifiers before the first staging functions deploy. Like the
# production file, this is the single source of truth for the staging functions
# runtime environment and is read by the staging deploy lane
# (.github/workflows/deploy-staging.yml).
#
# Why a separate committed file (not reused from production):
#   - Staging must point at the STAGING project's own service URLs (OTS verifier,
#     quota runner) and, where you want isolation, staging/test product & price
#     IDs — never the live Stripe/App Store/Play catalog.
#   - Keeping it committed + reviewed means a staging deploy can never ship with
#     empty config, exactly like functions/.env.burnbar.production (H14).
#
# NON-SECRET VALUES ONLY. Every key below is a public identifier or URL. Real
# secrets (Stripe SECRET key, APNs key, Sentry DSN) remain GitHub Actions
# secrets / Secret Manager in the STAGING project — never stored here.
#
# Per-deploy dynamic values (FUNCTION_VERSION, OPENBURNBAR_SOURCE_COMMIT,
# SENTRY_DSN, SENTRY_ENVIRONMENT) are appended by the deploy caller.
#
# Before the first deploy, replace every <STAGING-…> placeholder with the
# staging project's real values, then `git mv` this file to
# functions/.env.burnbar-staging.

# ── Corresponding-source provenance ───────────────────────────────────────
OPENBURNBAR_CORRESPONDING_SOURCE_URL=https://burnbar.ai/legal/source

# ── OpenTimestamps verifier service (STAGING deployment of the verifier) ───
OPENBURNBAR_OTS_VERIFY_URL=https://<STAGING-OTS-VERIFIER-HOST>/verify
OPENBURNBAR_OTS_VERIFY_AUDIENCE=https://<STAGING-OTS-VERIFIER-HOST>
OPENBURNBAR_OTS_STAMP_URL=https://<STAGING-OTS-VERIFIER-HOST>/stamp

# ── APNs (Push Notifications) — sandbox for staging ────────────────────────
APNS_VOIP_TOPIC=com.openburnbar.mobile.voip
APNS_HOST=https://api.sandbox.push.apple.com

# ── Apple App Store — Sandbox for staging ──────────────────────────────────
APP_STORE_APPLE_APP_ID=6766366964
APP_STORE_BUNDLE_ID=com.openburnbar.app
APP_STORE_ENV=Sandbox

# ── App Check enforcement ─────────────────────────────────────────────────
# Keep enforcement ON in staging so it faithfully rehearses production posture.
# (Register a staging App Check debug token for local/dev clients instead of
# disabling enforcement.)
ENFORCE_APP_CHECK=true

# Windows custom App Check (public app id and verifier URL; the shared verifier
# bearer credential is the WINDOWS_TPM_VERIFIER_TOKEN Secret Manager secret).
WINDOWS_APP_CHECK_APP_ID=1:<STAGING-PROJECT-NUMBER>:web:<STAGING-WEB-APP-ID>
APP_CHECK_ALLOWED_APP_IDS=1:<STAGING-PROJECT-NUMBER>:web:<STAGING-WEB-APP-ID>
WINDOWS_TPM_VERIFIER_URL=https://<STAGING-WINDOWS-VERIFIER-HOST>/verify

# ── Hosted quota sync (STAGING quota runner) ───────────────────────────────
HOSTED_QUOTA_DAILY_REFRESH_LIMIT=30
HOSTED_QUOTA_MONTHLY_REFRESH_LIMIT=300
HOSTED_QUOTA_PRODUCT_ID=com.openburnbar.hostedQuotaSync.cloud.monthly
HOSTED_QUOTA_RUNNER_URL=https://<STAGING-QUOTA-RUNNER-HOST>
HOSTED_QUOTA_RUNNER_ALLOWED_HOSTS=<STAGING-QUOTA-RUNNER-HOST>

# ── Remote MCP issuer posture ─────────────────────────────────────────────
REMOTE_MCP_RUNTIME_ENVIRONMENT=staging

# ── BurnBar product IDs (Apple / canonical) ───────────────────────────────
# Reuse production IDs only if you accept staging exercising the live catalog.
# Prefer staging/test product IDs where the platform supports them.
BURNBAR_PRO_PRODUCT_ID=com.openburnbar.pro.monthly
BURNBAR_PRO_ANNUAL_PRODUCT_ID=com.openburnbar.pro.annual
BURNBAR_PRO_MAX_PRODUCT_ID=com.openburnbar.proMax.v2.monthly
BURNBAR_PRO_MAX_ANNUAL_PRODUCT_ID=com.openburnbar.proMax.annual
BURNBAR_ULTRA_PRODUCT_ID=com.openburnbar.ultra.monthly
BURNBAR_ULTRA_ANNUAL_PRODUCT_ID=com.openburnbar.ultra.annual.v2
AGENT_CONTROL_100_ACTIONS_PRODUCT_ID=com.openburnbar.agentControl.actions100
FLOO_RELAY_50GB_PRODUCT_ID=com.openburnbar.floo.relay50gb
ELDER_WAND_SEARCHES_100_PRODUCT_ID=com.openburnbar.elderWand.searches100
ELDER_WAND_SEARCHES_500_PRODUCT_ID=com.openburnbar.elderWand.searches500

# ── Google Play product IDs ───────────────────────────────────────────────
GOOGLE_PLAY_PACKAGE_NAME=com.openburnbar
GOOGLE_PLAY_SUBSCRIPTION_PRODUCT_ID=com.openburnbar.pro.monthly
GOOGLE_PLAY_CLOUD_MONTHLY_PRODUCT_ID=com.openburnbar.pro.monthly
GOOGLE_PLAY_CLOUD_ANNUAL_PRODUCT_ID=com.openburnbar.pro.annual
GOOGLE_PLAY_CLOUD_PRO_MONTHLY_PRODUCT_ID=com.openburnbar.promax.v2.monthly
GOOGLE_PLAY_CLOUD_PRO_ANNUAL_PRODUCT_ID=com.openburnbar.promax.annual
GOOGLE_PLAY_ULTRA_MONTHLY_PRODUCT_ID=com.openburnbar.ultra.monthly
GOOGLE_PLAY_ULTRA_ANNUAL_PRODUCT_ID=com.openburnbar.ultra.annual
GOOGLE_PLAY_AGENT_CONTROL_100_ACTIONS_PRODUCT_ID=com.openburnbar.agentcontrol.actions100
GOOGLE_PLAY_FLOO_RELAY_50GB_PRODUCT_ID=com.openburnbar.floo.relay50gb
GOOGLE_PLAY_ELDER_WAND_SEARCHES_100_PRODUCT_ID=com.openburnbar.elderwand.searches100
GOOGLE_PLAY_ELDER_WAND_SEARCHES_500_PRODUCT_ID=com.openburnbar.elderwand.searches500

# ── Stripe PRICE IDs — use Stripe TEST-mode prices for staging ─────────────
# The staging Stripe SECRET key (a separate secret) should be a TEST-mode key,
# so these must be TEST-mode price IDs. Replace before first deploy.
STRIPE_BURNBAR_PRO_PRICE_ID=<STAGING-STRIPE-TEST-PRICE-ID>
STRIPE_BURNBAR_CLOUD_MONTHLY_PRICE_ID=<STAGING-STRIPE-TEST-PRICE-ID>
STRIPE_BURNBAR_CLOUD_ANNUAL_PRICE_ID=<STAGING-STRIPE-TEST-PRICE-ID>
STRIPE_BURNBAR_CLOUD_PRO_MONTHLY_PRICE_ID=<STAGING-STRIPE-TEST-PRICE-ID>
STRIPE_BURNBAR_CLOUD_PRO_ANNUAL_PRICE_ID=<STAGING-STRIPE-TEST-PRICE-ID>
STRIPE_AGENT_CONTROL_100_ACTIONS_PRICE_ID=<STAGING-STRIPE-TEST-PRICE-ID>
STRIPE_FLOO_RELAY_50GB_PRICE_ID=<STAGING-STRIPE-TEST-PRICE-ID>
STRIPE_ELDER_WAND_SEARCHES_100_PRICE_ID=<STAGING-STRIPE-TEST-PRICE-ID>
STRIPE_ELDER_WAND_SEARCHES_500_PRICE_ID=<STAGING-STRIPE-TEST-PRICE-ID>
