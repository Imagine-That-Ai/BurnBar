# OpenBurnBar Cloud Functions environment variables
# Copy to .env and fill in real values. Never commit .env.
# See: docs/runbooks/ for setup instructions.

# ── Sentry Error Tracking ──────────────────────────────────────────────────
# Get from: https://sentry.io/settings/<org>/projects/<project>/keys/
# Required for error reporting in production. Leave blank for local dev.
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=openburnbar-functions
SENTRY_ENVIRONMENT=development

# ── Firebase project ──────────────────────────────────────────────────────
# These are injected automatically by the Firebase CLI or by CI secrets.
# Set here for local development without the emulator.
FIREBASE_PROJECT_ID=openburnbar-dev
# Public browser key for the same Firebase project. Required outside production.
OPENBURNBAR_FIREBASE_WEB_API_KEY=
# Exact browser Firebase app IDs that receive standard Web App Check trust.
# Keep desktop Linux/Windows IDs out of this list.
APP_CHECK_STANDARD_WEB_APP_IDS=

# ── Stripe ────────────────────────────────────────────────────────────────
# Live key: get from https://dashboard.stripe.com/apikeys
# Use a real restricted development key locally. Do not commit it.
STRIPE_SECRET_KEY=replace_me_with_stripe_secret_key

# ── Apple App Store Server API ────────────────────────────────────────────
# Required for App Store subscription validation.
# Get from App Store Connect → Keys → In-App Purchase Keys.
APPLE_ISSUER_ID=
APPLE_KEY_ID=
# APPLE_PRIVATE_KEY_PATH=./certs/apple-iap.p8

# ── APNs (Push Notifications) ────────────────────────────────────────────
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.openburnbar

# ── Functions runtime ─────────────────────────────────────────────────────
# Injected at deploy time. Set manually for local profiling.
FUNCTION_VERSION=dev-local

# ── Storage ───────────────────────────────────────────────────────────────
OPENBURNBAR_STORAGE_BUCKET=

# ── Amplitude (opt-in, consent-gated server analytics) ────────────────────
# OPTIONAL. The light backend stream emits ONLY high-value server conversions
# (e.g. subscription.entitlement.granted) and ONLY when the client propagated a
# verified `granted` consent flag. With AMPLITUDE_API_KEY unset the stream stays
# DARK by construction (the recorder's key gate). In prod the key is a Secret
# Manager secret (firebase functions:secrets:set AMPLITUDE_API_KEY); set the env
# var only for local/emulator runs. NEVER commit a real key.
AMPLITUDE_API_KEY=
# US (default) or EU data residency for the Amplitude HTTP V2 endpoint.
AMPLITUDE_SERVER_ZONE=US

# ── Model landscape benchmark refresh ───────────────────────────────────────
# Production scheduled functions bind these API keys as Firebase Secret Manager
# secrets. Use env vars only for local emulator/profiling runs.
ARTIFICIAL_ANALYSIS_API_KEY=
DESIGN_ARENA_API_KEY=
# Non-secret cached fixtures for local fallback or approved operator overrides.
DESIGN_ARENA_FIXTURE_JSON=
MODEL_LANDSCAPE_MANUAL_FIXTURES_JSON=
