# OpenBurnBar Cloud Functions — PRODUCTION runtime config (committed, reviewed).
#
# H14: this file is the single source of truth for the production functions
# runtime environment. It is read by BOTH the deploy lane
# (.github/workflows/deploy-production.yml) AND the source rollback
# (scripts/rollback.sh), so a rollback can never ship with empty config.
#
# NON-SECRET VALUES ONLY. Every key below is a public identifier or URL:
# App Check enforcement flag, Stripe/Play/App Store product & price IDs,
# OTS/quota-runner service URLs, APNs topic/host, hosted-quota limits.
# Real secrets (FIREBASE_TOKEN, GCP_SA_KEY, Stripe SECRET key, APNs key) are
# NEVER stored here — they remain GitHub Actions secrets / Secret Manager.
#
# Per-deploy dynamic values (FUNCTION_VERSION, OPENBURNBAR_SOURCE_COMMIT) are
# appended by the deploy/rollback caller, not committed here.
#
# Change control: edit this file in a reviewed PR. Adding/removing a product or
# price ID, or flipping ENFORCE_APP_CHECK, is a production config change.

# ── Corresponding-source provenance ───────────────────────────────────────
OPENBURNBAR_CORRESPONDING_SOURCE_URL=https://burnbar.ai/legal/source

# ── OpenTimestamps verifier service ───────────────────────────────────────
OPENBURNBAR_OTS_VERIFY_URL=https://openburnbar-ots-verifier-cjrjb5ckqq-uc.a.run.app/verify
OPENBURNBAR_OTS_VERIFY_AUDIENCE=https://openburnbar-ots-verifier-cjrjb5ckqq-uc.a.run.app
OPENBURNBAR_OTS_STAMP_URL=https://openburnbar-ots-verifier-cjrjb5ckqq-uc.a.run.app/stamp

# ── APNs (Push Notifications) ─────────────────────────────────────────────
APNS_VOIP_TOPIC=com.openburnbar.mobile.voip
APNS_HOST=https://api.push.apple.com

# ── Apple App Store ───────────────────────────────────────────────────────
APP_STORE_APPLE_APP_ID=6766366964
APP_STORE_BUNDLE_ID=com.openburnbar.app
APP_STORE_ENV=Production

# ── App Check enforcement ─────────────────────────────────────────────────
ENFORCE_APP_CHECK=true
LINUX_APP_CHECK_APP_ID=1:246956661961:web:ab19bc3a6f6d4580480118

# ── Revenue/control-path runtime scaling ──────────────────────────────────
# Production keeps the curated hot-path allowlist warm; staging explicitly
# overrides this to 0. Keeping the value in the reviewed dotenv also makes
# non-interactive Firebase deploys deterministic instead of prompting.
HOT_MIN_INSTANCES=1

# ── Hosted quota sync ─────────────────────────────────────────────────────
HOSTED_QUOTA_DAILY_REFRESH_LIMIT=30
HOSTED_QUOTA_MONTHLY_REFRESH_LIMIT=300
HOSTED_QUOTA_PRODUCT_ID=com.openburnbar.hostedQuotaSync.cloud.monthly
HOSTED_QUOTA_RUNNER_URL=https://openburnbar-quota-runner-cjrjb5ckqq-uc.a.run.app
HOSTED_QUOTA_RUNNER_ALLOWED_HOSTS=openburnbar-quota-runner-cjrjb5ckqq-uc.a.run.app

# ── Remote MCP issuer posture ─────────────────────────────────────────────
REMOTE_MCP_RUNTIME_ENVIRONMENT=production

# ── BurnBar product IDs (Apple / canonical) ───────────────────────────────
BURNBAR_PRO_PRODUCT_ID=com.openburnbar.pro.monthly
BURNBAR_PRO_ANNUAL_PRODUCT_ID=com.openburnbar.pro.annual
BURNBAR_PRO_MAX_PRODUCT_ID=com.openburnbar.proMax.v2.monthly
BURNBAR_PRO_MAX_ANNUAL_PRODUCT_ID=com.openburnbar.proMax.annual
BURNBAR_ULTRA_PRODUCT_ID=com.openburnbar.ultra.monthly
BURNBAR_ULTRA_ANNUAL_PRODUCT_ID=com.openburnbar.ultra.annual.v2
AGENT_CONTROL_100_ACTIONS_PRODUCT_ID=com.openburnbar.agentControl.actions100
FLOO_RELAY_50GB_PRODUCT_ID=com.openburnbar.floo.relay50gb
ELDER_WAND_SEARCHES_100_PRODUCT_ID=com.openburnbar.elderWand.searches100
ELDER_WAND_SEARCHES_500_PRODUCT_ID=com.openburnbar.elderWand.searches500
MEMORY_BOOST_TEXT_1M_PRODUCT_ID=com.openburnbar.memory.boost.text.1m
MEMORY_BOOST_TEXT_5M_PRODUCT_ID=com.openburnbar.memory.boost.text.5m
MEMORY_BOOST_VISION_1M_PRODUCT_ID=com.openburnbar.memory.boost.vision.1m

