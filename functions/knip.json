{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "src/index.ts",
    "src/types/generatedParity.ts",
    "src/hermesGatewayComplianceSurface.ts",
    "scripts/test-*.mjs",
    "scripts/test-firestore-rules.mjs"
  ],
  "project": ["src/**/*.ts"],
  "ignore": [
    "lib/**",
    "node_modules/**",
    "src/types/generated/**",
    "src/__tests__/bola/bolaVictimSeeds.generated.ts",
    ".dependency-cruiser.cjs"
  ],
  "ignoreIssues": {
    "src/types/legacy/{connections,insights-digest,insights-spec,media,quota-usage}.ts": ["exports", "types"]
  },
  "ignoreDependencies": [
    "@openburnbar/domain-core-wasm",
    "@openburnbar/entitlements",
    "@openburnbar/signal-envelope-contracts",
    "openburnbar-brace-expansion-cjs"
  ]
}
