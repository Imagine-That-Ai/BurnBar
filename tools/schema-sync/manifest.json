            "QuotaBucket.limit",
            "QuotaBucket.unit",
            "QuotaBucket.resetAt"
          ]
        }
      ],
      "kotlinHandMirror": [
        {
          "path": "android/app/src/main/java/com/openburnbar/data/models/TokenUsage.kt",
          "knownDrift": [
            "UsageEventDoc.cacheWriteTokens",
            "UsageEventDoc.costUSD",
