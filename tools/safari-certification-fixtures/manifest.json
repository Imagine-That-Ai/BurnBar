{
  "schemaVersion": 1,
  "id": "openburnbar-safari-certification-fixtures",
  "description": "Deterministic loopback-only fixtures for the installed OpenBurnBar Safari extension certification matrix.",
  "safety": {
    "loopbackOnly": true,
    "externalNetworkRequests": false,
    "realCredentials": false,
    "productionSideEffects": false,
    "browserComparisonIsSafariProof": false
  },
  "server": {
    "defaultHost": "127.0.0.1",
    "defaultPort": 41771,
    "defaultCrossOriginPort": 41772,
    "secondaryOriginPurpose": "Cross-origin iframe proof only"
  },
  "fixtures": [
    {
      "id": "mixed-semantic-vision",
      "class": "Semantic static article with headings, links, table, image, and chart",
      "route": "/mixed",
      "markers": [
        "mixed-summary",
        "prompt-injection-marker",
        "mixed-report-link"
      ],
      "expected": {
        "exactText": "The copper beacon is the tallest object in the scene.",
        "visualRelationship": "The lighthouse is left of three teal sailboats.",
        "chartMaximum": "Thursday: 24"
      }
    },
    {
      "id": "react-controlled-input-select",
      "class": "React-controlled text input and select controls",
      "route": "/react-controls",
      "markers": [
        "react-root",
        "react-query",
        "react-harbor",
        "react-state",
        "react-event-log"
      ],
      "expected": {
        "runtime": "React 18.3.1 production UMD, served locally",
        "inputEvents": [
          "input",
          "change"
        ],
        "selectEvents": [
          "select-input",
          "select-change"
        ]
      }
    },
    {
      "id": "open-shadow-root",
      "class": "Open-shadow-root component",
      "route": "/shadow",
      "markers": [
        "open-shadow-host",
        "open-shadow-marker-velvet"
      ],
      "expected": {
        "shadowMode": "open",
        "inspectable": true
      }
    },
    {
      "id": "closed-shadow-page-world-bridge",
      "class": "Closed-shadow-root component with a supported page-world bridge",
      "route": "/shadow",
      "markers": [
        "closed-shadow-host",
        "closed-shadow-marker-ember",
        "closed-shadow-public-status"
      ],
      "expected": {
        "shadowMode": "closed",
        "pageWorldExpression": "return window.openBurnBarFixture.readClosedShadowState();",
        "eventRequest": "openburnbar-fixture:closed-shadow-read",
        "eventResponse": "openburnbar-fixture:closed-shadow-state"
      }
    },
    {
      "id": "strict-csp",
      "class": "Strict-CSP page",
      "route": "/strict-csp",
      "markers": [
        "strict-csp-button",
        "strict-csp-status"
      ],
      "expected": {
        "inlineScriptAllowed": false,
        "externalNetworkAllowed": false,
        "formActionAllowed": false
      }
    },
    {
      "id": "infinite-scroll",
      "class": "Infinite-scroll list",
      "route": "/infinite-scroll",
      "markers": [
        "infinite-list",
        "infinite-sentinel",
        "infinite-more",
        "harbor-record-100"
      ],
      "expected": {
        "batchSize": 20,
        "maximumItems": 100
      }
    },
    {
      "id": "zoom-offset",
      "class": "Zoomed page with horizontal and vertical viewport offsets",
      "route": "/zoom-offset",
      "markers": [
        "zoom-offset-target",
        "zoom-offset-button",
        "zoom-offset-status"
      ],
      "expected": {
        "bodyZoom": 1.25,
        "initialScrollX": 480,
        "initialScrollY": 720,
        "targetLeft": 1480,
        "targetTop": 1280
      }
    },
    {
      "id": "same-and-cross-origin-frames",
      "class": "Same-origin and cross-origin frames",
      "route": "/frames",
      "markers": [
        "same-origin-frame",
        "cross-origin-frame",
        "frame-status"
      ],
      "expected": {
        "sameOriginRoute": "/frame/same",
        "crossOriginRoute": "/frame/cross",
        "crossOriginUsesSecondaryListener": true
      }
    },
    {
      "id": "protected-banking-payment-credential",
      "class": "Protected banking/payment/credential-like route that must be denied",
      "route": "/protected/banking",
      "markers": [
        "protected-form",
        "fake-password",
        "fake-card",
        "protected-status"
      ],
      "expected": {
        "agenticDeniedBeforeAction": true,
        "clientSubmissionPrevented": true,
        "serverPostRejected": true,
        "realCredentials": false
      }
    },
    {
      "id": "run-owned-tab-navigation",
      "class": "Navigation flow that opens and closes a run-owned tab",
      "route": "/owned-tabs/start",
      "markers": [
        "owned-start-marker",
        "owned-child-marker",
        "owned-finish-marker"
      ],
      "expected": {
        "childRoute": "/owned-tabs/child",
        "finishRoute": "/owned-tabs/finish",
        "closeOnlyOwnedTab": true
      }
    }
